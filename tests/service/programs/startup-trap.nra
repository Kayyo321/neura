// Traps while its module starts: the initializer of `ratio` divides by zero
// unless an argument is given.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let zero = func -> int => 0;
let ratio = 10 / zero();

export let StartupTrap = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line(ratio.to_string());
        return program.ExitCode.Ok;
    };
);
