// Without a type for any name, a lambda takes its types from an expected
// function type; a local binding without an annotation gives none. Passed to
// a parameter of function type the same lambda is valid
// (tests/ui/types/accepted-untyped-lambdas.nra).
let total = func -> int {
    let add = func(a, b) -> int { return a + b; };
    return add(1, 2);
};
