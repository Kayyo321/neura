// A Std.Concurrent handle given to a parallel item (E0602): the item runs in a
// heap of its own and would update a copy.
let atomics = import:Std.Concurrent.AtomicInt64;
let parallel = import:Std.Concurrent.Parallel;

let bump = func(counter: atomics.AtomicInt64) -> int64 => counter.add(1);

let run = func(counters: atomics.AtomicInt64[]) {
    let _ = parallel.map<atomics.AtomicInt64, int64>(counters, bump, parallel.limits(1000, 1000));
};
