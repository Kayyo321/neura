// An instance of a class that extends a #NotThreadSafe class, given to a
// spawned task (E0602): the instances stay in the task that holds them. The
// label is at the tag on the base class.
#NotThreadSafe
let Cursor = class (
    export let position: int64 = 0;
);

let LineCursor = class:Cursor (
    export let line: int64 = 0;
);

let advance = func(cursor: LineCursor) -> int64 => cursor.position + 1;

let run = func() {
    let cursor = new LineCursor();
    scope {
        spawn advance(cursor);
    }
};
