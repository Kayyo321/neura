// Inside an override, the property's name is the base's accessor (edge case
// 79), which may be missing.
let Shape = class (
    export let label: string = "shape";
        | get.virtual: label;
);
let Circle = class : Shape (
    export let.override label: string;
        | get.override: {
            label = "x";
            return "circle";
        };
);
