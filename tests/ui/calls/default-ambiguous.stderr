2 | let f = func(a: int) -> int => a
  |     - this alternative takes (a: int32)
3 |     or func(a: int, b: int = 1) -> int => a + b;
  |        ---- this alternative takes (a: int32, b: int32)
4 | let one = f(1);
  |           ^^^^
