// A state given to another task (E0602; Components030 case 29).
let ui = import:Std.Ui;

let read = func(state: ui.State<int32>) -> int32 => state.get();

let start = func() -> int32 {
    let state = new ui.State<int32>(1);
    scope {
        let task = spawn read(state);
        return task.join();
    }
};
