error[E0560]: parameter 'a' is named 'left' in the method it overrides
  --> $DIR/parameter-names.nra:10:34
   |
 4 |     static let add = func(left: T, right: T) -> T;
   |                           ---- the parameter is named 'left' here
...
10 |     export static let add = func(a: Money, b: Money) -> Money => a;
   |                                  ^ a call may name this parameter 'left'
