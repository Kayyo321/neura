error[E0504]: 'Money' must declare 'static let add = func(left: Money, right: Money) -> Money'
  --> $DIR/inherited.nra:12:5
   |
 4 |     static let add = func(left: T, right: T) -> T;
   |                --- 'add' is required here
...
12 | let Money = class : Base implements Additive<Money> (
   |     ^^^^^ 'Money' implements 'Additive<Money>'
