// Edge case 9 of docs/design/Expressions030.md: 'is' binds more tightly than '+', so the test is an operand and is E0265.
let Shape = class (
    export let sides: int = 0;
);
let Circle = class : Shape (
    export let radius: int = 1;
);
let Other = class (
    export let value: int = 0;
);
let check = func(count: int, shape: Shape) -> int {
    if (count + shape is circle: Circle) {
        return 1;
    }
    return 0;
};
