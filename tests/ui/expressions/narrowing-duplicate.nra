// docs/design/Expressions030.md, Narrowing: two narrowings of one condition binding one name.
let Shape = class (
    export let sides: int = 0;
);
let Circle = class : Shape (
    export let radius: int = 1;
);
let Other = class (
    export let value: int = 0;
);
let check = func(a: Shape, b: Shape) -> int {
    if (a is circle: Circle && b is circle: Circle) {
        return 1;
    }
    return 0;
};
