// Edge case 8 of docs/design/Expressions030.md: a conjunct before the narrowing does not see its binding.
let Shape = class (
    export let sides: int = 0;
);
let Circle = class : Shape (
    export let radius: int = 1;
);
let Other = class (
    export let value: int = 0;
);
let check = func(shape: Shape) -> int {
    if (circle.radius > 0 && shape is circle: Circle) {
        return 1;
    }
    return 0;
};
