// Edge case 14 of docs/design/Expressions030.md: an 'is not' narrowing inside an '&&' chain is E0266.
let Shape = class (
    export let sides: int = 0;
);
let Circle = class : Shape (
    export let radius: int = 1;
);
let Other = class (
    export let value: int = 0;
);
let check = func(shape: Shape, ready: bool) -> int {
    if (shape is not circle: Circle && ready) {
        return 1;
    }
    return 0;
};
