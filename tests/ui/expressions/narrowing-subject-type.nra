// docs/design/Expressions030.md, Narrowing: a subject match.is cannot test is E0411.
let Shape = class (
    export let sides: int = 0;
);
let Circle = class : Shape (
    export let radius: int = 1;
);
let Other = class (
    export let value: int = 0;
);
let check = func(pair: [int, int]) -> int {
    if (pair is first: int) {
        return first;
    }
    return 0;
};
