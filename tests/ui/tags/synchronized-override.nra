// An override of a synchronized method that is not synchronized (E0922): a
// call through the base class would run it without the guard.
let Account = class (
    let balance: int64 = 0;

    #Synchronized
    export let deposit = func(amount: int64) -> int64 {
        balance = balance + amount;
        return balance;
    };
);

let Savings = class:Account (
    export let.override deposit = func(amount: int64) -> int64 {
        return amount;
    };
);
