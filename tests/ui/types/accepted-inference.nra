// Type arguments inferred from arguments and from the expected type
// (docs/design/Calls030.md, edge cases 39, 40, 42, 43, 44, 46 and 54).
let identity = func<T>(value: T) -> T => value;
let pair = func<A, B>(a: A, b: B) -> B => b;
let same = func<T>(a: T, b: T) -> T => b;
let empty = func<T>() -> T[list] => new;

let Renderable = interface (
    let render = func -> string;
);
let Alert = class implements Renderable (
    export let render = func -> string => "alert";
);
let render = func<T: Renderable>(item: T) -> string => item.render();

let Box = class<T> (
    export let value: T;
    export let init = func(value: T) {
        instance.value = value;
    };
    export let pair = func<U>(other: U) -> U => other;
);

let use = func(big: int64, alert: Alert) {
    let seven: int32 = identity(7);
    let wide: int64 = identity<int64>(7);
    let text: string = pair(1, "a");
    let larger: int64 = same(1, big);
    let real: float64 = same(1.0, 2.5);
    let xs: int[list] = empty();
    let shown = render(alert);
    let box = new Box<int>(3);
    let other: string = box.pair("x");
};
