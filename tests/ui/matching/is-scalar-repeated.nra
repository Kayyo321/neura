// Edge case 6: int and int32 are one type.
let Named = interface (
    let name = func -> string;
);
let Shape = class (
    export let sides: int = 0;
);
let Circle = class : Shape (
    export let radius: int = 1;
);
let Other = class (
    export let value: int = 0;
);
let width = func(x: int32) -> int32 => match.is (x) {
    int => 1,
    v: int32 => v,
};
