// Edge case 59: a generic packing instantiated with an array.
let.promote _ = import:Std.Core.Optional;
let Shape = class ( export let sides: int = 0; );
let wrap = func<T>(value: T) -> any => value as any;
let program = import:Std.Program;
export let Main = module : program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let v = wrap([1, 2]);
        return program.ExitCode.Ok;
    };
);
