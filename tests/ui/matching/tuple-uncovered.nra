// Edge case 28: a tuple subject without its last arm.
let.promote _ = import:Std.Core.Optional;
let Shape = enum (Dot, Line(int), Box { size: [int, int], label: Optional<string> });
let Tree = enum (Leaf(int), Node(Tree, Tree));
let Light = enum (Red, Yellow, Green);
let pair = func(a: Light, b: Light) -> int => match ([a, b]) {
    [Light.Red, _] => 1,
    [_, Light.Red] => 2,
};
