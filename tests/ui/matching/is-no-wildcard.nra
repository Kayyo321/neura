// Edge case 2: a class subject without a final '_'.
let Named = interface (
    let name = func -> string;
);
let Shape = class (
    export let sides: int = 0;
);
let Circle = class : Shape (
    export let radius: int = 1;
);
let Other = class (
    export let value: int = 0;
);
let classify = func(value: class) -> int => match.is (value) {
    Circle => 1,
    shape: Shape => 2,
    nil => 3,
};
