// Edge case 90: '??' after a call is the coalescing token.
let.promote _ = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Result;
let.promote errors = import:Std.Core.Error;
let parse = func(text: string) -> Result<int> => Result<int>.Ok(1);
let nested = func() -> Result<Result<int>> => Result<Result<int>>.Ok(Result<int>.Ok(1));
let read = func() -> Result<int> {
    let value = nested()??;
    return Result<int>.Ok(value);
};
