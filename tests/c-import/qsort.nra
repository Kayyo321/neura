let console = import:Std.Io.Console;
let program = import:Std.Program;
let arenas = import:Std.DynamicForeign.Arena;
let descriptors = import:Std.DynamicForeign.FunctionDescriptor;
let layouts = import:Std.DynamicForeign.ValueLayout;
let linkers = import:Std.DynamicForeign.Linker;
let values = import:Std.DynamicForeign.ForeignValue;
let clib = import:c("stdlib.h");

// A header-only import of the C library: qsort sorts through a Neura
// comparator passed as an upcall stub, and abs and atoi take plain values.
export let Main = module:program.Entry (
    let compare = func(arguments: values.ForeignValue[list]) -> values.ForeignValue {
        let left = values.as_segment(arguments[0]).reinterpret(4).get_int32(0);
        let right = values.as_segment(arguments[1]).reinterpret(4).get_int32(0);
        return values.ForeignValue.Int32((left < right) ? -1 : (left > right) ? 1 : 0);
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        let arena = arenas.of_confined();
        let numbers = arena.allocate_array(layouts.Int32, 4);
        let input = [40, -1, 7, 0];
        for (let i = 0; i < 4; i++) {
            numbers.set_int32((i * 4) as int64, input[i]);
        }
        let stub = linkers.native_linker().upcall_stub(compare,
            descriptors.of(layouts.Int32, layouts.Address, layouts.Address), arena);
        clib.qsort(numbers, 4, 4, stub);
        let text = "";
        for (let i = 0; i < 4; i++) {
            text = text + numbers.get_int32((i * 4) as int64).to_string() + " ";
        }
        console.print_line(text);
        console.print_line(clib.abs(-9).to_string());
        console.print_line(clib.atoi("1234").to_string());
        console.print_line((clib.EXIT_FAILURE + clib.EXIT_SUCCESS).to_string());
        arena.close();
        return program.ExitCode.Ok;
    };
);
