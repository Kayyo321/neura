let console = import:Std.Io.Console;
let program = import:Std.Program;
let umbrella = import:c("umbrella.h");

// The declarations of umbrella.h are in _umbrella.h and, through it,
// _umbrella_inner.h: the functions and macros of both are imported and run.
export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line(umbrella.strlen("umbrella").to_string());
        console.print_line(umbrella.abs(-12).to_string());
        console.print_line((umbrella.UMBRELLA_OUTER + umbrella.UMBRELLA_INNER).to_string());
        return program.ExitCode.Ok;
    };
);
