// A record declared as a static member of a class; the expanded form is
// static.expanded.nra.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Holder = class (
    export static let Inner = record (value: int, flag: bool);
);

export let Main = module : program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let inner = new Holder.Inner(3, true);
        console.print_line(inner.to_string() + " " + inner.hash_code().to_string() + " " +
                           (inner === new Holder.Inner(3, true)).to_string());
        return program.ExitCode.Ok;
    };
);
