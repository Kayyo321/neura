// A copy builds the image of the constructor call it stands for, written out
// in copy.expanded.nra (docs/design/Records030.md, Copy construction).
let console = import:Std.Io.Console;
let program = import:Std.Program;

let User = record (id: int64, name: string, active: bool);

let rename = func(user: User, name: string) -> User {
    return new with(user) { name: name };
};

let reorder = func(user: User, id: int64, active: bool) -> User {
    return new with(user) { active: active, id: id };
};

export let Main = module : program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let user = new User(7, "Ada", true);
        console.print_line(rename(user, "Grace").to_string());
        console.print_line(reorder(user, 8, false).to_string());
        return program.ExitCode.Ok;
    };
);
