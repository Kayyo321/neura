// Virtual accessors (docs/design/Records030.md, edge cases 78, 79, 81, 87,
// 88, 91 and 92): overrides reached through the base class and through an
// interface, the base accessor called statically inside an override, an
// inherited getter beside an overridden setter, and a compound assignment
// with a dispatched getter and setter.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Labelled = interface (
    let label: string;
        | get;
);
let Shape = class implements Labelled (
    export let label: string = "shape";
        | get.virtual: label;
        | set.virtual: {
            console.print_line("Shape stores " + value);
            label = value;
        };
);
let Circle = class : Shape (
    export let.override label: string;
        | get.override: "circle of " + label;
    export let describe = func() -> string => "a " + label;
);
let Ring = class : Circle (
    export let.override label: string;
        | get.override: "ring, " + label;
        | set.override: {
            console.print_line("Ring sets " + value);
            label = value + "!";
        };
);
let Quiet = class : Shape (
    export let.override label: string;
        | set.override: label = value + ".";
);

export let Main = module : program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let shapes: Shape[] = [new Shape(), new Circle(), new Ring(), new Quiet()];
        for (let shape in shapes) {
            console.print_line(shape.label);
        }
        let ring: Shape = new Ring();
        ring.label = "r";
        console.print_line(ring.label);
        ring.label += "x";
        console.print_line(ring.label);
        let quiet: Shape = new Quiet();
        quiet.label = "q";
        console.print_line(quiet.label);
        let labelled: Labelled = new Ring();
        console.print_line(labelled.label + " | " + new Circle().describe());
        let total = 0;
        let circle: Shape = new Circle();
        for (let i = 0; i < 1000; i++) {
            total += circle.label.byte_length;
        }
        console.print_line(total.to_string());
        return program.ExitCode.Ok;
    };
);
