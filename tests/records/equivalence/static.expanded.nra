// The record of static.record.nra, written out.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Holder = class (
    #[Final, Immutable]
    export static let Inner = class (
        export last value: int;
        export last flag: bool;
        export let init = func(value: int, flag: bool) => set;
        export let.override equals = func(other: class) -> bool {
            if (!(other is Inner)) {
                return false;
            }
            const that = other as Inner;
            return instance.value.equals(that.value) && instance.flag.equals(that.flag);
        };
        export let.override hash_code = func() -> uint32 {
            let hash: uint32 = 1;
            hash = ((hash as uint64 * 31 + instance.value.hash_code() as uint64) & 4294967295) as uint32;
            hash = ((hash as uint64 * 31 + instance.flag.hash_code() as uint64) & 4294967295) as uint32;
            return hash;
        };
        export let.override to_string = func() -> string =>
            "Holder.Inner(value: " + instance.value.to_string() + ", flag: " + instance.flag.to_string() + ")";
    );
);

export let Main = module : program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let inner = new Holder.Inner(3, true);
        console.print_line(inner.to_string() + " " + inner.hash_code().to_string() + " " +
                           (inner === new Holder.Inner(3, true)).to_string());
        return program.ExitCode.Ok;
    };
);
