// A trap in a replacement prevents the later ones (edge case 52).
let console = import:Std.Io.Console;
let program = import:Std.Program;

let User = record (id: int64, name: string);

let g = func(divisor: int) -> string {
    console.print_line("g");
    return (10 / divisor).to_string();
};
let h = func() -> int64 {
    console.print_line("h");
    return 8;
};

export let Main = module : program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let user = new User(7, "Ada");
        let zero = args.length;
        let copy = new with(user) { name: g(zero), id: h() };
        console.print_line(copy.to_string());
        return program.ExitCode.Ok;
    };
);
