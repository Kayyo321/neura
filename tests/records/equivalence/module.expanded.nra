// The record of module.record.nra, written out.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Describe = interface (
    export let describe = func() -> string => "a value";
);

let App = module (
    .[Final, Immutable]
    export let Label = class implements Describe (
        export last text: string;
        export let init = func(text: string) => set;
        export let.override equals = func(other: class) -> bool {
            if (!(other is Label)) {
                return false;
            }
            const that = other as Label;
            return instance.text.equals(that.text);
        };
        export let.override hash_code = func() -> uint32 {
            let hash: uint32 = 1;
            hash = ((hash as uint64 * 31 + instance.text.hash_code() as uint64) & 4294967295) as uint32;
            return hash;
        };
        export let.override to_string = func() -> string => "App.Label(text: " + instance.text.to_string() + ")";
    );
);

export let Main = module : program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let label: Describe = new App.Label("tea");
        console.print_line(label.describe() + " " + label.to_string() + " " + label.hash_code().to_string());
        return program.ExitCode.Ok;
    };
);
