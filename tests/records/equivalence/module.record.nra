// A record in a module that implements an interface through a default
// method; the expanded form is module.expanded.nra.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Describe = interface (
    export let describe = func() -> string => "a value";
);

let App = module (
    export let Label = record implements Describe (text: string);
);

export let Main = module : program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let label: Describe = new App.Label("tea");
        console.print_line(label.describe() + " " + label.to_string() + " " + label.hash_code().to_string());
        return program.ExitCode.Ok;
    };
);
