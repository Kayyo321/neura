// Static requirements (docs/design/Records030.md, edge cases 97, 99, 104,
// 106, 108, 113 and 114): direct calls in each specialization, an
// implementation found on a base, two bounds with one requirement, named
// arguments in written order, a local that hides the type parameter, and a
// class whose static initializer runs at the first call.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Additive = interface<T> (
    static let zero = func() -> T;
    static let add = func(left: T, right: T) -> T;
);
let Monoid = interface<T> (
    static let zero = func() -> T;
);

let announce = func(text: string) -> int64 {
    console.print_line(text);
    return 0;
};

let Money = class implements Additive<Money>, Monoid<Money> (
    export static let base: int64 = announce("Money is initialized");
    export last cents: int64;
    export let init = func(cents: int64) => set;
    export static let zero = func() -> Money => new Money(base);
    export static let add = func(left: Money, right: Money) -> Money {
        console.print_line("add " + left.cents.to_string() + " " + right.cents.to_string());
        return new Money(left.cents + right.cents);
    };
);
let Gold = class : Money (
    export let init = func(cents: int64) {
        super.init(cents * 100);
    };
);
let Box = class (
    export let zero = func() -> int => 7;
);

let sum = func<T: Additive<T>>(items: T[]) -> T {
    let total = T.zero();
    for (let item in items) {
        total = T.add(total, item);
    }
    return total;
};
let first = func<T: [Additive<T>, Monoid<T>]>() -> T => T.zero();
let traced = func(label: string, value: Money) -> Money {
    console.print_line(label);
    return value;
};
let reversed = func<T: Additive<Money>>() -> Money =>
    T.add(right: traced("right", new Money(2)), left: traced("left", new Money(1)));
let shadowed = func<T: Additive<T>>() -> int {
    let T = new Box();
    return T.zero();
};

export let Main = module : program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line("start");
        // The first use of Money is the call of T.zero() in first<Money>.
        console.print_line(first<Money>().cents.to_string());
        let items: Money[] = [new Money(1), new Money(2), new Money(39)];
        console.print_line(sum<Money>(items).cents.to_string());
        let gold: Money[] = [new Gold(1)];
        console.print_line(sum<Money>(gold).cents.to_string());
        console.print_line(reversed<Gold>().cents.to_string());
        console.print_line(shadowed<Money>().to_string());
        console.print_line(Money.zero().cents.to_string());
        return program.ExitCode.Ok;
    };
);
