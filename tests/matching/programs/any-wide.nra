let console = import:Std.Io.Console;
let program = import:Std.Program;

let App = module:program.Entry (
    .NoInline
    let unpack = func(value: any) -> int => match.is (value) {
        number: int32 => number,
        _ => -100000,
    };

    .NoInline
    let sum = func(
        v00: any,
        v01: any,
        v02: any,
        v03: any,
        v04: any,
        v05: any,
        v06: any,
        v07: any,
        v08: any,
        v09: any,
        v10: any,
        v11: any,
        v12: any,
