            65 as int32,
            66 as int32,
            67 as int32,
            68 as int32,
            69 as int32,
            70 as int32
        );
        if (result != 2485) {
            console.println("wide mismatch {}", result);
            return program.ExitCode.Failure;
        }
        console.print_line("wide 2485 ok");
        return program.ExitCode.Ok;
    };
);
