        total = total + unpack(v51);
        total = total + unpack(v52);
        total = total + unpack(v53);
        total = total + unpack(v54);
        total = total + unpack(v55);
        total = total + unpack(v56);
        total = total + unpack(v57);
        total = total + unpack(v58);
        total = total + unpack(v59);
        total = total + unpack(v60);
        total = total + unpack(v61);
        total = total + unpack(v62);
        total = total + unpack(v63);
        total = total + unpack(v64);
        total = total + unpack(v65);
        total = total + unpack(v66);
        total = total + unpack(v67);
        total = total + unpack(v68);
        total = total + unpack(v69);
        return total;
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        let result = sum(
            1 as int32,
            2 as int32,
            3 as int32,
            4 as int32,
            5 as int32,
            6 as int32,
