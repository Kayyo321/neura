        v62: any,
        v63: any,
        v64: any,
        v65: any,
        v66: any,
        v67: any,
        v68: any,
        v69: any
    ) -> int {
        let total = 0;
        total = total + unpack(v00);
        total = total + unpack(v01);
        total = total + unpack(v02);
        total = total + unpack(v03);
        total = total + unpack(v04);
        total = total + unpack(v05);
        total = total + unpack(v06);
        total = total + unpack(v07);
        total = total + unpack(v08);
        total = total + unpack(v09);
        total = total + unpack(v10);
        total = total + unpack(v11);
        total = total + unpack(v12);
        total = total + unpack(v13);
        total = total + unpack(v14);
        total = total + unpack(v15);
        total = total + unpack(v16);
        total = total + unpack(v17);
        total = total + unpack(v18);
        total = total + unpack(v19);
        total = total + unpack(v20);
        total = total + unpack(v21);
        total = total + unpack(v22);
        total = total + unpack(v23);
        total = total + unpack(v24);
        total = total + unpack(v25);
        total = total + unpack(v26);
        total = total + unpack(v27);
        total = total + unpack(v28);
        total = total + unpack(v29);
        total = total + unpack(v30);
        total = total + unpack(v31);
        total = total + unpack(v32);
        total = total + unpack(v33);
        total = total + unpack(v34);
        total = total + unpack(v35);
        total = total + unpack(v36);
        total = total + unpack(v37);
        total = total + unpack(v38);
        total = total + unpack(v39);
        total = total + unpack(v40);
