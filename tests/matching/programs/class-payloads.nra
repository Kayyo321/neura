// Nested patterns over class payloads in a loop and in a recursive
// function, with enough allocation to collect (docs/design/Matching030.md,
// edge cases 39 and 41).
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Owner = class (
    export let name: string = "";
    export let score: int = 0;
);

let Leaf = enum (Plain(int), Owned(Owner, int));
let Link = class (
    export last item: Tagged;
    export let init = func(item: Tagged) => set;
);
let Tagged = enum (Plain(int), Owned(Owner, int), Pair(Leaf, Link));

let make = func(i: int) -> Tagged {
    let owner = new Owner();
    owner.name = "owner" + i.to_string();
    owner.score = i;
    return i % 3 == 0 ? Tagged.Plain(i) : i % 3 == 1 ? Tagged.Owned(owner, i) : Tagged.Pair(Leaf.Owned(owner, i), new Link(Tagged.Plain(i)));
};

let sum = func(item: Tagged) -> int => match (item) {
    Tagged.Plain(n) => n,
    Tagged.Owned(owner, n) if owner.score > 1000 => 0,
    Tagged.Owned(owner, n) => owner.score + n,
    Tagged.Pair(Leaf.Owned(owner, _), rest) => owner.score + sum(rest.item),
    Tagged.Pair(Leaf.Plain(n), rest) => n + sum(rest.item),
};

export let Main = module : program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let total = 0;
        let last_name = "";
        for (let i = 0; i < 3000; i += 1) {
            let item = make(i);
            let garbage = new int[list]([i, i, i, i, i, i, i, i]);
            total += sum(item) + garbage.length - 8;
            match (item) {
                Tagged.Pair(Leaf.Owned(owner, _), _) if i > 2990 => {
                    last_name = owner.name;
                    if (i == 2999) {
                        break;
                    }
                },
                _ => {},
            }
        }
        console.println("{} {}", total, last_name);
        return program.ExitCode.Ok;
    };
);
