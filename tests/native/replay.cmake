# Records a Std.DynamicForeign run and replays it without the native
# capability or the library: every native request is answered from the trace,
# so the replay reproduces the console output, including output printed by
# upcalls during a native call (ForeignInterop.md, determinism).
if(NOT DEFINED NEURA OR NOT DEFINED SOURCE_DIR OR NOT DEFINED TEST_DIR OR NOT DEFINED NATIVE_DIR)
    message(FATAL_ERROR "Provide NEURA, SOURCE_DIR, TEST_DIR, and NATIVE_DIR")
endif()
file(REMOVE_RECURSE "${TEST_DIR}")
file(MAKE_DIRECTORY "${TEST_DIR}")
function(run prefix executable)
    execute_process(COMMAND "${executable}" ${ARGN} WORKING_DIRECTORY "${TEST_DIR}"
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "${ARGN} returned ${status}\n${stdout}${stderr}")
    endif()
    set("${prefix}_stdout" "${stdout}" PARENT_SCOPE)
endfunction()

foreach(name IN ITEMS scalars upcalls)
    set(program "${SOURCE_DIR}/tests/stdlib/dynamic-foreign/programs/${name}.nra")
    file(READ "${SOURCE_DIR}/tests/stdlib/dynamic-foreign/programs/${name}.out" expected)
    run(build "${NEURA}" build "${program}" -o ${name}.nvr)
    run(recorded "${NEURA}" run --allow-native --record ${name}.trace ${name}.nvr -- "${NATIVE_DIR}/libmathops.so")
    if(NOT recorded_stdout STREQUAL expected)
        message(FATAL_ERROR "${name}: recorded run output differs:\n${recorded_stdout}")
    endif()
    run(replayed "${NEURA}" run --replay ${name}.trace ${name}.nvr -- "${NATIVE_DIR}/libmathops.so")
    if(NOT replayed_stdout STREQUAL expected)
        message(FATAL_ERROR "${name}: replayed run output differs:\n${replayed_stdout}")
    endif()
    file(STRINGS "${TEST_DIR}/${name}.trace" calls REGEX "^request neura[.]ffi[.]call")
    file(STRINGS "${TEST_DIR}/${name}.trace" callbacks REGEX "^callback neura[.]ffi[.]upcall")
    list(LENGTH calls call_count)
    list(LENGTH callbacks callback_count)
    if(call_count LESS 2 OR (name STREQUAL "upcalls" AND callback_count LESS 2))
        message(FATAL_ERROR "${name}: the trace should hold the native calls and callbacks")
    endif()
    message(STATUS "${name}: ${call_count} native calls and ${callback_count} callbacks recorded and replayed")
endforeach()

if(DEFINED NATIVE_TOOLCHAIN)
    run(build "${NATIVE_TOOLCHAIN}" build "${SOURCE_DIR}/tests/backend/programs/computation.nra" -o packed.nvr)
    run(package "${NATIVE_TOOLCHAIN}" build --native packed.nvr -o packed)

    run(cpu "${NEURA}" run --no-gpu --record cpu.trace packed.nvr)
    set(ENV{NEURA_RUN_OPTIONS} "--record native.trace")
    run(native "${TEST_DIR}/packed")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${TEST_DIR}/cpu.trace" "${TEST_DIR}/native.trace"
        RESULT_VARIABLE different)
    file(STRINGS "${TEST_DIR}/cpu.trace" requests REGEX "^request ")
    list(LENGTH requests count)
    if(NOT different STREQUAL "0" OR count LESS 2 OR NOT native_stdout STREQUAL cpu_stdout)
        message(FATAL_ERROR "native and neura run recordings must match byte for byte and contain multiple requests")
    endif()

    set(ENV{NEURA_RUN_OPTIONS} "--replay cpu.trace")
    run(from_cpu "${TEST_DIR}/packed")
    unset(ENV{NEURA_RUN_OPTIONS})
    run(from_native "${NEURA}" run --no-gpu --replay native.trace packed.nvr)
    if(NOT from_cpu_stdout STREQUAL cpu_stdout OR NOT from_native_stdout STREQUAL cpu_stdout)
        message(FATAL_ERROR "native and neura run must replay each other's traces")
    endif()
endif()

if(DEFINED NATIVE_TOOLCHAIN)
    # Trace output must not follow symbolic links. The old temporary name
    # (<trace>.tmp) and the destination itself are planted as links to files
    # the test owns; neither file may change, the trace must be written in
    # place of the destination link, and it must replay.
    file(MAKE_DIRECTORY "${TEST_DIR}/links")
    file(WRITE "${TEST_DIR}/links/victim-temporary" "victim of the temporary name\n")
    file(WRITE "${TEST_DIR}/links/victim-destination" "victim of the destination\n")
    file(CREATE_LINK "${TEST_DIR}/links/victim-temporary" "${TEST_DIR}/links/rec.tmp" SYMBOLIC)
    file(CREATE_LINK "${TEST_DIR}/links/victim-destination" "${TEST_DIR}/links/rec" SYMBOLIC)
    set(ENV{NEURA_RUN_OPTIONS} "--record links/rec")
    run(linked "${TEST_DIR}/packed")
    unset(ENV{NEURA_RUN_OPTIONS})
    file(READ "${TEST_DIR}/links/victim-temporary" temporary_victim)
    file(READ "${TEST_DIR}/links/victim-destination" destination_victim)
    if(NOT temporary_victim STREQUAL "victim of the temporary name\n" OR
       NOT destination_victim STREQUAL "victim of the destination\n")
        message(FATAL_ERROR "recording followed a symbolic link and changed another file")
    endif()
    if(IS_SYMLINK "${TEST_DIR}/links/rec" OR NOT IS_SYMLINK "${TEST_DIR}/links/rec.tmp")
        message(FATAL_ERROR "the trace should replace the destination link and leave the planted temporary link alone")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${TEST_DIR}/cpu.trace" "${TEST_DIR}/links/rec"
        RESULT_VARIABLE different)
    if(NOT different STREQUAL "0")
        message(FATAL_ERROR "the trace written beside planted links differs from the CPU recording")
    endif()
    set(ENV{NEURA_RUN_OPTIONS} "--replay links/rec")
    run(linked_replay "${TEST_DIR}/packed")
    unset(ENV{NEURA_RUN_OPTIONS})
    if(NOT linked_replay_stdout STREQUAL cpu_stdout)
        message(FATAL_ERROR "the trace written beside planted links does not replay")
    endif()
    file(GLOB leftovers "${TEST_DIR}/links/.rec.*")
    if(leftovers)
        message(FATAL_ERROR "recording left temporary files: ${leftovers}")
    endif()

    # A destination that cannot be written reports the failure and leaves no
    # temporary file behind.
    file(MAKE_DIRECTORY "${TEST_DIR}/unwritable")
    set(ENV{NEURA_RUN_OPTIONS} "--record unwritable/missing/rec")
    execute_process(COMMAND "${TEST_DIR}/packed" WORKING_DIRECTORY "${TEST_DIR}"
        RESULT_VARIABLE failed_status OUTPUT_VARIABLE failed_stdout ERROR_VARIABLE failed_stderr)
    unset(ENV{NEURA_RUN_OPTIONS})
    file(GLOB_RECURSE stray "${TEST_DIR}/unwritable/*")
    if(NOT failed_status STREQUAL "1" OR NOT failed_stderr MATCHES "error: cannot write unwritable/missing/rec" OR stray)
        message(FATAL_ERROR "a failed trace write should exit 1 without leftovers\n${failed_status}\n${failed_stderr}\n${stray}")
    endif()
endif()
