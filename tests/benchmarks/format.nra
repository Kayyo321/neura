// sizes: 100 200
// scaling: 2.1
// Formats n integers in decimal, hexadecimal, and zero-padded form.
let builders = import:Std.Core.StringBuilder;
let console = import:Std.Io.Console;
let int32s = import:Std.Core.Int32;
let program = import:Std.Program;
let result = import:Std.Core.Result;

export let FormatBenchmark = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        let n = result.value_or<int32>(int32s.parse(args[0]), 0);
        let text = builders.create();
        let value = -2000000000;
        for (let i = 0; i < n; i = i + 1) {
            text.append(int32s.to_string(value)).append(" ");
            text.append(int32s.to_string_radix(value, 16)).append(" ");
            text.append(int32s.format(value, 10, 12, "0")).append_line("");
            if (value > 2000000000 - 39999999) {
                value = -2000000000;
            }
            value = value + 39999999;
        }
        if (text.byte_length() < n * 30) {
            console.print_line("too short");
            return program.ExitCode.Failure;
        }
        console.print_line("ok");
        return program.ExitCode.Ok;
    };
);
