// Measurement workload for docs/lang/Concurrency.md section 16, phase 4: a
// producer, four workers, and a collector joined by two bounded channels,
// moving 200,000 messages. With the argument "sequential" the same work runs
// in a plain loop on the root task, which is the baseline.
let console = import:Std.Io.Console;
let program = import:Std.Program;
let channels = import:Std.Concurrent.Channel;

const messages: int = 200000;

// A few steps of arithmetic per message.
let work = func(value: int) -> int {
    let x = value;
    for (let round: int = 0; round < 4; round++) {
        x = (x * 31 + 7) % 1000003;
    }
    return x;
};

let produce = func(jobs: channels.Sender<int>, done: channels.Closer<int>) {
    for (let i: int = 0; i < messages; i++) {
        jobs.send(i);
    }
    done.close();
};

let serve = func(jobs: channels.Receiver<int>, results: channels.Sender<int>) {
    do {
        match (jobs.receive()) {
            channels.Received.Value(value) => {
                results.send(work(value));
            },
            _ => {
                return;
            },
        }
    }
};

export let Main = module : program.Entry (
    export let.override main = func(arguments: string[]) -> program.ExitCode {
        let total: int64 = 0;
        if (arguments.length > 0 && arguments[0] == "sequential") {
            for (let i: int = 0; i < messages; i++) {
                total = total + (work(i) as int64);
            }
        } else {
            let [jobs, incoming, jobs_closer] = channels.open<int>(64);
            let [results, outgoing, results_closer] = channels.open<int>(64);
            scope {
                spawn produce(jobs, jobs_closer);
                for (let worker: int = 0; worker < 4; worker++) {
                    spawn serve(incoming, results);
                }
                for (let i: int = 0; i < messages; i++) {
                    match (outgoing.receive()) {
                        channels.Received.Value(value) => {
                            total = total + (value as int64);
                        },
                        _ => {},
                    }
                }
            }
        }
        console.print_line(total.to_string());
        return program.ExitCode.Ok;
    };
);
