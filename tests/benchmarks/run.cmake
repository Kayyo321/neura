# Cost baseline for representative standard library workloads (Stdlib.md
# section 17). Each benchmark is a program in this directory whose header
# names the sizes it runs at and the largest acceptable growth of its step
# count from the first size to the second:
#
#   // sizes: <n1> <n2>
#   // scaling: <maximum steps(n2) / steps(n1)>
#
# The program receives the size as its argument and prints "ok" after
# checking its own result. Every run reports steps, peak heap cells, neuron
# count, and image bytes (`neura run --stats`), all deterministic. The figures
# at the first size are compared with baseline.txt: a figure more than 10%
# above its baseline fails, with the figures printed so the baseline can be
# updated with a stated reason. Run with -DUPDATE=ON to rewrite baseline.txt.
# Quoted arguments such as "steps" are strings, not variable references.
cmake_policy(SET CMP0054 NEW)
if(NOT DEFINED NEURA OR NOT DEFINED SOURCE_DIR OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "Provide NEURA, SOURCE_DIR, and TEST_DIR")
endif()
set(bench_dir "${SOURCE_DIR}/tests/benchmarks")
file(REMOVE_RECURSE "${TEST_DIR}")
file(MAKE_DIRECTORY "${TEST_DIR}")
set(baseline_file "${bench_dir}/baseline.txt")
set(baseline "")
if(EXISTS "${baseline_file}")
    file(STRINGS "${baseline_file}" baseline REGEX "^[a-z]")
endif()

function(stat_value out name text)
    string(REGEX MATCH "${name} ([0-9]+)" match "${text}")
    set("${out}" "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

file(GLOB benchmarks "${bench_dir}/*.nra")
list(SORT benchmarks)
set(lines "# name size steps peak_heap_cells neurons image_bytes steps_at_second_size")
set(failures "")
foreach(source IN LISTS benchmarks)
    get_filename_component(name "${source}" NAME_WE)
    file(STRINGS "${source}" sizes_line REGEX "^// sizes: ")
    file(STRINGS "${source}" scaling_line REGEX "^// scaling: ")
    string(REGEX REPLACE "^// sizes: " "" sizes "${sizes_line}")
    string(REGEX REPLACE "^// scaling: " "" scaling "${scaling_line}")
    separate_arguments(sizes)
    list(GET sizes 0 first)
    list(GET sizes 1 second)
    execute_process(COMMAND "${NEURA}" build "${source}" -o "${TEST_DIR}/${name}.nvr"
        RESULT_VARIABLE status ERROR_VARIABLE errors)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "${name}: build failed\n${errors}")
    endif()
    set(steps_list "")
    foreach(size IN ITEMS ${first} ${second})
        execute_process(COMMAND "${NEURA}" run --stats "${TEST_DIR}/${name}.nvr" -- ${size}
            RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
        if(NOT status STREQUAL "0" OR NOT stdout STREQUAL "ok\n")
            message(FATAL_ERROR "${name} ${size}: status ${status}, stdout '${stdout}'\n${stderr}")
        endif()
        stat_value(steps "steps" "${stderr}")
        list(APPEND steps_list ${steps})
        if(size STREQUAL first)
            stat_value(peak "peak heap cells" "${stderr}")
            stat_value(neurons "neurons" "${stderr}")
            stat_value(bytes "image bytes" "${stderr}")
        endif()
    endforeach()
    list(GET steps_list 0 steps_first)
    list(GET steps_list 1 steps_second)
    # Fixed-point ratio in hundredths, compared with the declared bound.
    math(EXPR ratio "${steps_second} * 100 / ${steps_first}")
    string(REPLACE "." "" bound_digits "${scaling}")
    math(EXPR bound "${bound_digits} * 10")
    if(scaling MATCHES "^[0-9]+[.][0-9][0-9]$")
        math(EXPR bound "${bound_digits}")
    endif()
    message(STATUS "${name}: n=${first} steps ${steps_first}, peak heap cells ${peak}, neurons ${neurons}, "
                   "image bytes ${bytes}; n=${second} steps ${steps_second} (x${ratio}/100, bound ${scaling})")
    if(ratio GREATER bound)
        list(APPEND failures "${name}: steps grew x${ratio}/100 from ${first} to ${second}, above ${scaling}")
    endif()
    list(APPEND lines "${name} ${first} ${steps_first} ${peak} ${neurons} ${bytes} ${steps_second}")
    foreach(line IN LISTS baseline)
        if(line MATCHES "^${name} ")
            string(REPLACE " " ";" fields "${line}")
            list(GET fields 1 base_size)
            set(index 2)
            foreach(label IN ITEMS steps peak_heap_cells neurons image_bytes)
                list(GET fields ${index} base)
                if(label STREQUAL "steps")
                    set(current ${steps_first})
                elseif(label STREQUAL "peak_heap_cells")
                    set(current ${peak})
                elseif(label STREQUAL "neurons")
                    set(current ${neurons})
                else()
                    set(current ${bytes})
                endif()
                math(EXPR limit "${base} + ${base} / 10")
                if(base_size STREQUAL first AND current GREATER limit)
                    list(APPEND failures "${name}: ${label} ${current} exceeds the baseline ${base} by more than 10%")
                endif()
                math(EXPR index "${index} + 1")
            endforeach()
        endif()
    endforeach()
endforeach()
if(UPDATE)
    list(JOIN lines "\n" text)
    file(WRITE "${baseline_file}" "${text}\n")
    message(STATUS "wrote ${baseline_file}")
endif()
if(failures)
    list(JOIN failures "\n" text)
    message(FATAL_ERROR "${text}")
endif()
