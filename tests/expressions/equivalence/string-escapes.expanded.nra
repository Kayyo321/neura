// String escapes (docs/design/Expressions030.md, Escapes): a literal written
// with \u, \x and \' escapes builds the image of the same text written
// out, since the lexer decodes escapes into the literal's bytes.
let console = import:Std.Io.Console;
let program = import:Std.Program;

export let Main = module : program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line("café é 😀 it's AB");
        let latin: byte = 233;
        console.print_line(latin.to_string());
        return program.ExitCode.Ok;
    };
);
