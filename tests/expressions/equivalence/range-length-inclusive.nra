// A `..=` range over the whole uint32 domain (docs/design/Expressions030.md,
// edge case 32) fails as an over-long `..` range does (range-length-exclusive),
// not with an overflow of the element count.
let console = import:Std.Io.Console;
let program = import:Std.Program;

export let Main = module : program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line("before");
        let top: uint32 = 4294967295;
        let items: uint32[] = 0 ..= top;
        console.print_line(items.length.to_string());
        return program.ExitCode.Ok;
    };
);
