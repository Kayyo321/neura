// `a !== b` (docs/design/Expressions030.md, Value inequality, edge case 46),
// built against value-inequality.expanded.nra, the same program written with
// `!(a === b)`.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Point = record (x: int, y: int);

let Box = class (
    export let size: int = 0;
    export let.override equals = func(other: class) -> bool {
        console.print_line("equals " + size.to_string());
        return other is Box && (other as Box).size == size;
    };
);

let differ = func(a: Point, b: Point, c: bool) -> string {
    let parts = (a !== b).to_string();
    parts = parts + " " + (a !== b && c).to_string();
    parts = parts + " " + (c || a !== b).to_string();
    parts = parts + " " + (a !== b == c).to_string();
    parts = parts + " " + (a
        !== // a comment
        b).to_string();
    return parts;
};

export let Main = module : program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line(differ(new Point(1, 2), new Point(1, 2), true));
        console.print_line(differ(new Point(1, 2), new Point(2, 1), false));
        let box = new Box();
        let other = new Box();
        other.size = 3;
        if (box !== other) {
            console.print_line("boxes differ");
        }
        console.print_line((box !== box).to_string());
        return program.ExitCode.Ok;
    };
);
