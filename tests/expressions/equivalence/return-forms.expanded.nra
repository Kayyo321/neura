// Return forms (docs/design/Expressions030.md, Return forms, edge cases
// 48-53): `return if` with compact arms, with and without `;` before
// `else`, and `return ... unless guard`, also over a whole `return if`,
// build the image of the `if` statements they stand for; `unless` stays an
// ordinary name elsewhere.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let sign = func(x: int) -> string {
    if (x > 0) {
        return "Positive";
    } else if (x == 0) {
        return "Zero";
    } else {
        return "Negative";
    }
};

let compact = func(c: bool) -> int {
    if (c) {
        return 1;
    } else {
        return 2;
    }
};

let note = func(text: string) -> bool {
    console.print_line("guard " + text);
    return text == "stop";
};

let guarded = func(text: string) -> string {
    if (!(note(text))) {
        return text + "!";
    }
    return "stopped";
};

let both = func(c: bool, g: bool) -> int {
    if (!(g)) {
        if (c) {
            return 10;
        } else {
            return 20;
        }
    }
    return 0;
};

let unless = 5;
let named = func -> int {
    return unless;
};

let flagged = func(flag: bool) -> int {
    if (!(flag)) {
        return unless;
    }
    return -1;
};

export let Main = module : program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line(sign(3) + " " + sign(0) + " " + sign(-2));
        console.print_line(compact(true).to_string() + " " + compact(false).to_string());
        console.print_line(guarded("go") + " " + guarded("stop"));
        console.print_line(both(true, false).to_string() + " " + both(false, false).to_string() + " " + both(true, true).to_string());
        console.print_line(named().to_string() + " " + flagged(false).to_string() + " " + flagged(true).to_string());
        return program.ExitCode.Ok;
    };
);
