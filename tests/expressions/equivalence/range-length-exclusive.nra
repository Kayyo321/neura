// An over-long `..` range: the failure that range-length-inclusive and
// range-length-int64 must match (docs/design/Expressions030.md, edge case 32).
let console = import:Std.Io.Console;
let program = import:Std.Program;

export let Main = module : program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line("before");
        let top: uint32 = 4294967295;
        let items: uint32[] = 0 .. top;
        console.print_line(items.length.to_string());
        return program.ExitCode.Ok;
    };
);
