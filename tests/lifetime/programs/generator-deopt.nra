// A generator's `$resume` in native tier 3, reached through `has_next` and
// `next` from a consuming loop (docs/design/Lifetime030.md, "Optimization
// and tiers"). The state is an object whose fields are stored before
// `$resume` returns, so a frame state inside it holds only that call's
// slots. The shapes change class late in the run. Since the resume chain
// carries lift hints, native code stays in `$resume`: the deoptimizations
// that `generator-deopt.deopt` asks for are at the host calls that print,
// not in the generator.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Shape = class (
    export let area = func() -> int {
        return 0;
    };
);

let Square = class:Shape (
    let side: int;
    export let init = func(length: int) -> void {
        super.init();
        side = length;
    };

    export let.override area = func() -> int {
        return side * side;
    };
);

let Strip = class:Shape (
    let length: int;
    export let init = func(size: int) -> void {
        super.init();
        length = size;
    };

    export let.override area = func() -> int {
        return length + 1;
    };
);

let GeneratorDeopt = module:program.Entry (
    let areas = iterator(count: int, square: Shape, strip: Shape) -> int {
        let total = 0;
        for (let index = 0; index < count; index++) {
            let shape = index < count * 3 / 4 || index % 2 == 0 ? square : strip;
            total = total + index % 5;
            yield shape.area() + total % 3;
        }
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        let sum = 0;
        let seen = 0;
        let items = areas(40000, new Square(3), new Strip(4)).iterator();
        while (items.has_next()) {
            sum = sum + items.next() % 11;
            seen = seen + 1;
        }
        console.print_line("sum " + sum.to_string());
        console.print_line("seen " + seen.to_string());
        return program.ExitCode.Ok;
    };
);
