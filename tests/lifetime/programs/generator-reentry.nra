// A generator that advances its own sequence from its body traps
// (docs/design/Lifetime030.md, edge case 70).
let console = import:Std.Io.Console;
let program = import:Std.Program;
let sequences = import:Std.Collections.Sequence;
let.promote _ = import:Std.Collections.Iterator;

let Holder = class (
    export let items: Iterator<int> = nil;
);

let GeneratorReentry = module:program.Entry (
    let holder = new Holder();

    let looping = iterator() -> int {
        yield 1;
        console.print_line("advancing itself");
        yield holder.items.next();
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        holder.items = looping().iterator();
        console.print_line(holder.items.next().to_string());
        console.print_line(holder.items.next().to_string());
        return program.ExitCode.Ok;
    };
);
