// Tier 3 deoptimization between a defer and its exit, and inside a
// deferred call inlined into its caller (docs/design/Lifetime030.md,
// "Optimization and tiers"). The shapes change class late in the loop, so
// native code compiled for the first class leaves at a class test while
// deferred calls are pending; the saved values are frame slots, and the
// frame states rebuild them.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Shape = class (
    export let area = func() -> int {
        return 0;
    };
);

let Square = class:Shape (
    let side: int;
    export let init = func(length: int) -> void {
        super.init();
        side = length;
    };
    export let.override area = func() -> int {
        return side * side;
    };
);

let Strip = class:Shape (
    let length: int;
    export let init = func(size: int) -> void {
        super.init();
        length = size;
    };
    export let.override area = func() -> int {
        return length + 1;
    };
);

let Tally = class (
    export let total: int = 0;
    export let calls: int = 0;
    export let add = func(value: int) -> void {
        total = total + value % 7;
        calls = calls + 1;
    };
);

let DeferDeopt = module:program.Entry (
    let tally = new Tally();

    let step = func(shape: Shape, index: int) -> int {
        defer tally.add(index);
        let area = shape.area();
        defer tally.add(area);
        return area % 11;
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        let sum = 0;
        let square: Shape = new Square(3);
        let strip: Shape = new Strip(4);
        for (let index = 0; index < 40000; index++) {
            let shape = index < 30000 || index % 2 == 0 ? square : strip;
            sum = sum + step(shape, index);
        }
        console.print_line("sum " + sum.to_string());
        console.print_line("total " + tally.total.to_string());
        console.print_line("calls " + tally.calls.to_string());
        return program.ExitCode.Ok;
    };
);
