let error = import:Std.Core.Error;
let randoms = import:Std.Random.Random;
let test = import:Std.Test;

// Without --allow-entropy, from_entropy fails with CapabilityDenied.
let EntropyDeniedTests = module (
    export let test_from_entropy_is_denied = func() -> void {
        let failure = test.assert_err<randoms.Random>(randoms.from_entropy());
        test.assert_equal_string("CapabilityDenied: entropy request failed", error.message(failure));
        match (failure) {
            error.Error.Io { kind, message: _, path } => {
                test.assert(kind == error.IoErrorKind.CapabilityDenied);
                test.assert_equal_string("", path);
            },
            _ => {
                test.fail("expected an Io error");
            },
        }
    };
);
