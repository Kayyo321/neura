// status: 70
// stderr: explicit program failure \(trap reason 3\): invalid argument: negative count
let console = import:Std.Io.Console;
let program = import:Std.Program;
let randoms = import:Std.Random.Random;

export let Main = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        let r = randoms.seeded(1);
        console.print_line("before");
        console.print_line(r.fill_bytes(-1).to_string());
        return program.ExitCode.Ok;
    };
);
