// run-options: --replay @AREA_DIR@/programs/entropy-failures.trace
let console = import:Std.Io.Console;
let error = import:Std.Core.Error;
let program = import:Std.Program;
let randoms = import:Std.Random.Random;
let result = import:Std.Core.Result;

// Entropy failures answered from a hand-written trace: a host error code
// and a response with the wrong number of bytes.
export let EntropyFailures = module:program.Entry (
    let attempt = func() -> void {
        match (randoms.from_entropy()) {
            result.Result.Ok(r) => {
                console.print_line("seeded: " + r.next_uint64().to_string());
            },
            result.Result.Err(failure) => {
                console.print_line(error.message(failure));
            },
        }
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        attempt();
        attempt();
        attempt();
        attempt();
        return program.ExitCode.Ok;
    };
);
