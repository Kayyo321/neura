// status: 70
// stderr: index out of bounds
let console = import:Std.Io.Console;
let immutable_list = import:Std.Collections.ImmutableList;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        console.print_line(immutable_list.of<int>([1]).get(1).to_string());
        return program.ExitCode.Ok;
    };
);
