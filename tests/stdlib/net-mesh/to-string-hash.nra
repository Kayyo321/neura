let baggage = import:Std.Net.Mesh.Baggage;
let.promote _ = import:Std.Core.Optional;
let ebpf = import:Std.Net.Mesh.Ebpf;
let proxy = import:Std.Net.Mesh.ProxyProtocol;
let test = import:Std.Test;
let trace_context = import:Std.Net.Mesh.TraceContext;
let trace_parent = import:Std.Net.Mesh.TraceParent;
let trace_state = import:Std.Net.Mesh.TraceState;

// Part 4 of the 0.3.0 stdlib pass: to_string, equals and hash_code of the Std.Net.Mesh value classes agree.
let ToStringHashTests = module (
    let agree = func(a: class, b: class) {
        test.assert(a.equals(b));
        test.assert(b.equals(a));
        test.assert_equal_int64(a.hash_code() as int64, b.hash_code() as int64);
    };

    let differ = func(a: class, b: class) {
        test.assert(not a.equals(b));
        test.assert(not b.equals(a));
    };

    let parent = func(text: string) -> trace_parent.TraceParent => test.assert_ok<trace_parent.TraceParent>(trace_parent.parse(text));

    let state = func(text: string) -> trace_state.TraceState => test.assert_ok<trace_state.TraceState>(trace_state.parse(text));

    let bag = func(text: string) -> baggage.Baggage => test.assert_ok<baggage.Baggage>(baggage.parse(text));

    export let test_trace_parent = func {
        last text = "00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01";
        agree(parent(text), parent(text));
        differ(parent(text), parent("00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-00"));
        test.assert_equal_string(text, parent(text).to_string());
    };

    export let test_trace_state = func {
        agree(state("a=1,b=2"), state("a=1,b=2"));
        differ(state("a=1,b=2"), state("a=1,b=3"));
        test.assert_equal_string("a=1,b=2", state("a=1,b=2").to_string());
    };

    export let test_baggage = func {
        last a = bag("user=alice;ttl=60,region=eu");
        agree(a, bag("user=alice;ttl=60,region=eu"));
        differ(a, bag("user=bob;ttl=60,region=eu"));
        test.assert_equal_string("Baggage(2 members)", a.to_string());
        agree(a.entry_at(0), bag("user=alice;ttl=60").entry_at(0));
        differ(a.entry_at(0), a.entry_at(1));
        test.assert(a.entry_at(0).to_string().byte_length > 0);
    };

    export let test_trace_context = func {
        last a = new trace_context.TraceContext(Optional<trace_parent.TraceParent>.Some(parent(
            "00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01")), state("a=1"), bag("k=v"));
        last b = new trace_context.TraceContext(Optional<trace_parent.TraceParent>.Some(parent(
            "00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01")), state("a=1"), bag("k=v"));
        agree(a, b);
        differ(a, trace_context.empty());
        test.assert_equal_string(a.to_string(), b.to_string());
    };

    export let test_proxy_protocol = func {
        last t = new proxy.Tlv(4, new([1, 2, 3]));
        agree(t, new proxy.Tlv(4, new([1, 2, 3])));
        differ(t, new proxy.Tlv(4, new([1, 2, 4])));
        test.assert_equal_string("Tlv(4, 3 bytes)", t.to_string());
        last s = new proxy.SslInfo(1, 0, new([t]));
        agree(s, new proxy.SslInfo(1, 0, new([new proxy.Tlv(4, new([1, 2, 3]))])));
        differ(s, new proxy.SslInfo(1, 1, new([t])));
        test.assert_equal_string("SslInfo(client 1, verify 0, 1 sub-TLVs)", s.to_string());
    };

    export let test_ebpf = func {
        last p = new ebpf.EbpfProgram("redirect", ebpf.AttachPoint.SkMsg, "GPL", new([1, 2, 3, 4, 5, 6, 7, 8]));
        agree(p, new ebpf.EbpfProgram("redirect", ebpf.AttachPoint.SkMsg, "GPL", new([1, 2, 3, 4, 5, 6, 7, 8])));
        differ(p, new ebpf.EbpfProgram("redirect", ebpf.AttachPoint.SkLookup, "GPL", new([1, 2, 3, 4, 5, 6, 7, 8])));
        test.assert_equal_string("EbpfProgram(redirect, SkMsg, 1 instructions)", p.to_string());
        last m = new ebpf.RedirectMap("socks", ebpf.MapKind.SockMap, 4, 64);
        agree(m, new ebpf.RedirectMap("socks", ebpf.MapKind.SockMap, 4, 64));
        differ(m, new ebpf.RedirectMap("socks", ebpf.MapKind.SockHash, 4, 64));
        test.assert_equal_string("RedirectMap(socks, SockMap, key 4 bytes, 64 entries)", m.to_string());
        last lp = new ebpf.LoadedProgram(7, ebpf.AttachPoint.SkMsg);
        agree(lp, new ebpf.LoadedProgram(7, ebpf.AttachPoint.SkMsg));
        differ(lp, new ebpf.LoadedProgram(8, ebpf.AttachPoint.SkMsg));
        test.assert_equal_string("LoadedProgram(7, SkMsg)", lp.to_string());
        last lm = new ebpf.LoadedMap(9, m);
        agree(lm, new ebpf.LoadedMap(9, m));
        differ(lm, new ebpf.LoadedMap(10, m));
        test.assert_equal_string("LoadedMap(9, socks)", lm.to_string());
    };
);
