// status: 134
// stderr: unsupported: Std.Net.Mesh.Ebpf.host_load is not implemented in Neura 0.3.0 \(needs the host service neura.net.ebpf.prog_load\)
// Loading a valid eBPF program reaches the host stub, which traps: Neura 0.3.0 has no eBPF host service.
let console = import:Std.Io.Console;
let ebpf = import:Std.Net.Mesh.Ebpf;
let program = import:Std.Program;

let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        last code: uint8[list] = new;
        for (let i = 0; i < 16; i++) {
            code.append(0);
        }
        last sockops = new ebpf.EbpfProgram("sockops", ebpf.AttachPoint.SockOps, "GPL", code);
        console.print_line(sockops.to_string());
        last loaded = ebpf.load(sockops);
        console.print_line("unreachable");
        return program.ExitCode.Ok;
    };
);
