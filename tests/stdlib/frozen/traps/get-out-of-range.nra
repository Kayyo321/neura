// status: 139
// stderr: index out of bounds
// Components030 case 43: get(length) traps as a list index does.
let console = import:Std.Io.Console;
let frozen = import:Std.Collections.Frozen;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let items = frozen.of<int32>(1, 2);
        console.print_line(items.get(items.length()).to_string());
        return program.ExitCode.Ok;
    };
);
