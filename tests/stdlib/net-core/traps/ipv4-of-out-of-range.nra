// status: 134
// stderr: Ipv4Addr[.]of: a part is outside 0 to 255
// Ipv4Addr.of traps on a part outside 0 to 255.
let console = import:Std.Io.Console;
let v4 = import:Std.Net.Core.Ipv4Addr;
let program = import:Std.Program;

let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line("before");
        console.print_line(v4.of(10, 0, 256, 1).to_string());
        return program.ExitCode.Ok;
    };
);
