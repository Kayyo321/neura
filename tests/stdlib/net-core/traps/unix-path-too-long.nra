// status: 134
// stderr: UnixAddr: name longer than 107 bytes
// UnixAddr.of_path traps on a path that does not fit sun_path (108 bytes with the NUL).
let console = import:Std.Io.Console;
let program = import:Std.Program;
let unix = import:Std.Net.Core.UnixAddr;

let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line("before");
        let path = "/";
        for (let i = 0; i < 107; i++) {
            path += "a";
        }
        console.print_line(unix.of_path(path).to_string());
        return program.ExitCode.Ok;
    };
);
