// status: 134
// stderr: SocketAddr: port outside 0 to 65535
// SocketAddr traps on a port outside 0 to 65535.
let console = import:Std.Io.Console;
let v4 = import:Std.Net.Core.Ipv4Addr;
let program = import:Std.Program;
let sockets = import:Std.Net.Core.SocketAddr;

let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line("before");
        console.print_line(sockets.of_v4(v4.localhost(), 65536).to_string());
        return program.ExitCode.Ok;
    };
);
