// status: 134
// stderr: ByteRing: capacity must be at least 1
// A ByteRing needs a capacity of at least one byte.
let rings = import:Std.Net.Core.ByteRing;
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line("before");
        console.print_line((new rings.ByteRing(0)).to_string());
        return program.ExitCode.Ok;
    };
);
