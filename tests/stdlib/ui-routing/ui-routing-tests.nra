let model = import:Std.Ui.ModelHost;
let result = import:Std.Core.Result;
let routing = import:Std.Ui.Routing;
let test = import:Std.Test;
let ui = import:Std.Ui;

let page_view = html(title: string) {
    <h1>{title}</h1>
};

let shell_view = html(href: ui.Url, on_go: func(ui.ClickEvent) -> void, content: ui.View) {
    <nav><a href={href} on:click.prevent_default={on_go}>Parts</a></nav>
    <main>{content}</main>
};

let UiRoutingTests = module (
    let mounted = func(host: model.Host, target: string, top: ui.Component) -> ui.Root =>
        test.assert_ok<ui.Root>(ui.mount(host, target, top));

    let join = func(items: string[list]) -> string {
        let text = "";
        for (let i = 0; i < items.length; i++) {
            if (i > 0) {
                text = text + "; ";
            }
            text = text + items[i];
        }
        return text;
    };

    // A page component that records each render.
    let page = func(title: string, trace: string[list]) -> ui.Component =>
        ui.component<string>(new ui.State<string>(title), new func(text: string) -> ui.View {
            trace.append("render " + text);
            return page_view(text);
        });

    let parts_router = func(trace: string[list]) -> routing.Router {
        let router = new routing.Router();
        router.add("/", new func(params: routing.Params) -> ui.Component => page("home", trace));
        router.add("/parts", new func(params: routing.Params) -> ui.Component => page("parts", trace));
        router.add("/parts/{id}", new func(params: routing.Params) -> ui.Component =>
            page("part " + params.get("id"), trace));
        router.add("/parts/new", new func(params: routing.Params) -> ui.Component => page("new part", trace));
        router.add("/shelves/{shelf}/parts/{id}", new func(params: routing.Params) -> ui.Component =>
            page("shelf " + params.get("shelf") + " part " + params.get("id"), trace));
        router.otherwise(new func(path: string) -> ui.Component => page("missing " + path, trace));
        return router;
    };

    // Matching: literals, parameters, a literal over a parameter, a trailing slash, a query, percent
    // escapes, and paths that match nothing.
    export let test_resolve = func() -> void {
        let trace: string[list] = new;
        let router = parts_router(trace);
        test.assert_equal_string("/", router.resolve("/").route);
        test.assert_equal_string("/parts", router.resolve("/parts/").route);
        let part = router.resolve("/parts/7?tab=stock#top");
        test.assert_equal_string("/parts/{id}", part.route);
        test.assert_equal_string("7", part.params.get("id"));
        test.assert_equal_string("tab=stock", part.query);
        test.assert_equal_string("/parts/7?tab=stock", part.to_string());
        test.assert_equal_string("/parts/new", router.resolve("/parts/new").route);
        let nested = router.resolve("/shelves/a%2Fb/parts/%E2%9C%93");
        test.assert_equal_string("{shelf=a/b, id=✓}", nested.params.to_string());
        test.assert(!router.resolve("/parts/%zz").matched());
        test.assert(!router.resolve("/parts/7/extra").matched());
        test.assert(!router.resolve("/Parts").matched());
        test.assert(!router.resolve("/parts//").matched());
        test.assert(router.resolve("/parts/7").equals(router.resolve("/parts/7")));
        test.assert_equal_int32(5, router.route_count() as int32);
    };

    // A deep link: mounted on a host whose history starts at /parts/7, the router shows that part;
    // navigate pushes, back and forward are turns, and the replaced page is unmounted.
    export let test_history = func() -> void {
        let trace: string[list] = new;
        let router = parts_router(trace);
        let host = new model.Host();
        host.start_at("/parts/7");
        let top = router.component();
        let root = mounted(host, "#app", top);
        test.assert_equal_string("render part 7", join(trace));
        last first_page = router.current_page();
        host.click(1, top, router.on_link("/parts/new"));
        host.end_batch();
        host.back();
        host.end_batch();
        host.forward();
        host.end_batch();
        host.navigate_externally("/nowhere");
        host.end_batch();
        root.run();
        test.assert_equal_string("render part 7; render new part; render part 7; render new part; render missing /nowhere",
                                 join(trace));
        test.assert_equal_string("/parts/7 /parts/new [/nowhere]", host.history_text());
        test.assert(!first_page.is_mounted());
        test.assert_equal_string("#/parts/7", router.href("/parts/7"));
        host.use_history_routing();
        test.assert_equal_string("/parts/7", router.href("/parts/7"));
        router.replace("/");
        test.assert_equal_string("/parts/7 /parts/new [/]", host.history_text());
        root.close();
        test.assert_equal_int32(0, router.location.subscriber_count());
    };

    // Two navigations queued in one batch coalesce to the latest; a navigation while no router
    // listens changes nothing.
    export let test_navigations_coalesce = func() -> void {
        let trace: string[list] = new;
        let router = parts_router(trace);
        let host = new model.Host();
        let root = mounted(host, "#app", router.component());
        host.navigate_externally("/parts/1");
        host.navigate_externally("/parts/2");
        host.end_batch();
        root.run();
        test.assert_equal_string("render home; render part 2", join(trace));
        test.assert(root.stats().turns == 1);
    };

    // Without a history host the router still navigates, and links use the hash form.
    export let test_without_history = func() -> void {
        let trace: string[list] = new;
        let router = parts_router(trace);
        router.navigate("/parts");
        test.assert_equal_string("#/parts/3", router.href("/parts/3"));
        test.assert_equal_string("/parts", router.location.get().route);
        test.assert_equal_string("Router(5 routes, at /parts)", router.to_string());
    };

    // A router embedded in a page: a click on its link renders the router and the new page, not
    // the page around it; closing the root unmounts the router and its page.
    export let test_embedded_router = func() -> void {
        let trace: string[list] = new;
        let router = parts_router(trace);
        let host = new model.Host();
        let outer = ui.component<string>(new ui.State<string>("app"), new func(name: string) -> ui.View {
            trace.append("render " + name);
            return shell_view(router.link("/parts"), router.on_link("/parts"), ui.slot(router.component()));
        });
        let root = mounted(host, "#app", outer);
        host.click(1, outer, router.on_link("/parts"));
        host.end_batch();
        root.run();
        test.assert_equal_string("render app; render home; render parts", join(trace));
        test.assert_equal_string("open #app: root 1; commit 1 on root 1: 3 renders; push /parts; "
                                 + "commit 2 on root 1: 2 renders", join(host.log));
        root.close();
        test.assert(!router.component().is_mounted());
        test.assert(!router.current_page().is_mounted());
    };
);
