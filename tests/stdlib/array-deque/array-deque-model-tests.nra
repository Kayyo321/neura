let array_deque = import:Std.Collections.ArrayDeque;
let model_random = import:ModelRandom;
let optional = import:Std.Core.Optional;
let test = import:Std.Test;

// Drives an ArrayDeque and a plain built-in list (index 0 is the first
// element) with the same seeded operations, comparing size, contents,
// iteration order, and results and calling validate() after every one.
let ArrayDequeModelTests = module (
    let check = func(actual: array_deque.ArrayDeque<int>, model: int[list]) -> void {
        actual.validate();
        test.assert_equal_int32(model.length, actual.size());
        test.assert_equal_bool(model.length == 0, actual.is_empty());
        let walk = actual.iterator();
        let i = 0;
        while (walk.has_next()) {
            test.assert_equal_int32(model[i], walk.next());
            i = i + 1;
        }
        test.assert_equal_int32(model.length, i);
    };

    let without = func(model: int[list], index: int) -> int[list] {
        let result: int[list] = [];
        let i = 0;
        while (i < model.length) {
            if (i != index) {
                result.append(model[i]);
            }
            i = i + 1;
        }
        return result;
    };

    let prepended = func(model: int[list], value: int) -> int[list] {
        let result: int[list] = [value];
        for (let element in model) {
            result.append(element);
        }
        return result;
    };

    let run = func(seed: uint64, operations: int) -> void {
        let random = model_random.seeded(seed);
        let actual = array_deque.create<int>();
        let model: int[list] = [];
        let step = 0;
        while (step < operations) {
            let choice = random.below(100);
            let value = random.below(1000);
            let size = model.length;
            // Long runs at one end exercise the rebalancing in both
            // directions.
            if (size > 64 && choice < 40) {
                choice = choice + 40;
            }
            if (choice < 15) {
                actual.add_first(value);
                model = prepended(model, value);
            } else if (choice < 30) {
                actual.add_last(value);
                model.append(value);
            } else if (choice < 40) {
                actual.enqueue(value);
                model.append(value);
            } else if (choice < 52) {
                if (size > 0) {
                    test.assert_equal_int32(model[0], actual.remove_first());
                    model = without(model, 0);
                }
            } else if (choice < 64) {
                if (size > 0) {
                    test.assert_equal_int32(model[size - 1], actual.remove_last());
                    model = without(model, size - 1);
                }
            } else if (choice < 68) {
                if (size > 0) {
                    test.assert_equal_int32(model[0], actual.dequeue());
                    model = without(model, 0);
                }
            } else if (choice < 72) {
                let taken = actual.try_dequeue();
                if (size > 0) {
                    test.assert_equal_int32(model[0], test.assert_some<int>(taken));
                    model = without(model, 0);
                } else {
                    test.assert_none<int>(taken);
                }
            } else if (choice < 76) {
                let seen = actual.peek();
                if (size > 0) {
                    test.assert_equal_int32(model[0], test.assert_some<int>(seen));
                    test.assert_equal_int32(model[0], actual.first());
                    test.assert_equal_int32(model[size - 1], actual.last());
                } else {
                    test.assert_none<int>(seen);
                }
            } else if (choice < 84) {
                if (size > 0) {
                    let index = random.below(size);
                    test.assert_equal_int32(model[index], actual.get(index));
                }
            } else if (choice < 88) {
                let probe = model_value(model, random);
                let expected = false;
                for (let element in model) {
                    if (element == probe) {
                        expected = true;
                    }
                }
                test.assert_equal_bool(expected, actual.contains(probe));
            } else if (choice < 89) {
                actual.clear();
                let empty: int[list] = [];
                model = empty;
            } else if (choice < 94) {
                test.assert(actual.to_list().equals(model));
            } else if (choice < 97) {
                test.assert_equal_string(model.to_string(), actual.to_string());
            } else {
                let seen: int[list] = [];
                actual.for_each(func(element: int) -> void {
                    seen.append(element);
                });
                test.assert(seen.equals(model));
            }
            check(actual, model);
            step = step + 1;
        }
    };

    // A value present about half the time.
    let model_value = func(model: int[list], random: model_random.Generator) -> int {
        if (model.length > 0 && random.below(2) == 0) {
            return model[random.below(model.length)];
        }
        return random.below(1000);
    };

    export let test_model_seed_1 = func() -> void {
        run(1, 5000);
    };

    export let test_model_seed_2 = func() -> void {
        run(424242, 5000);
    };
);
