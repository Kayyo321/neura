// run-options: --max-heap-cells 20000
let array_deque = import:Std.Collections.ArrayDeque;
let console = import:Std.Io.Console;
let program = import:Std.Program;

// Adds and removes 2,000 elements of 100 cells each at both ends, with
// rebalancing in both directions. If removed elements stayed reachable the
// loop would need about 200,000 cells, far above the limit.
export let Main = module:program.Entry (
    let block = func(seed: int) -> int[list] {
        let values: int[list] = [];
        let i = 0;
        while (i < 100) {
            values.append(seed + i);
            i = i + 1;
        }
        return values;
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        let items = array_deque.create<int[list]>();
        let total: int64 = 0;
        let round = 0;
        while (round < 400) {
            items.add_last(block(round));
            items.add_last(block(round + 1));
            items.add_last(block(round + 2));
            items.add_first(block(round + 3));
            items.add_first(block(round + 4));
            total = total + (items.remove_last()[0] as int64);
            total = total + (items.remove_last()[0] as int64);
            total = total + (items.remove_last()[0] as int64);
            total = total + (items.remove_last()[0] as int64);
            if (round % 2 == 0) {
                total = total + (items.remove_first()[0] as int64);
            } else {
                items.clear();
            }
            round = round + 1;
        }
        console.print_line(items.size().to_string() + " " + total.to_string());
        return program.ExitCode.Ok;
    };
);
