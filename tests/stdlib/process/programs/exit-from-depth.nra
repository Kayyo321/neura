// status: 7
let console = import:Std.Io.Console;
let program = import:Std.Program;

// Process.exit ends the run from inside nested calls with its status;
// output written before it is kept and nothing after it runs.
export let ExitFromDepth = module:program.Entry (
    let descend = func(int depth) -> int {
        if (depth == 0) {
            console.print_line("leaving");
            program.Process.exit(7);
        }
        let below = descend(depth - 1);
        console.print_line("not reached");
        return below;
    };

    export let.override main = func(string[] args) -> program.ExitCode {
        console.print_line("start");
        descend(5);
        console.print_line("not reached");
        return program.ExitCode.Ok;
    };
);
