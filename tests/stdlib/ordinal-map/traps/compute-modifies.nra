// status: 70
// stderr: explicit program failure \(trap reason 3\): collection modified during iteration
let optional = import:Std.Core.Optional;
let ordinal_map = import:Std.Collections.OrdinalMap;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        let items = ordinal_map.create<int>(3);
        let result = items.compute(0, func(int key, optional.Optional<int> current) -> optional.Optional<int> {
            items.set(2, 1);
            return current;
        });
        return program.ExitCode.Ok;
    };
);
