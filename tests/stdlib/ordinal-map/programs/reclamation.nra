// run-options: --max-heap-cells 20000
let console = import:Std.Io.Console;
let optional = import:Std.Core.Optional;
let ordinal_map = import:Std.Collections.OrdinalMap;
let program = import:Std.Program;

// Stores and removes 2,000 values of 100 cells each by every kind of
// removal. If removed values stayed reachable the loop would need about
// 200,000 cells, far above the limit.
export let Main = module:program.Entry (
    let block = func(seed: int) -> int[list] {
        let values: int[list] = [];
        let i = 0;
        while (i < 100) {
            values.append(seed + i);
            i = i + 1;
        }
        return values;
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        let items = ordinal_map.create<int[list]>(16);
        let total: int64 = 0;
        let round = 0;
        while (round < 400) {
            let i = 0;
            while (i < 5) {
                items.set((round + i * 3) % 16, block(round + i));
                i = i + 1;
            }
            items.delete(round % 16);
            match (items.remove((round + 3) % 16)) {
                optional.Optional.Some(values) => {
                    total = total + (values[0] as int64);
                },
                optional.Optional.None => {},
            }
            if (round % 2 == 0) {
                items.clear();
            } else {
                let removed = items.remove_if(func(key: int, values: int[list]) -> bool {
                    return true;
                });
            }
            round = round + 1;
        }
        console.print_line(items.size().to_string() + " " + total.to_string());
        return program.ExitCode.Ok;
    };
);
