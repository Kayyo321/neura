// stderr: explicit program failure \(trap reason 3\): invalid argument: Bulletproofs needs 1, 2, 4, 8 or 16 values with matching blindings
let bulletproofs = import:Std.Crypto.Advanced.Bulletproofs;
let merlin = import:Std.Crypto.Advanced.Merlin;
let program = import:Std.Program;

let App = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let transcript: merlin.Transcript = new(new([1]));
        let values: uint64[list] = new([0, 0, 0]);
        let scalars: uint8[list][list] = new([new, new, new]);
        let _ = bulletproofs.prove_aggregate_with(transcript, 8, values, scalars, new);
        return program.ExitCode.Ok;
    };
);
