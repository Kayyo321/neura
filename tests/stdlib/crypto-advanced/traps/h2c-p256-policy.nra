// stderr: explicit program failure \(trap reason 3\): denied: P256 is not allowed under the Cnsa2_0 policy
let crypto_policy = import:Std.Crypto.Core.CryptoPolicy;
let hash_to_curve = import:Std.Crypto.Advanced.HashToCurve;
let program = import:Std.Program;

let App = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        crypto_policy.set_policy(crypto_policy.Policy.Cnsa2_0);
        let _ = hash_to_curve.hash_to_p256(new, new([1]));
        return program.ExitCode.Ok;
    };
);
