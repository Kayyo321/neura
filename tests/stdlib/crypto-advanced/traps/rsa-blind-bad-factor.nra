// stderr: explicit program failure \(trap reason 3\): invalid argument: wrong RSA blind salt or factor length
let blind = import:Std.Crypto.Advanced.RsaBlindSignature;
let cases = import:RsaBlindTestCases;
let program = import:Std.Program;
let test = import:Std.Test;
let vectors = import:RsaBlindVectors;

let App = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        last client = new blind.Client(cases.public_key(), blind.Variant.PssDeterministic);
        let _ = client.blind_with_factor(new, new, new);
        return program.ExitCode.Ok;
    };
);
