// test-options: --gpu=off
// status: 134
// run-options: --gpu=off --deny-entropy --max-steps 1500000000
// stderr: explicit program failure \(trap reason 3\): invalid argument: FROST dealer share index is out of range
let frost = import:Std.Crypto.Advanced.Frost;
let cases = import:FrostTestCases;
let program = import:Std.Program;
let test = import:Std.Test;
let vectors = import:FrostVectors;

let App = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        last scalars: uint8[list][list] = new([cases.bytes(vectors.group[0]), cases.bytes(vectors.group[1])]);
        last pack = test.assert_ok(frost.deal_with_coefficients(scalars, 2));
        let _ = pack.share_at(2);
        return program.ExitCode.Ok;
    };
);
