// test-options: --gpu=off
// status: 134
// run-options: --gpu=off --deny-entropy --max-steps 15000000000
// stderr: explicit program failure \(trap reason 3\): invalid argument: wrong RSA blind signer factor length
let blind = import:Std.Crypto.Advanced.RsaBlindSignature;
let cases = import:RsaBlindTestCases;
let program = import:Std.Program;
let test = import:Std.Test;
let vectors = import:RsaBlindVectors;

let App = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        last signer = new blind.BlindSigner(cases.signing_key(), blind.Variant.PssRandomized);
        let _ = signer.sign_with_factor(new, new);
        return program.ExitCode.Ok;
    };
);
