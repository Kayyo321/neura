// status: 134
// stderr: explicit program failure \(trap reason 3\): invalid argument: negative Merlin challenge length
// run-options: --gpu=off
let merlin = import:Std.Crypto.Advanced.Merlin;
let program = import:Std.Program;

let App = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let transcript: merlin.Transcript = new(new);
        let _ = transcript.challenge_bytes(new, -1);
        return program.ExitCode.Ok;
    };
);
