// test-options: --gpu=off --max-steps 200000000
let crypto_policy = import:Std.Crypto.Core.CryptoPolicy;
let ecdsa = import:Std.Crypto.Asymmetric.Ecdsa;
let hash_to_curve = import:Std.Crypto.Advanced.HashToCurve;
let hex = import:Std.Encoding.Hex;
let test = import:Std.Test;
let vectors = import:H2cP256Vectors;

let H2cP256Tests = module (
    let bytes = func(value: string) -> uint8[list] => test.assert_ok(hex.decode(value));

    export let test_rfc_and_independent_sec1_encodings = func {
        last rows = vectors.records;
        for (let i = 0; i < rows.length; i += 5) {
            last msg = bytes(rows[i + 1]);
            last dst = bytes(rows[i + 2]);
            last uncompressed = hash_to_curve.hash_to_p256(msg, dst);
            last compressed = hash_to_curve.hash_to_p256(msg, dst, true);
            test.assert_equal_string(rows[i + 3], hex.encode(uncompressed));
            test.assert_equal_string(rows[i + 4], hex.encode(compressed));
            last point = test.assert_ok(ecdsa.parse_public_key(ecdsa.Curve.P256, uncompressed));
            last same_point = test.assert_ok(ecdsa.parse_public_key(ecdsa.Curve.P256, compressed));
            test.assert(point.equals(same_point));
        }
    };

    export let test_p256_suite_available_under_existing_fips_policy = func {
        last prior = crypto_policy.policy();
        crypto_policy.set_policy(crypto_policy.Policy.Fips140_3);
        last result = hash_to_curve.hash_to_p256(bytes(vectors.records[1]), bytes(vectors.records[2]));
        crypto_policy.set_policy(prior);
        test.assert_equal_string(vectors.records[3], hex.encode(result));
    };
);
