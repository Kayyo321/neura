// test-options: --gpu=off --max-steps 2000000000
let hash_to_curve = import:Std.Crypto.Advanced.HashToCurve;
let hex = import:Std.Encoding.Hex;
let int64s = import:Std.Core.Int64;
let sha2 = import:Std.Crypto.Hash.Sha2;
let test = import:Std.Test;
let vectors = import:Ristretto255Vectors;

let HashToCurveTests = module (
    let decode = func(text: string) -> uint8[list] => test.assert_ok(hex.decode(text));

    export let test_sha512_expansion = func {
        last rows = vectors.expansion;
        for (let i = 0; i < rows.length; i += 4) {
            last length = test.assert_ok(int64s.parse(rows[i + 2])) as int;
            last result = hash_to_curve.expand_message_xmd_sha512(decode(rows[i]), decode(rows[i + 1]), length);
            test.assert_equal_string(rows[i + 3], hex.encode(result));
        }
    };

    export let test_xmd_counter_limit = func {
        last row = vectors.max_expansion;
        last length = test.assert_ok(int64s.parse(row[2])) as int;
        last dst = decode(row[1]);
        last result = hash_to_curve.expand_message_xmd_sha512(decode(row[0]), dst, length);
        test.assert_equal_int32(length, result.length);
        test.assert_equal_string(row[3], hex.encode(sha2.sha256(result)));
        test.assert_equal_int32(0, hash_to_curve.expand_message_xmd_sha512(new, dst, 0).length);
    };

    export let test_hash_to_ristretto255 = func {
        last rows = vectors.hash_to_group;
        for (let i = 0; i < rows.length; i += 3) {
            last point = hash_to_curve.hash_to_ristretto255(decode(rows[i]), decode(rows[i + 1]));
            test.assert_equal_string(rows[i + 2], hex.encode(point));
        }
    };
);
