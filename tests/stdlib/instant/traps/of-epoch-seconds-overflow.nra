// status: 136
// stderr: source arithmetic failure \(trap reason 1\) in function [0-9]+ block [0-9]+ at std/time/instant[.]nra
let console = import:Std.Io.Console;
let duration = import:Std.Time.Duration;
let instant = import:Std.Time.Instant;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line(instant.of_epoch_seconds(9223372036854775807, 1000000000).to_string());
        return program.ExitCode.Ok;
    };
);
