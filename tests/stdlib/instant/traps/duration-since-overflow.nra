// status: 70
// stderr: source arithmetic failure \(trap reason 1\) in function [0-9]+ block [0-9]+ at std/time/instant[.]nra
let console = import:Std.Io.Console;
let duration = import:Std.Time.Duration;
let instant = import:Std.Time.Instant;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        let later = instant.of_epoch_seconds(9223372037, 0);
        console.print_line("before");
        console.print_line(later.duration_since(instant.Epoch).to_string());
        return program.ExitCode.Ok;
    };
);
