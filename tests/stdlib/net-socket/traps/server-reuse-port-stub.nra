// status: 134
// stderr: unsupported: Std\.Net\.Socket\.Internal\.HostCalls\.listen_with_options is not implemented in Neura 0\.3\.0
// run-options: --allow-net
// SO_REUSEPORT must be set before bind, which needs a listen-with-options host service.
let program = import:Std.Program;
let result = import:Std.Core.Result;
let socket_addr = import:Std.Net.Core.SocketAddr;
let options = import:Std.Net.Socket.SocketOptions;
let tcp_server = import:Std.Net.Socket.TcpServer;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        last builder = options.builder();
        builder.set_reuse_port(true);
        match (builder.build(options.SocketKind.TcpListener)) {
            result.Result.Ok(set) => {
                last address = result.expect<socket_addr.SocketAddr>(socket_addr.parse("127.0.0.1:0"), "address");
                let _ = tcp_server.bind_with(address, set);
            },
            result.Result.Err(_) => {},
        }
        return program.ExitCode.Ok;
    };
);
