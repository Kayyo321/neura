// status: 134
// stderr: unsupported: Std\.Net\.Socket\.Internal\.HostCalls\.shutdown is not implemented in Neura 0\.3\.0
// run-options: --allow-net
// TcpSocket.shutdown on an open socket needs a shutdown host service.
let duration = import:Std.Time.Duration;
let program = import:Std.Program;
let result = import:Std.Core.Result;
let socket_addr = import:Std.Net.Core.SocketAddr;
let stream_socket = import:Std.Net.Socket.StreamSocket;
let tcp_server = import:Std.Net.Socket.TcpServer;
let tcp_socket = import:Std.Net.Socket.TcpSocket;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        last server = result.expect<tcp_server.TcpServer>(tcp_server.bind(result.expect<socket_addr.SocketAddr>(
            socket_addr.parse("127.0.0.1:0"), "address")), "bind");
        last client = result.expect<tcp_socket.TcpSocket>(tcp_socket.connect(server.address(),
            duration.of_seconds(5)), "connect");
        let _ = client.shutdown(stream_socket.Shutdown.Write);
        return program.ExitCode.Ok;
    };
);
