// status: 134
// stderr: unsupported: Std\.Net\.Socket\.Internal\.HostCalls\.udp_bind is not implemented in Neura 0\.3\.0
// UdpSocket.bind calls the host's UDP service, which this runtime lacks.
let program = import:Std.Program;
let result = import:Std.Core.Result;
let socket_addr = import:Std.Net.Core.SocketAddr;
let udp = import:Std.Net.Socket.UdpSocket;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        last address = socket_addr.parse("127.0.0.1:0");
        match (address) {
            result.Result.Ok(a) => {
                let _ = udp.bind(a);
            },
            result.Result.Err(_) => {},
        }
        return program.ExitCode.Ok;
    };
);
