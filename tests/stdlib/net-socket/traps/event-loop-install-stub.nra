// status: 134
// stderr: unsupported: Std\.Net\.Socket\.Internal\.HostCalls\.select_event_loop is not implemented in Neura 0\.3\.0
// EventLoop.install needs a driver service to switch backends.
let event_loop = import:Std.Net.Socket.EventLoop;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let _ = event_loop.install(event_loop.EventLoopBackend.Epoll);
        return program.ExitCode.Ok;
    };
);
