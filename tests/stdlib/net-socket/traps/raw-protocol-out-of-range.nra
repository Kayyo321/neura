// status: 134
// stderr: invalid argument: protocol
// A raw socket's IP protocol number must be 0 through 255.
let net_address = import:Std.Net.Core.NetAddress;
let program = import:Std.Program;
let raw = import:Std.Net.Socket.RawSocket;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let _ = raw.open(net_address.AddressFamily.Ipv4, 256);
        return program.ExitCode.Ok;
    };
);
