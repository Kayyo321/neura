// test-options: --allow-net
let duration = import:Std.Time.Duration;
let errors = import:Std.Core.Error;
let event_loop = import:Std.Net.Socket.EventLoop;
let net_address = import:Std.Net.Core.NetAddress;
let options = import:Std.Net.Socket.SocketOptions;
let raw = import:Std.Net.Socket.RawSocket;
let result = import:Std.Core.Result;
let socket_addr = import:Std.Net.Core.SocketAddr;
let streams = import:Std.Net.Socket.StreamSocket;
let tcp = import:Std.Net.Socket.TcpSocket;
let server = import:Std.Net.Socket.TcpServer;
let test = import:Std.Test;
let udp = import:Std.Net.Socket.UdpSocket;
let unit = import:Std.Core.Unit;
let unix_addr = import:Std.Net.Core.UnixAddr;
let unix_datagram = import:Std.Net.Socket.UnixDatagram;

let SocketHostExtensions = module (
    let loopback = func -> socket_addr.SocketAddr =>
        test.assert_ok<socket_addr.SocketAddr>(socket_addr.parse("127.0.0.1:0"));

    let listen = func -> server.TcpServer => test.assert_ok<server.TcpServer>(server.bind(loopback()));

    let dial = func(listener: server.TcpServer) -> tcp.TcpSocket =>
        test.assert_ok<tcp.TcpSocket>(tcp.connect(listener.address(), duration.of_seconds(2)));

    let kind_of = func(error: errors.Error) -> errors.IoErrorKind => match (error) {
        errors.Error.Io { kind, message, path } => kind,
        _ => errors.IoErrorKind.Other,
    };

    // Whether the host is Linux: only Linux binds a Unix socket in the abstract namespace, and every other
    // host reports Unsupported. The name carries a fresh UDP port so parallel runs do not collide.
    let linux_host = func -> bool {
        last holder = test.assert_ok<udp.UdpSocket>(udp.bind(loopback()));
        last port = test.assert_ok<socket_addr.SocketAddr>(holder.local_address()).port;
        test.assert_ok<unit.Unit>(holder.close());
        match (unix_datagram.bind(unix_addr.abstract_name("neura-net-test-epoll-" + port.to_string()))) {
            result.Result.Ok(socket) => {
                test.assert_ok<unit.Unit>(socket.close());
                return true;
            },
            result.Result.Err(problem) => {
                test.assert(kind_of(problem) == errors.IoErrorKind.Unsupported);
                return false;
            },
        }
    };

    let check_bytes = func(expected: uint8[list], actual: uint8[list]) {
        test.assert_equal<int>(expected.length, actual.length);
        for (let i = 0; i < expected.length; i++) {
            test.assert_equal<uint8>(expected[i], actual[i]);
        }
    };

    let read_exact = func(socket: tcp.TcpSocket, count: int) -> uint8[list] {
        let bytes: uint8[list] = new;
        while (bytes.length < count) {
            last next = test.assert_ok<uint8[list]>(socket.read(count - bytes.length));
            test.assert(next.length > 0);
            for (let byte in next) {
                bytes.append(byte);
            }
        }
        return bytes;
    };

    export let test_half_close_preserves_other_direction = func {
        last listener = listen();
        last client = dial(listener);
        last peer = test.assert_ok<tcp.TcpSocket>(listener.accept());
        last address = test.assert_ok<socket_addr.SocketAddr>(client.local_address());
        test.assert_equal<int>(test.assert_ok<int>(client.local_port()), address.port);
        test.assert_equal_string("127.0.0.1", address.host_text());

        test.assert_ok<unit.Unit>(client.write(new([17, 23])));
        test.assert_ok<unit.Unit>(client.shutdown(streams.Shutdown.Write));
        peer.set_read_timeout(duration.of_seconds(2));
        check_bytes(new([17, 23]), read_exact(peer, 2));
        test.assert_equal<int>(0, test.assert_ok<uint8[list]>(peer.read(2)).length);
        test.assert_ok<unit.Unit>(peer.write(new([42])));
        client.set_read_timeout(duration.of_seconds(2));
        check_bytes(new([42]), read_exact(client, 1));

        test.assert_ok<unit.Unit>(peer.close());
        test.assert_ok<unit.Unit>(client.close());
        test.assert(kind_of(test.assert_err<unit.Unit>(client.shutdown(streams.Shutdown.Write)))
            == errors.IoErrorKind.Closed);
        test.assert_ok<unit.Unit>(listener.close());
    };

    export let test_readiness_backend_change = func {
        test.assert_ok<unit.Unit>(event_loop.install(event_loop.EventLoopBackend.Poll));
        // epoll exists on every Linux host: there the install must succeed. Elsewhere it is Unsupported.
        if (linux_host()) {
            test.assert_ok<unit.Unit>(event_loop.install(event_loop.EventLoopBackend.Epoll));
        } else {
            last problem = test.assert_err<unit.Unit>(event_loop.install(event_loop.EventLoopBackend.Epoll));
            test.assert(kind_of(problem) == errors.IoErrorKind.Unsupported);
        }
        last listener = listen();
        scope {
            spawn write_loopback(listener.local_port());
            last peer = test.assert_ok<tcp.TcpSocket>(listener.accept());
            peer.set_read_timeout(duration.of_seconds(2));
            check_bytes(new([31]), read_exact(peer, 1));
            test.assert_ok<unit.Unit>(peer.close());
        }
        test.assert_ok<unit.Unit>(listener.close());
    };

    let write_loopback = func(port: int) {
        last target = test.assert_ok<socket_addr.SocketAddr>(socket_addr.parse("127.0.0.1:" .. port.to_string()));
        last client = test.assert_ok<tcp.TcpSocket>(tcp.connect(target, duration.of_seconds(2)));
        test.assert_ok<unit.Unit>(client.write(new([31])));
        test.assert_ok<unit.Unit>(client.close());
    };

    export let test_bind_options = func {
        last builder = options.builder();
        builder.set_reuse_address(true);
        last settings = test.assert_ok<options.SocketOptions>(builder.build(options.SocketKind.TcpListener));
        last listener = test.assert_ok<server.TcpServer>(server.bind_with(loopback(), settings));
        test.assert(listener.local_port() > 0);
        test.assert_ok<unit.Unit>(listener.close());

    };

    export let test_relay_and_copy_avoidance = func {
        last listener = listen();
        last source = dial(listener);
        last from = test.assert_ok<tcp.TcpSocket>(listener.accept());
        last destination = dial(listener);
        last to = test.assert_ok<tcp.TcpSocket>(listener.accept());
        destination.set_read_timeout(duration.of_seconds(2));
        test.assert_ok<unit.Unit>(source.write(new([25, 56, 99])));
        test.assert_equal<int64>(0, test.assert_ok<int64>(from.splice_to(to, 0)));
        let moved: int64 = 0;
        while (moved < 3) {
            last progress = test.assert_ok<int64>(from.splice_to(to, 3 - moved));
            test.assert(progress > 0);
            moved += progress;
        }
        check_bytes(new([25, 56, 99]), read_exact(destination, 3));
        test.assert_ok<unit.Unit>(to.send_zerocopy(new([12, 34, 56])));
        check_bytes(new([12, 34, 56]), read_exact(destination, 3));

        test.assert_ok<unit.Unit>(source.close());
        test.assert_equal<int64>(0, test.assert_ok<int64>(from.splice_to(to, 3)));
        test.assert_ok<unit.Unit>(to.close());
        test.assert(kind_of(test.assert_err<int64>(from.splice_to(to, 1))) == errors.IoErrorKind.Closed);
        test.assert_ok<unit.Unit>(listener.close());
        test.assert_ok<unit.Unit>(from.close());
        test.assert_ok<unit.Unit>(destination.close());
    };

    export let test_raw_requires_its_own_capability = func {
        last problem = test.assert_err<raw.RawSocket>(raw.open(net_address.AddressFamily.Ipv4, 1));
        test.assert(kind_of(problem) == errors.IoErrorKind.CapabilityDenied);
    };
);
