let error = import:Std.Core.Error;
let result = import:Std.Core.Result;
let strings = import:Std.Text.Strings;
let test = import:Std.Test;
let utf8 = import:Std.Encoding.Utf8;

// UTF-8. The vectors come from python3: UnicodeDecodeError.start and
// .reason for decode and validate, and bytes.decode('utf-8', 'replace')
// (Unicode's maximal subpart practice) for decode_lossy. The exhaustive and
// grid tests compare validate with the NVM's string.from_utf8.
let Utf8Tests = module (
    let check = func(bytes: uint8[list], offset: int, reason: string, lossy: uint32[list]) -> void {
        test.assert_equal_int32(offset, utf8.validate(bytes));
        test.assert_equal<uint32[list]>(lossy, strings.scalars(utf8.decode_lossy(bytes)));
        match (utf8.decode(bytes)) {
            result.Result.Ok(text) => {
                test.assert_equal_int32(-1, offset);
                test.assert_equal<uint8[list]>(bytes, utf8.encode(text));
            },
            result.Result.Err(e) => {
                match (e) {
                    error.Error.Encoding { offset: at, message } => {
                        test.assert_equal_int32(offset, at);
                        test.assert_equal_string(reason, message);
                    },
                    _ => {
                        test.fail("expected an Encoding error");
                    },
                }
            },
        }
    };

    // validate agrees with string.from_utf8, and its offset is the one
    // decode reports.
    let agree = func(bytes: uint8[list]) -> void {
        let [valid, _] = string.from_utf8(bytes);
        let at = utf8.validate(bytes);
        test.assert_equal_bool(valid, at == -1);
        if (!valid) {
            match (utf8.decode(bytes)) {
                result.Result.Ok(_) => {
                    test.fail("decode accepted invalid bytes");
                },
                result.Result.Err(e) => {
                    match (e) {
                        error.Error.Encoding { offset, message: _ } => {
                            test.assert_equal_int32(offset, at);
                        },
                        _ => {
                            test.fail("expected an Encoding error");
                        },
                    }
                },
            }
        }
    };

    export let test_encode = func() -> void {
        test.assert_equal<uint8[list]>(new, utf8.encode(""));
        test.assert_equal<uint8[list]>(new([65, 195, 169, 240, 159, 153, 130]), utf8.encode("Aé🙂"));
        test.assert_equal<uint8[list]>(new([226, 130, 172, 0]), utf8.encode("€" + strings.from_scalars(new([0]))));
        test.assert_equal_string("Aé🙂", test.assert_ok<string>(utf8.decode(new([65, 195, 169, 240, 159, 153, 130]))));
        test.assert_equal_string("", test.assert_ok<string>(utf8.decode(new)));
        test.assert_equal_string("plain", utf8.decode_lossy(utf8.encode("plain")));
    };

    export let test_python_vectors = func() -> void {
        check(new, -1, "", new);
        check(new([65]), -1, "", new([65]));
        check(new([0]), -1, "", new([0]));
        check(new([127]), -1, "", new([127]));
        check(new([128]), 0, "invalid start byte", new([65533]));
        check(new([191]), 0, "invalid start byte", new([65533]));
        check(new([192, 128]), 0, "invalid start byte", new([65533, 65533]));
        check(new([193, 191]), 0, "invalid start byte", new([65533, 65533]));
        check(new([194]), 0, "unexpected end of data", new([65533]));
        check(new([194, 128]), -1, "", new([128]));
        check(new([194, 127]), 0, "invalid continuation byte", new([65533, 127]));
        check(new([223, 191]), -1, "", new([2047]));
        check(new([224, 159, 191]), 0, "invalid continuation byte", new([65533, 65533, 65533]));
        check(new([224, 160, 128]), -1, "", new([2048]));
        check(new([225, 128]), 0, "unexpected end of data", new([65533]));
        check(new([237, 159, 191]), -1, "", new([55295]));
        check(new([237, 160, 128]), 0, "invalid continuation byte", new([65533, 65533, 65533]));
        check(new([237, 191, 191]), 0, "invalid continuation byte", new([65533, 65533, 65533]));
        check(new([238, 128, 128]), -1, "", new([57344]));
        check(new([239, 191, 191]), -1, "", new([65535]));
        check(new([240, 143, 191, 191]), 0, "invalid continuation byte", new([65533, 65533, 65533, 65533]));
        check(new([240, 144, 128, 128]), -1, "", new([65536]));
        check(new([243, 191, 191, 191]), -1, "", new([1048575]));
        check(new([244, 143, 191, 191]), -1, "", new([1114111]));
        check(new([244, 144, 128, 128]), 0, "invalid continuation byte", new([65533, 65533, 65533, 65533]));
        check(new([245, 128, 128, 128]), 0, "invalid start byte", new([65533, 65533, 65533, 65533]));
        check(new([255]), 0, "invalid start byte", new([65533]));
        check(new([254, 255]), 0, "invalid start byte", new([65533, 65533]));
        check(new([65, 226, 130]), 1, "unexpected end of data", new([65, 65533]));
        check(new([65, 226, 130, 172, 66]), -1, "", new([65, 8364, 66]));
        check(new([65, 226, 130, 65]), 1, "invalid continuation byte", new([65, 65533, 65]));
        check(new([240, 159, 153]), 0, "unexpected end of data", new([65533]));
        check(new([240, 159, 153, 130, 240, 159]), 4, "unexpected end of data", new([128578, 65533]));
        check(new([97, 98, 99, 237, 160, 189, 237, 178, 169, 100]), 3, "invalid continuation byte", new([97, 98, 99, 65533, 65533, 65533, 65533, 65533, 65533, 100]));
        check(new([226, 130, 172, 128, 226, 130]), 3, "invalid start byte", new([8364, 65533, 65533]));
        check(new([192, 175, 224, 128, 175, 240, 128, 128, 175]), 0, "invalid start byte", new([65533, 65533, 65533, 65533, 65533, 65533, 65533, 65533, 65533]));
        check(new([97, 241, 128, 128, 225, 128, 194, 98, 128, 99, 128, 191, 100]), 1, "invalid continuation byte", new([97, 65533, 65533, 65533, 98, 65533, 99, 65533, 65533, 100]));
    };

    export let test_one_and_two_bytes_exhaustive = func() -> void {
        for (let first = 0; first < 256; first = first + 1) {
            agree(new([first as uint8]));
            for (let second = 0; second < 256; second = second + 1) {
                let pair: uint8[list] = new([first as uint8, second as uint8]);
                let [valid, _] = string.from_utf8(pair);
                test.assert_equal_bool(valid, utf8.validate(pair) == -1);
            }
        }
    };

    // Lead bytes and continuation candidates at every range boundary, alone
    // and between ASCII bytes.
    export let test_three_and_four_byte_grid = func() -> void {
        let leads: uint8[list] = new([192, 193, 194, 223, 224, 225, 236, 237, 238, 239, 240, 241, 243, 244, 245, 247, 248, 255]);
        let others: uint8[list] = new([0, 127, 128, 143, 144, 159, 160, 191, 192, 255]);
        for (let lead in leads) {
            for (let second in others) {
                for (let third in others) {
                    agree(new([lead, second, third]));
                    agree(new([65, lead, second, third, 66]));
                    for (let fourth in others) {
                        agree(new([lead, second, third, fourth]));
                    }
                }
            }
        }
    };
);
