// run-options: --replay @AREA_DIR@/programs/read-lines.trace
let console = import:Std.Io.Console;
let error = import:Std.Core.Error;
let optional = import:Std.Core.Optional;
let program = import:Std.Program;
let result = import:Std.Core.Result;

// Reads lines until the end of input: CR LF and LF endings, an empty line, a
// line that is not UTF-8, and a final line without LF. Replays
// read-lines.trace, recorded with that input.
export let ReadLines = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let count = 0;
        while (count < 10) {
            match (console.read_line()) {
                result.Result.Ok(line) => {
                    match (line) {
                        optional.Optional.Some(text) => {
                            console.print_line("[" + text + "]");
                        },
                        optional.Optional.None => {
                            console.print_line("end of input");
                            break;
                        },
                    }
                },
                result.Result.Err(failure) => {
                    console.print_line(error.message(failure));
                },
            }
            count = count + 1;
        }
        // After the end, read_line keeps returning None.
        match (console.read_line()) {
            result.Result.Ok(line) => {
                console.print_line(optional.is_none<string>(line).to_string());
            },
            result.Result.Err(_) => {},
        }
        return program.ExitCode.Ok;
    };
);
