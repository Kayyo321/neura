// status: 134
// stderr: unsupported: Std\.Net\.Rpc\.Framing\.compress is not implemented in Neura 0\.3\.0
let framing = import:Std.Net.Rpc.Framing;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let _ = framing.compress(framing.Compression.Gzip, new);
        return program.ExitCode.Ok;
    };
);
