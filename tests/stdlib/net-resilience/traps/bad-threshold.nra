// status: 134
// stderr: invalid argument: failure_rate_threshold
// A circuit breaker rejects a failure-rate threshold outside 1 through 100 at construction.
let breakers = import:Std.Net.Resilience.CircuitBreaker;
let console = import:Std.Io.Console;
let durations = import:Std.Time.Duration;
let fixed_clock = import:Std.Time.FixedClock;
let instant = import:Std.Time.Instant;
let program = import:Std.Program;

let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        last clock = fixed_clock.of(instant.Epoch);
        last ok = breakers.count_based(10, 50, 5, durations.of_seconds(1), 1, clock);
        console.print_line(ok.to_string());
        last bad = breakers.count_based(10, 0, 5, durations.of_seconds(1), 1, clock);
        console.print_line("unreachable");
        return program.ExitCode.Ok;
    };
);
