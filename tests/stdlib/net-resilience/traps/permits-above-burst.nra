// status: 134
// stderr: invalid argument: permits
// A GCRA limiter rejects a request for more permits than its burst, which could never conform.
let console = import:Std.Io.Console;
let durations = import:Std.Time.Duration;
let fixed_clock = import:Std.Time.FixedClock;
let gcra = import:Std.Net.Resilience.GcraLimiter;
let instant = import:Std.Time.Instant;
let program = import:Std.Program;
let result = import:Std.Core.Result;

let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        last limiter = gcra.in_memory(10, durations.of_seconds(1), 3, fixed_clock.of(instant.Epoch));
        match (limiter.try_acquire("k", 3)) {
            result.Result.Ok(decision) => {
                console.print_line(decision.to_string());
            },
            _ => {
            },
        }
        let _ = limiter.try_acquire("k", 4);
        console.print_line("unreachable");
        return program.ExitCode.Ok;
    };
);
