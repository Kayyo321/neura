// status: 70
// stderr: explicit program failure \(trap reason 3\): invalid argument: maximum count below 1
let buffered_reader = import:Std.Io.BufferedReader;
let buffered_writer = import:Std.Io.BufferedWriter;
let byte_buffer = import:Std.Io.ByteBuffer;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let buffer = byte_buffer.create();
        buffered_reader.create(buffer.reader()).read(0);
        return program.ExitCode.Ok;
    };
);
