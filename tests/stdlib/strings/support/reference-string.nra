// The Neura implementation of the Std.Core.String members that became kernel bindings (trim, compare_to,
// and compare_to_ignore_ascii_case), kept unchanged (but for the module's name and the members that did not
// change) as the oracle of kernel-oracle.nra. It lives with the tests, not in the standard library: only
// library source may import an Internal module, and code here never reaches a user's image.
let ordering = import:Std.Core.Ordering;
let strings = import:ReferenceStrings;

/// @brief The replaced members of the primitive companion for immutable UTF-8 text.
export let ReferenceString = module (
    /// @brief Compares UTF-8 bytes lexicographically and returns -1, 0, or 1.
    export let compare_to = func(s: string, other: string) -> int => match (strings.compare(s, other)) {
        ordering.Ordering.Less => -1,
        ordering.Ordering.Equal => 0,
        ordering.Ordering.Greater => 1,
    };

    /// @brief Compares UTF-8 bytes lexicographically after folding ASCII letters.
    export let compare_to_ignore_ascii_case = func(s: string, other: string) -> int =>
        compare_to(strings.to_ascii_lower(s), strings.to_ascii_lower(other));

    /// @brief Removes leading and trailing code points through U+0020.
    export let trim = func(s: string) -> string {
        let start = 0;
        let end = s.byte_length;
        while (start < end && s.byte_at(start) <= 32) {
            start += 1;
        }
        while (end > start && s.byte_at(end - 1) <= 32) {
            end -= 1;
        }
        return s.slice(start, end);
    };
);
