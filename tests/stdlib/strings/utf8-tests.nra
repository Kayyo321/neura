let error = import:Std.Core.Error;
let result = import:Std.Core.Result;
let strings = import:Std.Text.Strings;
let test = import:Std.Test;

// UTF-8 decoding and encoding. The vectors and totals were generated with
// python3 (generators/utf8-vectors.py): bytes.decode('utf-8', 'replace') for
// the lossy decoding (Unicode's maximal subpart practice) and
// UnicodeDecodeError.start and .reason for from_bytes.
let Utf8Tests = module (
    let check_bytes = func(bytes: uint8[list], lossy: uint32[list], offset: int, reason: string) -> void {
        let text = strings.from_bytes_lossy(bytes);
        test.assert_equal<uint32[list]>(lossy, strings.scalars(text));
        let [valid, _] = string.from_utf8(bytes);
        test.assert_equal_bool(offset < 0, valid);
        match (strings.from_bytes(bytes)) {
            result.Result.Ok(decoded) => {
                test.assert_equal_int32(-1, offset);
                test.assert_equal<uint8[list]>(bytes, strings.to_bytes(decoded));
                test.assert_equal_string(decoded, text);
            },
            result.Result.Err(e) => {
                match (e) {
                    error.Error.Encoding { offset: at, message } => {
                        test.assert_equal_int32(offset, at);
                        test.assert_equal_string(reason, message);
                    },
                    _ => {
                        test.fail("expected an Encoding error");
                    },
                }
            },
        }
    };

    export let test_python_vectors = func() -> void {
        check_bytes(new, new, -1, "");
        check_bytes(new([65]), new([65]), -1, "");
        check_bytes(new([0]), new([0]), -1, "");
        check_bytes(new([127]), new([127]), -1, "");
        check_bytes(new([128]), new([65533]), 0, "invalid start byte");
        check_bytes(new([191]), new([65533]), 0, "invalid start byte");
        check_bytes(new([192]), new([65533]), 0, "invalid start byte");
        check_bytes(new([193]), new([65533]), 0, "invalid start byte");
        check_bytes(new([192, 128]), new([65533, 65533]), 0, "invalid start byte");
        check_bytes(new([193, 191]), new([65533, 65533]), 0, "invalid start byte");
        check_bytes(new([194]), new([65533]), 0, "unexpected end of data");
        check_bytes(new([194, 128]), new([128]), -1, "");
        check_bytes(new([194, 127]), new([65533, 127]), 0, "invalid continuation byte");
        check_bytes(new([223, 191]), new([2047]), -1, "");
        check_bytes(new([223, 192]), new([65533, 65533]), 0, "invalid continuation byte");
        check_bytes(new([224]), new([65533]), 0, "unexpected end of data");
        check_bytes(new([224, 128]), new([65533, 65533]), 0, "invalid continuation byte");
        check_bytes(new([224, 159, 191]), new([65533, 65533, 65533]), 0, "invalid continuation byte");
        check_bytes(new([224, 160]), new([65533]), 0, "unexpected end of data");
        check_bytes(new([224, 160, 128]), new([2048]), -1, "");
        check_bytes(new([224, 160, 127]), new([65533, 127]), 0, "invalid continuation byte");
        check_bytes(new([225, 128, 128]), new([4096]), -1, "");
        check_bytes(new([236, 191, 191]), new([53247]), -1, "");
        check_bytes(new([237, 128, 128]), new([53248]), -1, "");
        check_bytes(new([237, 159, 191]), new([55295]), -1, "");
        check_bytes(new([237, 160, 128]), new([65533, 65533, 65533]), 0, "invalid continuation byte");
        check_bytes(new([237, 191, 191]), new([65533, 65533, 65533]), 0, "invalid continuation byte");
        check_bytes(new([238, 128, 128]), new([57344]), -1, "");
        check_bytes(new([239, 191, 191]), new([65535]), -1, "");
        check_bytes(new([239, 191]), new([65533]), 0, "unexpected end of data");
        check_bytes(new([240]), new([65533]), 0, "unexpected end of data");
        check_bytes(new([240, 128, 128, 128]), new([65533, 65533, 65533, 65533]), 0, "invalid continuation byte");
        check_bytes(new([240, 143, 191, 191]), new([65533, 65533, 65533, 65533]), 0, "invalid continuation byte");
        check_bytes(new([240, 144]), new([65533]), 0, "unexpected end of data");
        check_bytes(new([240, 144, 128]), new([65533]), 0, "unexpected end of data");
        check_bytes(new([240, 144, 128, 128]), new([65536]), -1, "");
        check_bytes(new([240, 144, 128, 127]), new([65533, 127]), 0, "invalid continuation byte");
        check_bytes(new([241, 128, 128, 128]), new([262144]), -1, "");
        check_bytes(new([243, 191, 191, 191]), new([1048575]), -1, "");
        check_bytes(new([244, 143, 191, 191]), new([1114111]), -1, "");
        check_bytes(new([244, 144, 128, 128]), new([65533, 65533, 65533, 65533]), 0, "invalid continuation byte");
        check_bytes(new([245, 128, 128, 128]), new([65533, 65533, 65533, 65533]), 0, "invalid start byte");
        check_bytes(new([248, 136, 128, 128, 128]), new([65533, 65533, 65533, 65533, 65533]), 0, "invalid start byte");
        check_bytes(new([254]), new([65533]), 0, "invalid start byte");
        check_bytes(new([255]), new([65533]), 0, "invalid start byte");
        check_bytes(new([254, 255]), new([65533, 65533]), 0, "invalid start byte");
        check_bytes(new([97, 255, 98]), new([97, 65533, 98]), 1, "invalid start byte");
        check_bytes(new([97, 226, 130, 98]), new([97, 65533, 98]), 1, "invalid continuation byte");
        check_bytes(new([226, 130, 172, 226, 130]), new([8364, 65533]), 3, "unexpected end of data");
        check_bytes(new([226, 130, 172, 255, 226, 130, 172]), new([8364, 65533, 8364]), 3, "invalid start byte");
        check_bytes(new([240, 159, 153, 130, 240, 159, 153]), new([128578, 65533]), 4, "unexpected end of data");
        check_bytes(new([240, 159, 153, 65]), new([65533, 65]), 0, "invalid continuation byte");
        check_bytes(new([195, 169, 195]), new([233, 65533]), 2, "unexpected end of data");
        check_bytes(new([195, 169, 195, 195, 169]), new([233, 65533, 233]), 2, "invalid continuation byte");
        check_bytes(new([97, 241, 128, 128, 225, 128, 194, 98, 128, 99, 128, 191, 100]), new([97, 65533, 65533, 65533, 98, 65533, 99, 65533, 65533, 100]), 1, "invalid continuation byte");
        check_bytes(new([224, 128, 175]), new([65533, 65533, 65533]), 0, "invalid continuation byte");
        check_bytes(new([244, 145, 146, 147, 255, 65, 128, 191, 66]), new([65533, 65533, 65533, 65533, 65533, 65, 65533, 65533, 66]), 0, "invalid continuation byte");
        check_bytes(new([225, 128, 226, 240, 145, 146, 241, 191, 65]), new([65533, 65533, 65533, 65533, 65]), 0, "invalid continuation byte");
        check_bytes(new([237, 160, 128, 237, 191, 191]), new([65533, 65533, 65533, 65533, 65533, 65533]), 0, "invalid continuation byte");
        check_bytes(new([128, 128, 128]), new([65533, 65533, 65533]), 0, "invalid start byte");
        check_bytes(new([194, 194, 128]), new([65533, 128]), 0, "invalid continuation byte");
    };

    export let test_error_message = func() -> void {
        let e = test.assert_err<string>(strings.from_bytes(new([97, 98, 255])));
        test.assert_equal_string("invalid encoding at 2: invalid start byte", error.message(e));
    };

    // The library's own validator must accept exactly what the NVM accepts.
    // Each candidate is followed by 0xFF, which is never valid, so the NVM
    // rejects the whole input and the library decodes the candidate itself:
    // from_bytes must report the error at the candidate's end exactly when
    // the NVM accepts the candidate alone. The lossy totals are python3's.
    let check_candidate = func(candidate: uint8[list]) -> void {
        let [valid, _] = string.from_utf8(candidate);
        let probe: uint8[list] = new;
        for (let b in candidate) {
            probe.append(b);
        }
        probe.append(255);
        match (strings.from_bytes(probe)) {
            result.Result.Ok(_) => {
                test.fail("0xFF was accepted");
            },
            result.Result.Err(e) => {
                match (e) {
                    error.Error.Encoding { offset, message: _ } => {
                        test.assert_equal_bool(valid, offset == candidate.length);
                    },
                    _ => {
                        test.fail("expected an Encoding error");
                    },
                }
            },
        }
    };

    let add_lossy = func(candidate: uint8[list], totals: int[]) -> void {
        let probe: uint8[list] = new;
        for (let b in candidate) {
            probe.append(b);
        }
        probe.append(255);
        for (let value in strings.scalars(strings.from_bytes_lossy(probe))) {
            totals[0] = totals[0] + 1;
            totals[1] = totals[1] + (value as int);
        }
    };

    // Every two-byte sequence with a non-ASCII first byte.
    export let test_two_byte_sequences = func() -> void {
        let count = 0;
        let total: int64 = 0;
        let a = 128;
        while (a < 256) {
            let totals: int[] = [0, 0];
            let b = 0;
            while (b < 256) {
                let candidate: uint8[list] = new([a as uint8, b as uint8]);
                check_candidate(candidate);
                add_lossy(candidate, totals);
                b = b + 1;
            }
            count = count + totals[0];
            total = total + (totals[1] as int64);
            a = a + 1;
        }
        test.assert_equal_int32(95168, count);
        test.assert_equal_int64(5040256896, total);
    };

    // Leads E0 through F7 with every second byte and a sample of later bytes.
    export let test_long_sequences = func() -> void {
        let count = 0;
        let total: int64 = 0;
        let thirds: uint8[] = [65, 128, 191];
        let a = 224;
        while (a < 248) {
            let totals: int[] = [0, 0];
            let b = 0;
            while (b < 256) {
                for (let c in thirds) {
                    let candidate: uint8[list] = new([a as uint8, b as uint8, c, 128]);
                    check_candidate(candidate);
                    add_lossy(candidate, totals);
                }
                b = b + 1;
            }
            count = count + totals[0];
            total = total + (totals[1] as int64);
            a = a + 1;
        }
        test.assert_equal_int32(82304, count);
        test.assert_equal_int64(4477842112, total);
    };

    export let test_scalars_and_offsets = func() -> void {
        let text = "Aé€🙂";
        let expected: uint32[list] = new([65, 233, 8364, 128578]);
        test.assert_equal<uint32[list]>(expected, strings.scalars(text));
        let offsets: [int, uint32][list] = new([[0, 65], [1, 233], [3, 8364], [6, 128578]]);
        test.assert_equal<[int, uint32][list]>(offsets, strings.scalar_offsets(text));
        let none: uint32[list] = new;
        test.assert_equal<uint32[list]>(none, strings.scalars(""));
        test.assert_equal_int32(0, strings.scalar_offsets("").length);
        test.assert_equal_int32(4, strings.scalar_count(text));
        test.assert_equal_int32(10, strings.byte_length(text));
        test.assert_equal_int32(0, strings.scalar_count(""));
    };

    export let test_scalar_at = func() -> void {
        let text = "Aé€🙂";
        test.assert(strings.scalar_at(text, 0) == 65);
        test.assert(strings.scalar_at(text, 1) == 233);
        test.assert(strings.scalar_at(text, 3) == 8364);
        test.assert(strings.scalar_at(text, 6) == 128578);
        test.assert(strings.byte_at(text, 1) == 195);
        test.assert(strings.byte_at(text, 9) == 130);
    };

    export let test_boundaries = func() -> void {
        let text = "Aé🙂";
        test.assert(strings.is_boundary(text, 0));
        test.assert(strings.is_boundary(text, 1));
        test.assert(!strings.is_boundary(text, 2));
        test.assert(strings.is_boundary(text, 3));
        test.assert(!strings.is_boundary(text, 4));
        test.assert(!strings.is_boundary(text, 6));
        test.assert(strings.is_boundary(text, 7));
        test.assert(!strings.is_boundary(text, 8));
        test.assert(!strings.is_boundary(text, -1));
        test.assert(strings.is_boundary("", 0));
        test.assert(!strings.is_boundary("", 1));
    };

    export let test_from_scalars = func() -> void {
        let values: uint32[list] = new([0, 127, 128, 2047, 2048, 55295, 57344, 65535, 65536, 1114111]);
        let text = strings.from_scalars(values);
        test.assert_equal<uint32[list]>(values, strings.scalars(text));
        let bytes: uint8[list] = new([0, 127, 194, 128, 223, 191, 224, 160, 128, 237, 159, 191, 238, 128, 128, 239, 191, 191,
            240, 144, 128, 128, 244, 143, 191, 191]);
        test.assert_equal<uint8[list]>(bytes, strings.to_bytes(text));
        let empty: uint32[list] = new;
        test.assert_equal_string("", strings.from_scalars(empty));
        test.assert_equal_string("é🙂", strings.from_scalars(new([233, 128578])));
    };

    export let test_to_bytes_is_a_copy = func() -> void {
        let text = "abcdefghé";
        let bytes = strings.to_bytes(text);
        test.assert_equal_int32(10, bytes.length);
        bytes[0] = 65;
        test.assert_equal_string("abcdefghé", text);
        test.assert_equal_string("Abcdefghé", test.assert_ok<string>(strings.from_bytes(bytes)));
        test.assert_equal_int32(0, strings.to_bytes("").length);
    };
);
