// run-options: --max-heap-cells 20000
let console = import:Std.Io.Console;
let linked_list = import:Std.Collections.LinkedList;
let program = import:Std.Program;

// An iterator keeps the first node it would return. Removal clears that
// node's links, so the held node does not keep the 2,000 later nodes (100
// cells each) reachable.
export let Main = module:program.Entry (
    let block = func(seed: int) -> int[list] {
        let values: int[list] = [];
        let i = 0;
        while (i < 100) {
            values.append(seed + i);
            i = i + 1;
        }
        return values;
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        let items = linked_list.create<int[list]>();
        items.add(block(0));
        let walk = items.iterator();
        let total: int64 = 0;
        let round = 1;
        while (round <= 2000) {
            items.add_last(block(round));
            total = total + (items.remove_first()[0] as int64);
            round = round + 1;
        }
        console.print_line(items.size().to_string() + " " + total.to_string());
        return program.ExitCode.Ok;
    };
);
