// status: 70
// stderr: explicit program failure \(trap reason 3\): expected a value other than <\[1, true\]>
let program = import:Std.Program;
let error = import:Std.Core.Error;
let optional = import:Std.Core.Optional;
let result = import:Std.Core.Result;
let test = import:Std.Test;

export let Main = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        test.assert_not_equal<[int, bool]>([1, true], [1, true]);

        return program.ExitCode.Ok;
    };
);
