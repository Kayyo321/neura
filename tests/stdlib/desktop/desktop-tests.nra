let desktop = import:Std.Desktop;
let hex = import:Std.Encoding.Hex;
let.promote _ = import:Std.Core.Result;
let strings = import:Std.Text.Strings;
let test = import:Std.Test;

// The native side of the desktop channel without a host: the registry text and digest, and the dispatcher.
// tests/desktop/bridge_test.js covers the frame codec against the window host with the real child.
// The registry digest was computed with
//   printf '%s' '{"operations":["fixture.echo","fixture.fail","fixture.open","fixture.quit","fixture.title","fixture.trap","fixture.unserved"],"schema":1}' | sha256sum
// and tests/desktop/bridge_test.js checks the same value against the window host's parser.
let DesktopTests = module (
    let fixture_ids = func -> string[list] => new(["fixture.echo", "fixture.fail", "fixture.open", "fixture.quit",
        "fixture.title", "fixture.trap", "fixture.unserved"]);

    export let test_registry_text_and_digest = func() -> void {
        last registry = new desktop.Registry(fixture_ids());
        test.assert_equal_string("{\"operations\":[\"fixture.echo\",\"fixture.fail\",\"fixture.open\",\"fixture.quit\","
            + "\"fixture.title\",\"fixture.trap\",\"fixture.unserved\"],\"schema\":1}", registry.json());
        test.assert_equal_string("c382c24eef75233e4501dc8bc8043df62f53406855f3870651b5c1e56c8bbcb0",
            hex.encode(registry.digest()));
        test.assert(registry.contains("fixture.echo"));
        test.assert(!registry.contains("fixture.missing"));
        test.assert(registry.equals(new desktop.Registry(fixture_ids())));
        last empty: string[list] = new;
        test.assert_equal_string("{\"operations\":[],\"schema\":1}", new desktop.Registry(empty).json());
    };

    export let test_dispatcher_answers_unserved_operations = func() -> void {
        last registry = new desktop.Registry(fixture_ids());
        last dispatcher = new desktop.Dispatcher(registry);
        dispatcher.add("fixture.echo", func(call: desktop.Call) -> Result<uint8[list]> =>
            Result<uint8[list]>.Ok(call.request));
        last context = new desktop.Context(registry);
        last window = new desktop.Window(3, context);
        let [status, reply] = dispatcher.dispatch(new desktop.Call(1, window, "fixture.echo", strings.to_bytes("hi"), 5));
        test.assert_equal_uint64(0, status as uint64);
        test.assert_equal_string("6869", hex.encode(reply));
        let [missing, message] = dispatcher.dispatch(new desktop.Call(2, window, "fixture.fail", new([]), 5));
        test.assert_equal_uint64(13, missing as uint64);
        test.assert_equal_string("756e737570706f727465643a206f7065726174696f6e20666978747572652e6661696c", hex.encode(message));
    };
);
