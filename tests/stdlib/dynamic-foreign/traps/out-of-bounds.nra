// status: 134
// stderr: explicit program failure \(trap reason 3\): invalid argument: out of bounds
// run-options: --allow-native
let console = import:Std.Io.Console;
let program = import:Std.Program;
let arenas = import:Std.DynamicForeign.Arena;

// A read that would cross the end of a segment traps before touching memory.
export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let arena = arenas.of_confined();
        let segment = arena.allocate(8, 8);
        segment.set_int32(4, 7);
        console.print_line(segment.get_int32(4).to_string());
        console.print_line(segment.get_int32(5).to_string());
        return program.ExitCode.Ok;
    };
);
