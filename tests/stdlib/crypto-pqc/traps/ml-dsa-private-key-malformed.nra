// status: 134
// stderr: explicit program failure \(trap reason 3\): invalid argument: ML-DSA-44 private key is malformed
let ml_dsa = import:Std.Crypto.Pqc.MlDsa;
let program = import:Std.Program;

let App = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let seed: uint8[list] = new;
        for (let i = 0; i < 32; i++) {
            seed.append(i as uint8);
        }
        let bytes = ml_dsa.key_pair_from_seed(ml_dsa.ParameterSet.MlDsa44, seed).expose();
        // A byte of tr.
        bytes[70] = bytes[70] ^ 1;
        let _ = new ml_dsa.MlDsaPrivateKey(ml_dsa.ParameterSet.MlDsa44, bytes);
        return program.ExitCode.Ok;
    };
);
