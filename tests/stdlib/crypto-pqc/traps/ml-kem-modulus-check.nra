let ml_kem = import:Std.Crypto.Pqc.MlKem;
let program = import:Std.Program;

let App = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        // Every 12-bit coefficient is 4095, above q.
        let bytes: uint8[list] = new;
        for (let i = 0; i < 800; i++) {
            bytes.append(255);
        }
        let _ = new ml_kem.MlKemPublicKey(ml_kem.ParameterSet.MlKem512, bytes);
        return program.ExitCode.Ok;
    };
);
