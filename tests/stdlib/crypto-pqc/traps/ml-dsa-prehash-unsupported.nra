// status: 134
// stderr: explicit program failure \(trap reason 3\): invalid argument: Blake3 is not a pre-hash function of HashML-DSA or HashSLH-DSA
let.promote _ = import:Std.Crypto.Algorithm;
let ml_dsa = import:Std.Crypto.Pqc.MlDsa;
let program = import:Std.Program;

let App = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let seed: uint8[list] = new;
        for (let i = 0; i < 32; i++) {
            seed.append(i as uint8);
        }
        let signer = new ml_dsa.MlDsaSigner(ml_dsa.key_pair_from_seed(ml_dsa.ParameterSet.MlDsa44, seed));
        let _ = signer.sign_prehash_with(new([1]), new, Algorithm.Blake3, seed);
        return program.ExitCode.Ok;
    };
);
