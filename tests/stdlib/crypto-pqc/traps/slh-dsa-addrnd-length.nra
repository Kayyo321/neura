    export let.override main = func(args: string[]) -> program.ExitCode {
        let seed: uint8[list] = new;
        for (let i = 0; i < 16; i++) {
            seed.append(i as uint8);
        }
        let key = slh_dsa.key_pair_from_seed(slh_dsa.ParameterSet.Sha2_128f, seed, seed, seed);
        let _ = new slh_dsa.SlhDsaSigner(key).sign_with(new([1]), new, new([1, 2, 3]));
        return program.ExitCode.Ok;
    };
);
