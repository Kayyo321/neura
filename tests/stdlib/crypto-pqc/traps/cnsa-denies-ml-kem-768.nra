// status: 134
// stderr: explicit program failure \(trap reason 3\): denied: MlKem768 is not allowed under the Cnsa2_0 policy
let crypto_policy = import:Std.Crypto.Core.CryptoPolicy;
let ml_kem = import:Std.Crypto.Pqc.MlKem;
let program = import:Std.Program;

let App = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        crypto_policy.set_policy(crypto_policy.Policy.Cnsa2_0);
        let _ = new ml_kem.MlKem(ml_kem.ParameterSet.MlKem1024);
        let _ = new ml_kem.MlKem(ml_kem.ParameterSet.MlKem768);
        return program.ExitCode.Ok;
    };
);
