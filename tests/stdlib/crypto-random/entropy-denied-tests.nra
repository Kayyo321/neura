// test-options: --gpu=off --deny-entropy
let drbg = import:Std.Crypto.Random.ChaCha20Drbg;
let entropy = import:Std.Crypto.Random.Entropy;
let error = import:Std.Core.Error;
let test = import:Std.Test;

// With --deny-entropy, the operating system's bytes fail with CapabilityDenied, and so does a generator seeded
// from them.
let EntropyDeniedTests = module (
    export let test_os_bytes_denied = func {
        last failure = test.assert_err(entropy.os_bytes(16));
        test.assert_equal_string("CapabilityDenied: entropy request failed", error.message(failure));
    };

    export let test_hardware_bytes_denied = func {
        for (let count in 0 ..= 1) {
            last failure = test.assert_err(entropy.hardware_bytes(count));
            test.assert_equal_string("CapabilityDenied: hardware entropy request failed", error.message(failure));
        }
    };

    export let test_fused_seed_denied = func {
        last failure = test.assert_err(entropy.fused_seed());
        test.assert_equal_string("CapabilityDenied: entropy request failed", error.message(failure));
    };

    export let test_drbg_from_entropy_denied = func {
        let _ = test.assert_err(drbg.from_entropy());
    };

    export let test_fork_generation_denied = func {
        last failure = test.assert_err(entropy.try_fork_generation());
        test.assert_equal_string("CapabilityDenied: process generation failed", error.message(failure));
        let _ = test.assert_err(drbg.fork_safe());
    };
);
