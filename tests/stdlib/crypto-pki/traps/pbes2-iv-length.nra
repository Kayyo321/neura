// status: 134
// stderr: explicit program failure \(trap reason 3\): invalid argument: PBES2 IV or nonce has the wrong length
let keys = import:Std.Crypto.Pki.PrivateKeyInfo;
let oid = import:Std.Crypto.Pki.Oid;
let oids = import:Std.Crypto.Pki.Oids;
let program = import:Std.Program;
let writer = import:Std.Crypto.Pki.DerWriter;
let.promote _ = import:Std.Core.Result;

let App = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        // OneAsymmetricKey v1 with an Ed25519 identifier and a 34-byte private key.
        let key: uint8[list] = new([4, 32]);
        for (let i = 0; i < 32; i++) {
            key.append(i as uint8);
        }
        last der = writer.sequence(new([writer.integer(0), writer.sequence(new([writer.oid(oid.of(oids.Ed25519))])),
            writer.octet_string(key)]));
        match (keys.parse(der)) {
            Result.Ok(info) => {
                // An AES-GCM nonce must be 12 bytes.
                let _ = keys.encrypt(info, new([1]), new([2]), 1, oids.HmacWithSha256, oids.Aes256Gcm, new([0, 0, 0]));
            },
            Result.Err(e) => {},
        }
        return program.ExitCode.Ok;
    };
);
