// status: 134
// stderr: explicit program failure \(trap reason 3\): collection modified during iteration
let optional = import:Std.Core.Optional;
let program = import:Std.Program;
let string_map = import:Std.Collections.StringMap;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let map = string_map.create<int>();
        map.set("a", 1);
        map.set("b", 2);
        map.compute("a", func(key: string, current: optional.Optional<int>) -> optional.Optional<int> {
            map.clear();
            return current;
        });
        return program.ExitCode.Ok;
    };
);
