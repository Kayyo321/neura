let map_model = import:MapModel;
let string_map = import:Std.Collections.StringMap;

// Seeded model-based tests (Stdlib.md section 17): 10,000 operations
// against an association list in insertion order, calling validate() after
// every operation.
let StringMapModelTests = module (
    export let test_model = func() -> void {
        let map = string_map.create<int>();
        map_model.run<string>(map, func(int id) -> string {
            return "k" + id.to_string();
        }, map.validate, map.trim, false, 31, 10000, 24, 160);
    };

    // Short keys with the empty string and multi-byte text.
    export let test_model_varied_keys = func() -> void {
        let map = string_map.with_capacity<int>(40);
        let keys: string[list] = ["", "a", "b", "ab", "ba", "é", "日本", "Ω", "zz"];
        map_model.run<string>(map, func(int id) -> string {
            return keys[id % 9] + (id / 9).to_string();
        }, map.validate, map.trim, false, 32, 3000, 20, 60);
    };
);
