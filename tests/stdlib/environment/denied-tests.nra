let error = import:Std.Core.Error;
let program = import:Std.Program;
let test = import:Std.Test;

// Without --allow-env every lookup fails with CapabilityDenied.
let EnvironmentDeniedTests = module (
    export let test_lookup_is_denied = func() -> void {
        match (program.Environment.get("PATH")) {
            program.Environment.Lookup.Failed(failure) => {
                test.assert_equal_string("CapabilityDenied: environment lookup failed", error.message(failure));
            },
            _ => {
                test.fail("expected Failed");
            },
        }
    };
);
