// The Neura implementation of Std.Math.Internal.Words before Std.Math.Math became a set of
// kernel bindings, kept unchanged (but for the module's name and its imports) as
// the oracle of kernel-oracle.nra. It lives with the tests, not in the standard
// library: only library source may import an Internal module, and code here
// never reaches a user's image.
//
/// @brief Access to the 32-bit words of a float64 encoding, as fdlibm's __HI and __LO macros give them
/// (Stdlib.md section 10.1).
///
/// The high word is a signed int: fdlibm compares it with signed constants and shifts it arithmetically.
export let ReferenceMathWords = module (
    /// @brief The high 32 bits of the encoding as a two's complement int.
    export let high = func(x: float64) -> int {
        let h = x.to_bits() >> 32;
        if (h >= 2147483648) {
            return ((h as int64) - 4294967296) as int;
        }
        return h as int;
    };

    /// @brief The low 32 bits of the encoding.
    export let low = func(x: float64) -> uint32 => (x.to_bits() & 4294967295) as uint32;

    /// @brief The float64 whose encoding has the given high and low words.
    export let from_words = func(hi: int, lo: uint32) -> float64 {
        let h: uint64 = 0;
        if (hi < 0) {
            h = ((hi as int64) + 4294967296) as uint64;
        } else {
            h = hi as uint64;
        }
        return float64.from_bits((h << 32) | (lo as uint64));
    };

    /// @brief x with its high word replaced.
    export let with_high = func(x: float64, hi: int) -> float64 => from_words(hi, low(x));

    /// @brief x with its low word replaced.
    export let with_low = func(x: float64, lo: uint32) -> float64 =>
        float64.from_bits((x.to_bits() & 18446744069414584320) | (lo as uint64));

    /// @brief |x| by clearing the sign bit, like fdlibm's fabs. Never rounds.
    export let abs = func(x: float64) -> float64 => float64.from_bits(x.to_bits() & 9223372036854775807);

    /// @brief fdlibm's s_scalbn.c: x times 2^n, computed on the exponent field.
    export let scalbn = func(x: float64, n: int) -> float64 {
        let two54 = float64.from_bits(4850376798678024192); // 0x4350000000000000 1.80143985094819840000e+16
        let twom54 = float64.from_bits(4363988038922010624); // 0x3C90000000000000 5.55111512312578270212e-17
        let huge = 1.0e300;
        let tiny = 1.0e-300;
        let hx = high(x);
        let lx = low(x);
        let k = (hx & 2146435072) >> 20; // 0x7ff00000
        if (k == 0) {
            if (lx == 0 && (hx & 2147483647) == 0) {
                return x;
            }
            x *= two54;
            hx = high(x);
            k = ((hx & 2146435072) >> 20) - 54;
            if (n < -50000) {
                return tiny * x;
            }
        }
        if (k == 2047) {
            return x + x;
        }
        if (n > 50000 || k + n > 2046) {
            return huge * copy_sign(huge, x);
        }
        k += n;
        if (k > 0) {
            return with_high(x, (hx & -2146435073) | (k << 20)); // 0x800fffff
        }
        if (k <= -54) {
            return tiny * copy_sign(tiny, x);
        }
        k += 54;
        x = with_high(x, (hx & -2146435073) | (k << 20));
        return x * twom54;
    };

    /// @brief magnitude with the sign bit of sign.
    export let copy_sign = func(magnitude: float64, sign: float64) -> float64 {
        return float64.from_bits((magnitude.to_bits() & 9223372036854775807) | (sign.to_bits() & 9223372036854775808));
    };
);
