// run-options: --max-heap-cells 12000
let console = import:Std.Io.Console;
let int32 = import:Std.Core.Int32;
let program = import:Std.Program;
let tree_map = import:Std.Collections.TreeMap;

// A removed node becomes unreachable at once (Stdlib.md section 9.7). The
// map keeps 8 entries; each round adds a 2,000-element value and removes the
// previous one by delete, remove, remove_first, or remove_if. The run needs
// about 10,500 cells (two live values, one being built, and short-lived
// temporaries); if removed values stayed reachable, 300 rounds would need
// about 600,000.
export let Main = module:program.Entry (
    let block = func(seed: int) -> int[list] {
        let values: int[list] = [];
        let i = 0;
        while (i < 2000) {
            values.append(seed + i);
            i = i + 1;
        }
        return values;
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        let map = tree_map.create<int, int[list]>(int32.compare);
        let i = 0;
        while (i < 7) {
            let small: int[list] = [i];
            map.set(1000 + i, small);
            i = i + 1;
        }
        let total: int64 = 0;
        let round = 0;
        while (round < 300) {
            map.set(round, block(round));
            if (round > 0) {
                let previous = round - 1;
                total = total + (map.require(previous)[1] as int64);
                if (round % 4 == 0) {
                    map.delete(previous);
                } else if (round % 4 == 1) {
                    map.remove(previous);
                } else if (round % 4 == 2) {
                    map.remove_first();
                } else {
                    map.remove_if(func(key: int, value: int[list]) -> bool {
                        return key == previous;
                    });
                }
            }
            round = round + 1;
        }
        map.validate();
        console.print_line(map.size().to_string() + " " + total.to_string());
        return program.ExitCode.Ok;
    };
);
