// status: 70
// stderr: explicit program failure \(trap reason 3\): collection modified during iteration
let int32 = import:Std.Core.Int32;
let optional = import:Std.Core.Optional;
let program = import:Std.Program;
let tree_map = import:Std.Collections.TreeMap;

export let Main = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        let map = tree_map.create<int, int>(int32.compare);
        map.set(2, 2);
        map.set(1, 1);
        map.compute(1, func(int key, optional.Optional<int> current) -> optional.Optional<int> {
            map.remove_last();
            return current;
        });
        return program.ExitCode.Ok;
    };
);
