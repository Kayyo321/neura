let regex_check = import:RegexCheck;

// Seeded random patterns and inputs compared with python3's re module. The
// generator never quantifies an item that can match empty and never runs
// \B on an empty input, the two places where Python's results differ
// (see regex-tests.nra).
// Python ran each pattern with re.ASCII and the IGNORECASE, MULTILINE, and
// DOTALL flags matching the test's flags (1, 2, 4), with $ without
// multi_line translated to \Z, (?<name> to (?P<name>, and \u{X} to
// \UXXXXXXXX. find_all was emulated with pattern.search(input, pos),
// resuming one scalar after an empty match, as Stdlib.md 8.4 specifies;
// `full` is re.fullmatch. Generated by generators/generate.py; do not edit by hand.
