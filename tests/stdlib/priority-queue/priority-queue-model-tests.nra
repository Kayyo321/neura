let model_random = import:ModelRandom;
let ordering = import:Std.Core.Ordering;
let priority_queue = import:Std.Collections.PriorityQueue;
let test = import:Std.Test;

// Drives a PriorityQueue and a trivially correct model (a count per value
// from 0 to 99) with the same seeded operations. After every operation it
// calls validate() and compares the size, the multiset of elements, and the
// iteration order with to_list().
let PriorityQueueModelTests = module (
    const Values: int = 100;

    let compare = func(int a, int b) -> ordering.Ordering {
        if (a < b) {
            return ordering.Ordering.Less;
        }
        if (a > b) {
            return ordering.Ordering.Greater;
        }
        return ordering.Ordering.Equal;
    };

    let least = func(int[list] counts) -> int {
        let v = 0;
        while (counts[v] == 0) {
            v = v + 1;
        }
        return v;
    };

    let check = func(priority_queue.PriorityQueue<int> actual, int[list] counts, int size) -> void {
        actual.validate();
        test.assert_equal_int32(size, actual.size());
        test.assert_equal_bool(size == 0, actual.is_empty());
        let remaining: int[list] = [];
        for (let count in counts) {
            remaining.append(count);
        }
        let order = actual.to_list();
        let walk = actual.iterator();
        let i = 0;
        while (walk.has_next()) {
            let value = walk.next();
            test.assert_equal_int32(order[i], value);
            remaining[value] = remaining[value] - 1;
            i = i + 1;
        }
        test.assert_equal_int32(size, i);
        for (let count in remaining) {
            test.assert_equal_int32(0, count);
        }
    };

    let run = func(uint64 seed, int operations) -> void {
        let random = model_random.seeded(seed);
        let actual = priority_queue.create<int>(compare);
        let counts: int[list] = [];
        let v = 0;
        while (v < Values) {
            counts.append(0);
            v = v + 1;
        }
        let size = 0;
        let step = 0;
        while (step < operations) {
            let choice = random.below(100);
            let value = random.below(Values);
            if (size > 60 && choice < 45) {
                choice = choice + 45;
            }
            if (choice < 45) {
                actual.enqueue(value);
                counts[value] = counts[value] + 1;
                size = size + 1;
            } else if (choice < 70) {
                if (size > 0) {
                    let expected = least(counts);
                    test.assert_equal_int32(expected, actual.dequeue());
                    counts[expected] = counts[expected] - 1;
                    size = size - 1;
                }
            } else if (choice < 78) {
                let taken = actual.try_dequeue();
                if (size > 0) {
                    let expected = least(counts);
                    test.assert_equal_int32(expected, test.assert_some<int>(taken));
                    counts[expected] = counts[expected] - 1;
                    size = size - 1;
                } else {
                    test.assert_none<int>(taken);
                }
            } else if (choice < 86) {
                let seen = actual.peek();
                if (size > 0) {
                    test.assert_equal_int32(least(counts), test.assert_some<int>(seen));
                } else {
                    test.assert_none<int>(seen);
                }
            } else if (choice < 94) {
                test.assert_equal_bool(counts[value] > 0, actual.contains(value));
            } else if (choice < 95) {
                actual.clear();
                let w = 0;
                while (w < Values) {
                    counts[w] = 0;
                    w = w + 1;
                }
                size = 0;
            } else if (choice < 96) {
                let drained = actual.drain_sorted();
                test.assert_equal_int32(size, drained.length);
                let i = 0;
                let w = 0;
                while (w < Values) {
                    while (counts[w] > 0) {
                        test.assert_equal_int32(w, drained[i]);
                        counts[w] = counts[w] - 1;
                        i = i + 1;
                    }
                    w = w + 1;
                }
                size = 0;
            } else if (choice < 98) {
                let seen: int[list] = [];
                actual.for_each(func(int element) -> void {
                    seen.append(element);
                });
                test.assert(seen.equals(actual.to_list()));
            } else {
                test.assert_equal_string(actual.to_list().to_string(), actual.to_string());
            }
            check(actual, counts, size);
            step = step + 1;
        }
    };

    export let test_model_seed_1 = func() -> void {
        run(1, 5000);
    };

    export let test_model_seed_2 = func() -> void {
        run(8675309, 5000);
    };

    // Heapifying seeded lists agrees with the model too.
    export let test_from_list = func() -> void {
        let random = model_random.seeded(12);
        let round = 0;
        while (round < 50) {
            let items: int[list] = [];
            let count = random.below(80);
            let i = 0;
            while (i < count) {
                items.append(random.below(Values));
                i = i + 1;
            }
            let heap = priority_queue.from_list<int>(items, compare);
            heap.validate();
            let drained = heap.drain_sorted();
            test.assert_equal_int32(count, drained.length);
            i = 1;
            while (i < count) {
                test.assert(drained[i - 1] <= drained[i]);
                i = i + 1;
            }
            test.assert(heap.is_empty());
            round = round + 1;
        }
    };
);
