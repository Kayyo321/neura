// status: 70
// stderr: explicit program failure \(trap reason 3\): collection modified during iteration
let console = import:Std.Io.Console;
let ordering = import:Std.Core.Ordering;
let priority_queue = import:Std.Collections.PriorityQueue;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let compare = func(a: int, b: int) -> ordering.Ordering {
            if (a < b) {
                return ordering.Ordering.Less;
            }
            if (a > b) {
                return ordering.Ordering.Greater;
            }
            return ordering.Ordering.Equal;
        };
        let items = priority_queue.from_list<int>([1, 2], compare);
        let walk = items.iterator();
        console.print_line(walk.next().to_string());
        items.enqueue(items.dequeue());
        console.print_line(items.size().to_string());
        console.print_line(walk.has_next().to_string());
        return program.ExitCode.Ok;
    };
);
