// status: 70
// stderr: explicit program failure \(trap reason 3\): invalid state: heap order
let console = import:Std.Io.Console;
let ordering = import:Std.Core.Ordering;
let priority_queue = import:Std.Collections.PriorityQueue;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        let flip: bool[list] = [false];
        let items = priority_queue.create<int>(func(int a, int b) -> ordering.Ordering {
            if (flip[0]) {
                if (a > b) {
                    return ordering.Ordering.Less;
                }
                return ordering.Ordering.Greater;
            }
            if (a < b) {
                return ordering.Ordering.Less;
            }
            return ordering.Ordering.Greater;
        });
        items.enqueue(1);
        items.enqueue(2);
        items.validate();
        console.print_line("valid");
        flip[0] = true;
        items.validate();
        return program.ExitCode.Ok;
    };
);
