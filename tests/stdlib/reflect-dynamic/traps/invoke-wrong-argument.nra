// status: 134
// stderr: reflection: argument 1 of Counter.add must be int32
// Arguments are checked before the call (docs/design/Reflect030.md, edge case 8).
let console = import:Std.Io.Console;
let program = import:Std.Program;
let variants = import:Std.Reflect.Dynamic.Variant;

let Counter = class (
    export let count: int32 = 0;
    export let add = func(by: int32) -> int32 {
        count = count + by;
        return count;
    };
);

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line("before");
        last arguments: variants.Variant[list] = new;
        arguments.append(variants.of("one"));
        variants.of(new Counter()).invoke_named("add", arguments);
        console.print_line("after");
        return program.ExitCode.Ok;
    };
);
