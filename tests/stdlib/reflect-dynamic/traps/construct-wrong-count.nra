// status: 134
// stderr: reflection: new Point takes 2 argument\(s\)
// The constructor is not called with the wrong number of arguments (docs/design/Reflect030.md, edge case 7).
let console = import:Std.Io.Console;
let program = import:Std.Program;
let types = import:Std.Reflect.Type.TypeDescriptor;
let variants = import:Std.Reflect.Dynamic.Variant;

let Point = record (x: int32, y: int32);

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line("before");
        last arguments: variants.Variant[list] = new;
        arguments.append(variants.of(1 as int32));
        variants.construct(types.of<Point>(), 0, arguments);
        console.print_line("after");
        return program.ExitCode.Ok;
    };
);
