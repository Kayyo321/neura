// status: 70
// stderr: explicit program failure \(trap reason 3\): no such element
let console = import:Std.Io.Console;
let int32 = import:Std.Core.Int32;
let program = import:Std.Program;
let tree_set = import:Std.Collections.TreeSet;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let set = tree_set.create<int>(int32.compare);
        set.add(1);
        set.add(2);
        let items = set.iterator();
        while (items.has_next()) {
            console.print_line(items.next().to_string());
        }
        items.next();
        return program.ExitCode.Ok;
    };
);
