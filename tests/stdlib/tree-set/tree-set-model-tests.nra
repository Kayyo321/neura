let int32 = import:Std.Core.Int32;
let ordering = import:Std.Core.Ordering;
let set_model = import:SetModel;
let tree_set = import:Std.Collections.TreeSet;

// Seeded model-based tests (Stdlib.md section 17): 10,000 operations
// against a list of ids kept ascending, calling validate() after every
// operation.
let TreeSetModelTests = module (
    let nothing = func() -> void {};

    export let test_model = func() -> void {
        let set = tree_set.create<int>(int32.compare);
        set_model.run<int>(set, func(id: int) -> int {
            return id;
        }, set.validate, nothing, true, 51, 10000, 24, 160);
    };

    // Descending element values under a reversed comparator still ascend
    // in comparator order.
    export let test_model_reversed_comparator = func() -> void {
        let set = tree_set.create<int>(func(a: int, b: int) -> ordering.Ordering {
            return int32.compare(b, a);
        });
        set_model.run<int>(set, func(id: int) -> int {
            return -id;
        }, set.validate, nothing, true, 52, 3000, 16, 80);
    };
);
