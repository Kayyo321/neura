let duration = import:Std.Time.Duration;
let error = import:Std.Core.Error;
let hashing = import:Std.Core.Hash;
let local_time = import:Std.Time.LocalTime;
let ordering = import:Std.Core.Ordering;
let test = import:Std.Test;

let LocalTimeTests = module (
    let check_error = func(string text, error.ParseErrorKind kind, int offset) -> void {
        let failure = test.assert_err<local_time.LocalTime>(local_time.parse(text));
        match (failure) {
            error.Error.Parse { kind: actual, offset: at, message: _ } => {
                test.assert_equal_string(kind.to_string(), actual.to_string());
                test.assert_equal_int32(offset, at);
            },
            _ => {
                test.fail("expected a parse error for " + text);
            },
        }
    };

    // Expected text computed with Python: (start + shift) mod one day.
    let check_plus = func(int64 start, int64 shift, string text) -> void {
        let moved = local_time.of_nano_of_day(start).plus(duration.of_nanos(shift));
        test.assert_equal_string(text, moved.to_string());
        test.assert(test.assert_ok<local_time.LocalTime>(local_time.parse(text)).equals(moved));
    };

    export let test_fields = func() -> void {
        let t = local_time.of(13, 45, 30, 123456789);
        test.assert_equal_int32(13, t.hour());
        test.assert_equal_int32(45, t.minute());
        test.assert_equal_int32(30, t.second());
        test.assert_equal_int32(123456789, t.nano());
        test.assert_equal_int64(49530123456789, t.to_nano_of_day());
        let last = local_time.of(23, 59, 59, 999999999);
        test.assert_equal_int64(86399999999999, last.to_nano_of_day());
        test.assert(local_time.of_nano_of_day(86399999999999).equals(last));
        test.assert_equal_int64(0, local_time.Midnight.to_nano_of_day());
        test.assert(local_time.of(0, 0, 0, 0).equals(local_time.Midnight));
    };

    export let test_plus_wraps = func() -> void {
        let late = local_time.of(23, 30, 0, 0);
        test.assert_equal_string("00:30:00", late.plus(duration.of_hours(1)).to_string());
        test.assert_equal_string("22:30:00", late.plus(duration.of_hours(-25)).to_string());
        test.assert_equal_string("23:30:00", late.plus(duration.of_days(-3)).to_string());
        test.assert_equal_string("23:59:59.999999999", local_time.Midnight.plus(duration.of_nanos(-1)).to_string());
        check_plus(86399999999999, -86400000000000, "23:59:59.999999999");
        check_plus(36692000000000, -32571976512261, "01:08:40.023487739");
        check_plus(86399999999999, 0, "23:59:59.999999999");
        check_plus(86399999999999, 6172621865212, "01:42:52.621865211");
        check_plus(58295642000000, 86400000000000, "16:11:35.642");
        check_plus(86399999999999, -86400000000000, "23:59:59.999999999");
        check_plus(15453262000000, -86400000000000, "04:17:33.262");
        check_plus(0, 50265187221406, "13:57:45.187221406");
        check_plus(1075000000000, 6552539364843190278, "14:07:19.843190278");
        check_plus(86399999999999, 140290149758274, "14:58:10.149758273");
        check_plus(54396302000000, 0, "15:06:36.302");
        check_plus(0, 0, "00:00:00");
        check_plus(52723000000000, -563537203334817, "02:06:25.796665183");
        check_plus(55433100275596, -86400000000000, "15:23:53.100275596");
        check_plus(73535619000000, 1596020975287286351, "07:35:10.906286351");
        check_plus(44962061000000, 0, "12:29:22.061");
        check_plus(86399999999999, 27508955912117, "07:38:28.955912116");
        check_plus(34297837000000, -86400000000000, "09:31:37.837");
        check_plus(26737554000000, 0, "07:25:37.554");
        check_plus(27747804000000, 3110713595415559266, "22:49:03.219559266");
        check_plus(49724986771844, -672304001861380, "19:03:40.984910464");
        check_plus(86399999999999, 3352944558054835151, "05:29:18.054835150");
        check_plus(54923442000000, -502863853343651750, "10:51:10.098348250");
        check_plus(34226024000000, 37068645431281, "19:48:14.669431281");
        check_plus(54645197436726, -86400000000000, "15:10:45.197436726");
        check_plus(6735219550653, 0, "01:52:15.219550653");
        check_plus(86399999999999, 634003377426264, "08:06:43.377426263");
        check_plus(86399999999999, 86400000000000, "23:59:59.999999999");
        check_plus(6889759000000, -86400000000000, "01:54:49.759");
        check_plus(71435000000000, 29099084202949, "03:55:34.084202949");
        check_plus(32875813814492, 664176842889210, "01:37:32.656703702");
        check_plus(73001255000000, 0, "20:16:41.255");
        check_plus(0, 7473583935791, "02:04:33.583935791");
        check_plus(64321260000000, 86400000000000, "17:52:01.260");
        check_plus(65940226760510, 259769468161636, "18:28:29.694922146");
        check_plus(86399999999999, 630804465927583, "07:13:24.465927582");
        check_plus(72833000000000, 0, "20:13:53");
        check_plus(86399999999999, -9814103937609, "21:16:25.896062390");
        check_plus(3597000000000, 86400000000000, "00:59:57");
        check_plus(44188617000000, 35133461289413, "22:02:02.078289413");
    };

    export let test_text = func() -> void {
        test.assert_equal_string("00:00:00", local_time.Midnight.to_string());
        test.assert_equal_string("01:02:03.100", local_time.of(1, 2, 3, 100000000).to_string());
        test.assert_equal_string("01:02:03.000100", local_time.of(1, 2, 3, 100000).to_string());
        test.assert_equal_string("01:02:03.000000100", local_time.of(1, 2, 3, 100).to_string());
        test.assert_equal_string("01:02:03.120", local_time.of(1, 2, 3, 120000000).to_string());
        test.assert_equal_string("01:02:03.120001", local_time.of(1, 2, 3, 120001000).to_string());
    };

    export let test_parse = func() -> void {
        test.assert(test.assert_ok<local_time.LocalTime>(local_time.parse("23:59:59.5")).equals(local_time.of(23, 59, 59, 500000000)));
        test.assert(test.assert_ok<local_time.LocalTime>(local_time.parse("00:00:00.000000001")).equals(local_time.of(0, 0, 0, 1)));
        check_error("", error.ParseErrorKind.Empty, 0);
        check_error("12", error.ParseErrorKind.UnexpectedEnd, 2);
        check_error("12:00", error.ParseErrorKind.UnexpectedEnd, 5);
        check_error("12:00:00.", error.ParseErrorKind.UnexpectedEnd, 9);
        check_error("1:00:00", error.ParseErrorKind.InvalidCharacter, 1);
        check_error("12-00-00", error.ParseErrorKind.InvalidCharacter, 2);
        check_error("12:00:00Z", error.ParseErrorKind.InvalidCharacter, 8);
        check_error("12:00:00.1234567890", error.ParseErrorKind.InvalidCharacter, 18);
        check_error("12:00:00,5", error.ParseErrorKind.InvalidCharacter, 8);
        check_error("24:00:00", error.ParseErrorKind.OutOfRange, 0);
        check_error("23:60:00", error.ParseErrorKind.OutOfRange, 3);
        check_error("23:59:60", error.ParseErrorKind.OutOfRange, 6);
        let failure = test.assert_err<local_time.LocalTime>(local_time.parse("24:00:00"));
        test.assert_equal_string("parse error at 0: hour out of range", error.message(failure));
    };

    export let test_order_and_equality = func() -> void {
        let a = local_time.of(10, 0, 0, 5);
        let b = local_time.of_nano_of_day(36000000000005);
        test.assert(a.equals(b) && a != b && a.hash_code() == b.hash_code() && !a.equals(nil));
        test.assert(a.hash_code() == hashing.combine(17, hashing.of_int64(36000000000005)));
        test.assert(a.compare_to(b) == ordering.Ordering.Equal);
        test.assert(a.compare_to(local_time.of(10, 0, 0, 6)) == ordering.Ordering.Less);
        test.assert(a.compare_to(local_time.Midnight) == ordering.Ordering.Greater);
    };
);
