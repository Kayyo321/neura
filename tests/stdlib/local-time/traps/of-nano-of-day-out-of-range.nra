// status: 70
// stderr: explicit program failure \(trap reason 3\): invalid argument: invalid time
let console = import:Std.Io.Console;
let local_time = import:Std.Time.LocalTime;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        console.print_line(local_time.of_nano_of_day(86400000000000).to_string());
        return program.ExitCode.Ok;
    };
);
