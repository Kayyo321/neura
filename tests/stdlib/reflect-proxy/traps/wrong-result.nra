// status: 134
// stderr: reflection: the value is not a string
// A handler's result of another type traps when the proxy unpacks it (docs/design/Reflect030.md, Proxies).
let console = import:Std.Io.Console;
let program = import:Std.Program;
let proxies = import:Std.Reflect.Proxy.DynamicProxy;
let variants = import:Std.Reflect.Dynamic.Variant;

let Named = interface (
    export let name = func -> string;
);

let Wrong = class implements proxies.InvocationHandler (
    export let invoke = func(context: proxies.MethodCallContext) -> variants.Variant => variants.of(5 as int32);
);

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line("before");
        console.print_line(proxies.create<Named>(new Wrong()).name());
        return program.ExitCode.Ok;
    };
);
