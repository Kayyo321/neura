// status: 70
// stderr: source arithmetic failure \(trap reason 1\) in function [0-9]+ block [0-9]+ at std/core/u-int8[.]nra
let console = import:Std.Io.Console;
let uint8s = import:Std.Core.UInt8;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        console.print_line(uint8s.floor_mod(7, 3).to_string());
        console.print_line(uint8s.floor_mod(7, 0).to_string());
        console.print_line("unreachable");
        return program.ExitCode.Ok;
    };
);
