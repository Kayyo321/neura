// status: 70
// stderr: source arithmetic failure \(trap reason 1\) in function [0-9]+ block [0-9]+ at std/core/int32[.]nra
let console = import:Std.Io.Console;
let int32s = import:Std.Core.Int32;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line(int32s.floor_div(-7, 2).to_string());
        console.print_line(int32s.floor_div(7, 0).to_string());
        console.print_line("unreachable");
        return program.ExitCode.Ok;
    };
);
