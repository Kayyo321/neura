// The Neura implementation of Std.Core.UInt16.to_string_radix and parse_radix before they became bindings of
// the neura.integer kernels, kept unchanged (but for the module's name and the members that did not
// change) as the oracle of kernel-oracle.nra. It lives with the tests, not in the standard library: only
// library source may import an Internal module, and code here never reaches a user's image.
let integer_text = import:ReferenceIntegerText;
let.promote _ = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Result;

/// @brief The replaced members of Std.Core.UInt16.
export let ReferenceUInt16 = module (
    /// @brief The smallest value representable by this integer type.
    export const Min: uint16 = 0;

    /// @brief The largest value representable by this integer type.
    export const Max: uint16 = 65535;

    /// @brief Lowercase digits. A radix outside 2 through 36 traps.
    export let to_string_radix = func(v: uint16, radix: int) -> string {
        integer_text.check_radix(radix);
        if (radix == 10) {
            return v.to_string();
        }
        let base = radix as uint16;
        let rest = v;
        let digits: uint8[list] = [];
        do {
            digits.append(integer_text.digit_byte((rest % base) as int));
            rest /= base;
            if (rest == 0) {
                break;
            }
        }
        return integer_text.digits_text(digits, false);
    };

    /// @brief An optional `+` or `-`, then one or more digits of the radix in either case.
    ///
    /// Syntax errors are reported first (Empty, UnexpectedEnd at the end, InvalidCharacter at the offending
    /// byte); a well-formed value outside the type fails with OutOfRange at offset 0. A `-` is accepted only
    /// for zero. A radix outside 2 through 36 traps.
    export let parse_radix = func(text: string, radix: int) -> Result<uint16> {
        integer_text.check_radix(radix);
        match (integer_text.syntax_error(text, radix)) {
            Optional.Some(failure) => {
                return Result<uint16>.Err(failure);
            },
            Optional.None => {},
        }
        let start = integer_text.sign_length(text);
        let negative = start == 1 && text.byte_at(0) == 45;
        let base = radix as uint16;
        let value: uint16 = 0;
        let length = text.byte_length;
        for (let i = start; i < length; i++) {
            let digit = integer_text.digit_value(text.byte_at(i)) as uint16;
            if (value > (Max - digit) / base) {
                return Result<uint16>.Err(integer_text.out_of_range("uint16"));
            }
            value = value * base + digit;
        }
        if (negative && value != 0) {
            return Result<uint16>.Err(integer_text.out_of_range("uint16"));
        }
        return Result<uint16>.Ok(value);
    };
);
