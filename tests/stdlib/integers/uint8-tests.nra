    ];
    let clamp_values: uint8[] = [
        0, 0, 1, 0, 0, 255, 1, 0, 1, 0, 1, 255,
        2, 0, 2, 0, 2, 255, 255, 0, 2, 0, 255, 255,
        254, 0, 2, 0, 254, 255, 16, 0, 2, 0, 16, 255,
