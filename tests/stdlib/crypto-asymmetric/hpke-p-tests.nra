// test-options: --gpu=off --max-steps 200000000000
let hex = import:Std.Encoding.Hex;
let hpke = import:Std.Crypto.Asymmetric.Hpke;
let test = import:Std.Test;
let vectors = import:HpkeVectors;

// HPKE (RFC 9180) for DHKEM(P-256), DHKEM(P-384) and DHKEM(P-521) against the official test vectors and, for P-384 and HKDF-SHA384, an
// independent reference checked against them (support/hpke-vectors.nra, scripts/crypto-vectors/gen-asymmetric-hpke.py).
let HpkePTests = module (
    let decode = func(text: string) -> uint8[list] => test.assert_ok(hex.decode(text));

    let kem_of = func(id: string) -> hpke.Kem {
        if (id == "16") {
            return hpke.Kem.DhKemP256HkdfSha256;
        }
        if (id == "17") {
            return hpke.Kem.DhKemP384HkdfSha384;
        }
        if (id == "18") {
            return hpke.Kem.DhKemP521HkdfSha512;
        }
        if (id == "32") {
            return hpke.Kem.DhKemX25519HkdfSha256;
        }
        return hpke.Kem.DhKemX448HkdfSha512;
    };

    let kdf_of = func(id: string) -> hpke.Kdf {
        if (id == "1") {
            return hpke.Kdf.HkdfSha256;
        }
        if (id == "2") {
            return hpke.Kdf.HkdfSha384;
        }
        return hpke.Kdf.HkdfSha512;
    };

    let aead_of = func(id: string) -> hpke.Aead {
        if (id == "1") {
            return hpke.Aead.Aes128Gcm;
        }
        if (id == "2") {
            return hpke.Aead.Aes256Gcm;
        }
        if (id == "3") {
            return hpke.Aead.ChaCha20Poly1305;
        }
        return hpke.Aead.ExportOnly;
    };

    let mode_of = func(id: string) -> hpke.Mode {
        if (id == "0") {
            return hpke.Mode.Base;
        }
        if (id == "1") {
            return hpke.Mode.Psk;
        }
        if (id == "2") {
            return hpke.Mode.Auth;
        }
        return hpke.Mode.AuthPsk;
    };

    /// @brief Runs every row whose KEM id is in `kems`; checks sequence 256 on the first row of each AEAD.
    let run = func(kems: string[list]) -> int {
        last rows = vectors.vectors;
        last width = 32;
        let count = 0;
        let long_runs: string[list] = new;
        for (let i = 0; i < rows.length; i += width) {
            let wanted = false;
            for (let k in kems) {
                if (rows[i + 2] == k) {
                    wanted = true;
                }
            }
            if (!wanted) {
                continue;
            }
            last label = rows[i] + " mode " + rows[i + 1] + " kem " + rows[i + 2] + " kdf " + rows[i + 3] + " aead " + rows[i + 4];
            last kem = kem_of(rows[i + 2]);
            last mode = mode_of(rows[i + 1]);
            last aead = aead_of(rows[i + 4]);
            last info = decode(rows[i + 5]);
            last psk = decode(rows[i + 15]);
            last psk_id = decode(rows[i + 16]);
            last recipient = hpke.derive_key_pair(kem, decode(rows[i + 7]));
            last ephemeral = hpke.derive_key_pair(kem, decode(rows[i + 6]));
            test.assert_equal_string(rows[i + 9], hex.encode(recipient.expose()));
            test.assert_equal_string(rows[i + 12], hex.encode(recipient.public_key_bytes()));
            test.assert_equal_string(rows[i + 11], hex.encode(ephemeral.expose()));
            let senders: hpke.HpkePrivateKey[list] = new;
            let sender_publics: hpke.HpkePublicKey[list] = new;
            if (rows[i + 8] != "") {
                last sender = hpke.derive_key_pair(kem, decode(rows[i + 8]));
                test.assert_equal_string(rows[i + 10], hex.encode(sender.expose()));
                test.assert_equal_string(rows[i + 13], hex.encode(sender.public_key_bytes()));
                senders.append(sender);
                sender_publics.append(sender.public_key());
            }
            last suite = new hpke.Suite(kem, kdf_of(rows[i + 3]), aead);
            // The KEM alone: Encap / AuthEncap and the shared secret.
            last dhkem = suite.key_encapsulation();
            last encapsulation = senders.length == 1
                ? test.assert_ok(dhkem.auth_encapsulate_with(recipient.public_key(), senders[0], ephemeral))
                : test.assert_ok(dhkem.encapsulate_with(recipient.public_key(), ephemeral));
            test.assert_equal_string(rows[i + 18], hex.encode(encapsulation.shared_secret.expose()));
            test.assert_equal_string(rows[i + 17], hex.encode(encapsulation.ciphertext));
            last decapsulated = senders.length == 1
                ? test.assert_ok(dhkem.auth_decapsulate(recipient, encapsulation.ciphertext, sender_publics[0]))
                : test.assert_ok(dhkem.decapsulate(recipient, encapsulation.ciphertext));
            test.assert(decapsulated.ct_equals(encapsulation.shared_secret));
            // The contexts.
            last sender_context = test.assert_ok(suite.setup_sender_with(mode, recipient.public_key(), info, psk, psk_id,
                senders, ephemeral));
            test.assert_equal_string(rows[i + 17], hex.encode(sender_context.enc));
            last receiver = test.assert_ok(suite.setup_receiver(mode, sender_context.enc, recipient, info, psk, psk_id,
                sender_publics));
            if (aead != hpke.Aead.ExportOnly) {
                last pt = decode(rows[i + 19]);
                last ct0 = sender_context.seal(decode(rows[i + 20]), pt);
                test.assert_equal_string(rows[i + 21], hex.encode(ct0));
                last ct1 = sender_context.seal(decode(rows[i + 22]), pt);
                test.assert_equal_string(rows[i + 23], hex.encode(ct1));
                test.assert_equal_string(rows[i + 19], hex.encode(test.assert_ok(receiver.open(decode(rows[i + 20]), ct0))));
                // A failed open leaves the sequence number where it was.
                test.assert_err(receiver.open(decode(rows[i + 20]), ct1));
                test.assert_equal_string(rows[i + 19], hex.encode(test.assert_ok(receiver.open(decode(rows[i + 22]), ct1))));
                let first_of_aead = true;
                for (let seen in long_runs) {
                    if (seen == rows[i + 4]) {
                        first_of_aead = false;
                    }
                }
                if (first_of_aead) {
                    long_runs.append(rows[i + 4]);
                    for (let seq = 2; seq < 256; seq++) {
                        let _ = sender_context.seal(new, pt);
                    }
                    test.assert_equal_string(rows[i + 25], hex.encode(sender_context.seal(decode(rows[i + 24]), pt)));
                }
            }
            for (let e = 0; e < 3; e++) {
                last context = decode(rows[i + 26 + 2 * e]);
                test.assert_equal_string(rows[i + 27 + 2 * e], hex.encode(sender_context.export_secret(context, 32)));
                test.assert_equal_string(rows[i + 27 + 2 * e], hex.encode(receiver.export_secret(context, 32)));
            }
            count++;
        }
        return count;
    };

    export let test_p256_vectors = func {
        test.assert_equal_int32(32 + 4, run(new(["16"])));
    };

    export let test_p384_vectors = func {
        test.assert_equal_int32(24, run(new(["17"])));
    };

    export let test_p521_vectors = func {
        test.assert_equal_int32(32 + 4, run(new(["18"])));
    };
);
