// status: 134
// stderr: explicit program failure \(trap reason 3\): denied: Rsa1024 is not allowed under the Modern policy
let program = import:Std.Program;
let rsa = import:Std.Crypto.Asymmetric.Rsa;

let App = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        // An odd 1024-bit modulus, 2^1023 + 1: the size check runs before any use of the number.
        let n: uint8[list] = new([128]);
        for (let i = 0; i < 126; i++) {
            n.append(0);
        }
        n.append(1);
        let _ = new rsa.RsaPublicKey(n, new([1, 0, 1]));
        return program.ExitCode.Ok;
    };
);
