// test-options: --gpu=off
// status: 134
// run-options: --gpu=off --deny-entropy --max-steps 15000000000
// stderr: explicit program failure \(trap reason 3\): invalid state: secret wiped
let program = import:Std.Program;
let pss = import:Std.Crypto.Asymmetric.RsaPss;
let fixture = import:RsaWipeKey;

let App = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        last key = fixture.key();
        last signer = new pss.RsaPssSigner(key);
        key.wipe();
        let _ = signer.try_sign(new);
        return program.ExitCode.Ok;
    };
);
