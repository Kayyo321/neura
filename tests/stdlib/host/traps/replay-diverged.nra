// status: 1
// stderr: ^neura: error: replay of .*replay-diverged\.trace diverged: request 1 \(neura\.console\.write_line version 1\) differs in argument 0: the run passed "second" where the trace recorded "changed"
// run-options: --replay @AREA_DIR@/traps/replay-diverged.trace
let console = import:Std.Io.Console;
let program = import:Std.Program;

// The trace's second request has a different argument: replay stops with a
// diagnostic after reproducing the output before it.
export let ReplayDiverged = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line("first");
        console.print_line("second");
        return program.ExitCode.Ok;
    };
);
