// status: 134
// stderr: explicit program failure \(trap reason 3\): denied: Sha256 is not allowed under the Cnsa2_0 policy
let crypto_policy = import:Std.Crypto.Core.CryptoPolicy;
let hmac = import:Std.Crypto.Mac.Hmac;
let program = import:Std.Program;
let sha2 = import:Std.Crypto.Hash.Sha2;

let App = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        crypto_policy.set_policy(crypto_policy.Policy.Cnsa2_0);
        let _ = hmac.mac<sha2.Sha384>(new([1]), new([2]));
        let _ = hmac.mac<sha2.Sha256>(new([1]), new([2]));
        return program.ExitCode.Ok;
    };
);
