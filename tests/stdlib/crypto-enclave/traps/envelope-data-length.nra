// test-options: --gpu=off
// status: 134
// run-options: --gpu=off --deny-entropy --max-heap-cells 3000000 --max-steps 50000000
// stderr: explicit program failure \(trap reason 3\): invalid argument: envelope plaintext and associated data are limited to 1 MiB each
let.promote _ = import:Std.Crypto.Algorithm;
let envelope = import:Std.Crypto.Enclave.Envelope;
let memory = import:Std.Crypto.Enclave.MemoryKeyStore;
let program = import:Std.Program;

let App = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        last store = new memory.MemoryKeyStore();
        last crypt = new envelope.Envelope<memory.MemoryKeyHandle>(store, "test", 1, 2);
        let oversized: uint8[list] = new;
        for (let i = 0; i <= 1048576; i++) {
            oversized.append(0);
        }
        let _ = crypt.seal(new, oversized);
        return program.ExitCode.Ok;
    };
);
