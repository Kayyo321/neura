// status: 134
// run-options: --gpu=off --deny-entropy
// stderr: explicit program failure \(trap reason 3\): invalid argument: invalid envelope label, key version or DEK use limit
let.promote _ = import:Std.Crypto.Algorithm;
let envelope = import:Std.Crypto.Enclave.Envelope;
let memory = import:Std.Crypto.Enclave.MemoryKeyStore;
let program = import:Std.Program;

let App = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        last store = new memory.MemoryKeyStore();
        let _ = new envelope.Envelope<memory.MemoryKeyHandle>(store, "test", 1, 0);
        return program.ExitCode.Ok;
    };
);
