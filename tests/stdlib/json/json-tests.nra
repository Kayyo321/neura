let big_decimals = import:Std.Math.BigDecimal;
let error = import:Std.Core.Error;
let json = import:Std.Encoding.Json;
let optional = import:Std.Core.Optional;
let result = import:Std.Core.Result;
let strings = import:Std.Text.Strings;
let test = import:Std.Test;

// JSON (RFC 8259) as Stdlib.md section 13.1 specifies it. The y_ and n_
// tests follow JSONTestSuite's categories (must accept, must reject) with
// the expected text and error offsets written out here. The round-trip
// vectors are random documents that python3's json.dumps wrote (seeded);
// the expected compact and pretty text is json.dumps with
// separators=(",", ":") and with indent=2, both with ensure_ascii=False.
let JsonTests = module (
    let parsed = func(text: string) -> json.JsonValue {
        return test.assert_ok<json.JsonValue>(json.parse(text));
    };

    let accept = func(text: string, expected: string) -> void {
        test.assert_equal_string(expected, json.write(parsed(text)));
    };

    let reject = func(text: string, kind: error.ParseErrorKind, offset: int, message: string) -> void {
        match (test.assert_err<json.JsonValue>(json.parse(text))) {
            error.Error.Parse { kind: actual, offset: at, message: reason } => {
                test.assert_equal_string(message, reason);
                test.assert_equal_int32(offset, at);
                test.assert_equal_string(kind.to_string(), actual.to_string());
            },
            _ => {
                test.fail("expected a Parse error");
            },
        }
    };

    let check_round_trip = func(source: string, compact: string, pretty: string) -> void {
        let value = parsed(source);
        test.assert_equal_string(compact, json.write(value));
        test.assert_equal_string(pretty, json.write_pretty(value, 2));
        let again = parsed(compact);
        test.assert(json.equals(value, again));
        test.assert_equal_uint64(json.hash(value) as uint64, json.hash(again) as uint64);
        test.assert_equal_string(compact, json.write(parsed(pretty)));
    };

    let number = func(text: string) -> json.JsonValue {
        return json.JsonValue.Number(text);
    };

    let same = func(a: json.JsonValue, b: json.JsonValue) -> void {
        test.assert(json.equals(a, b));
        test.assert(json.equals(b, a));
        test.assert_equal_uint64(json.hash(a) as uint64, json.hash(b) as uint64);
    };

    let different = func(a: json.JsonValue, b: json.JsonValue) -> void {
        test.assert(!json.equals(a, b));
        test.assert(!json.equals(b, a));
    };

    let nested = func(open: string, close: string, depth: int) -> string {
        return strings.repeat(open, depth) + strings.repeat(close, depth);
    };

    export let test_y_structures = func() -> void {
        accept("[]", "[]");
        accept("{}", "{}");
        accept(" [ ] ", "[]");
        accept("\t\n\r [ 1 , 2 ] \n", "[1,2]");
        accept("[[[[[]]]]]", "[[[[[]]]]]");
        accept("[null,true,false]", "[null,true,false]");
        accept("{\"a\" : 1 , \"b\" :2}", "{\"a\":1,\"b\":2}");
        accept("{\"\":0}", "{\"\":0}");
        accept("{\"a\":{\"b\":{\"c\":[1,{\"d\":null}]}}}", "{\"a\":{\"b\":{\"c\":[1,{\"d\":null}]}}}");
        accept("[{}, [], {\"x\": []}]", "[{},[],{\"x\":[]}]");
    };

    // RFC 8259 allows any value at the top.
    export let test_y_scalars = func() -> void {
        accept("true", "true");
        accept("false", "false");
        accept("null", "null");
        accept(" \"str\" ", "\"str\"");
        accept("42", "42");
        accept("-0.5", "-0.5");
    };

    // Numbers keep their text.
    export let test_y_numbers = func() -> void {
        accept("[1]", "[1]");
        accept("[-0]", "[-0]");
        accept("[-1]", "[-1]");
        accept("[1.5]", "[1.5]");
        accept("[1E22]", "[1E22]");
        accept("[1e+2,1e-2,1E-2,1E+2]", "[1e+2,1e-2,1E-2,1E+2]");
        accept("[0e1,-0.0e-0,0.000]", "[0e1,-0.0e-0,0.000]");
        accept("[123e65,20e1,123.456e78]", "[123e65,20e1,123.456e78]");
        accept("[-9223372036854775809]", "[-9223372036854775809]");
        accept("[100000000000000000000000000000000000000000]", "[100000000000000000000000000000000000000000]");
        accept("[1e999999999999999999999]", "[1e999999999999999999999]");
    };

    export let test_y_strings = func() -> void {
        accept("[\"\"]", "[\"\"]");
        accept("[\" \"]", "[\" \"]");
        accept("[\"\\u0060\\u012a\\u12AB\"]", "[\"`Īካ\"]");
        accept("[\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"]", "[\"\\\"\\\\/\\b\\f\\n\\r\\t\"]");
        accept("[\"\\ud834\\udd1e\"]", "[\"𝄞\"]");
        accept("[\"\\uD83D\\uDE00x\"]", "[\"😀x\"]");
        accept("[\"\\u0000\"]", "[\"\\u0000\"]");
        accept("[\"\\u001f\\u001B\\u0010\"]", "[\"\\u001f\\u001b\\u0010\"]");
        accept("[\"é日本🙂\"]", "[\"é日本🙂\"]");
        accept("[\"\\u00e9\"]", "[\"é\"]");
        accept("[\"\\uFFFF\\uffFE\"]", "[\"" + strings.from_scalars([65535, 65534]) + "\"]");
        accept("[\"a/b\"]", "[\"a/b\"]");
        accept("[\"\\u2028\\u2029\"]", "[\"" + strings.from_scalars([8232, 8233]) + "\"]");
    };

    // A repeated name keeps its first position and takes the last value.
    export let test_y_duplicate_names = func() -> void {
        accept("{\"a\":\"b\",\"a\":\"c\"}", "{\"a\":\"c\"}");
        accept("{\"a\":1,\"b\":2,\"a\":3}", "{\"a\":3,\"b\":2}");
        accept("{\"a\":1,\"b\":2,\"a\":3,\"b\":[],\"c\":0,\"a\":null}", "{\"a\":null,\"b\":[],\"c\":0}");
        // Past 16 members the parser indexes the names.
        let source = "{";
        let expected = "{";
        for (let i = 0; i < 40; i = i + 1) {
            if (i > 0) {
                source = source + ",";
            }
            source = source + "\"k" + (i % 25).to_string() + "\":" + i.to_string();
            if (i < 25) {
                if (i > 0) {
                    expected = expected + ",";
                }
                let last = i;
                if (i + 25 < 40) {
                    last = i + 25;
                }
                expected = expected + "\"k" + i.to_string() + "\":" + last.to_string();
            }
        }
        accept(source + "}", expected + "}");
    };

    export let test_y_depth_limit = func() -> void {
        let deepest = nested("[", "]", 512);
        test.assert_equal_string(deepest, json.write(parsed(deepest)));
        let objects = strings.repeat("{\"a\":", 511) + "[]" + strings.repeat("}", 511);
        test.assert_equal_string(objects, json.write(parsed(objects)));
    };

    export let test_n_empty_and_end = func() -> void {
        reject("", error.ParseErrorKind.Empty, 0, "no value");
        reject("   ", error.ParseErrorKind.Empty, 3, "no value");
        reject("\n", error.ParseErrorKind.Empty, 1, "no value");
        reject("[", error.ParseErrorKind.UnexpectedEnd, 1, "unexpected end of input");
        reject("[1", error.ParseErrorKind.UnexpectedEnd, 2, "unexpected end of input");
        reject("[1,", error.ParseErrorKind.UnexpectedEnd, 3, "unexpected end of input");
        reject("[1, ", error.ParseErrorKind.UnexpectedEnd, 4, "unexpected end of input");
        reject("{", error.ParseErrorKind.UnexpectedEnd, 1, "unexpected end of input");
        reject("{\"a\"", error.ParseErrorKind.UnexpectedEnd, 4, "unexpected end of input");
        reject("{\"a\":", error.ParseErrorKind.UnexpectedEnd, 5, "unexpected end of input");
        reject("{\"a\":1", error.ParseErrorKind.UnexpectedEnd, 6, "unexpected end of input");
        reject("{\"a\":1,", error.ParseErrorKind.UnexpectedEnd, 7, "unexpected end of input");
        reject("tru", error.ParseErrorKind.UnexpectedEnd, 3, "unexpected end of input");
        reject("nul", error.ParseErrorKind.UnexpectedEnd, 3, "unexpected end of input");
        reject("\"abc", error.ParseErrorKind.UnexpectedEnd, 4, "unexpected end of input");
        reject("\"a\\", error.ParseErrorKind.UnexpectedEnd, 3, "unexpected end of input");
        reject("\"a\\nb", error.ParseErrorKind.UnexpectedEnd, 5, "unexpected end of input");
    };

    export let test_n_structure = func() -> void {
        reject("[1,]", error.ParseErrorKind.Syntax, 3, "expected a value");
        reject("[,1]", error.ParseErrorKind.Syntax, 1, "expected a value");
        reject("[\"a\",]", error.ParseErrorKind.Syntax, 5, "expected a value");
        reject("[1 2]", error.ParseErrorKind.Syntax, 3, "expected ',' or ']'");
        reject("[1;2]", error.ParseErrorKind.Syntax, 2, "expected ',' or ']'");
        reject("[1}", error.ParseErrorKind.Syntax, 2, "expected ',' or ']'");
        reject("]", error.ParseErrorKind.Syntax, 0, "expected a value");
        reject("[1]]", error.ParseErrorKind.Syntax, 3, "unexpected text after value");
        reject("[1] x", error.ParseErrorKind.Syntax, 4, "unexpected text after value");
        reject("{\"a\":1}}", error.ParseErrorKind.Syntax, 7, "unexpected text after value");
        reject("truefalse", error.ParseErrorKind.Syntax, 4, "unexpected text after value");
        reject("[] []", error.ParseErrorKind.Syntax, 3, "unexpected text after value");
        reject("{\"a\":1,}", error.ParseErrorKind.Syntax, 7, "expected a member name");
        reject("{,}", error.ParseErrorKind.Syntax, 1, "expected a member name");
        reject("{a:1}", error.ParseErrorKind.Syntax, 1, "expected a member name");
        reject("{'a':1}", error.ParseErrorKind.Syntax, 1, "expected a member name");
        reject("{1:1}", error.ParseErrorKind.Syntax, 1, "expected a member name");
        reject("{\"a\" 1}", error.ParseErrorKind.Syntax, 5, "expected ':'");
        reject("{\"a\"=1}", error.ParseErrorKind.Syntax, 4, "expected ':'");
        reject("{\"a\":1 \"b\":2}", error.ParseErrorKind.Syntax, 7, "expected ',' or '}'");
        reject("{\"a\":1]", error.ParseErrorKind.Syntax, 6, "expected ',' or '}'");
        reject("{\"a\":}", error.ParseErrorKind.Syntax, 5, "expected a value");
        reject("True", error.ParseErrorKind.Syntax, 0, "expected a value");
        reject("+1", error.ParseErrorKind.Syntax, 0, "expected a value");
        reject(".5", error.ParseErrorKind.Syntax, 0, "expected a value");
        reject("[NaN]", error.ParseErrorKind.Syntax, 1, "expected a value");
        reject("[Infinity]", error.ParseErrorKind.Syntax, 1, "expected a value");
        reject("'a'", error.ParseErrorKind.Syntax, 0, "expected a value");
    };

    // No comments and only the four JSON whitespace characters.
    export let test_n_comments_and_whitespace = func() -> void {
        reject("[1] /* c */", error.ParseErrorKind.Syntax, 4, "unexpected text after value");
        reject("// c\n[1]", error.ParseErrorKind.Syntax, 0, "expected a value");
        reject("[1, # c\n2]", error.ParseErrorKind.Syntax, 4, "expected a value");
        reject(strings.from_scalars([12]) + "[]", error.ParseErrorKind.Syntax, 0, "expected a value");
        reject("[" + strings.from_scalars([11]) + "]", error.ParseErrorKind.Syntax, 1, "expected a value");
        reject(strings.from_scalars([160]) + "[]", error.ParseErrorKind.Syntax, 0, "expected a value");
        reject(strings.from_scalars([65279]) + "[]", error.ParseErrorKind.Syntax, 0, "expected a value");
        reject("[]" + strings.from_scalars([0]), error.ParseErrorKind.Syntax, 2, "unexpected text after value");
    };

    export let test_n_literals = func() -> void {
        reject("trux", error.ParseErrorKind.InvalidCharacter, 3, "invalid literal");
        reject("nulL", error.ParseErrorKind.InvalidCharacter, 3, "invalid literal");
        reject("[fals]", error.ParseErrorKind.InvalidCharacter, 5, "invalid literal");
        reject("[nil]", error.ParseErrorKind.InvalidCharacter, 2, "invalid literal");
    };

    export let test_n_numbers = func() -> void {
        reject("01", error.ParseErrorKind.InvalidCharacter, 1, "leading zero");
        reject("-01", error.ParseErrorKind.InvalidCharacter, 2, "leading zero");
        reject("[00]", error.ParseErrorKind.InvalidCharacter, 2, "leading zero");
        reject("-", error.ParseErrorKind.UnexpectedEnd, 1, "unexpected end of input");
        reject("[-]", error.ParseErrorKind.InvalidCharacter, 2, "expected a digit");
        reject("[-a]", error.ParseErrorKind.InvalidCharacter, 2, "expected a digit");
        reject("[-Infinity]", error.ParseErrorKind.InvalidCharacter, 2, "expected a digit");
        reject("[- 1]", error.ParseErrorKind.InvalidCharacter, 2, "expected a digit");
        reject("[1.]", error.ParseErrorKind.InvalidCharacter, 3, "expected a digit");
        reject("1.", error.ParseErrorKind.UnexpectedEnd, 2, "unexpected end of input");
        reject("[1.e5]", error.ParseErrorKind.InvalidCharacter, 3, "expected a digit");
        reject("[1e]", error.ParseErrorKind.InvalidCharacter, 3, "expected a digit");
        reject("[1e+]", error.ParseErrorKind.InvalidCharacter, 4, "expected a digit");
        reject("[1E-x]", error.ParseErrorKind.InvalidCharacter, 4, "expected a digit");
        reject("1e", error.ParseErrorKind.UnexpectedEnd, 2, "unexpected end of input");
        reject("1E+", error.ParseErrorKind.UnexpectedEnd, 3, "unexpected end of input");
        reject("[0x1]", error.ParseErrorKind.Syntax, 2, "expected ',' or ']'");
        reject("[1_000]", error.ParseErrorKind.Syntax, 2, "expected ',' or ']'");
        reject("[1.5.5]", error.ParseErrorKind.Syntax, 4, "expected ',' or ']'");
        reject("[1e5e5]", error.ParseErrorKind.Syntax, 4, "expected ',' or ']'");
        reject("[0.1.]", error.ParseErrorKind.Syntax, 4, "expected ',' or ']'");
    };

    export let test_n_strings = func() -> void {
        reject("[\"\\x\"]", error.ParseErrorKind.InvalidCharacter, 2, "invalid escape");
        reject("[\"é\\x\"]", error.ParseErrorKind.InvalidCharacter, 4, "invalid escape");
        reject("[\"\\'\"]", error.ParseErrorKind.InvalidCharacter, 2, "invalid escape");
        reject("[\"\\U0041\"]", error.ParseErrorKind.InvalidCharacter, 2, "invalid escape");
        reject("[\"\\u12\"]", error.ParseErrorKind.InvalidCharacter, 2, "invalid \\u escape");
        reject("[\"\\u00G0\"]", error.ParseErrorKind.InvalidCharacter, 2, "invalid \\u escape");
        reject("\"\\u12", error.ParseErrorKind.UnexpectedEnd, 5, "unexpected end of input");
        reject("[\"\\uD800\"]", error.ParseErrorKind.InvalidCharacter, 2, "unpaired surrogate");
        reject("[\"\\uD800\\u0041\"]", error.ParseErrorKind.InvalidCharacter, 2, "unpaired surrogate");
        reject("[\"\\uDBFF\\uDBFF\"]", error.ParseErrorKind.InvalidCharacter, 2, "unpaired surrogate");
        reject("[\"\\uDC00\"]", error.ParseErrorKind.InvalidCharacter, 2, "unpaired surrogate");
        reject("[\"a\\uDFFF\\uD800\"]", error.ParseErrorKind.InvalidCharacter, 3, "unpaired surrogate");
        reject("[\"\\uD800x\"]", error.ParseErrorKind.InvalidCharacter, 2, "unpaired surrogate");
        reject("[\"\\uD800\\n\"]", error.ParseErrorKind.InvalidCharacter, 2, "unpaired surrogate");
        reject("[\"\\uD800\\u12\"]", error.ParseErrorKind.InvalidCharacter, 8, "invalid \\u escape");
        reject("\"\\uD800", error.ParseErrorKind.UnexpectedEnd, 7, "unexpected end of input");
        reject("\"\\uD800\\", error.ParseErrorKind.UnexpectedEnd, 8, "unexpected end of input");
        reject("\"\\uD800\\u", error.ParseErrorKind.UnexpectedEnd, 9, "unexpected end of input");
        reject("[\"a\tb\"]", error.ParseErrorKind.InvalidCharacter, 3, "control character in string");
        reject("[\"a\nb\"]", error.ParseErrorKind.InvalidCharacter, 3, "control character in string");
        reject("[\"\\n" + strings.from_scalars([1]) + "\"]", error.ParseErrorKind.InvalidCharacter, 4,
            "control character in string");
        reject("[\"" + strings.from_scalars([31]) + "\"]", error.ParseErrorKind.InvalidCharacter, 2,
            "control character in string");
    };

    export let test_n_depth_limit = func() -> void {
        reject(nested("[", "]", 513), error.ParseErrorKind.OutOfRange, 512, "nesting deeper than 512");
        let objects = strings.repeat("{\"a\":", 512) + "[]" + strings.repeat("}", 512);
        reject(objects, error.ParseErrorKind.OutOfRange, 2560, "nesting deeper than 512");
        reject(strings.repeat("[", 20000), error.ParseErrorKind.OutOfRange, 512, "nesting deeper than 512");
    };

    export let test_python_round_trips = func() -> void {
        check_round_trip("{\"\": -257284.4895369521, \"\\u65e5\": [], \"\\r\\\\\\f\\u001f\\u0001\": 408932980481011026781466859669, \"z/\\\\\\t\\\\~\": 0.1}",
            "{\"\":-257284.4895369521,\"日\":[],\"\\r\\\\\\f\\u001f\\u0001\":408932980481011026781466859669,\"z/\\\\\\t\\\\~\":0.1}",
            "{\n  \"\": -257284.4895369521,\n  \"日\": [],\n  \"\\r\\\\\\f\\u001f\\u0001\": 408932980481011026781466859669,\n  \"z/\\\\\\t\\\\~\": 0.1\n}");
        check_round_trip("{\n \"\\nb\\u0001\\t\\n\": [\n  [\n   {\n    \"{\": -8e-26\n   }\n  ]\n ],\n \"é\\u0001,日\": \"𝄞{\\\"]🙂,\"\n}",
            "{\"\\nb\\u0001\\t\\n\":[[{\"{\":-8e-26}]],\"é\\u0001,日\":\"𝄞{\\\"]🙂,\"}",
            "{\n  \"\\nb\\u0001\\t\\n\": [\n    [\n      {\n        \"{\": -8e-26\n      }\n    ]\n  ],\n  \"é\\u0001,日\": \"𝄞{\\\"]🙂,\"\n}");
        check_round_trip("[]",
            "[]",
            "[]");
        check_round_trip("[true]",
            "[true]",
            "[\n  true\n]");
        check_round_trip("{}",
            "{}",
            "{}");
        check_round_trip("{\n \"\\t🙂\": \"{\\u001f]/{\",\n \"\\\\\\bb\": 5e-324,\n \",,\\f\\r\": null\n}",
            "{\"\\t🙂\":\"{\\u001f]/{\",\"\\\\\\bb\":5e-324,\",,\\f\\r\":null}",
            "{\n  \"\\t🙂\": \"{\\u001f]/{\",\n  \"\\\\\\bb\": 5e-324,\n  \",,\\f\\r\": null\n}");
        check_round_trip("{\"\\f\": [], \"\\b/b\\\"\\n\": [-892099.076428452, [-129, 947], {\"\\ud83d\\ude42\\u0001\\ud834\\udd1e\\u00e9a{\": [\"\\\\\\u0001\\u001f\\ud834\\udd1e\\f\\b\", 2.7000000000000002e-14, \"\\ud83d\\ude42\", \"\\n]\\n\\n\\u65e5~\"], \"\\u65e5\\r ]\\u65e5\": \"\\u00e9{\\u65e5]\"}], \"/\\\"\\\\\": {\"a\\r\\f\\b\": [null, [true, 747, \"\\r\\u001fa\", 856464485342173415133841464838], 117952073923693972033660711194], \"\\u00e9\\ud83d\\ude42\\\"a{\": {}, \" \": true, \"\": [null]}}",
            "{\"\\f\":[],\"\\b/b\\\"\\n\":[-892099.076428452,[-129,947],{\"🙂\\u0001𝄞éa{\":[\"\\\\\\u0001\\u001f𝄞\\f\\b\",2.7000000000000002e-14,\"🙂\",\"\\n]\\n\\n日~\"],\"日\\r ]日\":\"é{日]\"}],\"/\\\"\\\\\":{\"a\\r\\f\\b\":[null,[true,747,\"\\r\\u001fa\",856464485342173415133841464838],117952073923693972033660711194],\"é🙂\\\"a{\":{},\" \":true,\"\":[null]}}",
            "{\n  \"\\f\": [],\n  \"\\b/b\\\"\\n\": [\n    -892099.076428452,\n    [\n      -129,\n      947\n    ],\n    {\n      \"🙂\\u0001𝄞éa{\": [\n        \"\\\\\\u0001\\u001f𝄞\\f\\b\",\n        2.7000000000000002e-14,\n        \"🙂\",\n        \"\\n]\\n\\n日~\"\n      ],\n      \"日\\r ]日\": \"é{日]\"\n    }\n  ],\n  \"/\\\"\\\\\": {\n    \"a\\r\\f\\b\": [\n      null,\n      [\n        true,\n        747,\n        \"\\r\\u001fa\",\n        856464485342173415133841464838\n      ],\n      117952073923693972033660711194\n    ],\n    \"é🙂\\\"a{\": {},\n    \" \": true,\n    \"\": [\n      null\n    ]\n  }\n}");
        check_round_trip("[\n   983877.7414001042,\n   \"é日/\",\n   null,\n   \"b\\\\\\t🙂\\f\"\n]",
            "[983877.7414001042,\"é日/\",null,\"b\\\\\\t🙂\\f\"]",
            "[\n  983877.7414001042,\n  \"é日/\",\n  null,\n  \"b\\\\\\t🙂\\f\"\n]");
        check_round_trip("[\n{},\n[\n[\n7374975594393464575,\n[\nnull,\n0.1,\n\"\\ud834\\udd1e]\\u001fa\",\nnull\n],\n1e-07,\n\"\\\"]\"\n],\n-107030.40166362724,\n745032161283229469935394792971\n],\nnull\n]",
            "[{},[[7374975594393464575,[null,0.1,\"𝄞]\\u001fa\",null],1e-07,\"\\\"]\"],-107030.40166362724,745032161283229469935394792971],null]",
            "[\n  {},\n  [\n    [\n      7374975594393464575,\n      [\n        null,\n        0.1,\n        \"𝄞]\\u001fa\",\n        null\n      ],\n      1e-07,\n      \"\\\"]\"\n    ],\n    -107030.40166362724,\n    745032161283229469935394792971\n  ],\n  null\n]");
        check_round_trip("[\"日\"]",
            "[\"日\"]",
            "[\n  \"日\"\n]");
        check_round_trip("[]",
            "[]",
            "[]");
        check_round_trip("[\n   \"b~b\\fb\\\"\",\n   [\n      \"\",\n      [\n         \"\\f]\",\n         -293\n      ],\n      true,\n      \"/\"\n   ],\n   \"{\\n,b\\f日\",\n   {\n      \"𝄞\": [],\n      \"\\u0001\\u0001\": 0.0\n   }\n]",
            "[\"b~b\\fb\\\"\",[\"\",[\"\\f]\",-293],true,\"/\"],\"{\\n,b\\f日\",{\"𝄞\":[],\"\\u0001\\u0001\":0.0}]",
            "[\n  \"b~b\\fb\\\"\",\n  [\n    \"\",\n    [\n      \"\\f]\",\n      -293\n    ],\n    true,\n    \"/\"\n  ],\n  \"{\\n,b\\f日\",\n  {\n    \"𝄞\": [],\n    \"\\u0001\\u0001\": 0.0\n  }\n]");
        check_round_trip("{\"\\\"\\ud834\\udd1e\\b~\\u65e5\": \"\\b\\u00e9\\ud83d\\ude42\", \"\\\\]\\u0001\\ud834\\udd1e~\\\"\": null, \"\\ud834\\udd1e\": {\"\\u65e5\\t \\\\\": {\"z\\u0001\\\" \": [\"\\ta]\\r/\\u001f\", true, \"\\b\"], \"z \": {\"\\\"/\": 689124450080015819042605328492, \"\\u001f\": \"\\u65e5\\u0001{\\\"\\f\"}}}, \"\\b\": null}",
            "{\"\\\"𝄞\\b~日\":\"\\bé🙂\",\"\\\\]\\u0001𝄞~\\\"\":null,\"𝄞\":{\"日\\t \\\\\":{\"z\\u0001\\\" \":[\"\\ta]\\r/\\u001f\",true,\"\\b\"],\"z \":{\"\\\"/\":689124450080015819042605328492,\"\\u001f\":\"日\\u0001{\\\"\\f\"}}},\"\\b\":null}",
            "{\n  \"\\\"𝄞\\b~日\": \"\\bé🙂\",\n  \"\\\\]\\u0001𝄞~\\\"\": null,\n  \"𝄞\": {\n    \"日\\t \\\\\": {\n      \"z\\u0001\\\" \": [\n        \"\\ta]\\r/\\u001f\",\n        true,\n        \"\\b\"\n      ],\n      \"z \": {\n        \"\\\"/\": 689124450080015819042605328492,\n        \"\\u001f\": \"日\\u0001{\\\"\\f\"\n      }\n    }\n  },\n  \"\\b\": null\n}");
        check_round_trip("[\n [\n  null,\n  false,\n  [\n   [],\n   {\n    \"𝄞日{\": -1928134835797295524,\n    \"\\t/\": \"𝄞\",\n    \"{ \\n\\r\": \"~,]\",\n    \"𝄞a/\": null\n   }\n  ]\n ],\n {\n  \"é\": [\n   false,\n   -85,\n   -0.0\n  ]\n }\n]",
            "[[null,false,[[],{\"𝄞日{\":-1928134835797295524,\"\\t/\":\"𝄞\",\"{ \\n\\r\":\"~,]\",\"𝄞a/\":null}]],{\"é\":[false,-85,-0.0]}]",
