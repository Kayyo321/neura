    export let test_write_escapes = func() -> void {
        let controls: uint32[list] = [];
        for (let c: uint32 = 0; c < 32; c = c + 1) {
            controls.append(c);
        }
        controls.append(34);
        controls.append(92);
        controls.append(47);
        controls.append(127);
        let text = json.write(json.JsonValue.Text(strings.from_scalars(controls)));
        test.assert_equal_string("\"\\u0000\\u0001\\u0002\\u0003\\u0004\\u0005\\u0006\\u0007\\b\\t\\n\\u000b\\f\\r"
            + "\\u000e\\u000f\\u0010\\u0011\\u0012\\u0013\\u0014\\u0015\\u0016\\u0017\\u0018\\u0019\\u001a\\u001b"
            + "\\u001c\\u001d\\u001e\\u001f\\\"\\\\/" + strings.from_scalars([127]) + "\"", text);
        test.assert_equal_string(strings.from_scalars(controls), match (parsed(text)) {
            json.JsonValue.Text(s) => s,
            _ => "not text",
        });
        // Member names are escaped the same way.
        let members: [string, json.JsonValue][list] = [["a\"b\n", json.JsonValue.Null]];
        test.assert_equal_string("{\"a\\\"b\\n\":null}", json.write(json.JsonValue.Object(members)));
    };

    export let test_write_pretty = func() -> void {
        let value = parsed("{\"a\":[1,{\"b\":null,\"c\":[]},{}],\"d\":\"x\"}");
        test.assert_equal_string("{\n  \"a\": [\n    1,\n    {\n      \"b\": null,\n      \"c\": []\n    },\n    {}\n  ],\n  \"d\": \"x\"\n}",
            json.write_pretty(value, 2));
        test.assert_equal_string("{\n\"a\": [\n1,\n{\n\"b\": null,\n\"c\": []\n},\n{}\n],\n\"d\": \"x\"\n}",
            json.write_pretty(value, 0));
        test.assert_equal_string("[\n    true\n]", json.write_pretty(parsed("[true]"), 4));
        test.assert_equal_string("[]", json.write_pretty(parsed("[]"), 4));
        test.assert_equal_string("\"s\"", json.write_pretty(parsed("\"s\""), 4));
        // Every member is written, including repeated names.
        let members: [string, json.JsonValue][list] = [["k", json.number_of_int64(1)], ["k", json.number_of_int64(2)]];
        test.assert_equal_string("{\"k\":1,\"k\":2}", json.write(json.JsonValue.Object(members)));
        test.assert_equal_string("{\n \"k\": 1,\n \"k\": 2\n}", json.write_pretty(json.JsonValue.Object(members), 1));
    };

    export let test_number_constructors = func() -> void {
        test.assert_equal_string("0", json.write(json.number_of_int64(0)));
        test.assert_equal_string("-9223372036854775808", json.write(json.number_of_int64(-9223372036854775807 - 1)));
        test.assert_equal_string("9223372036854775807", json.write(json.number_of_int64(9223372036854775807)));
        test.assert_equal_string("1.5", json.write(json.number_of_float64(1.5)));
        test.assert_equal_string("-0.0", json.write(json.number_of_float64(-0.0)));
        test.assert_equal_string("1.0e22", json.write(json.number_of_float64(1e22)));
        test.assert_equal_string("5.0e-324", json.write(json.number_of_float64(5e-324)));
        test.assert_equal_string("1.7976931348623157e308", json.write(json.number_of_float64(1.7976931348623157e308)));
        test.assert_equal_string("0.1", json.write(json.number_of_float64(0.1)));
        // The float text is valid JSON number text.
        test.assert_equal_string("[1.0e22]", json.write(parsed("[1.0e22]")));
    };

    export let test_member = func() -> void {
        let members: [string, json.JsonValue][list] = [
            ["a", json.number_of_int64(1)], ["b", json.JsonValue.Null], ["a", json.number_of_int64(2)]
        ];
        test.assert(json.equals(json.number_of_int64(1), test.assert_some<json.JsonValue>(json.member(members, "a"))));
        test.assert(json.equals(json.JsonValue.Null, test.assert_some<json.JsonValue>(json.member(members, "b"))));
        test.assert_none<json.JsonValue>(json.member(members, "c"));
        test.assert_none<json.JsonValue>(json.member(members, "A"));
        test.assert_none<json.JsonValue>(json.member([], "a"));
    };

    export let test_number_to_int64 = func() -> void {
        test.assert_equal_int64(0, test.assert_some<int64>(json.number_to_int64("0")));
        test.assert_equal_int64(0, test.assert_some<int64>(json.number_to_int64("-0")));
        test.assert_equal_int64(-42, test.assert_some<int64>(json.number_to_int64("-42")));
        test.assert_equal_int64(9223372036854775807, test.assert_some<int64>(json.number_to_int64("9223372036854775807")));
        test.assert_equal_int64(-9223372036854775807 - 1,
            test.assert_some<int64>(json.number_to_int64("-9223372036854775808")));
        test.assert_none<int64>(json.number_to_int64("9223372036854775808"));
        test.assert_none<int64>(json.number_to_int64("-9223372036854775809"));
        test.assert_none<int64>(json.number_to_int64("123456789012345678901234567890"));
        test.assert_none<int64>(json.number_to_int64("1.0"));
        test.assert_none<int64>(json.number_to_int64("1e2"));
        test.assert_none<int64>(json.number_to_int64("1E0"));
        test.assert_none<int64>(json.number_to_int64(""));
        test.assert_none<int64>(json.number_to_int64("-"));
        test.assert_none<int64>(json.number_to_int64("01"));
        test.assert_none<int64>(json.number_to_int64("+1"));
        test.assert_none<int64>(json.number_to_int64(" 1"));
        test.assert_none<int64>(json.number_to_int64("abc"));
    };

    export let test_number_to_float64 = func() -> void {
        test.assert_equal_float64(0.0, json.number_to_float64("0"));
        test.assert_equal_float64(-0.0, json.number_to_float64("-0"));
        test.assert_equal_float64(1.5, json.number_to_float64("1.5"));
        test.assert_equal_float64(100.0, json.number_to_float64("1E2"));
        test.assert_equal_float64(0.1, json.number_to_float64("0.1"));
        test.assert_equal_float64(0.1, json.number_to_float64("1e-1"));
        test.assert_equal_float64(1.2345678901234568e29, json.number_to_float64("123456789012345678901234567890"));
        test.assert_equal_float64(5e-324, json.number_to_float64("5e-324"));
        test.assert_equal_float64(2.2250738585072014e-308, json.number_to_float64("2.2250738585072014e-308"));
        test.assert_equal_float64(1.7976931348623157e308, json.number_to_float64("1.7976931348623157e308"));
        test.assert_equal_float64(9007199254740992.0, json.number_to_float64("9007199254740993"));
        // Too large becomes an infinity and too small a signed zero.
        test.assert_equal_float64(1.0 / 0.0, json.number_to_float64("1e309"));
        test.assert_equal_float64(-0.0, json.number_to_float64("-1e-400"));
    };

    let check_decimal = func(text: string, unscaled: string, scale: int, plain: string) -> void {
        let value = json.number_to_big_decimal(text);
        test.assert_equal_string(unscaled, value.unscaled.to_string());
        test.assert_equal_int32(scale, value.scale);
        test.assert_equal_string(plain, value.to_string());
    };

    export let test_number_to_big_decimal = func() -> void {
        check_decimal("0", "0", 0, "0");
        check_decimal("-0", "0", 0, "0");
        check_decimal("1.50", "150", 2, "1.50");
        check_decimal("15e-1", "15", 1, "1.5");
        check_decimal("-123.4500e2", "-1234500", 2, "-12345.00");
        check_decimal("1E3", "1", -3, "1000");
        check_decimal("0.1", "1", 1, "0.1");
        check_decimal("123456789012345678901234567890.25", "12345678901234567890123456789025", 2,
            "123456789012345678901234567890.25");
        check_decimal("-9223372036854775809", "-9223372036854775809", 0, "-9223372036854775809");
        check_decimal("5e-324", "5", 324, "0." + strings.repeat("0", 323) + "5");
        // Equal JSON numbers give numerically equal decimals.
        test.assert(json.number_to_big_decimal("1.0").equals(json.number_to_big_decimal("10e-1")));
        test.assert(!json.number_to_big_decimal("0.1").equals(json.number_to_big_decimal("0.10000000000000001")));
    };

    // Numbers are equal when their exact decimal values are.
    export let test_number_equality = func() -> void {
        same(number("1"), number("1.0"));
        same(number("1"), number("10e-1"));
        same(number("1"), number("0.1e1"));
        same(number("1"), number("100E-2"));
        same(number("0"), number("-0"));
        same(number("0"), number("0.000e+7"));
        same(number("-0.0e-0"), number("0e5"));
        same(number("123.4500e2"), number("12345"));
        same(number("-120.50"), number("-1205e-1"));
        same(number("1e99999999999999999999"), number("10e99999999999999999998"));
        same(number("1e-99999999999999999999"), number("0.1e-99999999999999999998"));
        same(number("99e999999999999999999"), number("9.9e1000000000000000000"));
        same(number("12.5e-999999999999999999"), number("125e-1000000000000000000"));
        same(number("100000000000000000000000"), number("1e23"));
        different(number("1"), number("2"));
        different(number("1e2"), number("1e3"));
        different(number("-1"), number("1"));
        different(number("0.1"), number("0.10000000000000001"));
        different(number("1e99999999999999999999"), number("1e99999999999999999998"));
        different(number("1e-99999999999999999999"), number("1e-99999999999999999998"));
        different(number("9223372036854775807"), number("9223372036854775808"));
    };

    export let test_structural_equality = func() -> void {
        same(json.JsonValue.Null, json.JsonValue.Null);
        same(json.JsonValue.Boolean(true), json.JsonValue.Boolean(true));
        different(json.JsonValue.Boolean(true), json.JsonValue.Boolean(false));
        different(json.JsonValue.Null, json.JsonValue.Boolean(false));
        different(json.JsonValue.Text("1"), number("1"));
        different(json.JsonValue.Text("a"), json.JsonValue.Text("b"));
        same(json.JsonValue.Text("é"), json.JsonValue.Text("é"));
        same(parsed("[1, [2, 3.0]]"), parsed("[1.0,[2,3]]"));
        different(parsed("[1, 2]"), parsed("[2, 1]"));
        different(parsed("[1]"), parsed("[1, 1]"));
        different(parsed("[]"), parsed("{}"));
        // Objects compare regardless of member order.
        same(parsed("{\"a\":1,\"b\":[true]}"), parsed("{\"b\":[true],\"a\":1.0}"));
        same(parsed("{}"), parsed("{}"));
        different(parsed("{\"a\":1}"), parsed("{\"a\":2}"));
        different(parsed("{\"a\":1}"), parsed("{\"b\":1}"));
        different(parsed("{\"a\":1}"), parsed("{\"a\":1,\"b\":1}"));
        different(parsed("{\"a\":{\"x\":1}}"), parsed("{\"a\":{\"x\":1,\"y\":1}}"));
    };

    // Member lists built directly may repeat a name. Each member of either
    // object must match a member of the other.
    export let test_repeated_names_equality = func() -> void {
        let one = json.number_of_int64(1);
        let two = json.number_of_int64(2);
        let a: [string, json.JsonValue][list] = [["x", one], ["x", two]];
        let b: [string, json.JsonValue][list] = [["x", two], ["x", one]];
        same(json.JsonValue.Object(a), json.JsonValue.Object(b));
        let c: [string, json.JsonValue][list] = [["x", one], ["x", one], ["x", two]];
        let d: [string, json.JsonValue][list] = [["x", one], ["x", two], ["x", two]];
        same(json.JsonValue.Object(c), json.JsonValue.Object(d));
        let e: [string, json.JsonValue][list] = [["x", one], ["x", json.number_of_int64(3)]];
        different(json.JsonValue.Object(a), json.JsonValue.Object(e));
        let f: [string, json.JsonValue][list] = [["x", one], ["x", one]];
        let g: [string, json.JsonValue][list] = [["x", one], ["y", one]];
        different(json.JsonValue.Object(f), json.JsonValue.Object(g));
        different(json.JsonValue.Object(f), json.JsonValue.Object(a));
        same(json.JsonValue.Object(f), json.JsonValue.Object(f));
    };

    // The hash values are part of the contract.
    export let test_hash_values = func() -> void {
        test.assert_equal_uint64(1, json.hash(json.JsonValue.Null) as uint64);
        test.assert_equal_uint64(1293, json.hash(json.JsonValue.Boolean(true)) as uint64);
        test.assert_equal_uint64(1299, json.hash(json.JsonValue.Boolean(false)) as uint64);
        // "0".hash_code() is 48; "1e0" is 48655.
        test.assert_equal_uint64(141, json.hash(number("-0.0")) as uint64);
        test.assert_equal_uint64(50361, json.hash(number("1.0")) as uint64);
        // "a" is 97.
        test.assert_equal_uint64(221, json.hash(json.JsonValue.Text("a")) as uint64);
        test.assert_equal_uint64(5, json.hash(parsed("[]")) as uint64);
        test.assert_equal_uint64(4837, json.hash(parsed("[null,null]")) as uint64);
        // Hash.combine(Hash.combine(6, 0), 0) and, for {"a":null},
        // Hash.combine(Hash.combine(6, 1), Hash.combine(97, 1)).
        test.assert_equal_uint64(5766, json.hash(parsed("{}")) as uint64);
        test.assert_equal_uint64(8805, json.hash(parsed("{\"a\":null}")) as uint64);
    };

    export let test_index = func() -> void {
        let members: [string, json.JsonValue][list] = [
            ["a", json.number_of_int64(1)], ["b", json.JsonValue.Null], ["a", json.number_of_int64(2)]
        ];
        let map = json.index(members);
        test.assert_equal_int32(2, map.size());
        test.assert(json.equals(json.number_of_int64(2), test.assert_some<json.JsonValue>(map.get("a"))));
        test.assert(json.equals(json.JsonValue.Null, test.assert_some<json.JsonValue>(map.get("b"))));
        test.assert_none<json.JsonValue>(map.get("c"));
        test.assert_equal<string[list]>(["a", "b"], map.keys());
        test.assert_equal_int32(0, json.index([]).size());
    };
);
