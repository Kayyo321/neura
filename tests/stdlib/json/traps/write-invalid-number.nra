// status: 70
// stderr: explicit program failure \(trap reason 3\): invalid argument: number text
let console = import:Std.Io.Console;
let json = import:Std.Encoding.Json;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        console.print_line(json.write(json.JsonValue.Number("1.5e3")));
        let items: json.JsonValue[list] = [json.number_of_int64(1), json.JsonValue.Number("01")];
        console.print_line(json.write(json.JsonValue.Array(items)));
        console.print_line("after");
        return program.ExitCode.Ok;
    };
);
