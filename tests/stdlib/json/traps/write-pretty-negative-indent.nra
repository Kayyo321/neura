// status: 70
// stderr: explicit program failure \(trap reason 3\): invalid argument: negative indent
let console = import:Std.Io.Console;
let json = import:Std.Encoding.Json;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        console.print_line(json.write_pretty(json.JsonValue.Null, 0));
        console.print_line(json.write_pretty(json.JsonValue.Null, -1));
        console.print_line("after");
        return program.ExitCode.Ok;
    };
);
