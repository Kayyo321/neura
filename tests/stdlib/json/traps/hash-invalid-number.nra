// status: 70
// stderr: explicit program failure \(trap reason 3\): invalid argument: number text
let console = import:Std.Io.Console;
let json = import:Std.Encoding.Json;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line(json.hash(json.JsonValue.Number("10")).to_string());
        let h = json.hash(json.JsonValue.Number("1e"));
        console.print_line("after");
        return program.ExitCode.Ok;
    };
);
