// status: 134
// stderr: unsupported: Std\.Net\.Dns\.Mdns\.multicast_exchange is not implemented in Neura 0\.3\.0
let duration = import:Std.Time.Duration;
let mdns = import:Std.Net.Dns.Mdns;
let messages = import:Std.Net.Dns.Message;
let names = import:Std.Net.Dns.Name;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        last querier = new mdns.MdnsQuerier(duration.of_seconds(1));
        let _ = querier.query_all(names.root(), messages.TypeA);
        return program.ExitCode.Ok;
    };
);
