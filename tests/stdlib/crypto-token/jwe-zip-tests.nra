// test-options: --gpu=off --max-steps 1000000000
let error = import:Std.Core.Error;
let hex = import:Std.Encoding.Hex;
let jwe = import:Std.Crypto.Token.Jwe;
let strings = import:Std.Text.Strings;
let test = import:Std.Test;

// JWE compression, "zip":"DEF" (RFC 7516 section 4.1.3): raw DEFLATE before encryption, inflation only after the
// tag check. The independent tokens come from Node 24 (zlib.deflateRawSync and OpenSSL AES-256-GCM through
// node:crypto); the script is recorded in lanes/net-b/RETURN-04.md.
let JweZipTests = module (
    let bytes = func(text: string) -> uint8[list] => test.assert_ok(hex.decode(text));

    let code = func(e: error.Error) -> string => match (e) {
        error.Error.Custom(detail) => detail.code(),
        _ => "",
    };

    let message = func(e: error.Error) -> string => match (e) {
        error.Error.Custom(detail) => detail.message(),
        _ => "",
    };

    let key = func -> jwe.DirectKey => new jwe.DirectKey(jwe.ContentEncryption.A256Gcm,
        bytes("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"));

    let zipped_header = func -> string => "{\"alg\":\"dir\",\"enc\":\"A256GCM\",\"zip\":\"DEF\"}";

    let expected_claims = func -> string => "{\"sub\":\"compressed\",\"claims\":\"" + strings.repeat("abcabcabc", 20)
        + "\"}";

    // A token sealed by Node: raw DEFLATE of the claims under dir/A256GCM.
    let node_token = func -> string => "eyJhbGciOiJkaXIiLCJlbmMiOiJBMjU2R0NNIiwiemlwIjoiREVGIn0..oKGio6Slpqeoqaqr.TU5WAwiZsO0oq0j-LzDt8D7hCM"
        + "LD_YwlUMIL0M35P02YaDW3BjRT.wdm3oIe6oOKULurFsabDzg";

    export let test_opens_an_independent_compressed_token = func {
        test.assert_equal_string(expected_claims(), test.assert_ok(strings.from_bytes(test.assert_ok(
            jwe.open(key(), node_token())))));
    };

    export let test_seals_compressed_when_the_header_asks = func {
        last plaintext = strings.to_bytes(expected_claims());
        last iv = bytes("c0c1c2c3c4c5c6c7c8c9cacb");
        last sealed = test.assert_ok(jwe.seal_with(key(), plaintext, iv, zipped_header()));
        last plain = test.assert_ok(jwe.seal_with(key(), plaintext, iv));
        // The compressed ciphertext segment is much shorter than the uncompressed one.
        test.assert(strings.split(sealed, ".")[3].byte_length * 2 < strings.split(plain, ".")[3].byte_length);
        test.assert_equal_string(expected_claims(), test.assert_ok(strings.from_bytes(test.assert_ok(
            jwe.open(key(), sealed)))));
        test.assert_equal_string(expected_claims(), test.assert_ok(strings.from_bytes(test.assert_ok(
            jwe.open(key(), plain)))));
    };

    export let test_tag_is_checked_before_inflation = func {
        // A changed tag or ciphertext fails authentication; nothing is inflated.
        let segments = strings.split(node_token(), ".");
        last tag = segments[4];
        segments[4] = (strings.starts_with(tag, "A") ? "B" : "A") + strings.slice_from(tag, 1);
        test.assert_equal_string("crypto.authentication_failed",
            code(test.assert_err(jwe.open(key(), strings.join(segments, ".")))));
        // Another zip value is refused before decryption.
        last other = "{\"alg\":\"dir\",\"enc\":\"A256GCM\",\"zip\":\"GZIP\"}";
        test.assert_equal_string("crypto.invalid_jwe", code(test.assert_err(jwe.seal_with(key(),
            strings.to_bytes("x"), bytes("c0c1c2c3c4c5c6c7c8c9cacb"), other))));
    };

    // A token whose plaintext inflates to MaxDecompressedSize + 1 bytes (4 MiB + 1 of "a") fails once the limit
    // is passed, with crypto.invalid_jwe.
    export let test_decompressed_size_is_bounded = func {
        test.assert_equal<int>(4194304, jwe.MaxDecompressedSize);
        last bomb = "eyJhbGciOiJkaXIiLCJlbmMiOiJBMjU2R0NNIiwiemlwIjoiREVGIn0..sLGys7S1tre4ubq7.dJTbq-zNu5xnLm7p0bndw4Q8Sd"
            + "IVLo81Xs6C8VyC8hYFSyM6Y96muKVboEo8uYK1LW0Xxxs7QvBNimwwBJsg_7LoPrQKvGbaGdyiXp4G4jFGkMmyqHh13fX7eJArWQ"
            + "-_Y6B-W87XNhZeThrcktrAgA22t5dz8806eAf32R4OLyJJraeOAw6TLmJVDSYsHzEbg71E0MtjQx2x8SPdScH8lPLSwfw_Z1Ux8B"
            + "tDsk1E67EyUBCxnO5BvFUTS4GAg4leXdek8PUHRIsoNGzZB2AtlcophnBeNi3EUzZAlcM16Rx6AIl3kPEOZDMVhk2hQZpIl8pBB6"
            + "Y5VqfQ-VIGl7VFQhd_QBCsFC_HR0vDU7umcVBEGNgf2Ka5AmS-PfMRSZww39JMQoB-HS65aU3LmCjiBZjfjSzrWb8EnkqGslSQSw"
            + "z02uIsFZl9G3033y5XCqrTSwgciERJkJ3zPxwgHqb6A_DKf8MUTBfbviXhBLtP70LqOwXnve_UB8VxbNv8EFkHG826sfdBmRP26_"
            + "aeVFxiTxu6hDsbEV6gE0NSto2B44K4JdfA7ruoGHgRs09QEB8tydqhHWZJr0UU7Ub4zLcJ5B-JR251L5f6kVgf5Jg_eoVorKoVbu"
            + "RPReOgbDUHM8ju1DXZbmOh_8ybu_YwhevAf3mrFlViXGbsvIijmldQC4hyTYZe8IVqXIUAmfqV8pvAxobB7uBxRaYUVGqwdsQvIp"
            + "xlSsyimrLi-7fufMU9DsbO6uQBjMHZUo5R-MejxLm9B6uqf1CnRwa-mnmYg7T1ksHk1b4_9etifaSE5VEcF9SP5uR6B03TiJMSDZ"
            + "uZwCofZuHpYq4BrguKgwX_CHybBQ__OigOvEoed78Gerbz0gxPwlI8hc_pypQgcr0YEI8NQN_DsDW1o5_PR4nJHMxtvldoj57Jpk"
            + "FvpO6YP6M22NL4uTND8-WjE0XBYL-R8NDWef0q1sUl0aqk9JIeA1XURSP-ocSFQnqIv9bxQqXgD-EMok9XNP9pLUU4iJ9Fy23sFt"
            + "osYP-OZSmi4-pvswgJ1dGil5dma4UPhXi2emsR_T3q4DE80MuEzoIOyuCkmS655rsiYYKG5N4dUiR9ZH-p2brEZWFyGUgIwspdJq"
            + "3fL7IyKCgZ61Fy_hGxgqfo7vDBBpw2bWuNd3jdRaRCXDJS5wg3I1HUbgsgRl9mT6xjfeVb7kRXf-5uNfq47MfCah6OPAKPsb1RPZ"
            + "SzfluvXHtcyLqan_BZ5OWZr1Dv0sDUHCF4Hd54OmztVIOHA-U86xbrtBqIBRmmcFtm3b3YiRDqiedksIeUgKYss9Xr8cglHtMnhv"
            + "hHA3IDxdNkDmyikZvYY-0pZhfwst6IbSoGS5uYVxqZjNfcr5NMAaf6DkICl350y9PBHKtceUYMgku-dqZHFzmO2aNf-k2tMhax1E"
            + "6pmh93ERdiSEeESzda_8elmim8cAYJBcTEhWhuqi6MK1eMIAZj5R3zCbgIrCoRMeF7L4rTP006fOcfPN7DjXWfw69oWCO69wvt-E"
            + "Xr53EkHh9tHVlojPevce1hiSzp3lfVY8UIHFf2FU1S4f0UdtJlvK0WmJCEZt1_S4lpL1iCbEzmFkZppNxK95-fqdm6eNfc7cyxXg"
            + "92PJKgdv2-jRRSpobwWaUpBjHaiJOMxulYY_cxEOa5i-zbwzFPaRaqmDMAhtWYTw5cGs0nq4xZsURrd2E9ZidwC0dIvLZEx54tPv"
