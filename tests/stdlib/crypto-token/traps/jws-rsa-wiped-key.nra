// status: 134
// stderr: explicit program failure \(trap reason 3\): invalid state: secret wiped
// run-options: --gpu=off --deny-entropy --max-steps 5000000000
let cases = import:JwsSigningTestCases;
let jwk = import:Std.Crypto.Token.Jwk;
let jws = import:Std.Crypto.Token.Jws;
let program = import:Std.Program;

let App = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let key = cases.rsa_key(0);
        key.wipe();
        let _ = jws.sign_rsa(new, key, jwk.RsaAlgorithm.Ps256);
        return program.ExitCode.Ok;
    };
);
