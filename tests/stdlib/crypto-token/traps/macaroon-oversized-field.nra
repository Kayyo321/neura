// test-options: --gpu=off
// status: 134
// run-options: --gpu=off --deny-entropy
// stderr: explicit program failure \(trap reason 3\): invalid argument: a macaroon field may hold at most 32767 bytes
let macaroon = import:Std.Crypto.Token.Macaroon;
let program = import:Std.Program;

let App = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let location: uint8[list] = new;
        for (let i = 0; i < 32768; i++) {
            location.append(0);
        }
        let _ = macaroon.create(location, new([1]), new([1]));
        return program.ExitCode.Ok;
    };
);
