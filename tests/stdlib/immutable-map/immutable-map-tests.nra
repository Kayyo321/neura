let cell = import:Std.Core.Cell;
let hash_map = import:Std.Collections.HashMap;
let immutable_map = import:Std.Collections.ImmutableMap;
let int_map = import:Std.Collections.IntMap;
let int32 = import:Std.Core.Int32;
let map_interface = import:Std.Collections.Map;
let maps = import:Std.Collections.Maps;
let random = import:Std.Random.Random;
let test = import:Std.Test;
let tree_map = import:Std.Collections.TreeMap;

let ImmutableMapTests = module (
    let sample = func() -> immutable_map.ImmutableMap<string, int> {
        let entries: [string, int][list] = [["b", 2], ["a", 1], ["c", 3]];
        return immutable_map.of<string, int>(entries);
    };

    export let test_members = func() -> void {
        let empty: [string, int][list] = [];
        test.assert(immutable_map.of<string, int>(empty).is_empty());
        let map = sample();
        test.assert_equal_int32(3, map.size());
        test.assert(!map.is_empty());
        test.assert(map.contains_key("a"));
        test.assert(!map.contains_key("d"));
        test.assert_equal_int32(1, test.assert_some<int>(map.get("a")));
        test.assert_none<int>(map.get("d"));
        test.assert_equal_int32(0, map.get_or("d", 0));
        test.assert_equal_int32(3, map.require("c"));
        test.assert_equal_string("[b, a, c]", map.keys().to_string());
        test.assert_equal_string("[2, 1, 3]", map.values().to_string());
        test.assert_equal_string("[[b, 2], [a, 1], [c, 3]]", map.entries().to_string());
        test.assert(map.contains_value(3));
        test.assert(!map.contains_value(4));
        test.assert_equal_string("{b: 2, a: 1, c: 3}", map.to_string());
        let seen = cell.of<string>("");
        map.for_each(func(string key, int value) -> void {
            seen.value = seen.value + key + value.to_string();
        });
        test.assert_equal_string("b2a1c3", seen.value);
        let items = map.iterator();
        test.assert_equal_string("[b, 2]", items.next().to_string());
        let total = 0;
        for (let entry in map) {
            total = total + entry[1];
        }
        test.assert_equal_int32(6, total);
    };

    export let test_copies_at_construction = func() -> void {
        let entries: [int, int][list] = [[1, 10]];
        let map = immutable_map.of<int, int>(entries);
        let extra: [int, int] = [2, 20];
        entries.append(extra);
        let listed = map.entries();
        listed.append(extra);
        test.assert_equal_string("{1: 10}", map.to_string());
    };

    export let test_equals_and_hash = func() -> void {
        let a = sample();
        let entries: [string, int][list] = [["c", 3], ["b", 2], ["a", 1]];
        let b = immutable_map.of<string, int>(entries);
        test.assert(a.equals(b));
        test.assert_equal_uint64(a.hash_code() as uint64, b.hash_code() as uint64);
        let expected = ((("b".hash_code() ^ 2) as uint64) + (("a".hash_code() ^ 1) as uint64)
            + (("c".hash_code() ^ 3) as uint64)) & 4294967295;
        test.assert_equal_uint64(expected, a.hash_code() as uint64);
        let changed: [string, int][list] = [["c", 3], ["b", 2], ["a", 4]];
        test.assert(!a.equals(immutable_map.of<string, int>(changed)));
        let fewer: [string, int][list] = [["c", 3], ["b", 2]];
        test.assert(!a.equals(immutable_map.of<string, int>(fewer)));
        let other: class = hash_map.create<string, int>();
        test.assert(!a.equals(other));
        test.assert(!a.equals(nil));
    };

    // Maps.same_entries compares maps of different classes through the
    // read-only interface.
    export let test_same_entries = func() -> void {
        let hashed = hash_map.create<int, string>();
        hashed.set(2, "b");
        hashed.set(1, "a");
        let sorted = tree_map.create<int, string>(int32.compare);
        sorted.set(1, "a");
        sorted.set(2, "b");
        let numbered = int_map.create<string>();
        numbered.set(1, "a");
        numbered.set(2, "b");
        let entries: [int, string][list] = [[1, "a"], [2, "b"]];
        let fixed = immutable_map.of<int, string>(entries);
        test.assert(maps.same_entries<int, string>(hashed, sorted));
        test.assert(maps.same_entries<int, string>(sorted, numbered));
        test.assert(maps.same_entries<int, string>(numbered, fixed));
        test.assert(maps.same_entries<int, string>(fixed, hashed));
        sorted.set(2, "B");
        test.assert(!maps.same_entries<int, string>(hashed, sorted));
        sorted.set(2, "b");
        sorted.set(3, "c");
        test.assert(!maps.same_entries<int, string>(hashed, sorted));
        hashed.set(4, "c");
        test.assert(!maps.same_entries<int, string>(hashed, sorted));
        let view: map_interface.Map<int, string> = fixed;
        test.assert_equal_int32(2, view.size());
    };

    // Seeded check against an association list: 50 random sources of
    // distinct keys and 10,000 lookups.
    export let test_model = func() -> void {
        let generator = random.seeded(71);
        let round = 0;
        while (round < 50) {
            let entries: [int, int][list] = [];
            let keys: int[list] = [];
            let values: int[list] = [];
            let length = generator.next_int_below(40);
            let next_key = generator.next_int_below(5);
            while (entries.length < length) {
                let value = generator.next_int_below(1000);
                let entry: [int, int] = [next_key, value];
                entries.append(entry);
                keys.append(next_key);
                values.append(value);
                next_key = next_key + 1 + generator.next_int_below(3);
            }
            let map = immutable_map.of<int, int>(entries);
            test.assert_equal_string(keys.to_string(), map.keys().to_string());
            test.assert_equal_string(values.to_string(), map.values().to_string());
            let query = 0;
            while (query < 200) {
                let key = generator.next_int_below(130);
                let expected = -1;
                let i = 0;
                while (i < keys.length) {
                    if (keys[i] == key) {
                        expected = values[i];
                    }
                    i = i + 1;
                }
                test.assert_equal_int32(expected, map.get_or(key, -1));
                test.assert_equal_bool(expected >= 0, map.contains_key(key));
                query = query + 1;
            }
            round = round + 1;
        }
    };
);
