// status: 70
// stderr: explicit program failure \(trap reason 3\): invalid argument: NaN bound
let console = import:Std.Io.Console;
let floats = import:Std.Core.Float32;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        console.print_line(floats.clamp(floats.NaN, 1.0, 2.0).to_string());
        console.print_line(floats.clamp(1.5, floats.NaN, 2.0).to_string());
        console.print_line("unreachable");
        return program.ExitCode.Ok;
    };
);
