// status: 134
// stderr: explicit program failure \(trap reason 3\): invalid argument: digits outside 0 through 100
let console = import:Std.Io.Console;
let floats = import:Std.Core.Float32;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line(floats.to_exponential(1.5, 0));
        console.print_line(floats.to_exponential(1.5, 101));
        console.print_line("unreachable");
        return program.ExitCode.Ok;
    };
);
