let config = import:Std.Net.Quic.QuicConfig;
let duration = import:Std.Time.Duration;
let error = import:Std.Core.Error;
let fixed_clock = import:Std.Time.FixedClock;
let instant = import:Std.Time.Instant;
let replay = import:Std.Net.Quic.ReplayFilter;
let strings = import:Std.Text.Strings;
let test = import:Std.Test;
let ticket = import:Std.Net.Quic.SessionTicket;
let tls = import:Std.Net.Tls.TlsConfig;

// 0-RTT replay protection, session tickets and the QUIC configuration.
let StateTests = module (
    let positions_of = func(filter: replay.ReplayFilter, token: string) -> int64[list] =>
        filter.positions(strings.to_bytes(token));

    // Script: /home/dev/neura-gate/030/std-net/vectors-socket-tls-quic/quic_vec.py.
    // Generated with python3 -I: d = hashlib.sha256(seed + token).digest(); h1 = int.from_bytes(d[0:8], "big");
    // h2 = int.from_bytes(d[8:16], "big") | 1; [(h1 + i * h2) % m for i in range(k)].
    export let test_probe_positions = func {
        last clock = fixed_clock.of(instant.Epoch);
        last filter = replay.create(4096, 4, strings.to_bytes("server-secret"), clock, duration.of_seconds(10));
        last expected: int64[list] = new([1470, 3157, 748, 2435]);
        last actual = positions_of(filter, "ticket-1");
        test.assert_equal<int>(4, actual.length);
        let i = 0;
        while (i < 4) {
            test.assert_equal_int64(expected[i], actual[i]);
            i++;
        }
        last small = replay.create(64, 3, new, clock, duration.of_seconds(10));
        last three = positions_of(small, "abc");
        test.assert_equal_int64(42, three[0]);
        test.assert_equal_int64(13, three[1]);
        test.assert_equal_int64(48, three[2]);
        test.assert_equal_string("ReplayFilter(4096 bits, 4 hashes)", filter.to_string());
    };

    export let test_replays_are_refused_within_the_window = func {
        last clock = fixed_clock.of(instant.Epoch);
        last filter = replay.create(8192, 5, strings.to_bytes("k"), clock, duration.of_seconds(10));
        last first = strings.to_bytes("client-hello-1");
        last second = strings.to_bytes("client-hello-2");
        test.assert(test.assert_ok<bool>(filter.check_and_insert(first)));
        test.assert(!test.assert_ok<bool>(filter.check_and_insert(first)));
        test.assert(test.assert_ok<bool>(filter.check_and_insert(second)));
        test.assert(test.assert_ok<bool>(filter.may_contain(first)));
        // After one window the token is in the older generation and still refused.
        clock.advance(duration.of_seconds(10));
        test.assert(!test.assert_ok<bool>(filter.check_and_insert(second)));
        // After two more windows both generations have rotated out.
        clock.advance(duration.of_seconds(20));
        test.assert(!test.assert_ok<bool>(filter.may_contain(first)));
        test.assert(test.assert_ok<bool>(filter.check_and_insert(first)));
    };

    export let test_many_tokens_have_no_false_negatives = func {
        last clock = fixed_clock.of(instant.Epoch);
        last filter = replay.create(16384, 4, strings.to_bytes("seed"), clock, duration.of_seconds(60));
        let i = 0;
        while (i < 200) {
            let fresh = filter.check_and_insert(strings.to_bytes("token-" + i.to_string()));
            test.assert_ok<bool>(fresh);
            i++;
        }
        i = 0;
        while (i < 200) {
            test.assert(test.assert_ok<bool>(filter.may_contain(strings.to_bytes("token-" + i.to_string()))));
            i++;
        }
    };

    // RFC 8446 sections 4.6.1 and 4.2.11.1, RFC 9001 section 4.6.1.
    export let test_session_tickets = func {
        last received = instant.of_epoch_seconds(1000, 0);
        last held = test.assert_ok<ticket.SessionTicket>(ticket.create(strings.to_bytes("opaque"), "example.com", "h3",
            received, 7200, 4294967000, 4294967295));
        test.assert(held.early_data);
        test.assert(held.is_usable_at(received));
        test.assert(held.is_usable_at(received.plus(duration.of_seconds(7199))));
        test.assert(!held.is_usable_at(received.plus(duration.of_seconds(7200))));
        test.assert(!held.is_usable_at(received.minus(duration.of_seconds(1))));
        // (500 ms + 4294967000) mod 2^32 = 204.
        test.assert_equal_int64(204, held.obfuscated_age(received.plus(duration.of_millis(500))));
        test.assert_equal_string("SessionTicket(example.com, h3, 7200 s, 0-RTT, ticket redacted)", held.to_string());
        test.assert_equal<int>(6, held.ticket_bytes().length);
        last without_early = test.assert_ok<ticket.SessionTicket>(ticket.create(strings.to_bytes("t"), "example.com",
            "h3", received, 604800, 0, -1));
        test.assert(!without_early.early_data);
        test.assert(!held.equals(without_early));
        last again = test.assert_ok<ticket.SessionTicket>(ticket.create(strings.to_bytes("opaque"), "example.com", "h3",
            received, 7200, 4294967000, 4294967295));
        test.assert(held.equals(again));
        test.assert_equal<uint32>(held.hash_code(), again.hash_code());
        test.assert_err<ticket.SessionTicket>(ticket.create(strings.to_bytes("t"), "a", "h3", received, 604801, 0, -1));
        test.assert_err<ticket.SessionTicket>(ticket.create(strings.to_bytes("t"), "a", "h3", received, 0, 0, -1));
        test.assert_err<ticket.SessionTicket>(ticket.create(new, "a", "h3", received, 60, 0, -1));
        test.assert_err<ticket.SessionTicket>(ticket.create(strings.to_bytes("t"), "a", "h3", received, 60, 4294967296,
            -1));
        last violation = test.assert_err<ticket.SessionTicket>(ticket.create(strings.to_bytes("t"), "a", "h3", received,
            60, 0, 16384));
        test.assert_equal_string("a QUIC ticket's max_early_data_size must be 0xffffffff (PROTOCOL_VIOLATION)",
            error.message(violation));
    };

    let tls_client = func(lowest: tls.TlsVersion, alpn: string[list]) -> tls.TlsConfig {
        last builder = tls.builder();
        builder.set_versions(lowest, tls.TlsVersion.Tls13);
        builder.set_alpn(alpn);
        return test.assert_ok<tls.TlsConfig>(builder.build_client());
    };

    export let test_quic_config = func {
        last good = tls_client(tls.TlsVersion.Tls13, new(["h3"]));
        last settings = test.assert_ok<config.QuicConfig>(config.create(good, 100, 3, 65535, duration.of_seconds(30),
            1200, config.CongestionAlgorithm.Cubic, true));
        test.assert_equal_string("QuicConfig(Cubic, alpn h3, 100/3 streams, datagrams 65535)", settings.to_string());
        test.assert_equal_string("Cubic", settings.new_controller().name());
        test.assert_equal_int64(12000, settings.new_controller().window());
        for (let algorithm in [config.CongestionAlgorithm.NewReno, config.CongestionAlgorithm.Ledbat]) {
            last other = test.assert_ok<config.QuicConfig>(config.create(good, 1, 1, 0, duration.of_seconds(0), 1350,
                algorithm, false));
            test.assert_equal_string(algorithm.to_string(), other.new_controller().name());
        }
        last messages: string[list] = new;
        messages.append(error.message(test.assert_err<config.QuicConfig>(config.create(
            tls_client(tls.TlsVersion.Tls12, new(["h3"])), 1, 1, 0, duration.of_seconds(0), 1200,
            config.CongestionAlgorithm.Cubic, false))));
        messages.append(error.message(test.assert_err<config.QuicConfig>(config.create(
            tls_client(tls.TlsVersion.Tls13, new), 1, 1, 0, duration.of_seconds(0), 1200,
            config.CongestionAlgorithm.Cubic, false))));
        messages.append(error.message(test.assert_err<config.QuicConfig>(config.create(good, 1152921504606846977, 1, 0,
            duration.of_seconds(0), 1200, config.CongestionAlgorithm.Cubic, false))));
        messages.append(error.message(test.assert_err<config.QuicConfig>(config.create(good, 1, 1, 4611686018427387904,
            duration.of_seconds(0), 1200, config.CongestionAlgorithm.Cubic, false))));
        messages.append(error.message(test.assert_err<config.QuicConfig>(config.create(good, 1, 1, 0,
            duration.of_seconds(0), 1199, config.CongestionAlgorithm.Cubic, false))));
        test.assert_equal_string("QUIC needs TLS 1.3 only|QUIC needs at least one ALPN protocol|"
            + "a stream limit must be 0 through 2^60|max_datagram_frame_size must be at most 2^62 - 1|"
            + "the maximum datagram size must be 1200 through 65527 bytes", strings.join(messages, "|"));
    };
);
