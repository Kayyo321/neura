// status: 134
// stderr: unsupported: Std\.Net\.Quic\.QuicConnection\.quic_connect is not implemented in Neura 0\.3\.0
// A QUIC connection needs a QUIC host service, which no runtime has.
let config = import:Std.Net.Quic.QuicConfig;
let duration = import:Std.Time.Duration;
let optional = import:Std.Core.Optional;
let program = import:Std.Program;
let quic = import:Std.Net.Quic.QuicConnection;
let result = import:Std.Core.Result;
let socket_addr = import:Std.Net.Core.SocketAddr;
let ticket = import:Std.Net.Quic.SessionTicket;
let tls = import:Std.Net.Tls.TlsConfig;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        last builder = tls.builder();
        builder.set_versions(tls.TlsVersion.Tls13, tls.TlsVersion.Tls13);
        builder.set_alpn(new(["h3"]));
        last client = result.expect<tls.TlsConfig>(builder.build_client(), "tls");
        last settings = result.expect<config.QuicConfig>(config.create(client, 100, 100, 65535, duration.of_seconds(30),
            1200, config.CongestionAlgorithm.Cubic, false), "config");
        last target = result.expect<socket_addr.SocketAddr>(socket_addr.parse("127.0.0.1:443"), "address");
        let _ = quic.connect(target, settings, optional.Optional<ticket.SessionTicket>.None, new);
        return program.ExitCode.Ok;
    };
);
