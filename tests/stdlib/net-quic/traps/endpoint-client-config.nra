// status: 134
// stderr: invalid argument: a QUIC endpoint needs a server configuration
// Binding an endpoint with a client configuration is a programming error.
let config = import:Std.Net.Quic.QuicConfig;
let connections = import:Std.Net.Quic.QuicConnection;
let duration = import:Std.Time.Duration;
let endpoint = import:Std.Net.Quic.QuicEndpoint;
let program = import:Std.Program;
let result = import:Std.Core.Result;
let socket_addr = import:Std.Net.Core.SocketAddr;
let tls = import:Std.Net.Tls.TlsConfig;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        last builder = tls.builder();
        builder.set_versions(tls.TlsVersion.Tls13, tls.TlsVersion.Tls13);
        builder.set_alpn(new(["h3"]));
        last client = result.expect<tls.TlsConfig>(builder.build_client(), "tls");
        last settings = result.expect<config.QuicConfig>(config.create(client, connections.StackStreamLimit,
            connections.StackStreamLimit, 0, duration.of_seconds(30), 1200, config.CongestionAlgorithm.NewReno, false),
            "config");
        last address = result.expect<socket_addr.SocketAddr>(socket_addr.parse("127.0.0.1:0"), "address");
        let _ = endpoint.bind(address, settings);
        return program.ExitCode.Ok;
    };
);
