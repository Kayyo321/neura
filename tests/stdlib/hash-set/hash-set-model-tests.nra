let hash_set = import:Std.Collections.HashSet;
let set_model = import:SetModel;

// Seeded model-based tests (Stdlib.md section 17): 10,000 operations
// against a list of ids in insertion order, calling validate() after every
// operation.
let HashSetModelTests = module (
    let identity = func(id: int) -> int {
        return id;
    };

    export let test_model_universal_elements = func() -> void {
        let set = hash_set.create<int>();
        set_model.run<int>(set, identity, set.validate, set.trim, false, 11, 10000, 24, 160);
    };

    // Four hash values for every element: long probe chains.
    export let test_model_colliding_elements = func() -> void {
        let set = hash_set.with_keys<int>(func(value: int) -> uint32 {
            return (value % 4) as uint32;
        }, func(a: int, b: int) -> bool {
            return a == b;
        });
        set_model.run<int>(set, identity, set.validate, set.trim, false, 12, 3000, 12, 40);
    };

    export let test_model_string_elements = func() -> void {
        let set = hash_set.with_capacity<string>(50);
        set_model.run<string>(set, func(id: int) -> string {
            return "s" + id.to_string();
        }, set.validate, set.trim, false, 13, 3000, 24, 160);
    };
);
