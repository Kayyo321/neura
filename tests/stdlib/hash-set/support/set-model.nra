let cell = import:Std.Core.Cell;
let mutable_set = import:Std.Collections.MutableSet;
let random = import:Std.Random.Random;
let test = import:Std.Test;

// Drives a MutableSet<T> and a trivially correct list of element ids (in
// iteration order) with the same seeded operations, and compares results,
// size, contents, and iteration order after every operation (Stdlib.md
// section 17). `element_of` turns an id into an element and must give equal
// elements for equal ids. `check` runs the set's validate(). A sorted model
// keeps ids ascending (TreeSet with ascending int elements); otherwise new
// elements go to the end (insertion order).
export let SetModel = module (
    export let run = func<T>(set: mutable_set.MutableSet<T>, element_of: func(int) -> T, check: func() -> void,
                             trim: func() -> void, sorted: bool, seed: uint64, operations: int, small_domain: int,
                             large_domain: int) -> void {
        let generator = random.seeded(seed);
        let ids: int[list] = [];
        let step = 0;
        while (step < operations) {
            let domain = small_domain;
            if (step % 3000 >= 1500) {
                domain = large_domain;
            }
            let id = generator.next_int_below(domain);
            let element = element_of(id);
            let choice = generator.next_int_below(100);
            let at = position(ids, id);
            if (choice < 40) {
                test.assert_equal_bool(at < 0, set.add(element));
                if (at < 0) {
                    insert(ids, id, sorted);
                }
            } else if (choice < 70) {
                test.assert_equal_bool(at >= 0, set.remove(element));
                if (at >= 0) {
                    ids.remove_at(at);
                }
            } else if (choice < 80) {
                test.assert_equal_bool(at >= 0, set.contains(element));
            } else if (choice < 84) {
                let divisor = 2 + generator.next_int_below(6);
                let calls = cell.of<int>(0);
                let retain = generator.next_int_below(2) == 0;
                let test_element = func(e: T) -> bool {
                    calls.value = calls.value + 1;
                    return position_of<T>(e, ids, element_of) % divisor == 0;
                };
                let kept: int[list] = [];
                let i = 0;
                while (i < ids.length) {
                    if ((i % divisor == 0) == retain) {
                        kept.append(ids[i]);
                    }
                    i = i + 1;
                }
                let removed = 0;
                if (retain) {
                    removed = set.retain_if(test_element);
                } else {
                    removed = set.remove_if(test_element);
                }
                test.assert_equal_int32(ids.length, calls.value);
                test.assert_equal_int32(ids.length - kept.length, removed);
                replace(ids, kept);
            } else if (choice < 88) {
                let items: T[list] = [element, element_of(generator.next_int_below(domain)), element];
                set.add_all(items);
                let j = 0;
                while (j < items.length) {
                    let item_id = id;
                    if (j == 1) {
                        item_id = position_id<T>(items[1], domain, element_of);
                    }
                    if (position(ids, item_id) < 0) {
                        insert(ids, item_id, sorted);
                    }
                    j = j + 1;
                }
            } else if (choice < 91) {
                let listed = set.to_list();
                test.assert_equal_int32(ids.length, listed.length);
                let i = 0;
                while (i < ids.length) {
                    test.assert(listed[i].equals(element_of(ids[i])));
                    i = i + 1;
                }
            } else if (choice < 94) {
                trim();
            } else if (choice < 95) {
                if (generator.next_int_below(3) == 0) {
                    set.clear();
                    replace(ids, []);
                }
            } else {
                let seen = cell.of<int>(0);
                set.for_each(func(e: T) -> void {
                    test.assert(e.equals(element_of(ids[seen.value])));
                    seen.value = seen.value + 1;
                });
                test.assert_equal_int32(ids.length, seen.value);
            }
            check();
            compare<T>(set, ids, element_of);
            step = step + 1;
        }
    };

    let compare = func<T>(set: mutable_set.MutableSet<T>, ids: int[list], element_of: func(int) -> T) -> void {
        test.assert_equal_int32(ids.length, set.size());
        test.assert_equal_bool(ids.length == 0, set.is_empty());
        let items = set.iterator();
        let i = 0;
        while (items.has_next()) {
            let element = items.next();
            test.assert(i < ids.length);
            test.assert(element.equals(element_of(ids[i])));
            i = i + 1;
        }
        test.assert_equal_int32(ids.length, i);
    };

    // The position in `ids` of the element, found by equals.
    let position_of = func<T>(element: T, ids: int[list], element_of: func(int) -> T) -> int {
        let i = 0;
        while (i < ids.length) {
            if (element.equals(element_of(ids[i]))) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    };

    // The id below `domain` whose element equals `element`.
    let position_id = func<T>(element: T, domain: int, element_of: func(int) -> T) -> int {
        let id = 0;
        while (id < domain) {
            if (element.equals(element_of(id))) {
                return id;
            }
            id = id + 1;
        }
        return -1;
    };

    let position = func(items: int[list], item: int) -> int {
        let i = 0;
        while (i < items.length) {
            if (items[i] == item) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    };

    let insert = func(ids: int[list], id: int, sorted: bool) -> void {
        ids.append(id);
        if (sorted) {
            let i = ids.length - 1;
            while (i > 0 && ids[i - 1] > id) {
                ids[i] = ids[i - 1];
                i = i - 1;
            }
            ids[i] = id;
        }
    };

    let replace = func(target: int[list], source: int[list]) -> void {
        while (target.length > 0) {
            target.remove_at(target.length - 1);
        }
        let i = 0;
        while (i < source.length) {
            target.append(source[i]);
            i = i + 1;
        }
    };
);
