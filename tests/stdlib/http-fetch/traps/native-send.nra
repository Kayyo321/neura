// status: 1
// stderr: neura\.http\.fetch version 1\) is not available
// A native run does not serve neura.http.fetch yet (docs/runtime/Providers.md, "HTTP fetch"): an image that
// calls it fails to bind before it starts, so nothing is printed.
let console = import:Std.Io.Console;
let http = import:Std.Net.Http.Fetch;
let program = import:Std.Program;
let result = import:Std.Core.Result;

export let Main = module : program.Entry (
    export let.override main = func(arguments: string[]) -> program.ExitCode {
        console.print_line("started");
        return match (http.get("http://127.0.0.1:9/")) {
            result.Result.Ok(_) => program.ExitCode.Ok,
            result.Result.Err(_) => program.ExitCode.Failure,
        };
    };
);
