// status: 70
// stderr: explicit program failure \(trap reason 3\): invalid argument: limit below 1
let program = import:Std.Program;
let text = import:Std.Core.String;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let _ = text.split_with_delimiters("a,b", ",", 0);
        return program.ExitCode.Ok;
    };
);
