let big = import:Std.Math.BigInteger;
let optional = import:Std.Core.Optional;
let ordering = import:Std.Core.Ordering;
let result = import:Std.Core.Result;
let test = import:Std.Test;
let vectors = import:BigIntegerVectors;

// BigInteger against checked-in reference results computed with Python's
// int (support/big-integer-vectors.nra, generated by vectors/generate.py):
// seeded operands of 0 to 200 limbs, Karatsuba sizes, and divisions that
// need Algorithm D's qhat correction and add-back.
let BigIntegerReferenceTests = module (
    // Reads numbers and integers from a flat vector list.
    let Reader = class (
        let data: uint32[list] = [];
        let position: int = 0;

        export let init = func(uint32[list] cases) -> void {
            data = cases;
        };

        export let has_more = func() -> bool {
            return position < data.length;
        };

        export let next_int = func() -> int {
            position = position + 1;
            return data[position - 1] as int;
        };

        export let next_uint32 = func() -> uint32 {
            position = position + 1;
            return data[position - 1];
        };

        export let next_uint64 = func() -> uint64 {
            let low = data[position] as uint64;
            let high = data[position + 1] as uint64;
            position = position + 2;
            return low | (high << 32);
        };

        export let next = func() -> big.BigInteger {
            let code = next_int();
            let count = next_int();
            let limbs: uint32[list] = [];
            for (let i = 0; i < count; i = i + 1) {
                limbs.append(data[position + i]);
            }
            position = position + count;
            let sign = 0;
            if (code == 1) {
                sign = 1;
            } else if (code == 2) {
                sign = -1;
            }
            return new big.BigInteger(sign, limbs);
        };
    );

    let same = func(string what, big.BigInteger expected, big.BigInteger actual) -> void {
        if (!expected.equals(actual)) {
            test.fail(what + ": expected <" + expected.to_string() + ">, got <" + actual.to_string() + ">");
        }
    };

    let ordinal = func(ordering.Ordering o) -> int {
        if (o == ordering.Ordering.Less) {
            return 0;
        }
        if (o == ordering.Ordering.Equal) {
            return 1;
        }
        return 2;
    };

    export let test_add_subtract_compare = func() -> void {
        let reader = new Reader(vectors.add_cases());
        let count = 0;
        while (reader.has_more()) {
            let a = reader.next();
            let b = reader.next();
            same("a + b", reader.next(), a.add(b));
            same("a - b", reader.next(), a.subtract(b));
            test.assert_equal_int32(reader.next_int(), ordinal(a.compare_to(b)));
            test.assert_equal_bool(a.equals(b), a.compare_to(b) == ordering.Ordering.Equal);
            count = count + 1;
        }
        test.assert(count >= 90);
    };

    export let test_multiply_schoolbook = func() -> void {
        let reader = new Reader(vectors.multiply_cases());
        while (reader.has_more()) {
            let a = reader.next();
            let b = reader.next();
            let product = reader.next();
            same("a * b", product, a.multiply(b));
            same("b * a", product, b.multiply(a));
        }
    };

    export let test_multiply_karatsuba = func() -> void {
        let reader = new Reader(vectors.karatsuba_cases());
        let count = 0;
        while (reader.has_more()) {
            let a = reader.next();
            let b = reader.next();
            same("a * b", reader.next(), a.multiply(b));
            count = count + 1;
        }
        test.assert(count == 20);
    };

    export let test_divide_remainder_floor_mod = func() -> void {
        let reader = new Reader(vectors.divide_cases());
        let count = 0;
        while (reader.has_more()) {
            let a = reader.next();
            let b = reader.next();
            let quotient = reader.next();
            let rest = reader.next();
            let modulo = reader.next();
            let [q, r] = a.divide_and_remainder(b);
            same("quotient", quotient, q);
            same("remainder", rest, r);
            same("divide", quotient, a.divide(b));
            same("remainder", rest, a.remainder(b));
            same("floor_mod", modulo, a.floor_mod(b));
            count = count + 1;
        }
        test.assert(count == 132);
    };

    export let test_shifts = func() -> void {
        let reader = new Reader(vectors.shift_cases());
        while (reader.has_more()) {
            let a = reader.next();
            let n = reader.next_int();
            same("shift_left", reader.next(), a.shift_left(n));
            same("shift_right", reader.next(), a.shift_right(n));
        }
    };

    export let test_pow = func() -> void {
        let reader = new Reader(vectors.pow_cases());
        while (reader.has_more()) {
            let a = reader.next();
            let e = reader.next_int();
            same("pow", reader.next(), a.pow(e));
        }
    };

    export let test_gcd = func() -> void {
        let reader = new Reader(vectors.gcd_cases());
        while (reader.has_more()) {
            let a = reader.next();
            let b = reader.next();
            let g = reader.next();
            same("gcd", g, a.gcd(b));
            same("gcd", g, b.gcd(a));
        }
    };

    export let test_mod_pow = func() -> void {
        let reader = new Reader(vectors.mod_pow_cases());
        while (reader.has_more()) {
            let a = reader.next();
            let e = reader.next();
            let m = reader.next();
            same("mod_pow", reader.next(), a.mod_pow(e, m));
        }
    };

    export let test_mod_inverse = func() -> void {
        let reader = new Reader(vectors.mod_inverse_cases());
        let missing = 0;
        while (reader.has_more()) {
            let a = reader.next();
            let m = reader.next();
            let exists = reader.next_int() == 1;
            let expected = reader.next();
            let inverse = a.mod_inverse(m);
            if (exists) {
                test.assert(inverse != nil);
                same("mod_inverse", expected, inverse);
            } else {
                test.assert(inverse == nil);
                missing = missing + 1;
            }
        }
        test.assert(missing > 0);
    };

    export let test_conversions_and_hash = func() -> void {
        let reader = new Reader(vectors.conversion_cases());
        while (reader.has_more()) {
            let a = reader.next();
            let bits = reader.next_uint64();
            let hash = reader.next_uint32();
            let length = reader.next_int();
            let fits = reader.next_int() == 1;
            let value = reader.next_uint64();
            test.assert_equal_uint64(bits, a.to_float64().to_bits());
            test.assert_equal_uint64(hash as uint64, a.hash_code() as uint64);
            test.assert_equal_int32(length, a.bit_length());
            match (a.to_int64()) {
                optional.Optional.Some(v) => {
                    test.assert(fits);
                    let pattern: uint64 = 0;
                    if (v < 0) {
                        pattern = ((v + 9223372036854775807 + 1) as uint64) + 9223372036854775808;
                    } else {
                        pattern = v as uint64;
                    }
                    test.assert_equal_uint64(value, pattern);
                },
                optional.Optional.None => {
                    test.assert(!fits);
                },
            }
        }
    };

    export let test_test_bit = func() -> void {
        let reader = new Reader(vectors.bit_cases());
        while (reader.has_more()) {
            let a = reader.next();
            let n = reader.next_int();
            test.assert_equal_bool(reader.next_int() == 1, a.test_bit(n));
        }
    };

    export let test_text = func() -> void {
        let reader = new Reader(vectors.text_values());
        let texts = vectors.text_strings();
        let i = 0;
        while (reader.has_more()) {
            let a = reader.next();
            let radix = reader.next_int();
            let text = texts[i];
            test.assert_equal_string(text, a.to_string_radix(radix));
            if (radix == 10) {
                test.assert_equal_string(text, a.to_string());
            }
            same("parse_radix", a, result.expect<big.BigInteger>(big.parse_radix(text, radix), text));
            i = i + 1;
        }
        test.assert(i == texts.length);
    };
);
