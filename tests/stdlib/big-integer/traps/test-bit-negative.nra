// status: 134
// stderr: explicit program failure \(trap reason 3\): invalid argument: negative bit index
let big = import:Std.Math.BigInteger;
let console = import:Std.Io.Console;
let program = import:Std.Program;
let result = import:Std.Core.Result;

export let Main = module:program.Entry (
    let test_bit_probe: int64 = 5;

    let parse_probe = func(radix: int) -> big.BigInteger {
        return result.value_or<big.BigInteger>(big.parse_radix("1", radix), big.Zero);
    };

    let digits_probe = func() -> uint32[list] {
        let limbs: uint32[list] = [5];
        return limbs;
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line("before");
        console.print_line(big.of_int64(test_bit_probe).test_bit(-1).to_string());
        console.print_line("unreachable");
        return program.ExitCode.Ok;
    };
);
