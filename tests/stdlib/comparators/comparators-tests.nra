let bools = import:Std.Core.Bool;
let cell = import:Std.Core.Cell;
let comparators = import:Std.Core.Comparators;
let int32s = import:Std.Core.Int32;
let ordering = import:Std.Core.Ordering;
let test = import:Std.Test;

let ComparatorsTests = module (
    // Insertion sort by a comparator, so the tests see the order it defines.
    let sorted = func(input: int[list], c: func(int, int) -> ordering.Ordering) -> int[list] {
        let output: int[list] = [];
        for (let value in input) {
            output.append(value);
            let i = output.length - 1;
            while (i > 0 && c(output[i], output[i - 1]) == ordering.Ordering.Less) {
                let swap = output[i];
                output[i] = output[i - 1];
                output[i - 1] = swap;
                i = i - 1;
            }
        }
        return output;
    };

    let text = func(values: int[list]) -> string {
        return values.to_string();
    };

    export let test_reversed = func() -> void {
        let descending = comparators.reversed<int>(int32s.compare);
        test.assert(descending(1, 2) == ordering.Ordering.Greater);
        test.assert(descending(2, 1) == ordering.Ordering.Less);
        test.assert(descending(3, 3) == ordering.Ordering.Equal);
        test.assert_equal_string("[9, 4, 1, -3]", text(sorted([4, -3, 9, 1], descending)));
        let twice = comparators.reversed<int>(descending);
        test.assert_equal_string("[-3, 1, 4, 9]", text(sorted([4, -3, 9, 1], twice)));
    };

    export let test_by_key = func() -> void {
        let by_length = comparators.by_key<string, int>(func(s: string) -> int { return s.byte_length; }, int32s.compare);
        test.assert(by_length("ab", "c") == ordering.Ordering.Greater);
        test.assert(by_length("ab", "cd") == ordering.Ordering.Equal);
        test.assert(by_length("", "c") == ordering.Ordering.Less);
        // Absolute value as the key; the key runs once per operand.
        let calls = cell.of<int>(0);
        let magnitude = func(v: int) -> int {
            calls.value = calls.value + 1;
            if (v < 0) {
                return -v;
            }
            return v;
        };
        let by_magnitude = comparators.by_key<int, int>(magnitude, int32s.compare);
        test.assert(by_magnitude(-5, 3) == ordering.Ordering.Greater);
        test.assert_equal_int32(2, calls.value);
        let by_flag = comparators.by_key<int, bool>(func(v: int) -> bool { return v % 2 == 0; }, bools.compare);
        test.assert(by_flag(2, 3) == ordering.Ordering.Greater);
    };

    export let test_then = func() -> void {
        let parity = comparators.by_key<int, int>(func(v: int) -> int { return int32s.floor_mod(v, 2); }, int32s.compare);
        let combined = comparators.then<int>(parity, int32s.compare);
        test.assert_equal_string("[-4, 0, 2, 6, -3, 1, 5]", text(sorted([5, 2, -3, 0, 6, 1, -4], combined)));
        let second_calls = cell.of<int>(0);
        let counted = func(a: int, b: int) -> ordering.Ordering {
            second_calls.value = second_calls.value + 1;
            return int32s.compare(a, b);
        };
        let lazy = comparators.then<int>(parity, counted);
        test.assert(lazy(1, 2) == ordering.Ordering.Greater);
        test.assert_equal_int32(0, second_calls.value);
        test.assert(lazy(2, 4) == ordering.Ordering.Less);
        test.assert_equal_int32(1, second_calls.value);
        let descending_within = comparators.then<int>(parity, comparators.reversed<int>(int32s.compare));
        test.assert_equal_string("[6, 2, 0, -4, 5, 1, -3]", text(sorted([5, 2, -3, 0, 6, 1, -4], descending_within)));
    };
);
