let hash_map = import:Std.Collections.HashMap;
let map_model = import:MapModel;

// Seeded model-based tests (Stdlib.md section 17): 10,000 operations
// against an association list in insertion order, calling validate() after
// every operation.
let HashMapModelTests = module (
    let identity = func(id: int) -> int {
        return id;
    };

    export let test_model_universal_keys = func() -> void {
        let map = hash_map.create<int, int>();
        map_model.run<int>(map, identity, map.validate, map.trim, false, 1, 10000, 24, 160);
    };

    // Three hash values for every key: long probe chains and many equal
    // cached hashes, so lookups depend on the stored equality function.
    export let test_model_colliding_keys = func() -> void {
        let map = hash_map.with_keys<int, int>(func(key: int) -> uint32 {
            return (key % 3) as uint32;
        }, func(a: int, b: int) -> bool {
            return a == b;
        });
        map_model.run<int>(map, identity, map.validate, map.trim, false, 2, 3000, 12, 40);
    };

    // String keys through with_keys_and_capacity.
    export let test_model_string_keys = func() -> void {
        let map = hash_map.with_keys_and_capacity<string, int>(func(key: string) -> uint32 {
            return key.hash_code();
        }, func(a: string, b: string) -> bool {
            return a == b;
        }, 100);
        map_model.run<string>(map, func(id: int) -> string {
            return "key" + id.to_string();
        }, map.validate, map.trim, false, 3, 3000, 24, 160);
    };
);
