// run-options: --max-heap-cells 9500
let console = import:Std.Io.Console;
let hash_map = import:Std.Collections.HashMap;
let program = import:Std.Program;

// Releasing the last entry removes it and the dead entries before it from
// the dense lists at once, so stack-like use retains nothing (Stdlib.md
// section 9.6). Each round adds a 2,000-element value under a new key and
// removes it again. The run needs about 8,500 cells; keeping even the 7 dead
// entries that compaction rule 2 would allow needs about 23,000.
export let Main = module:program.Entry (
    let block = func(int seed) -> int[list] {
        let values: int[list] = [];
        let i = 0;
        while (i < 2000) {
            values.append(seed + i);
            i = i + 1;
        }
        return values;
    };

    export let.override main = func(string[] args) -> program.ExitCode {
        let map = hash_map.with_capacity<int, int[list]>(1000);
        let i = 0;
        while (i < 7) {
            let small: int[list] = [i];
            map.set(-1 - i, small);
            i = i + 1;
        }
        let total: int64 = 0;
        let round = 0;
        while (round < 300) {
            map.set(round, block(round));
            if (round % 3 == 0) {
                map.delete(round);
            } else if (round % 3 == 1) {
                total = total + (map.require(round)[2] as int64);
                let removed = map.remove(round);
            } else {
                map.remove_if(func(int key, int[list] value) -> bool {
                    return key >= 0;
                });
            }
            round = round + 1;
        }
        map.validate();
        console.print_line(map.size().to_string() + " " + total.to_string());
        return program.ExitCode.Ok;
    };
);
