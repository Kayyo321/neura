// test-options: --gpu=off --deny-all --max-steps 1000000000
let fixed = import:Std.Time.FixedClock;
let instant = import:Std.Time.Instant;
let vectors = import:SpiffeVectors;
let error = import:Std.Core.Error;
let spiffe = import:Std.Net.Tls.Spiffe;
let strings = import:Std.Text.Strings;
let test = import:Std.Test;

// Std.Net.Tls.Spiffe: SPIFFE ID parsing per SPIFFE-ID.md section 2 (examples from sections 2 and 2.2).
let SpiffeTests = module (
    let rejected = func(text: string, kind: error.ParseErrorKind, offset: int) {
        last failure = test.assert_err<spiffe.SpiffeId>(spiffe.parse(text));
        match (failure) {
            error.Error.Parse { kind: actual_kind, offset: actual_offset, message } => {
                test.assert_with(actual_kind == kind, text + ": expected " + kind.to_string() + ", got "
                    + actual_kind.to_string() + " (" + message + ")");
                test.assert_equal<int>(offset, actual_offset);
            },
            _ => {
                test.fail("expected a parse error for " + text);
            },
        }
    };

    export let test_examples_from_the_standard = func {
        for (let text in ["spiffe://staging.example.com/payments/mysql", "spiffe://staging.example.com/payments/web-fe",
            "spiffe://k8s-west.example.com/ns/staging/sa/default",
            "spiffe://example.com/9eebccd2-12bf-40a6-b262-65fe0487d453",
            "spiffe://trust_domain_name.example.com"]) {
            test.assert_equal_string(text, test.assert_ok<spiffe.SpiffeId>(spiffe.parse(text)).to_string());
        }
        last id = test.assert_ok<spiffe.SpiffeId>(spiffe.parse("spiffe://k8s-west.example.com/ns/staging/sa/default"));
        test.assert_equal_string("k8s-west.example.com", id.trust_domain);
        test.assert_equal_string("/ns/staging/sa/default", id.path);
        test.assert_equal<int>(4, id.segments().length);
        test.assert_equal_string("sa", id.segments()[2]);
        test.assert(id.member_of("k8s-west.example.com"));
        test.assert_equal_string("spiffe://k8s-west.example.com", id.trust_domain_id().to_string());
    };

    export let test_scheme_case_and_equality = func {
        last upper = test.assert_ok<spiffe.SpiffeId>(spiffe.parse("SPIFFE://example.org/Svc"));
        test.assert_equal_string("spiffe://example.org/Svc", upper.to_string());
        last same = test.assert_ok<spiffe.SpiffeId>(spiffe.of("example.org", "/Svc"));
        test.assert(upper.equals(same));
        test.assert_equal<uint32>(upper.hash_code(), same.hash_code());
        // The path is case-sensitive.
        test.assert(!upper.equals(test.assert_ok<spiffe.SpiffeId>(spiffe.parse("spiffe://example.org/svc"))));
        test.assert_equal<int>(0, test.assert_ok<spiffe.SpiffeId>(spiffe.parse("spiffe://example.org")).segments().length);
        test.assert_equal_string("1.2.3.4", test.assert_ok<string>(spiffe.check_trust_domain_name("1.2.3.4")));
    };

    export let test_trust_domain_rules = func {
        rejected("spiffe://", error.ParseErrorKind.Empty, 9);
        rejected("spiffe:///path", error.ParseErrorKind.Empty, 9);
        rejected("spiffe://Example.org/a", error.ParseErrorKind.InvalidCharacter, 9);
        rejected("spiffe://example.org:8080/a", error.ParseErrorKind.InvalidCharacter, 20);
        rejected("spiffe://user@example.org", error.ParseErrorKind.InvalidCharacter, 13);
        rejected("spiffe://exa%41mple.org", error.ParseErrorKind.InvalidCharacter, 12);
        rejected("spiffe://[::1]/a", error.ParseErrorKind.InvalidCharacter, 9);
        rejected("spiffe://example.org?x=1", error.ParseErrorKind.InvalidCharacter, 20);
        rejected("http://example.org/a", error.ParseErrorKind.Syntax, 0);
        rejected("spiffe:/example.org", error.ParseErrorKind.Syntax, 0);
        rejected("spiffe://" + strings.repeat("a", 256), error.ParseErrorKind.OutOfRange, 9);
        test.assert_ok<spiffe.SpiffeId>(spiffe.parse("spiffe://" + strings.repeat("a", 255)));
    };

    export let test_path_rules = func {
        rejected("spiffe://example.org/", error.ParseErrorKind.Syntax, 20);
        rejected("spiffe://example.org/a/", error.ParseErrorKind.Syntax, 22);
        rejected("spiffe://example.org//a", error.ParseErrorKind.Syntax, 20);
        rejected("spiffe://example.org/a/./b", error.ParseErrorKind.Syntax, 23);
        rejected("spiffe://example.org/a/../b", error.ParseErrorKind.Syntax, 23);
        rejected("spiffe://example.org/a%20b", error.ParseErrorKind.InvalidCharacter, 22);
        rejected("spiffe://example.org/a?b", error.ParseErrorKind.InvalidCharacter, 22);
        rejected("spiffe://example.org/a#b", error.ParseErrorKind.InvalidCharacter, 22);
        rejected("spiffe://example.org/ü", error.ParseErrorKind.InvalidCharacter, 21);
        test.assert_ok<spiffe.SpiffeId>(spiffe.parse("spiffe://example.org/a.b/-_/.../..x"));
    };

    // Section 2.3: SPIFFE IDs up to 2048 bytes are supported.
    export let test_length_limit = func {
        last prefix = "spiffe://example.org/";
        last longest = prefix + strings.repeat("a", 2048 - prefix.byte_length);
        test.assert_equal<int>(2048, longest.byte_length);
        test.assert_ok<spiffe.SpiffeId>(spiffe.parse(longest));
        rejected(longest + "a", error.ParseErrorKind.OutOfRange, 2048);
    };

    let code = func(failure: error.Error) -> string => match (failure) {
        error.Error.Custom(detail) => detail.code(),
        _ => "",
    };

    export let test_x509_svid_trust_and_uri = func {
        last clock = fixed.of(instant.of_epoch_seconds(1735689600, 0));
        last id = test.assert_ok<spiffe.SpiffeId>(spiffe.verify_x509_svid(vectors.Leaf, vectors.Root, "example.test", clock));
        test.assert_equal_string("spiffe://example.test/workload", id.to_string());
        last mismatch = test.assert_err<spiffe.SpiffeId>(spiffe.verify_x509_svid(vectors.Leaf, vectors.Root, "other.test", clock));
        test.assert_equal_string("spiffe.identity", code(mismatch));
        last multiple = test.assert_err<spiffe.SpiffeId>(spiffe.verify_x509_svid(vectors.DoubleUri, vectors.Root, "example.test", clock));
        test.assert_equal_string("spiffe.certificate", code(multiple));
        last empty = test.assert_err<spiffe.SpiffeId>(spiffe.verify_x509_svid(vectors.Leaf, "", "example.test", clock));
        test.assert_equal_string("pki.no_path", code(empty));
        last expired_clock = fixed.of(instant.of_epoch_seconds(2100000000, 0));
        last expired = test.assert_err<spiffe.SpiffeId>(spiffe.verify_x509_svid(vectors.Leaf, vectors.Root, "example.test", expired_clock));
        test.assert_equal_string("pki.validity", code(expired));
    };

    export let test_jwt_svid_key_and_claims = func {
        last clock = fixed.of(instant.of_epoch_seconds(1735689600, 0));
        last id = test.assert_ok<spiffe.SpiffeId>(spiffe.verify_jwt_svid(vectors.Jwt, vectors.Jwks, "test-audience", "example.test", clock));
        test.assert_equal_string("spiffe://example.test/workload", id.to_string());
        last no_key = test.assert_ok<spiffe.SpiffeId>(spiffe.verify_jwt_svid(vectors.NoKeyIdJwt, vectors.Jwks, "test-audience", "example.test", clock));
        test.assert(id.equals(no_key));
        last audience = test.assert_err<spiffe.SpiffeId>(spiffe.verify_jwt_svid(vectors.Jwt, vectors.Jwks, "other-audience", "example.test", clock));
        test.assert_equal_string("spiffe.claims", code(audience));
        last no_expiry = test.assert_err<spiffe.SpiffeId>(spiffe.verify_jwt_svid(vectors.NoExpiryJwt, vectors.Jwks, "test-audience", "example.test", clock));
        test.assert_equal_string("spiffe.claims", code(no_expiry));
        last wrong_use = test.assert_err<spiffe.SpiffeId>(spiffe.verify_jwt_svid(vectors.Jwt, vectors.WrongUseJwks, "test-audience", "example.test", clock));
        test.assert_equal_string("spiffe.bundle", code(wrong_use));
        clock.set(instant.of_epoch_seconds(1800000000, 0));
        last expired = test.assert_err<spiffe.SpiffeId>(spiffe.verify_jwt_svid(vectors.Jwt, vectors.Jwks, "test-audience", "example.test", clock));
        test.assert_equal_string("jwt.expired", code(expired));
    };

    export let test_jwt_svid_ml_dsa = func {
        last clock = fixed.of(instant.of_epoch_seconds(1735689600, 0));
        last id = test.assert_ok<spiffe.SpiffeId>(spiffe.verify_jwt_svid(vectors.MlDsaJwt, vectors.MlDsaBundle, "test-audience", "example.test", clock));
        test.assert_equal_string("spiffe://example.test/workload", id.to_string());
    };
);
