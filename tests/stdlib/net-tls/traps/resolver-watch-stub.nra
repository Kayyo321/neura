// status: 134
// stderr: unsupported: Std\.Net\.Tls\.DynamicCertResolver\.watch_paths is not implemented in Neura 0\.3\.0
// Watching files needs a host file-watching service.
let duration = import:Std.Time.Duration;
let resolver = import:Std.Net.Tls.DynamicCertResolver;
let fixed_clock = import:Std.Time.FixedClock;
let instant = import:Std.Time.Instant;
let program = import:Std.Program;
let result = import:Std.Core.Result;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        last load = func -> result.Result<resolver.CertificateBundle> => resolver.bundle("-----BEGIN CERTIFICATE-----\nA\n-----END CERTIFICATE-----\n",
            "-----BEGIN PRIVATE KEY-----\nB\n-----END PRIVATE KEY-----\n", "");
        last changed = func -> result.Result<bool> => result.Result<bool>.Ok(false);
        last rotating = result.expect<resolver.DynamicCertResolver>(resolver.create(load, changed,
            fixed_clock.of(instant.Epoch), duration.of_seconds(1)), "create");
        let _ = resolver.watch_paths(rotating, new(["cert.pem"]));
        return program.ExitCode.Ok;
    };
);
