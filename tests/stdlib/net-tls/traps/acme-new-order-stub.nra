// status: 134
// stderr: unsupported: Std\.Net\.Tls\.Acme\.AcmeClient\.new_order is not implemented in Neura 0\.3\.0
// ACME network flows need an HTTPS client and JWS signing.
let acme = import:Std.Net.Tls.Acme;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        last client = new acme.AcmeClient("https://ca.example/directory", "thumbprint");
        let _ = client.new_order(new(["example.org"]));
        return program.ExitCode.Ok;
    };
);
