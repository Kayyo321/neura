let config = import:Std.Net.Tls.TlsConfig;
let console = import:Std.Io.Console;
let datagram = import:Std.Net.Socket.DatagramSocket;
let duration = import:Std.Time.Duration;
let errors = import:Std.Core.Error;
let fs = import:Std.Fs.Fs;
let handshake = import:Std.Net.Tls.Handshake;
let optional = import:Std.Core.Optional;
let path = import:Std.Fs.Path;
let pem = import:Std.Crypto.Pki.Pem;
let program = import:Std.Program;
let result = import:Std.Core.Result;
let socket_addr = import:Std.Net.Core.SocketAddr;
let strings = import:Std.Text.Strings;
let transport = import:Std.Net.Transport;
let udp = import:Std.Net.Socket.UdpSocket;
let unit = import:Std.Core.Unit;

// dtls-loopback.py controls the application phase through stdin, after both
// endpoints report READY. A relay never guesses when a handshake has finished.
export let DtlsPeer = module:program.Entry (
    // Inject a one-shot receive failure while leaving the underlying socket usable.
    let FaultingDatagram = class implements datagram.DatagramSocket<socket_addr.SocketAddr> (
        last wire: udp.UdpSocket;
        let fail_next_read = false;

        export let init = func(socket: udp.UdpSocket) {
            wire = socket;
        };

        export let fail_read = func {
            fail_next_read = true;
        };

        export let local_address = func -> result.Result<socket_addr.SocketAddr> => wire.local_address();
        export let read_timeout = func -> duration.Duration => wire.read_timeout();
        export let set_read_timeout = func(timeout: duration.Duration) => wire.set_read_timeout(timeout);
        export let send_to = func(data: uint8[list], target: socket_addr.SocketAddr) -> result.Result<int> =>
            wire.send_to(data, target);

        export let close = func -> result.Result<unit.Unit> => wire.close();

        export let receive_from = func(max: int) -> result.Result<datagram.Datagram<socket_addr.SocketAddr>> {
            if (fail_next_read) {
                fail_next_read = false;
                return result.Result<datagram.Datagram<socket_addr.SocketAddr>>.Err(errors.Error.Io {
                    kind: errors.IoErrorKind.ConnectionReset, message: "injected read failure", path: "",
                });
            }
            return wire.receive_from(max);
        };
    );

    export let.override main = func(args: string[]) -> program.ExitCode {
        match (exercise(args)) {
            result.Result.Ok(text) => {
                console.print_line($"RESULT {text}");
            },
            result.Result.Err(failure) => {
                match (failure) {
                    errors.Error.Io { kind, message, path } => {
                        console.print_line($"ERROR {kind.to_string()}");
                    },
                    errors.Error.Custom(detail) => {
                        console.print_line($"ERROR {detail.code()}");
                    },
                    _ => {
                        console.print_line($"ERROR {errors.message(failure)}");
                    },
                }
            },
        }
        return program.ExitCode.Ok;
    };

    let exercise = func(args: string[]) -> result.Result<string> {
        last server = args[0] == "server";
        last wire = udp.bind(socket_addr.parse("127.0.0.1:0")?)?;
        wire.set_read_timeout(duration.of_seconds(5));
        console.print_line($"ADDRESS {(wire.local_address()?).to_string()}");
        last builder = config.builder();
        builder.set_versions(config.TlsVersion.Tls13, config.TlsVersion.Tls13);
        builder.set_handshake_timeout(args[6] == "timeout" ? duration.of_millis(250) : duration.of_seconds(8));
        if (args[2].byte_length > 0) {
            builder.set_certificate(args[2], args[3]);
        }
        last settings: config.TlsConfig;
        if (server) {
            builder.set_client_ca_file(args[4]);
            settings = builder.build_server()?;
        } else {
            builder.set_ca_file(args[4]);
            builder.set_server_name(args[5]);
            settings = builder.build_client()?;
        }
        last faulting_wire = new FaultingDatagram(wire);
        let supplied: datagram.DatagramSocket<socket_addr.SocketAddr> = wire;
        if (args[6] == "receive-error") {
            supplied = faulting_wire;
        }
        last opened = handshake.dtls13(settings, supplied, socket_addr.parse(args[1])?);
        match (opened) {
            result.Result.Err(failure) => {
                let _ = wire.close();
                return result.Result<string>.Err(failure);
            },
            result.Result.Ok(stream) => {
                console.print_line("READY");
                last outcome = exercise_open(stream, server, args[6], args[4], wire, faulting_wire);
                let _ = stream.close();
                return outcome;
            },
        }
    };

    let check_verified_chain = func(stream: transport.Transport<uint8[list], uint8[list]>, ca: string)
        -> result.Result<unit.Unit> {
        last chain = handshake.dtls_peer_certificate_chain(stream);
        if (ca.byte_length == 0) {
            match (chain) {
                result.Result.Err(errors.Error.Io { kind, message, path }) => {
                    if (kind == errors.IoErrorKind.PermissionDenied) {
                        console.print_line("CHAIN PermissionDenied");
                        return result.Result<unit.Unit>.Ok(unit.Unit.Value);
                    }
                },
                _ => {},
            }
            return result.Result<unit.Unit>.Err(errors.custom("test.dtls.chain", "unverified chain must be denied"));
        }
        last verified = chain?;
        // Each peer uses the other peer's self-signed certificate as its trust anchor.
        last anchor = pem.decode(fs.read_text(path.of(ca))?, "CERTIFICATE")?;
        // Compare the DER bytes through one canonical encoding, not the file's PEM layout.
        if (verified.length != 1 || pem.encode("CERTIFICATE", verified[0]) != pem.encode("CERTIFICATE", anchor)) {
            return result.Result<unit.Unit>.Err(errors.custom("test.dtls.chain", "unexpected verified certificate"));
        }
        console.print_line("CHAIN verified");
        return result.Result<unit.Unit>.Ok(unit.Unit.Value);
    };

    let exercise_open = func(stream: transport.Transport<uint8[list], uint8[list]>, server: bool, scenario: string, ca: string,
        wire: udp.UdpSocket, faulting_wire: FaultingDatagram) -> result.Result<string> {
        if (scenario == "mutual" || (scenario == "round-trip" && server && ca.byte_length == 0)) {
            check_verified_chain(stream, ca)?;
        }
        if (not server && (scenario == "idle-read" || scenario == "receive-error")) {
            last idle = scenario == "idle-read";
            if (idle) {
                wire.set_read_timeout(duration.of_millis(100));
            } else {
                faulting_wire.fail_read();
            }
            last attempted = stream.receive();
            wire.set_read_timeout(duration.of_seconds(5));
            last expected = idle ? errors.IoErrorKind.TimedOut : errors.IoErrorKind.ConnectionReset;
            match (attempted) {
                result.Result.Err(errors.Error.Io { kind, message, path }) => {
                    if (kind != expected) {
                        return result.Result<string>.Err(errors.custom("test.dtls.read", $"unexpected read error {kind}"));
                    }
                },
                _ => {
                    return result.Result<string>.Err(errors.custom("test.dtls.read", "expected an I/O error"));
                },
            }
            console.print_line($"READ {expected.to_string()}");
        }
        return exchange(stream, server, scenario);
    };

    let barrier = func -> result.Result<unit.Unit> {
        match (console.read_line()?) {
            optional.Optional.Some(line) => {
                if (line == "go") {
                    return result.Result<unit.Unit>.Ok(unit.Unit.Value);
                }
            },
            optional.Optional.None => {},
        }
        return result.Result<unit.Unit>.Err(errors.custom("test.dtls.control", "expected go"));
    };

    let expect_message = func(stream: transport.Transport<uint8[list], uint8[list]>, expected: string)
        -> result.Result<unit.Unit> {
        match (stream.receive()?) {
            optional.Optional.Some(data) => {
                last text = strings.from_bytes(data)?;
                if (text != wire_text(expected)) {
                    return result.Result<unit.Unit>.Err(errors.custom("test.dtls.payload", $"expected {expected}, got {text}"));
                }
                console.print_line($"RECEIVED {expected}");
                return result.Result<unit.Unit>.Ok(unit.Unit.Value);
            },
            optional.Optional.None => {
                return result.Result<unit.Unit>.Err(errors.custom("test.dtls.closed", "peer closed before a message"));
            },
        }
    };

    // Larger than the short ACK and KeyUpdate records. The relay uses this
    // length after READY to select application records without decrypting them.
    let wire_text = func(text: string) -> string => strings.pad_end(text, 256, " ") .. "\n";

    let exchange = func(stream: transport.Transport<uint8[list], uint8[list]>, server: bool, scenario: string)
        -> result.Result<string> {
        barrier()?;
        if (scenario == "loss-reorder") {
            if (server) {
                expect_message(stream, "second")?;
                expect_message(stream, "first")?;
                stream.send(strings.to_bytes(wire_text("pong")))?;
            } else {
                stream.send(strings.to_bytes(wire_text("discard")))?;
                stream.send(strings.to_bytes(wire_text("first")))?;
                stream.send(strings.to_bytes(wire_text("second")))?;
                expect_message(stream, "pong")?;
            }
        } else {
            for (let index in 0 .. 2) {
                last ping = index == 0 ? "ping-one" : "ping-two";
                last pong = index == 0 ? "pong-one" : "pong-two";
                if (server) {
                    expect_message(stream, ping)?;
                    stream.send(strings.to_bytes(wire_text(pong)))?;
                } else {
                    stream.send(strings.to_bytes(wire_text(ping)))?;
                    expect_message(stream, pong)?;
                }
                if (index == 0) {
                    console.print_line("NEXT");
                    barrier()?;
                    if (scenario == "key-update-reorder") {
                        // The harness reverses the reciprocal KeyUpdate and
                        // this expendable response. DTLS application data need
                        // not survive loss or epoch reordering. The following
                        // ping-two/pong-two exchange verifies the updated keys.
                        if (server) {
                            expect_message(stream, "probe")?;
                            stream.send(strings.to_bytes(wire_text("probe")))?;
                        } else {
                            stream.send(strings.to_bytes(wire_text("probe")))?;
                        }
                        console.print_line("UPDATED");
                        barrier()?;
                    }
                }
            }
        }
        console.print_line("DONE");
        // Keep both endpoints alive until their peer has received its last
        // datagram; close_notify must not race the application's final send.
        barrier()?;
        return result.Result<string>.Ok("ok");
    };
);
