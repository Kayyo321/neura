    export let.override main = func(args: string[]) -> program.ExitCode {
        let key: uint8[list] = new;
        for (let i = 0; i < 32; i++) {
            key.append(i as uint8);
        }
        let stream = new online.StreamEncryptor<SymmetricKey<chacha20_poly1305.ChaCha20Poly1305>>(
            new chacha20_poly1305.ChaCha20Poly1305(key), new([1, 2, 3, 4, 5, 6, 7]), new);
        let _ = stream.seal_segment(new([1]), true);
        let _ = stream.seal_segment(new([2]), false);
        return program.ExitCode.Ok;
    };
);
