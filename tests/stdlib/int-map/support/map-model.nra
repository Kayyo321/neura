let cell = import:Std.Core.Cell;
let mutable_map = import:Std.Collections.MutableMap;
let optional = import:Std.Core.Optional;
let random = import:Std.Random.Random;
let test = import:Std.Test;

// Drives a MutableMap<K, int> and a trivially correct association list (key
// ids and values in iteration order) with the same seeded operations, and
// compares results, size, contents, and iteration order after every
// operation (Stdlib.md section 17). `key_of` turns a key id into a key and
// must give equal keys for equal ids. `check` runs the map's validate().
// A sorted model keeps key ids ascending (TreeMap with ascending int keys);
// otherwise new keys go to the end (insertion order).
export let MapModel = module (
    export let run = func<K>(mutable_map.MutableMap<K, int> map, func(int) -> K key_of, func() -> void check,
                             func() -> void trim, bool sorted, uint64 seed, int operations, int small_domain,
                             int large_domain) -> void {
        let generator = random.seeded(seed);
        let ids: int[list] = [];
        let values: int[list] = [];
        let plus = func(int a, int b) -> int {
            return a + b;
        };
        let step = 0;
        while (step < operations) {
            let domain = small_domain;
            if (step % 3000 >= 1500) {
                domain = large_domain;
            }
            let id = generator.next_int_below(domain);
            let key = key_of(id);
            let value = generator.next_int_below(1000);
            let choice = generator.next_int_below(100);
            let at = position(ids, id);
            if (choice < 25) {
                map.set(key, value);
                store(ids, values, id, value, at, sorted);
            } else if (choice < 33) {
                expect_previous(map.put(key, value), values, at);
                store(ids, values, id, value, at, sorted);
            } else if (choice < 48) {
                test.assert_equal_bool(at >= 0, map.delete(key));
                drop(ids, values, at);
            } else if (choice < 56) {
                expect_previous(map.remove(key), values, at);
                drop(ids, values, at);
            } else if (choice < 64) {
                expect_previous(map.get(key), values, at);
                test.assert_equal_bool(at >= 0, map.contains_key(key));
                let fallback = -1;
                if (at >= 0) {
                    fallback = values[at];
                }
                test.assert_equal_int32(fallback, map.get_or(key, -1));
            } else if (choice < 70) {
                let made = cell.of<int>(0);
                let result = map.get_or_put(key, func() -> int {
                    made.value = made.value + 1;
                    return value;
                });
                if (at >= 0) {
                    test.assert_equal_int32(values[at], result);
                    test.assert_equal_int32(0, made.value);
                } else {
                    test.assert_equal_int32(value, result);
                    test.assert_equal_int32(1, made.value);
                    store(ids, values, id, value, at, sorted);
                }
            } else if (choice < 76) {
                let expected = value;
                if (at >= 0) {
                    expected = values[at] + value;
                }
                test.assert_equal_int32(expected, map.merge(key, value, plus));
                store(ids, values, id, expected, at, sorted);
            } else if (choice < 82) {
                let outcome = map.compute(key, func(K ignored, optional.Optional<int> current) -> optional.Optional<int> {
                    return adjusted(current, value);
                });
                let current = optional.Optional<int>.None;
                if (at >= 0) {
                    current = optional.Optional<int>.Some(values[at]);
                }
                let expected = adjusted(current, value);
                test.assert(optional.equals<int>(expected, outcome));
                match (expected) {
                    optional.Optional.Some(stored) => {
                        store(ids, values, id, stored, at, sorted);
                    },
                    optional.Optional.None => {
                        drop(ids, values, at);
                    },
                }
            } else if (choice < 85) {
                let divisor = 2 + generator.next_int_below(6);
                let calls = cell.of<int>(0);
                let removed = map.remove_if(func(K ignored, int v) -> bool {
                    calls.value = calls.value + 1;
                    return v % divisor == 0;
                });
                test.assert_equal_int32(ids.length, calls.value);
                let kept_ids: int[list] = [];
                let kept_values: int[list] = [];
                let i = 0;
                while (i < ids.length) {
                    if (values[i] % divisor != 0) {
                        kept_ids.append(ids[i]);
                        kept_values.append(values[i]);
                    }
                    i = i + 1;
                }
                test.assert_equal_int32(ids.length - kept_ids.length, removed);
                replace(ids, kept_ids);
                replace(values, kept_values);
            } else if (choice < 88) {
                if (at >= 0) {
                    test.assert_equal_int32(values[at], map.require(key));
                }
                test.assert_equal_bool(position(values, value) >= 0, map.contains_value(value));
            } else if (choice < 91) {
                let keys = map.keys();
                let listed = map.values();
                let entries = map.entries();
                test.assert_equal_int32(ids.length, keys.length);
                test.assert_equal_int32(ids.length, listed.length);
                test.assert_equal_int32(ids.length, entries.length);
                let i = 0;
                while (i < ids.length) {
                    test.assert(keys[i].equals(key_of(ids[i])));
                    test.assert_equal_int32(values[i], listed[i]);
                    let [entry_key, entry_value] = entries[i];
                    test.assert(entry_key.equals(key_of(ids[i])));
                    test.assert_equal_int32(values[i], entry_value);
                    i = i + 1;
                }
            } else if (choice < 94) {
                trim();
            } else if (choice < 95) {
                if (generator.next_int_below(3) == 0) {
                    map.clear();
                    replace(ids, []);
                    replace(values, []);
                }
            } else {
                let seen = cell.of<int>(0);
                map.for_each(func(K k, int v) -> void {
                    let i = seen.value;
                    test.assert(k.equals(key_of(ids[i])));
                    test.assert_equal_int32(values[i], v);
                    seen.value = i + 1;
                });
                test.assert_equal_int32(ids.length, seen.value);
            }
            check();
            compare<K>(map, ids, values, key_of);
            step = step + 1;
        }
    };

    // None leaves the key absent; Some(c) becomes absent when c is a
    // multiple of 3 and c + 1 otherwise; an absent key gets the value when it
    // is even.
    let adjusted = func(optional.Optional<int> current, int value) -> optional.Optional<int> {
        return match (current) {
            optional.Optional.None => even(value),
            optional.Optional.Some(c) => next_unless_third(c),
        };
    };

    let even = func(int value) -> optional.Optional<int> {
        if (value % 2 == 0) {
            return optional.Optional<int>.Some(value);
        }
        return optional.Optional<int>.None;
    };

    let next_unless_third = func(int c) -> optional.Optional<int> {
        if (c % 3 == 0) {
            return optional.Optional<int>.None;
        }
        return optional.Optional<int>.Some(c + 1);
    };

    let compare = func<K>(mutable_map.MutableMap<K, int> map, int[list] ids, int[list] values, func(int) -> K key_of) -> void {
        test.assert_equal_int32(ids.length, map.size());
        test.assert_equal_bool(ids.length == 0, map.is_empty());
        let items = map.iterator();
        let i = 0;
        while (items.has_next()) {
            let [key, value] = items.next();
            test.assert(i < ids.length);
            test.assert(key.equals(key_of(ids[i])));
            test.assert_equal_int32(values[i], value);
            i = i + 1;
        }
        test.assert_equal_int32(ids.length, i);
    };

    let expect_previous = func(optional.Optional<int> actual, int[list] values, int at) -> void {
        if (at >= 0) {
            test.assert_equal_int32(values[at], test.assert_some<int>(actual));
        } else {
            test.assert_none<int>(actual);
        }
    };

    let position = func(int[list] items, int item) -> int {
        let i = 0;
        while (i < items.length) {
            if (items[i] == item) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    };

    // Overwrites in place, or adds the key at the end (or at its ascending
    // place for a sorted model).
    let store = func(int[list] ids, int[list] values, int id, int value, int at, bool sorted) -> void {
        if (at >= 0) {
            values[at] = value;
            return;
        }
        ids.append(id);
        values.append(value);
        if (sorted) {
            let i = ids.length - 1;
            while (i > 0 && ids[i - 1] > id) {
                ids[i] = ids[i - 1];
                values[i] = values[i - 1];
                i = i - 1;
            }
            ids[i] = id;
            values[i] = value;
        }
    };

    let drop = func(int[list] ids, int[list] values, int at) -> void {
        if (at >= 0) {
            ids.remove_at(at);
            values.remove_at(at);
        }
    };

    let replace = func(int[list] target, int[list] source) -> void {
        while (target.length > 0) {
            target.remove_at(target.length - 1);
        }
        let i = 0;
        while (i < source.length) {
            target.append(source[i]);
            i = i + 1;
        }
    };
);
