let int_map = import:Std.Collections.IntMap;
let map_model = import:MapModel;

// Seeded model-based tests (Stdlib.md section 17): 10,000 operations
// against an association list in insertion order, calling validate() after
// every operation.
let IntMapModelTests = module (
    let identity = func(id: int) -> int {
        return id;
    };

    export let test_model = func() -> void {
        let map = int_map.create<int>();
        map_model.run<int>(map, identity, map.validate, map.trim, false, 21, 10000, 24, 160);
    };

    // Negative keys and keys that differ only in high bits.
    export let test_model_spread_keys = func() -> void {
        let map = int_map.with_capacity<int>(10);
        map_model.run<int>(map, func(id: int) -> int {
            return (id - 20) * 65536;
        }, map.validate, map.trim, false, 22, 3000, 24, 80);
    };
);
