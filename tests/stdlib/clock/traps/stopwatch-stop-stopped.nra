// status: 134
// stderr: explicit program failure \(trap reason 3\): invalid state: stopwatch is stopped
let console = import:Std.Io.Console;
let duration = import:Std.Time.Duration;
let fixed_clock = import:Std.Time.FixedClock;
let instant = import:Std.Time.Instant;
let program = import:Std.Program;
let result = import:Std.Core.Result;
let stopwatch = import:Std.Time.Stopwatch;
let unit = import:Std.Core.Unit;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let watch = stopwatch.create(fixed_clock.of(instant.Epoch));
        console.print_line("before");
        result.expect<unit.Unit>(watch.stop(), "stop");
        return program.ExitCode.Ok;
    };
);
