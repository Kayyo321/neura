// status: 70
// stderr: explicit program failure \(trap reason 3\): invalid state: stopwatch is running
let console = import:Std.Io.Console;
let duration = import:Std.Time.Duration;
let fixed_clock = import:Std.Time.FixedClock;
let instant = import:Std.Time.Instant;
let program = import:Std.Program;
let result = import:Std.Core.Result;
let stopwatch = import:Std.Time.Stopwatch;
let unit = import:Std.Core.Unit;

export let Main = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        let watch = stopwatch.create(fixed_clock.of(instant.Epoch));
        result.expect<unit.Unit>(watch.start(), "start");
        console.print_line("before");
        result.expect<unit.Unit>(watch.start(), "start again");
        return program.ExitCode.Ok;
    };
);
