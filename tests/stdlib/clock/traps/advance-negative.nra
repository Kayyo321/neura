// status: 134
// stderr: explicit program failure \(trap reason 3\): invalid argument: negative duration
let console = import:Std.Io.Console;
let duration = import:Std.Time.Duration;
let fixed_clock = import:Std.Time.FixedClock;
let instant = import:Std.Time.Instant;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let fixed = fixed_clock.of(instant.Epoch);
        console.print_line("before");
        fixed.advance(duration.of_nanos(-1));
        return program.ExitCode.Ok;
    };
);
