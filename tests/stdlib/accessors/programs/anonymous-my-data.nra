// The accessor example of Types.md, Accessors, exactly as the language owner
// specified it: an anonymous class whose fields have accessors, two of them
// without a type annotation. Only the trap call is filled in.
let console = import:Std.Io.Console;
let program = import:Std.Program;
let failure = import:Std.Core.Failure;

let my_data: class (
    export let data: string = "";
        | set: data = value;
        | get: data;

    export let code = "XY729H08";
        | get: code;

    export let non_zero = 18000;
        | get: non_zero;
        | set: {
            if (value == 0) {
                failure.trap("non_zero must not be zero");
            }
            non_zero = value;
        };
) = new;

let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        my_data.data = "payload";
        let my_var = my_data.data;
        console.print_line(my_var);
        let v = my_data.code;
        console.print_line(v);
        console.print_line(my_data.non_zero.to_string());
        my_data.non_zero = 7;
        my_data.non_zero *= 3;
        my_data.non_zero++;
        console.print_line(my_data.non_zero.to_string());
        return program.ExitCode.Ok;
    };
);
