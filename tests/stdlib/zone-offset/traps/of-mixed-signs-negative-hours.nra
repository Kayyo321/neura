// status: 70
// stderr: explicit program failure \(trap reason 3\): invalid argument: invalid zone offset
let console = import:Std.Io.Console;
let program = import:Std.Program;
let zone_offset = import:Std.Time.ZoneOffset;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line(zone_offset.of_hours_minutes(-5, 30).to_string());
        return program.ExitCode.Ok;
    };
);
