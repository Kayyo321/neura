// status: 70
// stderr: explicit program failure \(trap reason 3\): invalid argument: unscaled value is nil
let big = import:Std.Math.BigInteger;
let console = import:Std.Io.Console;
let decimals = import:Std.Math.BigDecimal;
let program = import:Std.Program;
let result = import:Std.Core.Result;

export let Main = module:program.Entry (
    let zero: float64 = 0.0;

    let of = func(text: string) -> decimals.BigDecimal {
        return result.expect<decimals.BigDecimal>(decimals.parse(text), text);
    };

    let missing = func() -> big.BigInteger {
        return nil;
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line("before");
        console.print_line(decimals.of_big_integer(missing(), 2).to_string());
        console.print_line("unreachable");
        return program.ExitCode.Ok;
    };
);
