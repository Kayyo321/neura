let big = import:Std.Math.BigInteger;
let comparable = import:Std.Core.Comparable;
let decimals = import:Std.Math.BigDecimal;
let error = import:Std.Core.Error;
let ordering = import:Std.Core.Ordering;
let result = import:Std.Core.Result;
let test = import:Std.Test;

// BigDecimal members with literal expectations (Stdlib.md section 10.3).
let BigDecimalTests = module (
    let of = func(string text) -> decimals.BigDecimal {
        return result.expect<decimals.BigDecimal>(decimals.parse(text), text);
    };

    let check = func(string expected, decimals.BigDecimal actual) -> void {
        test.assert_equal_string(expected, actual.to_string());
    };

    let parse_failure = func(string text, error.ParseErrorKind kind, int offset) -> void {
        match (test.assert_err<decimals.BigDecimal>(decimals.parse(text))) {
            error.Error.Parse { kind: actual_kind, offset: actual_offset, message: _ } => {
                test.assert_equal_string(kind.to_string(), actual_kind.to_string());
                test.assert_equal_int32(offset, actual_offset);
            },
            _ => {
                test.fail("expected a parse error");
            },
        }
    };

    let larger = func<T: comparable.Comparable<T>>(T a, T b) -> T {
        if (a.compare_to(b) == ordering.Ordering.Less) {
            return b;
        }
        return a;
    };

    export let test_rounding_mode_order = func() -> void {
        test.assert_equal_int32(0, decimals.RoundingMode.Up as int);
        test.assert_equal_int32(1, decimals.RoundingMode.Down as int);
        test.assert_equal_int32(2, decimals.RoundingMode.Ceiling as int);
        test.assert_equal_int32(3, decimals.RoundingMode.Floor as int);
        test.assert_equal_int32(4, decimals.RoundingMode.HalfUp as int);
        test.assert_equal_int32(5, decimals.RoundingMode.HalfDown as int);
        test.assert_equal_int32(6, decimals.RoundingMode.HalfEven as int);
        test.assert_equal_string("HalfEven", decimals.RoundingMode.HalfEven.to_string());
    };

    export let test_factories_and_accessors = func() -> void {
        check("-42", decimals.of_int64(-42));
        test.assert_equal_int32(0, decimals.of_int64(7).scale());
        let value = decimals.of_big_integer(big.of_int64(12345), 3);
        check("12.345", value);
        test.assert_equal_int32(3, value.scale());
        test.assert_equal_string("12345", value.unscaled().to_string());
        check("123450000", decimals.of_big_integer(big.of_int64(12345), -4));
        check("0.000", decimals.of_big_integer(big.Zero, 3));
        check("0.5", decimals.of_float64(0.5));
        check("2", decimals.of_float64(2.0));
        check("0", decimals.of_float64(-0.0));
        check("-0.125", decimals.of_float64(-0.125));
        test.assert_equal_int32(1074, decimals.of_float64(5.0e-324).scale());
    };

    export let test_parse_and_text = func() -> void {
        check("1.50", of("+1.50"));
        check("0.5", of(".5"));
        check("5", of("5."));
        check("0.00", of("-0.00"));
        check("1000", of("1E+3"));
        check("1000", of("1e3"));
        check("0.00123", of("1.23e-3"));
        check("0.0123", of("123E-4"));
        check("-12.5", of("-1.25e1"));
        check("0", of("0e5"));
        check("0", of("0E+1"));
        check("0", of("-0e3"));
        test.assert_equal_int32(-3, of("1E+3").scale());
        test.assert_equal_int32(2, of("0.00").scale());
        check("12345678901234567890.123456789", of("12345678901234567890.123456789"));
    };

    export let test_parse_errors = func() -> void {
        parse_failure("", error.ParseErrorKind.Empty, 0);
        parse_failure("-", error.ParseErrorKind.UnexpectedEnd, 1);
        parse_failure(".", error.ParseErrorKind.UnexpectedEnd, 1);
        parse_failure("1e", error.ParseErrorKind.UnexpectedEnd, 2);
        parse_failure("1e+", error.ParseErrorKind.UnexpectedEnd, 3);
        parse_failure("1.2.3", error.ParseErrorKind.InvalidCharacter, 3);
        parse_failure("a", error.ParseErrorKind.InvalidCharacter, 0);
        parse_failure(" 1", error.ParseErrorKind.InvalidCharacter, 0);
        parse_failure("1,5", error.ParseErrorKind.InvalidCharacter, 1);
        parse_failure(".e5", error.ParseErrorKind.InvalidCharacter, 1);
        parse_failure("1e5x", error.ParseErrorKind.InvalidCharacter, 3);
        parse_failure("1ex", error.ParseErrorKind.InvalidCharacter, 2);
        parse_failure("1e-2147483648", error.ParseErrorKind.OutOfRange, 0);
        parse_failure("1e99999999999999999999", error.ParseErrorKind.OutOfRange, 0);
        test.assert_equal_string("parse error at 1: invalid character",
            error.message(test.assert_err<decimals.BigDecimal>(decimals.parse("1x"))));
        check("1", of("1e-0"));
        check("10", of("1e000000000000000000001"));
    };

    export let test_arithmetic = func() -> void {
        check("3.75", of("1.5").add(of("2.25")));
        check("-0.75", of("1.5").subtract(of("2.25")));
        check("3.375", of("1.5").multiply(of("2.25")));
        check("100.1", of("1E+2").add(of("0.1")));
        check("0.0", of("1.5").add(of("-1.5")));
        check("0.33", of("1").divide(of("3"), 2, decimals.RoundingMode.HalfUp));
        check("0.34", of("1").divide(of("3"), 2, decimals.RoundingMode.Up));
        check("0", of("0").divide(of("3"), -1, decimals.RoundingMode.Up));
        check("120", of("1234").divide(of("10"), -1, decimals.RoundingMode.HalfUp));
        check("-0.333", of("1").divide(of("-3"), 3, decimals.RoundingMode.HalfEven));
        check("0", of("0").divide(of("3"), 0, decimals.RoundingMode.Up));
        check("1.4", of("1.5").pow(1).subtract(of("0.1")));
        check("1", of("2.50").pow(0));
        check("6.25", of("-2.5").pow(2));
        check("2.5", of("-2.5").abs());
        check("2.5", of("-2.5").negate());
        test.assert_equal_int32(-1, of("-0.1").sign());
        test.assert_equal_int32(0, of("0.000").sign());
        test.assert_equal_int32(1, of("1E+5").sign());
    };

    export let test_rounding_modes_on_halves = func() -> void {
        // value: 2.5, -2.5, 1.5, -1.5, 2.6, -2.4
        let values: string[] = ["2.5", "-2.5", "1.5", "-1.5", "2.6", "-2.4"];
        let expected: string[] = [
            "3", "-3", "2", "-2", "3", "-3", // Up
            "2", "-2", "1", "-1", "2", "-2", // Down
            "3", "-2", "2", "-1", "3", "-2", // Ceiling
            "2", "-3", "1", "-2", "2", "-3", // Floor
            "3", "-3", "2", "-2", "3", "-2", // HalfUp
            "2", "-2", "1", "-1", "3", "-2", // HalfDown
            "2", "-2", "2", "-2", "3", "-2" // HalfEven
        ];
        let modes: decimals.RoundingMode[] = [
            decimals.RoundingMode.Up, decimals.RoundingMode.Down, decimals.RoundingMode.Ceiling,
            decimals.RoundingMode.Floor, decimals.RoundingMode.HalfUp, decimals.RoundingMode.HalfDown,
            decimals.RoundingMode.HalfEven
        ];
        for (let m = 0; m < 7; m = m + 1) {
            for (let v = 0; v < 6; v = v + 1) {
                let value = of(values[v]);
                check(expected[m * 6 + v], value.set_scale(0, modes[m]));
                test.assert_equal_string(expected[m * 6 + v], value.to_big_integer(modes[m]).to_string());
            }
        }
    };

    export let test_scale_round_strip = func() -> void {
        check("1.500", of("1.5").set_scale(3, decimals.RoundingMode.Down));
        check("2", of("1.5").set_scale(0, decimals.RoundingMode.HalfEven));
        check("0", of("0.000001").set_scale(2, decimals.RoundingMode.HalfUp).set_scale(0, decimals.RoundingMode.Up));
        check("0.01", of("0.000001").set_scale(2, decimals.RoundingMode.Up));
        check("-0.01", of("-0.000001").set_scale(2, decimals.RoundingMode.Floor));
        check("0", of("1E-1000").set_scale(0, decimals.RoundingMode.HalfUp));
        check("1", of("1E-1000").set_scale(0, decimals.RoundingMode.Ceiling));
        check("1000", of("999.9").round(3, decimals.RoundingMode.HalfUp));
        test.assert_equal_int32(-1, of("999.9").round(3, decimals.RoundingMode.HalfUp).scale());
        check("123.4567", of("123.4567").round(0, decimals.RoundingMode.Up));
        check("123.4567", of("123.4567").round(7, decimals.RoundingMode.Up));
        check("123.46", of("123.4567").round(5, decimals.RoundingMode.HalfEven));
        check("0.0012", of("0.0012345").round(2, decimals.RoundingMode.HalfDown));
        check("12.345", of("12.3450000").strip_trailing_zeros());
        check("1200", of("1200.00").strip_trailing_zeros());
        test.assert_equal_int32(-2, of("1200.00").strip_trailing_zeros().scale());
        check("0", of("0.000").strip_trailing_zeros());
        test.assert_equal_int32(0, of("0.000").strip_trailing_zeros().scale());
    };

    export let test_compare_equals_hash = func() -> void {
        test.assert(of("2.0").equals(of("2.00")));
        test.assert(of("2.0").compare_to(of("2.00")) == ordering.Ordering.Equal);
        test.assert_equal_uint64(of("2.0").hash_code() as uint64, of("2.00").hash_code() as uint64);
        test.assert_equal_uint64(of("0").hash_code() as uint64, of("0.000").hash_code() as uint64);
        // combine(combine(17, hash(2)), hash(0)) = 31 * (31 * 17 + 2) = 16399
        test.assert_equal_uint64(16399, of("2.00").hash_code() as uint64);
        test.assert(!of("2.0").equals(of("2.01")));
        test.assert(!of("2").equals(big.Ten));
        test.assert(!of("2").equals(nil));
        test.assert(of("1E-100").compare_to(of("1E+100")) == ordering.Ordering.Less);
        test.assert(of("-1E-50").compare_to(of("-2E-50")) == ordering.Ordering.Greater);
        test.assert(of("1.0").compare_to(of("1.000000000000000000000000000001")) == ordering.Ordering.Less);
        test.assert(of("-0.1").compare_to(of("0")) == ordering.Ordering.Less);
        test.assert(of("0.00").compare_to(of("0E+5")) == ordering.Ordering.Equal);
        check("3.1", larger<decimals.BigDecimal>(of("3.1"), of("-7")));
    };

    export let test_float_conversions = func() -> void {
        test.assert_equal_float64(0.0, of("0.000").to_float64());
        test.assert_equal_float64(0.1, of("0.1").to_float64());
        test.assert_equal_float64(-1.5, of("-15E-1").to_float64());
        test.assert_equal_float64(1.0e22, of("1E+22").to_float64());
        test.assert_equal_float64(0.0, of("1E-500").to_float64());
        test.assert_equal_float64(-0.0, of("-1E-500").to_float64());
        let infinity = of("1E+500").to_float64();
        test.assert(infinity > 1.0e308 && infinity == infinity * 2.0);
        test.assert(of("-1E+500").to_float64() < -1.0e308);
        check("0.1000000000000000055511151231257827021181583404541015625", decimals.of_float64(0.1));
        check("100000000000000000000", decimals.of_float64(1.0e20));
    };
);
