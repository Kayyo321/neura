let big = import:Std.Math.BigInteger;
let decimals = import:Std.Math.BigDecimal;
let int32s = import:Std.Core.Int32;
let ordering = import:Std.Core.Ordering;
let result = import:Std.Core.Result;
let test = import:Std.Test;
let uint64s = import:Std.Core.UInt64;
let vectors = import:BigDecimalVectors;

// BigDecimal against checked-in reference results computed with Python's
// decimal and fractions modules (support/big-decimal-vectors.nra,
// generated by vectors/generate.py). Inputs are parsed from Python's text
// forms; results are compared as plain text, which fixes the scale too.
let BigDecimalReferenceTests = module (
    let of = func(text: string) -> decimals.BigDecimal {
        return result.expect<decimals.BigDecimal>(decimals.parse(text), text);
    };

    let number = func(text: string) -> int {
        return result.expect<int32>(int32s.parse(text), text);
    };

    let mode = func(text: string) -> decimals.RoundingMode {
        let modes: decimals.RoundingMode[] = [
            decimals.RoundingMode.Up, decimals.RoundingMode.Down, decimals.RoundingMode.Ceiling,
            decimals.RoundingMode.Floor, decimals.RoundingMode.HalfUp, decimals.RoundingMode.HalfDown,
            decimals.RoundingMode.HalfEven
        ];
        return modes[number(text)];
    };

    let ordinal = func(o: ordering.Ordering) -> int {
        if (o == ordering.Ordering.Less) {
            return 0;
        }
        if (o == ordering.Ordering.Equal) {
            return 1;
        }
        return 2;
    };

    let same = func(what: string, expected: string, actual: decimals.BigDecimal) -> void {
        let text = actual.to_string();
        if (text != expected) {
            test.fail(what + ": expected <" + expected + ">, got <" + text + ">");
        }
    };

    export let test_arithmetic_compare_hash = func() -> void {
        let cases = vectors.arithmetic_cases();
        let i = 0;
        while (i < cases.length) {
            let a = of(cases[i]);
            let b = of(cases[i + 1]);
            same(cases[i] + " + " + cases[i + 1], cases[i + 2], a.add(b));
            same(cases[i] + " - " + cases[i + 1], cases[i + 3], a.subtract(b));
            same(cases[i] + " * " + cases[i + 1], cases[i + 4], a.multiply(b));
            test.assert_equal_int32(number(cases[i + 5]), ordinal(a.compare_to(b)));
            test.assert_equal_bool(number(cases[i + 5]) == 1, a.equals(b));
            test.assert_equal_uint64(result.expect<uint64>(uint64s.parse(cases[i + 6]), "hash"), a.hash_code() as uint64);
            i = i + 7;
        }
        test.assert(i > 700);
    };

    export let test_divide = func() -> void {
        let cases = vectors.divide_cases();
        let i = 0;
        while (i < cases.length) {
            let a = of(cases[i]);
            let b = of(cases[i + 1]);
            let quotient = a.divide(b, number(cases[i + 2]), mode(cases[i + 3]));
            same(cases[i] + " / " + cases[i + 1] + " mode " + cases[i + 3], cases[i + 4], quotient);
            i = i + 5;
        }
    };

    export let test_set_scale = func() -> void {
        let cases = vectors.set_scale_cases();
        let i = 0;
        while (i < cases.length) {
            let a = of(cases[i]);
            same("set_scale " + cases[i] + " " + cases[i + 1] + " mode " + cases[i + 2], cases[i + 3],
                a.set_scale(number(cases[i + 1]), mode(cases[i + 2])));
            i = i + 4;
        }
    };

    export let test_round = func() -> void {
        let cases = vectors.round_cases();
        let i = 0;
        while (i < cases.length) {
            let a = of(cases[i]);
            same("round " + cases[i] + " " + cases[i + 1] + " mode " + cases[i + 2], cases[i + 3],
                a.round(number(cases[i + 1]), mode(cases[i + 2])));
            i = i + 4;
        }
    };

    export let test_to_big_integer = func() -> void {
        let cases = vectors.to_big_integer_cases();
        let i = 0;
        while (i < cases.length) {
            let a = of(cases[i]);
            test.assert_equal_string(cases[i + 2], a.to_big_integer(mode(cases[i + 1])).to_string());
            i = i + 3;
        }
    };

    export let test_unary = func() -> void {
        let cases = vectors.unary_cases();
        let i = 0;
        while (i < cases.length) {
            let a = of(cases[i]);
            same("strip " + cases[i], cases[i + 1], a.strip_trailing_zeros());
            same("pow " + cases[i] + " " + cases[i + 2], cases[i + 3], a.pow(number(cases[i + 2])));
            same("negate " + cases[i], cases[i + 4], a.negate());
            same("abs " + cases[i], cases[i + 5], a.abs());
            test.assert(a.strip_trailing_zeros().equals(a));
            test.assert_equal_uint64(a.hash_code() as uint64, a.strip_trailing_zeros().hash_code() as uint64);
            i = i + 6;
        }
    };

    export let test_to_float64 = func() -> void {
        let cases = vectors.to_float64_cases();
        let i = 0;
        while (i < cases.length) {
            let bits = result.expect<uint64>(uint64s.parse(cases[i + 1]), "bits");
            let actual = of(cases[i]).to_float64().to_bits();
            if (actual != bits) {
                test.fail("to_float64 " + cases[i] + ": expected bits " + cases[i + 1] + ", got " + actual.to_string());
            }
            i = i + 2;
        }
    };

    export let test_of_float64 = func() -> void {
        let cases = vectors.of_float64_cases();
        let i = 0;
        while (i < cases.length) {
            let v = float64.from_bits(result.expect<uint64>(uint64s.parse(cases[i]), "bits"));
            let exact = decimals.of_float64(v);
            same("of_float64 " + v.to_string(), cases[i + 1], exact);
            test.assert_equal_float64(v + 0.0, exact.to_float64());
            i = i + 2;
        }
    };
);
