    // Consecutive days across the 400-year cycle's turns: each epoch day
    // converts back, the weekday advances by one, and the date is the
    // previous date's successor.
    export let test_consecutive_days = func() -> void {
        let starts: int64[] = [-719529, -146097, -36525, 10957, 11016, -365961662, 364522600];
        for (let start in starts) {
            let previous = local_date.of_epoch_day(start);
            for (let e = start + 1; e < start + 370; e = e + 1) {
                let date = local_date.of_epoch_day(e);
                test.assert_equal_int64(e, date.to_epoch_day());
                test.assert_equal_int32(((previous.day_of_week() as int) + 1) % 7, date.day_of_week() as int);
                if (date.day == 1) {
                    test.assert_equal_int32(previous.length_of_month(), previous.day);
                    if (date.month == 1) {
                        test.assert_equal_int32(previous.year + 1, date.year);
                        test.assert_equal_int32(12, previous.month);
                        test.assert_equal_int32(1, date.day_of_year());
                    } else {
                        test.assert_equal_int32(previous.month + 1, date.month);
                    }
                } else {
                    test.assert_equal_int32(previous.day + 1, date.day);
                    test.assert_equal_int32(previous.day_of_year() + 1, date.day_of_year());
                }
                previous = date;
            }
        }
    };

    // Round trips through the whole range in steps that visit every
    // position of the cycle's leap pattern.
    export let test_sweep = func() -> void {
        let e: int64 = -365961662;
        while (e <= 364522971) {
            let date = local_date.of_epoch_day(e);
            test.assert_equal_int64(e, local_date.of(date.year, date.month, date.day).to_epoch_day());
            e = e + 182623;
        }
    };

    export let test_of_and_try_of = func() -> void {
        let date = local_date.of(2024, 2, 29);
        test.assert_equal_int32(2024, date.year);
        test.assert(local_date.try_of(2024, 2, 29).equals(date));
        test.assert(local_date.try_of(2023, 2, 29) == nil);
        test.assert(local_date.try_of(2024, 13, 1) == nil);
        test.assert(local_date.try_of(2024, 0, 1) == nil);
        test.assert(local_date.try_of(2024, 4, 31) == nil);
        test.assert(local_date.try_of(2024, 4, 0) == nil);
        test.assert(local_date.try_of(1000000, 1, 1) == nil);
        test.assert(local_date.try_of(-1000000, 1, 1) == nil);
        test.assert(local_date.try_of(1900, 2, 29) == nil);
        test.assert(local_date.try_of(2000, 2, 29) != nil);
        test.assert(local_date.try_of(-4, 2, 29) != nil);
        test.assert(local_date.try_of(-100, 2, 29) == nil);
        test.assert(local_date.try_of(999999, 12, 31) != nil);
        test.assert(local_date.try_of(-999999, 1, 1) != nil);
    };

    export let test_clamping = func() -> void {
        let end = local_date.of(2024, 1, 31);
        test.assert_equal_string("2024-02-29", end.plus_months(1).to_string());
        test.assert_equal_string("2023-02-28", end.plus_months(-11).to_string());
        test.assert_equal_string("2024-04-30", end.plus_months(3).to_string());
        test.assert_equal_string("2025-01-31", end.plus_months(12).to_string());
        let leap = local_date.of(2024, 2, 29);
        test.assert_equal_string("2025-02-28", leap.plus_years(1).to_string());
        test.assert_equal_string("2028-02-29", leap.plus_years(4).to_string());
        test.assert_equal_string("1900-02-28", leap.plus_years(-124).to_string());
        test.assert_equal_string("-0001-02-28", local_date.of(0, 2, 29).plus_years(-1).to_string());
        test.assert_equal_string("2024-02-29", leap.plus_days(0).to_string());
        test.assert_equal_string("+999999-12-31", local_date.of(999999, 11, 30).plus_days(31).to_string());
    };

    export let test_text = func() -> void {
        test.assert_equal_string("0000-01-01", local_date.of(0, 1, 1).to_string());
        test.assert_equal_string("-0001-12-31", local_date.of(-1, 12, 31).to_string());
        test.assert_equal_string("-10000-01-01", local_date.of(-10000, 1, 1).to_string());
        test.assert_equal_string("9999-12-31", local_date.of(9999, 12, 31).to_string());
        test.assert_equal_string("+10000-01-01", local_date.of(10000, 1, 1).to_string());
        test.assert_equal_string("0987-06-05", local_date.of(987, 6, 5).to_string());
    };

    export let test_parse = func() -> void {
        test.assert(test.assert_ok<local_date.LocalDate>(local_date.parse("+2024-02-29")).equals(local_date.of(2024, 2, 29)));
        test.assert(test.assert_ok<local_date.LocalDate>(local_date.parse("-0000-01-01")).equals(local_date.of(0, 1, 1)));
        test.assert(test.assert_ok<local_date.LocalDate>(local_date.parse("+0999999-12-31")).equals(local_date.of(999999, 12, 31)));
        check_error("", error.ParseErrorKind.Empty, 0);
        check_error("2024", error.ParseErrorKind.UnexpectedEnd, 4);
        check_error("2024-02-2", error.ParseErrorKind.UnexpectedEnd, 9);
        check_error("+", error.ParseErrorKind.UnexpectedEnd, 1);
        check_error("+123", error.ParseErrorKind.UnexpectedEnd, 4);
        check_error("202a-01-01", error.ParseErrorKind.InvalidCharacter, 3);
        check_error("2024/01/01", error.ParseErrorKind.InvalidCharacter, 4);
        check_error("12024-01-01", error.ParseErrorKind.InvalidCharacter, 4);
        check_error("+123-01-01", error.ParseErrorKind.InvalidCharacter, 4);
        check_error(" 2024-01-01", error.ParseErrorKind.InvalidCharacter, 0);
        check_error("2024-01-01T", error.ParseErrorKind.InvalidCharacter, 10);
        check_error("2024-01-1x", error.ParseErrorKind.InvalidCharacter, 9);
        check_error("+1000000-01-01", error.ParseErrorKind.OutOfRange, 0);
        check_error("-99999999999999999999999-01-01", error.ParseErrorKind.OutOfRange, 0);
        check_error("2024-13-01", error.ParseErrorKind.OutOfRange, 5);
        check_error("2024-00-01", error.ParseErrorKind.OutOfRange, 5);
        check_error("2023-02-29", error.ParseErrorKind.OutOfRange, 8);
        check_error("2024-04-31", error.ParseErrorKind.OutOfRange, 8);
        check_error("2024-04-00", error.ParseErrorKind.OutOfRange, 8);
        check_error("2024-13-45x", error.ParseErrorKind.OutOfRange, 5);
        let failure = test.assert_err<local_date.LocalDate>(local_date.parse("2023-02-29"));
        test.assert_equal_string("parse error at 8: day out of range", error.message(failure));
    };

    export let test_order_and_equality = func() -> void {
        let a = local_date.of(2024, 3, 1);
        let b = local_date.of_epoch_day(a.to_epoch_day());
        test.assert(a.equals(b) && a != b && a.hash_code() == b.hash_code());
        let expected = hashing.combine(hashing.combine(hashing.combine(17, 2024), 3), 1);
        test.assert(a.hash_code() == expected);
        test.assert(!a.equals(nil) && !a.equals(local_date.of(2024, 3, 2)));
        test.assert(a.compare_to(b) == ordering.Ordering.Equal);
        test.assert(a.compare_to(local_date.of(2024, 3, 2)) == ordering.Ordering.Less);
        test.assert(a.compare_to(local_date.of(2024, 2, 29)) == ordering.Ordering.Greater);
        test.assert(a.compare_to(local_date.of(-2025, 12, 31)) == ordering.Ordering.Greater);
        test.assert(a.compare_to(local_date.of(2025, 1, 1)) == ordering.Ordering.Less);
    };

    export let test_day_of_week_module = func() -> void {
        test.assert(weekdays.of_ordinal(0) == weekdays.DayOfWeek.Monday);
        test.assert(weekdays.of_ordinal(6) == weekdays.DayOfWeek.Sunday);
        test.assert(weekdays.plus(weekdays.DayOfWeek.Sunday, 1) == weekdays.DayOfWeek.Monday);
        test.assert(weekdays.plus(weekdays.DayOfWeek.Monday, -1) == weekdays.DayOfWeek.Sunday);
        test.assert(weekdays.plus(weekdays.DayOfWeek.Thursday, 0) == weekdays.DayOfWeek.Thursday);
        test.assert(weekdays.plus(weekdays.DayOfWeek.Wednesday, -9223372036854775807 - 1) == weekdays.DayOfWeek.Tuesday);
        test.assert(weekdays.plus(weekdays.DayOfWeek.Wednesday, 9223372036854775807) == weekdays.DayOfWeek.Wednesday);
        test.assert_equal_string("Friday", weekdays.DayOfWeek.Friday.to_string());
    };
);
