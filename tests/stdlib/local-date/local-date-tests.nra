let error = import:Std.Core.Error;
let hashing = import:Std.Core.Hash;
let local_date = import:Std.Time.LocalDate;
let ordering = import:Std.Core.Ordering;
let test = import:Std.Test;
let weekdays = import:Std.Time.DayOfWeek;

let LocalDateTests = module (
    // Expected values computed with Python: datetime for the date of the
    // same position in the 400-year cycle, shifted by whole cycles.
    let check_day = func(epoch_day: int64, year: int, month: int, day: int, weekday: weekdays.DayOfWeek, day_of_year: int,
            leap: bool, month_length: int, text: string) -> void {
        let date = local_date.of_epoch_day(epoch_day);
        test.assert_equal_int32(year, date.year);
        test.assert_equal_int32(month, date.month);
        test.assert_equal_int32(day, date.day);
        test.assert_equal_int64(epoch_day, local_date.of(year, month, day).to_epoch_day());
        test.assert_equal_string(weekday.to_string(), date.day_of_week().to_string());
        test.assert_equal_int32(day_of_year, date.day_of_year());
        test.assert_equal_bool(leap, date.is_leap_year());
        test.assert_equal_int32(month_length, date.length_of_month());
        test.assert_equal_string(text, date.to_string());
        test.assert(test.assert_ok<local_date.LocalDate>(local_date.parse(text)).equals(date));
    };

    let check_shift = func(year: int, month: int, day: int, months: int64, months_text: string, years: int64, years_text: string,
            days: int64, days_text: string, until: int64) -> void {
        let date = local_date.of(year, month, day);
        test.assert_equal_string(months_text, date.plus_months(months).to_string());
        test.assert_equal_string(years_text, date.plus_years(years).to_string());
        test.assert_equal_string(days_text, date.plus_days(days).to_string());
        let other = date.plus_days(until);
        test.assert_equal_int64(until, date.days_until(other));
        test.assert_equal_int64(-until, other.days_until(date));
    };

    let check_error = func(text: string, kind: error.ParseErrorKind, offset: int) -> void {
        let failure = test.assert_err<local_date.LocalDate>(local_date.parse(text));
        match (failure) {
            error.Error.Parse { kind: actual, offset: at, message: _ } => {
                test.assert_equal_string(kind.to_string(), actual.to_string());
                test.assert_equal_int32(offset, at);
            },
            _ => {
                test.fail("expected a parse error for " + text);
            },
        }
    };

