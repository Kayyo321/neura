// status: 70
// stderr: explicit program failure \(trap reason 3\): invalid argument: date out of range
let console = import:Std.Io.Console;
let local_date = import:Std.Time.LocalDate;
let program = import:Std.Program;

export let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let last = local_date.of(999999, 12, 31);
        console.print_line("before");
        console.print_line(last.plus_days(1).to_string());
        return program.ExitCode.Ok;
    };
);
