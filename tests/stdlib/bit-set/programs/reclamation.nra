// run-options: --max-heap-cells 20000
let bit_set = import:Std.Collections.BitSet;
let console = import:Std.Io.Console;
let program = import:Std.Program;

// Each round grows the set to about 1,000 words and clears it. If cleared
// word lists stayed reachable the 100 rounds would need about 100,000
// cells, far above the limit.
export let Main = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        let items = bit_set.create();
        let total = 0;
        let round = 0;
        while (round < 100) {
            items.add(round);
            items.add(32000 + round);
            total = total + items.size() + items.next_set(round + 1);
            if (round % 2 == 0) {
                items.clear();
            } else {
                items.intersect_with(bit_set.create());
                items = bit_set.create();
            }
            round = round + 1;
        }
        console.print_line(items.size().to_string() + " " + total.to_string());
        return program.ExitCode.Ok;
    };
);
