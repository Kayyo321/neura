// The server image of tests/server/server_host_test.py.
let app = import:Std.App;
let errors = import:Std.Core.Error;
let optional = import:Std.Core.Optional;
let program = import:Std.Program;
let int32 = import:Std.Core.Int32;
let results = import:Std.Core.Result;
let system_clock = import:Std.Time.SystemClock;
let.promote _ = import:Std.Core.Result;
let.promote _ = import:Std.Core.Unit;
let.promote _ = import:Std.Time.Duration;

let TestServer = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode => app.run(serve);

    /// @brief Serves the test routes. The startup check fails when the configuration says so.
    let serve = func(context: app.Context) -> Result<Unit> {
        last refuse = optional.value_or<string>(context.config("refuse_startup"), "no");
        if (refuse == "yes") {
            return Result<Unit>.Err(errors.custom("test.refuse", "configured to refuse"));
        }
        if (optional.value_or<string>(context.config("streamed_body"), "no") == "yes") {
            return context.serve_streamed(app.streaming_handler_of(
                new func(request: app.Request, body: app.BodyReader) -> Result<app.Response> =>
                    upload(context, request, body)));
        }
        return context.serve(app.handler_of(new func(request: app.Request) -> Result<app.Response> =>
            route(context, request)));
    };

    /// @brief Counts the body as it arrives, in reads of at most 1,000 bytes, and answers the count and the
    /// number of reads. /early answers before reading anything.
    let upload = func(context: app.Context, request: app.Request, body: app.BodyReader) -> Result<app.Response> {
        if (request.path == "/early") {
            return Result<app.Response>.Ok(app.text(200, "early\n"));
        }
        let total = 0;
        let reads = 0;
        while (true) {
            match (body.read(1000)) {
                Result.Err(problem) => {
                    return Result<app.Response>.Err(problem);
                },
                Result.Ok(chunk) => {
                    if (chunk.length == 0) {
                        return Result<app.Response>.Ok(app.text(200, "received " + total.to_string() + " in "
                            + reads.to_string() + " reads\n"));
                    }
                    total += chunk.length;
                    reads++;
                },
            }
        }
        return Result<app.Response>.Ok(app.text(500, "unreachable\n"));
    };

    /// @brief The test routes.
    let route = func(context: app.Context, request: app.Request) -> Result<app.Response> {
        if (request.path == "/hello") {
            return Result<app.Response>.Ok(app.text(200, "hello from " + request.scheme + "\n"));
        }
        if (request.path == "/echo" && request.method == "POST") {
            last kind = optional.value_or<string>(request.header("content-type"), "application/octet-stream");
            last fields: [string, string][list] = new;
            fields.append(["Content-Type", kind]);
            fields.append(["X-Body-Length", request.body.length.to_string()]);
            return Result<app.Response>.Ok(new app.Response(201, fields, request.body));
        }
        if (request.path == "/config") {
            return match (context.config(request.query)) {
                optional.Optional.Some(value) => Result<app.Response>.Ok(app.text(200, value)),
                optional.Optional.None => Result<app.Response>.Ok(app.text(404, "unset")),
            };
        }
        if (request.path == "/info") {
            return Result<app.Response>.Ok(app.json(200, "{\"method\":\"" + request.method + "\",\"query\":\""
                + request.query + "\",\"client\":\"" + request.client + "\",\"id\":\"" + request.request_id + "\"}"));
        }
        if (request.path == "/sleep") {
            last clock = new system_clock.SystemClock();
            match (clock.sleep(of_millis(60000))) {
                Result.Ok(_) => {},
                Result.Err(_) => {},
            }
            return Result<app.Response>.Ok(app.text(200, "woke\n"));
        }
        if (request.path == "/nap") {
            last clock = new system_clock.SystemClock();
            match (clock.sleep(of_millis(1000))) {
                Result.Ok(_) => {},
                Result.Err(_) => {},
            }
            return Result<app.Response>.Ok(app.text(200, "rested\n"));
        }
        if (request.path == "/big") {
            last size = results.value_or<int32>(int32.parse(request.query), 0);
            last content: uint8[list] = new;
            for (let i = 0; i < size; i++) {
                content.append(120 as uint8);
            }
            return Result<app.Response>.Ok(new app.Response(200, new, content));
        }
        if (request.path == "/spin") {
            last rounds = results.value_or<int32>(int32.parse(request.query), 0);
            let total = 0;
            for (let i = 0; i < rounds; i++) {
                total += i % 7;
            }
            return Result<app.Response>.Ok(app.text(200, "spun " + total.to_string() + "\n"));
        }
        if (request.path == "/stream") {
            // query: chunk count; each chunk is 1,000 bytes; one pause of 300 ms after the first.
            last count = results.value_or<int32>(int32.parse(request.query), 0);
            last fields: [string, string][list] = new;
            fields.append(["Content-Type", "application/octet-stream"]);
            return Result<app.Response>.Ok(app.stream(200, fields, new func(writer: app.BodyWriter) -> Result<Unit> {
                last chunk: uint8[list] = new;
                for (let i = 0; i < 1000; i++) {
                    chunk.append(97 as uint8);
                }
                for (let n = 0; n < count; n++) {
                    match (writer.write(chunk)) {
                        Result.Err(problem) => {
                            return Result<Unit>.Err(problem);
                        },
                        Result.Ok(_) => {},
                    }
                    if (n == 0) {
                        last clock = new system_clock.SystemClock();
                        match (clock.sleep(of_millis(300))) {
                            Result.Ok(_) => {},
                            Result.Err(_) => {},
                        }
                    }
                }
                return Result<Unit>.Ok(Unit.Value);
            }).with_header("X-Streamed", "yes"));
        }
        if (request.path == "/stream-fail") {
            last fields: [string, string][list] = new;
            return Result<app.Response>.Ok(app.stream(200, fields, new func(writer: app.BodyWriter) -> Result<Unit> {
                match (writer.write_text("partial")) {
                    Result.Err(problem) => {
                        return Result<Unit>.Err(problem);
                    },
                    Result.Ok(_) => {},
                }
                return Result<Unit>.Err(errors.custom("test.stream", "the producer failed on purpose"));
            }));
        }
        if (request.path == "/metric") {
            match (context.count("test_requests_total", 2 as int64)) {
                Result.Err(problem) => {
                    return Result<app.Response>.Err(problem);
                },
                Result.Ok(_) => {},
            }
            match (context.gauge("test_depth", -5 as int64)) {
                Result.Err(problem) => {
                    return Result<app.Response>.Err(problem);
                },
                Result.Ok(_) => {},
            }
            return Result<app.Response>.Ok(app.text(200, "counted\n"));
        }
        if (request.path == "/fail") {
            return Result<app.Response>.Err(errors.custom("test.fail", "the handler failed on purpose"));
        }
        if (request.path == "/trap") {
            trap_with_message("the handler trapped on purpose");
        }
        if (request.path == "/status") {
            return Result<app.Response>.Ok(app.empty(204).with_header("X-Test", "yes"));
        }
        return Result<app.Response>.Ok(app.text(404, "not found\n"));
    };
);
