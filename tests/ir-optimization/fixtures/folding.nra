// Constant expressions whose results are defined and representable.
let Folding = module (
    export let sum_literals = func() -> int32 {
        return 2 + 3;
    };

    export let nested = func() -> int32 {
        return (2 + 3) * 4 - 18 / 6;
    };

    export let double_negation = func() -> int32 {
        return -(-5);
    };

    export let exact_division = func() -> int8 {
        return -128 / 2;
    };

    export let int8_upper = func() -> int8 {
        return 126 + 1;
    };

    export let int8_lower = func() -> int8 {
        return -127 - 1;
    };

    export let uint8_upper = func() -> uint8 {
        return 254 + 1;
    };

    export let uint8_zero = func() -> uint8 {
        return 3 - 3;
    };

    export let int64_upper = func() -> int64 {
        return 9223372036854775806 + 1;
    };

    export let int64_lower = func() -> int64 {
        return -9223372036854775807 - 1;
    };

    export let uint64_upper = func() -> uint64 {
        return 18446744073709551614 + 1;
    };

    export let uint64_exact_division = func() -> uint64 {
        return 18446744073709551615 / 5;
    };

    export let ordering = func() -> bool {
        return 1 < 2;
    };

    export let boolean_equality = func() -> bool {
        return true == false;
    };

    export let boolean_negation = func() -> bool {
        return !false;
    };

    export let scaled = func(int8 value) -> int8 {
        return value * (2 + 1) - 10 / 5;
    };

    export let condition = func(int32 value) -> int32 {
        if (2 * 3 == 6) {
            return value;
        } else {
            return 0;
        }
    };
);
