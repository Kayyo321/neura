// A return inside nested scopes inside a loop, and break and continue that
// leave a scope: each exit waits for the tasks of every scope it leaves,
// innermost first.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let note = func(label: string, value: int) -> int {
    console.print_line(label);
    return value;
};

let find = func(limit: int) -> int {
    for (let i: int = 0; i < limit; i++) {
        scope {
            let outer = spawn note("outer " + i.to_string(), i);
            scope {
                let inner = spawn note("inner " + i.to_string(), i * 10);
                if (i == 3) {
                    return outer.join() + inner.join();
                }
                if (i == 1) {
                    continue;
                }
            }
            console.print_line("after inner " + i.to_string());
        }
    }
    return 0 - 1;
};

let escape = func -> int {
    let rounds = 0;
    while (true) {
        scope {
            let task = spawn note("round " + rounds.to_string(), rounds);
            rounds = rounds + 1;
            if (rounds == 4) {
                break;
            }
            if (rounds % 2 == 0) {
                continue;
            }
            task.join();
        }
    }
    return rounds;
};

export let Main = module : program.Entry (
    export let.override main = func(arguments: string[]) -> program.ExitCode {
        console.print_line("find " + find(6).to_string());
        console.print_line("find " + find(2).to_string());
        console.print_line("escape " + escape().to_string());
        return program.ExitCode.Ok;
    };
);
