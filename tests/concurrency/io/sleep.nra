// Three tasks sleep for one second each. Their sleeps are deadlines on the
// run's clock, not blocked threads (Concurrency.md section 10.4), so they
// overlap: the whole program takes about one second, not three. The bound on
// the elapsed time is generous, because the machine may be busy; the point is
// that it is well below the sum of the sleeps. Needs the clock capability.
let channels = import:Std.Concurrent.Channel;
let console = import:Std.Io.Console;
let durations = import:Std.Time.Duration;
let errors = import:Std.Core.Error;
let program = import:Std.Program;
let result = import:Std.Core.Result;
let system_clock = import:Std.Time.SystemClock;

let sleeper = func(label: int, out: channels.Sender<int>) {
    match (system_clock.create().sleep(durations.of_millis(1000))) {
        result.Result.Ok(_) => {
            out.send(label);
        },
        result.Result.Err(_) => {
            out.send(0 - 100);
        },
    }
};

let now = func -> int64 {
    return match (system_clock.create().monotonic()) {
        result.Result.Ok(reading) => reading.to_nanos(),
        result.Result.Err(_) => 0,
    };
};

export let Main = module : program.Entry (
    export let.override main = func(arguments: string[]) -> program.ExitCode {
        let woke = channels.open<int>(3);
        let one_second: int64 = 1000000000;
        let limit: int64 = 2500000000;
        let started = now();
        let total = 0;
        scope {
            spawn sleeper(1, woke[0]);
            spawn sleeper(2, woke[0]);
            spawn sleeper(3, woke[0]);
            for (let i: int = 0; i < 3; i++) {
                match (woke[1].receive()) {
                    channels.Received.Value(label) => {
                        total = total + label;
                    },
                    _ => {},
                }
            }
        }
        let elapsed = now() - started;
        console.print_line("woken labels " + total.to_string());
        console.print_line("elapsed at least one second: " + (elapsed >= one_second).to_string());
        console.print_line("elapsed below two and a half seconds: " + (elapsed < limit).to_string());
        return program.ExitCode.Ok;
    };
);
