// A program without tasks: #Synchronized compiles to plain methods, with no
// guard and no other cost (Concurrency.md section 8.1). monitors.cmake builds
// it with and without the tag and requires the same output and statistics.
let console = import:Std.Io.Console;
let program = import:Std.Program;

#Synchronized
let Account = class (
    let balance: int64 = 0;

    export let deposit = func(amount: int64) -> int64 {
        balance = balance + amount;
        return audit();
    };

    export let audit = func -> int64 => balance;
);

let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let account = new Account();
        for (let i: int64 = 1; i <= 10; i++) {
            account.deposit(i);
        }
        console.print_line(account.audit().to_string());
        return program.ExitCode.Ok;
    };
);
