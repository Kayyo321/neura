// The live-task limit is checked before a spawn changes anything.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let wait = func(depth: int) -> int {
    if (depth == 0) {
        return 0;
    }
    scope {
        let deeper = spawn wait(depth - 1);
        return 1 + deeper.join();
    }
};

export let Main = module : program.Entry (
    export let.override main = func(arguments: string[]) -> program.ExitCode {
        console.print_line(wait(5).to_string());
        console.print_line(wait(40).to_string());
        return program.ExitCode.Ok;
    };
);
