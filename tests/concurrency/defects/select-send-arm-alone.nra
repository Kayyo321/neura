// FIXME(compiler): a send arm of `select` is rejected unless Sender.send was lowered earlier in the program.
// Not registered in CTest; pinned in tests/concurrency/frontend.cmake as select_send_arm_alone.
//
//   neura check select-send-arm-alone.nra
//
// Expected (Concurrency.md section 6): the arm is accepted and the program prints "send Sent".
// Actual: select-send-arm-alone.nra:21:27: error: send takes the value to send
// Uncomment the plain `sender.send(1)` line (and open the channel with capacity 2) and the same arm compiles and
// runs. Probable cause (read from the source, not confirmed by a fix): src/neura-ir/lowering.cpp (Lowering::select_statement): the arm reads
// `symbol(member).parameters.size()` before `resolve(member)`, so a member that nothing has resolved yet has no
// parameters.
let console = import:Std.Io.Console;
let program = import:Std.Program;
let channels = import:Std.Concurrent.Channel;

export let Main = module : program.Entry (
    export let.override main = func(arguments: string[]) -> program.ExitCode {
        let [sender, receiver, closer] = channels.open<int>(1);
        // sender.send(1);
        select {
            let outcome = sender.send(7) => { console.print_line("send " + outcome.to_string()); },
        }
        return program.ExitCode.Ok;
    };
);
