// Diagnostic quality. Not registered in CTest; pinned in tests/concurrency/frontend.cmake as
// group_work_captures_an_object, group_work_writes_a_global, tasks_all_call_writes_a_global, and
// tasks_all_ok_call_captures_an_object.
//
//   neura check spawn-diagnostic-in-library.nra
//
// A library helper spawns the user's function (Std.Concurrent.WorkerGroup.with_workers spawns the worker that
// calls `work`). The spawn checks of Concurrency.md sections 5.1 and 5.2 run at that spawn, which is inside the
// library, so the primary location of the error is a line of std/concurrent/worker-group.nra, and for a captured
// object the message names neither the user's function nor the capture:
//
//   .../stdlib/std/concurrent/worker-group.nra:92:37: error: a value of type func(int32) -> void is not
//   transferable, so it cannot be given to a spawned task
//
// (An unsafe `work` that writes a global is reported at the same library line, but its message names the user's
// function and the binding, with their positions.) Expected: the primary location is the user's call to
// with_workers, as it is for a non-transferable job type, which is reported at the user's call. The same applies
// to Std.Concurrent.Tasks; there the type shown for a capturing call is the helper's internal
// `func() -> Result<Erased>`.
let console = import:Std.Io.Console;
let program = import:Std.Program;
let groups = import:Std.Concurrent.WorkerGroup;

let Box = class (
    export let value: int;
    export let init = func(v: int) { value = v; };
);

export let Main = module : program.Entry (
    export let.override main = func(arguments: string[]) -> program.ExitCode {
        let box = new Box(1);
        let add = func(job: int) -> void { box.value = box.value + job; };
        groups.with_workers<int>(1, 1, add, func(group: groups.WorkerGroup<int>) -> void { });
        return program.ExitCode.Ok;
    };
);
