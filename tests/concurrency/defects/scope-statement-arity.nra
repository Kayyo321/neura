// Diagnostic quality, not a crash. Not registered in CTest; the messages are pinned in
// tests/concurrency/frontend.cmake as scope_with_two_names and scope_with_no_name.
//
// Section 4.4 recognizes `scope (name) {` with exactly one identifier, so `scope (first, second) {` and
// `scope () {` are not scope statements. They parse as a call statement, and the user sees only
//
//   scope-statement-arity.nra:14:31: error: expected ';'
//
// at the brace. Expected: a message that says a scope takes exactly one name.
let program = import:Std.Program;

export let Main = module : program.Entry (
    export let.override main = func(arguments: string[]) -> program.ExitCode {
        scope (first, second) {
        }
        return program.ExitCode.Ok;
    };
);
