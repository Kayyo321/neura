// FIXME(compiler): `scope (name) { }` in a function with type parameters (or in a method of a generic class)
// fails NeuraIR verification. Not registered in CTest; the same input is pinned in
// tests/concurrency/frontend.cmake as named_scope_in_a_generic_function.
//
//   neura build scope-name-in-generic.nra -o out.nvr
//
// Expected (Concurrency.md section 4.1): the program builds and prints 5.
// Actual: scope-name-in-generic.nra:18:12: error: NeuraIR verification failed before optimization: load of local
//   %N '$scope' is not preceded by its initialization in an enclosing scope
// `scope { }` without a name works in the same function. Probable cause (read from the source, not confirmed by a fix): src/neura-ir/lowering.cpp
// (Lowering::task_scope): the hidden local '$scope' that carries the scope's identity is created per lowering of
// the statement and its symbol is not remapped when the generic body is specialized.
// Std.Concurrent.Tasks works around it by cancelling from functions that have no type parameters.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let run = func<T>(value: T) -> int {
    scope (group) {
        return 5;
    }
};

export let Main = module : program.Entry (
    export let.override main = func(arguments: string[]) -> program.ExitCode {
        console.print_line(run<int>(1).to_string());
        return program.ExitCode.Ok;
    };
);
