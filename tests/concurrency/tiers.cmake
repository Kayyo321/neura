cmake_minimum_required(VERSION 3.20)

# Run each fixture against tier 0 at the same quantum. Ordinary runs report
# scheduler peaks in --stats; recordings add the request/delivery trace and
# also run the shadow. Real sockets and the clock of busy-deadline cannot
# give independent runs identical inputs. Check their live output and replay
# the tier-0 recording in each tier with the same clock readings and deliveries.
if(NOT DEFINED NEURA OR NOT DEFINED SOURCE_DIR OR NOT DEFINED TEST_DIR OR NOT DEFINED SECTION)
    message(FATAL_ERROR "Provide NEURA, SOURCE_DIR, TEST_DIR, and SECTION")
endif()

file(MAKE_DIRECTORY "${TEST_DIR}")
set(sources "${SOURCE_DIR}/tests/concurrency")
set(timeout 60)
if("$ENV{NEURA_TEST_TIMEOUT_SCALE}" MATCHES "^[1-9][0-9]*$")
    math(EXPR timeout "${timeout} * $ENV{NEURA_TEST_TIMEOUT_SCALE}")
endif()

set(environment)
foreach(var IN ITEMS NEURA_TIER NEURA_TIER_EAGER NEURA_TIER_CHECK NEURA_TIER_CHECK_HEAP NEURA_TIER_PROGRAMS
        NEURA_TIER_DUMP NEURA_TIER3 NEURA_TIER3_AFTER NEURA_TIER3_VERIFY NEURA_TIER3_PASSES
        NEURA_JIT NEURA_JIT_DUMP NEURA_RUN_OPTIONS)
    list(APPEND environment "--unset=${var}")
endforeach()

set(modes tier3-off)
set(env_tier3-off NEURA_TIER3=off)
foreach(backend IN ITEMS interp native)
    list(APPEND modes ${backend}-eager)
    set(env_${backend}-eager NEURA_TIER3=${backend} NEURA_TIER_EAGER=1)
    foreach(after IN ITEMS 1 7 64)
        list(APPEND modes ${backend}-after-${after})
        set(env_${backend}-after-${after} NEURA_TIER3=${backend} NEURA_TIER3_AFTER=${after})
    endforeach()
endforeach()
set(quanta 1 2 3 7 64 1024)

function(neura label mode check)
    set(options)
    if(mode STREQUAL "reference")
        set(options --tier=0)
    endif()
    if(check)
        set(shadow NEURA_TIER_CHECK=2)
    endif()
    list(POP_FRONT ARGN command)
    execute_process(
        COMMAND "${CMAKE_COMMAND}" -E env ${environment} ${env_${mode}} ${shadow}
            "${NEURA}" ${command} ${options} ${ARGN}
        WORKING_DIRECTORY "${TEST_DIR}"
        RESULT_VARIABLE status OUTPUT_FILE "${TEST_DIR}/${label}.out" ERROR_FILE "${TEST_DIR}/${label}.err"
        TIMEOUT "${timeout}")
    file(READ "${TEST_DIR}/${label}.out" out)
    file(READ "${TEST_DIR}/${label}.err" err)
    if(NOT status STREQUAL "${expected_status}")
        message(FATAL_ERROR "${label}: expected exit ${expected_status}, got ${status}\n${out}\n${err}")
    endif()
    if(err MATCHES "NEURA_TIER_CHECK=2 is not applied")
        message(FATAL_ERROR "${label}: the shadow must be available\n${err}")
    endif()
    set(out "${out}" PARENT_SCOPE)
    set(err "${err}" PARENT_SCOPE)
endfunction()

function(same_bytes left right)
    foreach(suffix IN LISTS ARGN)
        file(SHA256 "${TEST_DIR}/${left}.${suffix}" expected)
        file(SHA256 "${TEST_DIR}/${right}.${suffix}" actual)
        if(NOT expected STREQUAL actual)
            message(FATAL_ERROR "${right}: differs from ${left} in ${suffix}. See ${TEST_DIR}")
        endif()
    endforeach()
endfunction()

function(clean label)
    file(REMOVE "${TEST_DIR}/${label}.out" "${TEST_DIR}/${label}.err"
        "${TEST_DIR}/${label}.trace" "${TEST_DIR}/${label}.events")
endfunction()

function(build source image)
    set(expected_status 0)
    file(REMOVE "${TEST_DIR}/${image}")
    neura("${image}-build" build FALSE build "${source}" -o "${image}")
endfunction()

# Limit and trap cases must really hit the specified boundary. The exact
# output of fixtures whose interleaving can vary is checked at quantum 1024;
# at the other quanta it's compared with that quantum's tier-0 run.
function(check_run label)
    if(NOT err MATCHES "^stats: steps [1-9][0-9]*, peak heap cells [0-9]+, [^\n]+\n")
        message(FATAL_ERROR "${label}: no run statistics\n${err}")
    endif()
    if(trap)
        if(NOT err MATCHES "\n[^\n]+: trap: ${trap}")
            message(FATAL_ERROR "${label}: missing trap '${trap}'\n${err}")
        endif()
    elseif(NOT err MATCHES "^stats: [^\n]+\ngpu: off\n$")
        message(FATAL_ERROR "${label}: unexpected stderr\n${err}")
    endif()
    if(exact_output OR quantum EQUAL 1024)
        if(NOT out STREQUAL expected_output)
            message(FATAL_ERROR "${label}: expected stdout\n${expected_output}\ngot\n${out}")
        endif()
    elseif(NOT expected_output STREQUAL "" AND out STREQUAL "")
        message(FATAL_ERROR "${label}: no program output")
    endif()
endfunction()

function(run_fixture name image)
    foreach(quantum IN LISTS quanta)
        set(reference "${name}-q${quantum}-reference")
        foreach(mode IN ITEMS reference ${modes})
            set(label "${name}-q${quantum}-${mode}")
            clean("${label}")
            set(run --gpu=off --stats --task-quantum "${quantum}" ${limits})
            set(entry "${image}" -- ${arguments})
            if(NOT host_timed)
                neura("${label}-live" "${mode}" FALSE run ${run} ${capabilities} ${entry})
                check_run("${label}-live")
            endif()
            neura("${label}" "${mode}" TRUE run ${run} ${capabilities}
                --record "${label}.trace" --trace-events "${label}.events" ${entry})
            check_run("${label}")
            if(NOT without_tasks)
                file(STRINGS "${TEST_DIR}/${label}.trace" header LIMIT_COUNT 2)
                if(NOT header MATCHES "^neura-trace 3;settings quantum ${quantum} ")
                    message(FATAL_ERROR "${label}: missing version 3 trace/settings: ${header}")
                endif()
                file(SIZE "${TEST_DIR}/${label}.events" event_size)
                if(event_size EQUAL 0)
                    message(FATAL_ERROR "${label}: missing scheduler events")
                endif()
            endif()
            if(mode STREQUAL "reference")
                continue()
            endif()
            if(host_timed)
                clean("${label}-replay")
                neura("${label}-replay" "${mode}" FALSE run ${run} --deny-all
                    --replay "${reference}.trace" --trace-events "${label}-replay.events" ${entry})
                check_run("${label}-replay")
                same_bytes("${reference}" "${label}-replay" out err events)
                clean("${label}-replay")
            else()
                same_bytes("${reference}-live" "${label}-live" out err)
                same_bytes("${reference}" "${label}" out err trace events)
                clean("${label}-live")
            endif()
            clean("${label}")
        endforeach()
        clean("${reference}-live")
        clean("${reference}")
    endforeach()
    message(STATUS "${name}: tiers agree across quanta ${quanta}")
endfunction()

function(run_program source)
    get_filename_component(name "${source}" NAME_WE)
    get_filename_component(directory "${source}" DIRECTORY)
    set(image "${name}.nvr")
    build("${source}" "${image}")
    set(expected_status 0)
    set(arguments)
    set(limits)
    set(capabilities)
    set(host_timed FALSE)
    set(exact_output FALSE)
    set(without_tasks FALSE)
    set(trap)
    if(EXISTS "${directory}/${name}.expected")
        file(READ "${directory}/${name}.expected" expected_output)
    elseif(SECTION STREQUAL "monitors" AND name STREQUAL "plain")
        set(expected_output "55\n")
        set(without_tasks TRUE)
    elseif(SECTION STREQUAL "parallel" AND name STREQUAL "traps")
        # Each argument takes a different path through the same image.
        set(expected_divide 136)
        set(expected_steps 152)
        set(expected_heap 137)
        set(expected_total 0)
        set(trap_divide "source arithmetic failure[^\n]*item 2 of a parallel map")
        set(trap_steps "step limit exceeded: 20000 steps \\(item 2 of a parallel map\\)")
        set(trap_heap "heap limit exceeded:[^\n]*item 2 of a parallel map")
        foreach(arguments IN ITEMS divide steps heap total)
            set(expected_status "${expected_${arguments}}")
            set(trap "${trap_${arguments}}")
            set(expected_output "start\n")
            if(arguments STREQUAL "total")
                string(APPEND expected_output "finished\n")
            endif()
            set(exact_output TRUE)
            run_fixture("${name}-${arguments}" "${image}")
        endforeach()
        return()
    elseif(name STREQUAL "spin")
        set(limits --max-steps 150000)
        set(expected_status 152)
        set(expected_output "")
        set(exact_output TRUE)
        set(trap "step limit exceeded: 150000 steps")
    elseif(name STREQUAL "busy-deadline")
        set(limits --max-steps 10000000)
        set(capabilities --allow-clock)
        set(expected_output "busy task stopped: true\n")
        set(exact_output TRUE)
        set(host_timed TRUE)
    else()
        message(FATAL_ERROR "${source}: fixture needs expected stdout and exit status")
    endif()
    if(name STREQUAL "deadline" OR name STREQUAL "sleep")
        set(capabilities --allow-clock --virtual-time)
    elseif(SECTION STREQUAL "io")
        set(capabilities --allow-net --allow-clock)
        set(host_timed TRUE)
        set(exact_output TRUE)
    elseif(name STREQUAL "child-exit")
        set(expected_status 7)
    elseif(name STREQUAL "deadlock")
        set(expected_status 134)
        set(trap "deadlock: all tasks are parked\nwait chain:")
    elseif(name STREQUAL "child-trap" OR name STREQUAL "trap")
        set(expected_status 136)
        set(trap "source arithmetic failure[^\n]*task [1-9][0-9]* spawned")
    endif()
    run_fixture("${name}" "${image}")

    if(name STREQUAL "task-limit")
        set(limits --max-tasks 16)
        set(expected_status 137)
        set(expected_output "5\n")
        set(exact_output TRUE)
        set(trap "task limit exceeded: spawning another task")
        run_fixture("${name}-exhausted" "${image}")
    elseif(name STREQUAL "queued-limit")
        set(limits --max-queued-messages 8)
        set(expected_status 137)
        string(REGEX REPLACE "second channel holds 3,.*$" "" expected_output "${expected_output}")
        set(exact_output TRUE)
        set(trap "queued message limit exceeded: buffering another message")
        run_fixture("${name}-exhausted" "${image}")
    endif()
endfunction()

function(run_schedules source status pattern)
    get_filename_component(name "${source}" NAME_WE)
    set(expected_status "${status}")
    foreach(quantum IN LISTS quanta)
        set(reference "${name}-q${quantum}-reference")
        foreach(mode IN ITEMS reference ${modes})
            set(label "${name}-q${quantum}-${mode}")
            # The chooser disables the shadow. A relative filename keeps the
            # saved-schedule note identical across invocations.
            clean("${label}")
            file(REMOVE "${TEST_DIR}/failing.schedule")
            neura("${label}" "${mode}" FALSE test --gpu=off --stats --virtual-time --task-quantum "${quantum}"
                --schedules 8 --schedule-seed 0 --save-schedule failing.schedule "${source}")
            if(NOT out MATCHES "${pattern}")
                message(FATAL_ERROR "${label}: unexpected schedule exploration result\n${out}\n${err}")
            endif()
            set(suffixes out err)
            if(status EQUAL 1)
                file(READ "${TEST_DIR}/failing.schedule" saved)
                if(NOT saved MATCHES "\nchoose [0-9]+ [1-9][0-9]*\n")
                    message(FATAL_ERROR "${label}: failure didn't exercise a non-FIFO schedule\n${saved}")
                endif()
                file(RENAME "${TEST_DIR}/failing.schedule" "${TEST_DIR}/${label}.trace")
                list(APPEND suffixes trace)
            endif()
            if(NOT mode STREQUAL "reference")
                same_bytes("${reference}" "${label}" ${suffixes})
                clean("${label}")
            endif()
        endforeach()
        clean("${reference}")
    endforeach()
    message(STATUS "${name}: schedule exploration agrees across tiers at quanta ${quanta}")
endfunction()

function(nonvacuity)
    set(expected_status 0)
    set(missing)
    # Parallel-map items can run native code before M1, so use images that
    # can only count entries from the scheduler's own tasks.
    foreach(fixture IN ITEMS programs/fan-out monitors/counter)
        get_filename_component(name "${fixture}" NAME_WE)
        build("${sources}/${fixture}.nra" "${name}.nvr")
        neura("${name}" native-eager FALSE run --gpu=off --jit=on --stats --tier-stats "${name}.nvr")
        file(READ "${sources}/${fixture}.expected" expected)
        if(NOT out STREQUAL expected OR NOT err MATCHES "^stats: steps [1-9][0-9]*, [^\n]+peak tasks ([2-9]|[1-9][0-9]+),")
            message(FATAL_ERROR "${fixture}: no successful task run\n${out}\n${err}")
        endif()
        if(NOT err MATCHES "\ntier: blocks [1-9][0-9]*, hinted [0-9]+," OR
           NOT err MATCHES "\ntier: steps [1-9][0-9]*: tier 2 [^\n]* \\(in regions [1-9][0-9]*\\)")
            message(FATAL_ERROR "${fixture}: missing tier statistics or no tier-2 execution\n${err}")
        endif()
        if(err MATCHES "\ntier: native programs on the IR interpreter:")
            message(FATAL_ERROR "${fixture}: native code is unavailable\n${err}")
        endif()
        if(err MATCHES "\ntier: native programs [^\n]+; entered ([0-9]+),")
            if(CMAKE_MATCH_1 GREATER 0)
                if(NOT err MATCHES "steps in native code [1-9][0-9]*\n")
                    message(FATAL_ERROR "${fixture}: native entries reported without executing any native steps\n${err}")
                endif()
                if(EXPECT_MISSING_NATIVE)
                    message(FATAL_ERROR "${fixture}: unexpected pass, native task entries are now present")
                endif()
                continue()
            endif()
        elseif(err MATCHES "\ntier: native programs ")
            message(FATAL_ERROR "${fixture}: malformed native tier statistics\n${err}")
        endif()
        list(APPEND missing "${fixture}")
    endforeach()
    if(missing)
        if(EXPECT_MISSING_NATIVE)
            message(STATUS "Expected failure before M1: zero native task entries in ${missing}")
        else()
            message(FATAL_ERROR "Expected native task entries above zero in ${missing}")
        endif()
    endif()
endfunction()

if(SECTION STREQUAL "nonvacuity")
    nonvacuity()
elseif(SECTION STREQUAL "schedules")
    # The monitor remains schedule-independent at each of the six quanta.
    run_schedules("${sources}/monitors/tally-tests.nra" 0
        "PASS TallyTests.test_total_is_exact \\[8 schedules\\]")
    # The service's overload fixture requires the entire burst to arrive
    # in one turn. The order-dependent test must fail after a non-FIFO choice.
    set(quanta 1024)
    run_schedules("${sources}/schedules/service-tests.nra" 0
        "explored 16 schedule\\(s\\) of 2 test\\(s\\)")
    run_schedules("${sources}/schedules/order-tests.nra" 1
        "FAIL OrderTests.test_assumes_spawn_order \\[schedule [2-8] of 8, seed [0-9]+\\]: expected <1>, got <2>")
elseif(SECTION STREQUAL "special")
    run_program("${sources}/spin.nra")
    run_program("${sources}/busy-deadline.nra")
elseif(SECTION MATCHES "^(programs|monitors|io|parallel)$")
    file(GLOB fixtures "${sources}/${SECTION}/*.nra")
    foreach(source IN LISTS fixtures)
        if(NOT source MATCHES "/tally-tests[.]nra$")
            run_program("${source}")
        endif()
    endforeach()
else()
    message(FATAL_ERROR "Unknown concurrency tier section '${SECTION}'")
endif()
