let console = import:Std.Io.Console;
let desktop = import:Std.Desktop;
let program = import:Std.Program;
let closeable = import:Std.Io.Closeable;
let errors = import:Std.Core.Error;
let cancellation = import:Std.Concurrent.Cancellation;
let durations = import:Std.Time.Duration;
let.promote _ = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Result;
let timers = import:Std.Concurrent.Timer;
let strings = import:Std.Text.Strings;
let.promote _ = import:Std.Core.Unit;

// The native child of the desktop application fixture (tests/desktop/app_test.js). Its standard output is the
// channel to the window host, so it logs only to standard error; the tests read the "child:" lines. Every bridge
// operation runs as its own task, so it reaches the host through `call.host()` and captures nothing else.
let AppChild = module:program.Entry (
    last registry = new desktop.Registry(new(["fixture.clipboard_read", "fixture.clipboard_write", "fixture.close",
        "fixture.data_dir", "fixture.echo", "fixture.fail", "fixture.focus", "fixture.menu", "fixture.menu_bad",
        "fixture.notify", "fixture.open", "fixture.open_many", "fixture.open_read", "fixture.quit", "fixture.save",
        "fixture.spin", "fixture.title", "fixture.trap", "fixture.unserved", "fixture.wait", "fixture.work"]));

    /// @brief The request as text; the fixture's pages send UTF-8.
    let text_of = func(call: desktop.Call) -> string {
        return match (call.text()) {
            Optional.Some(text) => text,
            Optional.None => "",
        };
    };

    /// @brief The request's decimal number.
    let number_of = func(call: desktop.Call) -> int64 {
        last wanted = text_of(call);
        let value: int64 = 0;
        for (let i = 0; i < wanted.byte_length; i++) {
            value = value * 10 + ((wanted.byte_at(i) - 48) as int64);
        }
        return value;
    };

    /// @brief An Ok reply of `text`.
    let reply = func(text: string) -> Result<uint8[list]> => Result<uint8[list]>.Ok(strings.to_bytes(text));

    /// @brief The text of a failed host request, as the fixture's pages read it.
    let failed = func(problem: errors.Error) -> Result<uint8[list]> => Result<uint8[list]>.Err(problem);

    /// @brief The window whose handle is the request's decimal text, open or not.
    let window_named = func(call: desktop.Call) -> desktop.Window => call.host().window(number_of(call) as uint32);

    /// @brief Logs an event to standard error, where the tests read it.
    let log_event = func(event: desktop.Event) {
        match (event) {
            desktop.Event.Closed(window) => { console.eprintln("child: event Closed {}", window.handle); },
            desktop.Event.Focused(window) => { console.eprintln("child: event Focused {}", window.handle); },
            desktop.Event.Blurred(window) => { console.eprintln("child: event Blurred {}", window.handle); },
            desktop.Event.Resized(window, width, height) => {
                console.eprintln("child: event Resized {} {}x{}", window.handle, width, height);
            },
            desktop.Event.MenuActivated(id, window) => {
                console.eprintln("child: event MenuActivated {} {}", id, window.handle);
            },
        }
    };

    /// @brief Opens the first window and serves the bridge until the application ends.
    let start = func(context: desktop.Context) -> Result<Unit> {
        match (context.open_window("Fixture", 640, 480)) {
            Result.Ok(window) => { console.eprintln("child: opened {}", window.to_string()); },
            Result.Err(problem) => { return Result<Unit>.Err(problem); },
        }
        last dispatcher = new desktop.Dispatcher(registry);
        dispatcher.on_event(log_event);
        dispatcher.add("fixture.echo", func(call: desktop.Call) -> Result<uint8[list]> =>
            Result<uint8[list]>.Ok(call.request()));
        dispatcher.add("fixture.fail", func(call: desktop.Call) -> Result<uint8[list]> =>
            Result<uint8[list]>.Err(errors.Error.Io { kind: errors.IoErrorKind.PermissionDenied, message: "refused by the fixture", path: "" }));
        dispatcher.add("fixture.title", func(call: desktop.Call) -> Result<uint8[list]> {
            match (call.window().set_title(text_of(call))) {
                Result.Ok(_) => { return reply("titled"); },
                Result.Err(problem) => { return failed(problem); },
            }
            return reply("unreachable");
        });
        dispatcher.add("fixture.open", func(call: desktop.Call) -> Result<uint8[list]> {
            match (call.host().open_window_at("Second", 320, 240, 100, 100, "/second.html")) {
                Result.Ok(window) => { return reply(window.handle.to_string()); },
                Result.Err(problem) => { return failed(problem); },
            }
            return reply("unreachable");
        });
        // Opens windows until one is refused; answers how many opened and the refusal.
        dispatcher.add("fixture.open_many", func(call: desktop.Call) -> Result<uint8[list]> {
            let opened = 0;
            while (true) {
                match (call.host().open_window_at("Many", 200, 150, 0, 0, "/second.html")) {
                    Result.Ok(window) => { opened = opened + 1; },
                    Result.Err(problem) => {
                        return reply(opened.to_string() + " then " + errors.message(problem));
                    },
                }
            }
            return reply("unreachable");
        });
        dispatcher.add("fixture.close", func(call: desktop.Call) -> Result<uint8[list]> {
            match (window_named(call).close()) {
                Result.Ok(_) => { return reply("closed"); },
                Result.Err(problem) => { return failed(problem); },
            }
            return reply("unreachable");
        });
        dispatcher.add("fixture.focus", func(call: desktop.Call) -> Result<uint8[list]> {
            match (window_named(call).focus()) {
                Result.Ok(_) => { return reply("focused"); },
                Result.Err(problem) => { return failed(problem); },
            }
            return reply("unreachable");
        });
        dispatcher.add("fixture.notify", func(call: desktop.Call) -> Result<uint8[list]> {
            match (call.host().notify("Fixture", text_of(call))) {
                Result.Ok(outcome) => {
                    return match (outcome) {
                        desktop.NotifyOutcome.Shown => reply("Shown"),
                        desktop.NotifyOutcome.Denied => reply("Denied"),
                        desktop.NotifyOutcome.Unsupported => reply("Unsupported"),
                    };
                },
                Result.Err(problem) => { return failed(problem); },
            }
            return reply("unreachable");
        });
        dispatcher.add("fixture.clipboard_write", func(call: desktop.Call) -> Result<uint8[list]> {
            match (call.host().clipboard_write(text_of(call))) {
                Result.Ok(_) => { return reply("written"); },
                Result.Err(problem) => { return failed(problem); },
            }
            return reply("unreachable");
        });
        dispatcher.add("fixture.clipboard_read", func(call: desktop.Call) -> Result<uint8[list]> {
            match (call.host().clipboard_read()) {
                Result.Ok(text) => { return reply(text); },
                Result.Err(problem) => { return failed(problem); },
            }
            return reply("unreachable");
        });
        dispatcher.add("fixture.data_dir", func(call: desktop.Call) -> Result<uint8[list]> {
            match (call.host().data_directory()) {
                Result.Ok(path) => { return reply(path); },
                Result.Err(problem) => { return failed(problem); },
            }
            return reply("unreachable");
        });
        dispatcher.add("fixture.quit", func(call: desktop.Call) -> Result<uint8[list]> {
            match (call.host().quit(7)) {
                Result.Ok(_) => {},
                Result.Err(problem) => { return failed(problem); },
            }
            return reply("quitting");
        });
        // Counts to the request's decimal number; 120,000,000 iterations take the child past the 100,000,000 steps
        // that `neura run` allows by default, which a desktop child must not be held to. It never asks whether it
        // was cancelled.
        dispatcher.add("fixture.spin", func(call: desktop.Call) -> Result<uint8[list]> {
            last limit = number_of(call);
            let count: int64 = 0;
            while (count < limit) {
                count = count + 1;
            }
            return reply(count.to_string());
        });
        // The application menu: a native item, a window item, a disabled item, and the copy and paste roles.
        dispatcher.add("fixture.menu", func(call: desktop.Call) -> Result<uint8[list]> {
            last file: desktop.MenuItem[list] = new([
                desktop.action("file.export", "Export…", desktop.MenuTarget.Native).with_accelerator("CmdOrCtrl+E"),
                desktop.action("view.refresh", "Refresh", desktop.MenuTarget.Window),
                desktop.separator(),
                desktop.action("file.never", "Unavailable \"quoted\"", desktop.MenuTarget.Native).with_enabled(false)
            ]);
            last edit: desktop.MenuItem[list] = new([
                desktop.role_item("edit.copy", "Copy", "copy"),
                desktop.role_item("edit.paste", "Paste", "paste")
            ]);
            last menu: desktop.MenuItem[list] = new([desktop.submenu("File", file), desktop.submenu("Edit", edit)]);
            match (call.host().set_menu(menu)) {
                Result.Ok(_) => { return reply("menu set"); },
                Result.Err(problem) => { return failed(problem); },
            }
            return reply("unreachable");
        });
        // A menu the host refuses: one identifier used twice.
        dispatcher.add("fixture.menu_bad", func(call: desktop.Call) -> Result<uint8[list]> {
            last twice: desktop.MenuItem[list] = new([
                desktop.action("same.id", "One", desktop.MenuTarget.Native),
                desktop.action("same.id", "Two", desktop.MenuTarget.Native)
            ]);
            match (call.host().set_menu(twice)) {
                Result.Ok(_) => { return reply("accepted"); },
                Result.Err(problem) => { return failed(problem); },
            }
            return reply("unreachable");
        });
        // Asks where to save, suggesting the request's name, and writes two lines (cases 6 to 8).
        dispatcher.add("fixture.save", func(call: desktop.Call) -> Result<uint8[list]> {
            last filters: desktop.FileFilter[list] = new([new desktop.FileFilter("Text", new(["txt"]))]);
            match (call.host().save_file_dialog(call.window(), text_of(call), filters)) {
                Result.Ok(outcome) => {
                    match (outcome) {
                        desktop.DialogOutcome.Cancelled => { return reply("cancelled"); },
                        desktop.DialogOutcome.Chosen(file) => {
                            last first = file.write(strings.to_bytes("first line\n"));
                            last second = file.write(strings.to_bytes("second line\n"));
                            last outcome_text = match (closeable.release<Unit>(file, Result<Unit>.Ok(Unit.Value))) {
                                Result.Ok(_) => "closed",
                                Result.Err(problem) => errors.message(problem),
                            };
                            last reading = match (file.read(10)) {
                                Result.Ok(_) => "read after close",
                                Result.Err(problem) => errors.message(problem),
                            };
                            last counts = match (first) {
                                Result.Ok(a) => match (second) {
                                    Result.Ok(b) => a.to_string() + "+" + b.to_string(),
                                    Result.Err(problem) => errors.message(problem),
                                },
                                Result.Err(problem) => errors.message(problem),
                            };
                            return reply("saved " + file.name + " " + counts + " " + outcome_text + "; " + reading);
                        },
                    }
                },
                Result.Err(problem) => { return failed(problem); },
            }
            return reply("unreachable");
        });
        // Asks for a file to read and reads it in chunks of five bytes; a write is refused.
        dispatcher.add("fixture.open_read", func(call: desktop.Call) -> Result<uint8[list]> {
            last none: desktop.FileFilter[list] = new;
            match (call.host().open_file_dialog(call.window(), none)) {
                Result.Ok(outcome) => {
                    match (outcome) {
                        desktop.DialogOutcome.Cancelled => { return reply("cancelled"); },
                        desktop.DialogOutcome.Chosen(file) => {
                            // Five-byte chunks split UTF-8 sequences, so the bytes are decoded once at the end.
                            last content_bytes: uint8[list] = new;
                            while (true) {
                                match (file.read(5)) {
                                    Result.Ok(chunk) => {
                                        if (chunk.length == 0) {
                                            break;
                                        }
                                        for (let b in chunk) {
                                            content_bytes.append(b);
                                        }
                                    },
                                    Result.Err(problem) => { return failed(problem); },
                                }
                            }
                            last refused = match (file.write(strings.to_bytes("x"))) {
                                Result.Ok(_) => "written",
                                Result.Err(problem) => errors.message(problem),
                            };
                            file.close();
                            let [valid, content] = string.from_utf8(content_bytes);
                            return reply(file.name + ": " + content + "; " + refused);
                        },
                    }
                },
                Result.Err(problem) => { return failed(problem); },
            }
            return reply("unreachable");
        });
        dispatcher.add("fixture.trap", func(call: desktop.Call) -> Result<uint8[list]> {
            trap_with_message("fixture trap in a bridge operation");
            return Result<uint8[list]>.Ok(call.request());
        });
        // Waits the request's number of milliseconds on a timer (case 4): a parked operation that a cancel wakes.
        dispatcher.add("fixture.wait", func(call: desktop.Call) -> Result<uint8[list]> {
            match (timers.after(durations.of_millis(number_of(call)))) {
                Result.Ok(timer) => {
                    match (timer.wait()) {
                        timers.TimerOutcome.Fired => { return reply("waited"); },
                        timers.TimerOutcome.Cancelled => {
                            console.eprintln("child: wait {} cancelled", call.id);
                            return reply("cancelled");
                        },
                    }
                },
                Result.Err(problem) => { return failed(problem); },
            }
            return reply("unreachable");
        });
        // Computes until its call is cancelled, asking between steps: a running operation that a cancel stops.
        dispatcher.add("fixture.work", func(call: desktop.Call) -> Result<uint8[list]> {
            let steps: int64 = 0;
            while (!cancellation.requested()) {
                steps = steps + 1;
            }
            console.eprintln("child: work {} stopped", call.id);
            return reply(steps.to_string());
        });
        return context.run(dispatcher);
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        return desktop.run_application(registry, start);
    };
);
