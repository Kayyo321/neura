// NeuraIR 1.12 fixture (docs/design/Matching030.md): `any` in a field, a
// parameter and a local, packing, `is`, and `match.is` over an `any`. The
// tests check the round trip and the verifier's rules for the operations.
let program = import:Std.Program;
let.promote _ = import:Std.Core.Optional;

let Values = module:program.Entry (
    let Shape = class (
        export let sides: int32 = 0;
    );
    let Holder = class (
        export let value: any = nil;
    );
    let describe = func(value: any) -> int32 => match.is (value) {
        count: int64 if count > 0 => 1,
        int64 => 2,
        text: string => 3,
        shape: Shape => shape.sides,
        nil => 5,
        _ => 6,
    };
    let test = func(value: any) -> bool => value is Shape || value is float64;
    let count = func(values: ...any) -> int32 {
        let integers = 0;
        for (let value: any in values) {
            if (value is int64) {
                integers += 1;
            }
        }
        return integers;
    };
    let pick = func(x: int32) -> int32 {
        return 1;
    } or func(x: any) -> int32 {
        return 2;
    };
    let wrap = func<T>(value: T) -> any => value as any;
    let forms = func(ready: bool) -> int32 {
        let list = new any[list]([1, "a", nil]);
        let tuple: [any, int32] = [wrap(3), 2];
        let either: any = ready ? 1 : "x";
        let maybe = Optional<any>.Some(either);
        return count(7 as int64, "seven", 7.0, nil) + pick(1 as int32) + pick("s") + describe(tuple[0]);
    };
    export let.override main = func(args: string[]) -> program.ExitCode {
        let holder = new Holder();
        holder.value = 7 as int64;
        let local: any = "seven";
        let result = describe(holder.value) + describe(local) + forms(true);
        return test(local) ? program.ExitCode.Ok : program.ExitCode.Ok;
    };
);
