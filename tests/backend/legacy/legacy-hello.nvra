; Neura assembly: the lossless text form of an NVR image.
; `neura assemble` turns it back into the same image.
nvr 1.0 profile 1
entry 0

type 0 text
type 1 array 0
type 2 signed 32
type 3 unsigned 32
type 4 void
constant 0 type 0 bytes 48656c6c6f2c20576f726c6421 ; "Hello, World!"
constant 1 type 2 bytes 00000000 ; 0

graph 0 inputs 0 outputs [ ]

import 0 "neura.console.write_line" version 1 parameters [ 0 ] success 4 error 3

function 0 parameters 1 result 2 frame [ 1 3 ]
  block 0 graph 0 selector 0 inputs [ ]
    exit host import 0 arguments [ constant:0:0 ] result - resume 1 error 1 error-resume 2 assign [ ]
  block 1 graph 0 selector 0 inputs [ ]
    exit return arguments [ constant:2:1 ] assign [ ]
  block 2 graph 0 selector 0 inputs [ ]
    exit trap reason 3 assign [ ]
