// Exercises examples/guide/core.nra, a library without an entry point.
// Build with -I examples/guide.
let io = import:SysIo;
let core = import:Core;

let CoreDriver = module:io.Entry (
    export let.override main = func(string[] args) -> Entry.ExitCode {
        if (core.sum_to(3) == 6) {
            io.println("Core.sum_to(3) = 6");
        }
        if (core.sum_to(0) == 0) {
            io.println("Core.sum_to(0) = 0");
        }
        io.println(core.describe(5));
        io.println(core.describe(0));
        return Entry.ExitCode.Ok;
    }
);
