// Calls examples/types/collections.nra, which exercises arrays, lists, and
// nested collections without printing.
let console = import:Std.Io.Console;
let program = import:Std.Program;
let collections = import:Collections;

let CollectionsDriver = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        collections.example();
        console.print_line("collections example finished");
        return program.ExitCode.Ok;
    }
);
