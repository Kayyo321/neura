// Calls examples/types/collections.nra, which exercises arrays, lists, and
// nested collections without printing.
let io = import:SysIo;
let collections = import:Collections;

let CollectionsDriver = module:io.Entry (
    export let.override main = func(string[] args) -> Entry.ExitCode {
        collections.example();
        io.println("collections example finished");
        return Entry.ExitCode.Ok;
    }
);
