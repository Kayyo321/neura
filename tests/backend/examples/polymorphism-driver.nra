// Calls examples/types/polymorphism.nra, which exercises subtype dispatch,
// generic functions and classes, a bound, and construction and destruction
// without printing.
let console = import:Std.Io.Console;
let program = import:Std.Program;
let polymorphism = import:Polymorphism;

let PolymorphismDriver = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        polymorphism.example();
        console.print_line("polymorphism example finished");
        return program.ExitCode.Ok;
    }
);
