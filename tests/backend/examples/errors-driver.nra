// Runs examples/guide/errors.nra against a missing file. With files granted
// it also reads a real one; with --deny-fs, the read is denied.
let console = import:Std.Io.Console;
let errors = import:Errors;
let program = import:Std.Program;

export let ErrorsDriver = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line(errors.describe(errors.read_count("does-not-exist.cfg")));
        for (let argument in args) {
            console.print_line(errors.describe(errors.read_count(argument)));
        }
        return program.ExitCode.Ok;
    };
);
