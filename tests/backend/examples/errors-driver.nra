// Runs examples/guide/errors.nra against a missing file. With --allow-fs it
// also reads a real one; without it, the read is denied.
let console = import:Std.Io.Console;
let errors = import:Errors;
let program = import:Std.Program;

export let ErrorsDriver = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        console.print_line(errors.describe(errors.read_count("does-not-exist.cfg")));
        for (let argument in args) {
            console.print_line(errors.describe(errors.read_count(argument)));
        }
        return program.ExitCode.Ok;
    };
);
