// Exercises examples/types/overlay.nra. Build with -I examples/types.
let console = import:Std.Io.Console;
let program = import:Std.Program;
let overlay = import:Overlay;

let OverlayDriver = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        if (overlay.next_user_id(overlay.default_user_id) == 2) {
            console.print_line("next_user_id(default_user_id) = 2");
        }
        if (overlay.enabled) {
            console.print_line(overlay.default_name + " is enabled");
        }
        return program.ExitCode.Ok;
    };
);
