// Exercises examples/types/classes.nra. Build with -I examples/types.
let console = import:Std.Io.Console;
let program = import:Std.Program;
let classes = import:Classes;

let ClassesDriver = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        let dog = new classes.Dog();
        dog.name = "Rover";
        let cat = new classes.Cat();
        cat.name = "Mittens";
        console.print_line(classes.describe(dog));
        console.print_line(classes.describe(cat));
        console.print_line(classes.describe(new classes.Animal()));
        classes.example();
        console.print_line("Classes.example() completed");
        return program.ExitCode.Ok;
    }
);
