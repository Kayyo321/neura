// Built together with examples/guide/resources.nra, whose top-level
// statements create, update, and destroy a counter before main runs.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let ResourcesDriver = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line("resources example finished");
        return program.ExitCode.Ok;
    };
);
