function(expect_gpu_stats prefix pattern)
    string(REGEX MATCHALL "(^|\n)gpu: [^\n]*" lines "${${prefix}_stderr}")
    list(LENGTH lines count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "${prefix}: expected one GPU stats line\n${${prefix}_stderr}")
    endif()
    string(REGEX REPLACE "^\n" "" line "${lines}")
    string(FIND "${${prefix}_stderr}" "${line}\n" terminated)
    if(terminated EQUAL -1 OR NOT line MATCHES "^gpu: (${pattern})$")
        message(FATAL_ERROR "${prefix}: expected GPU stats matching '${pattern}'\n${${prefix}_stderr}")
    endif()
    set(${prefix}_gpu "${line}" PARENT_SCOPE)
endfunction()

function(compare_modes label command)
    neura(required "${command}" --require-gpu --gpu-software --gpu-verify ${ARGN})
    compare_run("${label} with --require-gpu" required cpu)
    neura(automatic "${command}" --gpu=auto --gpu-software --gpu-verify ${ARGN})
    compare_run("${label} with verified --gpu=auto" automatic cpu)
    neura(prepared "${command}" --gpu=auto --gpu-software ${ARGN})
    compare_run("${label} with unwrapped --gpu=auto" prepared cpu)
    expect_gpu_stats(cpu off)
    expect_gpu_stats(required "${always_device}")
    expect_gpu_stats(automatic "${auto_result}")
    expect_gpu_stats(prepared "${auto_result}")
    string(REGEX MATCH ", evaluated ([0-9]+)," counter "${required_gpu}")
    math(EXPR total "${required_evaluated} + ${CMAKE_MATCH_1}")
    set(required_evaluated "${total}" PARENT_SCOPE)
    foreach(prefix IN ITEMS cpu required automatic prepared)
        if(command STREQUAL "run")
            if(NOT ${prefix}_stderr MATCHES "(^|\n)stats: [^\n]*\n([^\n]*\n)*gpu: [^\n]*\n$")
                message(FATAL_ERROR "${label}: GPU stats must follow existing run diagnostics\n${${prefix}_stderr}")
            endif()
        elseif(NOT ${prefix}_stderr STREQUAL "${${prefix}_gpu}\n")
            message(FATAL_ERROR "${label}: test adds only one GPU stats line to stderr\n${${prefix}_stderr}")
        endif()
    endforeach()
endfunction()

set(programs_compared 0)
set(required_evaluated 0)
foreach(group IN ITEMS programs traps)
    file(GLOB programs "${tests}/${group}/*.nra")
    list(SORT programs)
    foreach(source IN LISTS programs)
        get_filename_component(name "${source}" NAME_WE)
        set(image "${directory}/${group}-${name}.nvr")
        build_image("${source}" "${image}")
        neura(cpu run --no-gpu --stats "${image}")
        if(NOT cpu_stderr MATCHES "(^|\n)stats: steps ([0-9]+), ")
            message(FATAL_ERROR "${source}: CPU run did not report steps\n${cpu_stderr}")
        endif()
        set(steps "${CMAKE_MATCH_2}")
        if(steps GREATER 200000)
            message(STATUS "${group}/${name}: outside differential domain (${steps} steps)")
        else()
            compare_modes("${group}/${name}" run --stats "${image}")
            math(EXPR programs_compared "${programs_compared} + 1")
        endif()

        # Also exercise traps under the bounds their fixtures declare.
        file(STRINGS "${source}" options_line REGEX "^// run-options: ")
        if(NOT options_line STREQUAL "")
            string(REGEX REPLACE "^// run-options: " "" options "${options_line}")
            separate_arguments(options NATIVE_COMMAND "${options}")
            neura(cpu run --no-gpu --stats ${options} "${image}")
            compare_modes("${group}/${name} with fixture limits" run --stats ${options} "${image}")
        endif()
    endforeach()
endforeach()
if(programs_compared EQUAL 0 OR required_evaluated EQUAL 0)
    message(FATAL_ERROR "program sweep must compare at least one program and evaluate GPU jobs")
endif()
