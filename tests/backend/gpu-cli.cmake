function(compare_traces label input expected_status min_requests)
    set(cpu_trace "${directory}/${label}-cpu.trace")
    set(gpu_trace "${directory}/${label}-gpu.trace")
    neura(cpu run --no-gpu --record "${cpu_trace}" "${input}" -- ${ARGN})
    neura(gpu run --require-gpu --gpu-software --gpu-verify --record "${gpu_trace}" "${input}" -- ${ARGN})
    if(NOT cpu_status STREQUAL "${expected_status}")
        message(FATAL_ERROR "${label}: reference recording returned ${cpu_status}\n${cpu_stderr}")
    endif()
    compare_run("${label} record trace" gpu cpu)
    compare_files("${label} CPU and GPU trace bytes" "${gpu_trace}" "${cpu_trace}")
    file(STRINGS "${cpu_trace}" requests REGEX "^request ")
    list(LENGTH requests request_count)
    if(request_count LESS min_requests)
        message(FATAL_ERROR "${label}: trace contained only ${request_count} requests")
    endif()
    neura(cpu_replay run --no-gpu --replay "${gpu_trace}" "${input}" -- ${ARGN})
    neura(gpu_replay run --require-gpu --gpu-software --replay "${cpu_trace}" "${input}" -- ${ARGN})
    compare_run("${label} replay GPU trace on CPU" cpu_replay cpu)
    compare_run("${label} replay CPU trace on GPU" gpu_replay cpu)
endfunction()

