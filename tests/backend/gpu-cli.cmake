function(check_environment label environment pattern)
    set(gpu_environment "${environment}")
    neura(env_mode run --stats ${ARGN} "${image}" -- "mode test")
    compare_run("${label}" env_mode cpu_mode)
    expect_gpu_stats(env_mode "${pattern}")
endfunction()

