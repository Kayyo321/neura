cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED NEURA OR NOT DEFINED SOURCE_DIR OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "Provide NEURA, SOURCE_DIR, and TEST_DIR")
endif()

file(REMOVE_RECURSE "${TEST_DIR}")
file(MAKE_DIRECTORY "${TEST_DIR}")
file(REAL_PATH "${TEST_DIR}" directory)
set(tests "${SOURCE_DIR}/tests/backend")
unset(ENV{NEURA_GPU})

function(neura prefix)
    execute_process(
        COMMAND "${NEURA}" ${ARGN}
        WORKING_DIRECTORY "${directory}"
        RESULT_VARIABLE status
        OUTPUT_FILE "${directory}/${prefix}.out"
        ERROR_VARIABLE stderr
    )
    set(${prefix}_status "${status}" PARENT_SCOPE)
    set(${prefix}_stderr "${stderr}" PARENT_SCOPE)
endfunction()

function(build_image source image)
    neura(build build "${source}" -o "${image}")
    if(NOT build_status STREQUAL "0" OR NOT EXISTS "${image}")
        message(FATAL_ERROR "${source}: build failed with status ${build_status}\n${build_stderr}")
    endif()
endfunction()

function(compare_files label left right)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${left}" "${right}" RESULT_VARIABLE different)
    if(NOT different STREQUAL "0")
        message(FATAL_ERROR "${label}: ${left} and ${right} differ")
    endif()
endfunction()

function(compare_run label actual expected)
    if(NOT ${actual}_status STREQUAL "${${expected}_status}")
        message(FATAL_ERROR "${label}: expected status ${${expected}_status}, got ${${actual}_status}\n${${actual}_stderr}")
    endif()
    compare_files("${label} standard output" "${directory}/${actual}.out" "${directory}/${expected}.out")
    foreach(mode IN ITEMS "${actual}" "${expected}")
        string(REGEX REPLACE "(^|\n)gpu: [^\n]*\n" "\\1" ${mode}_diagnostics "${${mode}_stderr}")
    endforeach()
    if(NOT ${actual}_diagnostics STREQUAL "${${expected}_diagnostics}")
        message(FATAL_ERROR "${label}: stderr differs\nexpected:\n${${expected}_diagnostics}\nactual:\n${${actual}_diagnostics}")
    endif()
endfunction()

function(compare_modes label command)
    neura(required "${command}" --require-gpu --gpu-software --gpu-verify ${ARGN})
    compare_run("${label} with --require-gpu" required cpu)
endfunction()

set(programs_compared 0)
foreach(group IN ITEMS programs traps)
    file(GLOB programs "${tests}/${group}/*.nra")
    list(SORT programs)
    foreach(source IN LISTS programs)
        get_filename_component(name "${source}" NAME_WE)
        set(image "${directory}/${group}-${name}.nvr")
        build_image("${source}" "${image}")
        neura(cpu run --no-gpu --stats "${image}")
        if(NOT cpu_stderr MATCHES "(^|\n)stats: steps ([0-9]+), ")
            message(FATAL_ERROR "${source}: CPU run did not report steps\n${cpu_stderr}")
        endif()
        set(steps "${CMAKE_MATCH_2}")
        if(steps GREATER 200000)
            message(STATUS "${group}/${name}: outside differential domain (${steps} steps)")
        else()
            compare_modes("${group}/${name}" run --stats "${image}")
            math(EXPR programs_compared "${programs_compared} + 1")
        endif()

        # Also exercise traps under the bounds their fixtures declare.
        file(STRINGS "${source}" options_line REGEX "^// run-options: ")
        if(NOT options_line STREQUAL "")
            string(REGEX REPLACE "^// run-options: " "" options "${options_line}")
            separate_arguments(options NATIVE_COMMAND "${options}")
            neura(cpu run --no-gpu --stats ${options} "${image}")
            compare_modes("${group}/${name} with fixture limits" run --stats ${options} "${image}")
        endif()
    endforeach()
endforeach()
message(STATUS "compared ${programs_compared} program and trap images under default limits")

file(GLOB suites "${tests}/testing/*.nra")
list(SORT suites)
foreach(suite IN LISTS suites)
    neura(cpu test --no-gpu --stats "${suite}")
    file(READ "${directory}/cpu.out" summary)
    if(NOT summary MATCHES "[0-9]+ test[(]s[)], [0-9]+ passed, [0-9]+ failed\n$")
        message(FATAL_ERROR "${suite}: CPU test run did not report a summary\n${cpu_stderr}")
    endif()
    compare_modes("${suite}" test --stats "${suite}")
endforeach()

set(image "${directory}/first-argument.nvr")
build_image("${tests}/arguments/first-argument.nra" "${image}")
set(lists "${directory}/each.txt")
set(text "")
foreach(member RANGE 1 2000)
    string(APPEND text "\"member ${member}\"\n")
endforeach()
file(WRITE "${lists}" "${text}")
neura(cpu run --no-gpu --stats --each "${lists}" "${image}")
if(NOT cpu_status STREQUAL "0" OR NOT cpu_stderr MATCHES "^stats: members 2000, ")
    message(FATAL_ERROR "CPU fleet input did not report 2,000 members\n${cpu_stderr}")
endif()
compare_modes("run --each, 2,000 members" run --stats --each "${lists}" "${image}")

set(cpu_trace "${directory}/cpu.trace")
set(gpu_trace "${directory}/gpu.trace")
neura(cpu run --gpu=off --record "${cpu_trace}" "${image}" -- "trace input")
neura(gpu run --gpu=always --require-gpu --gpu-software --gpu-verify --record "${gpu_trace}" "${image}" -- "trace input")
if(NOT cpu_status STREQUAL "0" OR NOT gpu_status STREQUAL "0")
    message(FATAL_ERROR "record failed\nCPU: ${cpu_stderr}\nGPU: ${gpu_stderr}")
endif()
compare_run("record trace" gpu cpu)
compare_files("CPU and GPU trace bytes" "${gpu_trace}" "${cpu_trace}")
configure_file("${directory}/cpu.out" "${directory}/recorded.out" COPYONLY)

neura(cpu run --no-gpu --replay "${gpu_trace}" "${image}" -- "trace input")
neura(gpu run --require-gpu --gpu-software --replay "${cpu_trace}" "${image}" -- "trace input")
if(NOT cpu_status STREQUAL "0" OR NOT gpu_status STREQUAL "0")
    message(FATAL_ERROR "cross-device replay failed\nCPU: ${cpu_stderr}\nGPU: ${gpu_stderr}")
endif()
compare_run("replay across graph evaluators" gpu cpu)
compare_files("replayed and recorded console output" "${directory}/gpu.out" "${directory}/recorded.out")

function(expect_error expected)
    neura(error ${ARGN})
    file(SIZE "${directory}/error.out" stdout_bytes)
    if(NOT error_status STREQUAL "1" OR NOT stdout_bytes EQUAL 0 OR
       NOT error_stderr STREQUAL "neura: error: ${expected}\n")
        message(FATAL_ERROR "expected '${expected}', got status ${error_status} with ${stdout_bytes} stdout bytes\n${error_stderr}")
    endif()
endfunction()

neura(help --help)
file(READ "${directory}/help.out" usage)
foreach(option IN ITEMS --each --gpu=always --gpu=off --no-gpu --require-gpu --gpu-software --gpu-verify)
    string(FIND "${usage}" "${option}" position)
    if(NOT help_status STREQUAL "0" OR position EQUAL -1)
        message(FATAL_ERROR "usage is missing ${option}\n${usage}\n${help_stderr}")
    endif()
endforeach()

expect_error("conflicting GPU modes" run --gpu=always --gpu=off "${image}")
expect_error("conflicting GPU modes" run --no-gpu --gpu=always "${image}")
expect_error("--require-gpu needs --gpu=always" run --require-gpu --gpu=off "${image}")
expect_error("--require-gpu needs --gpu=always" run --no-gpu --require-gpu "${image}")
expect_error("--gpu-software cannot be combined with --gpu=off" run --gpu=off --gpu-software "${image}")
expect_error("--gpu-verify cannot be combined with --gpu=off" run --gpu-verify --no-gpu "${image}")
expect_error("expected --gpu=auto, --gpu=always, or --gpu=off" run --gpu=unknown "${image}")
foreach(option IN ITEMS --gpu=always --gpu=off --no-gpu --require-gpu --gpu-software --gpu-verify)
    expect_error("${option} applies only to run and test" check "${option}" "${tests}/arguments/first-argument.nra")
endforeach()

if(DEFINED FAULT_LOADER_DIR)
    set(fault_image "${directory}/gpu-fault.nvr")
    neura(assemble assemble "${tests}/gpu-fault.nvra" -o "${fault_image}")
    if(NOT assemble_status STREQUAL "0")
        message(FATAL_ERROR "could not assemble the GPU fault fixture\n${assemble_stderr}")
    endif()

    # Append the original search path only if nonempty. An empty component
    # in LD_LIBRARY_PATH would also search the working directory.
    set(original_loader_path "$ENV{LD_LIBRARY_PATH}")
    set(loader_path "${FAULT_LOADER_DIR}")
    if(NOT original_loader_path STREQUAL "")
        string(APPEND loader_path ":${original_loader_path}")
    endif()
    set(ENV{LD_LIBRARY_PATH} "${loader_path}")
    set(ENV{NEURA_TEST_VULKAN_FAULT} submit)
    neura(cpu run --no-gpu "${fault_image}")
    neura(fallback run --gpu=always --gpu-software "${fault_image}")
    file(READ "${directory}/cpu.out" fault_output)
    if(NOT cpu_status STREQUAL "7" OR NOT fault_output STREQUAL "before\nafter\n" OR NOT cpu_stderr STREQUAL "")
        message(FATAL_ERROR "fault fixture failed its CPU reference run\n${cpu_stderr}")
    endif()
    compare_run("optional GPU failure falls back" fallback cpu)

    # Capture both streams together to establish that the required-GPU
    # error follows all output, even though the program returned status 7.
    set(combined "${directory}/required-failure.out")
    execute_process(COMMAND "${NEURA}" run --require-gpu --gpu-software "${fault_image}"
                    WORKING_DIRECTORY "${directory}" RESULT_VARIABLE status
                    OUTPUT_FILE "${combined}" ERROR_FILE "${combined}")
    file(READ "${combined}" output)
    if(NOT status STREQUAL "1" OR NOT output STREQUAL
       "before\nafter\nneura: error: --require-gpu: the device failed during the run: vkQueueSubmit failed (-4)\n")
        message(FATAL_ERROR "required GPU failure should follow the program's output, got status ${status}\n${output}")
    endif()

    set(ENV{NEURA_TEST_VULKAN_FAULT} mismatch)
    neura(unverified run --require-gpu --gpu-software "${fault_image}")
    file(READ "${directory}/unverified.out" unverified_output)
    if(NOT unverified_status STREQUAL "8" OR NOT unverified_output STREQUAL "before\n" OR NOT unverified_stderr STREQUAL "")
        message(FATAL_ERROR "injected output should select the other graph exit without verification\n${unverified_stderr}")
    endif()
    neura(verified run --require-gpu --gpu-software --gpu-verify "${fault_image}")
    file(READ "${directory}/verified.out" verified_output)
    if(NOT verified_status STREQUAL "1" OR NOT verified_output STREQUAL "before\n" OR NOT verified_stderr STREQUAL
       "neura: error: graph device mismatch: graph 1 output 0: device 1, reference 0\n")
        message(FATAL_ERROR "verification should stop at the corrupted output, got status ${verified_status}\n${verified_stderr}")
    endif()
    unset(ENV{NEURA_TEST_VULKAN_FAULT})
    set(ENV{LD_LIBRARY_PATH} "${original_loader_path}")
    message(STATUS "checked an injected submission failure and graph output mismatch after startup")
endif()

if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    # Override the driver's manifest list for a fresh process. Both variable
    # spellings cover installed Vulkan loaders before and after VK_DRIVER_FILES.
    set(ENV{VK_DRIVER_FILES} "${directory}/no-icd.json")
    set(ENV{VK_ICD_FILENAMES} "${directory}/no-icd.json")
    neura(cpu run --no-gpu --stats "${image}" -- "fallback")
    neura(fallback run --gpu=always --gpu-software --gpu-verify --stats "${image}" -- "fallback")
    if(NOT cpu_status STREQUAL "0" OR NOT fallback_status STREQUAL "0")
        message(FATAL_ERROR "unavailable device did not fall back to CPU\n${fallback_stderr}")
    endif()
    compare_run("silent fallback without a GPU" fallback cpu)
    expect_error("--require-gpu: cannot create a Vulkan instance" run --require-gpu --gpu-software "${image}")
    file(WRITE "${directory}/invalid.nvr" "")
    neura(error run --require-gpu --gpu-software "${directory}/invalid.nvr")
    if(NOT error_status STREQUAL "1" OR NOT error_stderr MATCHES "^neura: error: .*malformed image:")
        message(FATAL_ERROR "invalid image should fail before device creation\n${error_stderr}")
    endif()
endif()
