// Prints the first launch argument. Without arguments the index is out of
// bounds and the run traps.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let FirstArgument = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line("first: " + args[0]);
        return program.ExitCode.Ok;
    };
);
