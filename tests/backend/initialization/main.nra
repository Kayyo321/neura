// Program initialization across two files: the imported file's statements and
// initializers run first, each file in source order, then main.
let console = import:Std.Io.Console;
let program = import:Std.Program;
let settings = import:Settings;

console.print_line("main: top-level statement");

let banner: string = "[" + settings.label + "]";

let Counter = class (
    export let value: int32 = 0;
    export let deinit = func() -> void {
        console.print_line("main: counter destroyed");
    }
);

let shared = new Counter();
shared.value = settings.counter;

let App = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        console.print_line("main: " + banner);
        if (shared.value == 42) {
            console.print_line("main: the shared counter holds 42");
        }
        destroy shared;
        return program.ExitCode.Ok;
    }
);
