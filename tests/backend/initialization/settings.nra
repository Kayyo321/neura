// Imported by main.nra, so its initialization runs first.
let console = import:Std.Io.Console;

console.print_line("settings: first statement");

let Settings = module (
    // A literal holds its value when the image is loaded.
    export let greeting: string = "hello";
    // Computed values are assigned in source order before main runs.
    export let label: string = greeting + " world";
    export let counter: int32 = answer();

    let answer = func() -> int32 {
        return 41 + 1;
    };
);

console.print_line("settings: " + Settings.label);
