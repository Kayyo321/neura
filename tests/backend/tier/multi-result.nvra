; Multi-word function results (NVR 1.7). The compiler does not emit them yet, so this
; image is assembled by hand; the graphs are the compiler's checked int64 compare,
; increment and add. tests/backend/tier_programs_tests.cpp runs it in every tier.
;
; F0 entry: prints a loop sum, then the two words of a recursive call, and discards
;           the words of another
; F1 loop(n): 300 times calls F2 (three words: int64, float64, text), prints the
;           last float and text words
; F2 add3(a, b) -> (a + b, 2.5, "w")
; F3 add(a, b) -> a + b, a single word
; F4 rec(i, n) -> (sum of i..n-1, n - i), recursive, two words
nvr 1.7 profile 1
entry 0

type 0 text
type 1 array 0
type 2 signed 32
type 3 unsigned 32
type 4 void
type 5 bool
type 6 signed 64
type 7 float 64
constant 0 type 2 bytes 00000000 ; 0
constant 1 type 2 bytes 01000000 ; 1
constant 2 type 6 bytes 0000000000000000 ; 0
constant 3 type 6 bytes 2c01000000000000 ; 300
constant 4 type 7 bytes 0000000000000440 ; 2.5
constant 5 type 6 bytes 3200000000000000 ; 50
constant 6 type 0 bytes 77 ; "w"
constant 7 type 6 bytes 0700000000000000 ; 7
constant 8 type 6 bytes 0100000000000000 ; 1

