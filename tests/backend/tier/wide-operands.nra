    export let.override main = func(args: string[]) -> program.ExitCode {
        let kind = "all";
        if (args.length > 0) {
            kind = args[0];
        }
        let all = kind == "all";
        if (all || kind == "list") {
            report("list", wide_list());
        }
        if (all || kind == "array") {
            report("array", wide_array());
        }
        if (all || kind == "text") {
            report("text", wide_text());
        }
        if (all || kind == "call") {
