// Operand counts above 255 in tier 2 and tier 3: a list literal, an array
// literal, a text list and a call each take 300 operands, more than an
// operation of a region or program can count, so formation leaves those
// exits to the interpreter (docs/runtime/NVM.md, "Execution tiers"). The
// first argument picks the case:
//   list    a list literal of 300 int64 values
//   array   an array literal of 300 int64 values
//   text    a list literal of 300 text values
//   call    a call of a function with 300 parameters
//   all     every case above
// tests/backend/tier_programs_tests.cpp runs it at every tier.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let WideOperands = module:program.Entry (
    let report = func(label: string, value: int64) {
        console.print_line(label + " " + value.to_string());
