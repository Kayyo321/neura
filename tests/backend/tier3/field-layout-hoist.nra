// A preheader may check Cell without proving that it can read Special.extra.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Cell = class (
    export let value: int = 1;
);

let Special = class:Cell (
    export let extra: int = 7;
);

let walk = func(values: int[list], c: Cell, sink: Cell, n: int) -> int {
    let total = 0;
    for (let i = 0; i < n; i = i + 1) {
        total = total + c.value;
        sink.value = total;
        if (values[i] == -5) {
            let s = c as Special;
            total = total + s.extra;
        }
    }
    return total;
};

let P = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let values: int[list] = new;
        for (let i = 0; i < 200; i = i + 1) {
            values.append(i);
        }
        let plain = new Cell();
        let sink = new Cell();
        let sum = 0;
        for (let w = 0; w < 500; w = w + 1) {
            sum = sum + walk(values, plain, sink, 200);
        }
        console.println("{}", sum);
        return program.ExitCode.Ok;
    };
);
