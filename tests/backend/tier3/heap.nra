// Heap access in tier 3 (docs/runtime/NVM.md, "Execution tiers"): field,
// element, length, tag and global reads and writes inline, class tests and
// casts, enum names, objects allocated and lists appended to in loops, a
// field read through a base-typed reference whose entries have more than 64
// fields, a read after `destroy`, and narrow element widths. The first
// argument picks the case, the second the size. tests/backend/tier3_heap_tests.cpp
// runs it at every tier and limit.
let console = import:Std.Io.Console;
let int32s = import:Std.Core.Int32;
let program = import:Std.Program;
let result = import:Std.Core.Result;

let Tier3Heap = module:program.Entry (
    const Mask: int64 = 1048575;

    let Base = class (
        export let a: int64 = 1;
        export let b: int64 = 2;
    );

    // More than 64 fields: the initialized words take two words, so its
    // fields start eight bytes later than Base's.
    let Wide = class:Base (
        export let w0: int64 = 0;
        export let w1: int64 = 1;
        export let w2: int64 = 2;
        export let w3: int64 = 3;
        export let w4: int64 = 4;
        export let w5: int64 = 5;
        export let w6: int64 = 6;
        export let w7: int64 = 7;
        export let w8: int64 = 8;
        export let w9: int64 = 9;
        export let w10: int64 = 10;
        export let w11: int64 = 11;
        export let w12: int64 = 12;
        export let w13: int64 = 13;
        export let w14: int64 = 14;
        export let w15: int64 = 15;
        export let w16: int64 = 16;
        export let w17: int64 = 17;
        export let w18: int64 = 18;
        export let w19: int64 = 19;
        export let w20: int64 = 20;
        export let w21: int64 = 21;
        export let w22: int64 = 22;
        export let w23: int64 = 23;
        export let w24: int64 = 24;
        export let w25: int64 = 25;
        export let w26: int64 = 26;
        export let w27: int64 = 27;
        export let w28: int64 = 28;
        export let w29: int64 = 29;
        export let w30: int64 = 30;
        export let w31: int64 = 31;
        export let w32: int64 = 32;
        export let w33: int64 = 33;
        export let w34: int64 = 34;
        export let w35: int64 = 35;
        export let w36: int64 = 36;
        export let w37: int64 = 37;
        export let w38: int64 = 38;
        export let w39: int64 = 39;
        export let w40: int64 = 40;
        export let w41: int64 = 41;
        export let w42: int64 = 42;
        export let w43: int64 = 43;
        export let w44: int64 = 44;
        export let w45: int64 = 45;
        export let w46: int64 = 46;
        export let w47: int64 = 47;
        export let w48: int64 = 48;
        export let w49: int64 = 49;
        export let w50: int64 = 50;
        export let w51: int64 = 51;
        export let w52: int64 = 52;
        export let w53: int64 = 53;
        export let w54: int64 = 54;
        export let w55: int64 = 55;
        export let w56: int64 = 56;
        export let w57: int64 = 57;
        export let w58: int64 = 58;
        export let w59: int64 = 59;
        export let w60: int64 = 60;
        export let w61: int64 = 61;
        export let w62: int64 = 62;
        export let w63: int64 = 63;
        export let w64: int64 = 64;
        export let w65: int64 = 65;
        export let w66: int64 = 66;
        export let w67: int64 = 67;
        export let w68: int64 = 68;
        export let w69: int64 = 69;
    );

    let Small = class:Base (
        export let c: int64 = 3;
    );

    let Cell = class (
        export last value: int64;
        export let next: int64 = 0;
        export let init = func(start: int64) {
            value = start;
        };
    );

    let Color = enum (Red, Green, Blue, Violet);

    let total: int64 = 0;

    let report = func(label: string, value: int64) {
        console.print_line(label + " " + value.to_string());
    };

    // Objects allocated in a loop through a constructor, their fields read
    // and written, kept in a list and read back by index.
    let objects = func(n: int32) -> int64 {
        let cells: Cell[list] = [];
        for (let i = 0; i < n; i = i + 1) {
            let cell = new Cell(i as int64);
            cell.next = cell.value * 2 + 1;
            cells.append(cell);
        }
        let sum: int64 = 0;
        for (let i = 0; i < cells.length; i = i + 1) {
            sum = (sum + cells[i].value + cells[i].next) & Mask;
        }
        return sum;
    };

    // Appends to lists of two widths in a loop, and reads them back.
    let append = func(n: int32) -> int64 {
        let bytes: uint8[list] = [];
        let words: int64[list] = [];
        for (let i = 0; i < n; i = i + 1) {
            bytes.append((i % 251) as uint8);
            words.append((i * 7) as int64);
        }
        let sum: int64 = 0;
        for (let i = 0; i < bytes.length; i = i + 1) {
            sum = (sum + (bytes[i] as int64) * 3 + words[i]) & Mask;
            bytes[i] = ((i * 5) % 256) as uint8;
        }
        for (let i = 0; i < bytes.length; i = i + 1) {
            sum = (sum + (bytes[i] as int64)) & Mask;
        }
        return sum;
    };

    // Fields read and written through a Base reference to entries of three
    // layouts, two of them with one initialized word and one with two.
    let poke = func(item: Base, by: int64) -> int64 {
        item.b = item.b + by;
        return item.a + item.b;
    };

    let wide = func(n: int32) -> int64 {
        let items: Base[list] = [new Base(), new Wide(), new Small()];
        let sum: int64 = 0;
        for (let i = 0; i < n; i = i + 1) {
            sum = (sum + poke(items[i % 3], i as int64)) & Mask;
        }
        return sum;
    };

    // A field read after the object was destroyed: an invalid handle. The
    // read comes first in the loop, before the destruction that a later
    // iteration's read must see.
    let destroyed = func(n: int32) -> int64 {
        let sum: int64 = 0;
        let keep = new Cell(5);
        for (let i = 0; i < n; i = i + 1) {
            sum = sum + keep.value;
            if (i == n - 3) {
                destroy keep;
            }
        }
        return sum;
    };

    // A list and an object read on both sides of appends (helpers that may
    // collect, and grow the list): the entries, the list's length and its
    // element storage are read again after each.
    let around = func(n: int32) -> int64 {
        let cell = new Cell(3);
        let values: int64[list] = [];
        let sum: int64 = 0;
        for (let i = 0; i < n; i = i + 1) {
            values.append(cell.value + (i as int64));
            let last = values[values.length - 1];
            values.append(last + cell.next);
            sum = (sum + values[values.length - 1] + (values.length as int64)) & Mask;
            cell.next = cell.next + 1;
        }
        return sum;
    };

    // An append and an allocation inside functions the caller inlines: their
    // slow paths (a collection, a new chunk, a growth, a limit) materialize
    // the inlined frame and leave at the helper's resume block, while the
    // caller's loop values live in its frame across them.
    let push = func(list: int64[list], value: int64) {
        list.append(value);
    };

    let fresh = func(value: int64) -> Base {
        let item = new Base();
        item.a = value;
        return item;
    };

    let inlined = func(n: int32) -> int64 {
        let values: int64[list] = [];
        let total: int64 = 0;
        let step: int64 = 7;
        for (let i = 0; i < n; i = i + 1) {
            push(values, (i as int64) * 3);
            let item = fresh(i as int64);
            total = (total + item.a + item.b + step + (values.length as int64)) & Mask;
            step = step + 1;
        }
        return total + step;
    };

    // A module global read and written in a loop.
    let globals = func(n: int32) -> int64 {
        for (let i = 0; i < n; i = i + 1) {
            total = (total + (i as int64)) & Mask;
        }
        return total;
    };

    // Class tests and casts on a list of mixed entries.
    let classes = func(n: int32) -> int64 {
        let items: Base[list] = [new Base(), new Wide(), new Small(), new Wide()];
        let sum: int64 = 0;
        for (let i = 0; i < n; i = i + 1) {
            let item = items[i % 4];
            if (item is Wide) {
                sum = sum + (item as Wide).w65;
            } else if (item is Small) {
                sum = sum + (item as Small).c;
            } else {
                sum = sum + 1;
            }
        }
        return sum;
    };

    // A cast that fails after some iterations.
    let bad_cast = func(n: int32) -> int64 {
        let items: Base[list] = [new Wide(), new Wide(), new Small()];
        let sum: int64 = 0;
        for (let i = 0; i < n; i = i + 1) {
            sum = sum + (items[i % 3] as Wide).w1;
        }
        return sum;
    };

    // Enum names.
    let names = func(n: int32) -> int64 {
        let colors: Color[list] = [Color.Red, Color.Green, Color.Blue, Color.Violet];
        let sum: int64 = 0;
        for (let i = 0; i < n; i = i + 1) {
            sum = sum + (colors[i % 4].to_string().byte_length as int64);
        }
        return sum;
    };

    // An index past the end after some iterations.
    let overrun = func(n: int32) -> int64 {
        let values: int64[] = [1, 2, 3, 4, 5, 6, 7, 8];
        let sum: int64 = 0;
        for (let i = 0; i < n; i = i + 1) {
            sum = sum + values[i];
        }
        return sum;
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        let kind = "objects";
        let size = 100;
        if (args.length > 0) {
            kind = args[0];
        }
        if (args.length > 1) {
            size = result.value_or<int32>(int32s.parse(args[1]), 100);
        }
        if (kind == "objects") {
            report("objects", objects(size));
        } else if (kind == "append") {
            report("append", append(size));
        } else if (kind == "wide") {
            report("wide", wide(size));
        } else if (kind == "destroyed") {
            report("destroyed", destroyed(size));
        } else if (kind == "around") {
            report("around", around(size));
        } else if (kind == "inlined") {
            report("inlined", inlined(size));
        } else if (kind == "globals") {
            report("globals", globals(size));
        } else if (kind == "classes") {
            report("classes", classes(size));
        } else if (kind == "cast") {
            report("cast", bad_cast(size));
        } else if (kind == "names") {
            report("names", names(size));
        } else if (kind == "overrun") {
            report("overrun", overrun(size));
        }
        return program.ExitCode.Ok;
    };
);
