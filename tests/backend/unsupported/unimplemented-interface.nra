// expect: 10:9 module 'Logger' does not implement 'log'
let io = import:SysIo;

let Logger = module (
    export let log = func(string message) -> void;
);

let App = module:io.Entry (
    export let.override main = func(string[] args) -> Entry.ExitCode {
        Logger.log("hello");
        return Entry.ExitCode.Ok;
    }
);
