// expect: 12:16 generic specialization does not terminate: the type arguments of 'grow
let console = import:Std.Io.Console;
let program = import:Std.Program;

// Each instance calls the next with a deeper type argument, so the set of
// instances is infinite.
let Grow = module:program.Entry (
    let grow = func<T>(value: T, depth: int32) -> int32 {
        if (depth == 0) {
            return 0;
        }
        return grow<T[]>([value], depth - 1) + 1;
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        if (grow<int32>(1, 3) == 3) {
            console.print_line("three");
        }
        return program.ExitCode.Ok;
    };
);
