// expect: 5:35 initializer of 'greeting' is not a constant
let io = import:SysIo;

let App = module:io.Entry (
    export let greeting: string = "a" + "b";

    export let.override main = func(string[] args) -> Entry.ExitCode {
        io.println(greeting);
        return Entry.ExitCode.Ok;
    }
);
