// status: 70
// stderr: index out of bounds: index 2 for length 2
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Bounds = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        let names: string[] = ["Ada", "Lin"];
        let position: uint8 = 2;
        console.print_line(names[position - 1]);
        console.print_line(names[position]);
        return program.ExitCode.Ok;
    }
);
