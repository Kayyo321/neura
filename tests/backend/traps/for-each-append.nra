// status: 134
// stderr: collection modified during iteration \(trap reason 5\) .* at for-each-append\.nra:12:9
let console = import:Std.Io.Console;
let program = import:Std.Program;

// Appending to a list while a for-each loop visits it fails at the loop
// before the next element is visited.
let Grow = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let queue: string[list] = ["first", "second"];
        let seen: int32 = 0;
        for (let item in queue) {
            console.print_line("visit " + item);
            if (seen == 0) {
                queue.append("third");
            }
            seen = seen + 1;
        }
        console.print_line("unreachable");
        return program.ExitCode.Ok;
    };
);
