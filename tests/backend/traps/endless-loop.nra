// status: 152
// run-options: --max-steps 1000
// stderr: step limit exceeded: 1000 steps
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Loop = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line("looping");
        let count: uint64 = 0;
        do {
            count++;
        }
    };
);
