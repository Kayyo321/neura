// status: 70
// run-options: --max-steps 1000
// stderr: step limit exceeded: 1000 steps
let io = import:SysIo;

let Loop = module:io.Entry (
    export let.override main = func(string[] args) -> Entry.ExitCode {
        io.println("looping");
        let count: uint64 = 0;
        while (true) {
            count = count + 1;
        }
    }
);
