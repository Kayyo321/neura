// status: 139
// stderr: read of an uninitialized global: global [0-9]+ in function 0 block [0-9]+ at uninitialized-global\.nra:16:20
let console = import:Std.Io.Console;
let program = import:Std.Program;

let App = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        return program.ExitCode.Ok;
    }
);

console.print_line("start");

// Later's initializer runs after this one, in source order, so the read
// faults. A literal initializer would already hold its value.
let first: int32 = Later.value + 1;

let Later = module (
    export let value: int32 = 2 * 3;
);
