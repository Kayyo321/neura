// status: 70
// stderr: source arithmetic failure \(trap reason 1\) in function [0-9]+ block [0-9]+ at overflow\.nra:8:16
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Overflow = module:program.Entry (
    let increment = func(int8 value) -> int8 {
        return value + 1;
    };

    export let.override main = func(string[] args) -> program.ExitCode {
        console.print_line("before overflow");
        if (increment(127) > 0) {
            console.print_line("unreachable");
        }
        return program.ExitCode.Ok;
    }
);
