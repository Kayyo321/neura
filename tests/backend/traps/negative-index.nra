// status: 70
// stderr: source bounds failure \(trap reason 2\)
let io = import:SysIo;

let Bounds = module:io.Entry (
    export let.override main = func(string[] args) -> Entry.ExitCode {
        let names: string[] = ["Ada", "Lin"];
        let position: int32 = -1;
        io.println(names[position + 1]);
        io.println(names[position]);
        return Entry.ExitCode.Ok;
    }
);
