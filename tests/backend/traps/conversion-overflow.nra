// status: 70
// stderr: source arithmetic failure \(trap reason 1\) .* at conversion-overflow\.nra:7:16
let io = import:SysIo;

let Narrow = module:io.Entry (
    let to_byte = func(int32 value) -> byte {
        return value as byte;
    };

    export let.override main = func(string[] args) -> Entry.ExitCode {
        if (to_byte(255) == 255) {
            io.println("255 fits in a byte");
        }
        if (to_byte(-1) == 255) {
            io.println("unreachable");
        }
        return Entry.ExitCode.Ok;
    }
);
