// status: 70
// stderr: invalid reference handle
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Lifetime = module:program.Entry (
    let Note = class (
        export let text: string = "note";
    );

    export let.override main = func(string[] args) -> program.ExitCode {
        let note = new Note();
        console.print_line(note.text);
        destroy note;
        console.print_line(note.text);
        return program.ExitCode.Ok;
    }
);
