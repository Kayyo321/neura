// status: 70
// stderr: explicit program failure \(trap reason 3\): rejected: café.*message-trap[.]nra:
let program = import:Std.Program;

let Main = module:program.Entry (
    let stop = func(string reason) -> int {
        trap_with_message("rejected: " + reason);
    };

    export let.override main = func(string[] args) -> program.ExitCode {
        stop("café");
        return program.ExitCode.Ok;
    };
);
