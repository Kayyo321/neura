// Functions over objects, collections, and loops, compared against the
// NeuraIR reference evaluator. Each takes and returns scalars so that the
// comparison can call it directly; the state it builds lives in the heap.
let Structures = module (
    let Counter = class (
        export let count: int16 = 0;
        export let bump = func(by: int16) -> void {
            count = count + by;
        };
    );

    let Base = class (
        export let order: int16 = 0;
        export let init = func(start: int16) -> void {
            order = start;
        };
        export let step = func() -> int16 {
            return 1;
        };
    );

    let Derived = class:Base (
        export let scale: int16 = 10;
        export let init = func(start: int16) -> void {
            super.init(start);
            order = order * scale;
        };
        export let.override step = func() -> int16 {
            return 2;
        };
    );

    export let two_counters = func(a: int8, b: int8) -> int16 {
        let first = new Counter();
        let second = new Counter();
        first.bump(a as int16);
        second.bump(b as int16);
        first.bump(a as int16);
        let result: int16 = first.count - second.count;
        destroy second;
        return result;
    };

    export let construction_order = func(a: int8, derived: bool) -> int16 {
        let item: Base = new Base(a as int16);
        if (derived) {
            item = new Derived(a as int16);
        }
        return item.order + item.step();
    };

    export let list_sum = func(a: int8, b: int8) -> int16 {
        let values: int16[list] = [a as int16, b as int16];
        values.append(values[0] + values[1]);
        let total: int16 = 0;
        for (let value in values) {
            total = total + value;
        }
        return total;
    };

    export let element = func(position: uint8) -> int8 {
        let values: int8[] = [10, 20, 30];
        return values[position];
    };

    export let remove = func(position: int8) -> int8 {
        let values: int8[list] = [1, 2, 3];
        values.remove_at(position);
        return values.length as int8;
    };

    export let grow_while_iterating = func(limit: uint8) -> uint8 {
        let values: uint8[list] = [1, 2, 3];
        let visits: uint8 = 0;
        for (let value in values) {
            visits = visits + 1;
            if (visits == limit) {
                values.append(value);
            }
        }
        return visits;
    };

    export let skip_and_stop = func(stop: uint8) -> uint8 {
        let total: uint8 = 0;
        for (let i: uint8 = 0; i < 20; i = i + 1) {
            if (i % 3 == 0) {
                continue;
            }
            if (i == stop) {
                break;
            }
            total = total + i;
        }
        return total;
    };
);

let program = import:Std.Program;

let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        return program.ExitCode.Ok;
    };
);
