let console = import:Std.Io.Console;
let program = import:Std.Program;
let tuples = import:Std.Probe.Tuples;

let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let sent: [int, [string, bool]] = [7, ["seven", true]];
        match (tuples.send(sent)) {
            tuples.Reply.Ok(value) => {
                console.print_line(value[1][0] + value[0].to_string() + value[1][1].to_string());
            },
            tuples.Reply.Error(code) => {
                console.print_line("error " + code.to_string());
            },
        }
        return program.ExitCode.Ok;
    };
);
