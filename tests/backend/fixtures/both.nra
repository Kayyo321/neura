// The conjunction from docs/Project.md, "Example from source to circuit".
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Logic = module (
    export let both = func(bool left, bool right) -> bool {
        return left && right;
    };
);

let Main = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        if (Logic.both(true, true)) {
            console.print_line("both");
        }
        return program.ExitCode.Ok;
    }
);
