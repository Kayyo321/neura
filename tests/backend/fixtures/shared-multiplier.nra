// Two int32 products of variables share one multiplier graph.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Shared = module:program.Entry (
    let area = func(int32 width, int32 height) -> int32 {
        return width * height;
    };

    let volume = func(int32 base, int32 depth) -> int32 {
        return base * depth;
    };

    export let.override main = func(string[] args) -> program.ExitCode {
        if (volume(area(2, 3), 4) == 24) {
            console.print_line("24");
        }
        return program.ExitCode.Ok;
    }
);
