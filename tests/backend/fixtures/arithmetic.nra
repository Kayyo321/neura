// Functions compared against the NeuraIR reference evaluator on the same
// inputs. Operations that trap, such as overflow, a zero divisor, or an
// out-of-range conversion, must trap with reason 1 in the compiled image.
let program = import:Std.Program;

let Arithmetic = module (
    export let add_i8 = func(a: int8, b: int8) -> int8 {
        return a + b;
    };

    export let sub_u8 = func(a: uint8, b: uint8) -> uint8 {
        return a - b;
    };

    export let mul_i8 = func(a: int8, b: int8) -> int8 {
        return a * b;
    };

    export let div_i8 = func(a: int8, b: int8) -> int8 {
        return a / b;
    };

    export let div_u8 = func(a: uint8, b: uint8) -> uint8 {
        return a / b;
    };

    export let negate_i8 = func(a: int8) -> int8 {
        return -a;
    };

    export let mixed_i8 = func(a: int8, b: int8) -> int8 {
        return (a - b) * 2 + a / 1 - -b;
    };

    export let guarded_i8 = func(a: int8, b: int8) -> bool {
        return a != 0 && b / a > 1 || a == 0 && b + a == b;
    };

    export let compare_i16 = func(a: int16, b: int16) -> bool {
        return a < b && b != 0 || a >= b && !(a == b);
    };

    export let poly_i32 = func(x: int32) -> int32 {
        return x * x - 3 * x + 2;
    };

    export let clamp_i64 = func(x: int64, low: int64, high: int64) -> int64 {
        if (x < low) {
            return low;
        }
        if (x > high) {
            return high;
        }
        return x;
    };

    export let triangle_u64 = func(n: uint64) -> uint64 {
        return n * (n + 1) / 2;
    };

    export let sum_to_u16 = func(limit: uint16) -> uint16 {
        let total: uint16 = 0;
        let current: uint16 = 0;
        while (current < limit) {
            current = current + 1;
            total = total + current;
        }
        return total;
    };

    export let first_root_above_i32 = func(n: int32) -> int32 {
        let i: int32 = 0;
        let found: int32 = -1;
        while (i < 100) {
            if (i * i > n) {
                found = i;
                break;
            }
            i = i + 1;
            if (i == 50) {
                continue;
            }
        }
        return found;
    };

    export let recursive_sum_u8 = func(n: uint8) -> uint8 {
        if (n == 0) {
            return 0;
        }
        return n + recursive_sum_u8(n - 1);
    };

    export let swap_difference_u32 = func(a: uint32, b: uint32) -> uint32 {
        if (a < b) {
            let t: uint32 = a;
            a = b;
            b = t;
        }
        return a - b;
    };

    export let rem_i8 = func(a: int8, b: int8) -> int8 {
        return a % b;
    };

    export let rem_u8 = func(a: uint8, b: uint8) -> uint8 {
        return a % b;
    };

    export let to_unsigned_i8 = func(a: int8) -> uint8 {
        return a as uint8;
    };

    export let to_signed_u8 = func(a: uint8) -> int8 {
        return a as int8;
    };

    export let narrow_i16 = func(a: int16) -> int8 {
        return a as int8;
    };

    export let widen_u8 = func(a: uint8) -> int64 {
        return a as int64 - 128;
    };

    export let digit_sum_u8 = func(a: uint8) -> uint8 {
        let total: uint8 = 0;
        for (let rest: uint8 = a; rest > 0; rest = rest / 10) {
            total = total + rest % 10;
        }
        return total;
    };
);

let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        return program.ExitCode.Ok;
    }
);
