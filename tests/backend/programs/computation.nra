// Integer and Boolean computation, loops, and calls. Each check prints a
// line only when the computed value matches, so stdout records the results.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Computation = module:program.Entry (
    let sum_to = func(limit: int32) -> int32 {
        let total: int32 = 0;
        let current: int32 = 1;
        while (current <= limit) {
            total = total + current;
            current = current + 1;
        }
        return total;
    };

    let factorial = func(n: int64) -> int64 {
        if (n <= 1) {
            return 1;
        }
        return n * factorial(n - 1);
    };

    // Euclid's algorithm by subtraction.
    let gcd = func(a: uint32, b: uint32) -> uint32 {
        while (a != b) {
            if (a > b) {
                a = a - b;
            } else {
                b = b - a;
            }
        }
        return a;
    };

    let first_square_above = func(limit: int16) -> int16 {
        let n: int16 = 0;
        while (true) {
            n = n + 1;
            if (n * n <= limit) {
                continue;
            }
            break;
        }
        return n;
    };

    let parity = func(value: uint8) -> bool {
        let odd: bool = false;
        while (value != 0) {
            odd = !odd;
            value = value - 1;
        }
        return odd;
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        if (sum_to(10) == 55) {
            console.print_line("sum_to(10) = 55");
        }
        if (sum_to(0) == 0) {
            console.print_line("sum_to(0) = 0");
        }
        if (factorial(20) == 2432902008176640000) {
            console.print_line("factorial(20) = 2432902008176640000");
        }
        if (gcd(1071, 462) == 21) {
            console.print_line("gcd(1071, 462) = 21");
        }
        if (first_square_above(50) == 8) {
            console.print_line("first_square_above(50) = 8");
        }
        if (parity(7) && !parity(10)) {
            console.print_line("parity(7) is odd and parity(10) is even");
        }
        let small: int8 = -128;
        if (small < 0 && -(small + 1) == 127) {
            console.print_line("int8 bounds hold");
        }
        let big: uint64 = 18446744073709551615;
        if (big > 9223372036854775807 && big - 1 == 18446744073709551614) {
            console.print_line("uint64 bounds hold");
        }
        if (-7 / 7 == -1 && 12 / -4 == -3) {
            console.print_line("exact signed division");
        }
        return program.ExitCode.Ok;
    }
);
