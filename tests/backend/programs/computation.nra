// Integer and Boolean computation, loops, and calls. Each check prints a
// line only when the computed value matches, so stdout records the results.
let io = import:SysIo;

let Computation = module:io.Entry (
    let sum_to = func(int32 limit) -> int32 {
        let total: int32 = 0;
        let current: int32 = 1;
        while (current <= limit) {
            total = total + current;
            current = current + 1;
        }
        return total;
    };

    let factorial = func(int64 n) -> int64 {
        if (n <= 1) {
            return 1;
        }
        return n * factorial(n - 1);
    };

    // Euclid's algorithm by subtraction.
    let gcd = func(uint32 a, uint32 b) -> uint32 {
        while (a != b) {
            if (a > b) {
                a = a - b;
            } else {
                b = b - a;
            }
        }
        return a;
    };

    let first_square_above = func(int16 limit) -> int16 {
        let n: int16 = 0;
        while (true) {
            n = n + 1;
            if (n * n <= limit) {
                continue;
            }
            break;
        }
        return n;
    };

    let parity = func(uint8 value) -> bool {
        let odd: bool = false;
        while (value != 0) {
            odd = !odd;
            value = value - 1;
        }
        return odd;
    };

    export let.override main = func(string[] args) -> Entry.ExitCode {
        if (sum_to(10) == 55) {
            io.println("sum_to(10) = 55");
        }
        if (sum_to(0) == 0) {
            io.println("sum_to(0) = 0");
        }
        if (factorial(20) == 2432902008176640000) {
            io.println("factorial(20) = 2432902008176640000");
        }
        if (gcd(1071, 462) == 21) {
            io.println("gcd(1071, 462) = 21");
        }
        if (first_square_above(50) == 8) {
            io.println("first_square_above(50) = 8");
        }
        if (parity(7) && !parity(10)) {
            io.println("parity(7) is odd and parity(10) is even");
        }
        let small: int8 = -128;
        if (small < 0 && -(small + 1) == 127) {
            io.println("int8 bounds hold");
        }
        let big: uint64 = 18446744073709551615;
        if (big > 9223372036854775807 && big - 1 == 18446744073709551614) {
            io.println("uint64 bounds hold");
        }
        if (-7 / 7 == -1 && 12 / -4 == -3) {
            io.println("exact signed division");
        }
        return Entry.ExitCode.Ok;
    }
);
