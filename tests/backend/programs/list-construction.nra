// A list is constructed with `new` in every accepted form (Storage030.md,
// Construction). Elements and range bounds are evaluated once, in written order.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Bag = class (
    export let items: int[list] = new([1, 2, 3]);
);

let trace = func(label: string, value: int) -> int {
    console.print_line("eval " + label);
    return value;
};

let describe = func(label: string, values: int[list]) {
    let text = label + ":";
    for (let value in values) {
        text = text + " " + value.to_string();
    }
    console.print_line(text + " (" + values.length.to_string() + ")");
};

let upto = func(count: int) -> int[list] {
    return new(0 .. count);
};

let wrap = func<T>(item: T) -> T[list] {
    return new([item, item]);
};

let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        describe("literal", new([4, 5, 6]));
        describe("empty", new);
        describe("typed", new int[list]([7, 8]));
        describe("typed empty", new int[list]());
        describe("range", new(0 .. 4));
        describe("stepped", new(10 .. 0 : -3));
        describe("typed range", new int[list](1 .. 3));
        describe("order", new([trace("a", 1), trace("b", 2), trace("c", 3)]));
        describe("bounds", new(trace("from", 2) .. trace("to", 5)));
        describe("field", new Bag().items);
        describe("result", upto(3));
        describe("generic", wrap<int>(9));
        let rows: int[list][list] = new([new([1]), new([2, 3]), new]);
        console.print_line(rows.length.to_string() + " " + rows[1].length.to_string() + " " + rows[2].length.to_string());
        let picked: int[list] = args.length > 100 ? new([1]) : new([2, 2]);
        describe("conditional", picked);
        let array: int[] = [1, 2, 3];
        console.print_line(array.length.to_string());
        return program.ExitCode.Ok;
    };
);
