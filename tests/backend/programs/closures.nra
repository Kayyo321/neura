let console = import:Std.Io.Console;
let program = import:Std.Program;

let Closures = module:program.Entry (
    let assert_equal = func(expected: int, actual: int) -> void {
        if (expected != actual) {
            console.print_line("closure result differed");
        }
    };

    let global_offset: int = 1;
    let global_callback: func(int) -> int = func(n: int) -> int {
        return n + global_offset;
    };
    let immediate_value = func(n: int) -> int { return n; }(20) + 2;

    let twice = func(value: int) -> int {
        return value + value;
    };

    let apply = func(callback: func(int) -> int, value: int) -> int {
        return callback(value);
    };

    let make_adder = func(offset: int) -> func(int) -> int {
        return func(value: int) -> int {
            return offset + value;
        };
    };

    let Counter = class (
        let value: int = 0;
        export let stored: func(int) -> int = func(by: int) -> int {
            return increment(by);
        };
        export let increment = func(by: int) -> int {
            value = value + by;
            return value;
        };
        export let callback = func() -> func(int) -> int {
            return func(by: int) -> int {
                return increment(by);
            };
        };
        export let read_other = func(other: Counter) -> func() -> int {
            return func() -> int {
                return other.value;
            };
        };
    );

    export let.override main = func(args: string[]) -> program.ExitCode {
        let seed: int = 10;
        let add_seed = func(value: int) -> int {
            return value + seed;
        };
        seed = 100;
        assert_equal(13, add_seed(3));
        assert_equal(8, apply(twice, 4));
        assert_equal(22, immediate_value);
        assert_equal(6, global_callback(5));
        global_offset = 2;
        assert_equal(7, global_callback(5));

        let callbacks: (func(int) -> int)[] = [make_adder(2), make_adder(3)];
        assert_equal(7, callbacks[0](5));
        assert_equal(8, callbacks[1](5));
        let counter = new Counter();
        let bound = counter.increment;
        let captured = counter.callback();
        assert_equal(5, bound(5));
        assert_equal(7, captured(2));
        assert_equal(8, counter.stored(1));
        assert_equal(8, counter.read_other(counter)());

        let nested = func(outer: int) -> func(int) -> int {
            return func(inner: int) -> int {
                return seed + outer + inner;
            };
        };
        assert_equal(105, nested(2)(3));
        assert_equal(12, func(x: int) -> int { return x * 2; }(6));
        let [callback, argument] = func(offset: int) -> [func(int) -> int, int] {
            return [make_adder(offset), 3];
        }(9);
        assert_equal(12, callback(argument));
        console.print_line("closures passed");
        return program.ExitCode.Ok;
    }
);
