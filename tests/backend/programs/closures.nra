let io = import:SysIo;

let Closures = module:io.Entry (
    let assert_equal = func(int expected, int actual) -> void {
        if (expected != actual) {
            io.println("closure result differed");
        }
    };

    let global_offset: int = 1;
    let global_callback: func(int) -> int = func(int n) -> int {
        return n + global_offset;
    };
    let immediate_value = func(int n) -> int { return n; }(20) + 2;

    let twice = func(int value) -> int {
        return value + value;
    };

    let apply = func(func(int) -> int callback, int value) -> int {
        return callback(value);
    };

    let make_adder = func(int offset) -> func(int) -> int {
        return func(int value) -> int {
            return offset + value;
        };
    };

    let Counter = class (
        let value: int = 0;
        export let stored: func(int) -> int = func(int by) -> int {
            return increment(by);
        };
        export let increment = func(int by) -> int {
            value = value + by;
            return value;
        };
        export let callback = func() -> func(int) -> int {
            return func(int by) -> int {
                return increment(by);
            };
        };
        export let read_other = func(Counter other) -> func() -> int {
            return func() -> int {
                return other.value;
            };
        };
    );

    export let.override main = func(string[] args) -> Entry.ExitCode {
        let seed: int = 10;
        let add_seed = func(int value) -> int {
            return value + seed;
        };
        seed = 100;
        assert_equal(13, add_seed(3));
        assert_equal(8, apply(twice, 4));
        assert_equal(22, immediate_value);
        assert_equal(6, global_callback(5));
        global_offset = 2;
        assert_equal(7, global_callback(5));

        let callbacks: (func(int) -> int)[] = [make_adder(2), make_adder(3)];
        assert_equal(7, callbacks[0](5));
        assert_equal(8, callbacks[1](5));
        let counter = new Counter();
        let bound = counter.increment;
        let captured = counter.callback();
        assert_equal(5, bound(5));
        assert_equal(7, captured(2));
        assert_equal(8, counter.stored(1));
        assert_equal(8, counter.read_other(counter)());

        let nested = func(int outer) -> func(int) -> int {
            return func(int inner) -> int {
                return seed + outer + inner;
            };
        };
        assert_equal(105, nested(2)(3));
        assert_equal(12, func(int x) -> int { return x * 2; }(6));
        let [callback, argument] = func(int offset) -> [func(int) -> int, int] {
            return [make_adder(offset), 3];
        }(9);
        assert_equal(12, callback(argument));
        io.println("closures passed");
        return Entry.ExitCode.Ok;
    }
);
