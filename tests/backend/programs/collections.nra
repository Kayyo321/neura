// Arrays and lists with checked indexing. Lengths are not used: their type,
// int, has no specified width.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Collections = module:program.Entry (
    export let.override main = func(string[] args) -> program.ExitCode {
        let names: string[] = ["Ada", "Lin"];
        names[0] = "Grace";
        console.print_line(names[0] + " and " + names[1]);

        let queue: int32[list] = [1];
        queue.append(2);
        queue.append(3);
        queue.remove_at(0);
        if (queue[0] == 2 && queue[1] == 3) {
            console.print_line("list holds 2, 3");
        }

        let grid: string[][] = [["a", "b"], ["c"]];
        console.print_line(grid[0][1] + grid[1][0]);

        let position: uint8 = 1;
        let values: int64[] = [10, 20, 30];
        values[position] = values[position] + 5;
        if (values[1] == 25) {
            console.print_line("element updated through a uint8 index");
        }
        return program.ExitCode.Ok;
    }
);
