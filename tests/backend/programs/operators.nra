let console = import:Std.Io.Console;
let program = import:Std.Program;

let Operators = module:program.Entry (
    let reads: int = 0;
    let current: int = 3;

    let subject = func() -> int {
        reads = reads + 1;
        return current;
    };

    let change_subject = func() -> int {
        current = 2;
        return 1;
    };

    let fail = func() -> int {
        return 1 / 0;
    };

    let bit_ops = func(value: byte, count: uint64, signed_value: int8) -> bool {
        return (value & 10) == 8 && (value | 1) == 13 && (value ^ 3) == 15 &&
            (~value == 243) && (value << count) == 128 && (value >> count) == 0 &&
            (signed_value >> count) == -1 && ((1 as byte) << 7) == 128;
    };

    let wide_shift = func(value: uint64, count: int8) -> uint64 {
        return value << count;
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        if (subject() == change_subject() or 2 or 3 or fail() && reads == 1 && current == 2) {
            console.print_line("or captures the subject and short-circuits");
        }
        if (subject() == 1 and fail() || reads == 2) {
            console.print_line("and stops at the first false comparison");
        }
        if (subject() >= 0 and 1 and 2 && reads == 3) {
            console.print_line("and requires each comparison");
        }
        if (bit_ops(12, 5, -3) && (wide_shift(1, 63) == 9223372036854775808) &&
            ((~0 as int64) == -1) && (128 as byte << 1) == 0) {
            console.print_line("fixed-width bitwise operations");
        }
        return program.ExitCode.Ok;
    };
);
