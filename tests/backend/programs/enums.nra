// Enums declared in source: qualified variants, equality, ordinals through
// `as`, enums as fields and parameters, and an enum in a generic box.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let Enums = module:program.Entry (
    export let Light = enum (Red, Yellow, Green);

    let next = func(current: Light) -> Light {
        if (current == Light.Red) {
            return Light.Green;
        }
        if (current == Light.Green) {
            return Light.Yellow;
        }
        return Light.Red;
    };

    let Signal = class (
        export let state: Light = Light.Red;
        export let advance = func() -> void {
            state = next(state);
        };
    );

    let Holder = class<T> (
        export let item: T;
    );

    export let.override main = func(args: string[]) -> program.ExitCode {
        let signal = new Signal();
        signal.advance();
        if (signal.state == Light.Green) {
            console.print_line("red advances to green");
        }
        signal.advance();
        if (signal.state != Light.Green && signal.state == Light.Yellow) {
            console.print_line("green advances to yellow");
        }
        if (Light.Red as int32 == 0 && Light.Yellow as uint8 == 1 && Light.Green as int64 == 2) {
            console.print_line("ordinals follow declaration order");
        }
        let holder = new Holder<Light>();
        holder.item = next(Light.Yellow);
        if (holder.item == Light.Red) {
            console.print_line("an enum in a generic box");
        }
        return program.ExitCode.Ok;
    }
);
