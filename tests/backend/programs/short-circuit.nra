// The right operand of && and || runs only when the left operand does not
// decide the result. Skipped operands here would print or trap.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let ShortCircuit = module:program.Entry (
    let evaluated: int32 = 0;

    let noisy = func(bool value, string label) -> bool {
        console.print_line("evaluated " + label);
        evaluated = evaluated + 1;
        return value;
    };

    let increments = func(int8 value) -> bool {
        return value + 1 > value;
    };

    export let.override main = func(string[] args) -> program.ExitCode {
        if (noisy(false, "left of &&") && noisy(true, "right of &&")) {
            console.print_line("unexpected");
        }
        if (noisy(true, "left of ||") || noisy(false, "right of ||")) {
            console.print_line("|| decided by its left operand");
        }
        if (noisy(true, "left of &&") && noisy(false, "right of &&")) {
            console.print_line("unexpected");
        } else {
            console.print_line("&& evaluated both operands");
        }

        let largest: int8 = 127;
        let check: bool = false;
        if (check && largest + 1 > largest) {
            console.print_line("unexpected");
        }
        if (!check || increments(largest)) {
            console.print_line("skipped operands did not trap");
        }

        let small: int8 = 5;
        let limit: int8 = 10;
        if (small < limit && limit > small) {
            console.print_line("comparisons combine in one graph");
        }
        if (evaluated == 4) {
            console.print_line("four operands evaluated");
        }
        return program.ExitCode.Ok;
    }
);
