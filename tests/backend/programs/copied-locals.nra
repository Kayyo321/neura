let console = import:Std.Io.Console;
let program = import:Std.Program;

// A local initialized from another local holds a copy of that local's value.
// A store to the source later in the same block must not reach the copy,
// whether the copy is captured by a closure, passed to a call or a
// constructor, or used as a method argument.
export let CopiedLocals = module:program.Entry (
    let Box = class (
        export let count: int = 0;
        export let add = func(amount: int) -> int {
            count = count + amount;
            return count;
        };
    );

    let Holder = class (
        export let held: int = 0;
        export let init = func(value: int) -> void {
            held = value;
        };
    );

    let pair = func(first: int, second: int) -> int => first * 10 + second;

    let seven = func() -> int {
        return 7;
    };

    let print_all = func(label: string, actions: (func() -> int)[list]) -> void {
        let text = label + ":";
        for (let action in actions) {
            text = text + " " + action().to_string();
        }
        console.print_line(text);
    };

    // The source is a parameter.
    let from_parameter = func(start: int) -> func() -> int {
        let copy = start;
        start = start + 100;
        return new func() -> int => copy;
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        // The reported case: a while loop whose body copies, then advances.
        let actions: (func() -> int)[list] = new;
        let current = 0;
        while (current < 2) {
            let value = current;
            current = current + 1;
            actions.append(new func() -> int => value);
        }
        print_all("while", actions);

        // A for loop over a range.
        let ranged: (func() -> int)[list] = new;
        let total = 0;
        for (let step in 1 ..= 3) {
            let before = total;
            total = total + step;
            ranged.append(new func() -> int => before);
        }
        print_all("for", ranged);

        // Nested blocks: the copy is made in the loop body, the store and the
        // capture in blocks nested inside it.
        let nested: (func() -> int)[list] = new;
        let level = 0;
        while (level < 2) {
            let outer = level;
            {
                level = level + 1;
                {
                    nested.append(new func() -> int => outer);
                }
            }
        }
        print_all("nested", nested);

        // The same under an `if`, whose condition ends the block that made
        // the copy before the store.
        let guarded: (func() -> int)[list] = new;
        let depth = 5;
        if (depth > 0) {
            let held = depth;
            if (held > 1) {
                depth = depth + 10;
                guarded.append(new func() -> int => held);
            }
        }
        print_all("guarded", guarded);

        // A copy of a copy.
        let chained: (func() -> int)[list] = new;
        let origin = 0;
        while (origin < 2) {
            let first = origin;
            let second = first;
            origin = origin + 1;
            chained.append(new func() -> int => second);
        }
        print_all("chain", chained);

        // A copy of a parameter.
        let from_start: (func() -> int)[list] = new;
        from_start.append(from_parameter(3));
        print_all("parameter", from_start);

        // A copy of a field.
        let fielded: (func() -> int)[list] = new;
        let box = new Box();
        box.count = 4;
        let counted = box.count;
        box.count = box.count + 1;
        fielded.append(new func() -> int => counted);
        print_all("field", fielded);

        // A copy of a tuple, one word per slot.
        let tupled: (func() -> int)[list] = new;
        let index = 0;
        while (index < 2) {
            let pair: [int, int] = [index, index + 10];
            let snapshot = pair;
            index = index + 1;
            pair = [index * 100, index * 100];
            tupled.append(new func() -> int => snapshot[0] + snapshot[1]);
        }
        print_all("tuple", tupled);

        // The source is reassigned in one branch or the other.
        let branched: (func() -> int)[list] = new;
        let choice = 0;
        while (choice < 2) {
            let kept = choice;
            if (choice == 0) {
                choice = choice + 1;
            } else {
                choice = choice + 5;
            }
            branched.append(new func() -> int => kept);
        }
        print_all("branch", branched);

        // No store after the copy: the capture sees the same value.
        let unchanged: (func() -> int)[list] = new;
        let fixed = 9;
        let same = fixed;
        unchanged.append(new func() -> int => same);
        print_all("unchanged", unchanged);

        // Without a closure: a call whose later argument is a call, a
        // constructor, and a method call.
        let called = 0;
        while (called < 2) {
            let copied = called;
            called = called + 1;
            console.print_line("call " + pair(copied, seven()).to_string());
        }
        let constructed = 0;
        while (constructed < 2) {
            let copied = constructed;
            constructed = constructed + 1;
            let holder = new Holder(copied);
            console.print_line("constructor " + holder.held.to_string());
        }
        let counter = new Box();
        let added = 1;
        while (added < 3) {
            let copied = added;
            added = added + 1;
            console.print_line("method " + counter.add(copied).to_string());
        }
        return program.ExitCode.Ok;
    };
);
