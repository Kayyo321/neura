let console = import:Std.Io.Console;
let program = import:Std.Program;
let int32s = import:Std.Core.Int32;
let result = import:Std.Core.Result;

let evolve = func(initial: float64, mode: int, coefficients: float64[]) -> [float64, float64] {
    let current = initial;
    let prior = initial;
    for (let i = 0; i < 4000; i++) {
        let index = i % 3;
        if (i == 3999 && mode == 1) {
            index = -1;
        }
        last next = current * coefficients[index];
        prior = next;
        current = next;
        if (i == 3999 && mode == 2) {
            index = coefficients.length;
        }
        current = current * coefficients[index];
    }
    return [current, prior];
};

export let FrameOnlyLoopPhis = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        last mode = result.value_or<int32>(int32s.parse(args[0]), 0);
        last coefficients: float64[] = [1.0, -1.0, 2.0];
        let [zero, prior_zero] = evolve(-0.0, mode, coefficients);
        last nan = float64.from_bits(9221120237041090561u64);
        let [invalid, prior_invalid] = evolve(nan, mode, coefficients);
        console.println("{:x} {:x} {:x} {:x}",
            zero.to_bits(), prior_zero.to_bits(), invalid.to_bits(), prior_invalid.to_bits());
        return program.ExitCode.Ok;
    };
);
