let console = import:Std.Io.Console;
let program = import:Std.Program;
let int32s = import:Std.Core.Int32;
let result = import:Std.Core.Result;

export let HoistedBounds = module:program.Entry (
    let sum_rows = func(rows: int[][], mode: int) -> int64 {
        let sum: int64 = 0;
        for (let turn = 0; turn < 4000; turn++) {
            last index = turn % rows.length;
            last row = rows[index];
            let offset = 0;
            if (turn == 3999 && mode == 1) {
                offset = -1;
            } else if (turn == 3999 && mode == 2) {
                offset = row.length;
            }
            for (let column = 0; column < row.length; column++) {
                sum += (rows[index][column + offset] as int64) * (row.length as int64);
            }
        }
        return sum;
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        last mode = result.value_or<int32>(int32s.parse(args[0]), 0);
        last rows: int[][] = [[1, 2, 3], [], [-2147483648, 2147483647]];
        console.println("{}", sum_rows(rows, mode));
        return program.ExitCode.Ok;
    };
);
