// Row 12, added after the freeze for append coverage.
// The optional argument is the number of rounds per phase.
let builders = import:Std.Core.StringBuilder;
let console = import:Std.Io.Console;
let int32s = import:Std.Core.Int32;
let program = import:Std.Program;
let result = import:Std.Core.Result;
let strings = import:Std.Text.Strings;

export let AppendCoverage = module:program.Entry (
    const DefaultRounds = 50000;
    const ChunkInterval = 128;
    const Mask: int64 = 1073741823;

    let append_record = func(builder: builders.StringBuilder, piece: string, number: int64) {
        builder.append("");
        builder.append("x");
        builder.append("abcdefghijklmno");
        builder.append(piece);
        builder.append_int(number);
        builder.append(";");
    };

    let mix_bytes = func(checksum: int64, text: string) -> int64 {
        let value = checksum;
        for (let i = 0; i < text.byte_length; i += 1) {
            value = (value * 31 + (text.byte_at(i) as int64)) & Mask;
        }
        return value;
    };

    let growing_checksum = func(pieces: string[list], chunks: string[list], rounds: int) -> int64 {
        last builder = builders.create();
        for (let i = 0; i < rounds; i += 1) {
            append_record(builder, pieces[i % pieces.length], i as int64);
            if (i % ChunkInterval == 0) {
                builder.append(chunks[(i / ChunkInterval) % chunks.length]);
            }
        }
        return mix_bytes(0, builder.to_string());
    };

    let short_lived_checksum = func(pieces: string[list], rounds: int, initial: int64) -> int64 {
        let checksum = initial;
        for (let i = 0; i < rounds; i += 1) {
            last builder = builders.create();
            last index = i % pieces.length;
            last number = i as int64;
            append_record(builder, pieces[index], -number - 1);
            append_record(builder, pieces[pieces.length - 1 - index], number);
            checksum = mix_bytes(checksum, builder.to_string());
        }
        return checksum;
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        let rounds = DefaultRounds;
        if (args.length > 0) {
            rounds = result.value_or<int32>(int32s.parse(args[0]), DefaultRounds);
        }
        // The six middle pieces cover 15, 16 and 17 UTF-8 bytes in both forms.
        last pieces: string[list] = new([
            "", "b",
            "abcdefghijklmno", "abcdefghijklmnop", "abcdefghijklmnopq",
            "é🙂é🙂abc", "é🙂é🙂abcd", "é🙂é🙂abcde",
            strings.repeat("0123456789abcdef", 4), strings.repeat("é🙂ab", 8)
        ]);
        last chunks: string[list] = new([
            strings.repeat("0123456789abcdef", 256), strings.repeat("é🙂ab", 512)
        ]);
        last initial = growing_checksum(pieces, chunks, rounds);
        console.println("{}", short_lived_checksum(pieces, rounds, initial));
        return program.ExitCode.Ok;
    };
);
