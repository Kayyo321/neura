// sizes: quick 1500 full 15000 long 2000000
// Text processing: for each of n lines, formats eight pseudo-random fields
// (numbers and words, padded with spaces) into a comma-separated line, splits
// it at the commas, trims each field, counts the fields equal to "beta",
// joins the fields with "|", and folds the bytes of the joined text into a
// checksum. The size is the first argument; java/TextSplit.java prints the
// same line.
let builders = import:Std.Core.StringBuilder;
let console = import:Std.Io.Console;
let int32s = import:Std.Core.Int32;
let program = import:Std.Program;
let result = import:Std.Core.Result;
let strings = import:Std.Text.Strings;

export let TextSplit = module:program.Entry (
    const Fields: int = 8;
    const Mask: int64 = 1073741823;

    let Words: string[] = ["alpha", "beta", "gamma", "delta"];

    export let.override main = func(args: string[]) -> program.ExitCode {
        last n = result.value_or<int32>(int32s.parse(args[0]), 0);
        let seed: int64 = 12345;
        let matches = 0;
        let bytes: int64 = 0;
        let checksum: int64 = 0;
        for (let i = 0; i < n; i = i + 1) {
            last line = builders.create();
            for (let field = 0; field < Fields; field = field + 1) {
                seed = (seed * 1103515245 + 12345) & 2147483647;
                if (field > 0) {
                    line.append(",");
                }
                for (let pad: int64 = 0; pad < seed % 3; pad = pad + 1) {
                    line.append(" ");
                }
                if (seed % 4 == 0) {
                    line.append(Words[((seed >> 8) % 4) as int]);
                } else {
                    line.append_int((seed >> 8) % 200000 - 100000);
                }
                if ((seed >> 4) % 2 == 0) {
                    line.append("  ");
                }
            }
            last parts = strings.split(line.to_string(), ",");
            last fields: string[list] = [];
            for (let k = 0; k < parts.length; k = k + 1) {
                last trimmed = strings.trim(parts[k]);
                if (trimmed == "beta") {
                    matches = matches + 1;
                }
                fields.append(trimmed);
            }
            last joined = strings.join(fields, "|");
            bytes = bytes + (joined.byte_length as int64);
            for (let k = 0; k < joined.byte_length; k = k + 1) {
                checksum = (checksum * 31 + (joined.byte_at(k) as int64)) & Mask;
            }
        }
        console.println("text-split {} {} {}", matches, bytes, checksum);
        return program.ExitCode.Ok;
    };
);
