// sizes: quick 30000 full 250000
// Sorts n pseudo-random int32 values with Std.Collections.Sorting.sort and
// Int32.compare, checks the order, and folds the sorted values into a
// checksum. The size is the first argument; java/Sort.java prints the same
// line with a port of the same stable sort.
let console = import:Std.Io.Console;
let int32s = import:Std.Core.Int32;
let program = import:Std.Program;
let result = import:Std.Core.Result;
let sorting = import:Std.Collections.Sorting;

export let Sort = module:program.Entry (
    const Mask: int64 = 1073741823;

    export let.override main = func(args: string[]) -> program.ExitCode {
        let n = result.value_or<int32>(int32s.parse(args[0]), 0);
        let items: int32[list] = [];
        let seed: uint64 = 12345;
        for (let i = 0; i < n; i = i + 1) {
            seed = (seed * 1103515245 + 12345) & 2147483647;
            items.append((seed % 1000000) as int32);
        }
        sorting.sort<int32>(items, int32s.compare);
        let checksum: int64 = 0;
        for (let i = 0; i < items.length; i = i + 1) {
            if (i > 0 && items[i - 1] > items[i]) {
                console.print_line("not sorted");
                return program.ExitCode.Failure;
            }
            checksum = (checksum * 31 + (items[i] as int64)) & Mask;
        }
        console.println("sort {}", checksum);
        return program.ExitCode.Ok;
    };
);
