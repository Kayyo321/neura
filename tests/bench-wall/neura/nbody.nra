// sizes: quick 250 full 2500 long 35000000
// N-body simulation of the Jovian planets around the sun with a symplectic
// integrator: the system's energy before and after n steps, as float64 bit
// patterns. The size is the first argument; java/NBody.java prints the same
// line.
let console = import:Std.Io.Console;
let int32s = import:Std.Core.Int32;
let math = import:Std.Math.Math;
let program = import:Std.Program;
let result = import:Std.Core.Result;

export let NBody = module:program.Entry (
    const Bodies: int = 5;
    const DaysPerYear: float64 = 365.24;

    let Planets = class (
        export let x: float64[];
        export let y: float64[];
        export let z: float64[];
        export let vx: float64[];
        export let vy: float64[];
        export let vz: float64[];
        export let mass: float64[];

        // The sun, Jupiter, Saturn, Uranus, and Neptune.
        export let init = func {
            let pi = 3.141592653589793;
            let solar_mass = 4.0 * pi * pi;
            x = [0.0, 4.84143144246472090, 8.34336671824457987, 12.8943695621391310, 15.3796971148509165];
            y = [0.0, -1.16032004402742839, 4.12479856412430479, -15.1111514016986312, -25.9193146099879641];
            z = [0.0, -0.103622044471123109, -0.403523417114321381, -0.223307578892655734, 0.179258772950371181];
            vx = [0.0, 1.66007664274403694e-3 * DaysPerYear, -2.76742510726862411e-3 * DaysPerYear,
                  2.96460137564761618e-3 * DaysPerYear, 2.68067772490389322e-3 * DaysPerYear];
            vy = [0.0, 7.69901118419740425e-3 * DaysPerYear, 4.99852801234917238e-3 * DaysPerYear,
                  2.37847173959480950e-3 * DaysPerYear, 1.62824170038242295e-3 * DaysPerYear];
            vz = [0.0, -6.90460016972063023e-5 * DaysPerYear, 2.30417297573763929e-5 * DaysPerYear,
                  -2.96589568540237556e-5 * DaysPerYear, -9.51592254519715870e-5 * DaysPerYear];
            mass = [solar_mass, 9.54791938424326609e-4 * solar_mass, 2.85885980666130812e-4 * solar_mass,
                    4.36624404335156298e-5 * solar_mass, 5.15138902046611451e-5 * solar_mass];
            let px = 0.0;
            let py = 0.0;
            let pz = 0.0;
            for (let i = 0; i < Bodies; i = i + 1) {
                px = px + vx[i] * mass[i];
                py = py + vy[i] * mass[i];
                pz = pz + vz[i] * mass[i];
            }
            vx[0] = -px / solar_mass;
            vy[0] = -py / solar_mass;
            vz[0] = -pz / solar_mass;
        };

        export let advance = func(dt: float64) {
            for (let i = 0; i < Bodies; i = i + 1) {
                for (let j = i + 1; j < Bodies; j = j + 1) {
                    let dx = x[i] - x[j];
                    let dy = y[i] - y[j];
                    let dz = z[i] - z[j];
                    let squared = dx * dx + dy * dy + dz * dz;
                    let distance = math.sqrt(squared);
                    let magnitude = dt / (squared * distance);
                    vx[i] = vx[i] - dx * mass[j] * magnitude;
                    vy[i] = vy[i] - dy * mass[j] * magnitude;
                    vz[i] = vz[i] - dz * mass[j] * magnitude;
                    vx[j] = vx[j] + dx * mass[i] * magnitude;
                    vy[j] = vy[j] + dy * mass[i] * magnitude;
                    vz[j] = vz[j] + dz * mass[i] * magnitude;
                }
            }
            for (let i = 0; i < Bodies; i = i + 1) {
                x[i] = x[i] + dt * vx[i];
                y[i] = y[i] + dt * vy[i];
                z[i] = z[i] + dt * vz[i];
            }
        };

        export let energy = func -> float64 {
            let e = 0.0;
            for (let i = 0; i < Bodies; i = i + 1) {
                e = e + 0.5 * mass[i] * (vx[i] * vx[i] + vy[i] * vy[i] + vz[i] * vz[i]);
                for (let j = i + 1; j < Bodies; j = j + 1) {
                    let dx = x[i] - x[j];
                    let dy = y[i] - y[j];
                    let dz = z[i] - z[j];
                    let distance = math.sqrt(dx * dx + dy * dy + dz * dz);
                    e = e - mass[i] * mass[j] / distance;
                }
            }
            return e;
        };
    );

    export let.override main = func(args: string[]) -> program.ExitCode {
        let n = result.value_or<int32>(int32s.parse(args[0]), 0);
        let planets = new Planets();
        let before = planets.energy();
        for (let i = 0; i < n; i = i + 1) {
            planets.advance(0.01);
        }
        let after = planets.energy();
        console.println("nbody {:x} {:x}", before.to_bits(), after.to_bits());
        return program.ExitCode.Ok;
    };
);
