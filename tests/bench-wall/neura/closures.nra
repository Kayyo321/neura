// sizes: quick 40 full 400 long 200000
// Higher-order functions written in the program: for n rounds, maps a list
// of 1000 pseudo-random int64 values through a closure that captures the
// round, filters the result through a closure that captures a local
// threshold, folds it through a closure that captures a weight, and calls a
// closure returned by a function in a loop; the results fold into a
// checksum. The size is the first argument; java/Closures.java prints the
// same line.
let console = import:Std.Io.Console;
let int32s = import:Std.Core.Int32;
let program = import:Std.Program;
let result = import:Std.Core.Result;

export let Closures = module:program.Entry (
    const Values: int = 1000;
    const Mask: int64 = 1073741823;

    let map_values = func(values: int64[list], transform: func(int64) -> int64) -> int64[list] {
        last mapped: int64[list] = [];
        for (let i = 0; i < values.length; i = i + 1) {
            mapped.append(transform(values[i]));
        }
        return mapped;
    };

    let filter_values = func(values: int64[list], keep: func(int64) -> bool) -> int64[list] {
        last kept: int64[list] = [];
        for (let i = 0; i < values.length; i = i + 1) {
            if (keep(values[i])) {
                kept.append(values[i]);
            }
        }
        return kept;
    };

    let fold_values = func(values: int64[list], initial: int64, combine: func(int64, int64) -> int64) -> int64 {
        let total = initial;
        for (let i = 0; i < values.length; i = i + 1) {
            total = combine(total, values[i]);
        }
        return total;
    };

    let make_step = func(factor: int64, offset: int64) -> func(int64) -> int64 {
        return func(value: int64) -> int64 => (value * factor + offset) & Mask;
    };

    export let.override main = func(args: string[]) -> program.ExitCode {
        last n = result.value_or<int32>(int32s.parse(args[0]), 0);
        last values: int64[list] = [];
        let seed: int64 = 12345;
        for (let i = 0; i < Values; i = i + 1) {
            seed = (seed * 1103515245 + 12345) & 2147483647;
            values.append(seed % 100000);
        }
        let checksum: int64 = 0;
        for (let round = 0; round < n; round = round + 1) {
            last offset = round as int64;
            last threshold = (round % 10) as int64;
            last weight = (round % 7 + 1) as int64;
            last shifted = map_values(values, func(value: int64) -> int64 => value + offset);
            last kept = filter_values(shifted, func(value: int64) -> bool => value % 10 != threshold);
            last total = fold_values(kept, 0, func(sum: int64, value: int64) -> int64 => (sum + value * weight) & Mask);
            last step = make_step(weight + 2, offset);
            let walked = total;
            for (let i = 0; i < 100; i = i + 1) {
                walked = step(walked);
            }
            checksum = (checksum * 31 + kept.length as int64 + total + walked) & Mask;
        }
        console.println("closures {}", checksum);
        return program.ExitCode.Ok;
    };
);
