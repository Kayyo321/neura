// The positional calls that named.named.nra writes with labels in
// parameter order.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let area = func(width: int, height: int) -> int => width * height;

let Box = class (
    export let width: int;
    export let height: int;
    export let init = func(width: int, height: int) {
        instance.width = width;
        instance.height = height;
    };
    export let grow = func(by: int, times: int) -> int => (width + by) * times;
);

export let Main = module : program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let box = new Box(2, 3);
        console.print_line(area(box.width, box.height).to_string());
        console.print_line(area(4, 5).to_string());
        console.print_line(box.grow(1, 2).to_string());
        return program.ExitCode.Ok;
    };
);
