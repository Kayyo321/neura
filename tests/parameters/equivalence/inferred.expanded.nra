// The calls of inferred.inferred.nra with their type arguments written.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let identity = func<T>(value: T) -> T => value;
let pair = func<A, B>(a: A, b: B) -> B => b;
let same = func<T>(a: T, b: T) -> T => b;
let empty = func<T>() -> T[list] => new;
let count = func<T>(items: ...T) -> int => items.length;
let first = func<T>(items: T[]) -> T => items[0];

let Box = class<T> (
    export let value: T;
    export let init = func(value: T) {
        instance.value = value;
    };
    export let pair = func<U>(other: U) -> U => other;
);

export let Main = module : program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let big: int64 = 5;
        console.print_line(identity<int32>(7).to_string());
        console.print_line(pair<int32, string>(1, "a"));
        console.print_line(same<int64>(1, big).to_string());
        console.print_line(same<float64>(1.0, 2.5).to_string());
        let xs: int[list] = empty<int32>();
        console.print_line(xs.length.to_string());
        console.print_line(count<int32>(1, 2, 3).to_string());
        console.print_line(first<string>(["x", "y"]));
        let box = new Box<int>(3);
        console.print_line(box.pair<string>("x"));
        console.print_line(same<string>(a: "early", b: "late"));
        console.print_line(identity<string>(identity<string>("nested")));
        console.print_line(identity<func(int) -> int>(func(x: int) -> int => x + 1)(4).to_string());
        return program.ExitCode.Ok;
    };
);
