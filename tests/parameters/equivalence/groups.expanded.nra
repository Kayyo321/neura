let console = import:Std.Io.Console;
let program = import:Std.Program;

let distance = func(a: float64, b: float64, label: string) -> string {
    return label + (a + b).to_string();
};
let sum = func(first: int, second: int, rest: ...int) -> int {
    let total = first + second;
    for (let n: int in rest) {
        total += n;
    }
    return total;
};
let pick = func(a: int, b: int) -> int {
    return a;
} or func(a: string, b: string) -> string {
    return b;
};
let combine = func(f: func(int, int) -> int, g: func(int, int) -> int, x: int, y: int) -> int {
    return f(x, y) + g(y, x);
};

let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line(distance(1.5, 2.0, "d="));
        console.print_line(sum(1, 2, 3, 4).to_string());
        console.print_line(pick(7, 8).to_string());
        console.print_line(pick("x", "y"));
        console.print_line(combine(func(a: int, b: int) -> int { return a - b; },
                                   func(a: int, b: int) -> int { return a * b; }, 5, 3).to_string());
        return program.ExitCode.Ok;
    };
);
