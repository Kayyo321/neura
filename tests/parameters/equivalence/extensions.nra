// Extension calls (docs/design/Calls030.md, Extension sets): the receiver
// is evaluated first and once, a member or a primitive companion function
// of the same name wins, a private member does not, a nil receiver is
// passed, and a '&int' receiver is bound to its local.
let console = import:Std.Io.Console;
let program = import:Std.Program;
let.extensions texts = import:App.Texts;

let note = func(text: string) -> string {
    console.print_line("evaluate receiver");
    return text;
};

let mark = func(value: int) -> int {
    console.print_line("evaluate marks");
    return value;
};

export let Main = module : program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        console.print_line(note("ready").shout(marks: mark(2)));
        console.print_line(texts.shout("plain"));
        let box = new texts.Box();
        console.print_line(box.label());
        console.print_line(box.secret());
        console.print_line("a".concat("b"));
        let nothing: texts.Box = nil;
        console.print_line(nothing.describe());
        let count = 1;
        count.bump(4);
        console.print_line(count.to_string());
        let items: string[list] = new(["x", "y"]);
        console.print_line(items.count().to_string());
        let light = texts.Light.Red;
        console.print_line(light.next().to_string() + " " + false.flipped().to_string());
        return program.ExitCode.Ok;
    };
);
