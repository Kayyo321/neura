// The lambdas and calls of lambdas.untyped.nra with every type written.
let console = import:Std.Io.Console;
let program = import:Std.Program;

let transform = func<T, U>(items: T[list], convert: func(T) -> U) -> U[list] {
    let result: U[list] = new;
    for (let item: T in items) {
        result.append(convert(item));
    }
    return result;
};

let both = func<T>(f: func(int) -> T, g: func(T) -> T) -> T => g(f(1));
let apply = func(f: func(int, int) -> int) -> int => f(3, 4);
let adder = func -> func(int, int) -> int {
    return func(a: int, b: int) -> int => a + b;
};

export let Main = module : program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let names: string[list] = new(["a", "bc", "def"]);
        let lengths = transform<string, int32>(names, func(word: string) -> int32 => word.byte_length);
        console.print_line(lengths.to_string());
        console.print_line(both<int32>(func(x: int) -> int => x + 1, func(y: int) -> int => y * 10).to_string());
        console.print_line(apply(func(a: int, b: int) -> int => a * b).to_string());
        console.print_line(adder()(5, 6).to_string());
        let printer: func(string) -> void = func(text: string) {
            console.print_line("printed " + text);
        };
        printer("x");
        return program.ExitCode.Ok;
    };
);
