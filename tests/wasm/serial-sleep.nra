// A sleep in a program without tasks: the browser answers the request later, and the run stays suspended at it
// without blocking the page (docs/runtime/Providers.md, "Scheduling").
let console = import:Std.Io.Console;
let durations = import:Std.Time.Duration;
let program = import:Std.Program;
let result = import:Std.Core.Result;
let system_clock = import:Std.Time.SystemClock;

let now = func -> int64 {
    return match (system_clock.create().monotonic()) {
        result.Result.Ok(reading) => reading.to_nanos(),
        result.Result.Err(_) => 0,
    };
};

export let Main = module : program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode {
        let started = now();
        match (system_clock.create().sleep(durations.of_millis(50))) {
            result.Result.Ok(_) => {
                console.print_line("slept");
            },
            result.Result.Err(_) => {
                console.print_line("sleep failed");
            },
        }
        console.print_line("at least 50 ms: " + (now() - started >= 50000000).to_string());
        return program.ExitCode.Ok;
    };
);
