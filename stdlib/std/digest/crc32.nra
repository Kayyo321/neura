let kernels = import:Std.Internal.Kernels.Digest;

/// @brief The IEEE 802.3 CRC-32 checksum (Stdlib.md section 13.2): the reflected polynomial 0xEDB88320, an
/// initial value of all ones, and a final exclusive-or with all ones.
///
/// The check value of the ASCII text 123456789 is 0xCBF43926. The built-in kernels neura.digest.crc32 and
/// crc32_update compute it (docs/runtime/Kernels.md). The Neura implementation they replaced is the oracle of
/// tests/stdlib/crc32/kernel-oracle.nra.
/// @see [Std.Digest.Crc32](https://github.com/Kayyo321/neura/wiki/Stdlib-Digest-Crc32)
export let Crc32 = module (
    /// @brief The initial register value and final XOR mask.
    const AllOnes: uint32 = 4294967295;

    /// @brief A running checksum. A new one, or one after reset, has the value 0, the checksum of no bytes.
    export let Crc32 = class (
        /// @brief The running reflected register before the final XOR.
        let register: uint32 = 4294967295;

        /// @brief Initializes the checksum of an empty byte stream.
        export let init = func {
        };

        /// @brief Adds the bytes to the checksum.
        export let update = func(bytes: uint8[list]) {
            register = kernels.crc32_update(register, bytes);
        };

        /// @brief The checksum of every byte added since creation or the last reset. Reading it does not end
        /// the computation.
        export let value = func -> uint32 => register ^ AllOnes;

        /// @brief Restores the initial register and discards the previous checksum state.
        export let reset = func {
            register = AllOnes;
        };
    );

    /// @brief A new checksum with no bytes added.
    export let create = func -> Crc32 => new Crc32();

    /// @brief The checksum of the bytes.
    export let of = func(bytes: uint8[list]) -> uint32 => kernels.crc32(bytes);
);
