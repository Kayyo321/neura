let kernels = import:Std.Internal.Kernels.Digest;

/// @brief SHA-256 (FIPS 180-4; Stdlib.md section 13.2).
///
/// The built-in kernels neura.digest.sha256, sha256_init, sha256_update, and sha256_finish compute it
/// (docs/runtime/Kernels.md). The Neura implementation they replaced is the oracle of
/// tests/stdlib/sha256/kernel-oracle.nra.
/// @see [Std.Digest.Sha256](https://github.com/Kayyo321/neura/wiki/Stdlib-Digest-Sha256)
#Since("0.1.0")
export let Sha256 = module (
    /// @brief A running digest. `finish` ends it: a later update or finish traps with "invalid state: digest
    /// finished".
    #Final
    export let Sha256 = class (
        /// @brief The kernel's running state: the hash words, the message length, the bytes of an incomplete
        /// block, and whether the digest is finished, in the 112-byte layout of neura_digest.h.
        last state: uint8[list] = [];

        /// @brief Initializes the state of a fresh digest.
        export let init = func {
            for (let i = 0; i < 112; i++) {
                state.append(0);
            }
            kernels.sha256_init(state);
        };

        /// @brief Adds the bytes to the message.
        export let update = func(bytes: uint8[list]) {
            kernels.sha256_update(state, bytes);
        };

        /// @brief Pads the message, ends the digest, and returns the 32 bytes of the hash.
        export let finish = func -> uint8[list] => kernels.sha256_finish(state);
    );

    /// @brief A new digest with no bytes added.
    #ThreadSafe
    export let create = func -> Sha256 => new;

    /// @brief The 32-byte hash of the bytes.
    #[NoDiscard, Pure, ThreadSafe]
    export let of = func(bytes: uint8[list]) -> uint8[list] => kernels.sha256(bytes);
);
