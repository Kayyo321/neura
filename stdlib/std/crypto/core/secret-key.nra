let.promote _ = import:Std.Crypto.Core.SecretBytes;
let.promote _ = import:Std.Crypto.SymmetricKey;

/// @brief A symmetric key typed by the algorithm that uses it (Stdlib.md section 21.2).
/// @see [Std.Crypto.Core.SecretKey](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Core-SecretKey)
#Since("0.3.0")
export let SecretKey = module (
    /// @brief Key bytes in a `SecretBytes`, for the primitive class `Alg`: a `SecretKey<AesGcm>` is accepted by
    /// `AesGcm` and by nothing else. Printing, equality and wiping are those of `SecretBytes`.
    #[Final, Since("0.3.0")]
    export let SecretKey = class<Alg> implements SymmetricKey<Alg> (
        /// @brief The key bytes.
        last material: SecretBytes;

        /// @brief Copies the key bytes.
        export let init = func(key: uint8[list]) {
            material = new(key);
        };

        export let expose = func -> uint8[list] => material.expose();
        export let wipe = func => material.wipe();
        export let is_wiped = func -> bool => material.is_wiped();
        export let lock = func => material.lock();
        export let key_length = func -> int => material.length();

        /// @brief Whether `other` holds the same key bytes, compared without a data-dependent branch.
        #NoDiscard
        export let ct_equals = func(other: SecretKey<Alg>) -> bool => material.ct_equals(other.material);

        /// @brief A fixed redacted placeholder.
        export let.override to_string = func -> string => "SecretKey(<redacted>)";
    );
);
