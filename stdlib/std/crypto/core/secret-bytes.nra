let constant_time = import:Std.Crypto.Core.ConstantTime;
let.promote _ = import:Std.Crypto.SecretMemory;

/// @brief Bytes of secret material (Stdlib.md section 21.2).
/// @see [Std.Crypto.Core.SecretBytes](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-SecretBytes)
#Since("0.3.0")
export let SecretBytes = module (
    /// @brief A private copy of secret bytes. `to_string` prints a fixed placeholder and never the bytes;
    /// `equals` and `hash_code` are the identity of the object, and contents are compared only with the
    /// branch-free `ct_equals`. `wipe` overwrites the copy this object holds with zeros. The runtime cannot
    /// lock the pages, keep them out of swap, or erase copies the collector made; `lock` is a stub until it can.
    #[Final, Since("0.3.0")]
    export let SecretBytes = class implements SecretMemory<uint8[list]> (
        /// @brief The private copy.
        let bytes: uint8[list] = new;
        /// @brief Whether `wipe` has run.
        let wiped: bool = false;

        /// @brief Copies the bytes, so the caller may wipe or reuse its own list.
        export let init = func(material: uint8[list]) {
            for (let b in material) {
                bytes.append(b);
            }
        };

        /// @brief The number of bytes; still readable after `wipe`.
        export let length = func -> int => bytes.length;

        /// @brief The held list itself, not a copy. Traps with "invalid state: secret wiped" after `wipe`.
        export let expose = func -> uint8[list] {
            if (wiped) {
                trap_with_message("invalid state: secret wiped");
            }
            return bytes;
        };

        /// @brief Overwrites every held byte with zero and marks the secret wiped. A second call does nothing.
        export let wipe = func {
            for (let i = 0; i < bytes.length; i++) {
                bytes[i] = 0;
            }
            wiped = true;
        };

        /// @brief Whether `wipe` has run.
        export let is_wiped = func -> bool => wiped;

        /// @brief Locks the pages in memory and out of swap.
        /// @stub the runtime has no host operation to lock memory (mlock/VirtualLock)
        export let lock = func {
            trap_with_message(
                "unsupported: Std.Crypto.Core.SecretBytes.lock is not implemented in Neura 0.3.0 (the runtime has no host operation to lock memory)");
        };

        /// @brief Whether `other` holds the same bytes, compared without a data-dependent branch. Traps if
        /// either is wiped.
        #NoDiscard
        export let ct_equals = func(other: SecretBytes) -> bool => constant_time.ct_eq(expose(), other.expose());

        /// @brief A fixed placeholder with the length, never the bytes.
        export let.override to_string = func -> string => "SecretBytes(" + bytes.length.to_string() + " bytes, <redacted>)";
    );
);
