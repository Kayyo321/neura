let.promote _ = import:Std.Core.Result;
let.promote _ = import:Std.Core.Unit;
let.promote _ = import:Std.Crypto.SecretMemory;
let constant_time = import:Std.Crypto.Core.ConstantTime;
let host_error = import:Std.Core.Internal.HostError;
let locked = import:Std.Crypto.Internal.LockedMemory;
let words = import:Std.Crypto.Internal.Words;

/// @brief Bytes of secret material (Stdlib.md section 21.2).
/// @see [Std.Crypto.Core.SecretBytes](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Core-SecretBytes)
#Since("0.3.0")
export let SecretBytes = module (
    const MaximumLockBytes = 65536;

    /// @brief A private copy of secret bytes with identity equality and a fixed redacted display. A successful
    /// lock moves the held bytes to a dedicated host buffer and overwrites the original list. Host guarantees
    /// cover only that buffer. Copies exposed to Neura remain ordinary heap bytes.
    /// @see [Std.Crypto.Core.SecretBytes](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Core-SecretBytes)
    #[Final, Since("0.3.0")]
    export let SecretBytes = class implements SecretMemory<uint8[list]> (
        let bytes: uint8[list] = new;
        let locked_handle: int64 = 0;
        let locked_length: int = 0;
        let wiped: bool = false;

        /// @brief Copies the material, so the caller can wipe or reuse its own list.
        /// @see [Std.Crypto.Core.SecretBytes](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Core-SecretBytes)
        #Since("0.3.0")
        export let init = func(material: uint8[list]) {
            for (let byte in material) {
                bytes.append(byte);
            }
        };

        /// @brief The retained byte count, including after wiping.
        /// @see [Std.Crypto.Core.SecretBytes](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Core-SecretBytes)
        #Since("0.3.0")
        export let length = func -> int => locked_length == 0 ? bytes.length : locked_length;

        /// @brief Returns the held list before locking and a new ordinary heap copy after locking.
        /// Traps with "invalid state: secret wiped" after wiping.
        /// @see [Std.Crypto.Core.SecretBytes](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Core-SecretBytes)
        #Since("0.3.0")
        export let expose = func -> uint8[list] {
            require_live();
            if (locked_handle == 0) {
                return bytes;
            }
            match (locked.read(locked_handle, 0, locked_length)) {
                locked.BytesOutcome.Ok(value) => {
                    return value;
                },
                locked.BytesOutcome.Error(code) => {
                    trap_with_message("locked secret read failed, host code " .. code.to_string());
                },
            }
            trap_with_message("locked secret read failed");
        };

        /// @brief Overwrites the held heap bytes or releases the locked host buffer once.
        /// @see [Std.Crypto.Core.SecretBytes](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Core-SecretBytes)
        #Since("0.3.0")
        export let wipe = func {
            if (locked_handle == 0) {
                words.wipe(bytes);
            } else {
                match (locked.release(locked_handle)) {
                    locked.DoneOutcome.Ok => {},
                    locked.DoneOutcome.Error(code) => {
                        trap_with_message("locked secret release failed, host code " .. code.to_string());
                    },
                }
                locked_handle = 0;
            }
            wiped = true;
        };

        /// @brief Whether wiping has completed.
        /// @see [Std.Crypto.Core.SecretBytes](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Core-SecretBytes)
        #Since("0.3.0")
        export let is_wiped = func -> bool => wiped;

        /// @brief Moves 1 to 65,536 bytes into a locked host buffer. Failure preserves the original material.
        /// Repeated successful calls are idempotent. Locking needs the entropy capability and a provider
        /// that can exclude the pages from swap, core dumps and forked children. Recording runs refuse it.
        /// @see [Std.Crypto.Core.SecretBytes](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Core-SecretBytes)
        #[NoDiscard, Since("0.3.0")]
        export let try_lock = func -> Result<Unit> {
            require_live();
            if (locked_handle != 0) {
                return Result<Unit>.Ok(Unit.Value);
            }
            last count = bytes.length;
            if (count < 1 || count > MaximumLockBytes) {
                return Result<Unit>.Err(host_error.io(4, "secret lock requires 1 to 65536 bytes", ""));
            }
            match (locked.create(count)) {
                locked.HandleOutcome.Ok(handle) => {
                    match (locked.write(handle, 0, bytes)) {
                        locked.DoneOutcome.Ok => {
                            words.wipe(bytes);
                            bytes = new;
                            locked_handle = handle;
                            locked_length = count;
                            return Result<Unit>.Ok(Unit.Value);
                        },
                        locked.DoneOutcome.Error(code) => {
                            let _ = locked.release(handle);
                            return lock_failure(code);
                        },
                    }
                },
                locked.HandleOutcome.Error(code) => {
                    return lock_failure(code);
                },
            }
            return Result<Unit>.Err(host_error.io(13, "secret lock provider unavailable", ""));
        };

        /// @brief Moves the held bytes into locked memory and traps if the provider refuses the request.
        /// @see [Std.Crypto.Core.SecretBytes](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Core-SecretBytes)
        #Since("0.3.0")
        export let lock = func {
            match (try_lock()) {
                Result.Ok(_) => {},
                Result.Err(failure) => {
                    trap_with_message("secret lock failed: " .. failure.to_string());
                },
            }
        };

        /// @brief Compares secret contents. Either wiped input traps. The software comparison is branch-free
        /// in source. The runtime does not guarantee constant time.
        /// @see [Std.Crypto.Core.SecretBytes](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Core-SecretBytes)
        #[NoDiscard, Since("0.3.0")]
        export let ct_equals = func(other: SecretBytes) -> bool {
            require_live();
            if (locked_handle != 0) {
                last candidate = other.expose();
                last equal = locked_equals(locked_handle, candidate);
                if (other.locked_handle != 0) {
                    words.wipe(candidate);
                }
                return equal;
            }
            if (other.locked_handle != 0) {
                other.require_live();
                return locked_equals(other.locked_handle, bytes);
            }
            return constant_time.ct_eq(bytes, other.expose());
        };

        /// @brief Fixed display for secret bytes.
        /// @see [Std.Crypto.Core.SecretBytes](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Core-SecretBytes)
        #Since("0.3.0")
        export let.override to_string = func -> string => "SecretBytes(<redacted>)";

        let require_live = func {
            if (wiped) {
                trap_with_message("invalid state: secret wiped");
            }
        };
    );

    let lock_failure = func(code: uint32) -> Result<Unit> =>
        Result<Unit>.Err(host_error.io(code, "secret lock provider failed (host code " .. code.to_string() .. ")", ""));

    let locked_equals = func(handle: int64, material: uint8[list]) -> bool {
        match (locked.equal(handle, material)) {
            locked.BoolOutcome.Ok(equal) => {
                return equal;
            },
            locked.BoolOutcome.Error(code) => {
                trap_with_message("locked secret comparison failed, host code " .. code.to_string());
            },
        }
        trap_with_message("locked secret comparison failed");
    };
);
