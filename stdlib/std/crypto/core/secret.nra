let optional = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Result;
let.promote _ = import:Std.Core.Unit;
let.promote _ = import:Std.Crypto.SecretMemory;
let host_error = import:Std.Core.Internal.HostError;
let.promote _ = import:Std.Crypto.Core.SecretBytes;

/// @brief A secret value of any type (Stdlib.md section 21.2).
/// @see [Std.Crypto.Core.Secret](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Core-Secret)
.Since("0.3.0")
export let Secret = module (
    let Codec = class<T> (
        export last encode: func(T) -> uint8[list];
        export last decode: func(uint8[list]) -> T;
        export let init = func(pack: func(T) -> uint8[list], unpack: func(uint8[list]) -> T) {
            encode = pack;
            decode = unpack;
        };
    );

    /// @brief Wraps a value of type T so that it is never printed. Because a generic class cannot overwrite a
    /// value of unknown type, the constructor takes an `eraser` that `wipe` calls with the value (for a byte
    /// list, a function that zeroes it). With a caller-supplied codec, locking retains only the
    /// encoded bytes in a dedicated host buffer. Previously exposed values and caller-owned copies
    /// and released heap storage retain their ordinary lifetimes.
    .[Final, Since("0.3.0")]
    export let Secret = class<T> implements SecretMemory<T> (
        let held: optional.Optional<T>;
        let codec: Codec<T> = nil;
        let locked: SecretBytes = nil;
        let in_codec = false;
        /// @brief Called once by `wipe`.
        last eraser: func(T) -> void;
        /// @brief Whether `wipe` has run.
        let wiped: bool = false;

        /// @brief Wraps the value, with the function `wipe` uses to erase it.
        export let init = func(secret: T, erase: func(T) -> void) {
            held = optional.Optional<T>.Some(secret);
            eraser = erase;
        };

        /// @brief The value. Traps with "invalid state: secret wiped" after `wipe`.
        export let expose = func -> T {
            check_codec_state();
            if (wiped) {
                trap_with_message("invalid state: secret wiped");
            }
            if (locked) {
                last bytes = locked.expose();
                defer zero_bytes(bytes);
                in_codec = true;
                last value = codec.decode(bytes);
                in_codec = false;
                return value;
            }
            return optional.expect(held, "secret has no retained value");
        };

        /// @brief Calls the eraser once and marks the secret wiped.
        export let wipe = func {
            if (not wiped) {
                last value = expose();
                if (locked) {
                    locked.wipe();
                    locked = nil;
                }
                held = optional.Optional<T>.None;
                wiped = true;
                eraser(value);
            }
        };

        /// @brief Whether `wipe` has run.
        export let is_wiped = func -> bool => wiped;

        /// @brief Sets the codec for moving this secret's retained representation into locked memory.
        /// The encoder returns a fresh owned byte list. The decoder returns an independent value and
        /// must not retain its input. Neither callback should capture copies of the secret.
        /// Call before locking. A successful lock may change the identity of subsequently exposed values.
        export let set_lock_codec = func(encode: func(T) -> uint8[list], decode: func(uint8[list]) -> T) {
            check_codec_state();
            if (wiped || locked != nil) {
                trap_with_message("invalid state: secret codec cannot change after locking or wiping");
            }
            codec = new Codec<T>(encode, decode);
        };

        /// @brief Moves encoded bytes into the host's locked memory. Failure retains the original value.
        /// Uses the entropy capability and refuses in a recording run. Repeated successful calls are idempotent.
        .NoDiscard
        export let try_lock = func -> Result<Unit> {
            check_codec_state();
            if (wiped) {
                trap_with_message("invalid state: secret wiped");
            }
            if (locked) {
                return Result<Unit>.Ok(Unit.Value);
            }
            if (not codec) {
                return Result<Unit>.Err(host_error.io(4, "generic secret lock requires a codec", ""));
            }
            in_codec = true;
            last bytes = codec.encode(optional.expect(held, "secret has no retained value"));
            in_codec = false;
            defer zero_bytes(bytes);
            last buffer = new SecretBytes(bytes);
            match (buffer.try_lock()) {
                Result.Err(error) => {
                    buffer.wipe();
                    return Result<Unit>.Err(error);
                },
                Result.Ok(_) => {
                    held = optional.Optional<T>.None;
                    locked = buffer;
                    return Result<Unit>.Ok(Unit.Value);
                },
            }
        };

        /// @brief Moves the retained value into locked host memory using the configured codec.
        /// Traps with the provider or codec diagnostic if locking fails.
        export let lock = func {
            match (try_lock()) {
                Result.Ok(_) => {},
                Result.Err(error) => {
                    trap_with_message("secret lock failed: " .. error.to_string());
                },
            }
        };

        let check_codec_state = func {
            if (in_codec) {
                trap_with_message("invalid state: secret codec cannot reenter the same secret");
            }
        };

        /// @brief A fixed placeholder, never the value.
        export let.override to_string = func -> string => "Secret(<redacted>)";
    );

    /// @brief An eraser for byte lists: overwrites every byte with zero.
    .Since("0.3.0")
    export let zero_bytes = func(bytes: uint8[list]) {
        for (let i = 0; i < bytes.length; i++) {
            bytes[i] = 0;
        }
    };
);
