let.promote _ = import:Std.Crypto.SecretMemory;

/// @brief A secret value of any type (Stdlib.md section 21.2).
/// @see [Std.Crypto.Core.Secret](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Core-Secret)
#Since("0.3.0")
export let Secret = module (
    /// @brief Wraps a value of type T so that it is never printed. Because a generic class cannot overwrite a
    /// value of unknown type, the constructor takes an `eraser` that `wipe` calls with the value (for a byte
    /// list, a function that zeroes it). Generic values remain in the Neura heap. Use `SecretBytes`
    /// for the dedicated byte-buffer locking service.
    #[Final, Since("0.3.0")]
    export let Secret = class<T> implements SecretMemory<T> (
        /// @brief The wrapped value.
        last value: T;
        /// @brief Called once by `wipe`.
        last eraser: func(T) -> void;
        /// @brief Whether `wipe` has run.
        let wiped: bool = false;

        /// @brief Wraps the value, with the function `wipe` uses to erase it.
        export let init = func(secret: T, erase: func(T) -> void) {
            value = secret;
            eraser = erase;
        };

        /// @brief The value. Traps with "invalid state: secret wiped" after `wipe`.
        export let expose = func -> T {
            if (wiped) {
                trap_with_message("invalid state: secret wiped");
            }
            return value;
        };

        /// @brief Calls the eraser once and marks the secret wiped.
        export let wipe = func {
            if (!wiped) {
                wiped = true;
                eraser(value);
            }
        };

        /// @brief Whether `wipe` has run.
        export let is_wiped = func -> bool => wiped;

        /// @brief Requests locking for a generic value.
        /// @stub the runtime has no locked-buffer adapter for arbitrary Neura values
        /// @see [Std.Crypto.Core.Secret](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Core-Secret)
        #Since("0.3.0")
        export let lock = func {
            trap_with_message("unsupported: Std.Crypto.Core.Secret.lock is not implemented in Neura 0.3.0 "
                + "(the runtime has no locked-buffer adapter for arbitrary Neura values)");
        };

        /// @brief A fixed placeholder, never the value.
        export let.override to_string = func -> string => "Secret(<redacted>)";
    );

    /// @brief An eraser for byte lists: overwrites every byte with zero.
    #Since("0.3.0")
    export let zero_bytes = func(bytes: uint8[list]) {
        for (let i = 0; i < bytes.length; i++) {
            bytes[i] = 0;
        }
    };
);
