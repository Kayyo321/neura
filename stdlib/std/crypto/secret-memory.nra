/// @brief The contract of a container for secret material (Stdlib.md section 21.1).
///
/// The specification asks for pinned, `mlock`'d, auto-zeroing memory. The Neura runtime provides none of
/// these: it cannot lock pages or keep them out of swap, it does not zero memory when an object dies, and the
/// collector may have copied a list before `wipe` overwrites it. An implementation therefore promises only
/// what it can do: it never prints its contents, `wipe` overwrites the storage it holds, and `lock` is the
/// place where page locking will go once the runtime offers it (docs/design/Crypto030.md, "Runtime needs").
/// @see [Std.Crypto.SecretMemory](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-SecretMemory)
#Since("0.3.0")
export let SecretMemory = module (
    /// @brief Secret material of type T.
    #Since("0.3.0")
    export let SecretMemory = interface<T> (
        /// @brief The secret itself. Traps with "invalid state: secret wiped" after `wipe`. The caller must not
        /// log or keep the result longer than it needs it.
        let expose = func -> T;
        /// @brief Overwrites the held storage with zeros; later `expose` calls trap.
        let wipe = func;
        /// @brief Reports whether `wipe` has run.
        let is_wiped = func -> bool;
        /// @brief Asks the runtime to keep the storage out of swap (`mlock`). Not provided by this runtime.
        let lock = func;
    );
);
