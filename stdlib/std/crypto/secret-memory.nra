/// @brief The contract of a container for secret material (Stdlib.md section 21.1).
///
/// Implementations redact their display and overwrite owned storage when wiped. Byte-backed
/// implementations can move their retained bytes to a locked host buffer where supported. The host
/// guarantees apply to that buffer. Exposed heap copies and collector copies have ordinary lifetimes.
/// @see [Std.Crypto.SecretMemory](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-SecretMemory)
.Since("0.3.0")
export let SecretMemory = module (
    /// @brief Secret material of type T.
    .Since("0.3.0")
    export let SecretMemory = interface<T> (
        /// @brief The secret itself. Traps with "invalid state: secret wiped" after `wipe`. The caller must not
        /// log or keep the result longer than it needs it.
        let expose = func -> T;
        /// @brief Overwrites the held storage with zeros; later `expose` calls trap.
        let wipe = func;
        /// @brief Reports whether `wipe` has run.
        let is_wiped = func -> bool;
        /// @brief Asks the implementation to keep its retained bytes in a dedicated locked host buffer.
        let lock = func;
    );
);
