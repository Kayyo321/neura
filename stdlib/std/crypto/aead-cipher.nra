let.promote _ = import:Std.Core.Error;
let.promote _ = import:Std.Core.Result;
let.promote _ = import:Std.Crypto.CryptographicPrimitive;

/// @brief The contract of authenticated encryption with associated data (Stdlib.md section 21.1).
/// @see [Std.Crypto.AeadCipher](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-AeadCipher)
.Since("0.3.0")
export let AeadCipher = module (
    /// @brief An AEAD bound to one key at construction. `Key` is the key type its constructor takes, `Nonce`
    /// and `Tag` the nonce and tag representations (built-in byte lists for every cipher of Std.Crypto).
    .Since("0.3.0")
    export let AeadCipher = interface<Key, Nonce, Tag>:CryptographicPrimitive<Key> (
        /// @brief The nonce length in bytes; `seal` and `open` trap on any other.
        let nonce_length = func -> int;
        /// @brief The tag length in bytes.
        let tag_length = func -> int;
        /// @brief Encrypts and authenticates: the ciphertext followed by the tag.
        let seal = func(nonce: Nonce, plaintext: uint8[list], associated_data: uint8[list]) -> uint8[list];
        /// @brief Verifies and decrypts `seal`'s output. A wrong key, nonce, data or tag fails with a Custom
        /// error of code "crypto.authentication" and releases no plaintext.
        let open = func(nonce: Nonce, sealed: uint8[list], associated_data: uint8[list]) -> Result<uint8[list]>;
    );
);
