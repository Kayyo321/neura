let.promote _ = import:Std.Core.Error;
let.promote _ = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Result;
let.promote _ = import:Std.Crypto.Pki.AlgorithmIdentifier;
let.promote _ = import:Std.Crypto.Pki.Oid;
let cbc = import:Std.Crypto.Internal.PkiCbc;
let der = import:Std.Crypto.Pki.Der;
let entropy = import:Std.Crypto.Random.Entropy;
let error = import:Std.Core.Error;
let gcm = import:Std.Crypto.Symmetric.AesGcm;
let identifiers = import:Std.Crypto.Pki.AlgorithmIdentifier;
let oid_module = import:Std.Crypto.Pki.Oid;
let oids = import:Std.Crypto.Pki.Oids;
let pbkdf2 = import:Std.Crypto.Kdf.Pbkdf2;
let pem = import:Std.Crypto.Pki.Pem;
let secret_bytes = import:Std.Crypto.Core.SecretBytes;
let sha2 = import:Std.Crypto.Hash.Sha2;
let writer = import:Std.Crypto.Pki.DerWriter;

/// @brief PKCS #8 private keys: OneAsymmetricKey (RFC 5958) and EncryptedPrivateKeyInfo with PBES2 (RFC 8018)
/// (Stdlib.md section 21.10).
///
/// PBES2 is supported with PBKDF2 over HMAC-SHA-224, -256, -384 or -512 and AES-128/192/256 in CBC mode (with
/// PKCS #7 padding) or GCM (RFC 5084 parameters, a 12-byte nonce and a 16-byte tag appended to the ciphertext).
/// The PBKDF2 default PRF, HMAC-SHA-1, is refused as `crypto.unsupported`: Std.Crypto has no public SHA-1.
/// A wrong password or altered ciphertext is `crypto.authentication`; CBC cannot always tell a wrong password
/// from a damaged key, and both fail.
/// @see [Std.Crypto.Pki.PrivateKeyInfo](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Pki-PrivateKeyInfo)
.Since("0.3.0")
export let PrivateKeyInfo = module (
    /// @brief A OneAsymmetricKey: version 0 (v1) or 1 (v2, which may carry the public key).
    .[Final, Since("0.3.0")]
    export let PrivateKeyInfo = class (
        /// @brief 0 for v1 (PrivateKeyInfo), 1 for v2.
        export last version: int;
        export last algorithm: AlgorithmIdentifier;
        /// @brief The contents of the privateKey OCTET STRING (for Ed25519, itself an encoded OCTET STRING).
        export last private_key: secret_bytes.SecretBytes;
        /// @brief The DER of the [0] attributes, or empty.
        export last attributes: uint8[list];
        /// @brief The [1] publicKey bytes (v2 only).
        export last public_key: Optional<uint8[list]>;

        export let init = func(version_number: int, id: AlgorithmIdentifier, key: secret_bytes.SecretBytes,
            attribute_der: uint8[list], public_bytes: Optional<uint8[list]>) {
            version = version_number;
            algorithm = id;
            private_key = key;
            attributes = attribute_der;
            public_key = public_bytes;
        };

        /// @brief The DER encoding, held as a secret.
        export let encode = func -> secret_bytes.SecretBytes {
            let items: uint8[list][list] = new([writer.integer(version as int64), algorithm.der_bytes,
                writer.octet_string(private_key.expose())]);
            if (attributes.length > 0) {
                items.append(attributes);
            }
            match (public_key) {
                Optional.Some(bytes) => {
                    let content: uint8[list] = new([0]);
                    for (let b in bytes) {
                        content.append(b);
                    }
                    items.append(writer.implicit(1, false, content));
                },
                Optional.None => {},
            }
            return new secret_bytes.SecretBytes(writer.sequence(items));
        };

        /// @brief Overwrites the private key bytes.
        export let wipe = func => private_key.wipe();

        /// @brief A fixed placeholder for the private key.
        export let.override to_string = func -> string => "PrivateKeyInfo(<redacted>)";
    );

    /// @brief An EncryptedPrivateKeyInfo with PBES2 parameters read out. Not secret: compared by DER.
    .[Final, Since("0.3.0")]
    export let EncryptedPrivateKeyInfo = class (
        export last der_bytes: uint8[list];
        export last salt: uint8[list];
        export last iterations: int;
        /// @brief The PBKDF2 keyLength, or -1 when absent.
        export last key_length: int;
        /// @brief The PRF OID (hmacWithSHA1 when absent, the PBKDF2 default).
        export last prf: Oid;
        /// @brief The encryption scheme OID (AES-CBC or AES-GCM).
        export last cipher: Oid;
        /// @brief The CBC IV or the GCM nonce.
        export last iv: uint8[list];
        /// @brief The GCM tag length (the ICVlen), 0 for CBC.
        export last tag_length: int;
        export last encrypted_data: uint8[list];

        export let init = func(encoded: uint8[list], salt_bytes: uint8[list], count: int, length: int, prf_id: Oid,
            cipher_id: Oid, iv_bytes: uint8[list], icv: int, data: uint8[list]) {
            der_bytes = encoded;
            salt = salt_bytes;
            iterations = count;
            key_length = length;
            prf = prf_id;
            cipher = cipher_id;
            iv = iv_bytes;
            tag_length = icv;
            encrypted_data = data;
        };

        /// @brief Decrypts with the password (its UTF-8 bytes, as RFC 8018 recommends).
        .NoDiscard
        export let decrypt = func(password: uint8[list]) -> Result<PrivateKeyInfo> {
            last key_size = aes_key_size(cipher.dotted);
            if (key_length >= 0 && key_length != key_size) {
                return unsupported<PrivateKeyInfo>("PBKDF2 keyLength does not match the cipher");
            }
            last key = derive(prf.dotted, password, salt, iterations, key_size)?;
            let plain: uint8[list] = new;
            if (is_gcm(cipher.dotted)) {
                match (new gcm.AesGcm(key).open(iv, encrypted_data, new)) {
                    Result.Ok(bytes) => {
                        plain = bytes;
                    },
                    Result.Err(e) => {
                        return authentication<PrivateKeyInfo>();
                    },
                }
            } else {
                match (cbc.decrypt(key, iv, encrypted_data)) {
                    Optional.Some(bytes) => {
                        plain = bytes;
                    },
                    Optional.None => {
                        return authentication<PrivateKeyInfo>();
                    },
                }
            }
            match (parse(plain)) {
                Result.Ok(info) => {
                    return Result<PrivateKeyInfo>.Ok(info);
                },
                Result.Err(e) => {
                    return authentication<PrivateKeyInfo>();
                },
            }
            return authentication<PrivateKeyInfo>();
        };

        export let.override equals = func(other: class) -> bool {
            if (other is not that: EncryptedPrivateKeyInfo) {
                return false;
            }
            if (that.der_bytes.length != der_bytes.length) {
                return false;
            }
            for (let i = 0; i < der_bytes.length; i++) {
                if (der_bytes[i] != that.der_bytes[i]) {
                    return false;
                }
            }
            return true;
        };

        export let.override hash_code = func -> uint32 => der.hash_range(der_bytes, 0, der_bytes.length);

        /// @brief "EncryptedPrivateKeyInfo(<cipher>, <iterations> iterations)".
        export let.override to_string = func -> string => $"EncryptedPrivateKeyInfo({cipher.dotted}, {iterations} iterations)";
    );

    let fail = func<T>(offset: int, message: string) -> Result<T> =>
        Result<T>.Err(Error.Parse { kind: ParseErrorKind.Syntax, offset: offset, message: message });

    let unsupported = func<T>(message: string) -> Result<T> => Result<T>.Err(error.custom("crypto.unsupported", message));

    let authentication = func<T>() -> Result<T> =>
        Result<T>.Err(error.custom("crypto.authentication", "wrong password or damaged key"));

    let is_gcm = func(dotted: string) -> bool => dotted == oids.Aes128Gcm || dotted == oids.Aes192Gcm
        || dotted == oids.Aes256Gcm;

    let aes_key_size = func(dotted: string) -> int {
        if (dotted == oids.Aes128Cbc || dotted == oids.Aes128Gcm) {
            return 16;
        }
        return if (dotted == oids.Aes192Cbc || dotted == oids.Aes192Gcm) -> 24 else -> 32;
    };

    let derive = func(prf: string, password: uint8[list], salt: uint8[list], iterations: int, length: int)
        -> Result<uint8[list]> {
        if (prf == oids.HmacWithSha256) {
            return Result<uint8[list]>.Ok(pbkdf2.derive<sha2.Sha256>(password, salt, iterations, length));
        }
        if (prf == oids.HmacWithSha384) {
            return Result<uint8[list]>.Ok(pbkdf2.derive<sha2.Sha384>(password, salt, iterations, length));
        }
        if (prf == oids.HmacWithSha512) {
            return Result<uint8[list]>.Ok(pbkdf2.derive<sha2.Sha512>(password, salt, iterations, length));
        }
        if (prf == oids.HmacWithSha224) {
            return Result<uint8[list]>.Ok(pbkdf2.derive<sha2.Sha224>(password, salt, iterations, length));
        }
        return unsupported<uint8[list]>("PBKDF2 PRF " .. prf .. " is not supported (HMAC-SHA-1 is not offered)");
    };

    /// @brief Parses a OneAsymmetricKey. A v1 key with a public key, or a version other than 0 or 1, fails.
    .[NoDiscard, Since("0.3.0")]
    export let parse = func(bytes: uint8[list]) -> Result<PrivateKeyInfo> {
        last top = der.parse(bytes)?;
        if (not top.is_universal(der.TagSequence)) {
            return fail<PrivateKeyInfo>(0, "OneAsymmetricKey must be a SEQUENCE");
        }
        let r = top.reader();
        last version = (r.next_universal(der.TagInteger, "version")?).small_integer(1)? as int;
        last algorithm = identifiers.parse(r.next_universal(der.TagSequence, "privateKeyAlgorithm")?)?;
        last key = (r.next_universal(der.TagOctetString, "privateKey")?).octet_string()?;
        let attributes: uint8[list] = new;
        match (r.optional_context(0)?) {
            Optional.Some(a) => {
                return fail<PrivateKeyInfo>(a.offset, "attributes must be constructed") unless a.constructed;
                attributes = a.encoded();
            },
            Optional.None => {},
        }
        let public_key = Optional<uint8[list]>.None;
        match (r.optional_context(1)?) {
            Optional.Some(p) => {
                if (version != 1) {
                    return fail<PrivateKeyInfo>(p.offset, "publicKey needs version v2");
                }
                last bits = p.bit_string_content()?;
                if (bits.unused_bits != 0) {
                    return fail<PrivateKeyInfo>(p.offset, "publicKey must be whole bytes");
                }
                public_key = Optional<uint8[list]>.Some(bits.bytes);
            },
            Optional.None => {},
        }
        r.finish()?;
        return Result<PrivateKeyInfo>.Ok(new PrivateKeyInfo(version, algorithm, new secret_bytes.SecretBytes(key),
            attributes, public_key));
    };

    /// @brief The only PRIVATE KEY block of PEM text, parsed.
    .[NoDiscard, Since("0.3.0")]
    export let parse_pem = func(text: string) -> Result<PrivateKeyInfo> => parse(pem.decode(text, "PRIVATE KEY")?);

    /// @brief Parses an EncryptedPrivateKeyInfo. Only PBES2 is accepted (`crypto.unsupported` otherwise), with
    /// PBKDF2 and an AES-CBC or AES-GCM scheme; malformed parameters are a `Parse` error.
    .[NoDiscard, Since("0.3.0")]
    export let parse_encrypted = func(bytes: uint8[list]) -> Result<EncryptedPrivateKeyInfo> {
        last top = der.parse(bytes)?;
        if (not top.is_universal(der.TagSequence)) {
            return fail<EncryptedPrivateKeyInfo>(0, "EncryptedPrivateKeyInfo must be a SEQUENCE");
        }
        let r = top.reader();
        last scheme = identifiers.parse(r.next_universal(der.TagSequence, "encryptionAlgorithm")?)?;
        last data = (r.next_universal(der.TagOctetString, "encryptedData")?).octet_string()?;
        r.finish()?;
        if (not scheme.oid.matches(oids.Pbes2)) {
            return unsupported<EncryptedPrivateKeyInfo>("only PBES2 is supported");
        }
        last params = der.parse(scheme.parameters)?;
        if (not params.is_universal(der.TagSequence)) {
            return fail<EncryptedPrivateKeyInfo>(0, "PBES2-params must be a SEQUENCE");
        }
        let pr = params.reader();
        last kdf = identifiers.parse(pr.next_universal(der.TagSequence, "keyDerivationFunc")?)?;
        last enc = identifiers.parse(pr.next_universal(der.TagSequence, "encryptionScheme")?)?;
        pr.finish()?;
        if (not kdf.oid.matches(oids.Pbkdf2)) {
            return unsupported<EncryptedPrivateKeyInfo>("only PBKDF2 is supported");
        }
        last kp = der.parse(kdf.parameters)?;
        if (not kp.is_universal(der.TagSequence)) {
            return fail<EncryptedPrivateKeyInfo>(0, "PBKDF2-params must be a SEQUENCE");
        }
        let kr = kp.reader();
        last salt = (kr.next_universal(der.TagOctetString, "salt")?).octet_string()?;
        last iterations = (kr.next_universal(der.TagInteger, "iterationCount")?).small_integer(10000000)? as int;
        if (iterations < 1) {
            return fail<EncryptedPrivateKeyInfo>(0, "iterationCount must be at least 1");
        }
        let key_length = -1;
        match (kr.optional_universal(der.TagInteger)?) {
            Optional.Some(k) => {
                key_length = k.small_integer(64)? as int;
            },
            Optional.None => {},
        }
        let prf = oid_module.of(oids.HmacWithSha1);
        match (kr.optional_universal(der.TagSequence)?) {
            Optional.Some(p) => {
                last id = identifiers.parse(p)?;
                if (id.has_parameters() && not id.has_null_parameters()) {
                    return fail<EncryptedPrivateKeyInfo>(p.offset, "PRF parameters must be NULL or absent");
                }
                prf = id.oid;
            },
            Optional.None => {},
        }
        kr.finish()?;
        last cipher = enc.oid.dotted;
        let iv: uint8[list] = new;
        let tag_length = 0;
        if (cipher == oids.Aes128Cbc || cipher == oids.Aes192Cbc || cipher == oids.Aes256Cbc) {
            iv = (der.parse(enc.parameters)?).octet_string()?;
            if (iv.length != 16) {
                return fail<EncryptedPrivateKeyInfo>(0, "AES-CBC IV must be 16 bytes");
            }
        } else if (is_gcm(cipher)) {
            last gp = der.parse(enc.parameters)?;
            if (not gp.is_universal(der.TagSequence)) {
                return fail<EncryptedPrivateKeyInfo>(0, "GCMParameters must be a SEQUENCE");
            }
            let gr = gp.reader();
            iv = (gr.next_universal(der.TagOctetString, "aes-nonce")?).octet_string()?;
            tag_length = 12;
            match (gr.optional_universal(der.TagInteger)?) {
                Optional.Some(t) => {
                    tag_length = t.small_integer(16)? as int;
                },
                Optional.None => {},
            }
            gr.finish()?;
            if (iv.length != 12 || tag_length != 16) {
                return unsupported<EncryptedPrivateKeyInfo>("AES-GCM needs a 12-byte nonce and a 16-byte tag");
            }
        } else {
            return unsupported<EncryptedPrivateKeyInfo>("encryption scheme " .. cipher .. " is not supported");
        }
        return Result<EncryptedPrivateKeyInfo>.Ok(new EncryptedPrivateKeyInfo(top.encoded(), salt, iterations, key_length,
            prf, enc.oid, iv, tag_length, data));
    };

    /// @brief Encrypts with PBES2: PBKDF2 under the PRF (hmacWithSHA224/256/384/512, dotted) with the salt and
    /// iteration count, then the cipher (AES-128/192/256-CBC with a 16-byte IV, or AES-128/192/256-GCM with a
    /// 12-byte nonce in `iv`). The keyLength field is omitted. A bad argument traps with "invalid argument: ...".
    .[NoDiscard, Since("0.3.0")]
    export let encrypt = func(info: PrivateKeyInfo, password: uint8[list], salt: uint8[list], iterations: int,
        prf: string, cipher: string, iv: uint8[list]) -> EncryptedPrivateKeyInfo {
        if (iterations < 1 || salt.length == 0) {
            trap_with_message("invalid argument: PBES2 needs a salt and at least one iteration");
        }
        if (not (prf == oids.HmacWithSha224 || prf == oids.HmacWithSha256 || prf == oids.HmacWithSha384
            || prf == oids.HmacWithSha512)) {
            trap_with_message("invalid argument: unsupported PBKDF2 PRF");
        }
        last gcm_mode = is_gcm(cipher);
        if (not gcm_mode && not (cipher == oids.Aes128Cbc || cipher == oids.Aes192Cbc || cipher == oids.Aes256Cbc)) {
            trap_with_message("invalid argument: unsupported PBES2 cipher");
        }
        if (iv.length != (gcm_mode ? 12 : 16)) {
            trap_with_message("invalid argument: PBES2 IV or nonce has the wrong length");
        }
        last key = must_derive(prf, password, salt, iterations, aes_key_size(cipher));
        last plain = info.encode();
        last data = gcm_mode ? new gcm.AesGcm(key).seal(iv, plain.expose(), new) : cbc.encrypt(key, iv, plain.expose());
        plain.wipe();
        last kdf = writer.sequence(new([writer.oid(oid_module.of(oids.Pbkdf2)), writer.sequence(new([
            writer.octet_string(salt), writer.integer(iterations as int64),
            writer.sequence(new([writer.oid(oid_module.of(prf)), writer.null()]))]))]));
        last parameters = gcm_mode ? writer.sequence(new([writer.octet_string(iv), writer.integer(16)]))
            : writer.octet_string(iv);
        last scheme = writer.sequence(new([writer.oid(oid_module.of(cipher)), parameters]));
        last encoded = writer.sequence(new([writer.sequence(new([writer.oid(oid_module.of(oids.Pbes2)),
            writer.sequence(new([kdf, scheme]))])), writer.octet_string(data)]));
        match (parse_encrypted(encoded)) {
            Result.Ok(value) => {
                return value;
            },
            Result.Err(e) => {
                trap_with_message("invalid state: PBES2 encoding");
            },
        }
        trap_with_message("invalid state: PBES2 encoding");
    };

    /// @brief `encrypt` with a 16-byte salt and the IV or nonce drawn from the operating system's generator,
    /// PBKDF2-HMAC-SHA-256 and AES-256-GCM.
    .[NoDiscard, Since("0.3.0")]
    export let encrypt_random = func(info: PrivateKeyInfo, password: uint8[list], iterations: int)
        -> Result<EncryptedPrivateKeyInfo> {
        last salt = entropy.os_bytes(16)?;
        last nonce = entropy.os_bytes(12)?;
        return Result<EncryptedPrivateKeyInfo>.Ok(encrypt(info, password, salt, iterations, oids.HmacWithSha256,
            oids.Aes256Gcm, nonce));
    };

    let must_derive = func(prf: string, password: uint8[list], salt: uint8[list], iterations: int, length: int)
        -> uint8[list] {
        match (derive(prf, password, salt, iterations, length)) {
            Result.Ok(key) => {
                return key;
            },
            Result.Err(e) => {
                trap_with_message("invalid argument: unsupported PBKDF2 PRF");
            },
        }
        trap_with_message("invalid argument: unsupported PBKDF2 PRF");
    };
);
