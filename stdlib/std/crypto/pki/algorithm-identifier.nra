let.promote _ = import:Std.Core.Error;
let.promote _ = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Result;
let.promote _ = import:Std.Crypto.Pki.Oid;
let der = import:Std.Crypto.Pki.Der;
let oid_module = import:Std.Crypto.Pki.Oid;
let oids = import:Std.Crypto.Pki.Oids;
let writer = import:Std.Crypto.Pki.DerWriter;

/// @brief The X.509 AlgorithmIdentifier and the RSASSA-PSS parameters of RFC 4055 (Stdlib.md section 21.10).
/// @see [Std.Crypto.Pki.AlgorithmIdentifier](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Pki-AlgorithmIdentifier)
#Since("0.3.0")
export let AlgorithmIdentifier = module (
    /// @brief An algorithm OID with its optional parameters, kept as DER.
    #[Final, Since("0.3.0")]
    export let AlgorithmIdentifier = class (
        /// @brief The algorithm.
        export last oid: Oid;
        /// @brief The DER encoding of the parameters; empty when they are absent.
        export last parameters: uint8[list];
        /// @brief The DER encoding of the whole AlgorithmIdentifier.
        export last der_bytes: uint8[list];

        /// @brief An identifier with the OID and the DER of its parameters (empty for none).
        export let init = func(algorithm: Oid, parameter_der: uint8[list]) {
            oid = algorithm;
            parameters = parameter_der;
            let items: uint8[list][list] = new([writer.oid(algorithm)]);
            if (parameter_der.length > 0) {
                items.append(parameter_der);
            }
            der_bytes = writer.sequence(items);
        };

        /// @brief Whether parameters are present.
        export let has_parameters = func -> bool => parameters.length > 0;

        /// @brief Whether the parameters are exactly NULL.
        export let has_null_parameters = func -> bool => parameters.length == 2 && parameters[0] == 5
            && parameters[1] == 0;

        /// @brief The RSASSA-PSS parameters, when this is id-RSASSA-PSS.
        #NoDiscard
        export let pss_parameters = func -> Result<RsaPssParameters> {
            if (!oid.matches(oids.RsaSsaPss)) {
                return fail<RsaPssParameters>(0, "not an RSASSA-PSS identifier");
            }
            if (parameters.length == 0) {
                return fail<RsaPssParameters>(0, "RSASSA-PSS needs parameters");
            }
            return parse_pss(der.parse(parameters)?);
        };

        export let.override equals = func(other: class) -> bool {
            if (!(other is AlgorithmIdentifier)) {
                return false;
            }
            last that = other as AlgorithmIdentifier;
            return same_bytes(der_bytes, that.der_bytes);
        };

        export let.override hash_code = func -> uint32 => der.hash_range(der_bytes, 0, der_bytes.length);

        /// @brief "AlgorithmIdentifier(<name>)".
        export let.override to_string = func -> string => "AlgorithmIdentifier(" + oids.name_of(oid.dotted) + ")";
    );

    /// @brief RSASSA-PSS-params (RFC 4055, section 3.1), with the defaults filled in.
    #[Final, Since("0.3.0")]
    export let RsaPssParameters = class (
        /// @brief The message digest (default SHA-1).
        export last hash: Oid;
        /// @brief The mask generation function (MGF1).
        export last mask_generation: Oid;
        /// @brief The digest of MGF1 (default SHA-1).
        export last mask_hash: Oid;
        /// @brief The salt length in bytes (default 20).
        export last salt_length: int;
        /// @brief The trailer field (must be 1).
        export last trailer_field: int;

        export let init = func(digest: Oid, mgf: Oid, mgf_digest: Oid, salt: int, trailer: int) {
            hash = digest;
            mask_generation = mgf;
            mask_hash = mgf_digest;
            salt_length = salt;
            trailer_field = trailer;
        };

        export let.override equals = func(other: class) -> bool {
            if (!(other is RsaPssParameters)) {
                return false;
            }
            last that = other as RsaPssParameters;
            return hash.equals(that.hash) && mask_generation.equals(that.mask_generation)
                && mask_hash.equals(that.mask_hash) && salt_length == that.salt_length
                && trailer_field == that.trailer_field;
        };

        export let.override hash_code = func -> uint32 =>
            ((hash.hash_code() as uint64 * 31 + mask_hash.hash_code() as uint64 + salt_length as uint64) & 4294967295) as uint32;

        /// @brief "RsaPssParameters(<hash>, MGF1 <hash>, salt <n>)".
        export let.override to_string = func -> string =>
            $"RsaPssParameters({hash.dotted}, MGF1 {mask_hash.dotted}, salt {salt_length})";
    );

    let fail = func<T>(offset: int, message: string) -> Result<T> =>
        Result<T>.Err(Error.Parse { kind: ParseErrorKind.Syntax, offset: offset, message: message });

    let same_bytes = func(a: uint8[list], b: uint8[list]) -> bool {
        if (a.length != b.length) {
            return false;
        }
        for (let i = 0; i < a.length; i++) {
            if (a[i] != b[i]) {
                return false;
            }
        }
        return true;
    };

    /// @brief Reads an AlgorithmIdentifier: SEQUENCE { OBJECT IDENTIFIER, parameters ANY OPTIONAL }.
    #[NoDiscard, Since("0.3.0")]
    export let parse = func(e: der.Element) -> Result<AlgorithmIdentifier> {
        if (!e.is_universal(der.TagSequence)) {
            return fail<AlgorithmIdentifier>(e.offset, "AlgorithmIdentifier must be a SEQUENCE");
        }
        let r = e.reader();
        last algorithm = (r.next_universal(der.TagOid, "algorithm")?).oid()?;
        let parameters: uint8[list] = new;
        if (r.has_more()) {
            parameters = (r.next()?).encoded();
        }
        r.finish()?;
        return Result<AlgorithmIdentifier>.Ok(new AlgorithmIdentifier(algorithm, parameters));
    };

    /// @brief The identifier with no parameters (EdDSA, ML-DSA, SLH-DSA, ECDSA signatures).
    #[NoDiscard, Since("0.3.0")]
    export let without_parameters = func(dotted: string) -> AlgorithmIdentifier =>
        new AlgorithmIdentifier(oid_module.of(dotted), new);

    /// @brief The identifier with NULL parameters (the RSA PKCS #1 v1.5 signatures and rsaEncryption).
    #[NoDiscard, Since("0.3.0")]
    export let with_null = func(dotted: string) -> AlgorithmIdentifier =>
        new AlgorithmIdentifier(oid_module.of(dotted), writer.null());

    let hash_of = func(e: der.Element) -> Result<Oid> {
        // HashAlgorithm: AlgorithmIdentifier whose parameters are NULL or absent.
        last id = parse(e)?;
        if (id.has_parameters() && !id.has_null_parameters()) {
            return fail<Oid>(e.offset, "hash parameters must be NULL or absent");
        }
        return Result<Oid>.Ok(id.oid);
    };

    let parse_pss = func(e: der.Element) -> Result<RsaPssParameters> {
        if (!e.is_universal(der.TagSequence)) {
            return fail<RsaPssParameters>(e.offset, "RSASSA-PSS-params must be a SEQUENCE");
        }
        let hash = oid_module.of(oids.Sha1);
        let mgf = oid_module.of(oids.Mgf1);
        let mgf_hash = oid_module.of(oids.Sha1);
        let salt: int64 = 20;
        let trailer: int64 = 1;
        let r = e.reader();
        match (r.optional_context(0)?) {
            Optional.Some(h) => {
                hash = hash_of(h.explicit_inner()?)?;
            },
            Optional.None => {},
        }
        match (r.optional_context(1)?) {
            Optional.Some(m) => {
                last mgf_id = parse(m.explicit_inner()?)?;
                mgf = mgf_id.oid;
                if (!mgf.matches(oids.Mgf1) || mgf_id.parameters.length == 0) {
                    return fail<RsaPssParameters>(m.offset, "mask generation must be MGF1 with a hash");
                }
                mgf_hash = hash_of(der.parse(mgf_id.parameters)?)?;
            },
            Optional.None => {},
        }
        match (r.optional_context(2)?) {
            Optional.Some(s) => {
                salt = (s.explicit_inner()?).small_integer(65535)?;
            },
            Optional.None => {},
        }
        match (r.optional_context(3)?) {
            Optional.Some(t) => {
                trailer = (t.explicit_inner()?).small_integer(255)?;
                if (trailer != 1) {
                    return fail<RsaPssParameters>(t.offset, "trailer field must be 1");
                }
            },
            Optional.None => {},
        }
        r.finish()?;
        return Result<RsaPssParameters>.Ok(new RsaPssParameters(hash, mgf, mgf_hash, salt as int, trailer as int));
    };
);
