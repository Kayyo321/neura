let.promote _ = import:Std.Core.Error;
let.promote _ = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Result;
let.promote _ = import:Std.Core.Unit;
let.promote _ = import:Std.Crypto.Pki.AlgorithmIdentifier;
let.promote _ = import:Std.Crypto.Pki.Certificate;
let.promote _ = import:Std.Crypto.Pki.PublicKeyInfo;
let.promote _ = import:Std.Crypto.Pki.SignatureVerifier;
let algorithm_verifier = import:Std.Crypto.Pki.AlgorithmVerifier;
let base64 = import:Std.Encoding.Base64;
let der = import:Std.Crypto.Pki.Der;
let error = import:Std.Core.Error;
let identifiers = import:Std.Crypto.Pki.AlgorithmIdentifier;
let int64s = import:Std.Core.Int64;
let json = import:Std.Encoding.Json;
let merkle = import:Std.Crypto.Hash.MerkleTree;
let oids = import:Std.Crypto.Pki.Oids;
let sha2 = import:Std.Crypto.Hash.Sha2;
let words = import:Std.Crypto.Internal.Words;
let writer = import:Std.Crypto.Pki.DerWriter;

/// @brief Certificate Transparency, RFC 6962 (Stdlib.md section 20.9): signed certificate timestamps, signed
/// tree heads, and Merkle audit and consistency proofs.
///
/// SCT lists are read in their TLS form (`parse_list`, as in the TLS extension and the OCSP extension) and from
/// a certificate's SCT list extension (`scts_of`). `signed_data` rebuilds what a log signed: for an `X509Entry`
/// the certificate's DER; for a `PrecertEntry` the SHA-256 of the issuer's SubjectPublicKeyInfo and the
/// TBSCertificate with the SCT list extension removed. Signatures go through a SignatureVerifier with the
/// AlgorithmIdentifier that the TLS (hash, signature) pair names: (4, 3) ecdsa-with-SHA256 and (4, 1)
/// sha256WithRSAEncryption, the two RFC 6962 allows. Merkle proofs use Std.Crypto.Hash.MerkleTree over SHA-256;
/// tree sizes and indexes above 2^31 - 1 are refused (`ct.range`), because that module counts with `int`.
/// Errors are `Custom` codes ct.version, ct.log_id, ct.signature, ct.unsupported, ct.range and ct.proof; malformed
/// input is a `Parse` error.
/// @see [Std.Crypto.Pki.Transparency](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Pki-Transparency)
#Since("0.3.0")
export let Transparency = module (
    /// @brief LogEntryType of RFC 6962, section 3.1.
    #Since("0.3.0")
    export let EntryType = enum (X509Entry, PrecertEntry);

    /// @brief One SignedCertificateTimestamp (version v1).
    #[Final, Since("0.3.0")]
    export let SignedCertificateTimestamp = class (
        export last version: int;
        /// @brief The log's ID: SHA-256 of its public key's SubjectPublicKeyInfo.
        export last log_id: uint8[list];
        /// @brief Milliseconds since the epoch.
        export last timestamp: uint64;
        export last extensions: uint8[list];
        /// @brief TLS HashAlgorithm code (4 = SHA-256).
        export last hash_algorithm: int;
        /// @brief TLS SignatureAlgorithm code (1 = RSA, 3 = ECDSA).
        export last signature_algorithm: int;
        export last signature: uint8[list];
        /// @brief The serialized SCT.
        export last encoded: uint8[list];

        export let init = func(sct_version: int, id: uint8[list], time: uint64, ext: uint8[list], hash: int, sig_alg: int,
            sig: uint8[list], bytes: uint8[list]) {
            version = sct_version;
            log_id = id;
            timestamp = time;
            extensions = ext;
            hash_algorithm = hash;
            signature_algorithm = sig_alg;
            signature = sig;
            encoded = bytes;
        };

        /// @brief The AlgorithmIdentifier of the signature, when RFC 6962 allows the pair.
        export let algorithm = func -> Optional<AlgorithmIdentifier> => algorithm_of(hash_algorithm, signature_algorithm);

        export let.override equals = func(other: class) -> bool => other is SignedCertificateTimestamp
            && same((other as SignedCertificateTimestamp).encoded, encoded);

        export let.override hash_code = func -> uint32 => der.hash_range(encoded, 0, encoded.length);

        export let.override to_string = func -> string => "SignedCertificateTimestamp(log " + hex_prefix(log_id) + ", "
            + timestamp.to_string() + ")";
    );

    /// @brief A signed tree head (the get-sth response of RFC 6962, section 4.3).
    #[Final, Since("0.3.0")]
    export let SignedTreeHead = class (
        export last tree_size: int64;
        export last timestamp: uint64;
        export last root_hash: uint8[list];
        export last hash_algorithm: int;
        export last signature_algorithm: int;
        export last signature: uint8[list];

        export let init = func(size: int64, time: uint64, root: uint8[list], hash: int, sig_alg: int, sig: uint8[list]) {
            tree_size = size;
            timestamp = time;
            root_hash = root;
            hash_algorithm = hash;
            signature_algorithm = sig_alg;
            signature = sig;
        };

        /// @brief The TreeHeadSignature input: version v1, tree_hash, timestamp, tree_size and the root.
        export let signed_data = func -> uint8[list] {
            let out: uint8[list] = new([0, 1]);
            words.append64_be(out, timestamp);
            words.append64_be(out, tree_size as uint64);
            words.append_all(out, root_hash);
            return out;
        };

        export let.override equals = func(other: class) -> bool {
            if (!(other is SignedTreeHead)) {
                return false;
            }
            last that = other as SignedTreeHead;
            return that.tree_size == tree_size && that.timestamp == timestamp && same(that.root_hash, root_hash)
                && same(that.signature, signature);
        };

        export let.override hash_code = func -> uint32 => der.hash_range(root_hash, 0, root_hash.length);

        export let.override to_string = func -> string => $"SignedTreeHead(size {tree_size}, {timestamp})";
    );

    let same = func(a: uint8[list], b: uint8[list]) -> bool {
        if (a.length != b.length) {
            return false;
        }
        for (let i = 0; i < a.length; i++) {
            if (a[i] != b[i]) {
                return false;
            }
        }
        return true;
    };

    let hex_prefix = func(bytes: uint8[list]) -> string {
        last digits = "0123456789abcdef";
        let text = "";
        for (let i = 0; i < 4 && i < bytes.length; i++) {
            last b = bytes[i] as int;
            text += digits.slice(b >> 4, (b >> 4) + 1) + digits.slice(b & 15, (b & 15) + 1);
        }
        return text;
    };

    let fail = func<T>(offset: int, message: string) -> Result<T> =>
        Result<T>.Err(Error.Parse { kind: ParseErrorKind.Syntax, offset: offset, message: message });

    let failure = func<T>(code: string, message: string) -> Result<T> => Result<T>.Err(error.custom(code, message));

    let algorithm_of = func(hash: int, sig_alg: int) -> Optional<AlgorithmIdentifier> {
        if (hash == 4 && sig_alg == 3) {
            return Optional<AlgorithmIdentifier>.Some(identifiers.without_parameters(oids.EcdsaWithSha256));
        }
        if (hash == 4 && sig_alg == 1) {
            return Optional<AlgorithmIdentifier>.Some(identifiers.with_null(oids.Sha256WithRsa));
        }
        return Optional<AlgorithmIdentifier>.None;
    };

    let u16 = func(bytes: uint8[list], at: int) -> int => ((bytes[at] as int) << 8) | (bytes[at + 1] as int);

    /// @brief Reads a TLS SignedCertificateTimestampList: a 2-byte length, then SCTs each with a 2-byte length.
    /// The list and each SCT must be non-empty, and every length must fit.
    #[NoDiscard, Since("0.3.0")]
    export let parse_list = func(bytes: uint8[list]) -> Result<SignedCertificateTimestamp[list]> {
        if (bytes.length < 2) {
            return fail<SignedCertificateTimestamp[list]>(0, "truncated SCT list");
        }
        last total = u16(bytes, 0);
        if (total != bytes.length - 2 || total == 0) {
            return fail<SignedCertificateTimestamp[list]>(0, "SCT list length does not match");
        }
        let out: SignedCertificateTimestamp[list] = new;
        let at = 2;
        while (at < bytes.length) {
            if (bytes.length - at < 2) {
                return fail<SignedCertificateTimestamp[list]>(at, "truncated SCT length");
            }
            last n = u16(bytes, at);
            if (n == 0 || n > bytes.length - at - 2) {
                return fail<SignedCertificateTimestamp[list]>(at, "SCT length runs past the list");
            }
            out.append(parse_sct(der.copy_range(bytes, at + 2, at + 2 + n), at + 2)?);
            at += 2 + n;
        }
        return Result<SignedCertificateTimestamp[list]>.Ok(out);
    };

    /// @brief Reads one serialized SCT; `offset` places error offsets in the enclosing input.
    #[NoDiscard, Since("0.3.0")]
    export let parse_sct = func(bytes: uint8[list], offset: int) -> Result<SignedCertificateTimestamp> {
        // version(1) log_id(32) timestamp(8) extensions(2 + n) hash(1) signature algorithm(1) signature(2 + m)
        if (bytes.length < 47) {
            return fail<SignedCertificateTimestamp>(offset, "truncated SCT");
        }
        last version = bytes[0] as int;
        if (version != 0) {
            return failure<SignedCertificateTimestamp>("ct.version", "only SCT version v1 is defined");
        }
        last id = der.copy_range(bytes, 1, 33);
        last time = words.load64_be(bytes, 33);
        last ext_length = u16(bytes, 41);
        if (ext_length > bytes.length - 43 - 4) {
            return fail<SignedCertificateTimestamp>(offset + 41, "SCT extensions run past the SCT");
        }
        last ext = der.copy_range(bytes, 43, 43 + ext_length);
        let at = 43 + ext_length;
        last hash = bytes[at] as int;
        last sig_alg = bytes[at + 1] as int;
        last sig_length = u16(bytes, at + 2);
        if (sig_length != bytes.length - at - 4) {
            return fail<SignedCertificateTimestamp>(offset + at + 2, "SCT signature length does not match");
        }
        return Result<SignedCertificateTimestamp>.Ok(new SignedCertificateTimestamp(version, id, time, ext, hash, sig_alg,
            der.copy_range(bytes, at + 4, bytes.length), der.copy_range(bytes, 0, bytes.length)));
    };

    /// @brief The SCTs of a certificate's SCT list extension (RFC 6962, section 3.3); empty when it has none.
    #[NoDiscard, Since("0.3.0")]
    export let scts_of = func(certificate: Certificate) -> Result<SignedCertificateTimestamp[list]> {
        match (certificate.sct_list) {
            Optional.Some(list) => {
                return parse_list(list);
            },
            Optional.None => {
                return Result<SignedCertificateTimestamp[list]>.Ok(new);
            },
        }
        return Result<SignedCertificateTimestamp[list]>.Ok(new);
    };

    /// @brief The certificate's TBSCertificate with the SCT list extension removed (and the extensions field
    /// removed if that leaves it empty), re-encoded in DER: the precertificate's TBSCertificate.
    #[NoDiscard, Since("0.3.0")]
    export let precert_tbs = func(certificate: Certificate) -> Result<uint8[list]> {
        last tbs = der.parse(certificate.tbs_bytes)?;
        let fields: uint8[list][list] = new;
        for (let field in tbs.children()?) {
            if (!field.is_context(3)) {
                fields.append(field.encoded());
                continue;
            }
            let kept: uint8[list][list] = new;
            for (let ext in (field.explicit_inner()?).children()?) {
                last id = ((ext.reader()).next()?).oid()?;
                if (!id.matches(oids.SctList)) {
                    kept.append(ext.encoded());
                }
            }
            if (kept.length > 0) {
                fields.append(writer.explicit(3, writer.sequence(kept)));
            }
        }
        return Result<uint8[list]>.Ok(writer.sequence(fields));
    };

    let append24 = func(out: uint8[list], bytes: uint8[list]) {
        out.append(((bytes.length >> 16) & 255) as uint8);
        out.append(((bytes.length >> 8) & 255) as uint8);
        out.append((bytes.length & 255) as uint8);
        words.append_all(out, bytes);
    };

    let append16 = func(out: uint8[list], bytes: uint8[list]) {
        out.append(((bytes.length >> 8) & 255) as uint8);
        out.append((bytes.length & 255) as uint8);
        words.append_all(out, bytes);
    };

    /// @brief The signed_entry: the certificate (X509Entry), or the issuer key hash and the precertificate TBS
    /// (PrecertEntry, which needs the issuer).
    let signed_entry = func(entry: EntryType, certificate: Certificate, issuer: Optional<Certificate>) -> Result<uint8[list]> {
        let out: uint8[list] = new;
        if (entry == EntryType.X509Entry) {
            out.append(0);
            out.append(0);
            append24(out, certificate.der_bytes);
            return Result<uint8[list]>.Ok(out);
        }
        out.append(0);
        out.append(1);
        match (issuer) {
            Optional.Some(ca) => {
                words.append_all(out, sha2.sha256(ca.public_key.der_bytes));
            },
            Optional.None => {
                trap_with_message("invalid argument: a precertificate entry needs the issuer");
            },
        }
        append24(out, precert_tbs(certificate)?);
        return Result<uint8[list]>.Ok(out);
    };

    /// @brief The bytes the log signed for the SCT (RFC 6962, section 3.2): version, certificate_timestamp,
    /// timestamp, entry type and signed entry, and the SCT's extensions.
    #[NoDiscard, Since("0.3.0")]
    export let signed_data = func(sct: SignedCertificateTimestamp, entry: EntryType, certificate: Certificate,
        issuer: Optional<Certificate>) -> Result<uint8[list]> {
        let out: uint8[list] = new([0, 0]);
        words.append64_be(out, sct.timestamp);
        words.append_all(out, signed_entry(entry, certificate, issuer)?);
        append16(out, sct.extensions);
        return Result<uint8[list]>.Ok(out);
    };

    /// @brief Verifies the SCT under the log's key: the log ID must be the SHA-256 of the key's
    /// SubjectPublicKeyInfo, and the signature must verify over `signed_data`. Unless supplied, the verifier
    /// is the library's AlgorithmVerifier.
    /// @see [Std.Crypto.Pki.Transparency](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Pki-Transparency)
    #[NoDiscard, Since("0.3.0")]
    export let verify_sct = func(sct: SignedCertificateTimestamp, entry: EntryType, certificate: Certificate,
        issuer: Optional<Certificate>, log_key: SubjectPublicKeyInfo) -> Result<Unit> {
        return verify_sct(sct, entry, certificate, issuer, log_key, new algorithm_verifier.AlgorithmVerifier());
    } or func(sct: SignedCertificateTimestamp, entry: EntryType, certificate: Certificate,
        issuer: Optional<Certificate>, log_key: SubjectPublicKeyInfo, verifier: SignatureVerifier) -> Result<Unit> {
        if (!same(sha2.sha256(log_key.der_bytes), sct.log_id)) {
            return failure<Unit>("ct.log_id", "the SCT's log ID is not this log's key");
        }
        last data = signed_data(sct, entry, certificate, issuer)?;
        return check(sct.algorithm(), log_key, data, sct.signature, verifier);
    };

    let check = func(algorithm: Optional<AlgorithmIdentifier>, key: SubjectPublicKeyInfo, data: uint8[list],
        signature: uint8[list], verifier: SignatureVerifier) -> Result<Unit> {
        match (algorithm) {
            Optional.Some(id) => {
                if (id.oid.matches(oids.EcdsaWithSha256) && key.key_algorithm != KeyAlgorithm.Ec) {
                    return failure<Unit>("ct.signature", "the signature algorithm does not fit the log's key");
                }
                last result = verifier.verify_signature(id, key, data, signature);
                if (result == SignatureCheck.Valid) {
                    return Result<Unit>.Ok(Unit.Value);
                }
                if (result == SignatureCheck.UnsupportedAlgorithm) {
                    return failure<Unit>("ct.unsupported", "the verifier cannot check this signature");
                }
                return failure<Unit>("ct.signature", "the signature does not verify");
            },
            Optional.None => {
                return failure<Unit>("ct.unsupported", "RFC 6962 allows only SHA-256 with ECDSA or RSA");
            },
        }
        return failure<Unit>("ct.unsupported", "unreachable");
    };

    /// @brief Verifies a signed tree head under the log's key using the library verifier or a supplied verifier.
    /// @see [Std.Crypto.Pki.Transparency](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Pki-Transparency)
    #[NoDiscard, Since("0.3.0")]
    export let verify_sth = func(sth: SignedTreeHead, log_key: SubjectPublicKeyInfo) -> Result<Unit> {
        return verify_sth(sth, log_key, new algorithm_verifier.AlgorithmVerifier());
    } or func(sth: SignedTreeHead, log_key: SubjectPublicKeyInfo, verifier: SignatureVerifier)
        -> Result<Unit> {
        return check(algorithm_of(sth.hash_algorithm, sth.signature_algorithm), log_key, sth.signed_data(), sth.signature,
            verifier);
    };

    /// @brief The MerkleTreeLeaf (RFC 6962, section 3.4) of an SCT's entry: version v1, timestamped_entry, and the
    /// TimestampedEntry. Its leaf hash is `merkle.leaf_hash<Sha256>(leaf)`.
    #[NoDiscard, Since("0.3.0")]
    export let leaf_input = func(sct: SignedCertificateTimestamp, entry: EntryType, certificate: Certificate,
        issuer: Optional<Certificate>) -> Result<uint8[list]> {
        let out: uint8[list] = new([0, 0]);
        words.append64_be(out, sct.timestamp);
        words.append_all(out, signed_entry(entry, certificate, issuer)?);
        append16(out, sct.extensions);
        return Result<uint8[list]>.Ok(out);
    };

    /// @brief The leaf hash of a MerkleTreeLeaf: SHA-256(0x00 || leaf).
    #[NoDiscard, Since("0.3.0")]
    export let leaf_hash = func(leaf: uint8[list]) -> uint8[list] => merkle.leaf_hash<sha2.Sha256>(leaf);

    /// @brief Whether the audit path proves the leaf hash at `index` in the tree of `tree_size` with the root.
    #[NoDiscard, Since("0.3.0")]
    export let verify_inclusion = func(leaf_hash_bytes: uint8[list], index: int64, tree_size: int64,
        proof: uint8[list][list], root: uint8[list]) -> Result<Unit> {
        if (index < 0 || index > 2147483647 || tree_size < 0 || tree_size > 2147483647) {
            return failure<Unit>("ct.range", "tree sizes and indexes above 2^31 - 1 are not supported");
        }
        if (!merkle.verify_inclusion<sha2.Sha256>(leaf_hash_bytes, index as int, tree_size as int, proof, root)) {
            return failure<Unit>("ct.proof", "the audit path does not lead to the root");
        }
        return Result<Unit>.Ok(Unit.Value);
    };

    /// @brief Whether the consistency proof shows that the tree of `old_size` with `old_root` is a prefix of the
    /// tree of `new_size` with `new_root`.
    #[NoDiscard, Since("0.3.0")]
    export let verify_consistency = func(old_size: int64, new_size: int64, old_root: uint8[list], new_root: uint8[list],
        proof: uint8[list][list]) -> Result<Unit> {
        if (old_size < 0 || old_size > 2147483647 || new_size < 0 || new_size > 2147483647) {
            return failure<Unit>("ct.range", "tree sizes above 2^31 - 1 are not supported");
        }
        if (!merkle.verify_consistency<sha2.Sha256>(old_size as int, new_size as int, old_root, new_root, proof)) {
            return failure<Unit>("ct.proof", "the consistency proof does not hold");
        }
        return Result<Unit>.Ok(Unit.Value);
    };

    /// @brief Parses a get-sth JSON response: tree_size, timestamp, sha256_root_hash (Base64, 32 bytes) and
    /// tree_head_signature (Base64 of a TLS DigitallySigned).
    #[NoDiscard, Since("0.3.0")]
    export let parse_sth_json = func(text: string) -> Result<SignedTreeHead> {
        last value = json.parse(text)?;
        match (value) {
            json.JsonValue.Object(members) => {
                last size = number_member(members, "tree_size")?;
                last time = number_member(members, "timestamp")?;
                last root = base64_member(members, "sha256_root_hash")?;
                last signed = base64_member(members, "tree_head_signature")?;
                if (root.length != 32) {
                    return fail<SignedTreeHead>(0, "sha256_root_hash must be 32 bytes");
                }
                if (signed.length < 4 || u16(signed, 2) != signed.length - 4) {
                    return fail<SignedTreeHead>(0, "malformed tree_head_signature");
                }
                return Result<SignedTreeHead>.Ok(new SignedTreeHead(size, time as uint64, root, signed[0] as int, signed[1] as int,
                    der.copy_range(signed, 4, signed.length)));
            },
            _ => {
                return fail<SignedTreeHead>(0, "STH must be a JSON object");
            },
        }
        return fail<SignedTreeHead>(0, "STH must be a JSON object");
    };

    let number_member = func(members: [string, json.JsonValue][list], name: string) -> Result<int64> {
        match (json.member(members, name)) {
            Optional.Some(v) => {
                match (v) {
                    json.JsonValue.Number(digits) => {
                        last n = int64s.parse(digits)?;
                        if (n < 0) {
                            return fail<int64>(0, name + " must not be negative");
                        }
                        return Result<int64>.Ok(n);
                    },
                    _ => {},
                }
            },
            Optional.None => {},
        }
        return fail<int64>(0, "STH needs the number " + name);
    };

    let base64_member = func(members: [string, json.JsonValue][list], name: string) -> Result<uint8[list]> {
        match (json.member(members, name)) {
            Optional.Some(v) => {
                match (v) {
                    json.JsonValue.Text(text) => {
                        return base64.decode(text);
                    },
                    _ => {},
                }
            },
            Optional.None => {},
        }
        return fail<uint8[list]>(0, "STH needs the Base64 text " + name);
    };
);
