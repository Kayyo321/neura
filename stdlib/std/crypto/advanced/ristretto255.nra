let.promote _ = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Result;
let edwards = import:Std.Crypto.Internal.Edwards25519;
let errors = import:Std.Core.Error;
let mp = import:Std.Crypto.Internal.Mp;
let ristretto = import:Std.Crypto.Internal.Ristretto255Core;

/// @brief The prime-order ristretto255 group of RFC 9496.
/// @see [Std.Crypto.Advanced.Ristretto255](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Ristretto255)
#Since("0.3.0")
export let Ristretto255 = module (
    let read_element = func(group: ristretto.Group, bytes: uint8[list]) -> Result<edwards.Point> {
        match (group.decode(bytes)) {
            Optional.Some(point) => { return Result<edwards.Point>.Ok(point); },
            Optional.None => {
                return Result<edwards.Point>.Err(errors.custom("crypto.invalid_encoding",
                    "invalid ristretto255 element encoding"));
            },
        }
        return Result<edwards.Point>.Err(errors.custom("crypto.invalid_encoding", "invalid ristretto255 element"));
    };

    let read_scalar = func(group: ristretto.Group, bytes: uint8[list]) -> Result<uint32[list]> {
        match (group.scalar_canonical(bytes)) {
            Optional.Some(value) => { return Result<uint32[list]>.Ok(value); },
            Optional.None => {
                return Result<uint32[list]>.Err(errors.custom("crypto.invalid_encoding", "invalid ristretto255 scalar encoding"));
            },
        }
        return Result<uint32[list]>.Err(errors.custom("crypto.invalid_encoding", "invalid ristretto255 scalar"));
    };

    /// @brief The canonical 32-byte encoding of the identity.
    /// @see [Std.Crypto.Advanced.Ristretto255](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Ristretto255)
    #[NoDiscard, Since("0.3.0")]
    export let identity = func -> uint8[list] {
        let group: ristretto.Group = new;
        return group.encode(group.identity());
    };

    /// @brief The canonical 32-byte encoding of the RFC 9496 generator.
    /// @see [Std.Crypto.Advanced.Ristretto255](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Ristretto255)
    #[NoDiscard, Since("0.3.0")]
    export let generator = func -> uint8[list] {
        let group: ristretto.Group = new;
        return group.encode(group.base());
    };

    /// @brief Validates and canonically re-encodes an element. The identity is a valid group element.
    /// @see [Std.Crypto.Advanced.Ristretto255](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Ristretto255)
    #[NoDiscard, Since("0.3.0")]
    export let parse_element = func(bytes: uint8[list]) -> Result<uint8[list]> {
        let group: ristretto.Group = new;
        return Result<uint8[list]>.Ok(group.encode(read_element(group, bytes)?));
    };

    /// @brief Tests a canonical encoded point for the group identity.
    /// @see [Std.Crypto.Advanced.Ristretto255](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Ristretto255)
    #[NoDiscard, Since("0.3.0")]
    export let is_identity = func(bytes: uint8[list]) -> Result<bool> {
        let group: ristretto.Group = new;
        return Result<bool>.Ok(group.is_identity(read_element(group, bytes)?));
    };

    /// @brief Adds two canonically encoded points.
    /// @see [Std.Crypto.Advanced.Ristretto255](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Ristretto255)
    #[NoDiscard, Since("0.3.0")]
    export let add = func(left: uint8[list], right: uint8[list]) -> Result<uint8[list]> {
        let group: ristretto.Group = new;
        last a = read_element(group, left)?;
        last b = read_element(group, right)?;
        return Result<uint8[list]>.Ok(group.encode(group.add(a, b)));
    };

    /// @brief Subtracts two canonically encoded points.
    /// @see [Std.Crypto.Advanced.Ristretto255](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Ristretto255)
    #[NoDiscard, Since("0.3.0")]
    export let subtract = func(left: uint8[list], right: uint8[list]) -> Result<uint8[list]> {
        let group: ristretto.Group = new;
        last a = read_element(group, left)?;
        last b = read_element(group, right)?;
        return Result<uint8[list]>.Ok(group.encode(group.subtract(a, b)));
    };

    /// @brief Multiplies a canonical encoded point by a canonical 32-byte little-endian scalar.
    /// The multiplication is branch-free in source. The runtime does not guarantee constant time.
    /// @see [Std.Crypto.Advanced.Ristretto255](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Ristretto255)
    #[NoDiscard, Since("0.3.0")]
    export let multiply = func(scalar: uint8[list], point: uint8[list]) -> Result<uint8[list]> {
        let group: ristretto.Group = new;
        last k = read_scalar(group, scalar)?;
        last p = read_element(group, point)?;
        return Result<uint8[list]>.Ok(group.encode(group.multiply(k, p)));
    };

    /// @brief Multiplies the standardized generator by a canonical 32-byte little-endian scalar.
    /// @see [Std.Crypto.Advanced.Ristretto255](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Ristretto255)
    #[NoDiscard, Since("0.3.0")]
    export let multiply_base = func(scalar: uint8[list]) -> Result<uint8[list]> {
        let group: ristretto.Group = new;
        return Result<uint8[list]>.Ok(group.encode(group.multiply_base(read_scalar(group, scalar)?)));
    };

    /// @brief Derives a point from exactly 64 bytes as specified in RFC 9496. Another width traps.
    /// @see [Std.Crypto.Advanced.Ristretto255](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Ristretto255)
    #[NoDiscard, Since("0.3.0")]
    export let from_uniform = func(bytes: uint8[list]) -> uint8[list] {
        let group: ristretto.Group = new;
        return group.encode(group.from_uniform(bytes));
    };

    /// @brief Reduces exactly 64 little-endian bytes modulo the group order. Another width traps.
    /// @see [Std.Crypto.Advanced.Ristretto255](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Ristretto255)
    #[NoDiscard, Since("0.3.0")]
    export let scalar_reduce = func(bytes: uint8[list]) -> uint8[list] {
        if (bytes.length != 64) {
            trap_with_message("invalid argument: ristretto255 scalar reduction requires 64 bytes");
        }
        let group: ristretto.Group = new;
        return group.scalar_bytes(group.scalar_reduce(bytes));
    };

    /// @brief Adds canonically encoded scalars modulo the group order.
    /// @see [Std.Crypto.Advanced.Ristretto255](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Ristretto255)
    #[NoDiscard, Since("0.3.0")]
    export let scalar_add = func(left: uint8[list], right: uint8[list]) -> Result<uint8[list]> {
        let group: ristretto.Group = new;
        last a = read_scalar(group, left)?;
        last b = read_scalar(group, right)?;
        return Result<uint8[list]>.Ok(group.scalar_bytes(group.scalar_add(a, b)));
    };

    /// @brief Subtracts canonically encoded scalars modulo the group order.
    /// @see [Std.Crypto.Advanced.Ristretto255](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Ristretto255)
    #[NoDiscard, Since("0.3.0")]
    export let scalar_subtract = func(left: uint8[list], right: uint8[list]) -> Result<uint8[list]> {
        let group: ristretto.Group = new;
        last a = read_scalar(group, left)?;
        last b = read_scalar(group, right)?;
        return Result<uint8[list]>.Ok(group.scalar_bytes(group.scalar_subtract(a, b)));
    };

    /// @brief Multiplies canonically encoded scalars modulo the group order.
    /// @see [Std.Crypto.Advanced.Ristretto255](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Ristretto255)
    #[NoDiscard, Since("0.3.0")]
    export let scalar_multiply = func(left: uint8[list], right: uint8[list]) -> Result<uint8[list]> {
        let group: ristretto.Group = new;
        last a = read_scalar(group, left)?;
        last b = read_scalar(group, right)?;
        return Result<uint8[list]>.Ok(group.scalar_bytes(group.scalar_multiply(a, b)));
    };

    /// @brief Inverts a nonzero canonical scalar modulo the group order. Zero returns a Result error.
    /// @see [Std.Crypto.Advanced.Ristretto255](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Ristretto255)
    #[NoDiscard, Since("0.3.0")]
    export let scalar_invert = func(scalar: uint8[list]) -> Result<uint8[list]> {
        let group: ristretto.Group = new;
        last value = read_scalar(group, scalar)?;
        if (mp.is_zero(value) == 1) {
            return Result<uint8[list]>.Err(errors.custom("crypto.invalid_scalar", "ristretto255 zero has no inverse"));
        }
        return Result<uint8[list]>.Ok(group.scalar_bytes(group.scalar_invert(value)));
    };
);
