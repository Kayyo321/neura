let ristretto = import:Std.Crypto.Internal.Ristretto255Core;
let weierstrass = import:Std.Crypto.Internal.Weierstrass;
let nist = import:Std.Crypto.Internal.WeierstrassHashToCurve;
let xmd = import:Std.Crypto.Internal.HashToCurveXmd;

/// @brief RFC 9380 hash-to-curve suites for ristretto255, P-256, P-384, and P-521, plus SHA-512 XMD.
/// The NIST mappings uses branch-free field selection in source; the runtime does not guarantee constant time.
/// @see [Std.Crypto.Advanced.HashToCurve](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Advanced-HashToCurve)
.Since("0.3.0")
export let HashToCurve = module (
    /// @brief Expands with SHA-512 and the supplied domain tag, including hashed tags longer than 255 bytes.
    ///
    /// An empty domain tag or an output length outside 0 through 16,320 bytes traps.
    /// @see [Std.Crypto.Advanced.HashToCurve](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Advanced-HashToCurve)
    .[NoDiscard, Since("0.3.0")]
    export let expand_message_xmd_sha512 = func(message: uint8[list], dst: uint8[list], length: int) -> uint8[list] =>
        xmd.expand_sha512(message, dst, length);

    /// @brief The 32-byte encoding of a point derived with ristretto255_XMD:SHA-512_R255MAP_RO_.
    /// The caller supplies the protocol's nonempty domain separation tag.
    /// @see [Std.Crypto.Advanced.HashToCurve](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Advanced-HashToCurve)
    .[NoDiscard, Since("0.3.0")]
    export let hash_to_ristretto255 = func(message: uint8[list], dst: uint8[list]) -> uint8[list] {
        let group: ristretto.Group = new;
        return group.encode(group.hash_to_group(message, dst));
    };

    /// @brief The RFC 9380 P256_XMD:SHA-256_SSWU_RO_ suite with the protocol's nonempty domain separation tag.
    /// Returns SEC1 uncompressed by default or compressed when requested. The identity is encoded as 0x00.
    /// An empty domain tag traps.
    /// @see [Std.Crypto.Advanced.HashToCurve](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Advanced-HashToCurve)
    .[NoDiscard, Since("0.3.0")]
    export let hash_to_p256 = func(message: uint8[list], dst: uint8[list]) -> uint8[list] =>
        hash_to_p256(message, dst, false)
        or func(message: uint8[list], dst: uint8[list], compressed: bool) -> uint8[list] =>
            encode_nist(weierstrass.CurveId.P256, message, dst, compressed);

    /// @brief The RFC 9380 P384_XMD:SHA-384_SSWU_RO_ suite with the protocol's nonempty domain separation tag.
    /// Returns SEC1 uncompressed by default or compressed when requested. The identity is encoded as 0x00.
    /// An empty domain tag traps.
    /// @see [Std.Crypto.Advanced.HashToCurve](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Advanced-HashToCurve)
    .[NoDiscard, Since("0.3.0")]
    export let hash_to_p384 = func(message: uint8[list], dst: uint8[list]) -> uint8[list] =>
        hash_to_p384(message, dst, false)
        or func(message: uint8[list], dst: uint8[list], compressed: bool) -> uint8[list] =>
            encode_nist(weierstrass.CurveId.P384, message, dst, compressed);

    /// @brief The RFC 9380 P521_XMD:SHA-512_SSWU_RO_ suite with the protocol's nonempty domain separation tag.
    /// Returns SEC1 uncompressed by default or compressed when requested. The identity is encoded as 0x00.
    /// An empty domain tag traps.
    /// @see [Std.Crypto.Advanced.HashToCurve](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Advanced-HashToCurve)
    .[NoDiscard, Since("0.3.0")]
    export let hash_to_p521 = func(message: uint8[list], dst: uint8[list]) -> uint8[list] =>
        hash_to_p521(message, dst, false)
        or func(message: uint8[list], dst: uint8[list], compressed: bool) -> uint8[list] =>
            encode_nist(weierstrass.CurveId.P521, message, dst, compressed);

    let encode_nist = func(id: weierstrass.CurveId, message, dst: uint8[list], compressed: bool) -> uint8[list] {
        last curve = new weierstrass.Curve(id);
        last point = nist.hash_to_point(curve, message, dst);
        if (curve.is_identity(point)) {
            return new([0]);
        }
        return curve.encode(point, compressed);
    };
);
