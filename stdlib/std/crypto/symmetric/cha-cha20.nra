let.promote _ = import:Std.Crypto.Algorithm;
let chacha = import:Std.Crypto.Internal.ChaCha20;
let crypto_policy = import:Std.Crypto.Core.CryptoPolicy;
let words = import:Std.Crypto.Internal.Words;

/// @brief The raw ChaCha20 stream cipher of RFC 8439, XChaCha20, and HChaCha20 (Stdlib.md section 21.7). Building
/// blocks, not authenticated encryption.
///
/// The output is unauthenticated: anyone can flip ciphertext bits and flip the same plaintext bits. Use
/// ChaCha20Poly1305 or XChaCha20Poly1305 for data.
/// @see [Std.Crypto.Symmetric.ChaCha20](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Symmetric-ChaCha20)
.Since("0.3.0")
export let ChaCha20 = module (
    /// @brief The bytes XORed with the ChaCha20 keystream for a 32-byte key and 12-byte nonce, starting at block
    /// `counter`. Encryption and decryption are the same call. Traps on another key or nonce length, and when
    /// the block counter would pass 2^32 - 1.
    .[NoDiscard, Since("0.3.0")]
    export let xor = func(key: uint8[list], nonce: uint8[list], counter: uint32, bytes: uint8[list]) -> uint8[list] {
        crypto_policy.require(Algorithm.ChaCha20);
        check(key, nonce, 12);
        return chacha.xor_stream(key, counter, nonce, bytes);
    };

    /// @brief XChaCha20 (draft-irtf-cfrg-xchacha-03): ChaCha20 under HChaCha20(key, nonce[0:16]) with the nonce
    /// 0^4 || nonce[16:24], for a 24-byte nonce.
    .[NoDiscard, Since("0.3.0")]
    export let xchacha20_xor = func(key: uint8[list], nonce: uint8[list], counter: uint32, bytes: uint8[list]) -> uint8[list] {
        crypto_policy.require(Algorithm.ChaCha20);
        check(key, nonce, 24);
        return chacha.xor_stream(chacha.hchacha20(key, words.slice(nonce, 0, 16)), counter, short_nonce(nonce), bytes);
    };

    /// @brief HChaCha20 of a 32-byte key and a 16-byte input: a 32-byte subkey.
    .[NoDiscard, Since("0.3.0")]
    export let hchacha20 = func(key: uint8[list], nonce: uint8[list]) -> uint8[list] {
        crypto_policy.require(Algorithm.ChaCha20);
        check(key, nonce, 16);
        return chacha.hchacha20(key, nonce);
    };

    /// @brief 0^4 || nonce[16:24]: the ChaCha20 nonce of an XChaCha20 nonce.
    .[Internal, Since("0.3.0")]
    export let short_nonce = func(nonce: uint8[list]) -> uint8[list] {
        let out = words.zeros(4);
        for (let i in 16 .. 24) {
            out.append(nonce[i]);
        }
        return out;
    };

    let check = func(key: uint8[list], nonce: uint8[list], nonce_length: int) {
        if (key.length != 32) {
            trap_with_message("invalid argument: ChaCha20 key must be 32 bytes");
        }
        if (nonce.length != nonce_length) {
            trap_with_message("invalid argument: ChaCha20 nonce must be " .. nonce_length.to_string() .. " bytes");
        }
    };
);
