let.promote _ = import:Std.Core.Error;
let.promote _ = import:Std.Core.Result;
let.promote _ = import:Std.Crypto.AeadCipher;
let.promote _ = import:Std.Crypto.Algorithm;
let.promote _ = import:Std.Crypto.SymmetricKey;
let aead = import:Std.Crypto.Internal.Aead;
let chacha = import:Std.Crypto.Internal.ChaCha20;
let constant_time = import:Std.Crypto.Core.ConstantTime;
let crypto_policy = import:Std.Crypto.Core.CryptoPolicy;
let poly1305 = import:Std.Crypto.Mac.Poly1305;
let words = import:Std.Crypto.Internal.Words;

/// @brief ChaCha20-Poly1305 of RFC 8439, section 2.8, with 96-bit nonces (Stdlib.md section 21.7).
///
/// A nonce must never repeat under one key. For random nonces use XChaCha20Poly1305, whose 192-bit nonces do
/// not collide in practice.
/// @see [Std.Crypto.Symmetric.ChaCha20Poly1305](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Symmetric-ChaCha20Poly1305)
#Since("0.3.0")
export let ChaCha20Poly1305 = module (
    /// @brief The AEAD under a 32-byte key.
    #[Final, Since("0.3.0")]
    export let ChaCha20Poly1305 = class implements AeadCipher<SymmetricKey<ChaCha20Poly1305>, uint8[list], uint8[list]> (
        let key_bytes: uint8[list] = new;

        /// @brief Keys the cipher with a 32-byte key (typed, or raw bytes); another length traps.
        export let init = func(key: SymmetricKey<ChaCha20Poly1305>) {
            setup(key.expose());
        } or func(key: uint8[list]) {
            setup(key);
        };

        let setup = func(key: uint8[list]) {
            aead.check_key(key.length == 32, "ChaCha20-Poly1305", "32");
            crypto_policy.require(Algorithm.ChaCha20Poly1305);
            key_bytes = words.copy(key);
        };

        /// @brief `ChaCha20Poly1305`.
        export let algorithm = func -> Algorithm => Algorithm.ChaCha20Poly1305;
        /// @brief 12.
        export let nonce_length = func -> int => 12;
        /// @brief 16.
        export let tag_length = func -> int => 16;

        export let seal = func(nonce: uint8[list], plaintext: uint8[list], associated_data: uint8[list]) -> uint8[list] {
            aead.check_nonce(nonce, 12, "ChaCha20-Poly1305");
            return seal_with(key_bytes, nonce, plaintext, associated_data);
        };

        export let open = func(nonce: uint8[list], sealed: uint8[list], associated_data: uint8[list])
            -> Result<uint8[list]> {
            aead.check_nonce(nonce, 12, "ChaCha20-Poly1305");
            return open_with(key_bytes, nonce, sealed, associated_data);
        };

        export let.override to_string = func -> string => "ChaCha20Poly1305(<redacted>)";
    );

    /// @brief The tag of RFC 8439, section 2.8: Poly1305 under the first 32 bytes of block 0, over the data,
    /// the ciphertext, each padded to 16 bytes, and their little-endian 64-bit lengths.
    let tag_of = func(key: uint8[list], nonce: uint8[list], ciphertext: uint8[list], data: uint8[list]) -> uint8[list] {
        let one_time = words.slice(chacha.block(key, 0, nonce), 0, 32);
        let mac = new poly1305.Poly1305(one_time);
        words.wipe(one_time);
        mac.update(data);
        mac.update(words.zeros((16 - data.length % 16) % 16));
        mac.update(ciphertext);
        mac.update(words.zeros((16 - ciphertext.length % 16) % 16));
        let lengths: uint8[list] = new;
        words.append64_le(lengths, data.length as uint64);
        words.append64_le(lengths, ciphertext.length as uint64);
        mac.update(lengths);
        return mac.finish();
    };

    /// @brief Seals under a 32-byte key and 12-byte nonce. Used by XChaCha20Poly1305 with its subkey.
    #[Internal, Since("0.3.0")]
    export let seal_with = func(key: uint8[list], nonce: uint8[list], plaintext: uint8[list], data: uint8[list]) -> uint8[list] {
        let out = chacha.xor_stream(key, 1, nonce, plaintext);
        words.append_all(out, tag_of(key, nonce, out, data));
        return out;
    };

    /// @brief Opens under a 32-byte key and 12-byte nonce. Used by XChaCha20Poly1305 with its subkey.
    #[Internal, Since("0.3.0")]
    export let open_with = func(key: uint8[list], nonce: uint8[list], sealed: uint8[list], data: uint8[list])
        -> Result<uint8[list]> {
        if (sealed.length < 16) {
            return aead.failure();
        }
        last body = words.slice(sealed, 0, sealed.length - 16);
        if (!constant_time.ct_eq(tag_of(key, nonce, body, data), words.slice(sealed, sealed.length - 16, sealed.length))) {
            return aead.failure();
        }
        return Result<uint8[list]>.Ok(chacha.xor_stream(key, 1, nonce, body));
    };
);
