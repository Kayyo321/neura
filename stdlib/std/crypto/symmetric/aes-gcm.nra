let.promote _ = import:Std.Core.Error;
let.promote _ = import:Std.Core.Result;
let.promote _ = import:Std.Crypto.AeadCipher;
let.promote _ = import:Std.Crypto.Algorithm;
let.promote _ = import:Std.Crypto.SymmetricKey;
let aead = import:Std.Crypto.Internal.Aead;
let aes = import:Std.Crypto.Internal.Aes;
let constant_time = import:Std.Crypto.Core.ConstantTime;
let crypto_policy = import:Std.Crypto.Core.CryptoPolicy;
let gf128 = import:Std.Crypto.Internal.Gf128;
let words = import:Std.Crypto.Internal.Words;

/// @brief AES-GCM of NIST SP 800-38D with 96-bit nonces and 128-bit tags (Stdlib.md section 21.7).
///
/// A nonce must never repeat under one key: a repeat reveals the XOR of two plaintexts and lets an attacker
/// forge tags. Where nonces cannot be guaranteed unique, prefer AesGcmSiv or XChaCha20Poly1305.
/// @see [Std.Crypto.Symmetric.AesGcm](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Symmetric-AesGcm)
#Since("0.3.0")
export let AesGcm = module (
    /// @brief AES-128-GCM, AES-192-GCM or AES-256-GCM, chosen by the key length.
    #[Final, Since("0.3.0")]
    export let AesGcm = class implements AeadCipher<SymmetricKey<AesGcm>, uint8[list], uint8[list]> (
        let cipher: aes.Cipher;
        let hash_key: uint8[list] = new;
        let alg: Algorithm = Algorithm.Aes256Gcm;

        /// @brief Keys the cipher with a 16-, 24- or 32-byte key (typed, or raw bytes); another length traps.
        export let init = func(key: SymmetricKey<AesGcm>) {
            setup(key.expose());
        } or func(key: uint8[list]) {
            setup(key);
        };

        let setup = func(key: uint8[list]) {
            aead.check_key(key.length == 16 || key.length == 24 || key.length == 32, "AES-GCM", "16, 24 or 32");
            if (key.length == 16) {
                alg = Algorithm.Aes128Gcm;
            } else if (key.length == 24) {
                alg = Algorithm.Aes192Gcm;
            }
            crypto_policy.require(alg);
            cipher = new(key);
            hash_key = cipher.encrypt(words.zeros(16), 0);
        };

        /// @brief `Aes128Gcm`, `Aes192Gcm` or `Aes256Gcm`.
        export let algorithm = func -> Algorithm => alg;
        /// @brief 12.
        export let nonce_length = func -> int => 12;
        /// @brief 16.
        export let tag_length = func -> int => 16;

        export let seal = func(nonce: uint8[list], plaintext: uint8[list], associated_data: uint8[list]) -> uint8[list] {
            aead.check_nonce(nonce, 12, "AES-GCM");
            last j0 = first_counter(nonce);
            let out = ctr(j0, plaintext);
            words.append_all(out, tag(j0, associated_data, out));
            return out;
        };

        export let open = func(nonce: uint8[list], sealed: uint8[list], associated_data: uint8[list])
                -> Result<uint8[list]> {
            aead.check_nonce(nonce, 12, "AES-GCM");
            if (sealed.length < 16) {
                return aead.failure();
            }
            last body = words.slice(sealed, 0, sealed.length - 16);
            last j0 = first_counter(nonce);
            if (!constant_time.ct_eq(tag(j0, associated_data, body), words.slice(sealed, sealed.length - 16, sealed.length))) {
                return aead.failure();
            }
            return Result<uint8[list]>.Ok(ctr(j0, body));
        };

        /// @brief J0 = nonce || 0^31 || 1.
        let first_counter = func(nonce: uint8[list]) -> uint8[list] {
            let block = words.copy(nonce);
            words.append32_be(block, 1);
            return block;
        };

        /// @brief GCTR from inc32(J0).
        let ctr = func(j0: uint8[list], bytes: uint8[list]) -> uint8[list] {
            let counter = j0;
            let out: uint8[list] = new;
            for (let start = 0; start < bytes.length; start += 16) {
                counter = aead.increment32_be(counter);
                last stream = cipher.encrypt(counter, 0);
                for (let i = 0; i < 16 && start + i < bytes.length; i++) {
                    out.append(bytes[start + i] ^ stream[i]);
                }
            }
            return out;
        };

        /// @brief E(K, J0) xor GHASH(A, C, lengths).
        let tag = func(j0: uint8[list], data: uint8[list], ciphertext: uint8[list]) -> uint8[list] {
            let ghash = new gf128.Hasher(hash_key, false);
            ghash.update_padded(data);
            ghash.update_padded(ciphertext);
            let lengths: uint8[list] = new;
            words.append64_be(lengths, (data.length as uint64) * 8);
            words.append64_be(lengths, (ciphertext.length as uint64) * 8);
            ghash.block(lengths, 0);
            return words.xor(cipher.encrypt(j0, 0), ghash.digest());
        };

        export let.override to_string = func -> string => "AesGcm(<redacted>)";
    );
);
