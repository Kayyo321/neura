let.promote _ = import:Std.Crypto.Algorithm;
let.promote _ = import:Std.Crypto.Mac.Authenticator;
let constant_time = import:Std.Crypto.Core.ConstantTime;
let crypto_policy = import:Std.Crypto.Core.CryptoPolicy;
let words = import:Std.Crypto.Internal.Words;

/// @brief The Poly1305 one-time authenticator of RFC 8439, section 2.5 (Stdlib.md section 21.5).
///
/// The accumulator is five 26-bit limbs in uint64 words, so every product and sum stays below 2^60, and the
/// final reduction selects between h and h - p with a mask rather than a branch.
/// @see [Std.Crypto.Mac.Poly1305](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Mac-Poly1305)
#Since("0.3.0")
export let Poly1305 = module (
    /// @brief Poly1305 under a 32-byte one-time key (r, then s). A key must never authenticate two messages;
    /// the AEADs of Std.Crypto.Symmetric derive a fresh one per nonce.
    #[Final, Since("0.3.0")]
    export let Poly1305 = class implements Authenticator (
        let r0: uint64;
        let r1: uint64;
        let r2: uint64;
        let r3: uint64;
        let r4: uint64;
        let pad: uint8[list] = new;
        let h0: uint64 = 0;
        let h1: uint64 = 0;
        let h2: uint64 = 0;
        let h3: uint64 = 0;
        let h4: uint64 = 0;
        let pending: uint8[list] = new;
        let done: bool = false;

        /// @brief Takes the 32-byte one-time key; any other length traps.
        export let init = func(key: uint8[list]) {
            crypto_policy.require(Algorithm.Poly1305);
            if (key.length != 32) {
                trap_with_message("invalid argument: Poly1305 key must be 32 bytes");
            }
            r0 = (words.load32_le(key, 0) as uint64) & 67108863;
            r1 = ((words.load32_le(key, 3) as uint64) >> 2) & 67108611;
            r2 = ((words.load32_le(key, 6) as uint64) >> 4) & 67092735;
            r3 = ((words.load32_le(key, 9) as uint64) >> 6) & 66076671;
            r4 = ((words.load32_le(key, 12) as uint64) >> 8) & 1048575;
            for (let i in 16 .. 32) {
                pad.append(key[i]);
            }
        };

        /// @brief `Algorithm.Poly1305`.
        export let algorithm = func -> Algorithm => Algorithm.Poly1305;
        /// @brief 16.
        export let tag_length = func -> int => 16;

        export let update = func(bytes: uint8[list]) {
            if (done) {
                trap_with_message("invalid state: mac finished");
            }
            let i = 0;
            if (pending.length > 0) {
                while (i < bytes.length && pending.length < 16) {
                    pending.append(bytes[i]);
                    i++;
                }
                if (pending.length < 16) {
                    return;
                }
                block(pending, 0, 16777216);
                pending = new;
            }
            while (i + 16 <= bytes.length) {
                block(bytes, i, 16777216);
                i += 16;
            }
            while (i < bytes.length) {
                pending.append(bytes[i]);
                i++;
            }
        };

        /// @brief Adds one 16-byte block with the high bit `high` (2^24 for a full block, 0 for the padded last).
        let block = func(m: uint8[list], at: int, high: uint64) {
            h0 += (words.load32_le(m, at) as uint64) & 67108863;
            h1 += ((words.load32_le(m, at + 3) as uint64) >> 2) & 67108863;
            h2 += ((words.load32_le(m, at + 6) as uint64) >> 4) & 67108863;
            h3 += ((words.load32_le(m, at + 9) as uint64) >> 6) & 67108863;
            h4 += ((words.load32_le(m, at + 12) as uint64) >> 8) | high;
            last s1 = r1 * 5;
            last s2 = r2 * 5;
            last s3 = r3 * 5;
            last s4 = r4 * 5;
            last d0 = h0 * r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1;
            let d1 = h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3 + h4 * s2;
            let d2 = h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3;
            let d3 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4;
            let d4 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0;
            h0 = d0 & 67108863;
            d1 += d0 >> 26;
            h1 = d1 & 67108863;
            d2 += d1 >> 26;
            h2 = d2 & 67108863;
            d3 += d2 >> 26;
            h3 = d3 & 67108863;
            d4 += d3 >> 26;
            h4 = d4 & 67108863;
            h0 += (d4 >> 26) * 5;
            h1 += h0 >> 26;
            h0 = h0 & 67108863;
        };

        export let finish = func -> uint8[list] {
            if (done) {
                trap_with_message("invalid state: mac finished");
            }
            done = true;
            if (pending.length > 0) {
                let last_block = pending;
                last_block.append(1);
                while (last_block.length < 16) {
                    last_block.append(0);
                }
                block(last_block, 0, 0);
            }
            // Full carry.
            h2 += h1 >> 26;
            h1 = h1 & 67108863;
            h3 += h2 >> 26;
            h2 = h2 & 67108863;
            h4 += h3 >> 26;
            h3 = h3 & 67108863;
            h0 += (h4 >> 26) * 5;
            h4 = h4 & 67108863;
            h1 += h0 >> 26;
            h0 = h0 & 67108863;
            // g = h + 5 - 2^130; keep g when it is not negative.
            let g0 = h0 + 5;
            let g1 = h1 + (g0 >> 26);
            g0 = g0 & 67108863;
            let g2 = h2 + (g1 >> 26);
            g1 = g1 & 67108863;
            let g3 = h3 + (g2 >> 26);
            g2 = g2 & 67108863;
            let g4 = h4 + (g3 >> 26) + 4294967296 - 67108864;
            g3 = g3 & 67108863;
            last keep_g = (g4 >> 32) & 1;
            g4 = g4 & 67108863;
            last mask = keep_g * 67108863;
            h0 = (h0 & ~mask) | (g0 & mask);
            h1 = (h1 & ~mask) | (g1 & mask);
            h2 = (h2 & ~mask) | (g2 & mask);
            h3 = (h3 & ~mask) | (g3 & mask);
            h4 = (h4 & ~mask) | (g4 & mask);
            // h mod 2^128, plus s.
            last w0 = (h0 | (h1 << 26)) & 4294967295;
            last w1 = ((h1 >> 6) | (h2 << 20)) & 4294967295;
            last w2 = ((h2 >> 12) | (h3 << 14)) & 4294967295;
            last w3 = ((h3 >> 18) | (h4 << 8)) & 4294967295;
            let f = w0 + (words.load32_le(pad, 0) as uint64);
            let tag: uint8[list] = new;
            words.append32_le(tag, (f & 4294967295) as uint32);
            f = w1 + (words.load32_le(pad, 4) as uint64) + (f >> 32);
            words.append32_le(tag, (f & 4294967295) as uint32);
            f = w2 + (words.load32_le(pad, 8) as uint64) + (f >> 32);
            words.append32_le(tag, (f & 4294967295) as uint32);
            f = w3 + (words.load32_le(pad, 12) as uint64) + (f >> 32);
            words.append32_le(tag, (f & 4294967295) as uint32);
            words.wipe(pad);
            return tag;
        };

        export let verify = func(tag: uint8[list]) -> bool => constant_time.ct_eq(finish(), tag);

        export let.override to_string = func -> string => "Poly1305(<redacted>)";
    );

    /// @brief The 16-byte Poly1305 tag of the message under the one-time key.
    #[NoDiscard, Since("0.3.0")]
    export let mac = func(key: uint8[list], message: uint8[list]) -> uint8[list] {
        let poly = new Poly1305(key);
        poly.update(message);
        return poly.finish();
    };
);
