/// @brief A reusable Keccak sponge for the post-quantum schemes (FIPS 202 SHAKE and SHA-3), which hash many short
/// inputs: `reset` starts a new message without allocating, bytes are absorbed straight into the lanes, and
/// the permutation is unrolled over the 25 lanes. Internal. The round constants are those of
/// Std.Crypto.Internal.Keccak (printed by scripts/crypto-vectors/constants.py), and the results equal it.
#Since("0.3.0")
export let PqcKeccak = module (
    /// @brief A sponge with a fixed rate and domain byte, reused for many messages.
    export let Xof = class (
        let lanes: uint64[list] = new;
        let round_constants: uint64[list] = new([
            1, 32898, 9223372036854808714, 9223372039002292224,
            32907, 2147483649, 9223372039002292353, 9223372036854808585,
            138, 136, 2147516425, 2147483658,
            2147516555, 9223372036854775947, 9223372036854808713, 9223372036854808579,
            9223372036854808578, 9223372036854775936, 32778, 9223372039002259466,
            9223372039002292353, 9223372036854808704, 2147483649, 9223372039002292232
        ]);

        last rate: int;
        last domain: uint64;
        let at: int = 0;
        let squeezing: bool = false;

        /// @brief A sponge of `rate_bytes` (168 SHAKE128, 136 SHAKE256 and SHA3-256, 72 SHA3-512) with the
        /// domain byte (0x1F SHAKE, 0x06 SHA-3).
        export let init = func(rate_bytes: int, domain_byte: uint8) {
            rate = rate_bytes;
            domain = domain_byte as uint64;
            for (let i in 0 .. 25) {
                lanes.append(0);
            }
        };

        /// @brief Starts a new message.
        export let reset = func {
            for (let i in 0 .. 25) {
                lanes[i] = 0;
            }
            at = 0;
            squeezing = false;
        };

        /// @brief Absorbs the bytes. Traps with "invalid state: digest finished" once squeezing has started.
        export let absorb = func(bytes: uint8[list]) {
            if (squeezing) {
                trap_with_message("invalid state: digest finished");
            }
            for (let b in bytes) {
                lanes[at >> 3] = lanes[at >> 3] ^ ((b as uint64) << ((at & 7) * 8));
                at++;
                if (at == rate) {
                    permute(lanes);
                    at = 0;
                }
            }
        };

        /// @brief Appends the next `count` output bytes to `out`.
        export let squeeze_into = func(out: uint8[list], count: int) {
            if (not squeezing) {
                squeezing = true;
                lanes[at >> 3] = lanes[at >> 3] ^ (domain << ((at & 7) * 8));
                last end = rate - 1;
                lanes[end >> 3] = lanes[end >> 3] ^ ((128 as uint64) << ((end & 7) * 8));
                permute(lanes);
                at = 0;
            }
            for (let i = 0; i < count; i++) {
                if (at == rate) {
                    permute(lanes);
                    at = 0;
                }
                out.append(((lanes[at >> 3] >> ((at & 7) * 8)) & 255) as uint8);
                at++;
            }
        };

        /// @brief The next `count` output bytes.
        export let squeeze = func(count: int) -> uint8[list] {
            let out: uint8[list] = new;
            squeeze_into(out, count);
            return out;
        };

        /// @brief Keccak-f[1600] on the lanes, unrolled over the 25 lanes of a round.
        let permute = func(s: uint64[list]) {
            let a0 = s[0];
            let a1 = s[1];
            let a2 = s[2];
            let a3 = s[3];
            let a4 = s[4];
            let a5 = s[5];
            let a6 = s[6];
            let a7 = s[7];
            let a8 = s[8];
            let a9 = s[9];
            let a10 = s[10];
            let a11 = s[11];
            let a12 = s[12];
            let a13 = s[13];
            let a14 = s[14];
            let a15 = s[15];
            let a16 = s[16];
            let a17 = s[17];
            let a18 = s[18];
            let a19 = s[19];
            let a20 = s[20];
            let a21 = s[21];
            let a22 = s[22];
            let a23 = s[23];
            let a24 = s[24];
            for (let round in 0 .. 24) {
                last c0 = a0 ^ a5 ^ a10 ^ a15 ^ a20;
                last c1 = a1 ^ a6 ^ a11 ^ a16 ^ a21;
                last c2 = a2 ^ a7 ^ a12 ^ a17 ^ a22;
                last c3 = a3 ^ a8 ^ a13 ^ a18 ^ a23;
                last c4 = a4 ^ a9 ^ a14 ^ a19 ^ a24;
                last d0 = c4 ^ ((c1 << 1) | (c1 >> 63));
                last d1 = c0 ^ ((c2 << 1) | (c2 >> 63));
                last d2 = c1 ^ ((c3 << 1) | (c3 >> 63));
                last d3 = c2 ^ ((c4 << 1) | (c4 >> 63));
                last d4 = c3 ^ ((c0 << 1) | (c0 >> 63));
                last b0 = a0 ^ d0;
                last t1 = a1 ^ d1;
                last b10 = (t1 << 1) | (t1 >> 63);
                last t2 = a2 ^ d2;
                last b20 = (t2 << 62) | (t2 >> 2);
                last t3 = a3 ^ d3;
                last b5 = (t3 << 28) | (t3 >> 36);
                last t4 = a4 ^ d4;
                last b15 = (t4 << 27) | (t4 >> 37);
                last t5 = a5 ^ d0;
                last b16 = (t5 << 36) | (t5 >> 28);
                last t6 = a6 ^ d1;
                last b1 = (t6 << 44) | (t6 >> 20);
                last t7 = a7 ^ d2;
                last b11 = (t7 << 6) | (t7 >> 58);
                last t8 = a8 ^ d3;
                last b21 = (t8 << 55) | (t8 >> 9);
                last t9 = a9 ^ d4;
                last b6 = (t9 << 20) | (t9 >> 44);
                last t10 = a10 ^ d0;
                last b7 = (t10 << 3) | (t10 >> 61);
                last t11 = a11 ^ d1;
                last b17 = (t11 << 10) | (t11 >> 54);
                last t12 = a12 ^ d2;
                last b2 = (t12 << 43) | (t12 >> 21);
                last t13 = a13 ^ d3;
                last b12 = (t13 << 25) | (t13 >> 39);
                last t14 = a14 ^ d4;
                last b22 = (t14 << 39) | (t14 >> 25);
                last t15 = a15 ^ d0;
                last b23 = (t15 << 41) | (t15 >> 23);
                last t16 = a16 ^ d1;
                last b8 = (t16 << 45) | (t16 >> 19);
                last t17 = a17 ^ d2;
                last b18 = (t17 << 15) | (t17 >> 49);
                last t18 = a18 ^ d3;
                last b3 = (t18 << 21) | (t18 >> 43);
                last t19 = a19 ^ d4;
                last b13 = (t19 << 8) | (t19 >> 56);
                last t20 = a20 ^ d0;
                last b14 = (t20 << 18) | (t20 >> 46);
                last t21 = a21 ^ d1;
                last b24 = (t21 << 2) | (t21 >> 62);
                last t22 = a22 ^ d2;
                last b9 = (t22 << 61) | (t22 >> 3);
                last t23 = a23 ^ d3;
                last b19 = (t23 << 56) | (t23 >> 8);
                last t24 = a24 ^ d4;
                last b4 = (t24 << 14) | (t24 >> 50);
                a0 = b0 ^ ((~b1) & b2);
                a1 = b1 ^ ((~b2) & b3);
                a2 = b2 ^ ((~b3) & b4);
                a3 = b3 ^ ((~b4) & b0);
                a4 = b4 ^ ((~b0) & b1);
                a5 = b5 ^ ((~b6) & b7);
                a6 = b6 ^ ((~b7) & b8);
                a7 = b7 ^ ((~b8) & b9);
                a8 = b8 ^ ((~b9) & b5);
                a9 = b9 ^ ((~b5) & b6);
                a10 = b10 ^ ((~b11) & b12);
                a11 = b11 ^ ((~b12) & b13);
                a12 = b12 ^ ((~b13) & b14);
                a13 = b13 ^ ((~b14) & b10);
                a14 = b14 ^ ((~b10) & b11);
                a15 = b15 ^ ((~b16) & b17);
                a16 = b16 ^ ((~b17) & b18);
                a17 = b17 ^ ((~b18) & b19);
                a18 = b18 ^ ((~b19) & b15);
                a19 = b19 ^ ((~b15) & b16);
                a20 = b20 ^ ((~b21) & b22);
                a21 = b21 ^ ((~b22) & b23);
                a22 = b22 ^ ((~b23) & b24);
                a23 = b23 ^ ((~b24) & b20);
                a24 = b24 ^ ((~b20) & b21);
                a0 = a0 ^ round_constants[round];
            }
            s[0] = a0;
            s[1] = a1;
            s[2] = a2;
            s[3] = a3;
            s[4] = a4;
            s[5] = a5;
            s[6] = a6;
            s[7] = a7;
            s[8] = a8;
            s[9] = a9;
            s[10] = a10;
            s[11] = a11;
            s[12] = a12;
            s[13] = a13;
            s[14] = a14;
            s[15] = a15;
            s[16] = a16;
            s[17] = a17;
            s[18] = a18;
            s[19] = a19;
            s[20] = a20;
            s[21] = a21;
            s[22] = a22;
            s[23] = a23;
            s[24] = a24;
        };

        export let.override to_string = func -> string => "PqcKeccak.Xof";
    );
);
