let words = import:Std.Crypto.Internal.Words;

/// @brief The SHA-256 and SHA-512 compression functions of FIPS 180-4 with a chosen initial value and output
/// length, for SHA-224, SHA-384, SHA-512 and SHA-512/256. Internal. (SHA-256 itself runs the kernel of
/// Std.Digest.Sha256.) The constants are printed by scripts/crypto-vectors/constants.py.
#Since("0.3.0")
export let Sha2Core = module (
    /// @brief A new list of the table (a function, so that tasks can use it: arrays are not transferable).
    let k256_table = func -> uint32[list] => new([
        1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
        3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
        3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
        2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
        666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
        2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
        430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
        1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298
    ]);

    /// @brief A new list of the table (a function, so that tasks can use it: arrays are not transferable).
    let k512_table = func -> uint64[list] => new([
        4794697086780616226, 8158064640168781261, 13096744586834688815, 16840607885511220156,
        4131703408338449720, 6480981068601479193, 10538285296894168987, 12329834152419229976,
        15566598209576043074, 1334009975649890238, 2608012711638119052, 6128411473006802146,
        8268148722764581231, 9286055187155687089, 11230858885718282805, 13951009754708518548,
        16472876342353939154, 17275323862435702243, 1135362057144423861, 2597628984639134821,
        3308224258029322869, 5365058923640841347, 6679025012923562964, 8573033837759648693,
        10970295158949994411, 12119686244451234320, 12683024718118986047, 13788192230050041572,
        14330467153632333762, 15395433587784984357, 489312712824947311, 1452737877330783856,
        2861767655752347644, 3322285676063803686, 5560940570517711597, 5996557281743188959,
        7280758554555802590, 8532644243296465576, 9350256976987008742, 10552545826968843579,
        11727347734174303076, 12113106623233404929, 14000437183269869457, 14369950271660146224,
        15101387698204529176, 15463397548674623760, 17586052441742319658, 1182934255886127544,
        1847814050463011016, 2177327727835720531, 2830643537854262169, 3796741975233480872,
        4115178125766777443, 5681478168544905931, 6601373596472566643, 7507060721942968483,
        8399075790359081724, 8693463985226723168, 9568029438360202098, 10144078919501101548,
        10430055236837252648, 11840083180663258601, 13761210420658862357, 14299343276471374635,
        14566680578165727644, 15097957966210449927, 16922976911328602910, 17689382322260857208,
        500013540394364858, 748580250866718886, 1242879168328830382, 1977374033974150939,
        2944078676154940804, 3659926193048069267, 4368137639120453308, 4836135668995329356,
        5532061633213252278, 6448918945643986474, 6902733635092675308, 7801388544844847127
    ]);

    /// @brief SHA-256 compression over 32-bit words, with the initial value and the number of output words.
    export let Core256 = class (
        let state: uint32[list] = new;
        let schedule: uint32[list] = new;
        let constants: uint32[list] = k256_table();
        let pending: uint8[list] = new;
        let total: uint64 = 0;
        let finished: bool = false;
        last out_words: int;

        export let init = func(iv: uint32[], output_words: int) {
            for (let word in iv) {
                state.append(word);
            }
            for (let t = 0; t < 64; t++) {
                schedule.append(0);
            }
            out_words = output_words;
        };

        export let update = func(bytes: uint8[list]) {
            if (finished) {
                trap_with_message("invalid state: digest finished");
            }
            total += bytes.length as uint64;
            let i = 0;
            if (pending.length > 0) {
                while (i < bytes.length && pending.length < 64) {
                    pending.append(bytes[i]);
                    i++;
                }
                if (pending.length < 64) {
                    return;
                }
                compress(pending, 0);
                pending = new;
            }
            while (i + 64 <= bytes.length) {
                compress(bytes, i);
                i += 64;
            }
            while (i < bytes.length) {
                pending.append(bytes[i]);
                i++;
            }
        };

        export let finish = func -> uint8[list] {
            if (finished) {
                trap_with_message("invalid state: digest finished");
            }
            finished = true;
            last bits = total * 8;
            let tail = pending;
            pending = new;
            tail.append(128);
            while (tail.length % 64 != 56) {
                tail.append(0);
            }
            words.append64_be(tail, bits);
            for (let offset = 0; offset < tail.length; offset += 64) {
                compress(tail, offset);
            }
            let digest: uint8[list] = new;
            for (let i = 0; i < out_words; i++) {
                words.append32_be(digest, state[i]);
            }
            return digest;
        };

        let compress = func(block: uint8[list], offset: int) {
            let w = schedule;
            for (let t = 0; t < 16; t++) {
                w[t] = words.load32_be(block, offset + 4 * t);
            }
            for (let t = 16; t < 64; t++) {
                last x = w[t - 15];
                last y = w[t - 2];
                last s0 = ((x >> 7) | (x << 25)) ^ ((x >> 18) | (x << 14)) ^ (x >> 3);
                last s1 = ((y >> 17) | (y << 15)) ^ ((y >> 19) | (y << 13)) ^ (y >> 10);
                w[t] = (((w[t - 16] as uint64) + (s0 as uint64) + (w[t - 7] as uint64) + (s1 as uint64))
                    & 4294967295) as uint32;
            }
            let a = state[0];
            let b = state[1];
            let c = state[2];
            let d = state[3];
            let e = state[4];
            let f = state[5];
            let g = state[6];
            let h = state[7];
            let k = constants;
            for (let t = 0; t < 64; t++) {
                last big_s1 = ((e >> 6) | (e << 26)) ^ ((e >> 11) | (e << 21)) ^ ((e >> 25) | (e << 7));
                last choose = (e & f) ^ ((~e) & g);
                last t1 = (h as uint64) + (big_s1 as uint64) + (choose as uint64) + (k[t] as uint64) + (w[t] as uint64);
                last big_s0 = ((a >> 2) | (a << 30)) ^ ((a >> 13) | (a << 19)) ^ ((a >> 22) | (a << 10));
                last majority = (a & b) ^ (a & c) ^ (b & c);
                h = g;
                g = f;
                f = e;
                e = (((d as uint64) + t1) & 4294967295) as uint32;
                d = c;
                c = b;
                b = a;
                a = ((t1 + (big_s0 as uint64) + (majority as uint64)) & 4294967295) as uint32;
            }
            state[0] = words.add32(state[0], a);
            state[1] = words.add32(state[1], b);
            state[2] = words.add32(state[2], c);
            state[3] = words.add32(state[3], d);
            state[4] = words.add32(state[4], e);
            state[5] = words.add32(state[5], f);
            state[6] = words.add32(state[6], g);
            state[7] = words.add32(state[7], h);
        };

        export let.override to_string = func -> string => "Sha2Core.Core256";
    );

    /// @brief SHA-512 compression over 64-bit words, with the initial value and the number of output bytes.
    export let Core512 = class (
        let state: uint64[list] = new;
        let schedule: uint64[list] = new;
        let constants: uint64[list] = k512_table();
        let pending: uint8[list] = new;
        let total: uint64 = 0;
        let finished: bool = false;
        last out_bytes: int;

        export let init = func(iv: uint64[], output_bytes: int) {
            for (let word in iv) {
                state.append(word);
            }
            for (let t = 0; t < 80; t++) {
                schedule.append(0);
            }
            out_bytes = output_bytes;
        };

        export let update = func(bytes: uint8[list]) {
            if (finished) {
                trap_with_message("invalid state: digest finished");
            }
            total += bytes.length as uint64;
            let i = 0;
            if (pending.length > 0) {
                while (i < bytes.length && pending.length < 128) {
                    pending.append(bytes[i]);
                    i++;
                }
                if (pending.length < 128) {
                    return;
                }
                compress(pending, 0);
                pending = new;
            }
            while (i + 128 <= bytes.length) {
                compress(bytes, i);
                i += 128;
            }
            while (i < bytes.length) {
                pending.append(bytes[i]);
                i++;
            }
        };

        export let finish = func -> uint8[list] {
            if (finished) {
                trap_with_message("invalid state: digest finished");
            }
            finished = true;
            // The message length is below 2^61 bytes, so the high 64 bits of the 128-bit bit count are the top
            // three bits of the byte count.
            let tail = pending;
            pending = new;
            tail.append(128);
            while (tail.length % 128 != 112) {
                tail.append(0);
            }
            words.append64_be(tail, total >> 61);
            words.append64_be(tail, total << 3);
            for (let offset = 0; offset < tail.length; offset += 128) {
                compress(tail, offset);
            }
            let full: uint8[list] = new;
            for (let word in state) {
                words.append64_be(full, word);
            }
            return words.slice(full, 0, out_bytes);
        };

        let compress = func(block: uint8[list], offset: int) {
            let w = schedule;
            for (let t = 0; t < 16; t++) {
                w[t] = words.load64_be(block, offset + 8 * t);
            }
            for (let t = 16; t < 80; t++) {
                last x = w[t - 15];
                last y = w[t - 2];
                last s0 = ((x >> 1) | (x << 63)) ^ ((x >> 8) | (x << 56)) ^ (x >> 7);
                last s1 = ((y >> 19) | (y << 45)) ^ ((y >> 61) | (y << 3)) ^ (y >> 6);
                w[t] = words.add64(words.add64(w[t - 16], s0), words.add64(w[t - 7], s1));
            }
            let a = state[0];
            let b = state[1];
            let c = state[2];
            let d = state[3];
            let e = state[4];
            let f = state[5];
            let g = state[6];
            let h = state[7];
            let k = constants;
            for (let t = 0; t < 80; t++) {
                last big_s1 = ((e >> 14) | (e << 50)) ^ ((e >> 18) | (e << 46)) ^ ((e >> 41) | (e << 23));
                last choose = (e & f) ^ ((~e) & g);
                last t1 = words.add64(words.add64(h, big_s1), words.add64(words.add64(choose, k[t]), w[t]));
                last big_s0 = ((a >> 28) | (a << 36)) ^ ((a >> 34) | (a << 30)) ^ ((a >> 39) | (a << 25));
                last majority = (a & b) ^ (a & c) ^ (b & c);
                h = g;
                g = f;
                f = e;
                e = words.add64(d, t1);
                d = c;
                c = b;
                b = a;
                a = words.add64(t1, words.add64(big_s0, majority));
            }
            state[0] = words.add64(state[0], a);
            state[1] = words.add64(state[1], b);
            state[2] = words.add64(state[2], c);
            state[3] = words.add64(state[3], d);
            state[4] = words.add64(state[4], e);
            state[5] = words.add64(state[5], f);
            state[6] = words.add64(state[6], g);
            state[7] = words.add64(state[7], h);
        };

        export let.override to_string = func -> string => "Sha2Core.Core512";
    );
);
