let digest_sha256 = import:Std.Digest.Sha256;
let pqc_keccak = import:Std.Crypto.Internal.PqcKeccak;
let words = import:Std.Crypto.Internal.Words;

/// @brief The algorithms of FIPS 205 (SLH-DSA) over byte lists, for the twelve parameter sets, without policy
/// checks or key objects. Internal: Std.Crypto.Pqc.SlhDsa wraps it. Addresses are 32-byte lists changed in
/// place; tree addresses are `uint64` (at most 64 bits in every parameter set).
#Since("0.3.0")
export let SlhDsaCore = module (
    const WotsHash = 0;
    const WotsPk = 1;
    const Tree = 2;
    const ForsTree = 3;
    const ForsRoots = 4;
    const WotsPrf = 5;
    const ForsPrf = 6;

    /// @brief SHA-512 (FIPS 180-4) for the many short messages of the SHA-2 parameter sets of categories 3 and 5,
    /// with its tables kept between messages. The constants are those of Std.Crypto.Internal.Sha2Core (printed
    /// by scripts/crypto-vectors/constants.py).
    let Sha512 = class (
        let constants: uint64[list] = new([
            4794697086780616226, 8158064640168781261, 13096744586834688815, 16840607885511220156,
            4131703408338449720, 6480981068601479193, 10538285296894168987, 12329834152419229976,
            15566598209576043074, 1334009975649890238, 2608012711638119052, 6128411473006802146,
            8268148722764581231, 9286055187155687089, 11230858885718282805, 13951009754708518548,
            16472876342353939154, 17275323862435702243, 1135362057144423861, 2597628984639134821,
            3308224258029322869, 5365058923640841347, 6679025012923562964, 8573033837759648693,
            10970295158949994411, 12119686244451234320, 12683024718118986047, 13788192230050041572,
            14330467153632333762, 15395433587784984357, 489312712824947311, 1452737877330783856,
            2861767655752347644, 3322285676063803686, 5560940570517711597, 5996557281743188959,
            7280758554555802590, 8532644243296465576, 9350256976987008742, 10552545826968843579,
            11727347734174303076, 12113106623233404929, 14000437183269869457, 14369950271660146224,
            15101387698204529176, 15463397548674623760, 17586052441742319658, 1182934255886127544,
            1847814050463011016, 2177327727835720531, 2830643537854262169, 3796741975233480872,
            4115178125766777443, 5681478168544905931, 6601373596472566643, 7507060721942968483,
            8399075790359081724, 8693463985226723168, 9568029438360202098, 10144078919501101548,
            10430055236837252648, 11840083180663258601, 13761210420658862357, 14299343276471374635,
            14566680578165727644, 15097957966210449927, 16922976911328602910, 17689382322260857208,
            500013540394364858, 748580250866718886, 1242879168328830382, 1977374033974150939,
            2944078676154940804, 3659926193048069267, 4368137639120453308, 4836135668995329356,
            5532061633213252278, 6448918945643986474, 6902733635092675308, 7801388544844847127
        ]);

        let schedule: uint64[list] = new;
        let state: uint64[list] = new;

        export let init = func {
            for (let t = 0; t < 80; t++) {
                schedule.append(0);
            }
            for (let i = 0; i < 8; i++) {
                state.append(0);
            }
        };

        /// @brief The 64-byte SHA-512 hash of the bytes.
        export let digest = func(bytes: uint8[list]) -> uint8[list] {
            state[0] = 7640891576956012808;
            state[1] = 13503953896175478587;
            state[2] = 4354685564936845355;
            state[3] = 11912009170470909681;
            state[4] = 5840696475078001361;
            state[5] = 11170449401992604703;
            state[6] = 2270897969802886507;
            state[7] = 6620516959819538809;
            last full = bytes.length - bytes.length % 128;
            for (let offset = 0; offset < full; offset += 128) {
                compress(bytes, offset);
            }
            let tail: uint8[list] = new;
            for (let i = full; i < bytes.length; i++) {
                tail.append(bytes[i]);
            }
            tail.append(128);
            while (tail.length % 128 != 112) {
                tail.append(0);
            }
            words.append64_be(tail, 0);
            words.append64_be(tail, (bytes.length as uint64) * 8);
            for (let offset = 0; offset < tail.length; offset += 128) {
                compress(tail, offset);
            }
            let out: uint8[list] = new;
            for (let i = 0; i < 8; i++) {
                words.append64_be(out, state[i]);
            }
            return out;
        };

        /// @brief One block. Sums modulo 2^64 add the 32-bit halves separately in uint64, so no sum of at most
        /// six terms overflows: (2^32 - 1) * 6 plus a carry is below 2^35.
        let compress = func(block: uint8[list], offset: int) {
            let w = schedule;
            for (let t = 0; t < 16; t++) {
                w[t] = words.load64_be(block, offset + 8 * t);
            }
            for (let t = 16; t < 80; t++) {
                last x = w[t - 15];
                last y = w[t - 2];
                last s0 = ((x >> 1) | (x << 63)) ^ ((x >> 8) | (x << 56)) ^ (x >> 7);
                last s1 = ((y >> 19) | (y << 45)) ^ ((y >> 61) | (y << 3)) ^ (y >> 6);
                last u = w[t - 16];
                last v = w[t - 7];
                last low = (u & 4294967295) + (s0 & 4294967295) + (v & 4294967295) + (s1 & 4294967295);
                last high = (u >> 32) + (s0 >> 32) + (v >> 32) + (s1 >> 32) + (low >> 32);
                w[t] = ((high & 4294967295) << 32) | (low & 4294967295);
            }
            let a = state[0];
            let b = state[1];
            let c = state[2];
            let d = state[3];
            let e = state[4];
            let f = state[5];
            let g = state[6];
            let h = state[7];
            let k = constants;
            for (let t = 0; t < 80; t++) {
                last big_s1 = ((e >> 14) | (e << 50)) ^ ((e >> 18) | (e << 46)) ^ ((e >> 41) | (e << 23));
                last choose = (e & f) ^ ((~e) & g);
                last kt = k[t];
                last wt = w[t];
                last low1 = (h & 4294967295) + (big_s1 & 4294967295) + (choose & 4294967295) + (kt & 4294967295)
                    + (wt & 4294967295);
                last high1 = (h >> 32) + (big_s1 >> 32) + (choose >> 32) + (kt >> 32) + (wt >> 32);
                last big_s0 = ((a >> 28) | (a << 36)) ^ ((a >> 34) | (a << 30)) ^ ((a >> 39) | (a << 25));
                last majority = (a & b) ^ (a & c) ^ (b & c);
                // e = d + t1 and a = t1 + big_s0 + majority, from the halves of t1.
                last low_e = low1 + (d & 4294967295);
                last high_e = high1 + (d >> 32) + (low_e >> 32);
                last low_a = low1 + (big_s0 & 4294967295) + (majority & 4294967295);
                last high_a = high1 + (big_s0 >> 32) + (majority >> 32) + (low_a >> 32);
                h = g;
                g = f;
                f = e;
                e = ((high_e & 4294967295) << 32) | (low_e & 4294967295);
                d = c;
                c = b;
                b = a;
                a = ((high_a & 4294967295) << 32) | (low_a & 4294967295);
            }
            state[0] = words.add64(state[0], a);
            state[1] = words.add64(state[1], b);
            state[2] = words.add64(state[2], c);
            state[3] = words.add64(state[3], d);
            state[4] = words.add64(state[4], e);
            state[5] = words.add64(state[5], f);
            state[6] = words.add64(state[6], g);
            state[7] = words.add64(state[7], h);
        };

        export let.override to_string = func -> string => "SlhDsaCore.Sha512";
    );

    /// @brief HMAC (FIPS 198-1) over SHA-256 or SHA-512.
    let hmac = func(sha512: Sha512, wide: bool, key: uint8[list], message: uint8[list]) -> uint8[list] {
        last block = wide ? 128 : 64;
        let inner: uint8[list] = new;
        let outer: uint8[list] = new;
        for (let i = 0; i < block; i++) {
            let b: uint8 = 0;
            if (i < key.length) {
                b = key[i];
            }
            inner.append(b ^ 54);
            outer.append(b ^ 92);
        }
        words.append_all(inner, message);
        if (wide) {
            words.append_all(outer, sha512.digest(inner));
            return sha512.digest(outer);
        }
        words.append_all(outer, digest_sha256.of(inner));
        return digest_sha256.of(outer);
    };

    /// @brief MGF1 (RFC 8017, B.2.1) over SHA-256 or SHA-512.
    let mgf1 = func(sha512: Sha512, wide: bool, seed: uint8[list], length: int) -> uint8[list] {
        let out: uint8[list] = new;
        let counter: uint32 = 0;
        while (out.length < length) {
            let input = words.copy(seed);
            words.append32_be(input, counter);
            if (wide) {
                words.append_all(out, sha512.digest(input));
            } else {
                words.append_all(out, digest_sha256.of(input));
            }
            counter++;
        }
        return words.slice(out, 0, length);
    };

    /// @brief One SLH-DSA parameter set.
    export let Engine = class (
        /// @brief Whether the SHAKE functions (section 11.1) or the SHA-2 ones (sections 11.2) are used.
        export last shake: bool;
        export last n: int;
        last h: int;
        last d: int;
        last hp: int;
        last a: int;
        last k: int;
        last m: int;
        last len: int;
        /// @brief SHAKE256, reset for each message.
        let xof: pqc_keccak.Xof = new(136, 31);
        /// @brief SHA-512 for the SHA-2 sets of categories 3 and 5.
        let sha512: Sha512 = new;
        /// @brief The SHA-2 input of F and PRF: PK.seed || 0^(64 - n) || ADRSc || an n-byte message. Only the
        /// address and the message change between calls.
        let short_input: uint8[list] = new;
        /// @brief The SHA-2 input of H: PK.seed || 0^(block - n) || ADRSc || a 2n-byte message, with a block of
        /// 64 bytes (SHA-256, category 1) or 128 (SHA-512).
        let pair_input: uint8[list] = new;
        let pair_block: int = 64;

        /// @brief The parameter set with SHAKE or SHA-2, security category n = 16, 24 or 32 bytes, and the
        /// small ("s") or fast ("f") variant.
        export let init = func(use_shake: bool, security: int, small: bool) {
            shake = use_shake;
            n = security;
            len = 2 * security + 3;
            if (security == 16 && small) {
                h = 63;
                d = 7;
                a = 12;
                k = 14;
                m = 30;
            } else if (security == 16) {
                h = 66;
                d = 22;
                a = 6;
                k = 33;
                m = 34;
            } else if (security == 24 && small) {
                h = 63;
                d = 7;
                a = 14;
                k = 17;
                m = 39;
            } else if (security == 24) {
                h = 66;
                d = 22;
                a = 8;
                k = 33;
                m = 42;
            } else if (small) {
                h = 64;
                d = 8;
                a = 14;
                k = 22;
                m = 47;
            } else {
                h = 68;
                d = 17;
                a = 9;
                k = 35;
                m = 49;
            }
            hp = h / d;
        };

        /// @brief The signature length, n (1 + k (1 + a) + h + d len).
        export let sig_length = func -> int => n * (1 + k * (1 + a) + h + d * len);

        // ---- Addresses (section 4.2) ----

        let set_word = func(adrs: uint8[list], at: int, value: uint32) {
            adrs[at] = (value >> 24) as uint8;
            adrs[at + 1] = ((value >> 16) & 255) as uint8;
            adrs[at + 2] = ((value >> 8) & 255) as uint8;
            adrs[at + 3] = (value & 255) as uint8;
        };

        let get_word = func(adrs: uint8[list], at: int) -> uint32 =>
            ((adrs[at] as uint32) << 24) | ((adrs[at + 1] as uint32) << 16) | ((adrs[at + 2] as uint32) << 8)
            | (adrs[at + 3] as uint32);

        let set_type_and_clear = func(adrs: uint8[list], kind: int) {
            set_word(adrs, 16, kind as uint32);
            for (let i = 20; i < 32; i++) {
                adrs[i] = 0;
            }
        };

        let set_tree_address = func(adrs: uint8[list], tree: uint64) {
            for (let i = 4; i < 8; i++) {
                adrs[i] = 0;
            }
            set_word(adrs, 8, (tree >> 32) as uint32);
            set_word(adrs, 12, (tree & 4294967295) as uint32);
        };

        // ---- Hash functions (section 11) ----

        /// @brief Fills the fixed parts of the SHA-2 inputs for PK.seed. Every public entry calls it before
        /// hashing, and F, H and PRF assume the PK.seed given here.
        let prepare = func(pk_seed: uint8[list]) {
            if (shake) {
                return;
            }
            if (n > 16) {
                pair_block = 128;
            }
            short_input = sha2_input(pk_seed, words.zeros(32), 64);
            words.append_all(short_input, words.zeros(n));
            pair_input = sha2_input(pk_seed, words.zeros(32), pair_block);
            words.append_all(pair_input, words.zeros(2 * n));
        };

        /// @brief The SHA-2 prefix PK.seed || 0^(block - n) and the compressed address.
        let sha2_input = func(pk_seed: uint8[list], adrs: uint8[list], block: int) -> uint8[list] {
            let input = words.copy(pk_seed);
            for (let i = n; i < block; i++) {
                input.append(0);
            }
            input.append(adrs[3]);
            for (let i = 8; i < 16; i++) {
                input.append(adrs[i]);
            }
            input.append(adrs[19]);
            for (let i = 20; i < 32; i++) {
                input.append(adrs[i]);
            }
            return input;
        };

        /// @brief Writes ADRSc into the input at `at`.
        let put_address = func(input: uint8[list], at: int, adrs: uint8[list]) {
            input[at] = adrs[3];
            for (let i = 0; i < 8; i++) {
                input[at + 1 + i] = adrs[8 + i];
            }
            input[at + 9] = adrs[19];
            for (let i = 0; i < 12; i++) {
                input[at + 10 + i] = adrs[20 + i];
            }
        };

        /// @brief The first n bytes of the digest.
        let truncate = func(digest: uint8[list]) -> uint8[list] {
            let out: uint8[list] = new;
            for (let i = 0; i < n; i++) {
                out.append(digest[i]);
            }
            return out;
        };

        /// @brief T_l: the hash of the message under PK.seed and the address. `wide` selects SHA-512 in
        /// categories 3 and 5.
        let tweak = func(pk_seed: uint8[list], adrs: uint8[list], message: uint8[list], wide: bool) -> uint8[list] {
            if (shake) {
                let sponge = xof;
                sponge.reset();
                sponge.absorb(pk_seed);
                sponge.absorb(adrs);
                sponge.absorb(message);
                return sponge.squeeze(n);
            }
            if (wide && n > 16) {
                let input = sha2_input(pk_seed, adrs, 128);
                words.append_all(input, message);
                return truncate(sha512.digest(input));
            }
            let input = sha2_input(pk_seed, adrs, 64);
            words.append_all(input, message);
            return truncate(digest_sha256.of(input));
        };

        /// @brief F (and PRF, whose message is SK.seed): an n-byte message.
        let f = func(pk_seed: uint8[list], adrs: uint8[list], message: uint8[list]) -> uint8[list] {
            if (shake) {
                return tweak(pk_seed, adrs, message, false);
            }
            let input = short_input;
            put_address(input, 64, adrs);
            for (let i = 0; i < n; i++) {
                input[86 + i] = message[i];
            }
            return truncate(digest_sha256.of(input));
        };

        /// @brief H over the two n-byte halves.
        let hh = func(pk_seed: uint8[list], adrs: uint8[list], left: uint8[list], right: uint8[list]) -> uint8[list] {
            if (shake) {
                let sponge = xof;
                sponge.reset();
                sponge.absorb(pk_seed);
                sponge.absorb(adrs);
                sponge.absorb(left);
                sponge.absorb(right);
                return sponge.squeeze(n);
            }
            let input = pair_input;
            last at = pair_block + 22;
            put_address(input, pair_block, adrs);
            for (let i = 0; i < n; i++) {
                input[at + i] = left[i];
                input[at + n + i] = right[i];
            }
            if (n > 16) {
                return truncate(sha512.digest(input));
            }
            return truncate(digest_sha256.of(input));
        };

        let prf = func(pk_seed: uint8[list], sk_seed: uint8[list], adrs: uint8[list]) -> uint8[list] =>
            f(pk_seed, adrs, sk_seed);

        /// @brief PRF_msg(SK.prf, opt_rand, M).
        export let prf_msg = func(sk_prf: uint8[list], opt_rand: uint8[list], message: uint8[list]) -> uint8[list] {
            if (shake) {
                let sponge = xof;
                sponge.reset();
                sponge.absorb(sk_prf);
                sponge.absorb(opt_rand);
                sponge.absorb(message);
                return sponge.squeeze(n);
            }
            return truncate(hmac(sha512, n > 16, sk_prf, words.concat(opt_rand, message)));
        };

        /// @brief H_msg(R, PK.seed, PK.root, M), m bytes.
        let h_msg = func(r: uint8[list], pk_seed: uint8[list], pk_root: uint8[list], message: uint8[list]) -> uint8[list] {
            if (shake) {
                let sponge = xof;
                sponge.reset();
                sponge.absorb(r);
                sponge.absorb(pk_seed);
                sponge.absorb(pk_root);
                sponge.absorb(message);
                return sponge.squeeze(m);
            }
            let input = words.concat(r, pk_seed);
            words.append_all(input, pk_root);
            words.append_all(input, message);
            let seed = words.concat(r, pk_seed);
            if (n > 16) {
                words.append_all(seed, sha512.digest(input));
                return mgf1(sha512, true, seed, m);
            }
            words.append_all(seed, digest_sha256.of(input));
            return mgf1(sha512, false, seed, m);
        };

        // ---- WOTS+ (section 5) ----

        /// @brief base_2b(X, b, out_len) of Algorithm 4, reading from `at`.
        let base_2b = func(x: uint8[list], at: int, b: int, out_len: int) -> int[list] {
            let out: int[list] = new;
            let i = at;
            let bits = 0;
            let total: uint64 = 0;
            last mask = ((1 as uint64) << b) - 1;
            for (let o = 0; o < out_len; o++) {
                while (bits < b) {
                    total = ((total << 8) | (x[i] as uint64)) & 4294967295;
                    i++;
                    bits += 8;
                }
                bits -= b;
                out.append(((total >> bits) & mask) as int);
            }
            return out;
        };

        /// @brief The base-16 digits of the message and of its checksum.
        let wots_digits = func(message: uint8[list]) -> int[list] {
            let digits = base_2b(message, 0, 4, 2 * n);
            let csum = 0;
            for (let digit in digits) {
                csum += 15 - digit;
            }
            csum = csum << 4;
            let checksum: uint8[list] = new;
            checksum.append(((csum >> 8) & 255) as uint8);
            checksum.append((csum & 255) as uint8);
            for (let digit in base_2b(checksum, 0, 4, 3)) {
                digits.append(digit);
            }
            return digits;
        };

        /// @brief chain(X, i, s): s applications of F from hash address i.
        let chain = func(x: uint8[list], start: int, steps: int, pk_seed: uint8[list], adrs: uint8[list]) -> uint8[list] {
            let tmp = x;
            for (let j = start; j < start + steps; j++) {
                set_word(adrs, 28, j as uint32);
                tmp = f(pk_seed, adrs, tmp);
            }
            return tmp;
        };

        let wots_secret = func(sk_seed: uint8[list], pk_seed: uint8[list], adrs: uint8[list], chain_index: int) -> uint8[list] {
            let sk_adrs = words.copy(adrs);
            set_type_and_clear(sk_adrs, WotsPrf);
            for (let i = 20; i < 24; i++) {
                sk_adrs[i] = adrs[i];
            }
            set_word(sk_adrs, 24, chain_index as uint32);
            return prf(pk_seed, sk_seed, sk_adrs);
        };

        /// @brief T_len over the chain ends, at the WOTS_PK address of the key pair.
        let wots_compress = func(ends: uint8[list], pk_seed: uint8[list], adrs: uint8[list]) -> uint8[list] {
            let pk_adrs = words.copy(adrs);
            set_type_and_clear(pk_adrs, WotsPk);
            for (let i = 20; i < 24; i++) {
                pk_adrs[i] = adrs[i];
            }
            return tweak(pk_seed, pk_adrs, ends, true);
        };

        /// @brief wots_pkGen (Algorithm 6).
        let wots_pk_gen = func(sk_seed: uint8[list], pk_seed: uint8[list], adrs: uint8[list]) -> uint8[list] {
            let ends: uint8[list] = new;
            for (let i = 0; i < len; i++) {
                last secret = wots_secret(sk_seed, pk_seed, adrs, i);
                set_word(adrs, 24, i as uint32);
                words.append_all(ends, chain(secret, 0, 15, pk_seed, adrs));
            }
            return wots_compress(ends, pk_seed, adrs);
        };

        /// @brief wots_sign (Algorithm 7), appended to `out`.
        let wots_sign = func(out: uint8[list], message: uint8[list], sk_seed: uint8[list], pk_seed: uint8[list],
            adrs: uint8[list]) {
            last digits = wots_digits(message);
            for (let i = 0; i < len; i++) {
                last secret = wots_secret(sk_seed, pk_seed, adrs, i);
                set_word(adrs, 24, i as uint32);
                words.append_all(out, chain(secret, 0, digits[i], pk_seed, adrs));
            }
        };

        /// @brief wots_pkFromSig (Algorithm 8) for the signature at `at`.
        let wots_pk_from_sig = func(sig: uint8[list], at: int, message: uint8[list], pk_seed: uint8[list],
            adrs: uint8[list]) -> uint8[list] {
            last digits = wots_digits(message);
            let ends: uint8[list] = new;
            for (let i = 0; i < len; i++) {
                set_word(adrs, 24, i as uint32);
                last part = words.slice(sig, at + i * n, at + (i + 1) * n);
                words.append_all(ends, chain(part, digits[i], 15 - digits[i], pk_seed, adrs));
            }
            return wots_compress(ends, pk_seed, adrs);
        };

        // ---- XMSS (section 6) ----

        /// @brief xmss_node (Algorithm 9).
        let xmss_node = func(sk_seed: uint8[list], i: int, z: int, pk_seed: uint8[list], adrs: uint8[list]) -> uint8[list] {
            if (z == 0) {
                set_type_and_clear(adrs, WotsHash);
                set_word(adrs, 20, i as uint32);
                return wots_pk_gen(sk_seed, pk_seed, adrs);
            }
            last left = xmss_node(sk_seed, 2 * i, z - 1, pk_seed, adrs);
            last right = xmss_node(sk_seed, 2 * i + 1, z - 1, pk_seed, adrs);
            set_type_and_clear(adrs, Tree);
            set_word(adrs, 24, z as uint32);
            set_word(adrs, 28, i as uint32);
            return hh(pk_seed, adrs, left, right);
        };

        /// @brief xmss_sign (Algorithm 10), appended to `out`.
        let xmss_sign = func(out: uint8[list], message: uint8[list], sk_seed: uint8[list], idx: int, pk_seed: uint8[list],
            adrs: uint8[list]) {
            let auth: uint8[list] = new;
            for (let j = 0; j < hp; j++) {
                last sibling = (idx >> j) ^ 1;
                words.append_all(auth, xmss_node(sk_seed, sibling, j, pk_seed, adrs));
            }
            set_type_and_clear(adrs, WotsHash);
            set_word(adrs, 20, idx as uint32);
            wots_sign(out, message, sk_seed, pk_seed, adrs);
            words.append_all(out, auth);
        };

        /// @brief xmss_pkFromSig (Algorithm 11) for the XMSS signature at `at`.
        let xmss_pk_from_sig = func(idx: int, sig: uint8[list], at: int, message: uint8[list], pk_seed: uint8[list],
            adrs: uint8[list]) -> uint8[list] {
            set_type_and_clear(adrs, WotsHash);
            set_word(adrs, 20, idx as uint32);
            let node = wots_pk_from_sig(sig, at, message, pk_seed, adrs);
            set_type_and_clear(adrs, Tree);
            let index = idx;
            last auth_at = at + len * n;
            for (let j = 0; j < hp; j++) {
                set_word(adrs, 24, (j + 1) as uint32);
                last auth = words.slice(sig, auth_at + j * n, auth_at + (j + 1) * n);
                if (((idx >> j) & 1) == 0) {
                    index = index / 2;
                    set_word(adrs, 28, index as uint32);
                    node = hh(pk_seed, adrs, node, auth);
                } else {
                    index = (index - 1) / 2;
                    set_word(adrs, 28, index as uint32);
                    node = hh(pk_seed, adrs, auth, node);
                }
            }
            return node;
        };

        // ---- Hypertree (section 7) ----

        /// @brief ht_sign (Algorithm 12), appended to `out`.
        let ht_sign = func(out: uint8[list], message: uint8[list], sk_seed: uint8[list], pk_seed: uint8[list],
            idx_tree: uint64, idx_leaf: int) {
            let adrs = words.zeros(32);
            let tree = idx_tree;
            let leaf = idx_leaf;
            set_tree_address(adrs, tree);
            let root = message;
            for (let j = 0; j < d; j++) {
                if (j > 0) {
                    leaf = (tree & (((1 as uint64) << hp) - 1)) as int;
                    tree = tree >> hp;
                    set_word(adrs, 0, j as uint32);
                    set_tree_address(adrs, tree);
                }
                last at = out.length;
                xmss_sign(out, root, sk_seed, leaf, pk_seed, adrs);
                if (j < d - 1) {
                    root = xmss_pk_from_sig(leaf, out, at, root, pk_seed, adrs);
                }
            }
        };

        /// @brief ht_verify (Algorithm 13) for the hypertree signature at `at`.
        let ht_verify = func(message: uint8[list], sig: uint8[list], at: int, pk_seed: uint8[list], idx_tree: uint64,
            idx_leaf: int, pk_root: uint8[list]) -> bool {
            let adrs = words.zeros(32);
            let tree = idx_tree;
            let leaf = idx_leaf;
            set_tree_address(adrs, tree);
            let node = message;
            last step = (len + hp) * n;
            for (let j = 0; j < d; j++) {
                if (j > 0) {
                    leaf = (tree & (((1 as uint64) << hp) - 1)) as int;
                    tree = tree >> hp;
                    set_word(adrs, 0, j as uint32);
                    set_tree_address(adrs, tree);
                }
                node = xmss_pk_from_sig(leaf, sig, at + j * step, node, pk_seed, adrs);
            }
            let diff: uint8 = 0;
            for (let i = 0; i < n; i++) {
                diff = diff | (node[i] ^ pk_root[i]);
            }
            return diff == 0;
        };

        // ---- FORS (section 8) ----

        let fors_secret = func(sk_seed: uint8[list], pk_seed: uint8[list], adrs: uint8[list], idx: int) -> uint8[list] {
            let sk_adrs = words.copy(adrs);
            set_type_and_clear(sk_adrs, ForsPrf);
            for (let i = 20; i < 24; i++) {
                sk_adrs[i] = adrs[i];
            }
            set_word(sk_adrs, 28, idx as uint32);
            return prf(pk_seed, sk_seed, sk_adrs);
        };

        /// @brief fors_node (Algorithm 15).
        let fors_node = func(sk_seed: uint8[list], i: int, z: int, pk_seed: uint8[list], adrs: uint8[list]) -> uint8[list] {
            if (z == 0) {
                last secret = fors_secret(sk_seed, pk_seed, adrs, i);
                set_word(adrs, 24, 0);
                set_word(adrs, 28, i as uint32);
                return f(pk_seed, adrs, secret);
            }
            last left = fors_node(sk_seed, 2 * i, z - 1, pk_seed, adrs);
            last right = fors_node(sk_seed, 2 * i + 1, z - 1, pk_seed, adrs);
            set_word(adrs, 24, z as uint32);
            set_word(adrs, 28, i as uint32);
            return hh(pk_seed, adrs, left, right);
        };

        /// @brief fors_sign (Algorithm 16), appended to `out`.
        let fors_sign = func(out: uint8[list], md: uint8[list], sk_seed: uint8[list], pk_seed: uint8[list], adrs: uint8[list]) {
            last indices = base_2b(md, 0, a, k);
            for (let i = 0; i < k; i++) {
                words.append_all(out, fors_secret(sk_seed, pk_seed, adrs, (i << a) + indices[i]));
                for (let j = 0; j < a; j++) {
                    last s = (indices[i] >> j) ^ 1;
                    words.append_all(out, fors_node(sk_seed, (i << (a - j)) + s, j, pk_seed, adrs));
                }
            }
        };

        /// @brief fors_pkFromSig (Algorithm 17) for the FORS signature at `at`.
        let fors_pk_from_sig = func(sig: uint8[list], at: int, md: uint8[list], pk_seed: uint8[list], adrs: uint8[list])
            -> uint8[list] {
            last indices = base_2b(md, 0, a, k);
            let roots: uint8[list] = new;
            for (let i = 0; i < k; i++) {
                last base = at + i * (a + 1) * n;
                set_word(adrs, 24, 0);
                let index = (i << a) + indices[i];
                set_word(adrs, 28, index as uint32);
                let node = f(pk_seed, adrs, words.slice(sig, base, base + n));
                for (let j = 0; j < a; j++) {
                    last auth = words.slice(sig, base + (j + 1) * n, base + (j + 2) * n);
                    set_word(adrs, 24, (j + 1) as uint32);
                    if (((indices[i] >> j) & 1) == 0) {
                        index = index / 2;
                        set_word(adrs, 28, index as uint32);
                        node = hh(pk_seed, adrs, node, auth);
                    } else {
                        index = (index - 1) / 2;
                        set_word(adrs, 28, index as uint32);
                        node = hh(pk_seed, adrs, auth, node);
                    }
                }
                words.append_all(roots, node);
            }
            let pk_adrs = words.copy(adrs);
            set_type_and_clear(pk_adrs, ForsRoots);
            for (let i = 20; i < 24; i++) {
                pk_adrs[i] = adrs[i];
            }
            return tweak(pk_seed, pk_adrs, roots, true);
        };

        // ---- SLH-DSA internal functions (section 9) ----

        /// @brief slh_keygen_internal (Algorithm 18): PK.root for the seeds.
        export let keygen_root = func(sk_seed: uint8[list], pk_seed: uint8[list]) -> uint8[list] {
            prepare(pk_seed);
            let adrs = words.zeros(32);
            set_word(adrs, 0, (d - 1) as uint32);
            return xmss_node(sk_seed, 0, hp, pk_seed, adrs);
        };

        /// @brief The message digest split of Algorithms 19 and 20: md, then idx_tree and idx_leaf.
        let split_digest = func(digest: uint8[list]) -> uint64[list] {
            last md_bytes = (k * a + 7) / 8;
            last tree_bits = h - hp;
            last tree_bytes = (tree_bits + 7) / 8;
            last leaf_bytes = (hp + 7) / 8;
            let tree: uint64 = 0;
            for (let i = md_bytes; i < md_bytes + tree_bytes; i++) {
                tree = (tree << 8) | (digest[i] as uint64);
            }
            if (tree_bits < 64) {
                tree = tree & (((1 as uint64) << tree_bits) - 1);
            }
            let leaf: uint64 = 0;
            for (let i = md_bytes + tree_bytes; i < md_bytes + tree_bytes + leaf_bytes; i++) {
                leaf = (leaf << 8) | (digest[i] as uint64);
            }
            leaf = leaf & (((1 as uint64) << hp) - 1);
            return new([tree, leaf]);
        };

        /// @brief slh_sign_internal (Algorithm 19) with the private key SK.seed || SK.prf || PK.seed || PK.root
        /// and opt_rand (PK.seed for the deterministic variant).
        export let sign = func(message: uint8[list], sk: uint8[list], opt_rand: uint8[list]) -> uint8[list] {
            last sk_seed = words.slice(sk, 0, n);
            last sk_prf = words.slice(sk, n, 2 * n);
            last pk_seed = words.slice(sk, 2 * n, 3 * n);
            last pk_root = words.slice(sk, 3 * n, 4 * n);
            prepare(pk_seed);
            let sig = prf_msg(sk_prf, opt_rand, message);
            last digest = h_msg(sig, pk_seed, pk_root, message);
            last md = words.slice(digest, 0, (k * a + 7) / 8);
            last indices = split_digest(digest);
            let adrs = words.zeros(32);
            set_tree_address(adrs, indices[0]);
            set_type_and_clear(adrs, ForsTree);
            set_word(adrs, 20, indices[1] as uint32);
            last fors_at = sig.length;
            fors_sign(sig, md, sk_seed, pk_seed, adrs);
            last fors_pk = fors_pk_from_sig(sig, fors_at, md, pk_seed, adrs);
            ht_sign(sig, fors_pk, sk_seed, pk_seed, indices[0], indices[1] as int);
            return sig;
        };

        /// @brief slh_verify_internal (Algorithm 20) with the public key PK.seed || PK.root. The caller checks
        /// the signature length.
        export let verify = func(message: uint8[list], sig: uint8[list], pk: uint8[list]) -> bool {
            last pk_seed = words.slice(pk, 0, n);
            last pk_root = words.slice(pk, n, 2 * n);
            prepare(pk_seed);
            last r = words.slice(sig, 0, n);
            last digest = h_msg(r, pk_seed, pk_root, message);
            last md = words.slice(digest, 0, (k * a + 7) / 8);
            last indices = split_digest(digest);
            let adrs = words.zeros(32);
            set_tree_address(adrs, indices[0]);
            set_type_and_clear(adrs, ForsTree);
            set_word(adrs, 20, indices[1] as uint32);
            last fors_pk = fors_pk_from_sig(sig, n, md, pk_seed, adrs);
            return ht_verify(fors_pk, sig, n + k * (a + 1) * n, pk_seed, indices[0], indices[1] as int, pk_root);
        };

        export let.override to_string = func -> string => "SlhDsaCore.Engine(n = " + n.to_string() + ")";
    );
);
