/// @brief The AES block cipher of FIPS 197 for 128-, 192- and 256-bit keys. Internal: the public block interface
/// is Std.Crypto.Symmetric.AesBlock, and the modes build on this. Table lookups are indexed by secret bytes, so
/// this code is not constant-time on hardware with caches (and the runtime promises no constant time anyway).
/// The S-boxes are printed by scripts/crypto-vectors/constants.py.
#Since("0.3.0")
export let Aes = module (
    /// @brief A new list of the table (a function, so that tasks can use it: arrays are not transferable).
    let sbox_table = func -> uint8[list] => new([
        99, 124, 119, 123, 242, 107, 111, 197, 48, 1, 103, 43, 254, 215, 171, 118,
        202, 130, 201, 125, 250, 89, 71, 240, 173, 212, 162, 175, 156, 164, 114, 192,
        183, 253, 147, 38, 54, 63, 247, 204, 52, 165, 229, 241, 113, 216, 49, 21,
        4, 199, 35, 195, 24, 150, 5, 154, 7, 18, 128, 226, 235, 39, 178, 117,
        9, 131, 44, 26, 27, 110, 90, 160, 82, 59, 214, 179, 41, 227, 47, 132,
        83, 209, 0, 237, 32, 252, 177, 91, 106, 203, 190, 57, 74, 76, 88, 207,
        208, 239, 170, 251, 67, 77, 51, 133, 69, 249, 2, 127, 80, 60, 159, 168,
        81, 163, 64, 143, 146, 157, 56, 245, 188, 182, 218, 33, 16, 255, 243, 210,
        205, 12, 19, 236, 95, 151, 68, 23, 196, 167, 126, 61, 100, 93, 25, 115,
        96, 129, 79, 220, 34, 42, 144, 136, 70, 238, 184, 20, 222, 94, 11, 219,
        224, 50, 58, 10, 73, 6, 36, 92, 194, 211, 172, 98, 145, 149, 228, 121,
        231, 200, 55, 109, 141, 213, 78, 169, 108, 86, 244, 234, 101, 122, 174, 8,
        186, 120, 37, 46, 28, 166, 180, 198, 232, 221, 116, 31, 75, 189, 139, 138,
        112, 62, 181, 102, 72, 3, 246, 14, 97, 53, 87, 185, 134, 193, 29, 158,
        225, 248, 152, 17, 105, 217, 142, 148, 155, 30, 135, 233, 206, 85, 40, 223,
        140, 161, 137, 13, 191, 230, 66, 104, 65, 153, 45, 15, 176, 84, 187, 22
    ]);

    /// @brief A new list of the table (a function, so that tasks can use it: arrays are not transferable).
    let inverse_sbox_table = func -> uint8[list] => new([
        82, 9, 106, 213, 48, 54, 165, 56, 191, 64, 163, 158, 129, 243, 215, 251,
        124, 227, 57, 130, 155, 47, 255, 135, 52, 142, 67, 68, 196, 222, 233, 203,
        84, 123, 148, 50, 166, 194, 35, 61, 238, 76, 149, 11, 66, 250, 195, 78,
        8, 46, 161, 102, 40, 217, 36, 178, 118, 91, 162, 73, 109, 139, 209, 37,
        114, 248, 246, 100, 134, 104, 152, 22, 212, 164, 92, 204, 93, 101, 182, 146,
        108, 112, 72, 80, 253, 237, 185, 218, 94, 21, 70, 87, 167, 141, 157, 132,
        144, 216, 171, 0, 140, 188, 211, 10, 247, 228, 88, 5, 184, 179, 69, 6,
        208, 44, 30, 143, 202, 63, 15, 2, 193, 175, 189, 3, 1, 19, 138, 107,
        58, 145, 17, 65, 79, 103, 220, 234, 151, 242, 207, 206, 240, 180, 230, 115,
        150, 172, 116, 34, 231, 173, 53, 133, 226, 249, 55, 232, 28, 117, 223, 110,
        71, 241, 26, 113, 29, 41, 197, 137, 111, 183, 98, 14, 170, 24, 190, 27,
        252, 86, 62, 75, 198, 210, 121, 32, 154, 219, 192, 254, 120, 205, 90, 244,
        31, 221, 168, 51, 136, 7, 199, 49, 177, 18, 16, 89, 39, 128, 236, 95,
        96, 81, 127, 169, 25, 181, 74, 13, 45, 229, 122, 159, 147, 201, 156, 239,
        160, 224, 59, 77, 174, 42, 245, 176, 200, 235, 187, 60, 131, 83, 153, 97,
        23, 43, 4, 126, 186, 119, 214, 38, 225, 105, 20, 99, 85, 33, 12, 125
    ]);

    /// @brief x times 2 in GF(2^8) modulo x^8 + x^4 + x^3 + x + 1.
    let xtime = func(x: uint8) -> uint8 => ((((x as uint32) << 1) ^ (((x as uint32) >> 7) * 27)) & 255) as uint8;

    /// @brief a times b in GF(2^8).
    let multiply = func(a: uint8, b: uint8) -> uint8 {
        let result: uint8 = 0;
        let x = a;
        let y = b;
        while (y != 0) {
            if ((y & 1) != 0) {
                result ^= x;
            }
            x = xtime(x);
            y = y >> 1;
        }
        return result;
    };

    /// @brief An expanded AES key: encrypts and decrypts 16-byte blocks.
    export let Cipher = class (
        /// @brief The round keys, 16 bytes per round, rounds + 1 of them.
        let round_keys: uint8[list] = new;
        /// @brief 10, 12 or 14.
        export last rounds: int;
        let work: uint8[list] = new;
        let sbox: uint8[list] = sbox_table();
        let inverse_sbox: uint8[list] = inverse_sbox_table();

        /// @brief Expands a 16-, 24- or 32-byte key; any other length traps with "invalid argument: AES key
        /// must be 16, 24 or 32 bytes".
        export let init = func(key: uint8[list]) {
            last nk = key.length / 4;
            if (key.length != 16 && key.length != 24 && key.length != 32) {
                trap_with_message("invalid argument: AES key must be 16, 24 or 32 bytes");
            }
            rounds = nk + 6;
            for (let b in key) {
                round_keys.append(b);
            }
            let rcon: uint8 = 1;
            for (let i = nk; i < 4 * (rounds + 1); i++) {
                last p = 4 * (i - 1);
                let t0 = round_keys[p];
                let t1 = round_keys[p + 1];
                let t2 = round_keys[p + 2];
                let t3 = round_keys[p + 3];
                if (i % nk == 0) {
                    last first = t0;
                    t0 = sbox[t1 as int] ^ rcon;
                    t1 = sbox[t2 as int];
                    t2 = sbox[t3 as int];
                    t3 = sbox[first as int];
                    rcon = xtime(rcon);
                } else if (nk > 6 && i % nk == 4) {
                    t0 = sbox[t0 as int];
                    t1 = sbox[t1 as int];
                    t2 = sbox[t2 as int];
                    t3 = sbox[t3 as int];
                }
                last q = 4 * (i - nk);
                round_keys.append(round_keys[q] ^ t0);
                round_keys.append(round_keys[q + 1] ^ t1);
                round_keys.append(round_keys[q + 2] ^ t2);
                round_keys.append(round_keys[q + 3] ^ t3);
            }
            for (let i in 0 .. 16) {
                work.append(0);
            }
        };

        /// @brief The encryption of the 16 bytes at `offset` of `block`.
        export let encrypt = func(block: uint8[list], offset: int) -> uint8[list] {
            let s: uint8[list] = new;
            for (let i = 0; i < 16; i++) {
                s.append(block[offset + i] ^ round_keys[i]);
            }
            for (let round = 1; round <= rounds; round++) {
                // SubBytes and ShiftRows: byte (r, c) of the new state is S(byte (r, c + r)).
                let t = work;
                for (let c = 0; c < 4; c++) {
                    for (let r = 0; r < 4; r++) {
                        t[4 * c + r] = sbox[s[4 * ((c + r) % 4) + r] as int];
                    }
                }
                if (round < rounds) {
                    for (let c = 0; c < 4; c++) {
                        last a0 = t[4 * c];
                        last a1 = t[4 * c + 1];
                        last a2 = t[4 * c + 2];
                        last a3 = t[4 * c + 3];
                        last all = a0 ^ a1 ^ a2 ^ a3;
                        s[4 * c] = a0 ^ all ^ xtime(a0 ^ a1);
                        s[4 * c + 1] = a1 ^ all ^ xtime(a1 ^ a2);
                        s[4 * c + 2] = a2 ^ all ^ xtime(a2 ^ a3);
                        s[4 * c + 3] = a3 ^ all ^ xtime(a3 ^ a0);
                    }
                } else {
                    for (let i = 0; i < 16; i++) {
                        s[i] = t[i];
                    }
                }
                last k = 16 * round;
                for (let i = 0; i < 16; i++) {
                    s[i] = s[i] ^ round_keys[k + i];
                }
            }
            return s;
        };

        /// @brief The decryption of the 16 bytes at `offset` of `block`.
        export let decrypt = func(block: uint8[list], offset: int) -> uint8[list] {
            let s: uint8[list] = new;
            last last_key = 16 * rounds;
            for (let i = 0; i < 16; i++) {
                s.append(block[offset + i] ^ round_keys[last_key + i]);
            }
            for (let round = rounds - 1; round >= 0; round--) {
                // InvShiftRows and InvSubBytes: byte (r, c + r) of the new state is S^-1(byte (r, c)).
                let t = work;
                for (let c = 0; c < 4; c++) {
                    for (let r = 0; r < 4; r++) {
                        t[4 * ((c + r) % 4) + r] = inverse_sbox[s[4 * c + r] as int];
                    }
                }
                last k = 16 * round;
                for (let i = 0; i < 16; i++) {
                    s[i] = t[i] ^ round_keys[k + i];
                }
                if (round > 0) {
                    for (let c = 0; c < 4; c++) {
                        last a0 = s[4 * c];
                        last a1 = s[4 * c + 1];
                        last a2 = s[4 * c + 2];
                        last a3 = s[4 * c + 3];
                        s[4 * c] = multiply(a0, 14) ^ multiply(a1, 11) ^ multiply(a2, 13) ^ multiply(a3, 9);
                        s[4 * c + 1] = multiply(a0, 9) ^ multiply(a1, 14) ^ multiply(a2, 11) ^ multiply(a3, 13);
                        s[4 * c + 2] = multiply(a0, 13) ^ multiply(a1, 9) ^ multiply(a2, 14) ^ multiply(a3, 11);
                        s[4 * c + 3] = multiply(a0, 11) ^ multiply(a1, 13) ^ multiply(a2, 9) ^ multiply(a3, 14);
                    }
                }
            }
            return s;
        };

        export let.override to_string = func -> string => "Aes.Cipher(<redacted>)";
    );
);
