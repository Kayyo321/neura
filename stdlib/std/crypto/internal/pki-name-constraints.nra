let.promote _ = import:Std.Core.Optional;
let.promote _ = import:Std.Crypto.Pki.Extensions;
let.promote _ = import:Std.Crypto.Pki.GeneralName;
let host_name = import:Std.Crypto.Pki.HostName;
let utf8 = import:Std.Encoding.Utf8;

/// @brief Name-constraint matching for RFC 5280 path validation (sections 4.2.1.10 and 6.1.3 (b), (c)).
/// Internal: only library source may import it.
///
/// `matches` answers 1 (the name is in the subtree), 0 (it is not) or -1 (the name or the constraint is
/// malformed, so the constraint cannot be evaluated, which validation treats as a failure).
#Since("0.3.0")
export let PkiNameConstraints = module (
    /// @brief Whether every name satisfies one layer of constraints: no name in an excluded subtree, and every
    /// name of a type that has permitted subtrees in one of them. A name of a type this module cannot evaluate
    /// (otherName, x400Address, ediPartyName, registeredID) fails when the layer constrains that type.
    export let satisfies = func(names: GeneralName[list], constraints: NameConstraints) -> bool {
        for (let name in names) {
            for (let subtree in constraints.excluded) {
                if (subtree.base.kind == name.kind) {
                    if (matches(name, subtree.base, true) != 0) {
                        return false;
                    }
                }
            }
            let constrained = false;
            let permitted = false;
            for (let subtree in constraints.permitted) {
                if (subtree.base.kind == name.kind) {
                    constrained = true;
                    last m = matches(name, subtree.base, false);
                    if (m < 0) {
                        return false;
                    }
                    if (m == 1) {
                        permitted = true;
                    }
                }
            }
            if (constrained && not permitted) {
                return false;
            }
        }
        return true;
    };

    /// @brief 1, 0 or -1 as the module says. `excluding` widens a wildcard dNSName to every name it could match.
    export let matches = func(name: GeneralName, base: GeneralName, excluding: bool) -> int {
        match (name.kind) {
            GeneralNameKind.DnsName => {
                return dns(lower(name.text), lower(base.text), excluding);
            },
            GeneralNameKind.IpAddress => {
                return ip(name.bytes, base.bytes);
            },
            GeneralNameKind.Rfc822Name => {
                return email(name.text, base.text);
            },
            GeneralNameKind.Uri => {
                return uri(name.text, lower(base.text));
            },
            GeneralNameKind.DirectoryName => {
                match (name.directory) {
                    Optional.Some(n) => {
                        match (base.directory) {
                            Optional.Some(b) => {
                                return n.starts_with(b) ? 1 : 0;
                            },
                            Optional.None => {
                                return -1;
                            },
                        }
                    },
                    Optional.None => {
                        return -1;
                    },
                }
            },
            _ => {
                return -1;
            },
        }
        return -1;
    };

    /// @brief ASCII lowercase, byte by byte (other bytes unchanged).
    let lower = func(text: string) -> string {
        let out: uint8[list] = new;
        for (let i = 0; i < text.byte_length; i++) {
            last c = text.byte_at(i);
            out.append(c >= 65 && c <= 90 ? c + 32 : c);
        }
        return utf8.decode_lossy(out);
    };

    let ends_with = func(text: string, suffix: string) -> bool => text.byte_length >= suffix.byte_length
        && text.slice(text.byte_length - suffix.byte_length, text.byte_length) == suffix;

    /// @brief DNS: a constraint "c" covers "c" and every name ending in ".c"; the empty constraint covers every
    /// name. A leading period is malformed for DNS (RFC 5280 allows it only for URI and e-mail constraints).
    let dns = func(name: string, constraint: string, excluding: bool) -> int {
        if (not host_name.is_dns_name(name, true)) {
            return -1;
        }
        if (constraint.byte_length == 0) {
            return 1;
        }
        last bare = constraint;
        if (not host_name.is_dns_name(bare, false)) {
            return -1;
        }
        if (name == bare || ends_with(name, "." .. bare)) {
            return 1;
        }
        // A wildcard name "*.s" stands for every one-label name under s: for exclusion it matches a constraint
        // of the form "x.s" too.
        if (excluding && name.byte_length > 2 && name.slice(0, 2) == "*.") {
            last suffix = name.slice(1, name.byte_length);
            if (ends_with(bare, suffix) && bare.byte_length > suffix.byte_length) {
                last head = bare.slice(0, bare.byte_length - suffix.byte_length);
                let one_label = true;
                for (let i = 0; i < head.byte_length; i++) {
                    if (head.byte_at(i) == 46) {
                        one_label = false;
                    }
                }
                if (one_label) {
                    return 1;
                }
            }
        }
        return 0;
    };

    /// @brief IP: the constraint is an address followed by a contiguous mask of the same family.
    let ip = func(address: uint8[list], constraint: uint8[list]) -> int {
        if (not (address.length == 4 || address.length == 16) || not (constraint.length == 8 || constraint.length == 32)) {
            return -1;
        }
        last half = constraint.length / 2;
        // The mask must be ones followed by zeros.
        let zero_seen = false;
        for (let i = half; i < constraint.length; i++) {
            for (let bit in 7 ..= 0 : -1) {
                last set = ((constraint[i] >> bit) & 1) == 1;
                if (set && zero_seen) {
                    return -1;
                }
                if (not set) {
                    zero_seen = true;
                }
            }
        }
        if (address.length != half) {
            return 0;
        }
        for (let i = 0; i < half; i++) {
            if ((address[i] & constraint[half + i]) != (constraint[i] & constraint[half + i])) {
                return 0;
            }
        }
        return 1;
    };

    let count_at = func(text: string) -> int {
        let n = 0;
        for (let i = 0; i < text.byte_length; i++) {
            if (text.byte_at(i) == 64) {
                n++;
            }
        }
        return n;
    };

    let last_at = func(text: string) -> int {
        for (let i = text.byte_length - 1; i >= 0; i--) {
            if (text.byte_at(i) == 64) {
                return i;
            }
        }
        return -1;
    };

    /// @brief rfc822Name: "local@host" is one mailbox; "host" every mailbox at host; ".host" every mailbox at a
    /// subdomain of host. Local parts compare exactly, hosts ignoring ASCII case.
    let email = func(address: string, constraint: string) -> int {
        last at = last_at(address);
        if (at <= 0 || at == address.byte_length - 1 || count_at(address) != 1 || count_at(constraint) > 1) {
            return -1;
        }
        last local = address.slice(0, at);
        last host = lower(address.slice(at + 1, address.byte_length));
        if (not host_name.is_dns_name(host, false)) {
            return -1;
        }
        last c_at = last_at(constraint);
        if (c_at >= 0) {
            last c_host = lower(constraint.slice(c_at + 1, constraint.byte_length));
            return local == constraint.slice(0, c_at) && host == c_host ? 1 : 0;
        }
        last c = lower(constraint);
        if (c.byte_length > 0 && c.byte_at(0) == 46) {
            return ends_with(host, c) ? 1 : 0;
        }
        return host == c ? 1 : 0;
    };

    /// @brief URI: the constraint applies to the host of the URI's authority; ".host" covers subdomains only.
    let uri = func(text: string, constraint: string) -> int {
        // scheme ":" "//" [userinfo "@"] host [":" port] ...
        let colon = -1;
        for (let i = 0; i < text.byte_length; i++) {
            if (text.byte_at(i) == 58) {
                colon = i;
                break;
            }
        }
        if (colon <= 0 || text.byte_length < colon + 3 || text.slice(colon + 1, colon + 3) != "//") {
            return -1;
        }
        let start = colon + 3;
        let stop = start;
        while (stop < text.byte_length && text.byte_at(stop) != 47 && text.byte_at(stop) != 63 && text.byte_at(stop) != 35) {
            stop++;
        }
        let authority = text.slice(start, stop);
        last at = last_at(authority);
        if (at >= 0) {
            authority = authority.slice(at + 1, authority.byte_length);
        }
        if (authority.byte_length > 0 && authority.byte_at(0) == 91) {
            return -1;
        }
        for (let i = 0; i < authority.byte_length; i++) {
            if (authority.byte_at(i) == 58) {
                authority = authority.slice(0, i);
                break;
            }
        }
        last host = lower(authority);
        if (not host_name.is_dns_name(host, false)) {
            return -1;
        }
        if (constraint.byte_length > 0 && constraint.byte_at(0) == 46) {
            return ends_with(host, constraint) ? 1 : 0;
        }
        return host == constraint ? 1 : 0;
    };
);
