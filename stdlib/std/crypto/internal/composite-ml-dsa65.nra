let ed25519 = import:Std.Crypto.Asymmetric.Ed25519;
let ml_dsa = import:Std.Crypto.Pqc.MlDsa;
let sha2 = import:Std.Crypto.Hash.Sha2;
let words = import:Std.Crypto.Internal.Words;

/// @brief Shared signing input and verification for id-MLDSA65-Ed25519-SHA512, as specified in
/// draft-ietf-lamps-pq-composite-sigs-19, sections 2.2, 3.3, 4 and 6.
/// @see [Std.Crypto.Pqc.Ed25519MlDsa65](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Ed25519MlDsa65)
#Since("0.3.0")
export let CompositeMlDsa65 = module (
    const Prefix = "CompositeAlgorithmSignatures2025";
    const Label = "COMPSIG-MLDSA65-Ed25519-SHA512";

    /// @brief The context passed to pure ML-DSA-65 by the composite signature algorithm.
    #[NoDiscard, Since("0.3.0")]
    export let label_bytes = func -> uint8[list] => words.utf8(Label);

    /// @brief The message representative signed by both component algorithms. An application context
    /// longer than 255 bytes traps.
    #[NoDiscard, Since("0.3.0")]
    export let format_message = func(message: uint8[list], context: uint8[list]) -> uint8[list] {
        if (context.length > 255) {
            trap_with_message("invalid argument: composite signature context must be at most 255 bytes");
        }
        let formatted = words.utf8(Prefix);
        words.append_all(formatted, label_bytes());
        formatted.append(context.length as uint8);
        words.append_all(formatted, context);
        words.append_all(formatted, sha2.sha512(message));
        return formatted;
    };

    /// @brief Checks both component signatures of this message and application context. Malformed keys,
    /// signatures, and contexts longer than 255 bytes return false. Callers enforce the composite
    /// algorithm policy before calling this helper. The component constructors enforce their own policies.
    #[NoDiscard, Since("0.3.0")]
    export let verify = func(public_key: uint8[list], message: uint8[list], signature: uint8[list],
            context: uint8[list]) -> bool {
        last key_split = ml_dsa.public_key_length(ml_dsa.ParameterSet.MlDsa65);
        last signature_split = ml_dsa.signature_length(ml_dsa.ParameterSet.MlDsa65);
        if (public_key.length != key_split + 32 || signature.length != signature_split + 64 || context.length > 255) {
            return false;
        }
        last formatted = format_message(message, context);
        last pq_key = new ml_dsa.MlDsaPublicKey(ml_dsa.ParameterSet.MlDsa65,
            words.slice(public_key, 0, key_split));
        last pq_verifier = new ml_dsa.MlDsaVerifier(pq_key);
        if (!pq_verifier.verify_with_context(formatted, words.slice(signature, 0, signature_split), label_bytes())) {
            return false;
        }
        last classical_key = new ed25519.Ed25519PublicKey(words.slice(public_key, key_split, public_key.length));
        last classical_verifier = new ed25519.Ed25519Verifier(classical_key);
        return classical_verifier.verify(formatted, words.slice(signature, signature_split, signature.length));
    };
);
