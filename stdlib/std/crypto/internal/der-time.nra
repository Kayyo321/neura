/// @brief Civil-date arithmetic for the DER time types of Std.Crypto.Pki. Internal: only library source may
/// import it.
///
/// Days are counted from 1970-01-01 in the proleptic Gregorian calendar (H. Hinnant's days_from_civil and
/// civil_from_days), in int64, so no input this library accepts can overflow.
#Since("0.3.0")
export let DerTime = module (
    /// @brief Whether the year is a leap year.
    #[Pure, ThreadSafe]
    export let is_leap = func(year: int64) -> bool => (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;

    /// @brief The number of days in the month (1 to 12) of the year.
    #[Pure, ThreadSafe]
    export let month_length = func(year: int64, month: int) -> int {
        if (month == 2) {
            return is_leap(year) ? 29 : 28;
        }
        return if (month == 4 || month == 6 || month == 9 || month == 11) -> 30 else -> 31;
    };

    /// @brief Days since 1970-01-01 of a valid date.
    #[Pure, ThreadSafe]
    export let days_from_civil = func(year: int64, month: int, day: int) -> int64 {
        last y = month <= 2 ? year - 1 : year;
        last era = (y >= 0 ? y : y - 399) / 400;
        last yoe = y - era * 400;
        last mp = ((month + 9) % 12) as int64;
        last doy = (153 * mp + 2) / 5 + (day as int64) - 1;
        last doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
        return era * 146097 + doe - 719468;
    };

    /// @brief [year, month, day] of a day count since 1970-01-01.
    #[Pure, ThreadSafe]
    export let civil_from_days = func(days: int64) -> int64[list] {
        last z = days + 719468;
        last era = (z >= 0 ? z : z - 146096) / 146097;
        last doe = z - era * 146097;
        last yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        last doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
        last mp = (5 * doy + 2) / 153;
        last d = doy - (153 * mp + 2) / 5 + 1;
        last m = mp < 10 ? mp + 3 : mp - 9;
        last y = yoe + era * 400 + (m <= 2 ? 1 : 0);
        let out: int64[list] = new;
        out.append(y);
        out.append(m);
        out.append(d);
        return out;
    };
);
