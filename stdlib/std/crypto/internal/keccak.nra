let words = import:Std.Crypto.Internal.Words;

/// @brief The Keccak-p[1600] sponge of FIPS 202 with a chosen rate, domain-separation byte and round count
/// (24 for SHA-3, SHAKE and SP 800-185, 12 for TurboSHAKE). Internal. The round constants and rotation offsets
/// are printed by scripts/crypto-vectors/constants.py.
#Since("0.3.0")
export let Keccak = module (
    /// @brief A new list of the table (a function, so that tasks can use it: arrays are not transferable).
    let round_constants_table = func -> uint64[list] => new([
        1, 32898, 9223372036854808714, 9223372039002292224,
        32907, 2147483649, 9223372039002292353, 9223372036854808585,
        138, 136, 2147516425, 2147483658,
        2147516555, 9223372036854775947, 9223372036854808713, 9223372036854808579,
        9223372036854808578, 9223372036854775936, 32778, 9223372039002259466,
        9223372039002292353, 9223372036854808704, 2147483649, 9223372039002292232
    ]);

    /// @brief The rotation offset of lane x + 5y.
    /// @brief A new list of the table (a function, so that tasks can use it: arrays are not transferable).
    let rho_table = func -> int[list] => new([0, 1, 62, 28, 27, 36, 44, 6, 55, 20, 3, 10, 43, 25, 39, 41, 45, 15, 21, 8, 18, 2, 61, 56, 14]);

    /// @brief The lane that lane x + 5y moves to: y + 5((2x + 3y) mod 5).
    /// @brief A new list of the table (a function, so that tasks can use it: arrays are not transferable).
    let pi_table = func -> int[list] => new([0, 10, 20, 5, 15, 16, 1, 11, 21, 6, 7, 17, 2, 12, 22, 23, 8, 18, 3, 13, 14, 24, 9, 19, 4]);

    /// @brief Keccak-p[1600] on lanes or a 200-byte little-endian state, with reusable scratch.
    export let Permutation = class (
        let moved: uint64[list] = new;
        let columns: uint64[list] = new;
        let rho: int[list] = rho_table();
        let pi: int[list] = pi_table();
        let round_constants: uint64[list] = round_constants_table();

        export let init = func {
            for (let i in 0 .. 25) {
                moved.append(0);
            }
            for (let i in 0 .. 5) {
                columns.append(0);
            }
        };

        /// @brief Applies rounds first_round through 23 to the caller's 25 lanes.
        export let apply = func(lanes: uint64[list], first_round: int) {
            let a = lanes;
            let b = moved;
            let c = columns;
            for (let round = first_round; round < 24; round++) {
                for (let x = 0; x < 5; x++) {
                    c[x] = a[x] ^ a[x + 5] ^ a[x + 10] ^ a[x + 15] ^ a[x + 20];
                }
                for (let x = 0; x < 5; x++) {
                    last right = c[(x + 1) % 5];
                    last d = c[(x + 4) % 5] ^ ((right << 1) | (right >> 63));
                    for (let y = 0; y < 25; y += 5) {
                        a[x + y] = a[x + y] ^ d;
                    }
                }
                b[0] = a[0];
                for (let i = 1; i < 25; i++) {
                    last n = rho[i];
                    last lane = a[i];
                    b[pi[i]] = (lane << n) | (lane >> (64 - n));
                }
                for (let y = 0; y < 25; y += 5) {
                    for (let x = 0; x < 5; x++) {
                        a[x + y] = b[x + y] ^ ((~b[(x + 1) % 5 + y]) & b[(x + 2) % 5 + y]);
                    }
                }
                a[0] = a[0] ^ round_constants[round];
            }
        };

        /// @brief Applies all 24 rounds in place to a serialized state.
        export let apply_bytes = func(state: uint8[list]) {
            if (state.length != 200) {
                trap_with_message("invalid argument: Keccak permutation state must be 200 bytes");
            }
            let lanes: uint64[list] = new;
            for (let i in 0 .. 25) {
                lanes.append(words.load64_le(state, 8 * i));
            }
            apply(lanes, 0);
            for (let i in 0 .. 25) {
                last lane = lanes[i];
                for (let j in 0 .. 8) {
                    state[8 * i + j] = ((lane >> (8 * j)) & 255) as uint8;
                }
            }
        };

        export let.override to_string = func -> string => "Keccak.Permutation(<redacted>)";
    );

    /// @brief A sponge: absorb, then squeeze. The first squeeze pads with the domain byte and 0x80.
    export let Sponge = class (
        let lanes: uint64[list] = new;
        let permutation: Permutation = new;
        let pending: uint8[list] = new;
        let output: uint8[list] = new;
        let output_at: int = 0;
        let squeezing: bool = false;
        last rate: int;
        last domain: uint8;
        last first_round: int;

        /// @brief A sponge with `rate_bytes` of rate (a multiple of 8 below 200), the domain byte (0x06 SHA-3,
        /// 0x1F SHAKE, 0x04 cSHAKE, or TurboSHAKE's D), and 24 or 12 rounds.
        export let init = func(rate_bytes: int, domain_byte: uint8, rounds: int) {
            rate = rate_bytes;
            domain = domain_byte;
            first_round = 24 - rounds;
            for (let i in 0 .. 25) {
                lanes.append(0);
            }
        };

        /// @brief The rate in bytes.
        export let rate_bytes = func -> int => rate;

        /// @brief Whether squeezing has started.
        export let is_squeezing = func -> bool => squeezing;

        /// @brief Absorbs the bytes. Traps with "invalid state: digest finished" once squeezing has started.
        export let absorb = func(bytes: uint8[list]) {
            if (squeezing) {
                trap_with_message("invalid state: digest finished");
            }
            let i = 0;
            if (pending.length > 0) {
                while (i < bytes.length && pending.length < rate) {
                    pending.append(bytes[i]);
                    i++;
                }
                if (pending.length < rate) {
                    return;
                }
                absorb_block(pending, 0);
                pending = new;
            }
            while (i + rate <= bytes.length) {
                absorb_block(bytes, i);
                i += rate;
            }
            while (i < bytes.length) {
                pending.append(bytes[i]);
                i++;
            }
        };

        /// @brief The next `count` bytes of output.
        export let squeeze = func(count: int) -> uint8[list] {
            if (count < 0) {
                trap_with_message("invalid argument: negative length");
            }
            if (not squeezing) {
                squeezing = true;
                let block = pending;
                pending = new;
                block.append(domain);
                while (block.length < rate) {
                    block.append(0);
                }
                block[rate - 1] = block[rate - 1] ^ 128;
                absorb_block(block, 0);
                fill_output();
            }
            let out: uint8[list] = new;
            while (out.length < count) {
                if (output_at == rate) {
                    permute();
                    fill_output();
                }
                out.append(output[output_at]);
                output_at++;
            }
            return out;
        };

        let fill_output = func {
            output = new;
            for (let i = 0; i < rate / 8; i++) {
                words.append64_le(output, lanes[i]);
            }
            output_at = 0;
        };

        let absorb_block = func(block: uint8[list], offset: int) {
            for (let i = 0; i < rate / 8; i++) {
                lanes[i] = lanes[i] ^ words.load64_le(block, offset + 8 * i);
            }
            permute();
        };

        let permute = func => permutation.apply(lanes, first_round);

        export let.override to_string = func -> string => "Keccak.Sponge(<redacted>)";
    );
);
