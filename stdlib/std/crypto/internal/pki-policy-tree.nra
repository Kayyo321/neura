let.promote _ = import:Std.Crypto.Pki.Extensions;
let oids = import:Std.Crypto.Pki.Oids;

/// @brief The valid_policy_tree of RFC 5280, section 6.1, with the operations of sections 6.1.3 (d) to (f),
/// 6.1.4 (a) and (b), and 6.1.5 (g). Internal: only library source may import it.
///
/// Nodes live in one list and refer to their parent by index; a deleted node stays in the list, marked. The
/// tree is capped at `MaxNodes` nodes: policy trees can grow exponentially with crafted mappings (as in
/// CVE-2023-0464), and validation fails when the cap is reached.
.Since("0.3.0")
export let PkiPolicyTree = module (
    /// @brief The largest number of nodes a tree may hold.
    export const MaxNodes: int = 2000;

    /// @brief One node: valid_policy, qualifier_set and expected_policy_set.
    .Final
    export let PolicyNode = class (
        export last valid_policy: string;
        export last qualifiers: PolicyQualifier[list];
        export let expected: string[list];
        export last depth: int;
        export last parent: int;
        export let deleted: bool = false;

        export let init = func(policy: string, qualifier_set: PolicyQualifier[list], expected_set: string[list],
            level: int, parent_index: int) {
            valid_policy = policy;
            qualifiers = qualifier_set;
            expected = expected_set;
            depth = level;
            parent = parent_index;
        };

        export let.override to_string = func -> string => $"PolicyNode({valid_policy} at depth {depth})";
    );

    /// @brief A valid_policy_tree; `is_null` once it became NULL.
    .Final
    export let PolicyTree = class (
        export let nodes: PolicyNode[list] = new;
        export let is_null: bool = false;
        /// @brief Whether the tree passed `MaxNodes`.
        export let overflowed: bool = false;

        /// @brief The initial tree: one anyPolicy node of depth 0.
        export let init = func {
            nodes.append(new PolicyNode(oids.AnyPolicy, new, new([oids.AnyPolicy]), 0, -1));
        };

        let add = func(policy: string, qualifier_set: PolicyQualifier[list], expected_set: string[list], level: int,
            parent_index: int) {
            if (nodes.length >= MaxNodes) {
                overflowed = true;
                return;
            }
            nodes.append(new PolicyNode(policy, qualifier_set, expected_set, level, parent_index));
        };

        let has_child_with = func(index: int, policy: string) -> bool {
            for (let n in nodes) {
                if (not n.deleted && n.parent == index && n.valid_policy == policy) {
                    return true;
                }
            }
            return false;
        };

        let has_child = func(index: int) -> bool {
            for (let n in nodes) {
                if (not n.deleted && n.parent == index) {
                    return true;
                }
            }
            return false;
        };

        /// @brief Deletes the node and its descendants.
        let delete_node = func(index: int) {
            nodes[index].deleted = true;
            for (let i = index + 1; i < nodes.length; i++) {
                if (not nodes[i].deleted && nodes[i].parent >= 0 && nodes[nodes[i].parent].deleted) {
                    nodes[i].deleted = true;
                }
            }
        };

        /// @brief Deletes, repeatedly, every node of depth at most `max_depth` without children; the tree
        /// becomes NULL when the root goes.
        export let prune = func(max_depth: int) {
            let changed = true;
            while (changed) {
                changed = false;
                for (let i = nodes.length - 1; i >= 0; i--) {
                    if (not nodes[i].deleted && nodes[i].depth <= max_depth && not has_child(i)) {
                        nodes[i].deleted = true;
                        changed = true;
                    }
                }
            }
            if (nodes[0].deleted) {
                is_null = true;
            }
        };

        /// @brief Section 6.1.3 (d) for certificate `i` (1-based) with its policies; `any_allowed` says whether
        /// its anyPolicy is processed (inhibit_anyPolicy > 0, or i < n and the certificate is self-issued).
        export let process_certificate = func(i: int, policies: PolicyInformation[list], any_allowed: bool) {
            last count = nodes.length;
            let any_qualifiers: PolicyQualifier[list] = new;
            let has_any = false;
            for (let info in policies) {
                last p = info.policy.dotted;
                if (p == oids.AnyPolicy) {
                    has_any = true;
                    any_qualifiers = info.qualifiers;
                    continue;
                }
                let matched = false;
                for (let k = 0; k < count; k++) {
                    last node = nodes[k];
                    if (not node.deleted && node.depth == i - 1 && contains(node.expected, p)) {
                        add(p, info.qualifiers, new([p]), i, k);
                        matched = true;
                    }
                }
                if (not matched) {
                    for (let k = 0; k < count; k++) {
                        last node = nodes[k];
                        if (not node.deleted && node.depth == i - 1 && node.valid_policy == oids.AnyPolicy) {
                            add(p, info.qualifiers, new([p]), i, k);
                        }
                    }
                }
            }
            if (has_any && any_allowed) {
                for (let k = 0; k < count; k++) {
                    if (nodes[k].deleted || nodes[k].depth != i - 1) {
                        continue;
                    }
                    for (let value in nodes[k].expected) {
                        if (not has_child_with(k, value)) {
                            add(value, any_qualifiers, new([value]), i, k);
                        }
                    }
                }
            }
            prune(i - 1);
        };

        /// @brief Section 6.1.4 (b) for certificate `i`: with `mapping_allowed`, nodes of depth i take the mapped
        /// expected sets; otherwise mapped policies are deleted.
        export let apply_mappings = func(i: int, mappings: PolicyMapping[list], mapping_allowed: bool) {
            let issuers: string[list] = new;
            for (let m in mappings) {
                if (not contains(issuers, m.issuer_domain.dotted)) {
                    issuers.append(m.issuer_domain.dotted);
                }
            }
            for (let id in issuers) {
                if (mapping_allowed) {
                    let mapped: string[list] = new;
                    for (let m in mappings) {
                        if (m.issuer_domain.dotted == id && not contains(mapped, m.subject_domain.dotted)) {
                            mapped.append(m.subject_domain.dotted);
                        }
                    }
                    let found = false;
                    for (let n in nodes) {
                        if (not n.deleted && n.depth == i && n.valid_policy == id) {
                            n.expected = copy(mapped);
                            found = true;
                        }
                    }
                    if (not found) {
                        last count = nodes.length;
                        for (let k = 0; k < count; k++) {
                            last n = nodes[k];
                            if (not n.deleted && n.depth == i && n.valid_policy == oids.AnyPolicy) {
                                add(id, n.qualifiers, copy(mapped), i, n.parent);
                                break;
                            }
                        }
                    }
                } else {
                    for (let k = 0; k < nodes.length; k++) {
                        if (not nodes[k].deleted && nodes[k].depth == i && nodes[k].valid_policy == id) {
                            delete_node(k);
                        }
                    }
                }
            }
            if (not mapping_allowed) {
                prune(i - 1);
            }
        };

        /// @brief Section 6.1.5 (g): the intersection with the user-initial-policy-set at depth n.
        export let intersect = func(n: int, user_set: string[list]) {
            if (is_null || contains(user_set, oids.AnyPolicy)) {
                return;
            }
            // valid_policy_node_set: nodes whose parent is an anyPolicy node.
            let in_set: int[list] = new;
            for (let k = 1; k < nodes.length; k++) {
                if (not nodes[k].deleted && nodes[nodes[k].parent].valid_policy == oids.AnyPolicy) {
                    in_set.append(k);
                }
            }
            let set_policies: string[list] = new;
            for (let k in in_set) {
                set_policies.append(nodes[k].valid_policy);
            }
            for (let k in in_set) {
                last p = nodes[k].valid_policy;
                if (not nodes[k].deleted && p != oids.AnyPolicy && not contains(user_set, p)) {
                    delete_node(k);
                }
            }
            last count = nodes.length;
            for (let k = 0; k < count; k++) {
                last node = nodes[k];
                if (not node.deleted && node.depth == n && node.valid_policy == oids.AnyPolicy) {
                    for (let p in user_set) {
                        if (not contains(set_policies, p)) {
                            add(p, node.qualifiers, new([p]), n, node.parent);
                        }
                    }
                    delete_node(k);
                }
            }
            prune(n - 1);
        };

        /// @brief The valid_policy of every node at depth n (the authorities' or the user's constrained set).
        export let policies_at = func(n: int) -> string[list] {
            let out: string[list] = new;
            if (is_null) {
                return out;
            }
            for (let node in nodes) {
                if (not node.deleted && node.depth == n && not contains(out, node.valid_policy)) {
                    out.append(node.valid_policy);
                }
            }
            return out;
        };

        export let.override to_string = func -> string => is_null ? "PolicyTree(NULL)" : $"PolicyTree({nodes.length} nodes)";
    );

    let contains = func(items: string[list], value: string) -> bool {
        for (let item in items) {
            if (item == value) {
                return true;
            }
        }
        return false;
    };

    let copy = func(items: string[list]) -> string[list] {
        let out: string[list] = new;
        for (let item in items) {
            out.append(item);
        }
        return out;
    };
);
