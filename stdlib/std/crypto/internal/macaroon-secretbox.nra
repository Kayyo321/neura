let.promote _ = import:Std.Core.Result;
let.promote _ = import:Std.Crypto.Algorithm;
let constant_time = import:Std.Crypto.Core.ConstantTime;
let crypto_policy = import:Std.Crypto.Core.CryptoPolicy;
let error = import:Std.Core.Error;
let poly1305 = import:Std.Crypto.Mac.Poly1305;
let salsa20 = import:Std.Crypto.Internal.Salsa20;
let words = import:Std.Crypto.Internal.Words;

/// @brief XSalsa20-Poly1305 in the NaCl secretbox format, for 32-byte Macaroons caveat keys.
#Since("0.3.0")
export let MacaroonSecretbox = module (
    let state = func(key: uint8[list], nonce_words: uint8[list]) -> uint32[list] => new([
        1634760805, words.load32_le(key, 0), words.load32_le(key, 4), words.load32_le(key, 8), words.load32_le(key, 12),
        857760878, words.load32_le(nonce_words, 0), words.load32_le(nonce_words, 4), words.load32_le(nonce_words, 8),
        words.load32_le(nonce_words, 12), 2036477234, words.load32_le(key, 16), words.load32_le(key, 20),
        words.load32_le(key, 24), words.load32_le(key, 28), 1797285236
    ]);

    let stream_block = func(key: uint8[list], nonce: uint8[list]) -> uint8[list] {
        crypto_policy.require(Algorithm.XSalsa20);
        last hsalsa_input = state(key, words.slice(nonce, 0, 16));
        last x = salsa20.permute20(hsalsa_input);
        let subkey: uint8[list] = new;
        for (let i in [0, 5, 10, 15, 6, 7, 8, 9]) {
            words.append32_le(subkey, x[i]);
        }
        last salsa_input = state(subkey, words.concat(words.slice(nonce, 16, 24), words.zeros(8)));
        last y = salsa20.permute20(salsa_input);
        let stream: uint8[list] = new;
        for (let i in 0 .. 16) {
            words.append32_le(stream, words.add32(salsa_input[i], y[i]));
            hsalsa_input[i] = 0;
            x[i] = 0;
            salsa_input[i] = 0;
            y[i] = 0;
        }
        words.wipe(subkey);
        return stream;
    };

    /// @brief Seals one 32-byte secret as nonce (24) || tag (16) || ciphertext (32).
    export let seal = func(key: uint8[list], nonce: uint8[list], secret: uint8[list]) -> uint8[list] {
        last stream = stream_block(key, nonce);
        last mac_key = words.slice(stream, 0, 32);
        last data_key = words.slice(stream, 32, 64);
        last ciphertext = words.xor(secret, data_key);
        last tag = poly1305.mac(mac_key, ciphertext);
        words.wipe(stream);
        words.wipe(mac_key);
        words.wipe(data_key);
        let out = words.concat(nonce, tag);
        words.append_all(out, ciphertext);
        return out;
    };

    /// @brief Authenticates a 72-byte sealed secret, then decrypts it.
    export let open = func(key: uint8[list], sealed: uint8[list]) -> Result<uint8[list]> {
        if (sealed.length != 72) {
            return Result<uint8[list]>.Err(error.custom("crypto.authentication", "invalid macaroon caveat box"));
        }
        last stream = stream_block(key, words.slice(sealed, 0, 24));
        last mac_key = words.slice(stream, 0, 32);
        last ciphertext = words.slice(sealed, 40, 72);
        last expected = poly1305.mac(mac_key, ciphertext);
        words.wipe(mac_key);
        if (not constant_time.ct_eq(words.slice(sealed, 24, 40), expected)) {
            words.wipe(stream);
            return Result<uint8[list]>.Err(error.custom("crypto.authentication", "authentication failed"));
        }
        last data_key = words.slice(stream, 32, 64);
        last secret = words.xor(ciphertext, data_key);
        words.wipe(stream);
        words.wipe(data_key);
        return Result<uint8[list]>.Ok(secret);
    };
);
