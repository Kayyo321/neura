let.promote _ = import:Std.Core.Optional;
let mp = import:Std.Crypto.Internal.Mp;
let words = import:Std.Crypto.Internal.Words;

/// @brief The edwards25519 group of RFC 8032, section 5.1: points, the scalar field modulo L, the 32-byte point
/// and scalar encodings, and equality. Internal: Ed25519, and later ristretto255 and FROST, build on it.
///
/// Points are extended coordinates (X : Y : Z : T) with x = X/Z, y = Y/Z, x y = T/Z, field elements in
/// Montgomery form. The addition formula of RFC 8032, section 5.1.4 is complete on this curve, so scalar
/// multiplication adds a table entry for every window, including the identity, with no branch on the scalar.
/// That is branch-free in source; the runtime does not guarantee constant time. Decoding works on public data
/// and returns early. The constants come from scripts/crypto-vectors/gen-asymmetric-constants.py.
#Since("0.3.0")
export let Edwards25519 = module (
    /// @brief A point in extended coordinates (Montgomery-form field elements). Immutable by convention.
    #Final
    export let Point = class (
        export last x: uint32[list];
        export last y: uint32[list];
        export last z: uint32[list];
        export last t: uint32[list];

        export let init = func(px: uint32[list], py: uint32[list], pz: uint32[list], pt: uint32[list]) {
            x = px;
            y = py;
            z = pz;
            t = pt;
        };

        export let.override to_string = func -> string => "Edwards25519.Point";
    );

    /// @brief The group: the field modulo p = 2^255 - 19, the scalars modulo L, and the constants. Build one
    /// per operation (it holds scratch state, so a task must not share it).
    #Final
    export let Group = class (
        /// @brief The field modulo p.
        export last field: mp.Modulus;
        /// @brief The scalars modulo L.
        export last order: mp.Modulus;
        /// @brief 2 d in Montgomery form.
        last d2: uint32[list];
        /// @brief d in Montgomery form.
        last d: uint32[list];
        /// @brief sqrt(-1) = 2^((p-1)/4) in Montgomery form.
        last sqrt_m1: uint32[list];
        /// @brief (p - 5) / 8.
        last exponent: uint32[list];

        export let init = func {
            field = new(mp.from_hex("7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffed", 8));
            order = new(mp.from_hex("1000000000000000000000000000000014def9dea2f79cd65812631a5cf5d3ed", 8));
            d = field.to_mont(mp.from_hex("52036cee2b6ffe738cc740797779e89800700a4d4141d8ab75eb4dca135978a3", 8));
            d2 = field.add(d, d);
            sqrt_m1 = field.to_mont(mp.from_hex("2b8324804fc1df0b2b4d00993dfbd7a72f431806ad2fe478c4ee1b274a0ea0b0", 8));
            exponent = mp.shift_right(mp.plain_sub(field.m, mp.small(5, 8)), 3);
        };

        /// @brief The neutral element (0, 1).
        export let identity = func -> Point => new(mp.zeros(8), field.one, field.one, mp.zeros(8));

        /// @brief The base point B of RFC 8032.
        export let base = func -> Point {
            last bx = field.to_mont(mp.from_hex("216936d3cd6e53fec0a4e231fdd6dc5c692cc7609525a7b2c9562d608f25d51a", 8));
            last by = field.to_mont(mp.from_hex("6666666666666666666666666666666666666666666666666666666666666658", 8));
            return new(bx, by, field.one, field.mul(bx, by));
        };

        /// @brief P + Q (RFC 8032, section 5.1.4).
        export let add = func(p: Point, q: Point) -> Point {
            last f = field;
            last a = f.mul(f.sub(p.y, p.x), f.sub(q.y, q.x));
            last b = f.mul(f.add(p.y, p.x), f.add(q.y, q.x));
            last c = f.mul(f.mul(p.t, d2), q.t);
            last zz = f.mul(p.z, q.z);
            last dd = f.add(zz, zz);
            last e = f.sub(b, a);
            last ff = f.sub(dd, c);
            last g = f.add(dd, c);
            last h = f.add(b, a);
            return new(f.mul(e, ff), f.mul(g, h), f.mul(ff, g), f.mul(e, h));
        };

        /// @brief 2 P (RFC 8032, section 5.1.4).
        export let double = func(p: Point) -> Point {
            last f = field;
            last a = f.sqr(p.x);
            last b = f.sqr(p.y);
            last zz = f.sqr(p.z);
            last c = f.add(zz, zz);
            last h = f.add(a, b);
            last e = f.sub(h, f.sqr(f.add(p.x, p.y)));
            last g = f.sub(a, b);
            last ff = f.add(c, g);
            return new(f.mul(e, ff), f.mul(g, h), f.mul(ff, g), f.mul(e, h));
        };

        /// @brief -P.
        export let negate = func(p: Point) -> Point => new(field.neg(p.x), p.y, p.z, field.neg(p.t));

        /// @brief P - Q.
        export let subtract = func(p: Point, q: Point) -> Point => add(p, negate(q));

        /// @brief Selects `a` when `choice` is 1 and `b` when it is 0, coordinate by coordinate.
        export let select = func(choice: uint32, a: Point, b: Point) -> Point =>
            new(mp.select(choice, a.x, b.x), mp.select(choice, a.y, b.y), mp.select(choice, a.z, b.z),
                mp.select(choice, a.t, b.t));

        /// @brief k P for a scalar of any limb count (an ordinary value, not reduced), with a fixed 4-bit window.
        /// The steps depend only on the scalar's limb count.
        export let multiply = func(k: uint32[list], p: Point) -> Point {
            last table = window_table(p);
            let acc = identity();
            for (let window = k.length * 8 - 1; window >= 0; window--) {
                acc = double(double(double(double(acc))));
                last digit = (k[window / 8] >> ((window % 8) * 4)) & 15;
                let chosen = identity();
                for (let i = 0; i < 16; i++) {
                    chosen = select(mp.eq32(i as uint32, digit), table[i], chosen);
                }
                acc = add(acc, chosen);
            }
            return acc;
        };

        /// @brief k B.
        export let multiply_base = func(k: uint32[list]) -> Point => multiply(k, base());

        /// @brief k1 P1 + k2 P2 with shared doublings (Straus), scalars of one limb count. Table entries are
        /// read by index, so use it for verification, where the scalars are public.
        export let multiply_two = func(k1: uint32[list], p1: Point, k2: uint32[list], p2: Point) -> Point {
            last first = window_table(p1);
            last second = window_table(p2);
            let acc = identity();
            for (let window = k1.length * 8 - 1; window >= 0; window--) {
                acc = double(double(double(double(acc))));
                acc = add(acc, first[((k1[window / 8] >> ((window % 8) * 4)) & 15) as int]);
                acc = add(acc, second[((k2[window / 8] >> ((window % 8) * 4)) & 15) as int]);
            }
            return acc;
        };

        /// @brief [0 P, 1 P, ..., 15 P].
        let window_table = func(p: Point) -> Point[list] {
            let table: Point[list] = new;
            table.append(identity());
            table.append(p);
            for (let i in 2 .. 16) {
                table.append(i % 2 == 0 ? double(table[i / 2]) : add(table[i - 1], p));
            }
            return table;
        };

        /// @brief Whether P is the neutral element (X = 0 and Y = Z).
        export let is_identity = func(p: Point) -> bool =>
            mp.is_zero(p.x) == 1 && mp.equal(p.y, p.z) == 1;

        /// @brief Whether P and Q are the same point (X1 Z2 = X2 Z1 and Y1 Z2 = Y2 Z1).
        export let equal = func(p: Point, q: Point) -> bool {
            last f = field;
            last same_x = mp.equal(f.mul(p.x, q.z), f.mul(q.x, p.z));
            last same_y = mp.equal(f.mul(p.y, q.z), f.mul(q.y, p.z));
            return (same_x & same_y) == 1;
        };

        /// @brief Whether 8 P is the neutral element: P lies in the torsion subgroup of order dividing 8.
        export let is_small_order = func(p: Point) -> bool => is_identity(double(double(double(p))));

        /// @brief The 32-byte encoding of RFC 8032, section 5.1.2: y little-endian with the low bit of x in the
        /// top bit.
        export let encode = func(p: Point) -> uint8[list] {
            last f = field;
            last zi = f.inv(p.z);
            last ax = f.from_mont(f.mul(p.x, zi));
            last ay = f.from_mont(f.mul(p.y, zi));
            let out = mp.to_bytes_le(ay, 32);
            out[31] = out[31] | (((ax[0] & 1) << 7) as uint8);
            return out;
        };

        /// @brief The point of a 32-byte encoding (RFC 8032, section 5.1.3), or None when y is not below p, x
        /// has no square root, or x is zero with its sign bit set. Every accepted encoding is canonical.
        export let decode = func(bytes: uint8[list]) -> Optional<Point> {
            if (bytes.length != 32) {
                return Optional<Point>.None;
            }
            last f = field;
            last sign = ((bytes[31] >> 7) & 1) as uint32;
            let ybytes = words.copy(bytes);
            ybytes[31] = ybytes[31] & 127;
            last yv = mp.from_bytes_le(ybytes, 8);
            if (mp.less(yv, f.m) == 0) {
                return Optional<Point>.None;
            }
            last y = f.to_mont(yv);
            last yy = f.sqr(y);
            last u = f.sub(yy, f.one);
            last v = f.add(f.mul(d, yy), f.one);
            last v3 = f.mul(f.sqr(v), v);
            last v7 = f.mul(f.sqr(v3), v);
            let x = f.mul(f.mul(u, v3), f.pow(f.mul(u, v7), exponent));
            last vxx = f.mul(v, f.sqr(x));
            if (mp.equal(vxx, u) == 0) {
                if (mp.equal(vxx, f.neg(u)) == 0) {
                    return Optional<Point>.None;
                }
                x = f.mul(x, sqrt_m1);
            }
            last plain = f.from_mont(x);
            if (mp.is_zero(plain) == 1 && sign == 1) {
                return Optional<Point>.None;
            }
            if ((plain[0] & 1) != sign) {
                x = f.neg(x);
            }
            return Optional<Point>.Some(new(x, y, f.one, f.mul(x, y)));
        };

        /// @brief The scalar of up to 64 little-endian bytes reduced modulo L, as 8 limbs.
        export let scalar_reduce = func(bytes: uint8[list]) -> uint32[list] => order.reduce_bytes_le(bytes);

        /// @brief (a b + c) mod L for scalars of 8 limbs (a may be at or above L, b and c below it).
        export let scalar_mul_add = func(a: uint32[list], b: uint32[list], c: uint32[list]) -> uint32[list] =>
            order.add(order.mul(a, order.to_mont(b)), c);

        /// @brief The scalar of 32 little-endian bytes when it is below L (RFC 8032's check on S), else None.
        export let scalar_canonical = func(bytes: uint8[list]) -> Optional<uint32[list]> {
            last s = mp.from_bytes_le(bytes, 8);
            if (mp.less(s, order.m) == 0) {
                return Optional<uint32[list]>.None;
            }
            return Optional<uint32[list]>.Some(s);
        };

        /// @brief The 32 little-endian bytes of a scalar.
        export let scalar_bytes = func(s: uint32[list]) -> uint8[list] => mp.to_bytes_le(s, 32);

        export let.override to_string = func -> string => "Edwards25519.Group";
    );
);
