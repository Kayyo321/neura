let argon2 = import:Std.Crypto.Kdf.Argon2;
let constant_time = import:Std.Crypto.Core.ConstantTime;
let error = import:Std.Core.Error;
let int32s = import:Std.Core.Int32;
let.promote _ = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Result;
let phc = import:Std.Crypto.Kdf.Phc;
let scrypt = import:Std.Crypto.Kdf.Scrypt;

/// @brief Password hashing in PHC strings with Argon2id or scrypt: hash, verify and `needs_rehash`
/// (Stdlib.md section 21.6).
///
/// The caller supplies the salt: 16 random bytes from Std.Crypto.Random for each password. Verification
/// compares in constant time.
/// @see [Std.Crypto.Kdf.PasswordHash](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-PasswordHash)
#Since("0.3.0")
export let PasswordHash = module (
    /// @brief `$argon2id$v=19$m=<m>,t=<t>,p=<p>$<salt>$<hash>` for the password.
    #[NoDiscard, Since("0.3.0")]
    export let hash_password = func(password: uint8[list], salt: uint8[list], params: argon2.Argon2Params) -> string {
        last tag = argon2.argon2id(password, salt, params);
        return new phc.PhcString("argon2id", 19, new(["m", "t", "p"]), new([params.memory_kib.to_string(),
            params.iterations.to_string(), params.parallelism.to_string()]), salt, tag).to_string();
    };

    /// @brief `$scrypt$ln=<log2 N>,r=<r>,p=<p>$<salt>$<hash>` for the password, with a hash of `length` bytes.
    #[NoDiscard, Since("0.3.0")]
    export let hash_password_scrypt = func(password: uint8[list], salt: uint8[list], log2_n: int, r: int, p: int,
            length: int) -> string {
        if (log2_n < 1 || log2_n > 30) {
            trap_with_message("invalid argument: scrypt parameters");
        }
        last key = scrypt.derive(password, salt, 1 << log2_n, r, p, length);
        return new phc.PhcString("scrypt", -1, new(["ln", "r", "p"]), new([log2_n.to_string(), r.to_string(),
            p.to_string()]), salt, key).to_string();
    };

    let unsupported = func(message: string) -> Result<bool> =>
        Result<bool>.Err(error.custom("crypto.unsupported", message));

    /// @brief The positive integer parameter, or -1 when it is missing or malformed.
    let integer = func(parsed: phc.PhcString, name: string) -> int => match (parsed.parameter(name)) {
        Optional.Some(text) => match (int32s.parse(text)) {
            Result.Ok(value) => value > 0 ? value : -1,
            Result.Err(e) => -1,
        },
        Optional.None => -1,
    };

    /// @brief Whether the password matches a PHC string of `argon2id` (version 19) or `scrypt`. A malformed
    /// string fails with a `Parse` error, and another function or out-of-range parameters with a Custom error
    /// of code "crypto.unsupported".
    #[NoDiscard, Since("0.3.0")]
    export let verify_password = func(password: uint8[list], encoded: string) -> Result<bool> {
        last parsed: phc.PhcString;
        match (phc.parse(encoded)) {
            Result.Ok(value) => {
                parsed = value;
            },
            Result.Err(e) => {
                return Result<bool>.Err(e);
            },
        }
        if (parsed.salt.length == 0 || parsed.hash.length == 0) {
            return unsupported("PHC string has no salt or hash");
        }
        if (parsed.algorithm == "argon2id") {
            last m = integer(parsed, "m");
            last t = integer(parsed, "t");
            last p = integer(parsed, "p");
            if (parsed.version != 19 || m < 0 || t < 0 || p < 0 || p > 16777215 || m < 8 * p || parsed.salt.length < 8
                    || parsed.hash.length < 4) {
                return unsupported("unsupported argon2id parameters");
            }
            last tag = argon2.argon2id(password, parsed.salt, new argon2.Argon2Params(m, t, p, parsed.hash.length));
            return Result<bool>.Ok(constant_time.ct_eq(tag, parsed.hash));
        }
        if (parsed.algorithm == "scrypt") {
            last ln = integer(parsed, "ln");
            last r = integer(parsed, "r");
            last p = integer(parsed, "p");
            if (ln < 1 || ln > 30 || r < 0 || p < 0 || (r as int64) * (p as int64) >= 1073741824
                    || (r as int64) * 128 * ((1 << ln) as int64) > 1073741824) {
                return unsupported("unsupported scrypt parameters");
            }
            last key = scrypt.derive(password, parsed.salt, 1 << ln, r, p, parsed.hash.length);
            return Result<bool>.Ok(constant_time.ct_eq(key, parsed.hash));
        }
        return unsupported("unsupported password hash: " + parsed.algorithm);
    };

    /// @brief Whether a stored hash should be recomputed with `wanted` at the next successful login: true when
    /// the string does not parse, is not Argon2id version 19, or has any parameter or hash length other than
    /// `wanted`'s.
    #[NoDiscard, Since("0.3.0")]
    export let needs_rehash = func(encoded: string, wanted: argon2.Argon2Params) -> bool => match (phc.parse(encoded)) {
        Result.Ok(parsed) => parsed.algorithm != "argon2id" || parsed.version != 19
            || integer(parsed, "m") != wanted.memory_kib || integer(parsed, "t") != wanted.iterations
            || integer(parsed, "p") != wanted.parallelism || parsed.hash.length != wanted.tag_length,
        Result.Err(e) => true,
    };
);
