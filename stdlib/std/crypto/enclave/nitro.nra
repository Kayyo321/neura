let.promote _ = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Result;
let.promote _ = import:Std.Core.Unit;
let.promote _ = import:Std.Crypto.Algorithm;
let certificate = import:Std.Crypto.Pki.Certificate;
let constant_time = import:Std.Crypto.Core.ConstantTime;
let crypto_policy = import:Std.Crypto.Core.CryptoPolicy;
let ecdsa = import:Std.Crypto.Asymmetric.Ecdsa;
let error = import:Std.Core.Error;
let extensions = import:Std.Crypto.Pki.Extensions;
let hashing = import:Std.Core.Hash;
let instant = import:Std.Time.Instant;
let path = import:Std.Crypto.Pki.PathValidation;
let public_keys = import:Std.Crypto.Pki.PublicKeyInfo;
let utf8 = import:Std.Encoding.Utf8;
let words = import:Std.Crypto.Internal.Words;

/// @brief Parses and verifies the AWS Nitro Enclaves COSE_Sign1 attestation document.
///
/// Verification uses a trust anchor provisioned by the caller and validates the certificate chain at an
/// explicit instant. The production verifier requires a fresh report, the expected nonce, and provisioned
/// PCR values. A signature-only check is available for inspecting historical or debug evidence.
/// This module handles ES384 reports with the AWS document fields and certificate bundle. It makes no host
/// requests during parsing or verification.
/// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
.Since("0.3.0")
export let Nitro = module (
    const MaxReportBytes = 32768;
    const MaxFieldBytes = 1024;
    const MaxBundleCount = 8;
    const DigestBytes = 48;

    let failure = func<T>(code: string, text: string) -> Result<T> => Result<T>.Err(error.custom(code, text));
    let malformed = func<T>(reason: string) -> Result<T> => failure<T>("crypto.malformed_nitro", reason);

    let zero = func(bytes: uint8[list]) -> bool => constant_time.ct_eq(bytes, words.zeros(bytes.length));
    let hash_bytes = func(bytes: uint8[list], seed: uint32) -> uint32 {
        let hash = seed;
        for (let b in bytes) {
            hash = hashing.combine(hash, b as uint32);
        }
        return hash;
    };

    let copy_optional = func(bytes: Optional<uint8[list]>) -> Optional<uint8[list]> => match (bytes) {
        Optional.None => Optional<uint8[list]>.None,
        Optional.Some(value) => Optional<uint8[list]>.Some(words.copy(value)),
    };

    /// @brief A numbered SHA-384 PCR measurement.
    /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
    .[Final, Since("0.3.0")]
    export let Measurement = class (
        /// @brief The PCR number from 0 to 31.
        /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
        .Since("0.3.0")
        export last index: int;
        last digest: uint8[list];

        /// @brief Copies a 48-byte measurement. A wrong index or length traps.
        /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
        .Since("0.3.0")
        export let init = func(register: int, bytes: uint8[list]) {
            if (register < 0 || register > 31 || bytes.length != DigestBytes) {
                trap_with_message("invalid argument: Nitro PCR needs an index from 0 to 31 and a 48-byte digest");
            }
            index = register;
            digest = words.copy(bytes);
        };

        /// @brief A copy of the SHA-384 value.
        /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
        .[NoDiscard, Since("0.3.0")]
        export let to_bytes = func -> uint8[list] => words.copy(digest);

        /// @brief Whether the PCR numbers and measurements match.
        /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
        .Since("0.3.0")
        export let.override equals = func(other: class) -> bool {
            if (other is not right: Measurement) {
                return false;
            }
            return index == right.index && constant_time.ct_eq(digest, right.to_bytes());
        };

        /// @brief A hash of the index and contents.
        /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
        .Since("0.3.0")
        export let.override hash_code = func -> uint32 => hash_bytes(digest, index as uint32);

        /// @brief The PCR index.
        /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
        .Since("0.3.0")
        export let.override to_string = func -> string => "Nitro.Measurement(" .. index.to_string() .. ")";
    );

    /// @brief The decoded, signed claims. Use verify to authenticate and check the caller's policy.
    /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
    .[Final, Since("0.3.0")]
    export let Document = class (
        /// @brief The issuing Nitro hypervisor module.
        /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
        .Since("0.3.0")
        export last module_id: string;
        /// @brief Signed issuance time in milliseconds after the Unix epoch.
        /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
        .Since("0.3.0")
        export last timestamp_millis: uint64;
        last registers: Measurement[list];
        last request_nonce: Optional<uint8[list]>;
        last enclave_data: Optional<uint8[list]>;
        last enclave_key: Optional<uint8[list]>;
        last signing_certificate: uint8[list];
        last encoded: uint8[list];

        /// @brief Records parsed evidence. Construction alone establishes no trust in the claims.
        /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
        .Since("0.3.0")
        export let init = func(module_name: string, timestamp: uint64, pcrs: Measurement[list],
            nonce_bytes, user_bytes, key_bytes: Optional<uint8[list]>, cert, report: uint8[list]) {
            module_id = module_name;
            timestamp_millis = timestamp;
            let copy: Measurement[list] = new;
            for (let measurement in pcrs) {
                copy.append(measurement);
            }
            registers = copy;
            request_nonce = copy_optional(nonce_bytes);
            enclave_data = copy_optional(user_bytes);
            enclave_key = copy_optional(key_bytes);
            signing_certificate = words.copy(cert);
            encoded = words.copy(report);
        };

        /// @brief A PCR by index when the report includes it.
        /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
        .[NoDiscard, Since("0.3.0")]
        export let pcr = func(index: int) -> Optional<Measurement> {
            for (let measurement in registers) {
                if (measurement.index == index) {
                    return Optional<Measurement>.Some(measurement);
                }
            }
            return Optional<Measurement>.None;
        };

        /// @brief A copy of the register list.
        /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
        .[NoDiscard, Since("0.3.0")]
        export let pcrs = func -> Measurement[list] {
            let copy: Measurement[list] = new;
            for (let measurement in registers) {
                copy.append(measurement);
            }
            return copy;
        };

        /// @brief A copy of the optional challenge nonce.
        /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
        .[NoDiscard, Since("0.3.0")]
        export let nonce = func -> Optional<uint8[list]> => copy_optional(request_nonce);

        /// @brief A copy of optional signed application data.
        /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
        .[NoDiscard, Since("0.3.0")]
        export let user_data = func -> Optional<uint8[list]> => copy_optional(enclave_data);

        /// @brief A copy of the optional application public key.
        /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
        .[NoDiscard, Since("0.3.0")]
        export let public_key = func -> Optional<uint8[list]> => copy_optional(enclave_key);

        /// @brief A copy of the infrastructure signing certificate in DER.
        /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
        .[NoDiscard, Since("0.3.0")]
        export let certificate_der = func -> uint8[list] => words.copy(signing_certificate);

        /// @brief A copy of the original encoded report.
        /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
        .[NoDiscard, Since("0.3.0")]
        export let to_bytes = func -> uint8[list] => words.copy(encoded);

        /// @brief Whether the encodings match.
        /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
        .Since("0.3.0")
        export let.override equals = func(other: class) -> bool {
            if (other is not that: Document) {
                return false;
            }
            return constant_time.ct_eq(encoded, that.to_bytes());
        };

        /// @brief A hash of the original encoding.
        /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
        .Since("0.3.0")
        export let.override hash_code = func -> uint32 => hash_bytes(encoded, 384);

        /// @brief A fixed name for the decoded evidence.
        /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
        .Since("0.3.0")
        export let.override to_string = func -> string => "Nitro.Document";
    );

    // A bounded cursor for the definite-length CBOR types in the AWS document.
    let Reader = class (
        last data: uint8[list];
        let position: int = 0;

        export let init = func(bytes: uint8[list]) {
            data = bytes;
        };

        export let peek = func -> int => position < data.length ? data[position] as int : -1;

        export let take_marker = func(marker: int) -> bool {
            if (peek() != marker) {
                return false;
            }
            position++;
            return true;
        };

        export let read_arg = func(major: int) -> Result<uint64> {
            last head = peek();
            if (head < 0 || (head >> 5) != major) {
                return malformed<uint64>("unexpected Nitro CBOR type or end of data");
            }
            position++;
            last additional = head & 31;
            if (additional < 24) {
                return Result<uint64>.Ok(additional as uint64);
            }
            if (additional > 27) {
                return malformed<uint64>("invalid or indefinite Nitro CBOR argument");
            }
            last width = 1 << (additional - 24);
            if (width > data.length - position) {
                return malformed<uint64>("truncated Nitro CBOR argument");
            }
            let value: uint64 = 0;
            for (let i = 0; i < width; i++) {
                value = (value << 8) | (data[position + i] as uint64);
            }
            position += width;
            if ((width == 1 && value < 24) || (width == 2 && value <= 255)
                || (width == 4 && value <= 65535) || (width == 8 && value <= 4294967295)) {
                return malformed<uint64>("non-minimal Nitro CBOR argument");
            }
            return Result<uint64>.Ok(value);
        };

        export let count = func(major: int, maximum: int) -> Result<int> {
            last value = read_arg(major)?;
            if (value > (maximum as uint64)) {
                return malformed<int>("Nitro CBOR item exceeds its size bound");
            }
            return Result<int>.Ok(value as int);
        };

        export let blob = func(major: int, maximum: int) -> Result<uint8[list]> {
            last length = count(major, maximum)?;
            if (length > data.length - position) {
                return malformed<uint8[list]>("truncated Nitro CBOR string");
            }
            last bytes = words.slice(data, position, position + length);
            position += length;
            return Result<uint8[list]>.Ok(bytes);
        };

        export let text = func(maximum: int) -> Result<string> {
            last encoded = blob(3, maximum)?;
            return match (utf8.decode(encoded)) {
                Result.Ok(value) => Result<string>.Ok(value),
                Result.Err(_) => malformed<string>("Nitro CBOR text is not UTF-8"),
            };
        };

        export let optional_bytes = func -> Result<Optional<uint8[list]>> {
            if (peek() == 246) {
                position++;
                return Result<Optional<uint8[list]>>.Ok(Optional<uint8[list]>.None);
            }
            last bytes = blob(2, MaxFieldBytes)?;
            return Result<Optional<uint8[list]>>.Ok(Optional<uint8[list]>.Some(bytes));
        };

        export let finish = func -> Result<Unit> => position == data.length ? Result<Unit>.Ok(Unit.Value)
            : malformed<Unit>("trailing Nitro CBOR data");

        export let.override to_string = func -> string => "Nitro.Reader";
    );

    let SignedReport = class (
        export last document: Document;
        export last bundle: uint8[list][list];
        export last protected: uint8[list];
        export last payload: uint8[list];
        export last signature: uint8[list];

        export let init = func(claims: Document, ca: uint8[list][list], header, signed, sig: uint8[list]) {
            document = claims;
            bundle = ca;
            protected = header;
            payload = signed;
            signature = sig;
        };

        export let.override to_string = func -> string => "Nitro.SignedReport";
    );

    let Payload = class (
        export let module_id: string = "";
        export let sha384: bool = false;
        export let timestamp: uint64 = 0;
        export let pcrs: Measurement[list] = new;
        export let cert: uint8[list] = new;
        export let bundle: uint8[list][list] = new;
        export let nonce: Optional<uint8[list]> = Optional<uint8[list]>.None;
        export let user_data: Optional<uint8[list]> = Optional<uint8[list]>.None;
        export let key: Optional<uint8[list]> = Optional<uint8[list]>.None;

        export let.override to_string = func -> string => "Nitro.Payload";
    );

    let read_pcrs = func(reader: Reader) -> Result<Measurement[list]> {
        last count = reader.count(5, 32)?;
        let values: Measurement[list] = new;
        let seen: uint32 = 0;
        for (let i = 0; i < count; i++) {
            last register = reader.count(0, 31)?;
            last mask = (1 as uint32) << register;
            if ((seen & mask) != 0) {
                return malformed<Measurement[list]>("duplicate Nitro PCR");
            }
            seen = seen | mask;
            last bytes = reader.blob(2, DigestBytes)?;
            if (bytes.length != DigestBytes) {
                return malformed<Measurement[list]>("Nitro SHA384 PCR must have 48 bytes");
            }
            values.append(new Measurement(register, bytes));
        }
        return Result<Measurement[list]>.Ok(values);
    };

    let read_bundle = func(reader: Reader) -> Result<uint8[list][list]> {
        last count = reader.count(4, MaxBundleCount)?;
        let certs: uint8[list][list] = new;
        for (let i = 0; i < count; i++) {
            last bytes = reader.blob(2, MaxFieldBytes)?;
            if (bytes.length == 0) {
                return malformed<uint8[list][list]>("empty Nitro CA certificate");
            }
            certs.append(bytes);
        }
        return Result<uint8[list][list]>.Ok(certs);
    };

    let read_payload = func(bytes: uint8[list]) -> Result<Payload> {
        let reader = new Reader(bytes);
        // AWS emits a break-terminated map when it cannot know all claims before writing the payload.
        last indefinite = reader.take_marker(191);
        last count = indefinite ? 9 : reader.count(5, 9)?;
        let payload = new Payload();
        let names: string[list] = new;
        for (let i = 0; i < count; i++) {
            if (indefinite && reader.peek() == 255) {
                break;
            }
            last name = reader.text(16)?;
            for (let previous in names) {
                if (name == previous) {
                    return malformed<Payload>("duplicate Nitro claim");
                }
            }
            names.append(name);
            if (name == "module_id") {
                payload.module_id = reader.text(MaxFieldBytes)?;
            } else if (name == "digest") {
                payload.sha384 = reader.text(8)? == "SHA384";
            } else if (name == "timestamp") {
                payload.timestamp = reader.read_arg(0)?;
            } else if (name == "pcrs") {
                payload.pcrs = read_pcrs(reader)?;
            } else if (name == "certificate") {
                payload.cert = reader.blob(2, MaxFieldBytes)?;
            } else if (name == "cabundle") {
                payload.bundle = read_bundle(reader)?;
            } else if (name == "nonce") {
                payload.nonce = reader.optional_bytes()?;
            } else if (name == "user_data") {
                payload.user_data = reader.optional_bytes()?;
            } else if (name == "public_key") {
                payload.key = reader.optional_bytes()?;
            } else {
                return malformed<Payload>("unknown Nitro claim");
            }
        }
        if (indefinite && not reader.take_marker(255)) {
            return malformed<Payload>("Nitro break-terminated claim map exceeds nine entries or is truncated");
        }
        reader.finish()?;
        let bundle_present = false;
        for (let name in names) {
            if (name == "cabundle") {
                bundle_present = true;
            }
        }
        if (payload.module_id == "" || not payload.sha384 || payload.timestamp == 0 || payload.pcrs.length == 0
            || payload.cert.length == 0 || not bundle_present) {
            return malformed<Payload>("missing or unsupported required Nitro claim");
        }
        return Result<Payload>.Ok(payload);
    };

    let read_report = func(bytes: uint8[list]) -> Result<SignedReport> {
        if (bytes.length == 0 || bytes.length > MaxReportBytes) {
            return malformed<SignedReport>("a Nitro report needs 1 to 32768 bytes");
        }
        let reader = new Reader(bytes);
        if (reader.peek() == 210) {
            let _ = reader.read_arg(6)?;
        }
        if (reader.count(4, 4)? != 4) {
            return malformed<SignedReport>("Nitro COSE_Sign1 needs four elements");
        }
        last protected = reader.blob(2, 4)?;
        let es384: uint8[list] = new([161, 1, 56, 34]);
        if (not constant_time.ct_eq(protected, es384)) {
            return malformed<SignedReport>("Nitro protected header must specify ES384");
        }
        let _ = reader.count(5, 0)?;
        last body = reader.blob(2, MaxReportBytes)?;
        last signature = reader.blob(2, 96)?;
        if (signature.length != 96) {
            return malformed<SignedReport>("Nitro ES384 signature must have 96 bytes");
        }
        reader.finish()?;
        last claims = read_payload(body)?;
        last document = new Document(claims.module_id, claims.timestamp, claims.pcrs, claims.nonce, claims.user_data,
            claims.key, claims.cert, bytes);
        return Result<SignedReport>.Ok(new SignedReport(document, claims.bundle, protected, body, signature));
    };

    /// @brief Parses a Nitro report without authenticating its claims. Accepts the optional COSE tag 18,
    /// accepts a bounded break-terminated claim map, and caps the report at 32 KiB, CA bundle at eight
    /// certificates, and
    /// individual DER and optional binary fields at 1024 bytes. Unrecognized or repeated claims fail.
    /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
    .[NoDiscard, Since("0.3.0")]
    export let parse = func(report: uint8[list]) -> Result<Document> => Result<Document>.Ok((read_report(report)?).document);

    let append_cbor_bytes = func(out: uint8[list], bytes: uint8[list]) {
        last size = bytes.length;
        if (size < 24) {
            out.append((64 + size) as uint8);
        } else if (size <= 255) {
            out.append(88);
            out.append(size as uint8);
        } else {
            out.append(89);
            out.append((size >> 8) as uint8);
            out.append((size & 255) as uint8);
        }
        words.append_all(out, bytes);
    };

    let signature_structure = func(report: SignedReport) -> uint8[list] {
        // RFC 9052 Sig_structure: [ "Signature1", body_protected, external_aad, payload ].
        let bytes: uint8[list] = new([132, 106]);
        words.append_all(bytes, words.utf8("Signature1"));
        append_cbor_bytes(bytes, report.protected);
        bytes.append(64);
        append_cbor_bytes(bytes, report.payload);
        return bytes;
    };

    let require_key_usage = func(cert: certificate.Certificate, bit: int) -> Result<Unit> {
        return match (cert.key_usage) {
            Optional.Some(usage) if usage.has(bit) => Result<Unit>.Ok(Unit.Value),
            _ => failure<Unit>("crypto.attestation_certificate", "Nitro certificate has incorrect key usage"),
        };
    };

    /// @brief Checks the Nitro COSE ES384 signature and the X.509 path at the explicit instant. The trusted
    /// root DER must be provisioned independently by the caller. Use verify for freshness and policy checks.
    /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
    .[NoDiscard, Since("0.3.0")]
    export let verify_signed = func(report: uint8[list], trusted_root_der: uint8[list], at: instant.Instant)
        -> Result<Document> {
        if (at.nanos < 0 || at.nanos >= 1000000000) {
            trap_with_message("invalid argument: Nitro verification needs a normalized instant");
        }
        last signed = read_report(report)?;
        last root = certificate.parse(trusted_root_der)?;
        last leaf = certificate.parse(signed.document.certificate_der())?;
        if (leaf.is_ca()) {
            return failure<Document>("crypto.attestation_certificate", "Nitro report signing certificate is a CA");
        }
        require_key_usage(leaf, extensions.DigitalSignature)?;
        let intermediates: certificate.Certificate[list] = new;
        for (let bytes in signed.bundle) {
            if (not constant_time.ct_eq(trusted_root_der, bytes)) {
                intermediates.append(certificate.parse(bytes)?);
            }
        }
        let options = new path.ValidationOptions(at);
        // Real AWS leaf certificates omit the authority key identifier. The older fixture also lacks
        // both key identifiers on the final intermediate. The signed path and usage checks still apply.
        options.strict_profile = false;
        last chain = (path.validate(leaf, intermediates, new([root]), options)?).chain;
        for (let i = 1; i < chain.length; i++) {
            require_key_usage(chain[i], extensions.KeyCertSign)?;
        }
        if (not crypto_policy.allows(Algorithm.P384) || not crypto_policy.allows(Algorithm.Sha384)) {
            return failure<Document>("crypto.attestation_policy", "Nitro ES384 is denied by the crypto policy");
        }
        if (leaf.public_key.key_algorithm != public_keys.KeyAlgorithm.Ec || leaf.public_key.parameter_set != "P-384") {
            return failure<Document>("crypto.attestation_signature", "Nitro signing key is not P-384");
        }
        last key = ecdsa.parse_public_key(ecdsa.Curve.P384, leaf.public_key.key)?;
        last verifier = new ecdsa.EcdsaVerifier(key, Algorithm.Sha384);
        if (not verifier.verify_raw(signature_structure(signed), signed.signature)) {
            return failure<Document>("crypto.attestation_signature", "invalid Nitro COSE signature");
        }
        return Result<Document>.Ok(signed.document);
    };

    let fresh = func(timestamp_millis: uint64, at: instant.Instant, max_age_millis: int64) -> bool {
        last issued_seconds = (timestamp_millis / 1000) as int64;
        if (at.epoch_seconds < issued_seconds) {
            return false;
        }
        let elapsed_seconds = at.epoch_seconds - issued_seconds;
        let elapsed_nanos = at.nanos - ((timestamp_millis % 1000) as int) * 1000000;
        if (elapsed_nanos < 0) {
            elapsed_seconds--;
            elapsed_nanos += 1000000000;
        }
        if (elapsed_seconds < 0 || elapsed_seconds > max_age_millis / 1000) {
            return false;
        }
        return elapsed_seconds != max_age_millis / 1000 || elapsed_nanos <= ((max_age_millis % 1000) as int) * 1000000;
    };

    let check_policy_arguments = func(expected_nonce: uint8[list], expected: Measurement[list], max_age_millis: int64) {
        if (expected_nonce.length == 0 || expected_nonce.length > MaxFieldBytes || expected.length == 0
            || expected.length > 32 || max_age_millis < 0) {
            trap_with_message("invalid argument: Nitro requires a nonce, provisioned PCRs, and a nonnegative maximum age");
        }
        let seen: uint32 = 0;
        let present = false;
        for (let measurement in expected) {
            last mask = (1 as uint32) << measurement.index;
            if ((seen & mask) != 0) {
                trap_with_message("invalid argument: duplicate expected Nitro PCR");
            }
            seen = seen | mask;
            present = present || not zero(measurement.to_bytes());
        }
        if (not present) {
            trap_with_message("invalid argument: expected Nitro PCR policy must include a nonzero measurement");
        }
    };

    let valid_boot = func(document: Document) -> bool {
        for (let index in 0 .. 3) {
            match (document.pcr(index)) {
                Optional.None => {
                    return false;
                },
                Optional.Some(measurement) => {
                    if (zero(measurement.to_bytes())) {
                        return false;
                    }
                },
            }
        }
        return true;
    };

    /// @brief Verifies the chain, signature, freshness, expected nonce, and every provisioned PCR. The maximum
    /// age is in milliseconds. Future timestamps, missing or zero PCR0/1/2 (debug evidence), and a nonce or PCR
    /// mismatch fail. The expected nonce comes from a fresh verifier challenge. A missing policy input,
    /// duplicate expected index, or all-zero PCR policy traps.
    /// Comparisons of nonce and measurement bytes are branch-free in source. The runtime does not guarantee
    /// constant time.
    /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
    .[NoDiscard, Since("0.3.0")]
    export let verify = func(report: uint8[list], trusted_root_der: uint8[list], at: instant.Instant,
        expected_nonce: uint8[list], expected_pcrs: Measurement[list], max_age_millis: int64) -> Result<Document> {
        check_policy_arguments(expected_nonce, expected_pcrs, max_age_millis);
        last document = verify_signed(report, trusted_root_der, at)?;
        if (not fresh(document.timestamp_millis, at, max_age_millis)) {
            return failure<Document>("crypto.attestation_time", "Nitro report has a future or stale timestamp");
        }
        if (not valid_boot(document)) {
            return failure<Document>("crypto.attestation_measurement", "Nitro report is missing boot measurements or is debug evidence");
        }
        match (document.nonce()) {
            Optional.Some(bytes) => {
                if (not constant_time.ct_eq(bytes, expected_nonce)) {
                    return failure<Document>("crypto.attestation_nonce", "Nitro nonce does not match");
                }
            },
            Optional.None => {
                return failure<Document>("crypto.attestation_nonce", "Nitro report has no nonce");
            },
        }
        for (let expected in expected_pcrs) {
            match (document.pcr(expected.index)) {
                Optional.Some(actual) => {
                    if (not actual.equals(expected)) {
                        return failure<Document>("crypto.attestation_measurement", "Nitro PCR does not match");
                    }
                },
                Optional.None => {
                    return failure<Document>("crypto.attestation_measurement", "Nitro report lacks a required PCR");
                },
            }
        }
        return Result<Document>.Ok(document);
    };

    /// @brief Requests a report from the Nitro Secure Module.
    /// @stub the runtime has no Nitro Secure Module attestation host operation
    /// @see [Std.Crypto.Enclave.Nitro](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Nitro)
    .[NoDiscard, Since("0.3.0")]
    export let request_attestation = func(nonce, user_data, public_key: uint8[list]) -> Result<uint8[list]> {
        return Result<uint8[list]>.Err(error.Error.Io {
            kind: error.IoErrorKind.Unsupported, message: "the runtime has no Nitro Secure Module attestation host operation", path: "",
        });
    };
);
