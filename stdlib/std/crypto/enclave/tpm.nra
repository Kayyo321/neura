let.promote _ = import:Std.Core.Result;
let error = import:Std.Core.Error;
let versioned = import:Std.Crypto.Enclave.VersionedKeyStore;

/// @brief A TPM 2.0-backed key store provider.
/// @see [Std.Crypto.Enclave.Tpm](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Tpm)
.Since("0.3.0")
export let Tpm = module (
    /// @brief An opaque versioned key store for this backend. String handles have meaning only to their provider.
    /// @see [Std.Crypto.Enclave.Tpm](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Tpm)
    .Since("0.3.0")
    export let Provider = interface:versioned.VersionedKeyStore<string> ();

    /// @brief Opens this configured provider.
    /// @stub the runtime has no TPM command host service
    /// @see [Std.Crypto.Enclave.Tpm](https://github.com/Kayyo321/neura/wiki/Stdlib-Crypto-Enclave-Tpm)
    .[NoDiscard, Since("0.3.0")]
    export let open = func(device_path: string) -> Result<Provider> {
        return Result<Provider>.Err(error.Error.Io {
            kind: error.IoErrorKind.Unsupported, message: "the runtime has no TPM command host service", path: "",
        });
    };
);
