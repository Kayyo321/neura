let.promote _ = import:Std.Core.Comparable;
let optional = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Ordering;

/// @brief A file system path held as normalized text (Stdlib.md section 11.2).
///
/// The separator is `/` on every host. Construction collapses repeated separators, removes `.` components, and
/// removes a trailing separator except for the root; an empty result is `.`. `..` components are kept.
/// Equality, hash, ordering (by UTF-8 bytes), and text use the normalized text.
/// @see [Std.Fs.Path](https://github.com/Kayyo321/neura/wiki/Stdlib-Fs-Path)
export let Path = module (
    /// @brief An immutable normalized path with lexical operations independent of the filesystem.
    export let Path = class implements Comparable<Path> (
        /// @brief The normalized slash-separated path text.
        let text: string = ".";

        /// @brief Normalizes `raw`; Path.of is the usual spelling.
        export let init = func(raw: string) {
            text = normalize(raw);
        };

        /// @brief Reports whether the path starts at the root.
        export let is_absolute = func -> bool => absolute_text(text);

        /// @brief This path followed by `other`; an absolute `other` replaces it.
        export let join = func(other: string) -> Path =>
            absolute_text(other) ? new Path(other) : new Path(text + "/" + other);

        /// @brief The path without its last component, or nil for the root, `.`, and a single relative
        /// component.
        export let parent = func -> Path {
            let parts = split(text);
            if (parts.length == 0) {
                return nil;
            }
            if (parts.length == 1 && !is_absolute()) {
                return nil;
            }
            parts.remove_at(parts.length - 1);
            return new Path(assemble(is_absolute(), parts));
        };

        /// @brief The last component; None for the root, `.`, and a path ending in `..`.
        export let file_name = func -> optional.Optional<string> {
            let parts = split(text);
            if (parts.length == 0 || parts[parts.length - 1] == "..") {
                return optional.Optional<string>.None;
            }
            return optional.Optional<string>.Some(parts[parts.length - 1]);
        };

        /// @brief The file name without its extension.
        export let stem = func -> optional.Optional<string> {
            return match (file_name()) {
                optional.Optional.Some(name) => optional.Optional<string>.Some(name.slice(0, stem_end(name))),
                optional.Optional.None => optional.Optional<string>.None,
            };
        };

        /// @brief The text after the last `.` of the file name, when that dot is not the name's first
        /// character.
        export let extension = func -> optional.Optional<string> {
            match (file_name()) {
                optional.Optional.Some(name) => {
                    let end = stem_end(name);
                    if (end == name.byte_length) {
                        return optional.Optional<string>.None;
                    }
                    return optional.Optional<string>.Some(name.slice(end + 1, name.byte_length));
                },
                optional.Optional.None => {
                    return optional.Optional<string>.None;
                },
            }
        };

        /// @brief The components in order, starting with "/" for an absolute path. The path `.` has none.
        export let components = func -> string[list] {
            let parts = split(text);
            if (!is_absolute()) {
                return parts;
            }
            let all: string[list] = ["/"];
            for (let part in parts) {
                all.append(part);
            }
            return all;
        };

        /// @brief Removes each `..` together with the component before it, without consulting the file system.
        /// `..` directly below the root is removed; leading `..` of a relative path are kept.
        export let resolve_lexically = func -> Path {
            let kept: string[list] = [];
            for (let part in split(text)) {
                if (part == "..") {
                    if (kept.length > 0 && kept[kept.length - 1] != "..") {
                        kept.remove_at(kept.length - 1);
                    } else if (!is_absolute()) {
                        kept.append(part);
                    }
                } else {
                    kept.append(part);
                }
            }
            return new Path(assemble(is_absolute(), kept));
        };

        /// @brief True when both paths are absolute or both relative and every component of `other` begins this
        /// path.
        export let starts_with = func(other: Path) -> bool {
            if (is_absolute() != other.is_absolute()) {
                return false;
            }
            let mine = split(text);
            let theirs = split(other.to_string());
            if (theirs.length > mine.length) {
                return false;
            }
            let i = 0;
            while (i < theirs.length) {
                if (mine[i] != theirs[i]) {
                    return false;
                }
                i++;
            }
            return true;
        };

        /// @brief A relative path that joined to `base` names this path, or nil when one is absolute and the
        /// other relative or when `base` has a `..` component after the common part.
        export let relative_to = func(base: Path) -> Path {
            if (is_absolute() != base.is_absolute()) {
                return nil;
            }
            let mine = split(text);
            let theirs = split(base.to_string());
            let common = 0;
            while (common < mine.length && common < theirs.length && mine[common] == theirs[common]) {
                common++;
            }
            let parts: string[list] = [];
            let i = common;
            while (i < theirs.length) {
                if (theirs[i] == "..") {
                    return nil;
                }
                parts.append("..");
                i++;
            }
            i = common;
            while (i < mine.length) {
                parts.append(mine[i]);
                i++;
            }
            return new Path(assemble(false, parts));
        };

        /// @brief Orders paths lexicographically by their normalized UTF-8 bytes.
        export let compare_to = func(other: Path) -> Ordering => compare_text(text, other.to_string());

        /// @brief Tests equality of the normalized path text.
        export let.override equals = func(other: class) -> bool {
            if (!(other is Path)) {
                return false;
            }
            return text == (other as Path).to_string();
        };

        /// @brief Hashes the normalized path text.
        export let.override hash_code = func -> uint32 => text.hash_code();

        /// @brief Returns the normalized path text.
        export let.override to_string = func -> string => text;
    );

    /// @brief Constructs a path and normalizes its separators and dot components.
    export let of = func(text: string) -> Path => new Path(text);

    /// @brief Tests whether the raw text begins with a slash.
    let absolute_text = func(text: string) -> bool => text.byte_length > 0 && text.byte_at(0) == 47;

    /// @brief The components of `text` other than empty ones and `.`.
    let split = func(text: string) -> string[list] {
        let parts: string[list] = [];
        let start = 0;
        let i = 0;
        let count = text.byte_length;
        while (i <= count) {
            if (i == count || text.byte_at(i) == 47) {
                if (i > start) {
                    let part = text.slice(start, i);
                    if (part != ".") {
                        parts.append(part);
                    }
                }
                start = i + 1;
            }
            i++;
        }
        return parts;
    };

    /// @brief Joins components with single separators and represents an empty path as root or dot.
    let assemble = func(absolute: bool, parts: string[list]) -> string {
        if (parts.length == 0) {
            return absolute ? "/" : ".";
        }
        let result = absolute ? "/" : "";
        let i = 0;
        while (i < parts.length) {
            if (i > 0) {
                result += "/";
            }
            result += parts[i];
            i++;
        }
        return result;
    };

    /// @brief Normalizes separators and removes empty and dot components while retaining parent components.
    let normalize = func(raw: string) -> string => assemble(absolute_text(raw), split(raw));

    /// @brief The byte index of the dot that starts the extension, or the name's length when there is none.
    let stem_end = func(name: string) -> int {
        let i = name.byte_length - 1;
        while (i > 0) {
            if (name.byte_at(i) == 46) {
                return i;
            }
            i--;
        }
        return name.byte_length;
    };

    /// @brief Orders two UTF-8 strings lexicographically by their bytes.
    let compare_text = func(a: string, b: string) -> Ordering {
        let i = 0;
        while (i < a.byte_length && i < b.byte_length) {
            let x = a.byte_at(i);
            let y = b.byte_at(i);
            if (x < y) {
                return Ordering.Less;
            }
            if (x > y) {
                return Ordering.Greater;
            }
            i++;
        }
        if (a.byte_length < b.byte_length) {
            return Ordering.Less;
        }
        if (a.byte_length > b.byte_length) {
            return Ordering.Greater;
        }
        return Ordering.Equal;
    };
);
