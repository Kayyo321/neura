let bytes = import:Std.Io.Internal.Bytes;
let.promote _ = import:Std.Io.Closeable;
let.promote _ = import:Std.Fs.Internal.FileHandle;
let host_error = import:Std.Core.Internal.HostError;
let.promote _ = import:Std.Fs.Path;
let result = import:Std.Core.Result;
let.promote _ = import:Std.Core.Unit;

/// @brief An open file (Stdlib.md section 11.2), unbuffered.
///
/// Its bound read method is a byte source and its bound write method a byte sink. Needs the fs capability.
/// After close every operation except close fails with Closed.
/// @see [Std.Fs.File](https://github.com/Kayyo321/neura/wiki/Stdlib-Fs-File)
#Since("0.1.0")
export let File = module (
    /// @brief Read: must exist. Write: create or truncate. Append: create, and write at the end. ReadWrite:
    /// must exist. CreateNew: read and write a new file; fails with AlreadyExists.
    export let OpenMode = enum (Read, Write, Append, ReadWrite, CreateNew);
    /// @brief Selects the start, current position, or end as the reference point for seeking.
    export let SeekOrigin = enum (Start, Current, End);

    /// @brief Represents a host success with an identifier or position, or an unsigned host error code.
    let IdOutcome = enum (Ok(int64), Error(uint32));
    /// @brief Represents returned bytes or an unsigned host error code.
    let BytesOutcome = enum (Ok(uint8[list]), Error(uint32));
    /// @brief Represents a host byte count or an unsigned host error code.
    let CountOutcome = enum (Ok(int), Error(uint32));
    /// @brief Represents host success without a value or an unsigned host error code.
    let DoneOutcome = enum (Ok, Error(uint32));
    /// @brief Opens a provider file using the numeric code for the requested mode.
    let open_file = func(path: string, mode: int) -> IdOutcome host("neura.fs.open", 1);
    /// @brief Requests up to the specified number of bytes from the provider.
    let read_file = func(file: int64, max: int) -> BytesOutcome host("neura.fs.read", 1);
    /// @brief Requests a provider write and receives the byte count, which may be partial.
    let write_file = func(file: int64, data: uint8[list]) -> CountOutcome host("neura.fs.write", 1);
    /// @brief Requests a position change and receives the new absolute position.
    let seek_file = func(file: int64, offset: int64, origin: int) -> IdOutcome host("neura.fs.seek", 1);
    /// @brief Requests that the provider release the open file.
    let close_file = func(file: int64) -> DoneOutcome host("neura.fs.close", 1);

    /// @brief An unbuffered host file with an explicit, idempotent close operation.
    #[Final, NoDiscard(reason: "an open file must be closed"), NotThreadSafe]
    export let File = class implements Closeable (
        /// @brief Holds the provider handle and the context used in error messages.
        last handle: FileHandle;
        /// @brief Tracks whether the wrapper may still use the host handle.
        let open_now: bool = true;

        /// @brief Use File.open; the handle comes from the library.
        export let init = func(opened: FileHandle) {
            handle = opened;
        };

        /// @brief Up to `max` bytes from the current position; an empty list at the end of the file. A maximum
        /// below 1 traps.
        #NoDiscard
        export let read = func(max: int) -> result.Result<uint8[list]> {
            bytes.check_maximum(max);
            if (!open_now) {
                return result.Result<uint8[list]>.Err(bytes.closed("file", handle.path));
            }
            return match (read_file(handle.id, max)) {
                BytesOutcome.Ok(chunk) => result.Result<uint8[list]>.Ok(chunk),
                BytesOutcome.Error(code) => result.Result<uint8[list]>.Err(host_error.io(code, "file read failed", handle.path)),
            };
        };

        /// @brief Writes every byte, repeating partial host writes.
        #NoDiscard
        export let write = func(data: uint8[list]) -> result.Result<Unit> {
            if (!open_now) {
                return result.Result<Unit>.Err(bytes.closed("file", handle.path));
            }
            let remaining = data;
            while (remaining.length > 0) {
                match (write_file(handle.id, remaining)) {
                    CountOutcome.Ok(count) => {
                        if (count <= 0) {
                            return result.Result<Unit>.Err(bytes.no_progress("file write failed", handle.path));
                        }
                        if (count >= remaining.length) {
                            return bytes.ok();
                        }
                        remaining = bytes.copy_range(remaining, count, remaining.length);
                    },
                    CountOutcome.Error(code) => {
                        return result.Result<Unit>.Err(host_error.io(code, "file write failed", handle.path));
                    },
                }
            }
            return bytes.ok();
        };

        /// @brief Moves the position and returns it, counted from the start.
        #NoDiscard
        export let seek = func(offset: int64, origin: SeekOrigin) -> result.Result<int64> {
            if (!open_now) {
                return result.Result<int64>.Err(bytes.closed("file", handle.path));
            }
            return match (seek_file(handle.id, offset, origin as int)) {
                IdOutcome.Ok(position) => result.Result<int64>.Ok(position),
                IdOutcome.Error(code) => result.Result<int64>.Err(host_error.io(code, "file seek failed", handle.path)),
            };
        };

        /// @brief The file's size in bytes. The position is unchanged.
        #NoDiscard
        export let size = func -> result.Result<int64> {
            last here: int64;
            match (seek(0, SeekOrigin.Current)) {
                result.Result.Ok(position) => {
                    here = position;
                },
                result.Result.Err(failure) => {
                    return result.Result<int64>.Err(failure);
                },
            }
            last end: int64;
            match (seek(0, SeekOrigin.End)) {
                result.Result.Ok(position) => {
                    end = position;
                },
                result.Result.Err(failure) => {
                    return result.Result<int64>.Err(failure);
                },
            }
            return match (seek(here, SeekOrigin.Start)) {
                result.Result.Ok(_) => result.Result<int64>.Ok(end),
                result.Result.Err(failure) => result.Result<int64>.Err(failure),
            };
        };

        /// @brief Releases the file. Closing again does nothing and returns Ok; the file is closed even when
        /// the host reports an error.
        export let close = func -> result.Result<Unit> {
            if (!open_now) {
                return bytes.ok();
            }
            open_now = false;
            return match (close_file(handle.id)) {
                DoneOutcome.Ok => bytes.ok(),
                DoneOutcome.Error(code) => result.Result<Unit>.Err(host_error.io(code, "file close failed", handle.path)),
            };
        };
    );

    /// @brief Opens the normalized path using the selected mode and returns an owned file.
    #NoDiscard
    export let open = func(path: Path, mode: OpenMode) -> result.Result<File> {
        last text = path.to_string();
        return match (open_file(text, mode as int)) {
            IdOutcome.Ok(id) => result.Result<File>.Ok(new File(new FileHandle(id, text))),
            IdOutcome.Error(code) => result.Result<File>.Err(host_error.io(code, "file open failed", text)),
        };
    };

    /// @brief Opens the file, runs `body` with it in a scope this helper owns, and closes it exactly once on
    /// every ordinary completion (Concurrency.md section 7, "Resources"). If the open fails, returns that error
    /// and does not call the body. Otherwise returns the body's result, with two exceptions for a failed close:
    /// a body Err becomes a Context error whose cause is the body's error and whose message carries the close
    /// error's message, and a body Ok becomes the close error (Std.Io.Closeable.release does the combining). The
    /// file is closed even if the body closed it already, which reports no error. A trap in the body ends the run without cleanup, and the runner then
    /// closes the files the run left open. Needs the fs capability.
    #NoDiscard
    export let with_open = func<T>(path: Path, mode: OpenMode,
            body: func(File) -> result.Result<T>) -> result.Result<T> {
        return match (open(path, mode)) {
            result.Result.Ok(file) => release<T>(file, run_body<T>(file, body)),
            result.Result.Err(failure) => result.Result<T>.Err(failure),
        };
    };

    // Runs the body in a scope the helper owns, so that whatever the body or the helper started inside it has
    // finished before the file is closed.
    let run_body = func<T>(file: File, body: func(File) -> result.Result<T>) -> result.Result<T> {
        scope {
            return body(file);
        }
    };
);
