let bytes = import:Std.Io.Internal.Bytes;
let.promote _ = import:Std.Io.Closeable;
let.promote _ = import:Std.Fs.Internal.FileHandle;
let host_error = import:Std.Core.Internal.HostError;
let.promote _ = import:Std.Fs.Path;
let result = import:Std.Core.Result;
let.promote _ = import:Std.Core.Unit;

// An open file (Stdlib.md section 11.2), unbuffered. Its bound read method
// is a byte source and its bound write method a byte sink. Needs the fs
// capability. After close every operation except close fails with Closed.
export let File = module (
    // Read: must exist. Write: create or truncate. Append: create, and
    // write at the end. ReadWrite: must exist. CreateNew: read and write a
    // new file; fails with AlreadyExists.
    export let OpenMode = enum (Read, Write, Append, ReadWrite, CreateNew);
    export let SeekOrigin = enum (Start, Current, End);

    let IdOutcome = enum (Ok(int64), Error(uint32));
    let BytesOutcome = enum (Ok(uint8[list]), Error(uint32));
    let CountOutcome = enum (Ok(int), Error(uint32));
    let DoneOutcome = enum (Ok, Error(uint32));
    let open_file = func(path: string, mode: int) -> IdOutcome host("neura.fs.open", 1);
    let read_file = func(file: int64, max: int) -> BytesOutcome host("neura.fs.read", 1);
    let write_file = func(file: int64, data: uint8[list]) -> CountOutcome host("neura.fs.write", 1);
    let seek_file = func(file: int64, offset: int64, origin: int) -> IdOutcome host("neura.fs.seek", 1);
    let close_file = func(file: int64) -> DoneOutcome host("neura.fs.close", 1);

    export let File = class implements Closeable (
        let handle: FileHandle = nil;
        let open_now: bool = true;

        // Use File.open; the handle comes from the library.
        export let init = func(opened: FileHandle) {
            handle = opened;
        };

        // Up to `max` bytes from the current position; an empty list at the
        // end of the file. A maximum below 1 traps.
        export let read = func(max: int) -> result.Result<uint8[list]> {
            bytes.check_maximum(max);
            if (!open_now) {
                return result.Result<uint8[list]>.Err(bytes.closed("file", handle.path));
            }
            return match (read_file(handle.id, max)) {
                BytesOutcome.Ok(chunk) => result.Result<uint8[list]>.Ok(chunk),
                BytesOutcome.Error(code) => result.Result<uint8[list]>.Err(host_error.io(code, "file read failed", handle.path)),
            };
        };

        // Writes every byte, repeating partial host writes.
        export let write = func(data: uint8[list]) -> result.Result<Unit> {
            if (!open_now) {
                return result.Result<Unit>.Err(bytes.closed("file", handle.path));
            }
            let remaining = data;
            while (remaining.length > 0) {
                match (write_file(handle.id, remaining)) {
                    CountOutcome.Ok(count) => {
                        if (count <= 0) {
                            return result.Result<Unit>.Err(bytes.no_progress("file write failed", handle.path));
                        }
                        if (count >= remaining.length) {
                            return bytes.ok();
                        }
                        remaining = bytes.copy_range(remaining, count, remaining.length);
                    },
                    CountOutcome.Error(code) => {
                        return result.Result<Unit>.Err(host_error.io(code, "file write failed", handle.path));
                    },
                }
            }
            return bytes.ok();
        };

        // Moves the position and returns it, counted from the start.
        export let seek = func(offset: int64, origin: SeekOrigin) -> result.Result<int64> {
            if (!open_now) {
                return result.Result<int64>.Err(bytes.closed("file", handle.path));
            }
            return match (seek_file(handle.id, offset, origin as int)) {
                IdOutcome.Ok(position) => result.Result<int64>.Ok(position),
                IdOutcome.Error(code) => result.Result<int64>.Err(host_error.io(code, "file seek failed", handle.path)),
            };
        };

        // The file's size in bytes. The position is unchanged.
        export let size = func -> result.Result<int64> {
            let here: int64 = 0;
            match (seek(0, SeekOrigin.Current)) {
                result.Result.Ok(position) => {
                    here = position;
                },
                result.Result.Err(failure) => {
                    return result.Result<int64>.Err(failure);
                },
            }
            let end: int64 = 0;
            match (seek(0, SeekOrigin.End)) {
                result.Result.Ok(position) => {
                    end = position;
                },
                result.Result.Err(failure) => {
                    return result.Result<int64>.Err(failure);
                },
            }
            return match (seek(here, SeekOrigin.Start)) {
                result.Result.Ok(_) => result.Result<int64>.Ok(end),
                result.Result.Err(failure) => result.Result<int64>.Err(failure),
            };
        };

        // Releases the file. Closing again does nothing and returns Ok; the
        // file is closed even when the host reports an error.
        export let close = func -> result.Result<Unit> {
            if (!open_now) {
                return bytes.ok();
            }
            open_now = false;
            return match (close_file(handle.id)) {
                DoneOutcome.Ok => bytes.ok(),
                DoneOutcome.Error(code) => result.Result<Unit>.Err(host_error.io(code, "file close failed", handle.path)),
            };
        };
    );

    export let open = func(path: Path, mode: OpenMode) -> result.Result<File> {
        let text = path.to_string();
        return match (open_file(text, mode as int)) {
            IdOutcome.Ok(id) => result.Result<File>.Ok(new File(new FileHandle(id, text))),
            IdOutcome.Error(code) => result.Result<File>.Err(host_error.io(code, "file open failed", text)),
        };
    };
);
