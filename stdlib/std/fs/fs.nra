let bytes = import:Std.Io.Internal.Bytes;
let errors = import:Std.Core.Error;
let files = import:Std.Fs.File;
let hashing = import:Std.Core.Hash;
let host_error = import:Std.Core.Internal.HostError;
let instant = import:Std.Time.Instant;
let.promote _ = import:Std.Fs.Path;
let result = import:Std.Core.Result;
let.promote _ = import:Std.Core.Unit;

/// @brief File system operations (Stdlib.md section 11.2).
///
/// Every function needs the fs capability. Functions that open files close them on every path before returning,
/// including after a failure.
/// @see [Std.Fs.Fs](https://github.com/Kayyo321/neura/wiki/Stdlib-Fs-Fs)
#Since("0.1.0")
export let Fs = module (
    /// @brief Distinguishes regular files, directories, and other entries.
    export let FileKind = enum (File, Directory, Other);

    /// @brief What metadata reports about an entry. A link is followed; an entry that is neither a file nor a
    /// directory is of kind Other. The fields are read-only.
    #Final
    export let FileMetadata = class (
        /// @brief The classification reported by the filesystem provider.
        export last kind: FileKind;
        /// @brief The reported size in bytes.
        export last size: int64;
        /// @brief The last modification instant, or nil when unavailable.
        export last modified: instant.Instant;

        /// @brief Stores the entry's kind, size, and modification time.
        export let init = func(entry_kind: FileKind, byte_size: int64, modified_at: instant.Instant) {
            kind = entry_kind;
            size = byte_size;
            modified = modified_at;
        };

        /// @brief Tests equality of the kind, size, and modification time.
        export let.override equals = func(other: class) -> bool {
            if (!(other is FileMetadata)) {
                return false;
            }
            last metadata = other as FileMetadata;
            return kind == metadata.kind && size == metadata.size &&
                (modified == nil ? metadata.modified == nil : modified === metadata.modified);
        };

        /// @brief Combines the hashes of the kind, size, and modification time.
        export let.override hash_code = func -> uint32 =>
            hashing.combine(hashing.combine(kind.hash_code(), size.hash_code()),
                modified == nil ? 0 : modified.hash_code());

        /// @brief Formats the metadata as Kind(size, modified), with nil for an absent timestamp.
        export let.override to_string = func -> string =>
            kind.to_string() + "(" + size.to_string() + ", " +
                (modified == nil ? "nil" : modified.to_string()) + ")";
    );

    /// @brief Carries the provider's entry kind, byte size and timestamp fields, or an error code.
    let StatOutcome = enum (Ok([int, int64, int64, int]), Error(uint32));
    /// @brief Carries the provider's directory entry names or an error code.
    let NamesOutcome = enum (Ok(string[list]), Error(uint32));
    /// @brief Represents host success without a value or an unsigned host error code.
    let DoneOutcome = enum (Ok, Error(uint32));
    /// @brief Requests entry metadata, optionally resolving the final link.
    let stat_path = func(path: string, follow_links: bool) -> StatOutcome host("neura.fs.stat", 1);
    /// @brief Requests the provider's unsorted directory entry names.
    let list_names = func(path: string) -> NamesOutcome host("neura.fs.list", 1);
    /// @brief Requests creation of a single directory.
    let make_directory = func(path: string) -> DoneOutcome host("neura.fs.make_directory", 1);
    /// @brief Requests removal of a directory or a non-directory entry.
    let remove_path = func(path: string, directory: bool) -> DoneOutcome host("neura.fs.remove", 1);
    /// @brief Requests a rename or move between two paths.
    let rename_path = func(from: string, to: string) -> DoneOutcome host("neura.fs.rename", 1);

    /// @brief Bytes per read and write of copy_file and read_bytes.
    export const CopyBufferSize: int = 65536;

    /// @brief Reads all bytes from the path and closes the file before returning.
    #NoDiscard
    export let read_bytes = func(path: Path) -> result.Result<uint8[list]> {
        match (files.open(path, files.OpenMode.Read)) {
            result.Result.Ok(file) => {
                return read_open(file);
            },
            result.Result.Err(failure) => {
                return result.Result<uint8[list]>.Err(failure);
            },
        }
    };

    /// @brief The file's text; invalid UTF-8 fails with InvalidData.
    #NoDiscard
    export let read_text = func(path: Path) -> result.Result<string> {
        match (read_bytes(path)) {
            result.Result.Ok(data) => {
                let [valid, text] = string.from_utf8(data);
                if (!valid) {
                    return result.Result<string>.Err(bytes.invalid_utf8(path.to_string()));
                }
                return result.Result<string>.Ok(text);
            },
            result.Result.Err(failure) => {
                return result.Result<string>.Err(failure);
            },
        }
    };

    /// @brief Creates or truncates the file and writes the bytes.
    #NoDiscard
    export let write_bytes = func(path: Path, data: uint8[list]) -> result.Result<Unit> {
        return write_mode(path, data, files.OpenMode.Write);
    };

    /// @brief Creates or truncates the file and writes the UTF-8 bytes of the text.
    #NoDiscard
    export let write_text = func(path: Path, text: string) -> result.Result<Unit> {
        return write_mode(path, bytes.of_string(text), files.OpenMode.Write);
    };

    /// @brief Creates the file if needed and writes the text at its end.
    #NoDiscard
    export let append_text = func(path: Path, text: string) -> result.Result<Unit> {
        return write_mode(path, bytes.of_string(text), files.OpenMode.Append);
    };

    /// @brief Ok(false) for NotFound; other failures are errors. Follows links.
    #NoDiscard
    export let exists = func(path: Path) -> result.Result<bool> {
        return match (stat_path(path.to_string(), true)) {
            StatOutcome.Ok(_) => result.Result<bool>.Ok(true),
            StatOutcome.Error(code) => missing_or_error(code, path.to_string()),
        };
    };

    /// @brief The kind, size in bytes, and last modification time of an entry, following links.
    #NoDiscard
    export let metadata = func(path: Path) -> result.Result<FileMetadata> {
        return match (stat_path(path.to_string(), true)) {
            StatOutcome.Ok(status) => result.Result<FileMetadata>.Ok(metadata_of(status)),
            StatOutcome.Error(code) => result.Result<FileMetadata>.Err(host_error.io(code, "metadata failed", path.to_string())),
        };
    };

    /// @brief The directory's entries joined to `path`, sorted by name bytes.
    #NoDiscard
    export let list = func(path: Path) -> result.Result<Path[list]> {
        match (list_names(path.to_string())) {
            NamesOutcome.Ok(names) => {
                last entries: Path[list] = [];
                for (let name in names) {
                    entries.append(path.join(name));
                }
                return result.Result<Path[list]>.Ok(entries);
            },
            NamesOutcome.Error(code) => {
                return result.Result<Path[list]>.Err(host_error.io(code, "list directory failed", path.to_string()));
            },
        }
    };

    /// @brief Creates a single directory. Missing parents and an existing entry are reported as errors.
    #NoDiscard
    export let create_directory = func(path: Path) -> result.Result<Unit> {
        return done(make_directory(path.to_string()), "create directory failed", path.to_string());
    };

    /// @brief Creates the directory and any missing parents; succeeds when the directory already exists.
    #NoDiscard
    export let create_directories = func(path: Path) -> result.Result<Unit> {
        last text = path.to_string();
        match (make_directory(text)) {
            DoneOutcome.Ok => {
                return bytes.ok();
            },
            DoneOutcome.Error(code) => {
                if (code == 3) {
                    return existing_directory(text);
                }
                last parent = path.parent();
                if (code != 1 || parent == nil) {
                    return result.Result<Unit>.Err(host_error.io(code, "create directory failed", text));
                }
                match (create_directories(parent)) {
                    result.Result.Ok(_) => {},
                    result.Result.Err(failure) => {
                        return result.Result<Unit>.Err(failure);
                    },
                }
            },
        }
        return match (make_directory(text)) {
            DoneOutcome.Ok => bytes.ok(),
            DoneOutcome.Error(code) => retry_failed(code, text),
        };
    };

    /// @brief Removes a file or another entry that is not a directory, such as a link (the link, not its
    /// target).
    #NoDiscard
    export let remove_file = func(path: Path) -> result.Result<Unit> {
        return done(remove_path(path.to_string(), false), "remove file failed", path.to_string());
    };

    /// @brief Removes an empty directory.
    #NoDiscard
    export let remove_directory = func(path: Path) -> result.Result<Unit> {
        return done(remove_path(path.to_string(), true), "remove directory failed", path.to_string());
    };

    /// @brief Removes `path` and, for a directory, everything below it: depth first, in sorted order.
    ///
    /// Links and other entries of kind Other are removed without descending into them. Stops at the first
    /// error.
    #NoDiscard
    export let remove_tree = func(path: Path) -> result.Result<Unit> {
        last text = path.to_string();
        match (stat_path(text, false)) {
            StatOutcome.Ok(status) => {
                if (status[0] != 1) {
                    return remove_file(path);
                }
            },
            StatOutcome.Error(code) => {
                return result.Result<Unit>.Err(host_error.io(code, "remove tree failed", text));
            },
        }
        match (list(path)) {
            result.Result.Ok(entries) => {
                for (let entry in entries) {
                    match (remove_tree(entry)) {
                        result.Result.Ok(_) => {},
                        result.Result.Err(failure) => {
                            return result.Result<Unit>.Err(failure);
                        },
                    }
                }
            },
            result.Result.Err(failure) => {
                return result.Result<Unit>.Err(failure);
            },
        }
        return remove_directory(path);
    };

    /// @brief Renames or moves an entry, replacing an existing file at `to`.
    #NoDiscard
    export let rename = func(from: Path, to: Path) -> result.Result<Unit> {
        return done(rename_path(from.to_string(), to.to_string()), "rename failed", from.to_string());
    };

    /// @brief Copies a file's bytes through a 65,536-byte buffer, replacing an existing target. Both files are
    /// closed on every path.
    #NoDiscard
    export let copy_file = func(from: Path, to: Path) -> result.Result<Unit> {
        last source: files.File;
        match (files.open(from, files.OpenMode.Read)) {
            result.Result.Ok(opened) => {
                source = opened;
            },
            result.Result.Err(failure) => {
                return result.Result<Unit>.Err(failure);
            },
        }
        last target: files.File;
        match (files.open(to, files.OpenMode.Write)) {
            result.Result.Ok(opened) => {
                target = opened;
            },
            result.Result.Err(failure) => {
                let _ = source.close();
                return result.Result<Unit>.Err(failure);
            },
        }
        do {
            match (source.read(CopyBufferSize)) {
                result.Result.Ok(chunk) => {
                    if (chunk.length == 0) {
                        break;
                    }
                    match (target.write(chunk)) {
                        result.Result.Ok(_) => {},
                        result.Result.Err(failure) => {
                            let _ = source.close();
                            let _ = target.close();
                            return result.Result<Unit>.Err(failure);
                        },
                    }
                },
                result.Result.Err(failure) => {
                    let _ = source.close();
                    let _ = target.close();
                    return result.Result<Unit>.Err(failure);
                },
            }
        }
        match (source.close()) {
            result.Result.Ok(_) => {},
            result.Result.Err(failure) => {
                let _ = target.close();
                return result.Result<Unit>.Err(failure);
            },
        }
        return target.close();
    };

    /// @brief Reads an open file in chunks until EOF or a read error.
    let read_open = func(file: files.File) -> result.Result<uint8[list]> {
        let data: uint8[list] = [];
        do {
            match (file.read(CopyBufferSize)) {
                result.Result.Ok(chunk) => {
                    if (chunk.length == 0) {
                        break;
                    }
                    if (data.length == 0) {
                        data = chunk;
                    } else {
                        bytes.append_range(data, chunk, 0, chunk.length);
                    }
                },
                result.Result.Err(failure) => {
                    let _ = file.close();
                    return result.Result<uint8[list]>.Err(failure);
                },
            }
        }
        return match (file.close()) {
            result.Result.Ok(_) => result.Result<uint8[list]>.Ok(data),
            result.Result.Err(failure) => result.Result<uint8[list]>.Err(failure),
        };
    };

    /// @brief A failed write is reported after the file is closed.
    let write_mode = func(path: Path, data: uint8[list], mode: files.OpenMode) -> result.Result<Unit> {
        match (files.open(path, mode)) {
            result.Result.Ok(file) => {
                match (file.write(data)) {
                    result.Result.Ok(_) => {
                        return file.close();
                    },
                    result.Result.Err(failure) => {
                        let _ = file.close();
                        return result.Result<Unit>.Err(failure);
                    },
                }
            },
            result.Result.Err(failure) => {
                return result.Result<Unit>.Err(failure);
            },
        }
    };

    /// @brief Converts the provider's metadata tuple into library values.
    let metadata_of = func(status: [int, int64, int64, int]) -> FileMetadata {
        last kind: FileKind;
        if (status[0] == 0) {
            kind = FileKind.File;
        } else if (status[0] == 1) {
            kind = FileKind.Directory;
        } else {
            kind = FileKind.Other;
        }
        return new(kind, status[1], instant.of_epoch_seconds(status[2], status[3]));
    };

    /// @brief Translates NotFound to Ok(false) and preserves other provider failures.
    let missing_or_error = func(code: uint32, path: string) -> result.Result<bool> {
        if (code == 1) {
            return result.Result<bool>.Ok(false);
        }
        return result.Result<bool>.Err(host_error.io(code, "metadata failed", path));
    };

    /// @brief Checks whether the path that already exists is a directory.
    let existing_directory = func(text: string) -> result.Result<Unit> {
        return match (stat_path(text, true)) {
            StatOutcome.Ok(status) => directory_or_exists(status[0], text),
            StatOutcome.Error(code) => result.Result<Unit>.Err(host_error.io(code, "create directory failed", text)),
        };
    };

    /// @brief Accepts an existing directory and reports AlreadyExists for other kinds.
    let directory_or_exists = func(kind: int, text: string) -> result.Result<Unit> {
        if (kind == 1) {
            return bytes.ok();
        }
        return result.Result<Unit>.Err(host_error.io(3, "create directory failed", text));
    };

    /// @brief Reports a failed attempt to create a directory after handling its parent.
    let retry_failed = func(code: uint32, text: string) -> result.Result<Unit> {
        if (code == 3) {
            return existing_directory(text);
        }
        return result.Result<Unit>.Err(host_error.io(code, "create directory failed", text));
    };

    /// @brief Converts provider success or failure into a Result with path context.
    let done = func(outcome: DoneOutcome, message: string, path: string) -> result.Result<Unit> {
        return match (outcome) {
            DoneOutcome.Ok => bytes.ok(),
            DoneOutcome.Error(code) => result.Result<Unit>.Err(host_error.io(code, message, path)),
        };
    };
);
