/// @brief The host ID of an open file and the path it was opened with. Only Std.Fs.File creates one; the ID
/// never leaves the library.
export let FileHandle = module (
    /// @brief Pairs a provider file identifier with its opening path.
    #Final
    export let FileHandle = class (
        /// @brief The provider's identifier for the open file.
        export last id: int64;
        /// @brief The opening path retained for diagnostics.
        export last path: string;

        /// @brief Stores the provider identifier and path.
        export let init = func(host_id: int64, path_text: string) {
            id = host_id;
            path = path_text;
        };
    );
);
