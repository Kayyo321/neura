let.promote _ = import:Std.Core.Comparable;
let.promote _ = import:Std.Core.Error;
let hashing = import:Std.Core.Hash;
let.promote _ = import:Std.Core.Ordering;
let.promote _ = import:Std.Random.Random;
let.promote _ = import:Std.Core.Result;

/// @brief An immutable 128-bit identifier (Stdlib.md section 12.2), held as its first and last 8 bytes in
/// big-endian order, so comparing the halves compares the bytes.
/// @see [Std.Random.Uuid](https://github.com/Kayyo321/neura/wiki/Stdlib-Random-Uuid)
#Since("0.1.0")
export let Uuid = module (
    /// @brief An immutable 128-bit identifier ordered by its unsigned big-endian bytes.
    #[Final, NoDiscard, Immutable, ThreadSafe]
    export let Uuid = class implements Comparable<Uuid> (
        /// @brief The most significant eight bytes.
        last high: uint64;
        /// @brief The least significant eight bytes.
        last low: uint64;

        /// @brief Constructs an identifier from its big-endian halves.
        export let init = func(first: uint64, last: uint64) {
            high = first;
            low = last;
        };

        /// @brief The 16 bytes in order, as a new list.
        export let to_bytes = func -> uint8[list] {
            last bytes: uint8[list] = [];
            append_word(bytes, high);
            append_word(bytes, low);
            return bytes;
        };

        /// @brief Lexicographic over the bytes, each unsigned.
        #Pure
        export let compare_to = func(other: Uuid) -> Ordering {
            if (high != other.high) {
                return order(high < other.high);
            }
            if (low != other.low) {
                return order(low < other.low);
            }
            return Ordering.Equal;
        };

        /// @brief Tests whether another UUID has the same two halves.
        #Pure
        export let.override equals = func(other: class) -> bool {
            if (!(other is Uuid)) {
                return false;
            }
            last id = other as Uuid;
            return high == id.high && low == id.low;
        };

        /// @brief Starts from 17 and combines each byte in order.
        export let.override hash_code = func -> uint32 {
            let hash: uint32 = 17;
            for (let b in to_bytes()) {
                hash = hashing.combine(hash, b as uint32);
            }
            return hash;
        };

        /// @brief The 36-character hyphenated form in lowercase.
        export let.override to_string = func -> string {
            let text = "";
            last bytes = to_bytes();
            for (let i = 0; i < 16; i++) {
                if (i == 4 || i == 6 || i == 8 || i == 10) {
                    text += "-";
                }
                last b = bytes[i] as int;
                text = text + HexDigits.slice(b / 16, b / 16 + 1) + HexDigits.slice(b % 16, b % 16 + 1);
            }
            return text;
        };
    );

    /// @brief The lowercase digits used for canonical UUID text.
    const HexDigits: string = "0123456789abcdef";

    /// @brief A version 4 identifier from 16 bytes of random.fill_bytes, with the version bits set to 0100 and
    /// the variant bits to 10.
    #ThreadSafe
    export let random = func(source: Random) -> Uuid {
        last bytes = source.fill_bytes(16);
        bytes[6] = (bytes[6] & 15) | 64;
        bytes[8] = (bytes[8] & 63) | 128;
        return new(word_at(bytes, 0), word_at(bytes, 8));
    };

    /// @brief The 36-character hyphenated form, hex digits in either case.
    ///
    /// Errors: Empty; InvalidCharacter at the first byte that is not a hex digit or a hyphen in its place, or
    /// at offset 36 when text follows; UnexpectedEnd at the length for shorter text.
    #[NoDiscard, Pure, ThreadSafe]
    export let parse = func(text: string) -> Result<Uuid> {
        last length = text.byte_length;
        if (length == 0) {
            return failed(ParseErrorKind.Empty, 0, "empty input");
        }
        last words: uint64[] = [0, 0];
        let digit_count = 0;
        for (let i = 0; i < 36; i++) {
            if (i >= length) {
                return failed(ParseErrorKind.UnexpectedEnd, length, "unexpected end of input");
            }
            last b = text.byte_at(i) as int;
            if (i == 8 || i == 13 || i == 18 || i == 23) {
                if (b != 45) {
                    return failed(ParseErrorKind.InvalidCharacter, i, "expected '-'");
                }
            } else {
                last value = hex_value(b);
                if (value < 0) {
                    return failed(ParseErrorKind.InvalidCharacter, i, "expected hex digit");
                }
                last w = digit_count / 16;
                words[w] = (words[w] << 4) | (value as uint64);
                digit_count++;
            }
        }
        if (length > 36) {
            return failed(ParseErrorKind.InvalidCharacter, 36, "unexpected character");
        }
        return Result<Uuid>.Ok(new Uuid(words[0], words[1]));
    };

    /// @brief Creates a UUID parse error at a specific UTF-8 byte offset.
    let failed = func(kind: ParseErrorKind, offset: int, message: string) -> Result<Uuid> =>
        Result<Uuid>.Err(Error.Parse { kind: kind, offset: offset, message: message });

    /// @brief Decodes one ASCII hexadecimal digit, or returns the invalid-digit sentinel.
    let hex_value = func(b: int) -> int {
        if (b >= 48 && b <= 57) {
            return b - 48;
        }
        if (b >= 97 && b <= 102) {
            return b - 87;
        }
        if (b >= 65 && b <= 70) {
            return b - 55;
        }
        return -1;
    };

    /// @brief Eight bytes from `start`, big-endian.
    let word_at = func(bytes: uint8[list], start: int) -> uint64 {
        let word: uint64 = 0;
        for (let i = start; i < start + 8; i++) {
            word = (word << 8) | (bytes[i] as uint64);
        }
        return word;
    };

    /// @brief Appends eight bytes from the word in big-endian order.
    let append_word = func(bytes: uint8[list], word: uint64) {
        let shift = 56;
        while (shift >= 0) {
            bytes.append(((word >> shift) & 255) as uint8);
            shift -= 8;
        }
    };

    /// @brief Converts an unequal comparison to Less or Greater.
    let order = func(less: bool) -> Ordering => less ? Ordering.Less : Ordering.Greater;
);
