let.promote _ = import:Std.Core.Error;
let host_error = import:Std.Core.Internal.HostError;
let maths = import:Std.Math.Math;
let.promote _ = import:Std.Core.Result;
let uint64s = import:Std.Core.UInt64;

/// @brief A seeded pseudo-random generator: xoshiro256** over four uint64 words, seeded by SplitMix64
/// (Stdlib.md section 12.2).
///
/// Every wrapping operation follows the uint64 recipes of section 7.2. The same seed gives the same results
/// from every member on every runtime. Not suitable for secrets.
/// @see [Std.Random.Random](https://github.com/Kayyo321/neura/wiki/Stdlib-Random-Random)
#Since("0.1.0")
export let Random = module (
    /// @brief Restricts construction to factories that initialize the generator state.
    let Seal = enum (Token);

    /// @brief A deterministic xoshiro256** generator with an optional cached normal sample.
    #[Final, NotThreadSafe]
    export let Random = class (
        /// @brief The first word of the xoshiro256** state.
        let s0: uint64;
        /// @brief The second word of the xoshiro256** state.
        let s1: uint64;
        /// @brief The third word of the xoshiro256** state.
        let s2: uint64;
        /// @brief The fourth word of the xoshiro256** state.
        let s3: uint64;
        /// @brief The second value of the last accepted Gaussian pair.
        let has_spare: bool = false;
        /// @brief The cached normal sample when a second value is available.
        let spare: float64 = 0.0;

        /// @brief Initializes the four state words supplied by the seeding factory.
        export let init = func(seal: Seal, a: uint64, b: uint64, c: uint64, d: uint64) {
            s0 = a;
            s1 = b;
            s2 = c;
            s3 = d;
        };

        /// @brief One step: rotate_left(s1 * 5, 7) * 9, then the state transition.
        export let next_uint64 = func -> uint64 {
            last output = times9(rotate(times5(s1), 7));
            last t = s1 << 17;
            s2 ^= s0;
            s3 ^= s1;
            s1 ^= s2;
            s0 ^= s3;
            s2 ^= t;
            s3 = rotate(s3, 45);
            return output;
        };

        /// @brief The high 32 bits of one step.
        export let next_uint32 = func -> uint32 => (next_uint64() >> 32) as uint32;

        /// @brief The top bit of one step.
        export let next_bool = func -> bool => (next_uint64() >> 63) == 1;

        /// @brief Uniform in 0 up to but excluding `bound`: next_uint32 masked to the smallest all-ones mask
        /// covering bound - 1, drawn until below bound.
        ///
        /// A bound below 1 traps with "invalid argument: bound must be positive".
        export let next_int_below = func(bound: int) -> int {
            if (bound < 1) {
                trap_with_message("invalid argument: bound must be positive");
            }
            return below(bound as uint32) as int;
        };

        /// @brief Uniform from `low` up to but excluding `high`, with the span in int64. Traps with "invalid
        /// argument: low must be below high" unless low < high.
        export let next_int_between = func(low: int, high: int) -> int {
            if (low >= high) {
                trap_with_message("invalid argument: low must be below high");
            }
            last span = (high as int64) - (low as int64);
            return ((low as int64) + (below(span as uint32) as int64)) as int;
        };

        /// @brief The top 53 bits of one step times 2^-53: uniform in 0 up to but excluding 1.
        export let next_float64 = func -> float64 =>
            ((next_uint64() >> 11) as float64) * 0.00000000000000011102230246251565404236316680908203125;

        /// @brief A standard normal value by Marsaglia's polar method: u and v are next_float64() * 2 - 1,
        /// drawn in pairs until s = u^2 + v^2 is below 1 and not 0; then m = sqrt(-2 log(s) / s) with Std.Math,
        /// u * m is returned and v * m is kept for the next call.
        export let next_gaussian = func -> float64 {
            if (has_spare) {
                has_spare = false;
                return spare;
            }
            let u = 0.0;
            let v = 0.0;
            let s = 0.0;
            do {
                u = next_float64() * 2.0 - 1.0;
                v = next_float64() * 2.0 - 1.0;
                s = u * u + v * v;
            } while (!(s < 1.0 && s != 0.0));
            last factor = maths.sqrt(-2.0 * maths.log(s) / s);
            spare = v * factor;
            has_spare = true;
            return u * factor;
        };

        /// @brief A new list of `count` bytes.
        ///
        /// Each step supplies 8 bytes, least significant first; a final partial group uses the low bytes. A
        /// negative count traps with "invalid argument: negative count".
        export let fill_bytes = func(count: int) -> uint8[list] {
            if (count < 0) {
                trap_with_message("invalid argument: negative count");
            }
            last bytes: uint8[list] = [];
            while (bytes.length < count) {
                let word = next_uint64();
                let k = 0;
                while (k < 8 && bytes.length < count) {
                    bytes.append((word & 255) as uint8);
                    word >>= 8;
                    k++;
                }
            }
            return bytes;
        };

        /// @brief Fisher-Yates: for i from the last index down to 1, swaps i with next_int_below(i + 1).
        export let shuffle = func<T>(items: T[list]) {
            let i = items.length - 1;
            while (i >= 1) {
                last j = next_int_below(i + 1);
                last held = items[i];
                items[i] = items[j];
                items[j] = held;
                i--;
            }
        };

        /// @brief An element chosen with next_int_below. An empty list traps with "no such element".
        export let choose = func<T>(items: T[list]) -> T {
            if (items.length == 0) {
                trap_with_message("no such element");
            }
            return items[next_int_below(items.length)];
        };

        /// @brief Uniform below a bound from 1 through 2^32 - 1.
        let below = func(bound: uint32) -> uint32 {
            let mask = bound - 1;
            mask |= (mask >> 1);
            mask |= (mask >> 2);
            mask |= (mask >> 4);
            mask |= (mask >> 8);
            mask |= (mask >> 16);
            do {
                last candidate = next_uint32() & mask;
                if (candidate < bound) {
                    return candidate;
                }
            }
        };
    );

    /// @brief The four words are successive outputs of SplitMix64 started at the seed.
    #[Pure, ThreadSafe]
    export let seeded = func(seed: uint64) -> Random {
        let state = seed;
        state = uint64s.wrapping_add(state, 11400714819323198485);
        last a = mix(state);
        state = uint64s.wrapping_add(state, 11400714819323198485);
        last b = mix(state);
        state = uint64s.wrapping_add(state, 11400714819323198485);
        last c = mix(state);
        state = uint64s.wrapping_add(state, 11400714819323198485);
        last d = mix(state);
        return new(Seal.Token, a, b, c, d);
    };

    /// @brief Carries the provider's entropy bytes or error code.
    let FillOutcome = enum (Ok(uint8[list]), Error(uint32));
    /// @brief Requests the specified byte count from the entropy provider.
    let fill_entropy = func(count: int) -> FillOutcome host("neura.entropy.fill", 1);

    /// @brief Seeds with 8 bytes from neura.entropy.fill, read as a little-endian uint64. Needs the entropy
    /// capability; a denied or failed request is an Io error (CapabilityDenied when denied).
    #NoDiscard
    export let from_entropy = func -> Result<Random> => match (fill_entropy(8)) {
        FillOutcome.Ok(bytes) => seeded_from(bytes),
        FillOutcome.Error(code) => Result<Random>.Err(host_error.io(code, "entropy request failed", "")),
    };

    /// @brief Interprets eight entropy bytes as a little-endian seed.
    let seeded_from = func(bytes: uint8[list]) -> Result<Random> {
        if (bytes.length != 8) {
            last wrong = Error.Io {
                kind: IoErrorKind.InvalidData, message: "entropy source returned " + bytes.length.to_string() + " bytes",
                path: ""
            };
            return Result<Random>.Err(wrong);
        }
        let seed: uint64 = 0;
        let i = 7;
        while (i >= 0) {
            seed = (seed << 8) | (bytes[i] as uint64);
            i--;
        }
        return Result<Random>.Ok(seeded(seed));
    };

    /// @brief The SplitMix64 output function for a state.
    let mix = func(state: uint64) -> uint64 {
        let z = state;
        z = uint64s.wrapping_mul(z ^ (z >> 30), 13787848793156543929);
        z = uint64s.wrapping_mul(z ^ (z >> 27), 10723151780598845931);
        return z ^ (z >> 31);
    };

    /// @brief x * 5 and x * 9 modulo 2^64 as a shift and a wrapping add.
    let times5 = func(x: uint64) -> uint64 => uint64s.wrapping_add(x << 2, x);

    /// @brief Multiplies a word by nine modulo 2^64.
    let times9 = func(x: uint64) -> uint64 => uint64s.wrapping_add(x << 3, x);

    /// @brief A rotation by 1 through 63.
    let rotate = func(x: uint64, count: int) -> uint64 => (x << count) | (x >> (64 - count));
);
