let error = import:Std.Core.Error;
let host_error = import:Std.Core.Internal.HostError;
let maths = import:Std.Math.Math;
let result = import:Std.Core.Result;
let uint64s = import:Std.Core.UInt64;

// A seeded pseudo-random generator: xoshiro256** over four uint64 words,
// seeded by SplitMix64 (Stdlib.md section 12.2). Every wrapping operation
// follows the uint64 recipes of section 7.2. The same seed gives the same
// results from every member on every runtime. Not suitable for secrets.
export let Random = module (
    let Seal = enum (Token);

    export let Random = class (
        let s0: uint64;
        let s1: uint64;
        let s2: uint64;
        let s3: uint64;
        // The second value of the last accepted Gaussian pair.
        let has_spare: bool = false;
        let spare: float64 = 0.0;

        export let init = func(Seal seal, uint64 a, uint64 b, uint64 c, uint64 d) -> void {
            s0 = a;
            s1 = b;
            s2 = c;
            s3 = d;
        };

        // One step: rotate_left(s1 * 5, 7) * 9, then the state transition.
        export let next_uint64 = func() -> uint64 {
            let output = times9(rotate(times5(s1), 7));
            let t = s1 << 17;
            s2 = s2 ^ s0;
            s3 = s3 ^ s1;
            s1 = s1 ^ s2;
            s0 = s0 ^ s3;
            s2 = s2 ^ t;
            s3 = rotate(s3, 45);
            return output;
        };

        // The high 32 bits of one step.
        export let next_uint32 = func() -> uint32 {
            return (next_uint64() >> 32) as uint32;
        };

        // The top bit of one step.
        export let next_bool = func() -> bool {
            return (next_uint64() >> 63) == 1;
        };

        // Uniform in 0 up to but excluding `bound`: next_uint32 masked to
        // the smallest all-ones mask covering bound - 1, drawn until below
        // bound. A bound below 1 traps with "invalid argument: bound must be
        // positive".
        export let next_int_below = func(int bound) -> int {
            if (bound < 1) {
                trap_with_message("invalid argument: bound must be positive");
            }
            return below(bound as uint32) as int;
        };

        // Uniform from `low` up to but excluding `high`, with the span in
        // int64. Traps with "invalid argument: low must be below high"
        // unless low < high.
        export let next_int_between = func(int low, int high) -> int {
            if (low >= high) {
                trap_with_message("invalid argument: low must be below high");
            }
            let span = (high as int64) - (low as int64);
            return ((low as int64) + (below(span as uint32) as int64)) as int;
        };

        // The top 53 bits of one step times 2^-53: uniform in 0 up to but
        // excluding 1.
        export let next_float64 = func() -> float64 {
            return ((next_uint64() >> 11) as float64) * 0.00000000000000011102230246251565404236316680908203125;
        };

        // A standard normal value by Marsaglia's polar method: u and v are
        // next_float64() * 2 - 1, drawn in pairs until s = u^2 + v^2 is
        // below 1 and not 0; then m = sqrt(-2 log(s) / s) with Std.Math,
        // u * m is returned and v * m is kept for the next call.
        export let next_gaussian = func() -> float64 {
            if (has_spare) {
                has_spare = false;
                return spare;
            }
            let u = 0.0;
            let v = 0.0;
            let s = 0.0;
            let searching = true;
            while (searching) {
                u = next_float64() * 2.0 - 1.0;
                v = next_float64() * 2.0 - 1.0;
                s = u * u + v * v;
                searching = !(s < 1.0 && s != 0.0);
            }
            let factor = maths.sqrt(-2.0 * maths.log(s) / s);
            spare = v * factor;
            has_spare = true;
            return u * factor;
        };

        // A new list of `count` bytes. Each step supplies 8 bytes, least
        // significant first; a final partial group uses the low bytes. A
        // negative count traps with "invalid argument: negative count".
        export let fill_bytes = func(int count) -> uint8[list] {
            if (count < 0) {
                trap_with_message("invalid argument: negative count");
            }
            let bytes: uint8[list] = [];
            while (bytes.length < count) {
                let word = next_uint64();
                let k = 0;
                while (k < 8 && bytes.length < count) {
                    bytes.append((word & 255) as uint8);
                    word = word >> 8;
                    k = k + 1;
                }
            }
            return bytes;
        };

        // Fisher-Yates: for i from the last index down to 1, swaps i with
        // next_int_below(i + 1).
        export let shuffle = func<T>(T[list] items) -> void {
            let i = items.length - 1;
            while (i >= 1) {
                let j = next_int_below(i + 1);
                let held = items[i];
                items[i] = items[j];
                items[j] = held;
                i = i - 1;
            }
        };

        // An element chosen with next_int_below. An empty list traps with
        // "no such element".
        export let choose = func<T>(T[list] items) -> T {
            if (items.length == 0) {
                trap_with_message("no such element");
            }
            return items[next_int_below(items.length)];
        };

        // Uniform below a bound from 1 through 2^32 - 1.
        let below = func(uint32 bound) -> uint32 {
            let mask = bound - 1;
            mask = mask | (mask >> 1);
            mask = mask | (mask >> 2);
            mask = mask | (mask >> 4);
            mask = mask | (mask >> 8);
            mask = mask | (mask >> 16);
            while (true) {
                let candidate = next_uint32() & mask;
                if (candidate < bound) {
                    return candidate;
                }
            }
            return 0;
        };
    );

    // The four words are successive outputs of SplitMix64 started at the
    // seed.
    export let seeded = func(uint64 seed) -> Random {
        let state = seed;
        state = uint64s.wrapping_add(state, 11400714819323198485);
        let a = mix(state);
        state = uint64s.wrapping_add(state, 11400714819323198485);
        let b = mix(state);
        state = uint64s.wrapping_add(state, 11400714819323198485);
        let c = mix(state);
        state = uint64s.wrapping_add(state, 11400714819323198485);
        let d = mix(state);
        return new Random(Seal.Token, a, b, c, d);
    };

    let FillOutcome = enum (Ok(uint8[list]), Error(uint32));
    let fill_entropy = func(int count) -> FillOutcome host("neura.entropy.fill", 1);

    // Seeds with 8 bytes from neura.entropy.fill, read as a little-endian
    // uint64. Needs the entropy capability; a denied or failed request is
    // an Io error (CapabilityDenied when denied).
    export let from_entropy = func() -> result.Result<Random> {
        return match (fill_entropy(8)) {
            FillOutcome.Ok(bytes) => seeded_from(bytes),
            FillOutcome.Error(code) => result.Result<Random>.Err(host_error.io(code, "entropy request failed", "")),
        };
    };

    let seeded_from = func(uint8[list] bytes) -> result.Result<Random> {
        if (bytes.length != 8) {
            let wrong = error.Error.Io {
                kind: error.IoErrorKind.InvalidData, message: "entropy source returned " + bytes.length.to_string() + " bytes",
                path: ""
            };
            return result.Result<Random>.Err(wrong);
        }
        let seed: uint64 = 0;
        let i = 7;
        while (i >= 0) {
            seed = (seed << 8) | (bytes[i] as uint64);
            i = i - 1;
        }
        return result.Result<Random>.Ok(seeded(seed));
    };

    // The SplitMix64 output function for a state.
    let mix = func(uint64 state) -> uint64 {
        let z = state;
        z = uint64s.wrapping_mul(z ^ (z >> 30), 13787848793156543929);
        z = uint64s.wrapping_mul(z ^ (z >> 27), 10723151780598845931);
        return z ^ (z >> 31);
    };

    // x * 5 and x * 9 modulo 2^64 as a shift and a wrapping add.
    let times5 = func(uint64 x) -> uint64 {
        return uint64s.wrapping_add(x << 2, x);
    };

    let times9 = func(uint64 x) -> uint64 {
        return uint64s.wrapping_add(x << 3, x);
    };

    // A rotation by 1 through 63.
    let rotate = func(uint64 x, int count) -> uint64 {
        return (x << count) | (x >> (64 - count));
    };
);
