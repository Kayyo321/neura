let bytes = import:Std.Io.Internal.Bytes;
let result = import:Std.Core.Result;
let unit = import:Std.Core.Unit;

// Buffers a byte sink (Stdlib.md section 11.1). The bound write method is
// itself a byte sink. Bytes pass on when the buffer would overflow and on
// flush; a write of at least the capacity goes straight to the sink after
// the buffer. It never closes anything. When the sink fails, the buffered
// bytes are discarded and the error is returned.
export let BufferedWriter = module (
    export const DefaultCapacity: int = 8192;
    export const MinimumCapacity: int = 16;

    export let BufferedWriter = class (
        let sink: func(uint8[list]) -> result.Result<unit.Unit>;
        let capacity: int = 8192;
        let buffer: uint8[list] = [];

        // Use create or with_capacity.
        export let init = func(func(uint8[list]) -> result.Result<unit.Unit> output, int size) -> void {
            if (size < MinimumCapacity) {
                trap_with_message("invalid argument: capacity below 16");
            }
            sink = output;
            capacity = size;
        };

        export let write = func(uint8[list] data) -> result.Result<unit.Unit> {
            if (buffer.length + data.length > capacity) {
                match (flush()) {
                    result.Result.Ok(_) => {},
                    result.Result.Err(failure) => {
                        return result.Result<unit.Unit>.Err(failure);
                    },
                }
            }
            if (data.length >= capacity) {
                return sink(data);
            }
            bytes.append_range(buffer, data, 0, data.length);
            return bytes.ok();
        };

        // Passes the buffered bytes to the sink.
        export let flush = func() -> result.Result<unit.Unit> {
            if (buffer.length == 0) {
                return bytes.ok();
            }
            let full = buffer;
            let empty: uint8[list] = [];
            buffer = empty;
            return sink(full);
        };

        // The number of bytes waiting for flush.
        export let buffered = func() -> int {
            return buffer.length;
        };
    );

    // A writer collecting up to 8,192 bytes.
    export let create = func(func(uint8[list]) -> result.Result<unit.Unit> sink) -> BufferedWriter {
        return new BufferedWriter(sink, DefaultCapacity);
    };

    // A capacity below 16 traps with "invalid argument: capacity below 16".
    export let with_capacity = func(func(uint8[list]) -> result.Result<unit.Unit> sink, int capacity) -> BufferedWriter {
        return new BufferedWriter(sink, capacity);
    };
);
