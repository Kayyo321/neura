let bytes = import:Std.Io.Internal.Bytes;
let errors = import:Std.Core.Error;
let.promote _ = import:Std.Core.Result;

/// @brief Buffers a byte source (Stdlib.md section 11.1).
///
/// The bound read method is itself a byte source. A read asking for at least the capacity bypasses an empty
/// buffer. Bytes read before a failure stay consumed.
/// @see [Std.Io.BufferedReader](https://github.com/Kayyo321/neura/wiki/Stdlib-Io-BufferedReader)
#Since("0.1.0")
export let BufferedReader = module (
    /// @brief The default buffer capacity in bytes.
    export const DefaultCapacity: int = 8192;
    /// @brief The smallest supported buffer capacity in bytes.
    export const MinimumCapacity: int = 16;

    /// @brief Wraps a byte source and retains unread bytes between reads.
    #[Final, NotThreadSafe]
    export let BufferedReader = class (
        /// @brief The underlying byte source called when more input is needed.
        last source: func(int) -> Result<uint8[list]>;
        /// @brief The configured maximum buffer size in bytes.
        last capacity: int;
        /// @brief Stores the buffered bytes.
        let buffer: uint8[list] = [];
        /// @brief The index of the next unread byte in the buffer.
        let start: int = 0;

        /// @brief Use create or with_capacity.
        export let init = func(input: func(int) -> Result<uint8[list]>, size: int) {
            if (size < MinimumCapacity) {
                trap_with_message("invalid argument: capacity below 16");
            }
            source = input;
            capacity = size;
        };

        /// @brief Up to `max` bytes, at least one unless the source has ended. A maximum below 1 traps.
        #NoDiscard
        export let read = func(max: int) -> Result<uint8[list]> {
            bytes.check_maximum(max);
            if (start == buffer.length) {
                if (max >= capacity) {
                    return source(max);
                }
                match (source(capacity)) {
                    Result.Ok(chunk) => {
                        buffer = chunk;
                        start = 0;
                    },
                    Result.Err(failure) => {
                        return Result<uint8[list]>.Err(failure);
                    },
                }
                if (buffer.length == 0) {
                    return Result<uint8[list]>.Ok(buffer);
                }
            }
            let end = buffer.length;
            if (end - start > max) {
                end = start + max;
            }
            last chunk = bytes.copy_range(buffer, start, end);
            start = end;
            return Result<uint8[list]>.Ok(chunk);
        };

        /// @brief Exactly `count` bytes; the source ending first fails with UnexpectedEnd. A negative count
        /// traps.
        #NoDiscard
        export let read_exact = func(count: int) -> Result<uint8[list]> {
            if (count < 0) {
                trap_with_message("invalid argument: negative count");
            }
            last collected: uint8[list] = [];
            while (collected.length < count) {
                match (read(count - collected.length)) {
                    Result.Ok(chunk) => {
                        if (chunk.length == 0) {
                            return Result<uint8[list]>.Err(unexpected_end());
                        }
                        bytes.append_range(collected, chunk, 0, chunk.length);
                    },
                    Result.Err(failure) => {
                        return Result<uint8[list]>.Err(failure);
                    },
                }
            }
            return Result<uint8[list]>.Ok(collected);
        };

        /// @brief Every remaining byte.
        #NoDiscard
        export let read_all = func -> Result<uint8[list]> {
            last collected: uint8[list] = [];
            do {
                match (read(capacity)) {
                    Result.Ok(chunk) => {
                        if (chunk.length == 0) {
                            return Result<uint8[list]>.Ok(collected);
                        }
                        bytes.append_range(collected, chunk, 0, chunk.length);
                    },
                    Result.Err(failure) => {
                        return Result<uint8[list]>.Err(failure);
                    },
                }
            }
        };

        /// @brief Creates the error for EOF before an exact byte count is available.
        let unexpected_end = func -> errors.Error =>
            bytes.io(errors.IoErrorKind.UnexpectedEnd, "unexpected end of stream", "");
    );

    /// @brief A reader holding up to 8,192 bytes.
    #[Pure, ThreadSafe]
    export let create = func(source: func(int) -> Result<uint8[list]>) -> BufferedReader =>
        new(source, DefaultCapacity);

    /// @brief A capacity below 16 traps with "invalid argument: capacity below 16".
    #[Pure, ThreadSafe]
    export let with_capacity = func(source: func(int) -> Result<uint8[list]>, capacity: int) -> BufferedReader =>
        new(source, capacity);
);
