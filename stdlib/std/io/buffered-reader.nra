let bytes = import:Std.Io.Internal.Bytes;
let errors = import:Std.Core.Error;
let.promote _ = import:Std.Core.Result;

// Buffers a byte source (Stdlib.md section 11.1). The bound read method is
// itself a byte source. A read asking for at least the capacity bypasses an
// empty buffer. Bytes read before a failure stay consumed.
export let BufferedReader = module (
    export const DefaultCapacity: int = 8192;
    export const MinimumCapacity: int = 16;

    export let BufferedReader = class (
        let source: func(int) -> Result<uint8[list]>;
        let capacity: int = 8192;
        let buffer: uint8[list] = [];
        let start: int = 0;

        // Use create or with_capacity.
        export let init = func(input: func(int) -> Result<uint8[list]>, size: int) {
            if (size < MinimumCapacity) {
                trap_with_message("invalid argument: capacity below 16");
            }
            source = input;
            capacity = size;
        };

        // Up to `max` bytes, at least one unless the source has ended. A
        // maximum below 1 traps.
        export let read = func(max: int) -> Result<uint8[list]> {
            bytes.check_maximum(max);
            if (start == buffer.length) {
                if (max >= capacity) {
                    return source(max);
                }
                match (source(capacity)) {
                    Result.Ok(chunk) => {
                        buffer = chunk;
                        start = 0;
                    },
                    Result.Err(failure) => {
                        return Result<uint8[list]>.Err(failure);
                    },
                }
                if (buffer.length == 0) {
                    return Result<uint8[list]>.Ok(buffer);
                }
            }
            let end = buffer.length;
            if (end - start > max) {
                end = start + max;
            }
            let chunk = bytes.copy_range(buffer, start, end);
            start = end;
            return Result<uint8[list]>.Ok(chunk);
        };

        // Exactly `count` bytes; the source ending first fails with
        // UnexpectedEnd. A negative count traps.
        export let read_exact = func(count: int) -> Result<uint8[list]> {
            if (count < 0) {
                trap_with_message("invalid argument: negative count");
            }
            let collected: uint8[list] = [];
            while (collected.length < count) {
                match (read(count - collected.length)) {
                    Result.Ok(chunk) => {
                        if (chunk.length == 0) {
                            return Result<uint8[list]>.Err(unexpected_end());
                        }
                        bytes.append_range(collected, chunk, 0, chunk.length);
                    },
                    Result.Err(failure) => {
                        return Result<uint8[list]>.Err(failure);
                    },
                }
            }
            return Result<uint8[list]>.Ok(collected);
        };

        // Every remaining byte.
        export let read_all = func -> Result<uint8[list]> {
            let collected: uint8[list] = [];
            do {
                match (read(capacity)) {
                    Result.Ok(chunk) => {
                        if (chunk.length == 0) {
                            return Result<uint8[list]>.Ok(collected);
                        }
                        bytes.append_range(collected, chunk, 0, chunk.length);
                    },
                    Result.Err(failure) => {
                        return Result<uint8[list]>.Err(failure);
                    },
                }
            }
        };

        let unexpected_end = func -> errors.Error =>
            bytes.io(errors.IoErrorKind.UnexpectedEnd, "unexpected end of stream", "");
    );

    // A reader holding up to 8,192 bytes.
    export let create = func(source: func(int) -> Result<uint8[list]>) -> BufferedReader =>
        new BufferedReader(source, DefaultCapacity);

    // A capacity below 16 traps with "invalid argument: capacity below 16".
    export let with_capacity = func(source: func(int) -> Result<uint8[list]>, capacity: int) -> BufferedReader =>
        new BufferedReader(source, capacity);
);
