let bytes = import:Std.Io.Internal.Bytes;
let cell = import:Std.Core.Cell;
let.promote _ = import:Std.Core.Result;
let.promote _ = import:Std.Core.Unit;

// An in-memory byte accumulator (Stdlib.md section 11.1). Its bound write
// method is a byte sink.
export let ByteBuffer = module (
    export let ByteBuffer = class (
        let data: uint8[list] = [];

        // Appends every byte; never fails.
        export let write = func(input: uint8[list]) -> Result<Unit> {
            bytes.append_range(data, input, 0, input.length);
            return bytes.ok();
        };

        // A copy of the bytes written so far.
        export let to_list = func -> uint8[list] => bytes.copy_range(data, 0, data.length);

        export let size = func -> int => data.length;

        export let clear = func {
            let empty: uint8[list] = [];
            data = empty;
        };

        // Only the current byte sequence participates. Readers hold their
        // own copies and do not affect the buffer's equality or hash.
        export let.override equals = func(other: class) -> bool {
            if (!(other is ByteBuffer)) {
                return false;
            }
            let buffer = other as ByteBuffer;
            return data === buffer.data;
        };

        export let.override hash_code = func -> uint32 => data.hash_code();

        export let.override to_string = func -> string => data.to_string();

        // A byte source over a copy of the current contents. A maximum count
        // below 1 traps.
        export let reader = func -> func(int) -> Result<uint8[list]> {
            let snapshot = to_list();
            let position = cell.of<int>(0);
            return func(max: int) -> Result<uint8[list]> {
                bytes.check_maximum(max);
                let start = position.value;
                let end = snapshot.length;
                if (end - start > max) {
                    end = start + max;
                }
                position.value = end;
                return Result<uint8[list]>.Ok(bytes.copy_range(snapshot, start, end));
            };
        };
    );

    export let create = func -> ByteBuffer => new ByteBuffer();
);
