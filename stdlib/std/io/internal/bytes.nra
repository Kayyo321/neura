let error = import:Std.Core.Error;
let result = import:Std.Core.Result;
let unit = import:Std.Core.Unit;

// Byte-list helpers shared by Std.Io, Std.Fs, and Std.Net.
export let Bytes = module (
    // The UTF-8 bytes of `text`.
    export let of_string = func(string text) -> uint8[list] {
        let bytes: uint8[list] = [];
        let count = text.byte_length;
        let i = 0;
        while (i < count) {
            bytes.append(text.byte_at(i));
            i = i + 1;
        }
        return bytes;
    };

    // A new list of bytes[start] up to but excluding bytes[end].
    export let copy_range = func(uint8[list] bytes, int start, int end) -> uint8[list] {
        let copy: uint8[list] = [];
        let i = start;
        while (i < end) {
            copy.append(bytes[i]);
            i = i + 1;
        }
        return copy;
    };

    // Appends bytes[start] up to but excluding bytes[end] to `target`.
    export let append_range = func(uint8[list] target, uint8[list] bytes, int start, int end) -> void {
        let i = start;
        while (i < end) {
            target.append(bytes[i]);
            i = i + 1;
        }
    };

    // The index of the first `value` at or after `start`, or -1.
    export let index_of = func(uint8[list] bytes, int start, uint8 value) -> int {
        let i = start;
        let count = bytes.length;
        while (i < count) {
            if (bytes[i] == value) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    };

    export let ok = func() -> result.Result<unit.Unit> {
        return result.Result<unit.Unit>.Ok(unit.Unit.Value);
    };

    export let io = func(error.IoErrorKind kind, string message, string path) -> error.Error {
        return error.Error.Io { kind: kind, message: message, path: path };
    };

    // The error of an operation on a closed resource (Stdlib.md 5.5).
    export let closed = func(string what, string path) -> error.Error {
        return io(error.IoErrorKind.Closed, what + " is closed", path);
    };

    // The error for bytes that are not valid UTF-8.
    export let invalid_utf8 = func(string path) -> error.Error {
        return io(error.IoErrorKind.InvalidData, "invalid UTF-8", path);
    };

    // The error for a host write that reported no progress.
    export let no_progress = func(string message, string path) -> error.Error {
        return io(error.IoErrorKind.Other, message, path);
    };

    // A source's maximum count must be at least 1.
    export let check_maximum = func(int max) -> void {
        if (max < 1) {
            trap_with_message("invalid argument: maximum count below 1");
        }
    };
);
