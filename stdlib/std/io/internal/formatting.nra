let errors = import:Std.Core.Error;
let floating = import:Std.Core.Float64;
let.promote _ = import:Std.Core.Result;
let string_builder = import:Std.Core.StringBuilder;
let strings = import:Std.Text.Strings;
let unsigned = import:Std.Core.UInt64;
let.promote _ = import:Std.Core.Variadic;

// Formatting stays in the program. Console sends only the completed UTF-8
// string to its existing write services.
export let Formatting = module (
    let Spec = class (
        export let fill: string = " ";
        export let align: uint8 = 0;
        export let sign: uint8 = 0;
        export let alternate: bool = false;
        export let zero: bool = false;
        export let width: int = 0;
        export let precision: int = -1;
        export let presentation: uint8 = 0;
    );

    let Cursor = class (
        let pattern: string;
        let values: Argument[];
        let position: int = 0;
        let next_auto: int = 0;
        // 0 means unset, 1 automatic, and 2 manual indexing.
        let index_mode: int = 0;
        let issue: string = "";
        let issue_offset: int = 0;
        let issue_kind: errors.ParseErrorKind = errors.ParseErrorKind.Syntax;

        export let init = func(source: string, arguments: Argument[]) {
            pattern = source;
            values = arguments;
        };

        export let render = func -> Result<string> {
            let output = string_builder.create();
            let literal_start = 0;
            while (position < pattern.byte_length) {
                let b = pattern.byte_at(position);
                if (b != 123 && b != 125) {
                    position += 1;
                    continue;
                }
                output.append(pattern.slice(literal_start, position));
                position += 1;
                if (position < pattern.byte_length && pattern.byte_at(position) == b) {
                    output.append(pattern.slice(position, position + 1));
                    position += 1;
                } else if (b == 123) {
                    let field = replacement();
                    if (issue != "") {
                        return Result<string>.Err(errors.Error.Parse {
                            kind: issue_kind, offset: issue_offset, message: issue
                        });
                    }
                    output.append(field);
                } else {
                    return Result<string>.Err(errors.Error.Parse {
                        kind: errors.ParseErrorKind.Syntax, offset: position - 1,
                        message: "unmatched closing brace"
                    });
                }
                literal_start = position;
            }
            output.append(pattern.slice(literal_start, position));
            return Result<string>.Ok(output.to_string());
        };

        let replacement = func -> string {
            if (position == pattern.byte_length) {
                fail(errors.ParseErrorKind.UnexpectedEnd, "unclosed replacement field");
                return "";
            }
            let index = read_index();
            if (issue != "") {
                return "";
            }
            let spec = new Spec();
            if (peek() == 58) {
                position += 1;
                read_spec(spec);
            }
            if (issue != "") {
                return "";
            }
            if (peek() != 125) {
                if (position == pattern.byte_length) {
                    fail(errors.ParseErrorKind.UnexpectedEnd, "unclosed replacement field");
                } else {
                    fail(errors.ParseErrorKind.Syntax, "expected a closing brace");
                }
                return "";
            }
            let text = render_value(values[index], spec);
            position += 1;
            return text;
        };

        let read_index = func -> int {
            let start = position;
            let mode = 1;
            let index = next_auto;
            if (is_digit(peek())) {
                mode = 2;
                if (peek() == 48 && position + 1 < pattern.byte_length &&
                    is_digit(pattern.byte_at(position + 1))) {
                    fail(errors.ParseErrorKind.Syntax, "leading zero in argument index");
                    return 0;
                }
                index = read_number();
            } else if (peek() != 58 && peek() != 125 && position != pattern.byte_length) {
                fail(errors.ParseErrorKind.Syntax, "expected an argument index");
                return 0;
            }
            if (issue == "") {
                if (index_mode != 0 && index_mode != mode) {
                    fail_at(errors.ParseErrorKind.Syntax, start, "cannot mix automatic and explicit argument indexes");
                } else if (index >= values.length) {
                    fail_at(errors.ParseErrorKind.OutOfRange, start, "format argument index out of range");
                } else if (mode == 1) {
                    next_auto += 1;
                }
            }
            index_mode = mode;
            return index;
        };

        let read_spec = func(spec: Spec) {
            // A single Unicode scalar followed by an alignment character is
            // the fill. Otherwise an alignment character can appear alone.
            let b = peek();
            if (position < pattern.byte_length && b != 123 && b != 125) {
                let after_fill = position + 1;
                while (after_fill < pattern.byte_length && (pattern.byte_at(after_fill) & 192) == 128) {
                    after_fill += 1;
                }
                if (after_fill < pattern.byte_length && is_align(pattern.byte_at(after_fill))) {
                    spec.fill = pattern.slice(position, after_fill);
                    spec.align = pattern.byte_at(after_fill);
                    position = after_fill + 1;
                } else if (is_align(b)) {
                    spec.align = b;
                    position += 1;
                }
            }
            b = peek();
            if (b == 43 || b == 45 || b == 32) {
                spec.sign = b;
                position += 1;
            }
            if (peek() == 35) {
                spec.alternate = true;
                position += 1;
            }
            if (peek() == 48) {
                spec.zero = true;
                position += 1;
            }
            if (is_digit(peek())) {
                spec.width = read_number();
            } else if (peek() == 123) {
                spec.width = read_dynamic();
            }
            if (issue != "") {
                return;
            }
            if (peek() == 46) {
                position += 1;
                if (is_digit(peek())) {
                    spec.precision = read_number();
                } else if (peek() == 123) {
                    spec.precision = read_dynamic();
                } else {
                    fail(errors.ParseErrorKind.Syntax, "expected a precision");
                }
            }
            b = peek();
            if (issue == "" && b != 125 && position < pattern.byte_length) {
                if (!is_presentation(b)) {
                    fail(errors.ParseErrorKind.Syntax, "unsupported format presentation");
                    return;
                }
                spec.presentation = b;
                position += 1;
            }
        };

        let read_dynamic = func -> int {
            position += 1;
            let start = position;
            let index = read_index();
            if (issue != "") {
                return 0;
            }
            if (peek() != 125) {
                fail(errors.ParseErrorKind.Syntax, "expected a closing brace for dynamic width or precision");
                return 0;
            }
            position += 1;
            match (values[index]) {
                Argument.Signed(n) => {
                    if (n >= 0 && n <= 2147483647) {
                        return n as int;
                    }
                },
                Argument.Unsigned(n) => {
                    if (n <= 2147483647) {
                        return n as int;
                    }
                },
                _ => {
                    fail_at(errors.ParseErrorKind.Syntax, start, "dynamic width or precision requires an integer");
                    return 0;
                },
            }
            fail_at(errors.ParseErrorKind.OutOfRange, start, "dynamic width or precision out of range");
            return 0;
        };

        let read_number = func -> int {
            let number = 0;
            while (is_digit(peek())) {
                let digit = (peek() - 48) as int;
                if (number > (2147483647 - digit) / 10) {
                    fail(errors.ParseErrorKind.OutOfRange, "format number out of range");
                    return 0;
                }
                number = number * 10 + digit;
                position += 1;
            }
            return number;
        };

        let peek = func -> uint8 {
            if (position >= pattern.byte_length) {
                return 0;
            }
            return pattern.byte_at(position);
        };

        let fail = func(kind: errors.ParseErrorKind, message: string) => fail_at(kind, position, message);

        let fail_at = func(kind: errors.ParseErrorKind, offset: int, message: string) {
            issue_kind = kind;
            issue_offset = offset;
            issue = message;
        };

        let render_value = func(value: Argument, spec: Spec) -> string => match (value) {
            Argument.Text(text) => render_text(text, spec),
            Argument.Signed(n) => render_signed(n, spec),
            Argument.Unsigned(n) => render_integer(n, false, spec),
            Argument.Floating16(n) => render_float(n as float64, n.to_string(), spec),
            Argument.BFloating16(n) => render_float(n as float64, n.to_string(), spec),
            Argument.Floating32(n) => render_float(n as float64, n.to_string(), spec),
            Argument.Floating(n) => render_float(n, n.to_string(), spec),
            Argument.Boolean(flag) => render_bool(flag, spec),
            Argument.Object(object) => render_text(object_text(object), spec),
        };

        let render_text = func(text: string, spec: Spec) -> string {
            if (spec.sign != 0 || spec.alternate || spec.zero ||
                (spec.presentation != 0 && spec.presentation != 115 && spec.presentation != 63)) {
                return invalid_spec();
            }
            let body = text;
            if (spec.precision >= 0) {
                body = text.slice(0, scalar_end(text, spec.precision));
            }
            if (spec.presentation == 63) {
                body = quote(body);
            }
            return pad(body, "", false, spec);
        };

        let render_bool = func(flag: bool, spec: Spec) -> string {
            if (is_integer_presentation(spec.presentation)) {
                let number: uint64 = 0;
                if (flag) {
                    number = 1;
                }
                return render_integer(number, false, spec);
            }
            if (spec.presentation != 0 && spec.presentation != 115) {
                return invalid_spec();
            }
            if (flag) {
                return render_text("true", spec);
            }
            return render_text("false", spec);
        };

        let render_signed = func(n: int64, spec: Spec) -> string {
            if (n >= 0) {
                return render_integer(n as uint64, false, spec);
            }
            return render_integer((-(n + 1) as uint64) + 1, true, spec);
        };

        let render_integer = func(magnitude: uint64, negative: bool, spec: Spec) -> string {
            let presentation = spec.presentation;
            if (spec.precision >= 0) {
                return invalid_spec();
            }
            if (presentation == 99) {
                if (spec.sign != 0 || spec.alternate || spec.zero) {
                    return invalid_spec();
                }
                if (negative || magnitude > 1114111 || (magnitude >= 55296 && magnitude <= 57343)) {
                    fail(errors.ParseErrorKind.OutOfRange, "character value is not a Unicode scalar");
                    return "";
                }
                let output = string_builder.create();
                output.append_scalar(magnitude as uint32);
                return pad(output.to_string(), "", false, spec);
            }
            if (presentation != 0 && !is_integer_presentation(presentation)) {
                return invalid_spec();
            }
            let radix = 10;
            let base_prefix = "";
            if (presentation == 98 || presentation == 66) {
                radix = 2;
                base_prefix = "0b";
            } else if (presentation == 111) {
                radix = 8;
                if (magnitude != 0) {
                    base_prefix = "0";
                }
            } else if (presentation == 120 || presentation == 88) {
                radix = 16;
                base_prefix = "0x";
            }
            let body = unsigned.to_string_radix(magnitude, radix);
            if (presentation == 88 || presentation == 66) {
                body = strings.to_ascii_upper(body);
                base_prefix = strings.to_ascii_upper(base_prefix);
            }
            let prefix = number_sign(negative, spec.sign);
            if (spec.alternate) {
                prefix += base_prefix;
            }
            return pad(body, prefix, true, spec);
        };

        let render_float = func(n: float64, original: string, spec: Spec) -> string {
            let presentation = spec.presentation;
            let hexadecimal = presentation == 97 || presentation == 65;
            if (presentation != 0 && presentation != 102 && presentation != 70 && presentation != 101 &&
                presentation != 69 && presentation != 103 && presentation != 71 && !hexadecimal) {
                return invalid_spec();
            }
            let digits = spec.precision;
            if (digits > 100) {
                fail(errors.ParseErrorKind.OutOfRange, "floating-point precision exceeds 100");
                return "";
            }
            let body = original;
            let negative = body.byte_at(0) == 45;
            let special = body == "Infinity" || body == "-Infinity" || body == "NaN";
            if (hexadecimal && !special) {
                body = hex_float(n, digits, spec.alternate);
            } else if (!special) {
                if (digits < 0) {
                    digits = 6;
                }
                if (presentation == 102 || presentation == 70) {
                    body = floating.to_fixed(n, digits);
                } else if (presentation == 101 || presentation == 69) {
                    body = floating.to_exponential(n, digits);
                } else if (presentation != 0 || spec.precision >= 0) {
                    body = general_float(n, digits, spec.alternate);
                }
                if (presentation != 0 || spec.precision >= 0 || spec.alternate) {
                    body = finish_float(body, spec.alternate);
                }
            }
            if (negative && (!hexadecimal || special)) {
                body = body.slice(1, body.byte_length);
            }
            if (special && presentation != 0) {
                body = body == "NaN" ? "nan" : "inf";
            }
            if (presentation == 70 || presentation == 69 || presentation == 71 || presentation == 65) {
                body = strings.to_ascii_upper(body);
            }
            if (special && spec.zero && spec.align == 0) {
                spec.zero = false;
            }
            return pad(body, number_sign(negative, spec.sign), true, spec);
        };

        let invalid_spec = func -> string {
            fail(errors.ParseErrorKind.Syntax, "format specification is invalid for the argument type");
            return "";
        };
    );

    export let try_vformat = func(pattern: string, args: Argument[]) -> Result<string> {
        if (!strings.contains(pattern, "{") && !strings.contains(pattern, "}")) {
            return Result<string>.Ok(pattern);
        }
        let cursor = new Cursor(pattern, args);
        return cursor.render();
    };

    let is_digit = func(b: uint8) -> bool => b >= 48 && b <= 57;

    let is_align = func(b: uint8) -> bool => b == 60 || b == 62 || b == 94;

    let is_integer_presentation = func(b: uint8) -> bool =>
        b == 100 || b == 98 || b == 66 || b == 111 || b == 120 || b == 88;

    let is_presentation = func(b: uint8) -> bool {
        return is_integer_presentation(b) || b == 63 || b == 99 || b == 115 ||
            b == 102 || b == 70 || b == 101 || b == 69 || b == 103 || b == 71 || b == 97 || b == 65;
    };

    let object_text = func(value: class) -> string {
        if (value == nil) {
            return "nil";
        }
        return value.to_string();
    };

    let scalar_end = func(text: string, count: int) -> int {
        let end = 0;
        let remaining = count;
        while (end < text.byte_length && remaining > 0) {
            end += 1;
            while (end < text.byte_length && (text.byte_at(end) & 192) == 128) {
                end += 1;
            }
            remaining -= 1;
        }
        return end;
    };

    let quote = func(text: string) -> string {
        let output = string_builder.create();
        output.append("\"");
        let start = 0;
        let end = 0;
        while (end < text.byte_length) {
            let b = text.byte_at(end);
            let escape = "";
            if (b == 34) {
                escape = "\\\"";
            } else if (b == 92) {
                escape = "\\\\";
            } else if (b == 9) {
                escape = "\\t";
            } else if (b == 10) {
                escape = "\\n";
            } else if (b == 13) {
                escape = "\\r";
            } else if (b < 32 || b == 127) {
                escape = "\\u{" + unsigned.to_string_radix(b as uint64, 16) + "}";
            }
            if (escape != "") {
                output.append(text.slice(start, end));
                output.append(escape);
                start = end + 1;
            }
            end += 1;
        }
        output.append(text.slice(start, end));
        output.append("\"");
        return output.to_string();
    };

    let number_sign = func(negative: bool, sign: uint8) -> string {
        if (negative) {
            return "-";
        }
        if (sign == 43) {
            return "+";
        }
        if (sign == 32) {
            return " ";
        }
        return "";
    };

    let pad = func(body: string, prefix: string, numeric: bool, spec: Spec) -> string {
        if (spec.width == 0) {
            return prefix == "" ? body : prefix + body;
        }
        let missing = spec.width - prefix.byte_length - strings.scalar_count(body);
        if (missing <= 0) {
            return prefix + body;
        }
        if (spec.zero && spec.align == 0) {
            return prefix + strings.repeat("0", missing) + body;
        }
        let left = 0;
        if (spec.align == 94) {
            left = missing / 2;
        } else if (spec.align == 62 || (spec.align == 0 && numeric)) {
            left = missing;
        }
        return strings.repeat(spec.fill, left) + prefix + body + strings.repeat(spec.fill, missing - left);
    };

    // Render the binary64 significand in base 16. All narrower floats are
    // exactly representable in binary64. Round truncated nibbles to even.
    let hex_float = func(value: float64, precision: int, alternate: bool) -> string {
        let bits = value.to_bits();
        let fraction_mask: uint64 = (1 as uint64 << 52) - 1;
        let fraction = bits & fraction_mask;
        let field = ((bits >> 52) & 2047) as int;
        let leading: uint64 = 0;
        let exponent = 0;
        if (field > 0) {
            leading = 1;
            exponent = field - 1023;
        } else if (fraction != 0) {
            exponent = -1022;
        }
        let places = 13;
        if (precision >= 0 && precision < places) {
            let discarded_bits = 4 * (places - precision);
            let retained_bits = 4 * precision;
            let rounded = ((leading << 52) | fraction) >> discarded_bits;
            let halfway = 1 as uint64 << (discarded_bits - 1);
            let discarded = fraction & ((halfway << 1) - 1);
            if (discarded > halfway || (discarded == halfway && (rounded & 1) != 0)) {
                rounded++;
            }
            leading = rounded >> retained_bits;
            fraction = rounded & ((1 as uint64 << retained_bits) - 1);
            places = precision;
        }
        let digits = "";
        if (places > 0) {
            let raw = unsigned.to_string_radix(fraction, 16);
            digits = strings.repeat("0", places - raw.byte_length) + raw;
        }
        if (precision < 0) {
            let end = digits.byte_length;
            while (end > 0 && digits.byte_at(end - 1) == 48) {
                end -= 1;
            }
            digits = digits.slice(0, end);
        } else if (precision > places) {
            digits += strings.repeat("0", precision - places);
        }
        let point = alternate || digits != "" ? "." : "";
        let sign = exponent >= 0 ? "+" : "";
        return leading.to_string() + point + digits + "p" + sign + exponent.to_string();
    };

    // Pick fixed or scientific form using the rounded exponent. Rearranging
    // the already-rounded significant digits avoids a second rounding.
    let general_float = func(value: float64, precision: int, alternate: bool) -> string {
        let digits = precision;
        if (digits == 0) {
            digits = 1;
        }
        let scientific = floating.to_exponential(value, digits - 1);
        let marker = strings.index_of(scientific, "e");
        let exponent = parse_exponent(scientific, marker + 1);
        let mantissa = scientific.slice(0, marker);
        if (exponent < -4 || exponent >= digits) {
            if (!alternate) {
                mantissa = trim_fraction(mantissa);
            }
            return mantissa + scientific.slice(marker, scientific.byte_length);
        }
        let start = 0;
        if (mantissa.byte_at(0) == 45) {
            start = 1;
        }
        let sign = mantissa.slice(0, start);
        let significant = mantissa.slice(start, start + 1);
        if (digits > 1) {
            significant += mantissa.slice(start + 2, mantissa.byte_length);
        }
        let point = exponent + 1;
        let fixed = "";
        if (point <= 0) {
            fixed = "0." + strings.repeat("0", -point) + significant;
        } else if (point < digits) {
            fixed = significant.slice(0, point) + "." + significant.slice(point, digits);
        } else {
            fixed = significant;
        }
        if (!alternate) {
            fixed = trim_fraction(fixed);
        }
        return sign + fixed;
    };

    let parse_exponent = func(text: string, start: int) -> int {
        let i = start;
        let negative = text.byte_at(i) == 45;
        if (negative || text.byte_at(i) == 43) {
            i += 1;
        }
        let value = 0;
        while (i < text.byte_length) {
            value = value * 10 + (text.byte_at(i) - 48) as int;
            i += 1;
        }
        if (negative) {
            return -value;
        }
        return value;
    };

    let trim_fraction = func(text: string) -> string {
        let point = strings.index_of(text, ".");
        if (point < 0) {
            return text;
        }
        let end = text.byte_length;
        while (end > point + 1 && text.byte_at(end - 1) == 48) {
            end -= 1;
        }
        if (end == point + 1) {
            end = point;
        }
        return text.slice(0, end);
    };

    let finish_float = func(body: string, alternate: bool) -> string {
        let marker = strings.index_of(body, "e");
        if (marker < 0) {
            if (alternate && !strings.contains(body, ".")) {
                return body + ".";
            }
            return body;
        }
        let mantissa = body.slice(0, marker);
        if (alternate && !strings.contains(mantissa, ".")) {
            mantissa += ".";
        }
        let exponent = parse_exponent(body, marker + 1);
        let sign = "+";
        if (exponent < 0) {
            sign = "-";
            exponent = -exponent;
        }
        let digits = exponent.to_string();
        if (exponent < 10) {
            digits = "0" + digits;
        }
        return mantissa + "e" + sign + digits;
    };
);
