let error = import:Std.Core.Error;
let optional = import:Std.Core.Optional;
let ordering = import:Std.Core.Ordering;
let result = import:Std.Core.Result;

// Functions on immutable UTF-8 strings (Stdlib.md section 8.1). Every
// position is a byte offset of type int. Members that read or slice at an
// offset let the built-in text operation trap; the other offset checks trap
// with "invalid argument: offset out of range" or "invalid argument: offset
// is not a character boundary".
//
// Cost model: byte_at, slice, ==, and string.from_utf8 are single NVM
// operations; concatenation and hash_code copy or read every byte. Members
// therefore compare candidates with slice and ==, build results from slices
// where they can, and build new text in one uint8 list converted once.
export let Strings = module (
    // Constant time.
    export let byte_length = func(string s) -> int {
        return s.byte_length;
    };

    // The number of bytes that are not continuation bytes. Linear.
    export let scalar_count = func(string s) -> int {
        let count = 0;
        let length = s.byte_length;
        let i = 0;
        while (i < length) {
            if ((s.byte_at(i) & 192) != 128) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    };

    export let is_empty = func(string s) -> bool {
        return s.byte_length == 0;
    };

    // The byte at the offset; the built-in read traps outside the string.
    export let byte_at = func(string s, int offset) -> uint8 {
        return s.byte_at(offset);
    };

    // The scalar value of the character starting at the offset. An offset
    // outside the string is a built-in bounds trap; a continuation byte traps
    // with "invalid argument: offset is not a character boundary".
    export let scalar_at = func(string s, int offset) -> uint32 {
        if ((s.byte_at(offset) & 192) == 128) {
            trap_with_message("invalid argument: offset is not a character boundary");
        }
        return decode(s, offset);
    };

    // True for 0, for the byte length, and for every offset whose byte is
    // not a continuation byte; false outside 0 through the byte length.
    export let is_boundary = func(string s, int offset) -> bool {
        if (offset < 0 || offset > s.byte_length) {
            return false;
        }
        return offset == s.byte_length || (s.byte_at(offset) & 192) != 128;
    };

    // The scalar values in order.
    export let scalars = func(string s) -> uint32[list] {
        let values: uint32[list] = [];
        let length = s.byte_length;
        let i = 0;
        while (i < length) {
            let lead = s.byte_at(i);
            values.append(decode(s, i));
            i = i + sequence_length(lead);
        }
        return values;
    };

    // Each character's starting offset with its scalar value.
    export let scalar_offsets = func(string s) -> [int, uint32][list] {
        let values: [int, uint32][list] = [];
        let length = s.byte_length;
        let i = 0;
        while (i < length) {
            let lead = s.byte_at(i);
            values.append([i, decode(s, i)]);
            i = i + sequence_length(lead);
        }
        return values;
    };

    // The built-in slice: both ends on boundaries and start not above end.
    export let slice = func(string s, int start, int end) -> string {
        return s.slice(start, end);
    };

    export let slice_from = func(string s, int start) -> string {
        return s.slice(start, s.byte_length);
    };

    // Same bytes (Stdlib.md section 5.2).
    export let equals = func(string a, string b) -> bool {
        return a == b;
    };

    // Start with 0; for each byte, 31 times the hash plus the byte, wrapping.
    export let hash = func(string s) -> uint32 {
        return s.hash_code();
    };

    // Byte-wise lexicographic order; a proper prefix sorts first. This is
    // also the order of the scalar values.
    export let compare = func(string a, string b) -> ordering.Ordering {
        if (a == b) {
            return ordering.Ordering.Equal;
        }
        let a_length = a.byte_length;
        let b_length = b.byte_length;
        let shorter = a_length;
        if (b_length < shorter) {
            shorter = b_length;
        }
        let i = 0;
        while (i < shorter) {
            let x = a.byte_at(i);
            let y = b.byte_at(i);
            if (x != y) {
                if (x < y) {
                    return ordering.Ordering.Less;
                }
                return ordering.Ordering.Greater;
            }
            i = i + 1;
        }
        if (a_length < b_length) {
            return ordering.Ordering.Less;
        }
        return ordering.Ordering.Greater;
    };

    export let starts_with = func(string s, string prefix) -> bool {
        return matches_at(s, prefix, 0);
    };

    export let ends_with = func(string s, string suffix) -> bool {
        let start = s.byte_length - suffix.byte_length;
        if (start < 0) {
            return false;
        }
        return matches_at(s, suffix, start);
    };

    export let contains = func(string s, string needle) -> bool {
        return find(s, needle, 0) >= 0;
    };

    // The offset of the first occurrence, or -1. An empty needle matches
    // at 0.
    export let index_of = func(string s, string needle) -> int {
        return find(s, needle, 0);
    };

    // The offset of the first occurrence at or after `from`, or -1. An
    // empty needle matches at `from`. `from` must be a boundary from 0
    // through the byte length.
    export let index_of_from = func(string s, string needle, int from) -> int {
        check_offset(s, from);
        return find(s, needle, from);
    };

    // The offset of the last occurrence, or -1. An empty needle matches at
    // the byte length.
    export let last_index_of = func(string s, string needle) -> int {
        let n = needle.byte_length;
        let i = s.byte_length - n;
        if (n == 0) {
            return i;
        }
        let first = needle.byte_at(0);
        while (i >= 0) {
            if (s.byte_at(i) == first && matches_at(s, needle, i)) {
                return i;
            }
            i = i - 1;
        }
        return -1;
    };

    // Every piece between non-overlapping occurrences of the separator,
    // left to right. Empty pieces are kept; the empty string gives one
    // piece. An empty separator traps with "invalid argument: empty
    // separator".
    export let split = func(string s, string separator) -> string[list] {
        return split_pieces(s, separator, 2147483647);
    };

    // As split, with at most `limit` pieces; the last piece holds the rest.
    // A limit below 1 traps with "invalid argument: limit below 1".
    export let split_limit = func(string s, string separator, int limit) -> string[list] {
        if (limit < 1) {
            trap_with_message("invalid argument: limit below 1");
        }
        return split_pieces(s, separator, limit);
    };

    // Splits at LF. A CR immediately before an LF is removed, and the empty
    // piece after a final LF is dropped. The empty string gives one empty
    // line, as split does.
    export let lines = func(string s) -> string[list] {
        let pieces: string[list] = [];
        let length = s.byte_length;
        let start = 0;
        let i = 0;
        while (i < length) {
            if (s.byte_at(i) == 10) {
                let end = i;
                if (end > start && s.byte_at(end - 1) == 13) {
                    end = end - 1;
                }
                pieces.append(s.slice(start, end));
                start = i + 1;
            }
            i = i + 1;
        }
        if (start < length || length == 0) {
            pieces.append(s.slice(start, length));
        }
        return pieces;
    };

    // The parts with the separator between each pair.
    export let join = func(string[list] parts, string separator) -> string {
        let count = parts.length;
        if (count == 0) {
            return "";
        }
        if (count == 1) {
            return parts[0];
        }
        let bytes: uint8[list] = [];
        let has_separator = separator.byte_length > 0;
        let k = 0;
        while (k < count) {
            if (k > 0 && has_separator) {
                append_bytes(bytes, separator, 0, separator.byte_length);
            }
            let part = parts[k];
            append_bytes(bytes, part, 0, part.byte_length);
            k = k + 1;
        }
        return text_of(bytes);
    };

    // `count` copies of the string. A negative count traps with "invalid
    // argument: negative count".
    export let repeat = func(string s, int count) -> string {
        if (count < 0) {
            trap_with_message("invalid argument: negative count");
        }
        if (count == 0 || s.byte_length == 0) {
            return "";
        }
        if (count == 1) {
            return s;
        }
        let bytes: uint8[list] = [];
        let k = 0;
        while (k < count) {
            append_bytes(bytes, s, 0, s.byte_length);
            k = k + 1;
        }
        return text_of(bytes);
    };

    // Removes space, tab, LF, vertical tab, form feed, and CR from both
    // ends.
    export let trim = func(string s) -> string {
        let end = trimmed_end(s);
        let start = 0;
        while (start < end && is_space(s.byte_at(start))) {
            start = start + 1;
        }
        return s.slice(start, end);
    };

    export let trim_start = func(string s) -> string {
        let length = s.byte_length;
        let start = 0;
        while (start < length && is_space(s.byte_at(start))) {
            start = start + 1;
        }
        return s.slice(start, length);
    };

    export let trim_end = func(string s) -> string {
        return s.slice(0, trimmed_end(s));
    };

    // The rest of the string when it starts with the prefix.
    export let strip_prefix = func(string s, string prefix) -> optional.Optional<string> {
        if (matches_at(s, prefix, 0)) {
            return optional.Optional<string>.Some(s.slice(prefix.byte_length, s.byte_length));
        }
        return optional.Optional<string>.None;
    };

    // The start of the string when it ends with the suffix.
    export let strip_suffix = func(string s, string suffix) -> optional.Optional<string> {
        let start = s.byte_length - suffix.byte_length;
        if (start >= 0 && matches_at(s, suffix, start)) {
            return optional.Optional<string>.Some(s.slice(0, start));
        }
        return optional.Optional<string>.None;
    };

    // Replaces every non-overlapping occurrence, left to right. An empty
    // target traps with "invalid argument: empty target".
    export let replace = func(string s, string target, string replacement) -> string {
        return replace_up_to(s, target, replacement, 2147483647);
    };

    // Replaces the first occurrence. An empty target traps as in replace.
    export let replace_first = func(string s, string target, string replacement) -> string {
        return replace_up_to(s, target, replacement, 1);
    };

    // a through z become A through Z; every other byte is unchanged.
    export let to_ascii_upper = func(string s) -> string {
        return map_ascii_letters(s, 97, 122, -32);
    };

    // A through Z become a through z; every other byte is unchanged.
    export let to_ascii_lower = func(string s) -> string {
        return map_ascii_letters(s, 65, 90, 32);
    };

    // Equal after mapping A through Z to a through z in both strings.
    export let equals_ignore_ascii_case = func(string a, string b) -> bool {
        if (a == b) {
            return true;
        }
        let length = a.byte_length;
        if (length != b.byte_length) {
            return false;
        }
        let i = 0;
        while (i < length) {
            let x = a.byte_at(i);
            let y = b.byte_at(i);
            if (x != y && fold(x) != fold(y)) {
                return false;
            }
            i = i + 1;
        }
        return true;
    };

    // Copies of `pad` before the string until it has `width` scalar values.
    // `pad` must be exactly one scalar value; otherwise the call traps with
    // "invalid argument: pad is not one scalar value".
    export let pad_start = func(string s, int width, string pad) -> string {
        let missing = padding(s, width, pad);
        if (missing == 0) {
            return s;
        }
        let bytes: uint8[list] = [];
        append_copies(bytes, pad, missing);
        append_bytes(bytes, s, 0, s.byte_length);
        return text_of(bytes);
    };

    // Copies of `pad` after the string, with the rules of pad_start.
    export let pad_end = func(string s, int width, string pad) -> string {
        let missing = padding(s, width, pad);
        if (missing == 0) {
            return s;
        }
        let bytes: uint8[list] = [];
        append_bytes(bytes, s, 0, s.byte_length);
        append_copies(bytes, pad, missing);
        return text_of(bytes);
    };

    // The scalar values in reverse order.
    export let reverse = func(string s) -> string {
        let length = s.byte_length;
        let bytes: uint8[list] = [];
        let end = length;
        let i = length - 1;
        while (i >= 0) {
            if ((s.byte_at(i) & 192) != 128) {
                append_bytes(bytes, s, i, end);
                end = i;
            }
            i = i - 1;
        }
        return text_of(bytes);
    };

    // A copy of the UTF-8 bytes.
    export let to_bytes = func(string s) -> uint8[list] {
        let bytes: uint8[list] = [];
        append_bytes(bytes, s, 0, s.byte_length);
        return bytes;
    };

    // The text the bytes encode, or an Encoding error whose offset is the
    // start of the first ill-formed sequence (the length of the longest
    // valid prefix). Its message is "invalid start byte", "invalid
    // continuation byte", or "unexpected end of data".
    export let from_bytes = func(uint8[list] bytes) -> result.Result<string> {
        let [valid, text] = string.from_utf8(bytes);
        if (valid) {
            return result.Result<string>.Ok(text);
        }
        let length = bytes.length;
        let i = 0;
        while (i < length) {
            let size = valid_length(bytes, i);
            if (size <= 0) {
                return result.Result<string>.Err(error.Error.Encoding {
                    offset: i,
                    message: invalid_message(bytes, i, -size),
                });
            }
            i = i + size;
        }
        trap_with_message("invalid state: UTF-8 validators disagree");
    };

    // The text the bytes encode, with each maximal ill-formed subsequence
    // (Unicode's "maximal subpart" practice) replaced by one U+FFFD.
    export let from_bytes_lossy = func(uint8[list] bytes) -> string {
        let [valid, text] = string.from_utf8(bytes);
        if (valid) {
            return text;
        }
        let output: uint8[list] = [];
        let length = bytes.length;
        let i = 0;
        while (i < length) {
            let size = valid_length(bytes, i);
            if (size > 0) {
                let end = i + size;
                while (i < end) {
                    output.append(bytes[i]);
                    i = i + 1;
                }
            } else {
                output.append(239);
                output.append(191);
                output.append(189);
                i = i - size;
            }
        }
        return text_of(output);
    };

    // The text of the scalar values. A surrogate or a value above 0x10FFFF
    // traps with "invalid argument: not a Unicode scalar value".
    export let from_scalars = func(uint32[list] values) -> string {
        let bytes: uint8[list] = [];
        for (let value in values) {
            append_scalar(bytes, value);
        }
        return text_of(bytes);
    };

    // Internal helpers.

    // The scalar value of the well-formed sequence starting at the offset.
    let decode = func(string s, int offset) -> uint32 {
        let lead = s.byte_at(offset) as uint32;
        if (lead < 128) {
            return lead;
        }
        if (lead < 224) {
            return ((lead & 31) << 6) | ((s.byte_at(offset + 1) as uint32) & 63);
        }
        if (lead < 240) {
            return ((lead & 15) << 12) | (((s.byte_at(offset + 1) as uint32) & 63) << 6)
                | ((s.byte_at(offset + 2) as uint32) & 63);
        }
        return ((lead & 7) << 18) | (((s.byte_at(offset + 1) as uint32) & 63) << 12)
            | (((s.byte_at(offset + 2) as uint32) & 63) << 6) | ((s.byte_at(offset + 3) as uint32) & 63);
    };

    // The length of the sequence a lead byte of valid text starts.
    let sequence_length = func(uint8 lead) -> int {
        if (lead < 128) {
            return 1;
        }
        if (lead < 224) {
            return 2;
        }
        if (lead < 240) {
            return 3;
        }
        return 4;
    };

    // Whether the needle's bytes occur at the offset. A candidate whose end
    // is not a boundary cannot match, so the slice compared is always valid.
    let matches_at = func(string s, string needle, int offset) -> bool {
        let end = offset + needle.byte_length;
        if (end > s.byte_length) {
            return false;
        }
        if (end < s.byte_length && (s.byte_at(end) & 192) == 128) {
            return false;
        }
        if (offset < s.byte_length && (s.byte_at(offset) & 192) == 128) {
            return false;
        }
        return s.slice(offset, end) == needle;
    };

    // The first occurrence at or after `from`: scan for the needle's first
    // byte, then compare the candidate.
    let find = func(string s, string needle, int from) -> int {
        let n = needle.byte_length;
        if (n == 0) {
            return from;
        }
        let last = s.byte_length - n;
        let first = needle.byte_at(0);
        let i = from;
        while (i <= last) {
            if (s.byte_at(i) == first) {
                if (n == 1 || matches_at(s, needle, i)) {
                    return i;
                }
            }
            i = i + 1;
        }
        return -1;
    };

    let check_offset = func(string s, int offset) -> void {
        if (offset < 0 || offset > s.byte_length) {
            trap_with_message("invalid argument: offset out of range");
        }
        if (offset < s.byte_length && (s.byte_at(offset) & 192) == 128) {
            trap_with_message("invalid argument: offset is not a character boundary");
        }
    };

    let split_pieces = func(string s, string separator, int limit) -> string[list] {
        let n = separator.byte_length;
        if (n == 0) {
            trap_with_message("invalid argument: empty separator");
        }
        let pieces: string[list] = [];
        let start = 0;
        let remaining = limit - 1;
        while (remaining > 0) {
            let found = find(s, separator, start);
            if (found < 0) {
                break;
            }
            pieces.append(s.slice(start, found));
            start = found + n;
            remaining = remaining - 1;
        }
        pieces.append(s.slice(start, s.byte_length));
        return pieces;
    };

    let replace_up_to = func(string s, string target, string replacement, int limit) -> string {
        let n = target.byte_length;
        if (n == 0) {
            trap_with_message("invalid argument: empty target");
        }
        let found = find(s, target, 0);
        if (found < 0) {
            return s;
        }
        let bytes: uint8[list] = [];
        let start = 0;
        let remaining = limit;
        while (found >= 0 && remaining > 0) {
            append_bytes(bytes, s, start, found);
            append_bytes(bytes, replacement, 0, replacement.byte_length);
            start = found + n;
            remaining = remaining - 1;
            if (remaining > 0) {
                found = find(s, target, start);
            }
        }
        append_bytes(bytes, s, start, s.byte_length);
        return text_of(bytes);
    };

    // Copies s with every byte from `low` through `high` shifted by
    // `delta`. Returns s itself when no byte changes.
    let map_ascii_letters = func(string s, uint8 low, uint8 high, int delta) -> string {
        let length = s.byte_length;
        let i = 0;
        while (i < length) {
            let b = s.byte_at(i);
            if (b >= low && b <= high) {
                break;
            }
            i = i + 1;
        }
        if (i == length) {
            return s;
        }
        let bytes: uint8[list] = [];
        append_bytes(bytes, s, 0, i);
        while (i < length) {
            let b = s.byte_at(i);
            if (b >= low && b <= high) {
                b = ((b as int) + delta) as uint8;
            }
            bytes.append(b);
            i = i + 1;
        }
        return text_of(bytes);
    };

    let fold = func(uint8 b) -> uint8 {
        if (b >= 65 && b <= 90) {
            return b + 32;
        }
        return b;
    };

    // The number of pad copies needed; traps unless pad is one scalar.
    let padding = func(string s, int width, string pad) -> int {
        let pad_length = pad.byte_length;
        if (pad_length == 0 || sequence_length(pad.byte_at(0)) != pad_length) {
            trap_with_message("invalid argument: pad is not one scalar value");
        }
        let missing = width - scalar_count(s);
        if (missing < 0) {
            return 0;
        }
        return missing;
    };

    let append_copies = func(uint8[list] bytes, string pad, int count) -> void {
        let k = 0;
        while (k < count) {
            append_bytes(bytes, pad, 0, pad.byte_length);
            k = k + 1;
        }
    };

    let is_space = func(uint8 b) -> bool {
        return b == 32 || (b >= 9 && b <= 13);
    };

    let trimmed_end = func(string s) -> int {
        let end = s.byte_length;
        while (end > 0 && is_space(s.byte_at(end - 1))) {
            end = end - 1;
        }
        return end;
    };

    // Appends the bytes of s from `start` up to `end`, four at a time where
    // possible.
    let append_bytes = func(uint8[list] bytes, string s, int start, int end) -> void {
        let i = start;
        while (i + 4 <= end) {
            bytes.append(s.byte_at(i));
            bytes.append(s.byte_at(i + 1));
            bytes.append(s.byte_at(i + 2));
            bytes.append(s.byte_at(i + 3));
            i = i + 4;
        }
        while (i < end) {
            bytes.append(s.byte_at(i));
            i = i + 1;
        }
    };

    // Text from bytes this module built from whole characters.
    let text_of = func(uint8[list] bytes) -> string {
        let [valid, text] = string.from_utf8(bytes);
        if (!valid) {
            trap_with_message("invalid state: built text is not UTF-8");
        }
        return text;
    };

    let append_scalar = func(uint8[list] bytes, uint32 value) -> void {
        if (value < 128) {
            bytes.append(value as uint8);
        } else if (value < 2048) {
            bytes.append((192 | (value >> 6)) as uint8);
            bytes.append((128 | (value & 63)) as uint8);
        } else if (value < 65536) {
            if (value >= 55296 && value <= 57343) {
                trap_with_message("invalid argument: not a Unicode scalar value");
            }
            bytes.append((224 | (value >> 12)) as uint8);
            bytes.append((128 | ((value >> 6) & 63)) as uint8);
            bytes.append((128 | (value & 63)) as uint8);
        } else {
            if (value > 1114111) {
                trap_with_message("invalid argument: not a Unicode scalar value");
            }
            bytes.append((240 | (value >> 18)) as uint8);
            bytes.append((128 | ((value >> 12) & 63)) as uint8);
            bytes.append((128 | ((value >> 6) & 63)) as uint8);
            bytes.append((128 | (value & 63)) as uint8);
        }
    };

    // The length of the well-formed sequence at `i`, or the negated length
    // of the maximal subpart of an ill-formed one (Unicode Table 3-7).
    let valid_length = func(uint8[list] bytes, int i) -> int {
        let lead = bytes[i];
        if (lead < 128) {
            return 1;
        }
        let size = 0;
        let low: uint8 = 128;
        let high: uint8 = 191;
        if (lead >= 194 && lead <= 223) {
            size = 2;
        } else if (lead >= 224 && lead <= 239) {
            size = 3;
            if (lead == 224) {
                low = 160;
            } else if (lead == 237) {
                high = 159;
            }
        } else if (lead >= 240 && lead <= 244) {
            size = 4;
            if (lead == 240) {
                low = 144;
            } else if (lead == 244) {
                high = 143;
            }
        } else {
            return -1;
        }
        let length = bytes.length;
        let k = 1;
        while (k < size) {
            if (i + k >= length) {
                return -k;
            }
            let next = bytes[i + k];
            if (next < low || next > high) {
                return -k;
            }
            low = 128;
            high = 191;
            k = k + 1;
        }
        return size;
    };

    // Why the ill-formed subpart of `size` bytes at `i` is invalid.
    let invalid_message = func(uint8[list] bytes, int i, int size) -> string {
        let lead = bytes[i];
        if (lead < 194 || lead > 244) {
            return "invalid start byte";
        }
        if (i + size >= bytes.length) {
            return "unexpected end of data";
        }
        return "invalid continuation byte";
    };
);
