let encoding_kernels = import:Std.Internal.Kernels.Encoding;
let hash_kernels = import:Std.Internal.Kernels.Hash;
let kernel_status = import:Std.Core.Internal.KernelStatus;
let optional = import:Std.Core.Optional;
let ordering = import:Std.Core.Ordering;
let result = import:Std.Core.Result;
let text_kernels = import:Std.Internal.Kernels.Text;

/// @brief Functions on immutable UTF-8 strings (Stdlib.md section 8.1).
///
/// Every position is a byte offset of type int. Members that read or slice at an offset let the built-in text
/// operation trap; the other offset checks trap with "invalid argument: offset out of range" or "invalid
/// argument: offset is not a character boundary".
///
/// Cost model: byte_at, slice, ==, and string.from_utf8 are single NVM operations; concatenation copies every
/// byte. The searches, comparisons, trims, splits, replacements, ASCII case mappings, scalar count, hash, and
/// UTF-8 check run on the built-in kernels of neura_text.h, neura_hash.h, and neura_encoding.h
/// (docs/runtime/Kernels.md), which keep the results and traps of the Neura code they replaced; that code is the
/// oracle of tests/stdlib/strings/kernel-oracle.nra. The other members compare candidates with slice and ==,
/// build results from slices where they can, and build new text in one uint8 list converted once.
/// @see [Std.Text.Strings](https://github.com/Kayyo321/neura/wiki/Stdlib-Text-Strings)
#Since("0.1.0")
export let Strings = module (
    /// @brief Constant time.
    #[Pure, ThreadSafe]
    export let byte_length = func(s: string) -> int => s.byte_length;

    /// @brief The number of bytes that are not continuation bytes. Linear.
    #[Pure, ThreadSafe]
    export let scalar_count = func(s: string) -> int => encoding_kernels.utf8_scalar_count(s) as int;

    /// @brief Tests whether the string has zero bytes.
    #[Pure, ThreadSafe]
    export let is_empty = func(s: string) -> bool => s.byte_length == 0;

    /// @brief The byte at the offset; the built-in read traps outside the string.
    #[Pure, ThreadSafe]
    export let byte_at = func(s: string, offset: int) -> uint8 => s.byte_at(offset);

    /// @brief The scalar value of the character starting at the offset.
    ///
    /// An offset outside the string is a built-in bounds trap; a continuation byte traps with "invalid
    /// argument: offset is not a character boundary".
    #[Pure, ThreadSafe]
    export let scalar_at = func(s: string, offset: int) -> uint32 {
        if ((s.byte_at(offset) & 192) == 128) {
            trap_with_message("invalid argument: offset is not a character boundary");
        }
        return decode(s, offset);
    };

    /// @brief True for 0, for the byte length, and for every offset whose byte is not a continuation byte;
    /// false outside 0 through the byte length.
    #[Pure, ThreadSafe]
    export let is_boundary = func(s: string, offset: int) -> bool {
        if (offset < 0 || offset > s.byte_length) {
            return false;
        }
        return offset == s.byte_length || (s.byte_at(offset) & 192) != 128;
    };

    /// @brief The scalar values in order.
    #[Pure, ThreadSafe]
    export let scalars = func(s: string) -> uint32[list] {
        last values: uint32[list] = [];
        last length = s.byte_length;
        let i = 0;
        while (i < length) {
            last lead = s.byte_at(i);
            values.append(decode(s, i));
            i = i + sequence_length(lead);
        }
        return values;
    };

    /// @brief Each character's starting offset with its scalar value.
    #[Pure, ThreadSafe]
    export let scalar_offsets = func(s: string) -> [int, uint32][list] {
        last values: [int, uint32][list] = [];
        last length = s.byte_length;
        let i = 0;
        while (i < length) {
            last lead = s.byte_at(i);
            values.append([i, decode(s, i)]);
            i = i + sequence_length(lead);
        }
        return values;
    };

    /// @brief The built-in slice: both ends on boundaries and start not above end.
    #[Pure, ThreadSafe]
    export let slice = func(s: string, start: int, end: int) -> string => s.slice(start, end);

    /// @brief Returns the suffix beginning at a UTF-8 byte boundary.
    #[Pure, ThreadSafe]
    export let slice_from = func(s: string, start: int) -> string => s.slice(start, s.byte_length);

    /// @brief Same bytes (Stdlib.md section 5.2).
    #[Pure, ThreadSafe]
    export let equals = func(a: string, b: string) -> bool => a == b;

    /// @brief Start with 0; for each byte, 31 times the hash plus the byte, wrapping.
    #[Pure, ThreadSafe]
    export let hash = func(s: string) -> uint32 => hash_kernels.string(s);

    /// @brief Byte-wise lexicographic order; a proper prefix sorts first. This is also the order of the scalar
    /// values.
    #[Pure, ThreadSafe]
    export let compare = func(a: string, b: string) -> ordering.Ordering {
        last order = text_kernels.compare(a, b);
        if (order < 0) {
            return ordering.Ordering.Less;
        }
        if (order > 0) {
            return ordering.Ordering.Greater;
        }
        return ordering.Ordering.Equal;
    };

    /// @brief Tests whether the string starts with the literal prefix.
    #[Pure, ThreadSafe]
    export let starts_with = func(s: string, prefix: string) -> bool => text_kernels.starts_with(s, prefix);

    /// @brief Tests whether the string ends with the literal suffix.
    #[Pure, ThreadSafe]
    export let ends_with = func(s: string, suffix: string) -> bool => text_kernels.ends_with(s, suffix);

    /// @brief Tests whether the literal needle occurs anywhere in the string.
    #[Pure, ThreadSafe]
    export let contains = func(s: string, needle: string) -> bool => text_kernels.contains(s, needle);

    /// @brief The offset of the first occurrence, or -1. An empty needle matches at 0.
    #[Pure, ThreadSafe]
    export let index_of = func(s: string, needle: string) -> int => search(s, needle, 0);

    /// @brief The offset of the first occurrence at or after `from`, or -1. An empty needle matches at `from`.
    /// `from` must be a boundary from 0 through the byte length.
    ///
    /// Linear in the distance searched: a loop that calls it with `from` after each occurrence is linear in
    /// the text.
    #[Pure, ThreadSafe]
    export let index_of_from = func(s: string, needle: string, from: int) -> int => search(s, needle, from);

    /// @brief The offset of the last occurrence, or -1. An empty needle matches at the byte length.
    #[Pure, ThreadSafe]
    export let last_index_of = func(s: string, needle: string) -> int =>
        text_kernels.last_index_of(s, needle) as int;

    /// @brief Every piece between non-overlapping occurrences of the separator, left to right.
    ///
    /// Empty pieces are kept; the empty string gives one piece. An empty separator traps with "invalid
    /// argument: empty separator".
    #[Pure, ThreadSafe]
    export let split = func(s: string, separator: string) -> string[list] =>
        split_pieces(s, separator, 2147483647);

    /// @brief As split, with at most `limit` pieces; the last piece holds the rest. A limit below 1 traps with
    /// "invalid argument: limit below 1".
    #[Pure, ThreadSafe]
    export let split_limit = func(s: string, separator: string, limit: int) -> string[list] {
        if (limit < 1) {
            trap_with_message("invalid argument: limit below 1");
        }
        return split_pieces(s, separator, limit);
    };

    /// @brief Splits at LF. A CR immediately before an LF is removed, and the empty piece after a final LF is
    /// dropped. The empty string gives one empty line, as split does.
    #[Pure, ThreadSafe]
    export let lines = func(s: string) -> string[list] {
        last pieces: string[list] = [];
        last length = s.byte_length;
        let start = 0;
        for (let found in separators(s, "\n", 2147483647)) {
            let end = found as int;
            if (end > start && s.byte_at(end - 1) == 13) {
                end -= 1;
            }
            pieces.append(s.slice(start, end));
            start = found as int + 1;
        }
        if (start < length || length == 0) {
            pieces.append(s.slice(start, length));
        }
        return pieces;
    };

    /// @brief The parts with the separator between each pair.
    #[Pure, ThreadSafe]
    export let join = func(parts: string[list], separator: string) -> string {
        last count = parts.length;
        if (count == 0) {
            return "";
        }
        if (count == 1) {
            return parts[0];
        }
        last bytes: uint8[list] = [];
        last has_separator = separator.byte_length > 0;
        let k = 0;
        while (k < count) {
            if (k > 0 && has_separator) {
                append_bytes(bytes, separator, 0, separator.byte_length);
            }
            last part = parts[k];
            append_bytes(bytes, part, 0, part.byte_length);
            k += 1;
        }
        return text_of(bytes);
    };

    /// @brief `count` copies of the string. A negative count traps with "invalid argument: negative count".
    #[NoDiscard, Pure, ThreadSafe]
    export let repeat = func(s: string, count: int) -> string {
        if (count < 0) {
            trap_with_message("invalid argument: negative count");
        }
        if (count == 0 || s.byte_length == 0) {
            return "";
        }
        if (count == 1) {
            return s;
        }
        last bytes: uint8[list] = [];
        let k = 0;
        while (k < count) {
            append_bytes(bytes, s, 0, s.byte_length);
            k += 1;
        }
        return text_of(bytes);
    };

    /// @brief Removes space, tab, LF, vertical tab, form feed, and CR from both ends.
    #[NoDiscard, Pure, ThreadSafe]
    export let trim = func(s: string) -> string {
        last end = text_kernels.space_suffix_start(s) as int;
        let start = text_kernels.space_prefix_length(s) as int;
        if (start > end) {
            start = end;
        }
        return s.slice(start, end);
    };

    /// @brief Removes ASCII space and bytes 9 through 13 from the start.
    #[NoDiscard, Pure, ThreadSafe]
    export let trim_start = func(s: string) -> string =>
        s.slice(text_kernels.space_prefix_length(s) as int, s.byte_length);

    /// @brief Removes ASCII space and bytes 9 through 13 from the end.
    #[NoDiscard, Pure, ThreadSafe]
    export let trim_end = func(s: string) -> string => s.slice(0, text_kernels.space_suffix_start(s) as int);

    /// @brief The rest of the string when it starts with the prefix.
    #[NoDiscard, Pure, ThreadSafe]
    export let strip_prefix = func(s: string, prefix: string) -> optional.Optional<string> {
        if (text_kernels.starts_with(s, prefix)) {
            return optional.Optional<string>.Some(s.slice(prefix.byte_length, s.byte_length));
        }
        return optional.Optional<string>.None;
    };

    /// @brief The start of the string when it ends with the suffix.
    #[NoDiscard, Pure, ThreadSafe]
    export let strip_suffix = func(s: string, suffix: string) -> optional.Optional<string> {
        if (text_kernels.ends_with(s, suffix)) {
            return optional.Optional<string>.Some(s.slice(0, s.byte_length - suffix.byte_length));
        }
        return optional.Optional<string>.None;
    };

    /// @brief Replaces every non-overlapping occurrence, left to right. An empty target traps with "invalid
    /// argument: empty target".
    #[NoDiscard, Pure, ThreadSafe]
    export let replace = func(s: string, target: string, replacement: string) -> string =>
        text_kernels.replace(s, target, replacement, 2147483647);

    /// @brief Replaces the first occurrence. An empty target traps as in replace.
    #[NoDiscard, Pure, ThreadSafe]
    export let replace_first = func(s: string, target: string, replacement: string) -> string =>
        text_kernels.replace(s, target, replacement, 1);

    /// @brief a through z become A through Z; every other byte is unchanged.
    #[NoDiscard, Pure, ThreadSafe]
    export let to_ascii_upper = func(s: string) -> string => text_kernels.ascii_upper(s);

    /// @brief A through Z become a through z; every other byte is unchanged.
    #[NoDiscard, Pure, ThreadSafe]
    export let to_ascii_lower = func(s: string) -> string => text_kernels.ascii_lower(s);

    /// @brief Equal after mapping A through Z to a through z in both strings.
    #[Pure, ThreadSafe]
    export let equals_ignore_ascii_case = func(a: string, b: string) -> bool =>
        a == b ||
        (a.byte_length == b.byte_length && text_kernels.ascii_lower(a) == text_kernels.ascii_lower(b));

    /// @brief Copies of `pad` before the string until it has `width` scalar values. `pad` must be exactly one
    /// scalar value; otherwise the call traps with "invalid argument: pad is not one scalar value".
    #[NoDiscard, Pure, ThreadSafe]
    export let pad_start = func(s: string, width: int, pad: string) -> string {
        last missing = padding(s, width, pad);
        if (missing == 0) {
            return s;
        }
        last bytes: uint8[list] = [];
        append_copies(bytes, pad, missing);
        append_bytes(bytes, s, 0, s.byte_length);
        return text_of(bytes);
    };

    /// @brief Copies of `pad` after the string, with the rules of pad_start.
    #[NoDiscard, Pure, ThreadSafe]
    export let pad_end = func(s: string, width: int, pad: string) -> string {
        last missing = padding(s, width, pad);
        if (missing == 0) {
            return s;
        }
        last bytes: uint8[list] = [];
        append_bytes(bytes, s, 0, s.byte_length);
        append_copies(bytes, pad, missing);
        return text_of(bytes);
    };

    /// @brief The scalar values in reverse order.
    #[NoDiscard, Pure, ThreadSafe]
    export let reverse = func(s: string) -> string {
        last length = s.byte_length;
        last bytes: uint8[list] = [];
        let end = length;
        let i = length - 1;
        while (i >= 0) {
            if ((s.byte_at(i) & 192) != 128) {
                append_bytes(bytes, s, i, end);
                end = i;
            }
            i -= 1;
        }
        return text_of(bytes);
    };

    /// @brief A copy of the UTF-8 bytes.
    #[Pure, ThreadSafe]
    export let to_bytes = func(s: string) -> uint8[list] {
        last bytes: uint8[list] = [];
        append_bytes(bytes, s, 0, s.byte_length);
        return bytes;
    };

    /// @brief The text the bytes encode, or an Encoding error whose offset is the start of the first ill-formed
    /// sequence (the length of the longest valid prefix).
    ///
    /// Its message is "invalid start byte", "invalid continuation byte", or "unexpected end of data".
    #[NoDiscard, Pure, ThreadSafe]
    export let from_bytes = func(bytes: uint8[list]) -> result.Result<string> {
        let [valid, text] = string.from_utf8(bytes);
        if (valid) {
            return result.Result<string>.Ok(text);
        }
        let [status, offset] = encoding_kernels.utf8_check(bytes);
        if (status == kernel_status.Ok) {
            trap_with_message("invalid state: UTF-8 validators disagree");
        }
        return result.Result<string>.Err(kernel_status.encoding_error(status, offset));
    };

    /// @brief The text the bytes encode, with each maximal ill-formed subsequence (Unicode's "maximal subpart"
    /// practice) replaced by one U+FFFD.
    #[NoDiscard, Pure, ThreadSafe]
    export let from_bytes_lossy = func(bytes: uint8[list]) -> string {
        let [valid, text] = string.from_utf8(bytes);
        if (valid) {
            return text;
        }
        last output: uint8[list] = [];
        last length = bytes.length;
        let i = 0;
        while (i < length) {
            last size = valid_length(bytes, i);
            if (size > 0) {
                last end = i + size;
                while (i < end) {
                    output.append(bytes[i]);
                    i += 1;
                }
            } else {
                output.append(239);
                output.append(191);
                output.append(189);
                i -= size;
            }
        }
        return text_of(output);
    };

    /// @brief The text of the scalar values. A surrogate or a value above 0x10FFFF traps with "invalid
    /// argument: not a Unicode scalar value".
    #[Pure, ThreadSafe]
    export let from_scalars = func(values: uint32[list]) -> string {
        last bytes: uint8[list] = [];
        for (let value in values) {
            append_scalar(bytes, value);
        }
        return text_of(bytes);
    };

    // Internal helpers.

    /// @brief The scalar value of the well-formed sequence starting at the offset.
    let decode = func(s: string, offset: int) -> uint32 {
        last lead = s.byte_at(offset) as uint32;
        if (lead < 128) {
            return lead;
        }
        if (lead < 224) {
            return ((lead & 31) << 6) | ((s.byte_at(offset + 1) as uint32) & 63);
        }
        if (lead < 240) {
            return ((lead & 15) << 12) | (((s.byte_at(offset + 1) as uint32) & 63) << 6)
                | ((s.byte_at(offset + 2) as uint32) & 63);
        }
        return ((lead & 7) << 18) | (((s.byte_at(offset + 1) as uint32) & 63) << 12)
            | (((s.byte_at(offset + 2) as uint32) & 63) << 6) | ((s.byte_at(offset + 3) as uint32) & 63);
    };

    /// @brief The length of the sequence a lead byte of valid text starts.
    let sequence_length = func(lead: uint8) -> int {
        if (lead < 128) {
            return 1;
        }
        if (lead < 224) {
            return 2;
        }
        if (lead < 240) {
            return 3;
        }
        return 4;
    };

    /// @brief The first occurrence at or after `from`, searched in windows of the neura.text.index_of kernel
    /// that double in length, so the steps charged grow with the distance covered rather than with the rest of
    /// the text. The kernel checks `from` on the first call; each later call starts at the boundary where the
    /// previous window ended.
    let search = func(s: string, needle: string, from: int) -> int {
        let window: int64 = 128;
        let found = text_kernels.index_of(s, needle, from as int64, window);
        while (found < -1) {
            window *= 2;
            found = text_kernels.index_of(s, needle, -2 - found, window);
        }
        return found as int;
    };

    /// @brief The offsets of the first `limit` non-overlapping occurrences of a separator, left to right: the
    /// neura.text.split kernel counts them, then writes them into a list of that length, built by appending
    /// (a range would compile to a much larger circuit and take more steps). An empty separator traps with
    /// "invalid argument: empty separator".
    let separators = func(s: string, separator: string, limit: int) -> int64[list] {
        last count = text_kernels.split(s, separator, limit as int64, []);
        if (count == 0) {
            return [];
        }
        last offsets: int64[list] = [];
        let k: int64 = 0;
        while (k < count) {
            offsets.append(0);
            k += 1;
        }
        text_kernels.split(s, separator, count, offsets);
        return offsets;
    };

    /// @brief Splits into at most the given number of pieces, leaving the remainder in the final piece.
    let split_pieces = func(s: string, separator: string, limit: int) -> string[list] {
        last n = separator.byte_length;
        last pieces: string[list] = [];
        let start = 0;
        for (let found in separators(s, separator, limit - 1)) {
            pieces.append(s.slice(start, found as int));
            start = found as int + n;
        }
        pieces.append(s.slice(start, s.byte_length));
        return pieces;
    };

    /// @brief The number of pad copies needed; traps unless pad is one scalar.
    let padding = func(s: string, width: int, pad: string) -> int {
        last pad_length = pad.byte_length;
        if (pad_length == 0 || sequence_length(pad.byte_at(0)) != pad_length) {
            trap_with_message("invalid argument: pad is not one scalar value");
        }
        last missing = width - scalar_count(s);
        if (missing < 0) {
            return 0;
        }
        return missing;
    };

    /// @brief Appends the requested number of copies of the pad text.
    let append_copies = func(bytes: uint8[list], pad: string, count: int) {
        let k = 0;
        while (k < count) {
            append_bytes(bytes, pad, 0, pad.byte_length);
            k += 1;
        }
    };

    /// @brief Appends the bytes of s from `start` up to `end`, four at a time where possible.
    let append_bytes = func(bytes: uint8[list], s: string, start: int, end: int) {
        let i = start;
        while (i + 4 <= end) {
            bytes.append(s.byte_at(i));
            bytes.append(s.byte_at(i + 1));
            bytes.append(s.byte_at(i + 2));
            bytes.append(s.byte_at(i + 3));
            i += 4;
        }
        while (i < end) {
            bytes.append(s.byte_at(i));
            i += 1;
        }
    };

    /// @brief Text from bytes this module built from whole characters.
    let text_of = func(bytes: uint8[list]) -> string {
        let [valid, text] = string.from_utf8(bytes);
        if (!valid) {
            trap_with_message("invalid state: built text is not UTF-8");
        }
        return text;
    };

    /// @brief Encodes a scalar into UTF-8 bytes. Invalid scalars trap.
    let append_scalar = func(bytes: uint8[list], value: uint32) {
        if (value < 128) {
            bytes.append(value as uint8);
        } else if (value < 2048) {
            bytes.append((192 | (value >> 6)) as uint8);
            bytes.append((128 | (value & 63)) as uint8);
        } else if (value < 65536) {
            if (value >= 55296 && value <= 57343) {
                trap_with_message("invalid argument: not a Unicode scalar value");
            }
            bytes.append((224 | (value >> 12)) as uint8);
            bytes.append((128 | ((value >> 6) & 63)) as uint8);
            bytes.append((128 | (value & 63)) as uint8);
        } else {
            if (value > 1114111) {
                trap_with_message("invalid argument: not a Unicode scalar value");
            }
            bytes.append((240 | (value >> 18)) as uint8);
            bytes.append((128 | ((value >> 12) & 63)) as uint8);
            bytes.append((128 | ((value >> 6) & 63)) as uint8);
            bytes.append((128 | (value & 63)) as uint8);
        }
    };

    /// @brief The length of the well-formed sequence at `i`, or the negated length of the maximal subpart of an
    /// ill-formed one (Unicode Table 3-7).
    let valid_length = func(bytes: uint8[list], i: int) -> int {
        last lead = bytes[i];
        if (lead < 128) {
            return 1;
        }
        let size = 0;
        let low: uint8 = 128;
        let high: uint8 = 191;
        if (lead >= 194 && lead <= 223) {
            size = 2;
        } else if (lead >= 224 && lead <= 239) {
            size = 3;
            if (lead == 224) {
                low = 160;
            } else if (lead == 237) {
                high = 159;
            }
        } else if (lead >= 240 && lead <= 244) {
            size = 4;
            if (lead == 240) {
                low = 144;
            } else if (lead == 244) {
                high = 143;
            }
        } else {
            return -1;
        }
        last length = bytes.length;
        let k = 1;
        while (k < size) {
            if (i + k >= length) {
                return -k;
            }
            last next = bytes[i + k];
            if (next < low || next > high) {
                return -k;
            }
            low = 128;
            high = 191;
            k += 1;
        }
        return size;
    };
);
