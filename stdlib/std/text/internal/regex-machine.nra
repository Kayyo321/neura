let parser = import:Std.Text.Internal.RegexParser;

/// @brief The regular expression compiler and Pike machine (Stdlib.md section 8.4).
///
/// A program is a list of instructions; the machine advances every live thread over the input one scalar value
/// at a time, in priority order, with at most one thread per instruction per position, so matching takes time
/// proportional to the program size times the input length and never backtracks. Each thread carries its own
/// capture slots; slot 2k is the start and slot 2k + 1 the end of group k, -1 when unset. The slots after the
/// groups' slots hold the entry positions of optional copies of an item that can match empty: Progress(slot) is
/// an assertion that holds when the position has moved since that save (see compile_repeat). A Class carries
/// its sorted ranges and, for ASCII scalars, a 128-bit membership set with the negation already applied.
export let RegexMachine = module (
    /// @brief Represents consuming instructions, prioritized branches, captures, assertions, progress checks,
    /// and completion.
    export let Inst = enum (
        Scalar(uint32),
        Any,
        Class { ranges: uint32[list], negated: bool, ascii: uint32[list] },
        Split { first: int, second: int },
        Jump(int),
        Save(int),
        Assert(parser.Anchor),
        Progress(int),
        Match
    );

    /// @brief Search modes: the leftmost match with backtracking priority; whether any match exists; a match of
    /// the whole input from the start offset.
    export const Leftmost: int = 0;
    /// @brief Selects the earliest successful match for an existence check.
    export const Earliest: int = 1;
    /// @brief Requires a match to consume the whole input from the start offset.
    export const Whole: int = 2;

    /// @brief A compiled program with the scratch state the machine reuses between searches. `first_bytes`
    /// lists the bytes that can begin a match when `can_skip` holds; `anchored` means a match can only start at
    /// offset 0.
    #Final
    export let Program = class (
        /// @brief The option bits captured at compile time.
        export let options: int = 0;
        /// @brief The compiled instruction sequence.
        export let insts: Inst[list] = [];
        /// @brief The count of capture and progress slots.
        export let slot_count: int = 2;
        /// @brief The table of candidate first bytes used to skip ahead in the input.
        export let first_bytes: bool[list] = [];
        /// @brief Whether the search may skip bytes that cannot start a match.
        export let can_skip: bool = false;
        /// @brief Whether the program requires a match at the start of the input.
        export let anchored: bool = false;
        /// @brief The last visited generation for each program counter.
        export let marks: int[list] = [];
        /// @brief The generation used to deduplicate threads at the current input position.
        export let generation: int = 0;
        /// @brief The work stack of program counters for pending epsilon transitions.
        export let stack_pcs: int[list] = [];
        /// @brief The capture-slot lists corresponding to the pending program counters.
        export let stack_caps: (int[list])[list] = [];
    );

    /// @brief Compiles a syntax tree with `groups` capturing groups.
    #Pure
    export let compile = func(root: parser.Node, groups: int, ignore_case: bool, multi_line: bool, dot_all: bool) -> Program {
        last compiler = new Compiler(ignore_case, multi_line, dot_all, 2 * groups + 2);
        compiler.emit(Inst.Save(0));
        compiler.compile(root);
        compiler.emit(Inst.Save(1));
        compiler.emit(Inst.Match);
        last program = new Program();
        program.options = (ignore_case ? 1 : 0) | (multi_line ? 2 : 0) | (dot_all ? 4 : 0);
        program.insts = compiler.insts;
        program.slot_count = compiler.next_slot;
        let k = 0;
        while (k < program.insts.length) {
            program.marks.append(-1);
            k += 1;
        }
        analyze_start(program);
        return program;
    };

    /// @brief Emits instructions and allocates capture and progress slots for a parsed tree.
    #Final
    let Compiler = class (
        /// @brief The instructions emitted so far.
        export let insts: Inst[list] = [];
        /// @brief Whether literal and class instructions fold ASCII case.
        last fold_case: bool;
        /// @brief Whether text anchors compile as line anchors.
        last line_anchors: bool;
        /// @brief Whether dot matches LF.
        last any_newline: bool;
        /// @brief The next available slot for a repeat progress check.
        export let next_slot: int = 2;

        /// @brief Initializes compiler options and the first available progress slot.
        export let init = func(ignore_case: bool, multi_line: bool, dot_all: bool, first_free_slot: int) {
            fold_case = ignore_case;
            line_anchors = multi_line;
            any_newline = dot_all;
            next_slot = first_free_slot;
        };

        /// @brief Appends an instruction and returns its program counter.
        export let emit = func(inst: Inst) -> int {
            insts.append(inst);
            return insts.length - 1;
        };

        /// @brief Compiles a syntax node, preserving alternative priority and capture boundaries.
        export let compile = func(node: parser.Node) {
            match (node) {
                parser.Node.Empty => {},
                parser.Node.Literal(value) => {
                    if (fold_case && ((value >= 65 && value <= 90) || (value >= 97 && value <= 122))) {
                        last upper = value & 4294967263;
                        emit(class_of([upper, upper, upper + 32, upper + 32], false));
                    } else {
                        emit(Inst.Scalar(value));
                    }
                },
                parser.Node.Any => {
                    if (any_newline) {
                        emit(Inst.Any);
                    } else {
                        emit(class_of([10, 10], true));
                    }
                },
                parser.Node.Class { ranges, negated } => {
                    emit(class_of(normalize(ranges, fold_case), negated));
                },
                parser.Node.Concat(items) => {
                    for (let item in items) {
                        compile(item);
                    }
                },
                parser.Node.Alternate(branches) => {
                    last jumps: int[list] = [];
                    last final_branch = branches.length - 1;
                    let k = 0;
                    while (k < final_branch) {
                        last split = emit(Inst.Jump(0));
                        compile(branches[k]);
                        jumps.append(emit(Inst.Jump(0)));
                        insts[split] = Inst.Split { first: split + 1, second: insts.length };
                        k += 1;
                    }
                    compile(branches[final_branch]);
                    for (let jump in jumps) {
                        insts[jump] = Inst.Jump(insts.length);
                    }
                },
                parser.Node.Repeat { item, min, max, greedy } => {
                    compile_repeat(item, min, max, greedy);
                },
                parser.Node.Group { item, index } => {
                    emit(Inst.Save(2 * index));
                    compile(item);
                    emit(Inst.Save(2 * index + 1));
                },
                parser.Node.Assert(anchor) => {
                    let kind = anchor;
                    if (line_anchors && anchor == parser.Anchor.StartText) {
                        kind = parser.Anchor.StartLine;
                    } else if (line_anchors && anchor == parser.Anchor.EndText) {
                        kind = parser.Anchor.EndLine;
                    }
                    emit(Inst.Assert(kind));
                },
            }
        };

        /// @brief x* is split, x, jump back; x+ (after min - 1 copies) is x then a split back; a bounded
        /// repetition is min copies followed by max - min optional copies that all exit to the same end.
        ///
        /// Empty iterations follow ECMAScript's backtracking rule: an iteration beyond the minimum that matches
        /// the empty string fails. In a loop the machine's one-thread-per-instruction rule already does this
        /// (the thread returning to the loop's split at the same position dies); an optional copy of an item
        /// that can match empty saves its entry position and ends with Progress.
        let compile_repeat = func(item: parser.Node, min: int, max: int, greedy: bool) {
            last nullable = parser.nullable(item);
            let copies = min;
            if (max < 0 && min > 0 && !nullable) {
                copies = min - 1;
            }
            let k = 0;
            while (k < copies) {
                compile(item);
                k += 1;
            }
            if (max < 0 && copies == min) {
                last split = emit(Inst.Jump(0));
                compile(item);
                emit(Inst.Jump(split));
                insts[split] = choice(split + 1, insts.length, greedy);
                return;
            }
            if (max < 0) {
                last body = insts.length;
                compile(item);
                emit(choice(body, insts.length + 1, greedy));
                return;
            }
            last guarded = nullable;
            let slot = 0;
            if (guarded && max > min) {
                slot = next_slot;
                next_slot += 1;
            }
            last splits: int[list] = [];
            k = min;
            while (k < max) {
                splits.append(emit(Inst.Jump(0)));
                if (guarded) {
                    emit(Inst.Save(slot));
                    compile(item);
                    emit(Inst.Progress(slot));
                } else {
                    compile(item);
                }
                k += 1;
            }
            last end = insts.length;
            for (let split in splits) {
                insts[split] = choice(split + 1, end, greedy);
            }
        };

        /// @brief Creates a split ordered for greedy or lazy evaluation.
        let choice = func(body: int, exit: int, greedy: bool) -> Inst {
            if (greedy) {
                return Inst.Split { first: body, second: exit };
            }
            return Inst.Split { first: exit, second: body };
        };
    );

    /// @brief A class instruction with its ASCII members as a 128-bit set, so that matching an ASCII scalar is
    /// one read.
    let class_of = func(ranges: uint32[list], negated: bool) -> Inst {
        last ascii: uint32[list] = [0, 0, 0, 0];
        let c: uint32 = 0;
        while (c < 128) {
            if (in_ranges(ranges, c) != negated) {
                last word = (c >> 5) as int;
                ascii[word] = ascii[word] | ((1 as uint32) << (c & 31));
            }
            c += 1;
        }
        return Inst.Class { ranges: ranges, negated: negated, ascii: ascii };
    };

    /// @brief Sorted, merged ranges; with case folding, each ASCII letter range also adds the other case.
    let normalize = func(ranges: uint32[list], fold_case: bool) -> uint32[list] {
        last pairs: uint32[list] = [];
        let k = 0;
        while (k < ranges.length) {
            last low = ranges[k];
            last high = ranges[k + 1];
            pairs.append(low);
            pairs.append(high);
            if (fold_case) {
                add_shifted(pairs, low, high, 65, 90, true);
                add_shifted(pairs, low, high, 97, 122, false);
            }
            k += 2;
        }
        // Insertion sort of the pairs by their low ends.
        last count = pairs.length / 2;
        let i = 1;
        while (i < count) {
            last low = pairs[2 * i];
            last high = pairs[2 * i + 1];
            let j = i - 1;
            while (j >= 0 && pairs[2 * j] > low) {
                pairs[2 * j + 2] = pairs[2 * j];
                pairs[2 * j + 3] = pairs[2 * j + 1];
                j -= 1;
            }
            pairs[2 * j + 2] = low;
            pairs[2 * j + 3] = high;
            i += 1;
        }
        last merged: uint32[list] = [];
        i = 0;
        while (i < count) {
            last low = pairs[2 * i];
            last high = pairs[2 * i + 1];
            last top = merged.length - 1;
            if (top > 0 && low <= merged[top] + 1) {
                if (high > merged[top]) {
                    merged[top] = high;
                }
            } else {
                merged.append(low);
                merged.append(high);
            }
            i += 1;
        }
        return merged;
    };

    /// @brief Adds the part of [low, high] inside [from, to] moved to the other case.
    let add_shifted = func(pairs: uint32[list], low: uint32, high: uint32, from: uint32, to: uint32, up: bool) {
        let a = low;
        if (a < from) {
            a = from;
        }
        let b = high;
        if (b > to) {
            b = to;
        }
        if (a > b) {
            return;
        }
        if (up) {
            pairs.append(a + 32);
            pairs.append(b + 32);
        } else {
            pairs.append(a - 32);
            pairs.append(b - 32);
        }
    };

    /// @brief Finds the bytes that can begin a match, and whether every match must start at offset 0, by
    /// following the epsilon instructions from the start.
    let analyze_start = func(program: Program) {
        last first: bool[list] = [];
        let k = 0;
        while (k < 256) {
            first.append(false);
            k += 1;
        }
        last anchored = !reaches_input(program.insts, first, false);
        last can_skip = !reaches_input(program.insts, first, true);
        program.first_bytes = first;
        program.can_skip = can_skip;
        program.anchored = anchored;
    };

    /// @brief Follows the epsilon instructions from the start.
    ///
    /// Every assertion is passable, except that a text-start assertion stops the walk unless `through_start` is
    /// set. Marks the first bytes of the consuming instructions reached and returns true when a match
    /// instruction or an instruction consuming any scalar is reached (no byte can be ruled out), or, without
    /// `through_start`, when any consuming instruction is.
    let reaches_input = func(insts: Inst[list], first: bool[list], through_start: bool) -> bool {
        last seen: bool[list] = [];
        let k = 0;
        while (k < insts.length) {
            seen.append(false);
            k += 1;
        }
        let open = false;
        last stack: int[list] = [0];
        while (stack.length > 0) {
            last pc = stack[stack.length - 1];
            stack.remove_at(stack.length - 1);
            if (seen[pc]) {
                continue;
            }
            seen[pc] = true;
            match (insts[pc]) {
                Inst.Jump(target) => {
                    stack.append(target);
                },
                Inst.Split { first: a, second: b } => {
                    stack.append(b);
                    stack.append(a);
                },
                Inst.Save(_) => {
                    stack.append(pc + 1);
                },
                Inst.Progress(_) => {
                    stack.append(pc + 1);
                },
                Inst.Assert(kind) => {
                    if (through_start || kind != parser.Anchor.StartText) {
                        stack.append(pc + 1);
                    }
                },
                Inst.Match => {
                    open = true;
                },
                Inst.Any => {
                    open = true;
                },
                Inst.Scalar(value) => {
                    if (!through_start) {
                        open = true;
                    }
                    mark_range(first, value, value);
                },
                Inst.Class { ranges, negated, ascii: _ } => {
                    if (!through_start) {
                        open = true;
                    }
                    if (negated) {
                        mark_complement(first, ranges);
                    } else {
                        let r = 0;
                        while (r < ranges.length) {
                            mark_range(first, ranges[r], ranges[r + 1]);
                            r += 2;
                        }
                    }
                },
            }
        }
        return open;
    };

    /// @brief Marks the first bytes of the UTF-8 encodings of [low, high]. The lead byte grows with the value,
    /// so the leads of the ends bound the rest.
    let mark_range = func(first: bool[list], low: uint32, high: uint32) {
        let a = lead_byte(low);
        last b = lead_byte(high);
        while (a <= b) {
            first[a] = true;
            a += 1;
        }
    };

    /// @brief Marks lead bytes for the complement of the sorted scalar ranges.
    let mark_complement = func(first: bool[list], ranges: uint32[list]) {
        let next: uint32 = 0;
        let r = 0;
        while (r < ranges.length) {
            if (ranges[r] > next) {
                mark_range(first, next, ranges[r] - 1);
            }
            if (ranges[r + 1] >= next) {
                next = ranges[r + 1] + 1;
            }
            r += 2;
        }
        if (next <= 1114111) {
            mark_range(first, next, 1114111);
        }
    };

    /// @brief Returns the UTF-8 lead byte for a scalar.
    let lead_byte = func(value: uint32) -> int {
        if (value < 128) {
            return value as int;
        }
        if (value < 2048) {
            return (192 | (value >> 6)) as int;
        }
        if (value < 65536) {
            return (224 | (value >> 12)) as int;
        }
        return (240 | (value >> 18)) as int;
    };

    /// @brief Runs the program over `input` from the byte offset `start`. Returns the capture slots of the
    /// match, or an empty list when there is none.
    export let search = func(program: Program, input: string, start: int, mode: int) -> int[list] {
        last none: int[list] = [];
        if (program.anchored && start > 0) {
            return none;
        }
        if (program.generation > 2000000000) {
            reset_marks(program);
        }
        last insts = program.insts;
        last marks = program.marks;
        last stack_pcs = program.stack_pcs;
        last stack_caps = program.stack_caps;
        last anchored = program.anchored;
        last skip = program.can_skip && mode != Whole;
        last first = program.first_bytes;
        last length = input.byte_length;
        last initial: int[list] = [];
        let k = 0;
        while (k < program.slot_count) {
            initial.append(-1);
            k += 1;
        }
        let matched = none;
        let found = false;
        let current_pcs: int[list] = [];
        let current_caps: (int[list])[list] = [];
        let pos = start;
        let generation = program.generation + 1;
        do {
            if (!found && (pos == start || mode != Whole)) {
                if (current_pcs.length == 0) {
                    if (anchored && pos > 0) {
                        break;
                    }
                    if (skip) {
                        last skipped_from = pos;
                        while (pos < length && !first[input.byte_at(pos) as int]) {
                            pos += 1;
                        }
                        if (pos == length) {
                            break;
                        }
                        if (pos != skipped_from) {
                            generation += 1;
                        }
                    }
                }
                add_thread(insts, marks, generation, stack_pcs, stack_caps, current_pcs, current_caps, 0, initial,
                    input, pos);
            }
            last count = current_pcs.length;
            if (count == 0) {
                // Every thread died; without a match, try the next start.
                if (found || mode == Whole || pos >= length) {
                    break;
                }
                pos = pos + scalar_width(input.byte_at(pos));
                generation += 1;
                continue;
            }
            let value: uint32 = 0;
            let next = pos;
            if (pos < length) {
                last lead = input.byte_at(pos);
                if (lead < 128) {
                    value = lead as uint32;
                    next = pos + 1;
                } else if (lead < 224) {
                    value = (((lead as uint32) & 31) << 6) | ((input.byte_at(pos + 1) as uint32) & 63);
                    next = pos + 2;
                } else if (lead < 240) {
                    value = (((lead as uint32) & 15) << 12) | (((input.byte_at(pos + 1) as uint32) & 63) << 6)
                        | ((input.byte_at(pos + 2) as uint32) & 63);
                    next = pos + 3;
                } else {
                    value = (((lead as uint32) & 7) << 18) | (((input.byte_at(pos + 1) as uint32) & 63) << 12)
                        | (((input.byte_at(pos + 2) as uint32) & 63) << 6) | ((input.byte_at(pos + 3) as uint32) & 63);
                    next = pos + 4;
                }
            }
            generation += 1;
            last next_pcs: int[list] = [];
            last next_caps: (int[list])[list] = [];
            last at_end = pos >= length;
            let i = 0;
            while (i < count) {
                last pc = current_pcs[i];
                let advance = false;
                match (insts[pc]) {
                    Inst.Scalar(expected) => {
                        advance = value == expected && !at_end;
                    },
                    Inst.Class { ranges, negated, ascii } => {
                        if (value < 128) {
                            advance = !at_end && ((ascii[(value >> 5) as int] >> (value & 31)) & 1) != 0;
                        } else {
                            advance = in_ranges(ranges, value) != negated;
                        }
                    },
                    Inst.Any => {
                        advance = !at_end;
                    },
                    Inst.Match => {
                        if (mode != Whole || at_end) {
                            matched = current_caps[i];
                            found = true;
                            if (mode == Earliest) {
                                program.generation = generation;
                                return matched;
                            }
                            break;
                        }
                    },
                    _ => {},
                }
                if (advance) {
                    add_thread(insts, marks, generation, stack_pcs, stack_caps, next_pcs, next_caps, pc + 1,
                        current_caps[i], input, next);
                }
                i += 1;
            }
            if (at_end) {
                break;
            }
            current_pcs = next_pcs;
            current_caps = next_caps;
            pos = next;
        }
        program.generation = generation;
        return matched;
    };

    /// @brief Adds a thread at `pc` to the list, following jumps, splits (first target first), saves, and
    /// assertions that hold at `pos`.
    ///
    /// A pc already marked with this generation is skipped. The stacks are empty on entry and on return.
    let add_thread = func(insts: Inst[list], marks: int[list], generation: int, stack_pcs: int[list],
                          stack_caps: (int[list])[list], pcs: int[list], caps_list: (int[list])[list], start_pc: int,
                          start_caps: int[list], input: string, pos: int) {
        let pc = start_pc;
        let caps = start_caps;
        do {
            let alive = false;
            if (marks[pc] != generation) {
                marks[pc] = generation;
                match (insts[pc]) {
                    Inst.Jump(target) => {
                        pc = target;
                        alive = true;
                    },
                    Inst.Split { first, second } => {
                        stack_pcs.append(second);
                        stack_caps.append(caps);
                        pc = first;
                        alive = true;
                    },
                    Inst.Save(slot) => {
                        caps = copy_with(caps, slot, pos);
                        pc += 1;
                        alive = true;
                    },
                    Inst.Assert(kind) => {
                        if (holds(kind, input, pos)) {
                            pc += 1;
                            alive = true;
                        }
                    },
                    Inst.Progress(slot) => {
                        if (caps[slot] != pos) {
                            pc += 1;
                            alive = true;
                        }
                    },
                    _ => {
                        pcs.append(pc);
                        caps_list.append(caps);
                    },
                }
            }
            if (!alive) {
                last top = stack_pcs.length - 1;
                if (top < 0) {
                    return;
                }
                pc = stack_pcs[top];
                caps = stack_caps[top];
                stack_pcs.remove_at(top);
                stack_caps.remove_at(top);
            }
        }
    };

    /// @brief A copy of the slots with one changed. Threads share slot lists, so a save never writes in place.
    /// Small counts use one list construction.
    let copy_with = func(caps: int[list], slot: int, value: int) -> int[list] {
        last count = caps.length;
        if (count == 2) {
            if (slot == 0) {
                return [value, caps[1]];
            }
            return [caps[0], value];
        }
        let copy: int[list] = [];
        if (count == 4) {
            copy = [caps[0], caps[1], caps[2], caps[3]];
        } else {
            let k = 0;
            while (k + 4 <= count) {
                copy.append(caps[k]);
                copy.append(caps[k + 1]);
                copy.append(caps[k + 2]);
                copy.append(caps[k + 3]);
                k += 4;
            }
            while (k < count) {
                copy.append(caps[k]);
                k += 1;
            }
        }
        copy[slot] = value;
        return copy;
    };

    /// @brief Evaluates a zero-width assertion at a UTF-8 byte offset.
    let holds = func(kind: parser.Anchor, input: string, pos: int) -> bool {
        last length = input.byte_length;
        if (kind == parser.Anchor.StartText) {
            return pos == 0;
        }
        if (kind == parser.Anchor.EndText) {
            return pos == length;
        }
        if (kind == parser.Anchor.StartLine) {
            return pos == 0 || input.byte_at(pos - 1) == 10;
        }
        if (kind == parser.Anchor.EndLine) {
            return pos == length || input.byte_at(pos) == 10;
        }
        last before = pos > 0 && is_word_byte(input.byte_at(pos - 1));
        last after = pos < length && is_word_byte(input.byte_at(pos));
        if (kind == parser.Anchor.WordBoundary) {
            return before != after;
        }
        return before == after;
    };

    /// @brief Word characters are ASCII letters, digits, and the underscore; a byte of a multi-byte character
    /// is never one.
    let is_word_byte = func(b: uint8) -> bool =>
        (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95;

    /// @brief Sorted ranges: stop at the first range above the value.
    let in_ranges = func(ranges: uint32[list], value: uint32) -> bool {
        last count = ranges.length;
        let r = 0;
        while (r < count) {
            if (value < ranges[r]) {
                return false;
            }
            if (value <= ranges[r + 1]) {
                return true;
            }
            r += 2;
        }
        return false;
    };

    /// @brief Returns the UTF-8 sequence width indicated by a lead byte.
    let scalar_width = func(lead: uint8) -> int {
        if (lead < 128) {
            return 1;
        }
        if (lead < 224) {
            return 2;
        }
        if (lead < 240) {
            return 3;
        }
        return 4;
    };

    /// @brief Clears visited-instruction marks and resets the generation counter.
    let reset_marks = func(program: Program) {
        let k = 0;
        while (k < program.marks.length) {
            program.marks[k] = -1;
            k += 1;
        }
        program.generation = 0;
    };
);
