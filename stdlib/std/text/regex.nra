let error = import:Std.Core.Error;
let hashing = import:Std.Core.Hash;
let machine = import:Std.Text.Internal.RegexMachine;
let optional = import:Std.Core.Optional;
let parser = import:Std.Text.Internal.RegexParser;
let result = import:Std.Core.Result;

// Regular expressions (Stdlib.md section 8.4). A pattern is parsed into a
// syntax tree, compiled into a program, and run by a Pike machine: the
// leftmost match wins, and among the matches that start there the one a
// backtracking matcher would find first. Positions are byte offsets.
//
// Syntax: literals; . (any scalar but LF, or any with dot_all); classes
// [...] and [^...] with ranges; \d \w \s \D \W \S (ASCII); \t \n \r, an
// escaped ASCII punctuation character, and \u{X} with 1 to 6 hex digits;
// ^ and $ (text start and end, or line start and end with multi_line);
// \b and \B (ASCII word characters); (...), (?:...), (?<name>...) and
// (?P<name>...); |; and * + ? {n} {n,} {n,m}, each with a lazy form ending
// in ?. Backreferences, lookaround, possessive quantifiers, Unicode
// properties, inline flags, and any other escape fail to compile. Limits: a
// repetition count of at most 1000, at most 10,000 instructions, and group
// nesting of at most 250. Every failure is a Parse error at the pattern
// offset of the offending construct.
//
// Where backtracking engines disagree: an iteration beyond a quantifier's
// minimum that matches the empty string fails (ECMAScript's rule; Python and
// Perl accept one), and a group inside a repeated group keeps the value of
// the last iteration in which it participated (Python and Perl; ECMAScript
// resets it). Because the machine keeps one thread per instruction and
// position, a new iteration of a loop whose body can match empty can merge
// with the unfinished previous iteration; the match can then differ from
// every backtracking order. Loops whose body cannot match empty are exact.
export let Regex = module (
    export let RegexFlags = class (
        export let ignore_ascii_case: bool = false;
        export let multi_line: bool = false;
        export let dot_all: bool = false;

        export let.override equals = func(other: class) -> bool {
            if (!(other is RegexFlags)) {
                return false;
            }
            let flags = other as RegexFlags;
            return ignore_ascii_case == flags.ignore_ascii_case &&
                multi_line == flags.multi_line && dot_all == flags.dot_all;
        };

        export let.override hash_code = func -> uint32 =>
            (ignore_ascii_case ? 1 : 0) | (multi_line ? 2 : 0) | (dot_all ? 4 : 0);

        export let.override to_string = func -> string =>
            "RegexFlags(ignore_ascii_case=" + ignore_ascii_case.to_string() +
                ", multi_line=" + multi_line.to_string() + ", dot_all=" + dot_all.to_string() + ")";
    );

    // One match: group 0 is the whole match. Immutable.
    export let RegexMatch = class (
        let input: string = "";
        let slots: int[list] = [];
        let names: string[list] = [];

        export let init = func(text: string, captured: int[list], group_names: string[list]) {
            input = text;
            slots = captured;
            names = group_names;
        };

        export let start = func -> int => slots[0];

        export let end = func -> int => slots[1];

        export let text = func -> string => input.slice(slots[0], slots[1]);

        export let.override equals = func(other: class) -> bool {
            if (!(other is RegexMatch)) {
                return false;
            }
            let found = other as RegexMatch;
            return input == found.input && slots === found.slots && names === found.names;
        };

        export let.override hash_code = func -> uint32 =>
            hashing.combine(hashing.combine(input.hash_code(), slots.hash_code()), names.hash_code());

        export let.override to_string = func -> string => text();

        // The group's text, or None when the group did not participate. An
        // index outside 0 through group_count() traps with "invalid
        // argument: no such group".
        export let group = func(index: int) -> optional.Optional<string> {
            check_group(index);
            let start_offset = slots[2 * index];
            if (start_offset < 0) {
                return optional.Optional<string>.None;
            }
            return optional.Optional<string>.Some(input.slice(start_offset, slots[2 * index + 1]));
        };

        // The group's start offset, or -1 when it did not participate.
        export let group_start = func(index: int) -> int {
            check_group(index);
            return slots[2 * index];
        };

        // The named group's text, or None when it did not participate. A
        // name the pattern does not define traps with "invalid argument: no
        // such group".
        export let named_group = func(name: string) -> optional.Optional<string> =>
            group(group_index(names, name));

        let check_group = func(index: int) {
            if (index < 0 || index > names.length) {
                trap_with_message("invalid argument: no such group");
            }
        };
    );

    export let Regex = class (
        let source: string = "";
        let program: machine.Program = nil;
        let names: string[list] = [];

        // Called by compile_with; the program type is internal to the library.
        export let init = func(text: string, compiled: machine.Program, group_names: string[list]) {
            source = text;
            program = compiled;
            names = group_names;
        };

        export let is_match = func(input: string) -> bool =>
            machine.search(program, input, 0, machine.Earliest).length > 0;

        // Whether the pattern matches the whole input.
        export let matches_fully = func(input: string) -> bool =>
            machine.search(program, input, 0, machine.Whole).length > 0;

        export let find = func(input: string) -> RegexMatch => match_at(input, 0);

        // The first match starting at or after the offset, or nil. The offset
        // must be a character boundary from 0 through the byte length;
        // otherwise the call traps with "invalid argument: offset out of
        // range" or "invalid argument: offset is not a character boundary".
        // ^ and \b still see the text before the offset.
        export let find_from = func(input: string, offset: int) -> RegexMatch {
            check_offset(input, offset);
            return match_at(input, offset);
        };

        // Successive non-overlapping matches. After an empty match the search
        // resumes one scalar value later.
        export let find_all = func(input: string) -> RegexMatch[list] {
            let matches: RegexMatch[list] = [];
            let length = input.byte_length;
            let pos = 0;
            while (pos <= length) {
                let slots = machine.search(program, input, pos, machine.Leftmost);
                if (slots.length == 0) {
                    break;
                }
                matches.append(new RegexMatch(input, slots, names));
                pos = slots[1];
                if (slots[0] == pos) {
                    if (pos == length) {
                        break;
                    }
                    pos = pos + scalar_width(input.byte_at(pos));
                }
            }
            return matches;
        };

        // Replaces every match of find_all. In the replacement, $0 through
        // $99 (two digits taken when present) and ${name} or ${number}
        // insert a group, and $$ is a dollar sign; a group that did not
        // participate inserts nothing. A reference to a group the pattern
        // does not have traps with "invalid argument: no such group"; any
        // other $ traps with "invalid argument: malformed replacement". The
        // replacement is checked before matching.
        export let replace_all = func(input: string, replacement: string) -> string =>
            replace_matches(input, replacement, find_all(input));

        // Replaces the first match, with the rules of replace_all.
        export let replace_first = func(input: string, replacement: string) -> string {
            let matches: RegexMatch[list] = [];
            let first = find(input);
            if (first != nil) {
                matches.append(first);
            }
            return replace_matches(input, replacement, matches);
        };

        // The pieces between the matches of find_all, with the rules of
        // Strings.split: empty pieces are kept, and an input without a match
        // gives one piece.
        export let split = func(input: string) -> string[list] {
            let pieces: string[list] = [];
            let start = 0;
            for (let found in find_all(input)) {
                pieces.append(input.slice(start, found.start()));
                start = found.end();
            }
            pieces.append(input.slice(start, input.byte_length));
            return pieces;
        };

        // The number of capturing groups, not counting group 0.
        export let group_count = func -> int => names.length;

        export let pattern = func -> string => source;

        export let.override equals = func(other: class) -> bool {
            if (!(other is Regex)) {
                return false;
            }
            let expression = other as Regex;
            return source == expression.source && compile_options() == expression.compile_options();
        };

        export let.override hash_code = func -> uint32 =>
            hashing.combine(source.hash_code(), compile_options().hash_code());

        export let.override to_string = func -> string => source;

        let compile_options = func -> int => program == nil ? -1 : program.options;

        let match_at = func(input: string, offset: int) -> RegexMatch {
            let slots = machine.search(program, input, offset, machine.Leftmost);
            if (slots.length == 0) {
                return nil;
            }
            return new RegexMatch(input, slots, names);
        };

        let replace_matches = func(input: string, replacement: string, matches: RegexMatch[list]) -> string {
            let segments = parse_replacement(replacement, names);
            if (matches.length == 0) {
                return input;
            }
            let bytes: uint8[list] = [];
            let start = 0;
            for (let found in matches) {
                append_bytes(bytes, input, start, found.start());
                for (let segment in segments) {
                    let [literal, index] = segment;
                    append_bytes(bytes, literal, 0, literal.byte_length);
                    if (index >= 0) {
                        match (found.group(index)) {
                            optional.Optional.Some(text) => {
                                append_bytes(bytes, text, 0, text.byte_length);
                            },
                            optional.Optional.None => {},
                        }
                    }
                }
                start = found.end();
            }
            append_bytes(bytes, input, start, input.byte_length);
            let [valid, text] = string.from_utf8(bytes);
            return text;
        };
    );

    // Compiles the pattern with every flag off.
    export let compile = func(pattern: string) -> result.Result<Regex> =>
        compile_with(pattern, new RegexFlags());

    // Compiles the pattern; a syntax error or an exceeded limit is a Parse
    // error at the offending pattern offset. The flags are read once.
    export let compile_with = func(pattern: string, flags: RegexFlags) -> result.Result<Regex> {
        let syntax = new parser.Parser(pattern);
        syntax.parse();
        if (syntax.failed) {
            return result.Result<Regex>.Err(error.Error.Parse {
                kind: syntax.error_kind,
                offset: syntax.error_offset,
                message: syntax.error_message,
            });
        }
        let program = machine.compile(syntax.root, syntax.groups, flags.ignore_ascii_case, flags.multi_line,
            flags.dot_all);
        if (program.insts.length != syntax.size + 3) {
            trap_with_message("invalid state: regex instruction count differs from its estimate");
        }
        return result.Result<Regex>.Ok(new Regex(pattern, program, syntax.names));
    };

    // The index of the named group; traps when there is none.
    let group_index = func(names: string[list], name: string) -> int {
        let k = 0;
        while (k < names.length) {
            if (names[k] == name) {
                return k + 1;
            }
            k += 1;
        }
        trap_with_message("invalid argument: no such group");
    };

    // The replacement as segments: literal text, then a group index or -1.
    let parse_replacement = func(replacement: string, names: string[list]) -> [string, int][list] {
        let segments: [string, int][list] = [];
        let length = replacement.byte_length;
        let literal: uint8[list] = [];
        let i = 0;
        while (i < length) {
            let b = replacement.byte_at(i);
            if (b != 36) {
                literal.append(b);
                i += 1;
                continue;
            }
            if (i + 1 >= length) {
                trap_with_message("invalid argument: malformed replacement");
            }
            let next = replacement.byte_at(i + 1);
            if (next == 36) {
                literal.append(36);
                i += 2;
                continue;
            }
            let index = -1;
            if (next >= 48 && next <= 57) {
                index = (next - 48) as int;
                i += 2;
                if (i < length && replacement.byte_at(i) >= 48 && replacement.byte_at(i) <= 57) {
                    index = index * 10 + ((replacement.byte_at(i) - 48) as int);
                    i += 1;
                }
            } else if (next == 123) {
                let close = i + 2;
                while (close < length && replacement.byte_at(close) != 125) {
                    close += 1;
                }
                if (close >= length || close == i + 2) {
                    trap_with_message("invalid argument: malformed replacement");
                }
                let reference = replacement.slice(i + 2, close);
                index = number_of(reference);
                if (index < 0) {
                    index = group_index(names, reference);
                }
                i = close + 1;
            } else {
                trap_with_message("invalid argument: malformed replacement");
            }
            if (index > names.length) {
                trap_with_message("invalid argument: no such group");
            }
            segments.append([text_of(literal), index]);
            literal = [];
        }
        segments.append([text_of(literal), -1]);
        return segments;
    };

    // The value of a reference made only of decimal digits, or -1.
    let number_of = func(reference: string) -> int {
        let value = 0;
        let k = 0;
        while (k < reference.byte_length) {
            let b = reference.byte_at(k);
            if (b < 48 || b > 57) {
                return -1;
            }
            if (value < 1000) {
                value = value * 10 + ((b - 48) as int);
            }
            k += 1;
        }
        return value;
    };

    let check_offset = func(s: string, offset: int) {
        if (offset < 0 || offset > s.byte_length) {
            trap_with_message("invalid argument: offset out of range");
        }
        if (offset < s.byte_length && (s.byte_at(offset) & 192) == 128) {
            trap_with_message("invalid argument: offset is not a character boundary");
        }
    };

    let scalar_width = func(lead: uint8) -> int {
        if (lead < 128) {
            return 1;
        }
        if (lead < 224) {
            return 2;
        }
        if (lead < 240) {
            return 3;
        }
        return 4;
    };

    let append_bytes = func(bytes: uint8[list], s: string, start: int, end: int) {
        let i = start;
        while (i + 4 <= end) {
            bytes.append(s.byte_at(i));
            bytes.append(s.byte_at(i + 1));
            bytes.append(s.byte_at(i + 2));
            bytes.append(s.byte_at(i + 3));
            i += 4;
        }
        while (i < end) {
            bytes.append(s.byte_at(i));
            i += 1;
        }
    };

    let text_of = func(bytes: uint8[list]) -> string {
        let [valid, text] = string.from_utf8(bytes);
        return text;
    };
);
