/// @brief The open-addressing core shared by every hash collection (Stdlib.md
/// section 9.6). It knows spread hashes and entry numbers and never sees a
/// key: the owning collection keeps keys and values in its own dense lists,
/// indexed by entry number, probes the index itself, and compares keys.
///
/// Layout: `index` has T slots (T a power of two, at least 8), each an entry
/// number, Empty (-1), or Tombstone (-2). `hashes` and `live` are dense lists
/// in insertion order, each of length `used`. E, the entry capacity, is T/2.
///
/// Owner protocol:
/// - Lookup: start at home(hash) and walk `index` with `(slot + 1) & mask`.
///   Empty ends the search and Tombstone continues it. An entry whose cached hash
///   equals the probe hash is a candidate for the owner's key comparison
///   (probe key first).
/// - Insertion: remember the first Tombstone passed, else the final Empty
///   slot. If is_full(), compact to grown_size() first and take
///   free_slot(hash) instead. claim(slot, hash) returns the new entry
///   number, and the owner appends its key and value in the same step.
/// - For removal, `release(slot)` returns the new `used` and the owner removes its
///   own entries above it from the end. Then, if needs_compaction(), the
///   owner compacts at table_size().
/// - Compaction: live_entries() gives the old entry numbers of the live
///   entries in order. The owner rebuilds its lists in that order (in a
///   helper that returns them) and then calls rebuild(order, size). No hash
///   or equality function is called.
///
/// Decision beyond section 9.6: releasing the last entry removes trailing
/// dead entries, whose tombstones stay in the index. Rule 1 therefore also
/// compacts when live entries plus tombstones fill E slots, so at least half
/// of the index is always Empty and every probe terminates.
/// @see [Standard library design](https://github.com/Kayyo321/neura/wiki/Stdlib-Design#96-hash-collections)
export let HashCore = module (
    /// @brief An index slot that ends a lookup probe.
    export const Empty: int = -1;
    /// @brief A previously occupied slot through which lookup continues.
    export const Tombstone: int = -2;
    /// @brief The minimum number of index slots.
    export const MinimumSize: int = 8;
    /// @brief 2^30: the largest table. Growing past it traps.
    export const MaximumSize: int = 1073741824;
    /// @brief 2^29: the largest capacity a with_capacity factory accepts.
    export const MaximumCapacity: int = 536870912;

    /// @brief The index and entry metadata for an open-addressed hash table.
    export let HashCore = class (
        /// @brief Power-of-two array of dense entry numbers, empty slots, and tombstones.
        export let index: int[list] = [];
        /// @brief Spread hashes in insertion order.
        export let hashes: uint32[list] = [];
        /// @brief False for a removed entry.
        export let live: bool[list] = [];
        /// @brief The number of live entries.
        export let count: int = 0;
        /// @brief Advanced by every structural change and every compaction.
        export let modifications: uint64 = 0;
        /// @brief One less than the number of index slots, used to wrap probes.
        export let mask: int = 7;
        /// @brief The number of index slots marked as tombstones.
        let tombstones: int = 0;
        /// @brief The index size restored by `clear()`.
        let initial_size: int = 8;

        /// @brief Builds an empty index with the supplied power-of-two table size.
        export let init = func(table_size: int) {
            initial_size = table_size;
            index = empty_index(table_size);
            mask = table_size - 1;
        };

        /// @brief Returns the number of index slots.
        export let table_size = func -> int => mask + 1;

        /// @brief The number of dense entries, live or dead.
        export let used = func -> int => hashes.length;

        /// @brief Returns the first probe slot for the already spread hash.
        export let home = func(hash: uint32) -> int => (hash & (mask as uint32)) as int;

        /// @brief Rule 1: a new entry needs a compaction first.
        export let is_full = func -> bool {
            let entries = (mask + 1) >> 1;
            return hashes.length == entries || count + tombstones == entries;
        };

        /// @brief The table size for a rule 1 compaction: doubled when more than half
        /// of E is live. Traps with "invalid argument: capacity" above 2^30.
        export let grown_size = func -> int {
            let size = mask + 1;
            if (count > (size >> 2)) {
                if (size >= MaximumSize) {
                    trap_with_message("invalid argument: capacity");
                }
                return size * 2;
            }
            return size;
        };

        /// @brief The first Empty slot from the hash's home. Used after a compaction,
        /// when the index has no tombstones.
        export let free_slot = func(hash: uint32) -> int {
            let slot = (hash & (mask as uint32)) as int;
            while (index[slot] != Empty) {
                slot = (slot + 1) & mask;
            }
            return slot;
        };

        /// @brief The slot that holds a live entry.
        export let slot_of = func(entry: int) -> int {
            let slot = (hashes[entry] & (mask as uint32)) as int;
            while (index[slot] != entry) {
                slot = (slot + 1) & mask;
            }
            return slot;
        };

        /// @brief Stores a new entry in `slot`, a Tombstone or Empty slot that the
        /// owner's probe chose, and returns its entry number.
        export let claim = func(slot: int, hash: uint32) -> int {
            let entry = hashes.length;
            if (index[slot] == Tombstone) {
                tombstones -= 1;
            }
            index[slot] = entry;
            hashes.append(hash);
            live.append(true);
            count += 1;
            modifications += 1;
            return entry;
        };

        /// @brief Releases the entry in `slot`. When it was the last entry, it and
        /// the dead entries before it leave the dense lists. Returns the new
        /// `used` so the owner can shorten its lists.
        export let release = func(slot: int) -> int {
            let entry = index[slot];
            index[slot] = Tombstone;
            tombstones += 1;
            live[entry] = false;
            count -= 1;
            modifications += 1;
            let length = hashes.length;
            if (entry == length - 1) {
                while (length > 0 && !live[length - 1]) {
                    length -= 1;
                    hashes.remove_at(length);
                    live.remove_at(length);
                }
            }
            return length;
        };

        /// @brief Rule 2: more dead entries than live ones, and at least 8.
        export let needs_compaction = func -> bool {
            let dead = hashes.length - count;
            return dead > count && dead >= 8;
        };

        /// @brief The old entry numbers of the live entries, in order.
        export let live_entries = func -> int[list] {
            let order: int[list] = [];
            let length = live.length;
            let entry = 0;
            while (entry < length) {
                if (live[entry]) {
                    order.append(entry);
                }
                entry += 1;
            }
            return order;
        };

        /// @brief Rebuilds the dense lists and the index from `order` (from
        /// live_entries) for a table of `table_size` slots, by probing from
        /// each cached hash for the first Empty slot.
        export let rebuild = func(order: int[list], table_size: int) {
            hashes = reordered_hashes(hashes, order);
            live = all_live(order.length);
            index = filled_index(hashes, table_size);
            mask = table_size - 1;
            tombstones = 0;
            modifications += 1;
        };

        /// @brief Empties the core at its initial table size.
        export let reset = func {
            index = empty_index(initial_size);
            hashes = [];
            live = [];
            count = 0;
            tombstones = 0;
            mask = initial_size - 1;
            modifications += 1;
        };

        /// @brief Traps with "invalid state: hash table ..." when an invariant is
        /// broken: index slots and entries agree, at least half of the index
        /// is Empty, the last entry is live, and dead entries stay within
        /// max(count, 7).
        export let validate = func {
            let size = mask + 1;
            if (size < MinimumSize || size > MaximumSize || (size & mask) != 0 || index.length != size) {
                trap_with_message("invalid state: hash table size");
            }
            let length = hashes.length;
            if (live.length != length || length > (size >> 1)) {
                trap_with_message("invalid state: hash table entries");
            }
            let seen: int[list] = [];
            let live_count = 0;
            let entry = 0;
            while (entry < length) {
                seen.append(0);
                if (live[entry]) {
                    live_count += 1;
                }
                entry += 1;
            }
            if (live_count != count) {
                trap_with_message("invalid state: hash table count");
            }
            if (length > 0 && !live[length - 1]) {
                trap_with_message("invalid state: hash table trailing dead entry");
            }
            let dead = length - count;
            if (dead > count && dead > 7) {
                trap_with_message("invalid state: hash table retention");
            }
            let filled = 0;
            let stones = 0;
            let slot = 0;
            while (slot < size) {
                let value = index[slot];
                if (value == Tombstone) {
                    stones += 1;
                    filled += 1;
                } else if (value != Empty) {
                    if (value < 0 || value >= length || !live[value] || seen[value] != 0) {
                        trap_with_message("invalid state: hash table index");
                    }
                    seen[value] = 1;
                    filled += 1;
                    // Every slot from the home slot to this one is filled.
                    let probe = (hashes[value] & (mask as uint32)) as int;
                    while (probe != slot) {
                        if (index[probe] == Empty) {
                            trap_with_message("invalid state: hash table probe chain");
                        }
                        probe = (probe + 1) & mask;
                    }
                }
                slot += 1;
            }
            if (stones != tombstones || filled - stones != count || filled > (size >> 1)) {
                trap_with_message("invalid state: hash table load");
            }
        };
    );

    /// @brief The table size for `capacity` entries: the smallest power of two at
    /// least max(8, 2 * capacity). Traps with "invalid argument: capacity" for
    /// a negative capacity or one above 2^29.
    export let table_size_for = func(capacity: int) -> int {
        if (capacity < 0 || capacity > MaximumCapacity) {
            trap_with_message("invalid argument: capacity");
        }
        let size = MinimumSize;
        while (size < capacity * 2) {
            size *= 2;
        }
        return size;
    };

    /// @brief Creates an empty core at the minimum table size.
    export let create = func -> HashCore => new HashCore(MinimumSize);

    /// @brief Creates an empty core sized for the entry capacity.
    /// Traps with `invalid argument: capacity` outside 0 through 2^29.
    export let with_capacity = func(capacity: int) -> HashCore => new HashCore(table_size_for(capacity));

    /// @brief Allocates `size` index slots initialized to `Empty`.
    let empty_index = func(size: int) -> int[list] {
        let slots: int[list] = [];
        let i = 0;
        while (i < size) {
            slots.append(Empty);
            i += 1;
        }
        return slots;
    };

    /// @brief Copies cached hashes at the old entry numbers in `order`.
    let reordered_hashes = func(old: uint32[list], order: int[list]) -> uint32[list] {
        let result: uint32[list] = [];
        let count = order.length;
        let i = 0;
        while (i < count) {
            result.append(old[order[i]]);
            i += 1;
        }
        return result;
    };

    /// @brief Builds a list of `count` true flags for compacted entries.
    let all_live = func(count: int) -> bool[list] {
        let result: bool[list] = [];
        let i = 0;
        while (i < count) {
            result.append(true);
            i += 1;
        }
        return result;
    };

    /// @brief Reinserts every cached spread hash by linear probing into a fresh index.
    let filled_index = func(spread_hashes: uint32[list], size: int) -> int[list] {
        let slots = empty_index(size);
        let mask = size - 1;
        let count = spread_hashes.length;
        let entry = 0;
        while (entry < count) {
            let slot = (spread_hashes[entry] & (mask as uint32)) as int;
            while (slots[slot] != Empty) {
                slot = (slot + 1) & mask;
            }
            slots[slot] = entry;
            entry += 1;
        }
        return slots;
    };
);
