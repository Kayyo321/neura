let.promote _ = import:Std.Collections.Iterator;
let.promote _ = import:Std.Collections.List;
let optional = import:Std.Core.Optional;
let ordering = import:Std.Core.Ordering;
let sorting = import:Std.Collections.Sorting;

/// @brief Lists with a shallow copy of the supplied elements in read-only storage.
/// The positions are fixed at construction, so iterators need no modification check.
/// @see [Std.Collections.ImmutableList](https://github.com/Kayyo321/neura/wiki/Stdlib-Collections-ImmutableList)
export let ImmutableList = module (
    /// @brief A positional collection with its own shallow copy of the supplied list.
    export let ImmutableList = class<T> implements List<T> (
        /// @brief The privately owned shallow copy of the supplied list.
        let storage: T[list];

        /// @brief Copies `values`.
        export let init = func(values: T[list]) {
            let copy: T[list] = [];
            let count = values.length;
            let i = 0;
            while (i < count) {
                copy.append(values[i]);
                i += 1;
            }
            storage = copy;
        };

        /// @brief Returns the number of elements.
        export let size = func -> int => storage.length;

        /// @brief Returns true when there are no elements.
        export let is_empty = func -> bool => storage.length == 0;

        /// @brief Returns the element at zero-based `index`. An invalid index causes a bounds trap.
        export let get = func(index: int) -> T => storage[index];

        /// @brief Returns the first element. Traps with `no such element` when empty.
        export let first = func -> T {
            if (storage.length == 0) {
                trap_with_message("no such element");
            }
            return storage[0];
        };

        /// @brief Returns the last element. Traps with `no such element` when empty.
        export let last = func -> T {
            if (storage.length == 0) {
                trap_with_message("no such element");
            }
            return storage[storage.length - 1];
        };

        /// @brief Returns the first element as `Some`, or `None` when empty.
        export let first_or_none = func -> optional.Optional<T> {
            if (storage.length == 0) {
                return optional.Optional<T>.None;
            }
            return optional.Optional<T>.Some(storage[0]);
        };

        /// @brief Returns the last element as `Some`, or `None` when empty.
        export let last_or_none = func -> optional.Optional<T> {
            if (storage.length == 0) {
                return optional.Optional<T>.None;
            }
            return optional.Optional<T>.Some(storage[storage.length - 1]);
        };

        /// @brief Tests membership with `value.equals(element)`.
        export let contains = func(value: T) -> bool => index_of(value) >= 0;

        /// @brief Returns the lowest index where `value.equals(element)` is true, or -1 when absent.
        export let index_of = func(value: T) -> int {
            let count = storage.length;
            let i = 0;
            while (i < count) {
                if (value === storage[i]) {
                    return i;
                }
                i += 1;
            }
            return -1;
        };

        /// @brief Returns the highest index where `value.equals(element)` is true, or -1 when absent.
        export let last_index_of = func(value: T) -> int {
            let i = storage.length - 1;
            while (i >= 0) {
                if (value === storage[i]) {
                    return i;
                }
                i -= 1;
            }
            return -1;
        };

        /// @brief Returns the first index accepted by `test`, or -1 if no element matches.
        export let index_where = func(test: func(T) -> bool) -> int {
            let count = storage.length;
            let i = 0;
            while (i < count) {
                if (test(storage[i])) {
                    return i;
                }
                i += 1;
            }
            return -1;
        };

        /// @brief Calls `action` once for each element in list order.
        export let for_each = func(action: func(T) -> void) {
            let count = storage.length;
            let i = 0;
            while (i < count) {
                action(storage[i]);
                i += 1;
            }
        };

        /// @brief A new ImmutableList with the elements from `start` inclusive to
        /// `end` exclusive. Traps with "invalid argument: range" unless
        /// 0 <= start <= end <= size().
        export let slice = func(start: int, end: int) -> ImmutableList<T> {
            if (start < 0 || start > end || end > storage.length) {
                trap_with_message("invalid argument: range");
            }
            let part: T[list] = [];
            let i = start;
            while (i < end) {
                part.append(storage[i]);
                i += 1;
            }
            return new ImmutableList<T>(part);
        };

        /// @brief Returns the first comparator-equal index, or `-insertion_point - 1` when absent.
        /// @pre The list is already sorted by `c`.
        export let binary_search = func(value: T, c: func(T, T) -> ordering.Ordering) -> int =>
            sorting.binary_search<T>(storage, value, c);

        /// @brief A new built-in list in order.
        export let to_list = func -> T[list] {
            let result: T[list] = [];
            let count = storage.length;
            let i = 0;
            while (i < count) {
                result.append(storage[i]);
                i += 1;
            }
            return result;
        };

        /// @brief Returns an iterator over the stable list in index order.
        export let iterator = func -> Iterator<T> => new ImmutableListIterator<T>(storage);

        /// @brief Another ImmutableList with the same element type, size, and equal
        /// elements at each index.
        export let.override equals = func(other: class) -> bool {
            if (!(other is ImmutableList<T>)) {
                return false;
            }
            let that = other as ImmutableList<T>;
            let count = storage.length;
            if (that.size() != count) {
                return false;
            }
            for (let i = 0; i < count; i++) {
                if (!(storage[i] === that.get(i))) {
                    return false;
                }
            }
            return true;
        };

        /// @brief Folds the element hashes in list order from 1, multiplying by 31 before each addition with 32-bit wraparound.
        export let.override hash_code = func -> uint32 => storage.hash_code();

        /// @brief `[a, b, c]`. The elements exist before the list, so it can never
        /// contain itself.
        export let.override to_string = func -> string => storage.to_string();
    );

    /// @brief A traversal over immutable list storage in index order.
    let ImmutableListIterator = class<T> implements Iterator<T> (
        /// @brief The immutable backing list being traversed.
        let source: T[list];
        /// @brief The zero-based position of the next element.
        let position: int = 0;

        /// @brief Records the backing list and starts before its first element.
        export let init = func(values: T[list]) {
            source = values;
        };

        /// @brief Reports whether another element remains.
        export let has_next = func -> bool => position < source.length;

        /// @brief Returns the next element and advances. Traps with `no such element` at exhaustion.
        export let next = func -> T {
            if (position >= source.length) {
                trap_with_message("no such element");
            }
            let value = source[position];
            position += 1;
            return value;
        };
    );

    /// @brief Copies `items`.
    export let of = func<T>(items: T[list]) -> ImmutableList<T> => new ImmutableList<T>(items);
);
