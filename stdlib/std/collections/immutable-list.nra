let iterators = import:Std.Collections.Iterator;
let list = import:Std.Collections.List;
let optional = import:Std.Core.Optional;
let ordering = import:Std.Core.Ordering;
let sorting = import:Std.Collections.Sorting;

// A list that copies its contents at construction and implements only the
// read-only List interface (Stdlib.md section 9.10). Nothing can change it,
// so its iterators need no modification check.
export let ImmutableList = module (
    export let ImmutableList = class<T> implements list.List<T> (
        let storage: T[list];

        // Copies `values`.
        export let init = func(T[list] values) -> void {
            let copy: T[list] = [];
            let count = values.length;
            let i = 0;
            while (i < count) {
                copy.append(values[i]);
                i = i + 1;
            }
            storage = copy;
        };

        export let size = func() -> int {
            return storage.length;
        };

        export let is_empty = func() -> bool {
            return storage.length == 0;
        };

        // A bounds trap for an index outside 0 through size() - 1.
        export let get = func(int index) -> T {
            return storage[index];
        };

        export let first = func() -> T {
            if (storage.length == 0) {
                trap_with_message("no such element");
            }
            return storage[0];
        };

        export let last = func() -> T {
            if (storage.length == 0) {
                trap_with_message("no such element");
            }
            return storage[storage.length - 1];
        };

        export let first_or_none = func() -> optional.Optional<T> {
            if (storage.length == 0) {
                return optional.Optional<T>.None;
            }
            return optional.Optional<T>.Some(storage[0]);
        };

        export let last_or_none = func() -> optional.Optional<T> {
            if (storage.length == 0) {
                return optional.Optional<T>.None;
            }
            return optional.Optional<T>.Some(storage[storage.length - 1]);
        };

        // By equals, with `value` as the receiver.
        export let contains = func(T value) -> bool {
            return index_of(value) >= 0;
        };

        export let index_of = func(T value) -> int {
            let count = storage.length;
            let i = 0;
            while (i < count) {
                if (value.equals(storage[i])) {
                    return i;
                }
                i = i + 1;
            }
            return -1;
        };

        export let last_index_of = func(T value) -> int {
            let i = storage.length - 1;
            while (i >= 0) {
                if (value.equals(storage[i])) {
                    return i;
                }
                i = i - 1;
            }
            return -1;
        };

        // The first index whose element passes, or -1.
        export let index_where = func(func(T) -> bool test) -> int {
            let count = storage.length;
            let i = 0;
            while (i < count) {
                if (test(storage[i])) {
                    return i;
                }
                i = i + 1;
            }
            return -1;
        };

        export let for_each = func(func(T) -> void action) -> void {
            let count = storage.length;
            let i = 0;
            while (i < count) {
                action(storage[i]);
                i = i + 1;
            }
        };

        // A new ImmutableList with the elements from `start` inclusive to
        // `end` exclusive. Traps with "invalid argument: range" unless
        // 0 <= start <= end <= size().
        export let slice = func(int start, int end) -> ImmutableList<T> {
            if (start < 0 || start > end || end > storage.length) {
                trap_with_message("invalid argument: range");
            }
            let part: T[list] = [];
            let i = start;
            while (i < end) {
                part.append(storage[i]);
                i = i + 1;
            }
            return new ImmutableList<T>(part);
        };

        // Sorting.binary_search over the elements, which must be sorted by c.
        export let binary_search = func(T value, func(T, T) -> ordering.Ordering c) -> int {
            return sorting.binary_search<T>(storage, value, c);
        };

        // A new built-in list in order.
        export let to_list = func() -> T[list] {
            let result: T[list] = [];
            let count = storage.length;
            let i = 0;
            while (i < count) {
                result.append(storage[i]);
                i = i + 1;
            }
            return result;
        };

        export let iterator = func() -> iterators.Iterator<T> {
            return new ImmutableListIterator<T>(storage);
        };

        // Another ImmutableList with the same element type, size, and equal
        // elements at each index.
        export let.override equals = func(class other) -> bool {
            if (!(other is ImmutableList<T>)) {
                return false;
            }
            let that = other as ImmutableList<T>;
            let count = storage.length;
            if (that.size() != count) {
                return false;
            }
            let i = 0;
            while (i < count) {
                if (!storage[i].equals(that.get(i))) {
                    return false;
                }
                i = i + 1;
            }
            return true;
        };

        // The list formula of section 5.2.
        export let.override hash_code = func() -> uint32 {
            return storage.hash_code();
        };

        // `[a, b, c]`. The elements exist before the list, so it can never
        // contain itself.
        export let.override to_string = func() -> string {
            return storage.to_string();
        };
    );

    let ImmutableListIterator = class<T> implements iterators.Iterator<T> (
        let source: T[list];
        let position: int = 0;

        export let init = func(T[list] values) -> void {
            source = values;
        };

        export let has_next = func() -> bool {
            return position < source.length;
        };

        export let next = func() -> T {
            if (position >= source.length) {
                trap_with_message("no such element");
            }
            let value = source[position];
            position = position + 1;
            return value;
        };
    );

    // Copies `items`.
    export let of = func<T>(T[list] items) -> ImmutableList<T> {
        return new ImmutableList<T>(items);
    };
);
