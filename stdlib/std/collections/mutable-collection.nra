let.promote _ = import:Std.Collections.Collection;

// Structural changes common to lists and sets. `add` returns false only
// when a set already holds the value; lists always return true.
export let MutableCollection = module (
    export let MutableCollection = interface<T>:Collection<T> (
        let add = func(value: T) -> bool;
        // Removes the first element equal to `value`; returns whether one was.
        let remove = func(value: T) -> bool;
        let clear = func;
        // The callback runs once per element, in order. Returns how many
        // elements were removed.
        let remove_if = func(drop: func(T) -> bool) -> int;
        let retain_if = func(keep: func(T) -> bool) -> int;

        let add_all = func(items: T[list]) {
            for (let item in items) {
                add(item);
            }
        };
    );
);
