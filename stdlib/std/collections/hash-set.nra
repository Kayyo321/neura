let hash_core = import:Std.Collections.Internal.HashCore;
let.promote _ = import:Std.Collections.Iterator;
let.promote _ = import:Std.Collections.MutableSet;

/// @brief Insertion-ordered hash sets with built-in or caller-supplied element operations.
/// Removing and reinserting an element moves it to the end. At most `max(size(), 7)`
/// removed elements can remain reachable pending compaction. Iterators and member
/// callbacks detect structural changes and trap with `collection modified during iteration`.
/// @see [Std.Collections.HashSet](https://github.com/Kayyo321/neura/wiki/Stdlib-Collections-HashSet)
#Since("0.1.0")
export let HashSet = module (
    /// @brief A private token type that restricts construction to module factories.
    let Seal = enum (Token);

    /// @brief A mutable set that tests membership by hash and equality and iterates in insertion order.
    export let HashSet = class<T> implements MutableSet<T> (
        /// @brief Never replaced, so iterators can read its modification count.
        last core: hash_core.HashCore;
        /// @brief The owner elements indexed by dense entry number, including entries pending compaction.
        let elements: T[list] = [];
        /// @brief The hash function for lookup and collection hashing.
        last hash_of: func(T) -> uint32;
        /// @brief The equality function used with the probe as its first argument.
        last same: func(T, T) -> bool;
        /// @brief Whether this instance's text conversion is running.
        let printing: bool = false;

        /// @brief Adopts the empty table and the key operations supplied by the module factory.
        export let init = func(seal: Seal, table: hash_core.HashCore, hash: func(T) -> uint32, equal: func(T, T) -> bool) {
            core = table;
            hash_of = hash;
            same = equal;
        };

        /// @brief Returns the number of distinct elements.
        export let size = func -> int => core.count;

        /// @brief Returns true when there are no distinct elements.
        export let is_empty = func -> bool => core.count == 0;

        /// @brief Replaces every list with a new one of the initial table size.
        export let clear = func {
            core.reset();
            elements = [];
        };

        /// @brief Reports whether the set holds an element equal to the probe under its key operations.
        export let contains = func(value: T) -> bool => find(value, spread(hash_of(value))) >= 0;

        /// @brief Adds the element and returns false for a duplicate. The set keeps
        /// the element it holds.
        export let add = func(value: T) -> bool {
            last hash = spread(hash_of(value));
            last slot = find(value, hash);
            if (slot >= 0) {
                return false;
            }
            insert(value, hash, -slot - 1);
            return true;
        };

        /// @brief Adds each element in order.
        export let add_all = func(items: T[list]) {
            last count = items.length;
            let i = 0;
            while (i < count) {
                add(items[i]);
                i += 1;
            }
        };

        /// @brief Removes the matching element. Returns false when absent.
        export let remove = func(value: T) -> bool {
            last slot = find(value, spread(hash_of(value)));
            if (slot < 0) {
                return false;
            }
            release(slot);
            return true;
        };

        /// @brief A new built-in list in insertion order.
        export let to_list = func -> T[list] {
            last result: T[list] = [];
            last live = core.live;
            last length = live.length;
            let entry = 0;
            while (entry < length) {
                if (live[entry]) {
                    result.append(elements[entry]);
                }
                entry += 1;
            }
            return result;
        };

        /// @brief Returns a fail-fast iterator over the elements in insertion order.
        export let iterator = func -> Iterator<T> => new HashSetIterator<T>(core, elements);

        /// @brief In insertion order. The action must not change the set
        /// structurally.
        export let for_each = func(action: func(T) -> void) {
            last expected = core.modifications;
            let entry = 0;
            while (entry < core.live.length) {
                if (core.live[entry]) {
                    action(elements[entry]);
                    if (core.modifications != expected) {
                        trap_with_message("collection modified during iteration");
                    }
                }
                entry += 1;
            }
        };

        /// @brief Calls `drop` once per element in insertion order, then removes the matches and compacts at most once.
        /// @pre The predicate leaves the set structure unchanged.
        /// @return The number of removed elements.
        export let remove_if = func(drop: func(T) -> bool) -> int => remove_matching(drop, true);

        /// @brief Calls `keep` once per element in insertion order, then removes rejected elements and compacts at most once.
        /// @pre The predicate leaves the set structure unchanged.
        /// @return The number of removed elements.
        export let retain_if = func(keep: func(T) -> bool) -> int => remove_matching(keep, false);

        /// @brief Whether every element of this set is in `other`.
        export let is_subset_of = func(other: HashSet<T>) -> bool {
            if (core.count > other.size()) {
                return false;
            }
            last live = core.live;
            last length = live.length;
            let entry = 0;
            while (entry < length) {
                if (live[entry] && !other.contains(elements[entry])) {
                    return false;
                }
                entry += 1;
            }
            return true;
        };

        /// @brief Whether no element of this set is in `other`.
        export let is_disjoint_from = func(other: HashSet<T>) -> bool {
            last live = core.live;
            last length = live.length;
            let entry = 0;
            while (entry < length) {
                if (live[entry] && other.contains(elements[entry])) {
                    return false;
                }
                entry += 1;
            }
            return true;
        };

        /// @brief A new set with this set's element operations: this set's elements
        /// in order, then the other's new elements in its order.
        export let union = func(other: HashSet<T>) -> HashSet<T> {
            last result = empty_like();
            result.add_all(to_list());
            result.add_all(other.to_list());
            return result;
        };

        /// @brief This set's elements that are in `other`, in this set's order.
        export let intersection = func(other: HashSet<T>) -> HashSet<T> => selected(other, true);

        /// @brief This set's elements that are not in `other`, in this set's order.
        export let difference = func(other: HashSet<T>) -> HashSet<T> => selected(other, false);

        /// @brief Compacts to the smallest table that holds the live entries and invalidates iterators.
        export let trim = func {
            compact(hash_core.table_size_for(core.count));
        };

        /// @brief Traps with "invalid state: ..." on a broken table invariant or when
        /// a live element's hash differs from its cached hash.
        export let validate = func {
            core.validate();
            last length = core.hashes.length;
            if (elements.length != length) {
                trap_with_message("invalid state: hash table owner lists");
            }
            let entry = 0;
            while (entry < length) {
                if (core.live[entry] && spread(hash_of(elements[entry])) != core.hashes[entry]) {
                    trap_with_message("invalid state: hash table cached hash");
                }
                entry += 1;
            }
        };

        /// @brief Another HashSet of the same size whose elements this set all
        /// contains.
        export let.override equals = func(other: class) -> bool {
            if (!(other is HashSet<T>)) {
                return false;
            }
            last that = other as HashSet<T>;
            if (that.size() != core.count) {
                return false;
            }
            last items = that.to_list();
            last count = items.length;
            let i = 0;
            while (i < count) {
                if (!contains(items[i])) {
                    return false;
                }
                i += 1;
            }
            return true;
        };

        /// @brief The wrapping sum of the element hashes.
        export let.override hash_code = func -> uint32 {
            let total: uint64 = 0;
            last live = core.live;
            last length = live.length;
            let entry = 0;
            while (entry < length) {
                if (live[entry]) {
                    total = (total + (hash_of(elements[entry]) as uint64)) & 4294967295;
                }
                entry += 1;
            }
            return total as uint32;
        };

        /// @brief Formats elements as `{a, b, c}` in iteration order. The set prints "(this collection)"
        /// where its own text reaches it again.
        export let.override to_string = func -> string {
            if (printing) {
                return "(this collection)";
            }
            printing = true;
            last text = to_list().to_string();
            printing = false;
            return "{" + text.slice(1, text.byte_length - 1) + "}";
        };

        /// @brief Creates an empty set with the same hash and equality functions.
        let empty_like = func -> HashSet<T> => new(Seal.Token, hash_core.create(), hash_of, same);

        /// @brief Copies elements whose membership in `other` matches `present`, preserving this set's order and key operations.
        let selected = func(other: HashSet<T>, present: bool) -> HashSet<T> {
            last result = empty_like();
            last live = core.live;
            last length = live.length;
            let entry = 0;
            while (entry < length) {
                if (live[entry] && other.contains(elements[entry]) == present) {
                    result.add(elements[entry]);
                }
                entry += 1;
            }
            return result;
        };

        /// @brief Collects matching entry numbers, releases them from highest to lowest, and compacts once if needed.
        let remove_matching = func(test: func(T) -> bool, remove_when: bool) -> int {
            last expected = core.modifications;
            last chosen: int[list] = [];
            last length = core.live.length;
            let entry = 0;
            while (entry < length) {
                if (core.live[entry]) {
                    last matched = test(elements[entry]);
                    if (core.modifications != expected) {
                        trap_with_message("collection modified during iteration");
                    }
                    if (matched == remove_when) {
                        chosen.append(entry);
                    }
                }
                entry += 1;
            }
            // From the highest entry down, so that trailing removals never
            // renumber an entry still to be released.
            let i = chosen.length - 1;
            while (i >= 0) {
                shorten(core.release(core.slot_of(chosen[i])));
                i -= 1;
            }
            if (core.needs_compaction()) {
                compact(core.table_size());
            }
            return chosen.length;
        };

        /// @brief Returns the slot holding the element when present. Otherwise returns -1 minus the
        /// slot a new entry takes.
        let find = func(value: T, hash: uint32) -> int {
            last slots = core.index;
            last cached = core.hashes;
            last mask = core.mask;
            let slot = (hash & (mask as uint32)) as int;
            let free = -1;
            do {
                last entry = slots[slot];
                if (entry == -1) {
                    if (free < 0) {
                        free = slot;
                    }
                    return -free - 1;
                }
                if (entry == -2) {
                    if (free < 0) {
                        free = slot;
                    }
                } else if (cached[entry] == hash && same(value, elements[entry])) {
                    return slot;
                }
                slot = (slot + 1) & mask;
            }
            return -1;
        };

        /// @brief Claims a slot and appends the corresponding owner data, compacting first when the table is full.
        let insert = func(value: T, hash: uint32, slot: int) {
            let target = slot;
            if (core.is_full()) {
                compact(core.grown_size());
                target = core.free_slot(hash);
            }
            core.claim(target, hash);
            elements.append(value);
        };

        /// @brief Releases a slot, drops trailing dead entries, and compacts when required by the table.
        let release = func(slot: int) {
            shorten(core.release(slot));
            if (core.needs_compaction()) {
                compact(core.table_size());
            }
        };

        /// @brief Drops owner entries beyond the length returned by the table.
        let shorten = func(length: int) {
            while (elements.length > length) {
                elements.remove_at(elements.length - 1);
            }
        };

        /// @brief Rebuilds the index and owner storage in the current live entry order using cached hashes.
        let compact = func(table_size: int) {
            last order = core.live_entries();
            elements = reordered<T>(elements, order);
            core.rebuild(order, table_size);
        };
    );

    /// @brief A fail-fast traversal over live table elements in insertion order.
    let HashSetIterator = class<T> implements Iterator<T> (
        /// @brief The live table metadata, including its modification count.
        last core: hash_core.HashCore;
        /// @brief The element storage captured when the iterator was created.
        last source: T[list];
        /// @brief The source version recorded when the iterator was created.
        last expected: uint64;
        /// @brief The dense entry position from which the next live entry search starts.
        let position: int = 0;

        /// @brief Captures the current entry storage and table version.
        export let init = func(table: hash_core.HashCore, values: T[list]) {
            core = table;
            source = values;
            expected = table.modifications;
        };

        /// @brief Reports whether another element remains. Traps with `collection modified during iteration` after a structural change.
        export let has_next = func -> bool {
            if (core.modifications != expected) {
                trap_with_message("collection modified during iteration");
            }
            last live = core.live;
            while (position < live.length && !live[position]) {
                position += 1;
            }
            return position < live.length;
        };

        /// @brief Returns the next element and advances. Traps with `collection modified during iteration` after a structural change. Traps with `no such element` at exhaustion.
        export let next = func -> T {
            if (!has_next()) {
                trap_with_message("no such element");
            }
            last value = source[position];
            position += 1;
            return value;
        };
    );

    /// @brief Creates an empty set using `equals` and `hash_code` for its elements.
    export let create = func<T> -> HashSet<T> =>
        with_keys_and_capacity<T>(universal_hash<T>(), universal_same<T>(), 0);

    /// @brief Creates an empty table sized for `capacity` entries.
    /// Traps with `invalid argument: capacity` outside 0 through 2^29.
    export let with_capacity = func<T>(capacity: int) -> HashSet<T> =>
        with_keys_and_capacity<T>(universal_hash<T>(), universal_same<T>(), capacity);

    /// @brief Creates an empty collection using the supplied hash and equality functions.
    /// @pre Equality is an equivalence relation. Equal keys have equal hashes, and both results remain stable while stored.
    export let with_keys = func<T>(hash: func(T) -> uint32, same: func(T, T) -> bool) -> HashSet<T> =>
        with_keys_and_capacity<T>(hash, same, 0);

    /// @brief Creates an empty collection sized for `capacity` entries using the supplied key operations.
    /// Traps with `invalid argument: capacity` outside 0 through 2^29.
    /// @param hash Returns a stable hash for a stored key.
    /// @param same Compares keys by a stable equivalence relation.
    /// @pre Equal keys have equal hashes.
    export let with_keys_and_capacity = func<T>(hash: func(T) -> uint32, same: func(T, T) -> bool, capacity: int) -> HashSet<T> =>
        new HashSet<T>(Seal.Token, hash_core.with_capacity(capacity), hash, same);

    /// @brief Builds a callback that calls the built-in `hash_code` member.
    let universal_hash = func<T> -> func(T) -> uint32 {
        return func(value: T) -> uint32 => value.hash_code();
    };

    /// @brief Builds a callback that tests value equality.
    let universal_same = func<T> -> func(T, T) -> bool {
        return func(a: T, b: T) -> bool => a === b;
    };

    /// @brief Mixes the upper 16 hash bits into the lower 16 before the table masks them.
    let spread = func(hash: uint32) -> uint32 => hash ^ (hash >> 16);

    /// @brief Copies entries from `old` at the indices in `order`.
    let reordered = func<T>(old: T[list], order: int[list]) -> T[list] {
        last result: T[list] = [];
        last count = order.length;
        let i = 0;
        while (i < count) {
            result.append(old[order[i]]);
            i += 1;
        }
        return result;
    };
);
