let.promote _ = import:Std.Collections.Iterator;
let.promote _ = import:Std.Collections.MutableList;
let optional = import:Std.Core.Optional;
let ordering = import:Std.Core.Ordering;
let sequences = import:Std.Collections.Sequence;
let sorting = import:Std.Collections.Sorting;
let text_depth = import:Std.Collections.Internal.TextDepth;

// A growable list over one built-in list (Stdlib.md section 9.3). The
// backing list's structural version is the modification count, so
// iterators also detect changes made through `items()` or a wrapped alias.
export let ArrayList = module (
    export let ArrayList = class<T> implements MutableList<T> (
        // Replaced never: wrap and items share this list for the wrapper's
        // lifetime.
        let storage: T[list];
        let printing_depth: int = 0;

        // Adopts `values` without copying, as `wrap` does.
        export let init = func(values: T[list]) {
            storage = values;
        };

        // The live backing list. A built-in for-each over it traps with
        // reason 5 on a structural change.
        export let items = func -> T[list] => storage;

        export let size = func -> int => storage.length;

        export let is_empty = func -> bool => storage.length == 0;

        // A bounds trap for an index outside 0 through size() - 1.
        export let get = func(index: int) -> T => storage[index];

        // Not structural.
        export let set = func(index: int, value: T) {
            storage[index] = value;
        };

        export let first = func -> T {
            if (storage.length == 0) {
                trap_with_message("no such element");
            }
            return storage[0];
        };

        export let last = func -> T {
            if (storage.length == 0) {
                trap_with_message("no such element");
            }
            return storage[storage.length - 1];
        };

        export let first_or_none = func -> optional.Optional<T> {
            if (storage.length == 0) {
                return optional.Optional<T>.None;
            }
            return optional.Optional<T>.Some(storage[0]);
        };

        export let last_or_none = func -> optional.Optional<T> {
            if (storage.length == 0) {
                return optional.Optional<T>.None;
            }
            return optional.Optional<T>.Some(storage[storage.length - 1]);
        };

        // Appends; always true.
        export let add = func(value: T) -> bool {
            storage.append(value);
            return true;
        };

        // Inserts before `index`; an index equal to the size appends.
        export let add_at = func(index: int, value: T) {
            let count = storage.length;
            if (index == count) {
                storage.append(value);
                return;
            }
            // The read makes any other bad index a bounds trap before the
            // list changes.
            let displaced = storage[index];
            storage.append(storage[count - 1]);
            let k = count - 1;
            while (k > index) {
                storage[k] = storage[k - 1];
                k -= 1;
            }
            storage[index] = value;
        };

        // Appends each element in order. Reads by position up to the starting
        // length, so adding the list's own items() doubles it.
        export let add_all = func(values: T[list]) {
            let count = values.length;
            let i = 0;
            while (i < count) {
                storage.append(values[i]);
                i += 1;
            }
        };

        export let remove_at = func(index: int) -> T {
            let value = storage[index];
            storage.remove_at(index);
            return value;
        };

        export let remove_first = func -> T {
            if (storage.length == 0) {
                trap_with_message("no such element");
            }
            let value = storage[0];
            storage.remove_at(0);
            return value;
        };

        export let remove_last = func -> T {
            let count = storage.length;
            if (count == 0) {
                trap_with_message("no such element");
            }
            let value = storage[count - 1];
            storage.remove_at(count - 1);
            return value;
        };

        // Not structural.
        export let swap = func(i: int, j: int) {
            let value = storage[i];
            storage[i] = storage[j];
            storage[j] = value;
        };

        // Not structural.
        export let reverse = func {
            let i = 0;
            let j = storage.length - 1;
            while (i < j) {
                let value = storage[i];
                storage[i] = storage[j];
                storage[j] = value;
                i += 1;
                j -= 1;
            }
        };

        // Not structural.
        export let fill = func(value: T) {
            let count = storage.length;
            let i = 0;
            while (i < count) {
                storage[i] = value;
                i += 1;
            }
        };

        // Removes elements from the end of the backing list until `size`
        // remain. Traps with "invalid argument: negative size" or "invalid
        // argument: size above current size".
        export let truncate = func(size: int) {
            if (size < 0) {
                trap_with_message("invalid argument: negative size");
            }
            if (size > storage.length) {
                trap_with_message("invalid argument: size above current size");
            }
            while (storage.length > size) {
                storage.remove_at(storage.length - 1);
            }
        };

        // Removes every element from the end of the same backing list.
        export let clear = func {
            while (storage.length > 0) {
                storage.remove_at(storage.length - 1);
            }
        };

        // A new ArrayList with the elements from `start` inclusive to `end`
        // exclusive. Traps with "invalid argument: range" unless
        // 0 <= start <= end <= size().
        export let slice = func(start: int, end: int) -> ArrayList<T> {
            if (start < 0 || start > end || end > storage.length) {
                trap_with_message("invalid argument: range");
            }
            let result: T[list] = [];
            let i = start;
            while (i < end) {
                result.append(storage[i]);
                i += 1;
            }
            return new ArrayList<T>(result);
        };

        // A new built-in list in order.
        export let to_list = func -> T[list] {
            let result: T[list] = [];
            let count = storage.length;
            let i = 0;
            while (i < count) {
                result.append(storage[i]);
                i += 1;
            }
            return result;
        };

        // A fail-fast iterator over the backing list.
        export let iterator = func -> Iterator<T> => new ArrayListIterator<T>(storage);

        // A lazy pipeline over this list's fail-fast iterator (Stdlib.md
        // section 9.12): a structural change while it runs traps.
        export let sequence = func -> sequences.Sequence<T> => sequences.from_iterator<T>(iterator());

        // In order. The action must not change the list structurally.
        export let for_each = func(action: func(T) -> void) {
            let version = storage.version;
            let i = 0;
            while (i < storage.length) {
                action(storage[i]);
                if (storage.version != version) {
                    trap_with_message("collection modified during iteration");
                }
                i += 1;
            }
        };

        // Calls `drop` once per element in order, compacts the kept elements
        // by indexed writes, then removes the tail from the end. Returns how
        // many were removed.
        export let remove_if = func(drop: func(T) -> bool) -> int => remove_matching(drop, true);

        export let retain_if = func(keep: func(T) -> bool) -> int => remove_matching(keep, false);

        let remove_matching = func(test: func(T) -> bool, remove_when: bool) -> int {
            let version = storage.version;
            let count = storage.length;
            let kept = 0;
            let i = 0;
            while (i < count) {
                let value = storage[i];
                let matched = test(value);
                if (storage.version != version) {
                    trap_with_message("collection modified during iteration");
                }
                if (matched != remove_when) {
                    if (kept != i) {
                        storage[kept] = value;
                    }
                    kept += 1;
                }
                i += 1;
            }
            while (storage.length > kept) {
                storage.remove_at(storage.length - 1);
            }
            return count - kept;
        };

        // The first index whose element passes, or -1.
        export let index_where = func(test: func(T) -> bool) -> int {
            let version = storage.version;
            let i = 0;
            while (i < storage.length) {
                let matched = test(storage[i]);
                if (storage.version != version) {
                    trap_with_message("collection modified during iteration");
                }
                if (matched) {
                    return i;
                }
                i += 1;
            }
            return -1;
        };

        // Stable; Sorting.sort on the backing list.
        export let sort = func(c: func(T, T) -> ordering.Ordering) {
            sorting.sort<T>(storage, c);
        };

        // Sorting.binary_search on the backing list, which must be sorted by c.
        export let binary_search = func(value: T, c: func(T, T) -> ordering.Ordering) -> int =>
            sorting.binary_search<T>(storage, value, c);

        // By equals, with `value` as the receiver.
        export let contains = func(value: T) -> bool => index_of(value) >= 0;

        export let index_of = func(value: T) -> int {
            let count = storage.length;
            let i = 0;
            while (i < count) {
                if (value === storage[i]) {
                    return i;
                }
                i += 1;
            }
            return -1;
        };

        export let last_index_of = func(value: T) -> int {
            let i = storage.length - 1;
            while (i >= 0) {
                if (value === storage[i]) {
                    return i;
                }
                i -= 1;
            }
            return -1;
        };

        // Removes the first element equal to `value`.
        export let remove = func(value: T) -> bool {
            let index = index_of(value);
            if (index < 0) {
                return false;
            }
            storage.remove_at(index);
            return true;
        };

        // Another ArrayList with the same element type, size, and equal
        // elements at each index.
        export let.override equals = func(other: class) -> bool {
            if (!(other is ArrayList<T>)) {
                return false;
            }
            return storage.equals((other as ArrayList<T>).items());
        };

        // The list formula of section 5.2.
        export let.override hash_code = func -> uint32 => storage.hash_code();

        // `[a, b, c]`; the list itself as a direct element prints
        // "(this collection)".
        export let.override to_string = func -> string {
            if (printing_depth != 0 && printing_depth == text_depth.current()) {
                return "(this collection)";
            }
            let saved = printing_depth;
            printing_depth = text_depth.enter();
            let text = storage.to_string();
            text_depth.leave();
            printing_depth = saved;
            return text;
        };
    );

    // Compares the backing list's version before every step.
    let ArrayListIterator = class<T> implements Iterator<T> (
        let source: T[list];
        let expected: uint64;
        let position: int = 0;

        export let init = func(values: T[list]) {
            source = values;
            expected = values.version;
        };

        export let has_next = func -> bool {
            if (source.version != expected) {
                trap_with_message("collection modified during iteration");
            }
            return position < source.length;
        };

        export let next = func -> T {
            if (source.version != expected) {
                trap_with_message("collection modified during iteration");
            }
            if (position >= source.length) {
                trap_with_message("no such element");
            }
            let value = source[position];
            position += 1;
            return value;
        };
    );

    export let create = func<T> -> ArrayList<T> {
        let values: T[list] = [];
        return new ArrayList<T>(values);
    };

    // Copies `items`.
    export let of = func<T>(items: T[list]) -> ArrayList<T> {
        let values: T[list] = [];
        let count = items.length;
        let i = 0;
        while (i < count) {
            values.append(items[i]);
            i += 1;
        }
        return new ArrayList<T>(values);
    };

    // `count` copies of `value`. Traps with "invalid argument: negative count".
    export let filled = func<T>(count: int, value: T) -> ArrayList<T> {
        if (count < 0) {
            trap_with_message("invalid argument: negative count");
        }
        let values: T[list] = [];
        let i = 0;
        while (i < count) {
            values.append(value);
            i += 1;
        }
        return new ArrayList<T>(values);
    };

    // Adopts `items` without copying; the list and the wrapper share
    // storage.
    export let wrap = func<T>(items: T[list]) -> ArrayList<T> => new ArrayList<T>(items);
);
