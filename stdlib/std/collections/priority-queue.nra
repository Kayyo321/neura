let cell = import:Std.Core.Cell;
let iterators = import:Std.Collections.Iterator;
let optional = import:Std.Core.Optional;
let ordering = import:Std.Core.Ordering;
let.promote _ = import:Std.Collections.Queue;

/// @brief Binary min-heaps that dequeue a least element under the supplied comparator.
/// Equal-priority elements have no FIFO guarantee. The comparator must leave the queue structure
/// unchanged. Structural changes during a comparison trap. Equality and hashing use identity.
/// @see [Std.Collections.PriorityQueue](https://github.com/Kayyo321/neura/wiki/Stdlib-Collections-PriorityQueue)
#Since("0.1.0")
export let PriorityQueue = module (
    /// @brief A min-heap that exposes the least element according to its comparator.
    #NotThreadSafe
    export let PriorityQueue = class<T> implements Queue<T> (
        /// @brief Heap order: the children of index i are at 2i + 1 and 2i + 2.
        let heap: T[list];
        /// @brief The total ordering used to maintain the heap.
        last comparator: func(T, T) -> ordering.Ordering;
        /// @brief The structural modification count shared with iterators.
        last modifications: cell.Cell<uint64> = cell.of<uint64>(0);
        /// @brief Whether this instance's text conversion is running.
        let printing: bool = false;

        /// @brief Copies `items` and heapifies the copy in linear time.
        /// @pre The comparator defines a total order and leaves the queue structure unchanged.
        export let init = func(items: T[list], c: func(T, T) -> ordering.Ordering) {
            comparator = c;
            last values: T[list] = [];
            last count = items.length;
            let i = 0;
            while (i < count) {
                values.append(items[i]);
                i += 1;
            }
            heap = values;
            last expected = modifications.value;
            let index = count / 2 - 1;
            while (index >= 0) {
                sift_down(index, heap[index], expected);
                index -= 1;
            }
        };

        /// @brief Compares two elements and traps if the callback changed the queue structurally.
        let less = func(a: T, b: T, expected: uint64) -> bool {
            last order = comparator(a, b);
            if (modifications.value != expected) {
                trap_with_message("collection modified during iteration");
            }
            return order == ordering.Ordering.Less;
        };

        /// @brief While the item is not at the root and is Less than its parent,
        /// moves the parent down.
        let sift_up = func(start: int, item: T, expected: uint64) {
            let index = start;
            while (index > 0) {
                last parent = (index - 1) / 2;
                last above = heap[parent];
                if (!less(item, above, expected)) {
                    break;
                }
                heap[index] = above;
                index = parent;
            }
            heap[index] = item;
        };

        /// @brief Picks the left child, or the right child when it exists and is
        /// Less than the left. Moves that child up while it is Less than the
        /// item.
        let sift_down = func(start: int, item: T, expected: uint64) {
            last count = heap.length;
            let index = start;
            do {
                let child = 2 * index + 1;
                if (child >= count) {
                    break;
                }
                last right = child + 1;
                if (right < count && less(heap[right], heap[child], expected)) {
                    child = right;
                }
                last below = heap[child];
                if (!less(below, item, expected)) {
                    break;
                }
                heap[index] = below;
                index = child;
            }
            heap[index] = item;
        };

        /// @brief Returns the number of elements.
        export let size = func -> int => heap.length;

        /// @brief Returns true when there are no elements.
        export let is_empty = func -> bool => heap.length == 0;

        /// @brief Adds `value` and sifts it up to restore heap order.
        export let enqueue = func(value: T) {
            last expected = modifications.value;
            heap.append(value);
            sift_up(heap.length - 1, value, expected);
            modifications.value = expected + 1;
        };

        /// @brief Removes and returns a least element. Traps with "no such element"
        /// when empty.
        export let dequeue = func -> T {
            last count = heap.length;
            if (count == 0) {
                trap_with_message("no such element");
            }
            last expected = modifications.value;
            last root = heap[0];
            last moved = heap[count - 1];
            heap.remove_at(count - 1);
            if (count > 1) {
                sift_down(0, moved, expected);
            }
            modifications.value = expected + 1;
            return root;
        };

        /// @brief A least element, or None when empty.
        #NoDiscard
        export let peek = func -> optional.Optional<T> {
            if (heap.length == 0) {
                return optional.Optional<T>.None;
            }
            return optional.Optional<T>.Some(heap[0]);
        };

        /// @brief Removes a least element and returns it as `Some`, or returns `None` when empty.
        export let try_dequeue = func -> optional.Optional<T> {
            if (heap.length == 0) {
                return optional.Optional<T>.None;
            }
            return optional.Optional<T>.Some(dequeue());
        };

        /// @brief Removes all queued elements.
        export let clear = func {
            last empty: T[list] = [];
            heap = empty;
            modifications.value = modifications.value + 1;
        };

        /// @brief Dequeues everything into a new built-in list, least first.
        export let drain_sorted = func -> T[list] {
            last result: T[list] = [];
            while (heap.length > 0) {
                result.append(dequeue());
            }
            return result;
        };

        /// @brief Tests membership with `value.equals(element)`.
        export let contains = func(value: T) -> bool {
            for (let element in heap) {
                if (value === element) {
                    return true;
                }
            }
            return false;
        };

        /// @brief A new built-in list in heap order, which is not sorted.
        export let to_list = func -> T[list] {
            last result: T[list] = [];
            for (let element in heap) {
                result.append(element);
            }
            return result;
        };

        /// @brief Returns a fail-fast iterator in heap order.
        export let iterator = func -> iterators.Iterator<T> =>
            new PriorityQueueIterator<T>(heap, modifications);

        /// @brief Calls `action` in heap order.
        /// @pre The action leaves the queue structure unchanged.
        export let for_each = func(action: func(T) -> void) {
            last expected = modifications.value;
            let i = 0;
            while (i < heap.length) {
                action(heap[i]);
                if (modifications.value != expected) {
                    trap_with_message("collection modified during iteration");
                }
                i += 1;
            }
        };

        /// @brief Traps with "invalid state: heap order" when an element is Less
        /// than its parent.
        export let validate = func {
            last expected = modifications.value;
            let i = 1;
            while (i < heap.length) {
                if (less(heap[i], heap[(i - 1) / 2], expected)) {
                    trap_with_message("invalid state: heap order");
                }
                i += 1;
            }
        };

        /// @brief Formats elements as `[a, b, c]` in heap order. The queue prints "(this collection)" where
        /// its own text reaches it again.
        export let.override to_string = func -> string {
            if (printing) {
                return "(this collection)";
            }
            printing = true;
            last text = heap.to_string();
            printing = false;
            return text;
        };
    );

    /// @brief Walks the heap list in index order, comparing the queue's
    /// modification count before every step.
    let PriorityQueueIterator = class<T> implements iterators.Iterator<T> (
        /// @brief The heap list in heap order.
        last source: T[list];
        /// @brief The live modification counter shared with the source collection.
        last modifications: cell.Cell<uint64>;
        /// @brief The source version recorded when the iterator was created.
        last expected: uint64;
        /// @brief The zero-based position of the next element.
        let position: int = 0;

        /// @brief Captures the heap and current modification count.
        export let init = func(values: T[list], counter: cell.Cell<uint64>) {
            source = values;
            modifications = counter;
            expected = counter.value;
        };

        /// @brief Reports whether another element remains. Traps with `collection modified during iteration` after a structural change.
        export let has_next = func -> bool {
            if (modifications.value != expected) {
                trap_with_message("collection modified during iteration");
            }
            return position < source.length;
        };

        /// @brief Returns the next element and advances. Traps with `collection modified during iteration` after a structural change. Traps with `no such element` at exhaustion.
        export let next = func -> T {
            if (modifications.value != expected) {
                trap_with_message("collection modified during iteration");
            }
            if (position >= source.length) {
                trap_with_message("no such element");
            }
            last value = source[position];
            position += 1;
            return value;
        };
    );

    /// @brief Creates an empty queue using the total order defined by `c`.
    export let create = func<T>(c: func(T, T) -> ordering.Ordering) -> PriorityQueue<T> {
        last empty: T[list] = [];
        return new(empty, c);
    };

    /// @brief Copies and heapifies `items` in linear time using the total order defined by `c`.
    export let from_list = func<T>(items: T[list], c: func(T, T) -> ordering.Ordering) -> PriorityQueue<T> =>
        new PriorityQueue<T>(items, c);
);
