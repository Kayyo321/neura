let cell = import:Std.Core.Cell;
let deque = import:Std.Collections.Deque;
let iterators = import:Std.Collections.Iterator;
let optional = import:Std.Core.Optional;
let text_depth = import:Std.Collections.Internal.TextDepth;

// A double-ended queue over two built-in lists used as stacks (Stdlib.md
// section 9.4). Removing an element removes its slot, so nothing removed
// stays reachable. Equality and hashing are by identity.
export let ArrayDeque = module (
    export let ArrayDeque = class<T> implements deque.Deque<T> (
        // The first part of the deque in reverse order: its last element is
        // the deque's first.
        let front: T[list] = [];
        // The rest of the deque in order.
        let back: T[list] = [];
        // Advanced after each structural change; shared with iterators.
        let modifications: cell.Cell<uint64> = cell.of<uint64>(0);
        let printing_depth: int = 0;

        let changed = func {
            modifications.value += 1;
        };

        export let size = func -> int => front.length + back.length;

        export let is_empty = func -> bool => front.length == 0 && back.length == 0;

        // The element at `index` from the first, in constant time. A bounds
        // trap for an index outside 0 through size() - 1.
        export let get = func(index: int) -> T {
            let split = front.length;
            return (index < split) ? front[split - 1 - index] : back[index - split];
        };

        export let add_first = func(value: T) -> void {
            front.append(value);
            changed();
        };

        export let add_last = func(value: T) -> void {
            back.append(value);
            changed();
        };

        // add_last.
        export let enqueue = func(value: T) -> void {
            back.append(value);
            changed();
        };

        // Moves the first half of `back`, rounded up, into `front` in reverse
        // order and shifts the rest of `back` down.
        let refill_front = func() -> void {
            let count = back.length;
            let moved = (count + 1) / 2;
            let i = moved - 1;
            while (i >= 0) {
                front.append(back[i]);
                i = i - 1;
            }
            let j = 0;
            while (j + moved < count) {
                back[j] = back[j + moved];
                j = j + 1;
            }
            while (back.length > count - moved) {
                back.remove_at(back.length - 1);
            }
        };

        // The mirror of refill_front: the deque's last half, rounded up,
        // moves from the start of `front` into `back`.
        let refill_back = func() -> void {
            let count = front.length;
            let moved = (count + 1) / 2;
            let i = moved - 1;
            while (i >= 0) {
                back.append(front[i]);
                i = i - 1;
            }
            let j = 0;
            while (j + moved < count) {
                front[j] = front[j + moved];
                j = j + 1;
            }
            while (front.length > count - moved) {
                front.remove_at(front.length - 1);
            }
        };

        // Traps with "no such element" when empty.
        export let remove_first = func() -> T {
            if (front.length == 0) {
                if (back.length == 0) {
                    trap_with_message("no such element");
                }
                refill_front();
            }
            let last_index = front.length - 1;
            let value = front[last_index];
            front.remove_at(last_index);
            changed();
            return value;
        };

        export let remove_last = func() -> T {
            if (back.length == 0) {
                if (front.length == 0) {
                    trap_with_message("no such element");
                }
                refill_back();
            }
            let last_index = back.length - 1;
            let value = back[last_index];
            back.remove_at(last_index);
            changed();
            return value;
        };

        // remove_first.
        export let dequeue = func() -> T {
            return remove_first();
        };

        export let first = func() -> T {
            if (front.length > 0) {
                return front[front.length - 1];
            }
            if (back.length == 0) {
                trap_with_message("no such element");
            }
            return back[0];
        };

        export let last = func() -> T {
            if (back.length > 0) {
                return back[back.length - 1];
            }
            if (front.length == 0) {
                trap_with_message("no such element");
            }
            return front[0];
        };

        // The first element, or None when empty.
        export let peek = func() -> optional.Optional<T> {
            if (front.length > 0) {
                return optional.Optional<T>.Some(front[front.length - 1]);
            }
            if (back.length > 0) {
                return optional.Optional<T>.Some(back[0]);
            }
            return optional.Optional<T>.None;
        };

        export let try_dequeue = func() -> optional.Optional<T> {
            if (front.length == 0 && back.length == 0) {
                return optional.Optional<T>.None;
            }
            return optional.Optional<T>.Some(remove_first());
        };

        export let clear = func() -> void {
            let empty_front: T[list] = [];
            let empty_back: T[list] = [];
            front = empty_front;
            back = empty_back;
            changed();
        };

        // By equals, with `value` as the receiver.
        export let contains = func(value: T) -> bool {
            for (let element in front) {
                if (value === element) {
                    return true;
                }
            }
            for (let element in back) {
                if (value === element) {
                    return true;
                }
            }
            return false;
        };

        // A new built-in list from first to last.
        export let to_list = func() -> T[list] {
            let result: T[list] = [];
            let i = front.length - 1;
            while (i >= 0) {
                result.append(front[i]);
                i = i - 1;
            }
            for (let element in back) {
                result.append(element);
            }
            return result;
        };

        // First to last; fail-fast.
        export let iterator = func() -> iterators.Iterator<T> {
            return new ArrayDequeIterator<T>(front, back, modifications);
        };

        // First to last. The action must not change the deque structurally.
        export let for_each = func(action: func(T) -> void) -> void {
            let expected = modifications.value;
            let i = 0;
            while (i < front.length + back.length) {
                action(get(i));
                if (modifications.value != expected) {
                    trap_with_message("collection modified during iteration");
                }
                i = i + 1;
            }
        };

        // Traps with "invalid state: ..." when iteration and indexing
        // disagree or the size is inconsistent.
        export let validate = func() -> void {
            let count = size();
            if (count != front.length + back.length || count < 0) {
                trap_with_message("invalid state: deque size");
            }
            let walk = iterator();
            let i = 0;
            while (walk.has_next()) {
                if (i >= count || !walk.next().equals(get(i))) {
                    trap_with_message("invalid state: deque order");
                }
                i = i + 1;
            }
            if (i != count) {
                trap_with_message("invalid state: deque order");
            }
        };

        // `[a, b, c]` from first to last; the deque itself as a direct
        // element prints "(this collection)".
        export let.override to_string = func() -> string {
            if (printing_depth != 0 && printing_depth == text_depth.current()) {
                return "(this collection)";
            }
            let saved = printing_depth;
            printing_depth = text_depth.enter();
            let text = to_list().to_string();
            text_depth.leave();
            printing_depth = saved;
            return text;
        };
    );

    // Walks `front` from its end, then `back`, comparing the deque's
    // modification count before every step.
    let ArrayDequeIterator = class<T> implements iterators.Iterator<T> (
        let front: T[list];
        let back: T[list];
        let modifications: cell.Cell<uint64>;
        let expected: uint64;
        let position: int = 0;

        export let init = func(first_part: T[list], rest: T[list], count: cell.Cell<uint64>) -> void {
            front = first_part;
            back = rest;
            modifications = count;
            expected = count.value;
        };

        export let has_next = func() -> bool {
            if (modifications.value != expected) {
                trap_with_message("collection modified during iteration");
            }
            return position < front.length + back.length;
        };

        export let next = func() -> T {
            if (modifications.value != expected) {
                trap_with_message("collection modified during iteration");
            }
            let split = front.length;
            let index = position;
            if (index >= split + back.length) {
                trap_with_message("no such element");
            }
            position = position + 1;
            if (index < split) {
                return front[split - 1 - index];
            }
            return back[index - split];
        };
    );

    export let create = func<T>() -> ArrayDeque<T> {
        return new ArrayDeque<T>();
    };

    // A deque of `items` from first to last; copies.
    export let of = func<T>(items: T[list]) -> ArrayDeque<T> {
        let result = new ArrayDeque<T>();
        for (let item in items) {
            result.add_last(item);
        }
        return result;
    };
);
