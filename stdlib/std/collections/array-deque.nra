let cell = import:Std.Core.Cell;
let.promote _ = import:Std.Collections.Deque;
let iterators = import:Std.Collections.Iterator;
let optional = import:Std.Core.Optional;

/// @brief Double-ended queues backed by two built-in lists used as stacks.
/// Removal drops the vacated slot, and equality and hashing use identity.
/// @see [Std.Collections.ArrayDeque](https://github.com/Kayyo321/neura/wiki/Stdlib-Collections-ArrayDeque)
#Since("0.1.0")
export let ArrayDeque = module (
    /// @brief A double-ended queue with constant-time indexing and amortized constant-time end operations.
    export let ArrayDeque = class<T> implements Deque<T> (
        /// @brief The first part of the deque in reverse order: its last element is
        /// the deque's first.
        let front: T[list] = [];
        /// @brief The rest of the deque in order.
        let back: T[list] = [];
        /// @brief The structural modification count shared with iterators.
        last modifications: cell.Cell<uint64> = cell.of<uint64>(0);
        /// @brief Whether this instance's text conversion is running.
        let printing: bool = false;

        /// @brief Advances the version observed by active iterators.
        let changed = func {
            modifications.value += 1;
        };

        /// @brief Returns the number of elements.
        export let size = func -> int => front.length + back.length;

        /// @brief Returns true when there are no elements.
        export let is_empty = func -> bool => front.length == 0 && back.length == 0;

        /// @brief Returns the element at zero-based `index` in constant time. An invalid index causes a bounds trap.
        export let get = func(index: int) -> T {
            last split = front.length;
            return (index < split) ? front[split - 1 - index] : back[index - split];
        };

        /// @brief Inserts `value` at the front.
        export let add_first = func(value: T) {
            front.append(value);
            changed();
        };

        /// @brief Appends `value` at the back.
        export let add_last = func(value: T) {
            back.append(value);
            changed();
        };

        /// @brief Appends `value` at the back.
        export let enqueue = func(value: T) {
            back.append(value);
            changed();
        };

        /// @brief Moves the first half of `back`, rounded up, into `front` in reverse
        /// order and shifts the rest of `back` down.
        let refill_front = func {
            last count = back.length;
            last moved = (count + 1) / 2;
            let i = moved - 1;
            while (i >= 0) {
                front.append(back[i]);
                i -= 1;
            }
            let j = 0;
            while (j + moved < count) {
                back[j] = back[j + moved];
                j += 1;
            }
            while (back.length > count - moved) {
                back.remove_at(back.length - 1);
            }
        };

        /// @brief Moves the last half of the deque, rounded up, from `front` into `back` in deque order.
        let refill_back = func {
            last count = front.length;
            last moved = (count + 1) / 2;
            let i = moved - 1;
            while (i >= 0) {
                back.append(front[i]);
                i -= 1;
            }
            let j = 0;
            while (j + moved < count) {
                front[j] = front[j + moved];
                j += 1;
            }
            while (front.length > count - moved) {
                front.remove_at(front.length - 1);
            }
        };

        /// @brief Removes and returns the first element. Traps with `no such element` when empty.
        export let remove_first = func -> T {
            if (front.length == 0) {
                if (back.length == 0) {
                    trap_with_message("no such element");
                }
                refill_front();
            }
            last last_index = front.length - 1;
            last value = front[last_index];
            front.remove_at(last_index);
            changed();
            return value;
        };

        /// @brief Removes and returns the last element. Traps with `no such element` when empty.
        export let remove_last = func -> T {
            if (back.length == 0) {
                if (front.length == 0) {
                    trap_with_message("no such element");
                }
                refill_back();
            }
            last last_index = back.length - 1;
            last value = back[last_index];
            back.remove_at(last_index);
            changed();
            return value;
        };

        /// @brief Removes and returns the first element. Traps with `no such element` when empty.
        export let dequeue = func -> T => remove_first();

        /// @brief Returns the first element. Traps with `no such element` when empty.
        export let first = func -> T {
            if (front.length > 0) {
                return front[front.length - 1];
            }
            if (back.length == 0) {
                trap_with_message("no such element");
            }
            return back[0];
        };

        /// @brief Returns the last element. Traps with `no such element` when empty.
        export let last = func -> T {
            if (back.length > 0) {
                return back[back.length - 1];
            }
            if (front.length == 0) {
                trap_with_message("no such element");
            }
            return front[0];
        };

        /// @brief The first element, or None when empty.
        #NoDiscard
        export let peek = func -> optional.Optional<T> {
            if (front.length > 0) {
                return optional.Optional<T>.Some(front[front.length - 1]);
            }
            if (back.length > 0) {
                return optional.Optional<T>.Some(back[0]);
            }
            return optional.Optional<T>.None;
        };

        /// @brief Removes the first element and returns it as `Some`, or returns `None` when empty.
        export let try_dequeue = func -> optional.Optional<T> {
            if (front.length == 0 && back.length == 0) {
                return optional.Optional<T>.None;
            }
            return optional.Optional<T>.Some(remove_first());
        };

        /// @brief Removes all elements from both halves of the deque.
        export let clear = func {
            last empty_front: T[list] = [];
            last empty_back: T[list] = [];
            front = empty_front;
            back = empty_back;
            changed();
        };

        /// @brief Tests membership with `value.equals(element)`.
        export let contains = func(value: T) -> bool {
            for (let element in front) {
                if (value === element) {
                    return true;
                }
            }
            for (let element in back) {
                if (value === element) {
                    return true;
                }
            }
            return false;
        };

        /// @brief A new built-in list from first to last.
        export let to_list = func -> T[list] {
            last result: T[list] = [];
            let i = front.length - 1;
            while (i >= 0) {
                result.append(front[i]);
                i -= 1;
            }
            for (let element in back) {
                result.append(element);
            }
            return result;
        };

        /// @brief Returns a fail-fast iterator from the front to the back.
        export let iterator = func -> iterators.Iterator<T> =>
            new ArrayDequeIterator<T>(front, back, modifications);

        /// @brief Calls `action` from the front to the back.
        /// @pre The action leaves the deque structure unchanged.
        export let for_each = func(action: func(T) -> void) {
            last expected = modifications.value;
            let i = 0;
            while (i < front.length + back.length) {
                action(get(i));
                if (modifications.value != expected) {
                    trap_with_message("collection modified during iteration");
                }
                i += 1;
            }
        };

        /// @brief Traps with "invalid state: ..." when iteration and indexing
        /// disagree or the size is inconsistent.
        export let validate = func {
            last count = size();
            if (count != front.length + back.length || count < 0) {
                trap_with_message("invalid state: deque size");
            }
            last walk = iterator();
            let i = 0;
            while (walk.has_next()) {
                if (i >= count || !walk.next().equals(get(i))) {
                    trap_with_message("invalid state: deque order");
                }
                i += 1;
            }
            if (i != count) {
                trap_with_message("invalid state: deque order");
            }
        };

        /// @brief Formats elements as `[a, b, c]` from first to last. The deque prints "(this collection)"
        /// where its own text reaches it again.
        export let.override to_string = func -> string {
            if (printing) {
                return "(this collection)";
            }
            printing = true;
            last text = to_list().to_string();
            printing = false;
            return text;
        };
    );

    /// @brief Walks `front` from its end, then `back`, comparing the deque's
    /// modification count before every step.
    let ArrayDequeIterator = class<T> implements iterators.Iterator<T> (
        /// @brief The first half of the deque stored in reverse order.
        last front: T[list];
        /// @brief The remaining deque elements stored in forward order.
        last back: T[list];
        /// @brief The live modification counter shared with the source collection.
        last modifications: cell.Cell<uint64>;
        /// @brief The source version recorded when the iterator was created.
        last expected: uint64;
        /// @brief The zero-based position of the next element.
        let position: int = 0;

        /// @brief Captures both deque halves and the current modification count.
        export let init = func(first_part: T[list], rest: T[list], count: cell.Cell<uint64>) {
            front = first_part;
            back = rest;
            modifications = count;
            expected = count.value;
        };

        /// @brief Reports whether another element remains. Traps with `collection modified during iteration` after a structural change.
        export let has_next = func -> bool {
            if (modifications.value != expected) {
                trap_with_message("collection modified during iteration");
            }
            return position < front.length + back.length;
        };

        /// @brief Returns the next element and advances. Traps with `collection modified during iteration` after a structural change. Traps with `no such element` at exhaustion.
        export let next = func -> T {
            if (modifications.value != expected) {
                trap_with_message("collection modified during iteration");
            }
            last split = front.length;
            last index = position;
            if (index >= split + back.length) {
                trap_with_message("no such element");
            }
            position += 1;
            if (index < split) {
                return front[split - 1 - index];
            }
            return back[index - split];
        };
    );

    /// @brief Creates an empty deque.
    export let create = func<T> -> ArrayDeque<T> => new;

    /// @brief Creates a deque from a shallow copy of `items`, in list order.
    export let of = func<T>(items: T[list]) -> ArrayDeque<T> {
        last result = new ArrayDeque<T>();
        for (let item in items) {
            result.add_last(item);
        }
        return result;
    };
);
