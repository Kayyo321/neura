let hash_core = import:Std.Collections.Internal.HashCore;
let.promote _ = import:Std.Collections.Iterator;
let.promote _ = import:Std.Collections.MutableMap;
let optional = import:Std.Core.Optional;
let text_depth = import:Std.Collections.Internal.TextDepth;

/// @brief Insertion-ordered hash maps with int keys.
/// Keys are compared by numeric value and hashed by their 32-bit pattern.
///
/// Updating an existing value preserves its entry position and iterator validity.
/// Removing and reinserting a key moves its entry to the end. At most
/// `max(size(), 7)` removed entries can remain reachable pending compaction.
/// Iterators and member callbacks detect structural changes and trap with
/// `collection modified during iteration`.
/// @see [Std.Collections.IntMap](https://github.com/Kayyo321/neura/wiki/Stdlib-Collections-IntMap)
export let IntMap = module (
    /// @brief A private token type that restricts construction to module factories.
    let Seal = enum (Token);

    /// @brief A mutable hash table that visits entries in insertion order.
    export let IntMap = class<V> implements MutableMap<int, V> (
        /// @brief Never replaced, so iterators can read its modification count.
        let core: hash_core.HashCore;
        /// @brief The keys indexed by dense entry number, including entries pending compaction.
        let stored_keys: int[list] = [];
        /// @brief The values indexed by the same dense entry numbers as their keys.
        let stored_values: V[list] = [];
        /// @brief The depth of this instance's active text conversion, or zero when inactive.
        let printing_depth: int = 0;

        /// @brief Initializes a map over the empty table supplied by the module factory.
        export let init = func(seal: Seal, table: hash_core.HashCore) {
            core = table;
        };

        /// @brief Returns the number of entries.
        export let size = func -> int => core.count;

        /// @brief Returns true when there are no entries.
        export let is_empty = func -> bool => core.count == 0;

        /// @brief Removes all entries, resets the table to its original size, and invalidates iterators.
        export let clear = func {
            core.reset();
            stored_keys = [];
            stored_values = [];
        };

        /// @brief Reports whether an entry exists for `key`.
        export let contains_key = func(key: int) -> bool => find(key, spread(key.hash_code())) >= 0;

        /// @brief Returns the associated value as `Some`, or `None` when the key is absent.
        export let get = func(key: int) -> optional.Optional<V> {
            let slot = find(key, spread(key.hash_code()));
            if (slot < 0) {
                return optional.Optional<V>.None;
            }
            return optional.Optional<V>.Some(stored_values[core.index[slot]]);
        };

        /// @brief Returns the associated value, or `fallback` when the key is absent.
        export let get_or = func(key: int, fallback: V) -> V {
            let slot = find(key, spread(key.hash_code()));
            if (slot < 0) {
                return fallback;
            }
            return stored_values[core.index[slot]];
        };

        /// @brief Returns the associated value. Traps with `no such element` when the key is absent.
        export let require = func(key: int) -> V {
            let slot = find(key, spread(key.hash_code()));
            if (slot < 0) {
                trap_with_message("no such element");
            }
            return stored_values[core.index[slot]];
        };

        /// @brief Stores the value for `key`. Replacing an existing value preserves the key and iterator validity.
        export let set = func(key: int, value: V) {
            let hash = spread(key.hash_code());
            let slot = find(key, hash);
            if (slot >= 0) {
                stored_values[core.index[slot]] = value;
                return;
            }
            insert(key, value, hash, -slot - 1);
        };

        /// @brief Stores the value for `key` and returns its previous value as `Some`, or `None` for a new key.
        export let put = func(key: int, value: V) -> optional.Optional<V> {
            let hash = spread(key.hash_code());
            let slot = find(key, hash);
            if (slot >= 0) {
                let entry = core.index[slot];
                let previous = stored_values[entry];
                stored_values[entry] = value;
                return optional.Optional<V>.Some(previous);
            }
            insert(key, value, hash, -slot - 1);
            return optional.Optional<V>.None;
        };

        /// @brief Removes the entry for `key`. Returns true if an entry was present.
        export let delete = func(key: int) -> bool {
            let slot = find(key, spread(key.hash_code()));
            if (slot < 0) {
                return false;
            }
            release(slot);
            return true;
        };

        /// @brief Removes the entry for `key` and returns its value as `Some`, or `None` when absent.
        export let remove = func(key: int) -> optional.Optional<V> {
            let slot = find(key, spread(key.hash_code()));
            if (slot < 0) {
                return optional.Optional<V>.None;
            }
            let value = stored_values[core.index[slot]];
            release(slot);
            return optional.Optional<V>.Some(value);
        };

        /// @brief Copies the keys to a new built-in list in insertion order.
        export let keys = func -> int[list] {
            let result: int[list] = [];
            let live = core.live;
            let length = live.length;
            let entry = 0;
            while (entry < length) {
                if (live[entry]) {
                    result.append(stored_keys[entry]);
                }
                entry += 1;
            }
            return result;
        };

        /// @brief Copies the values to a new built-in list in insertion order.
        export let values = func -> V[list] {
            let result: V[list] = [];
            let live = core.live;
            let length = live.length;
            let entry = 0;
            while (entry < length) {
                if (live[entry]) {
                    result.append(stored_values[entry]);
                }
                entry += 1;
            }
            return result;
        };

        /// @brief Copies the `[key, value]` tuples to a new built-in list in insertion order.
        export let entries = func -> [int, V][list] {
            let result: [int, V][list] = [];
            let live = core.live;
            let length = live.length;
            let entry = 0;
            while (entry < length) {
                if (live[entry]) {
                    let item: [int, V] = [stored_keys[entry], stored_values[entry]];
                    result.append(item);
                }
                entry += 1;
            }
            return result;
        };

        /// @brief Returns a fail-fast iterator over `[key, value]` tuples in insertion order.
        export let iterator = func -> Iterator<[int, V]> =>
            new IntMapIterator<V>(core, stored_keys, stored_values);

        /// @brief Sets each entry of `other` in its iteration order.
        export let put_all = func(other: IntMap<V>) {
            let items = other.entries();
            let count = items.length;
            let i = 0;
            while (i < count) {
                let [key, value] = items[i];
                set(key, value);
                i += 1;
            }
        };

        /// @brief Calls `action` with the key and value of each entry in insertion order.
        /// @pre The action leaves the map structure unchanged.
        export let for_each = func(action: func(int, V) -> void) {
            let expected = core.modifications;
            let entry = 0;
            while (entry < core.live.length) {
                if (core.live[entry]) {
                    action(stored_keys[entry], stored_values[entry]);
                    if (core.modifications != expected) {
                        trap_with_message("collection modified during iteration");
                    }
                }
                entry += 1;
            }
        };

        /// @brief Calls `drop` once per entry in insertion order, then removes the matches and compacts at most once.
        /// @pre The predicate leaves the map structure unchanged.
        /// @return The number of removed entries.
        export let remove_if = func(drop: func(int, V) -> bool) -> int {
            let expected = core.modifications;
            let chosen: int[list] = [];
            let length = core.live.length;
            let entry = 0;
            while (entry < length) {
                if (core.live[entry]) {
                    let removing = drop(stored_keys[entry], stored_values[entry]);
                    if (core.modifications != expected) {
                        trap_with_message("collection modified during iteration");
                    }
                    if (removing) {
                        chosen.append(entry);
                    }
                }
                entry += 1;
            }
            // From the highest entry down, so that trailing removals never
            // renumber an entry still to be released.
            let i = chosen.length - 1;
            while (i >= 0) {
                shorten(core.release(core.slot_of(chosen[i])));
                i -= 1;
            }
            if (core.needs_compaction()) {
                compact(core.table_size());
            }
            return chosen.length;
        };

        /// @brief Returns the associated value, or calls `make` once, stores its result, and returns it when absent.
        /// @pre The factory leaves the map structure unchanged.
        export let get_or_put = func(key: int, make: func() -> V) -> V {
            let hash = spread(key.hash_code());
            let slot = find(key, hash);
            if (slot >= 0) {
                return stored_values[core.index[slot]];
            }
            let expected = core.modifications;
            let value = make();
            if (core.modifications != expected) {
                trap_with_message("collection modified during iteration");
            }
            insert(key, value, hash, -slot - 1);
            return value;
        };

        /// @brief Stores and returns `value` when the key is absent. Otherwise stores and returns `combine(old, value)`.
        /// @pre The combiner leaves the map structure unchanged.
        export let merge = func(key: int, value: V, combine: func(V, V) -> V) -> V {
            let hash = spread(key.hash_code());
            let slot = find(key, hash);
            if (slot < 0) {
                insert(key, value, hash, -slot - 1);
                return value;
            }
            let entry = core.index[slot];
            let expected = core.modifications;
            let combined = combine(stored_values[entry], value);
            if (core.modifications != expected) {
                trap_with_message("collection modified during iteration");
            }
            stored_values[entry] = combined;
            return combined;
        };

        /// @brief Calls `f` with the key and its optional current value. Stores a `Some` result or removes the entry for `None`.
        /// @pre The callback leaves the map structure unchanged.
        /// @return The result of the callback.
        export let compute = func(key: int, f: func(int, optional.Optional<V>) -> optional.Optional<V>) -> optional.Optional<V> {
            let hash = spread(key.hash_code());
            let slot = find(key, hash);
            let current = optional.Optional<V>.None;
            if (slot >= 0) {
                current = optional.Optional<V>.Some(stored_values[core.index[slot]]);
            }
            let expected = core.modifications;
            let outcome = f(key, current);
            if (core.modifications != expected) {
                trap_with_message("collection modified during iteration");
            }
            match (outcome) {
                optional.Optional.Some(value) => {
                    if (slot >= 0) {
                        stored_values[core.index[slot]] = value;
                    } else {
                        insert(key, value, hash, -slot - 1);
                    }
                },
                optional.Optional.None => {
                    if (slot >= 0) {
                        release(slot);
                    }
                },
            }
            return outcome;
        };

        /// @brief Tests whether `value.equals(held_value)` is true for any entry.
        export let contains_value = func(value: V) -> bool {
            let live = core.live;
            let length = live.length;
            let entry = 0;
            while (entry < length) {
                if (live[entry] && value === stored_values[entry]) {
                    return true;
                }
                entry += 1;
            }
            return false;
        };

        /// @brief Compacts to the smallest table that holds the live entries and invalidates iterators.
        export let trim = func {
            compact(hash_core.table_size_for(core.count));
        };

        /// @brief Traps with "invalid state: ..." on a broken table invariant or when
        /// a live key's hash differs from its cached hash.
        export let validate = func {
            core.validate();
            let length = core.hashes.length;
            if (stored_keys.length != length || stored_values.length != length) {
                trap_with_message("invalid state: hash table owner lists");
            }
            let entry = 0;
            while (entry < length) {
                if (core.live[entry] && spread(stored_keys[entry].hash_code()) != core.hashes[entry]) {
                    trap_with_message("invalid state: hash table cached hash");
                }
                entry += 1;
            }
        };

        /// @brief Another IntMap with the same size in which, for each of its
        /// entries, this map holds an equal value for the key.
        export let.override equals = func(other: class) -> bool {
            if (!(other is IntMap<V>)) {
                return false;
            }
            let that = other as IntMap<V>;
            if (that.size() != core.count) {
                return false;
            }
            let items = that.entries();
            let count = items.length;
            let i = 0;
            while (i < count) {
                let [key, value] = items[i];
                let slot = find(key, spread(key.hash_code()));
                if (slot < 0 || !(stored_values[core.index[slot]] === value)) {
                    return false;
                }
                i += 1;
            }
            return true;
        };

        /// @brief The wrapping sum over entries of the key hash exclusive-or the
        /// value hash.
        export let.override hash_code = func -> uint32 {
            let total: uint64 = 0;
            let live = core.live;
            let length = live.length;
            let entry = 0;
            while (entry < length) {
                if (live[entry]) {
                    let mixed = stored_keys[entry].hash_code() ^ stored_values[entry].hash_code();
                    total = (total + (mixed as uint64)) & 4294967295;
                }
                entry += 1;
            }
            return total as uint32;
        };

        /// @brief Formats entries as `{k: v, k2: v2}` in iteration order. The map itself as a direct key
        /// or value prints "(this collection)".
        export let.override to_string = func -> string {
            if (printing_depth != 0 && printing_depth == text_depth.current()) {
                return "(this collection)";
            }
            let saved = printing_depth;
            printing_depth = text_depth.enter();
            let parts: string[list] = [];
            let live = core.live;
            let entry = 0;
            while (entry < live.length) {
                if (live[entry]) {
                    parts.append(stored_keys[entry].to_string() + ": " + stored_values[entry].to_string());
                }
                entry += 1;
            }
            text_depth.leave();
            printing_depth = saved;
            return braced(parts);
        };

        /// @brief Returns the slot holding the key when present. Otherwise returns -1 minus the slot
        /// a new entry takes (the first Tombstone passed, else the Empty slot
        /// that ended the search).
        let find = func(key: int, hash: uint32) -> int {
            let slots = core.index;
            let cached = core.hashes;
            let mask = core.mask;
            let slot = (hash & (mask as uint32)) as int;
            let free = -1;
            do {
                let entry = slots[slot];
                if (entry == -1) {
                    if (free < 0) {
                        free = slot;
                    }
                    return -free - 1;
                }
                if (entry == -2) {
                    if (free < 0) {
                        free = slot;
                    }
                } else if (cached[entry] == hash && key == stored_keys[entry]) {
                    return slot;
                }
                slot = (slot + 1) & mask;
            }
            return -1;
        };

        /// @brief Claims a slot and appends the corresponding owner data, compacting first when the table is full.
        let insert = func(key: int, value: V, hash: uint32, slot: int) {
            let target = slot;
            if (core.is_full()) {
                compact(core.grown_size());
                target = core.free_slot(hash);
            }
            core.claim(target, hash);
            stored_keys.append(key);
            stored_values.append(value);
        };

        /// @brief Releases a slot, drops trailing dead entries, and compacts when required by the table.
        let release = func(slot: int) {
            shorten(core.release(slot));
            if (core.needs_compaction()) {
                compact(core.table_size());
            }
        };

        /// @brief Drops owner entries above `length` after the core removed trailing
        /// dead entries.
        let shorten = func(length: int) {
            while (stored_keys.length > length) {
                let last = stored_keys.length - 1;
                stored_keys.remove_at(last);
                stored_values.remove_at(last);
            }
        };

        /// @brief Rebuilds the index and owner storage in the current live entry order using cached hashes.
        let compact = func(table_size: int) {
            let order = core.live_entries();
            stored_keys = reordered<int>(stored_keys, order);
            stored_values = reordered<V>(stored_values, order);
            core.rebuild(order, table_size);
        };
    );

    /// @brief A fail-fast traversal over live table entries in insertion order.
    let IntMapIterator = class<V> implements Iterator<[int, V]> (
        /// @brief The live table metadata, including its modification count.
        let core: hash_core.HashCore;
        /// @brief The key storage captured when the iterator was created.
        let source_keys: int[list];
        /// @brief The value storage captured when the iterator was created.
        let source_values: V[list];
        /// @brief The source version recorded when the iterator was created.
        let expected: uint64;
        /// @brief The dense entry position from which the next live entry search starts.
        let position: int = 0;

        /// @brief Captures the current entry storage and table version.
        export let init = func(table: hash_core.HashCore, keys: int[list], values: V[list]) {
            core = table;
            source_keys = keys;
            source_values = values;
            expected = table.modifications;
        };

        /// @brief Reports whether another element remains. Traps with `collection modified during iteration` after a structural change.
        export let has_next = func -> bool {
            if (core.modifications != expected) {
                trap_with_message("collection modified during iteration");
            }
            let live = core.live;
            while (position < live.length && !live[position]) {
                position += 1;
            }
            return position < live.length;
        };

        /// @brief Returns the next live `[key, value]` tuple and advances. Traps with `collection modified during iteration` after a structural change. Traps with `no such element` at exhaustion.
        export let next = func -> [int, V] {
            if (!has_next()) {
                trap_with_message("no such element");
            }
            let item: [int, V] = [source_keys[position], source_values[position]];
            position += 1;
            return item;
        };
    );

    /// @brief Creates an empty map with the default table size.
    export let create = func<V> -> IntMap<V> => new IntMap<V>(Seal.Token, hash_core.create());

    /// @brief Creates an empty map sized for `capacity` entries.
    /// Traps with `invalid argument: capacity` outside 0 through 2^29.
    export let with_capacity = func<V>(capacity: int) -> IntMap<V> =>
        new IntMap<V>(Seal.Token, hash_core.with_capacity(capacity));

    /// @brief Mixes the upper 16 hash bits into the lower 16 before the table masks them.
    let spread = func(hash: uint32) -> uint32 => hash ^ (hash >> 16);

    /// @brief Copies entries from `old` at the indices in `order`.
    let reordered = func<T>(old: T[list], order: int[list]) -> T[list] {
        let result: T[list] = [];
        let count = order.length;
        let i = 0;
        while (i < count) {
            result.append(old[order[i]]);
            i += 1;
        }
        return result;
    };

    /// @brief `[a, b]` text of the parts with braces in place of the brackets.
    let braced = func(parts: string[list]) -> string {
        let text = parts.to_string();
        return "{" + text.slice(1, text.byte_length - 1) + "}";
    };
);
