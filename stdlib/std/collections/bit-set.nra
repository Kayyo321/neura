let cell = import:Std.Core.Cell;
let iterators = import:Std.Collections.Iterator;
let.promote _ = import:Std.Collections.MutableSet;

/// @brief Sets of non-negative integers stored as packed 32-bit words. Iteration is in ascending order.
/// @see [Std.Collections.BitSet](https://github.com/Kayyo321/neura/wiki/Stdlib-Collections-BitSet)
export let BitSet = module (
    /// @brief A mask with every bit set in a 32-bit word.
    const AllBits: uint32 = 4294967295;

    /// @brief Counts the set bits using parallel sums. The final multiplication uses
    /// uint64 so that nothing wraps.
    let population = func(word: uint32) -> int {
        let x = word - ((word >> 1) & 1431655765);
        x = (x & 858993459) + ((x >> 2) & 858993459);
        x = (x + (x >> 4)) & 252645135;
        return ((((x as uint64) * 16843009) >> 24) & 255) as int;
    };

    /// @brief The position of the lowest set bit of a non-zero word.
    let lowest_bit = func(word: uint32) -> int {
        let lowest = word & (~word + 1);
        return population(lowest - 1);
    };

    /// @brief Returns the mask for the bit representing `value` within its word.
    let bit = func(value: int) -> uint32 {
        let one: uint32 = 1;
        return one << (value % 32);
    };

    /// @brief Traps with `invalid argument: negative element` if `value` is negative.
    let check_element = func(value: int) {
        if (value < 0) {
            trap_with_message("invalid argument: negative element");
        }
    };

    /// @brief The least member at or after `from`, or -1.
    let next_in = func(words: uint32[list], from: int) -> int {
        let index = from / 32;
        if (index >= words.length) {
            return -1;
        }
        let word = words[index] & (AllBits << (from % 32));
        while (word == 0) {
            index += 1;
            if (index >= words.length) {
                return -1;
            }
            word = words[index];
        }
        return index * 32 + lowest_bit(word);
    };

    /// @brief A mutable set of non-negative integers that iterates in ascending order. Negative element arguments trap with `invalid argument: negative element`.
    export let BitSet = class implements MutableSet<int> (
        /// @brief Membership bits grouped into 32 consecutive integers per word.
        let words: uint32[list] = [];
        /// @brief The number of set bits across all stored words.
        let count: int = 0;
        /// @brief The structural modification count shared with iterators.
        let modifications: cell.Cell<uint64> = cell.of<uint64>(0);

        /// @brief Advances the version observed by active iterators.
        let changed = func {
            modifications.value = modifications.value + 1;
        };

        /// @brief Recomputes the member count from the stored words.
        let recount = func {
            let total = 0;
            for (let word in words) {
                total = total + population(word);
            }
            count = total;
        };

        /// @brief The word at `index`, zero beyond the last word.
        let word_at = func(index: int) -> uint32 {
            if (index < words.length) {
                return words[index];
            }
            return 0;
        };

        /// @brief Appends zero words until the storage has at least `length` words.
        let grow_to = func(length: int) {
            while (words.length < length) {
                words.append(0);
            }
        };

        /// @brief Returns the number of distinct elements.
        export let size = func -> int => count;

        /// @brief Returns true when there are no distinct elements.
        export let is_empty = func -> bool => count == 0;

        /// @brief Tests the bit representing `value`. A negative value traps with `invalid argument: negative element`.
        export let contains = func(value: int) -> bool {
            check_element(value);
            let index = value / 32;
            if (index >= words.length) {
                return false;
            }
            return (words[index] & bit(value)) != 0;
        };

        /// @brief Adds the value and returns false if it was already present. Appends zero
        /// words as needed.
        export let add = func(value: int) -> bool {
            check_element(value);
            let index = value / 32;
            let mask = bit(value);
            if (index < words.length && (words[index] & mask) != 0) {
                return false;
            }
            grow_to(index + 1);
            words[index] = words[index] | mask;
            count += 1;
            changed();
            return true;
        };

        /// @brief Adds the members of `items`, ignoring duplicates. A negative item traps with `invalid argument: negative element`.
        export let add_all = func(items: int[list]) {
            let total = items.length;
            let i = 0;
            while (i < total) {
                add(items[i]);
                i += 1;
            }
        };

        /// @brief Removes the value and returns false if it was absent.
        export let remove = func(value: int) -> bool {
            check_element(value);
            let index = value / 32;
            let mask = bit(value);
            if (index >= words.length || (words[index] & mask) == 0) {
                return false;
            }
            words[index] = words[index] & ~mask;
            count -= 1;
            changed();
            return true;
        };

        /// @brief Adds the value when absent and removes it when present.
        export let flip = func(value: int) {
            check_element(value);
            let index = value / 32;
            let mask = bit(value);
            grow_to(index + 1);
            if ((words[index] & mask) != 0) {
                count -= 1;
            } else {
                count += 1;
            }
            words[index] = words[index] ^ mask;
            changed();
        };

        /// @brief Removes all members and releases the stored words.
        export let clear = func {
            let empty: uint32[list] = [];
            words = empty;
            count = 0;
            changed();
        };

        /// @brief The least member at or after `from`, or -1.
        export let next_set = func(from: int) -> int {
            check_element(from);
            return next_in(words, from);
        };

        /// @brief A new built-in list of the members in ascending order.
        export let to_list = func -> int[list] {
            let result: int[list] = [];
            let value = next_in(words, 0);
            while (value >= 0) {
                result.append(value);
                if (value == 2147483647) {
                    break;
                }
                value = next_in(words, value + 1);
            }
            return result;
        };

        /// @brief Returns a fail-fast iterator over the members in ascending order.
        export let iterator = func -> iterators.Iterator<int> => new BitSetIterator(words, modifications);

        /// @brief Ascending. The action must not change the set structurally.
        export let for_each = func(action: func(int) -> void) {
            let expected = modifications.value;
            for (let value in to_list()) {
                action(value);
                if (modifications.value != expected) {
                    trap_with_message("collection modified during iteration");
                }
            }
        };

        /// @brief Calls `drop` once per member in ascending order and removes the matches.
        /// @pre The predicate leaves the set structure unchanged.
        /// @return The number of removed members.
        export let remove_if = func(drop: func(int) -> bool) -> int => remove_matching(drop, true);

        /// @brief Calls `keep` once per member in ascending order, removing rejected members.
        /// @pre The predicate leaves the set structure unchanged.
        /// @return The number of removed members.
        export let retain_if = func(keep: func(int) -> bool) -> int => remove_matching(keep, false);

        /// @brief Walks a snapshot of members in ascending order and removes selected members from the set.
        /// Checks the version after each predicate call.
        let remove_matching = func(test: func(int) -> bool, remove_when: bool) -> int {
            let expected = modifications.value;
            let removed = 0;
            for (let value in to_list()) {
                let matched = test(value);
                if (modifications.value != expected) {
                    trap_with_message("collection modified during iteration");
                }
                if (matched == remove_when) {
                    remove(value);
                    removed += 1;
                    expected = modifications.value;
                }
            }
            return removed;
        };

        /// @brief Reports whether every member is also present in `other`.
        export let is_subset_of = func(other: BitSet) -> bool {
            let i = 0;
            while (i < words.length) {
                if ((words[i] & ~other.word_at(i)) != 0) {
                    return false;
                }
                i += 1;
            }
            return true;
        };

        /// @brief Reports whether the two sets have no members in common.
        export let is_disjoint_from = func(other: BitSet) -> bool {
            let i = 0;
            while (i < words.length) {
                if ((words[i] & other.word_at(i)) != 0) {
                    return false;
                }
                i += 1;
            }
            return true;
        };

        /// @brief In place: adds the other's members.
        export let union_with = func(other: BitSet) {
            let length = other.words.length;
            let before = count;
            grow_to(length);
            let i = 0;
            while (i < length) {
                words[i] = words[i] | other.words[i];
                i += 1;
            }
            recount();
            if (count != before) {
                changed();
            }
        };

        /// @brief In place: keeps only members the other also has.
        export let intersect_with = func(other: BitSet) {
            let before = count;
            let i = 0;
            while (i < words.length) {
                words[i] = words[i] & other.word_at(i);
                i += 1;
            }
            recount();
            if (count != before) {
                changed();
            }
        };

        /// @brief In place: removes the other's members.
        export let subtract = func(other: BitSet) {
            let before = count;
            let i = 0;
            while (i < words.length) {
                words[i] = words[i] & ~other.word_at(i);
                i += 1;
            }
            recount();
            if (count != before) {
                changed();
            }
        };

        /// @brief In place: keeps the members in exactly one of the two sets.
        export let symmetric_difference_with = func(other: BitSet) {
            let length = other.words.length;
            grow_to(length);
            let different = false;
            let i = 0;
            while (i < length) {
                if (other.words[i] != 0) {
                    words[i] = words[i] ^ other.words[i];
                    different = true;
                }
                i += 1;
            }
            recount();
            if (different) {
                changed();
            }
        };

        /// @brief Returns a set with independent word storage and the same members.
        let copy = func -> BitSet {
            let result = new BitSet();
            for (let word in words) {
                result.words.append(word);
            }
            result.count = count;
            return result;
        };

        /// @brief A new set of the members of either set.
        export let union = func(other: BitSet) -> BitSet {
            let result = copy();
            result.union_with(other);
            return result;
        };

        /// @brief A new set of the members of both sets.
        export let intersection = func(other: BitSet) -> BitSet {
            let result = copy();
            result.intersect_with(other);
            return result;
        };

        /// @brief A new set of this set's members that the other lacks.
        export let difference = func(other: BitSet) -> BitSet {
            let result = copy();
            result.subtract(other);
            return result;
        };

        /// @brief Tests for another BitSet with the same members, ignoring trailing zero words.
        export let.override equals = func(other: class) -> bool {
            if (!(other is BitSet)) {
                return false;
            }
            let that = other as BitSet;
            if (that.count != count) {
                return false;
            }
            let length = words.length;
            if (that.words.length > length) {
                length = that.words.length;
            }
            let i = 0;
            while (i < length) {
                if (word_at(i) != that.word_at(i)) {
                    return false;
                }
                i += 1;
            }
            return true;
        };

        /// @brief The wrapping sum of the members' hashes (each member's own value).
        export let.override hash_code = func -> uint32 {
            let sum: uint64 = 0;
            for (let value in to_list()) {
                sum = (sum + (value as uint64)) & 4294967295;
            }
            return sum as uint32;
        };

        /// @brief `{a, b, c}` in ascending order.
        export let.override to_string = func -> string {
            let text = "{";
            let first = true;
            for (let value in to_list()) {
                if (!first) {
                    text = text + ", ";
                }
                text = text + value.to_string();
                first = false;
            }
            return text + "}";
        };
    );

    /// @brief Ascending, comparing the set's modification count before every step.
    let BitSetIterator = class implements iterators.Iterator<int> (
        /// @brief The set's live membership words.
        let words: uint32[list];
        /// @brief The live modification counter shared with the source collection.
        let modifications: cell.Cell<uint64>;
        /// @brief The source version recorded when the iterator was created.
        let expected: uint64;
        /// @brief The next member to return, or -1 at exhaustion.
        let upcoming: int;

        /// @brief Captures the words and version and finds the least member.
        export let init = func(source: uint32[list], counter: cell.Cell<uint64>) {
            words = source;
            modifications = counter;
            expected = counter.value;
            upcoming = next_in(source, 0);
        };

        /// @brief Reports whether another element remains. Traps with `collection modified during iteration` after a structural change.
        export let has_next = func -> bool {
            if (modifications.value != expected) {
                trap_with_message("collection modified during iteration");
            }
            return upcoming >= 0;
        };

        /// @brief Returns the next element and advances. Traps with `collection modified during iteration` after a structural change. Traps with `no such element` at exhaustion.
        export let next = func -> int {
            if (modifications.value != expected) {
                trap_with_message("collection modified during iteration");
            }
            let value = upcoming;
            if (value < 0) {
                trap_with_message("no such element");
            }
            if (value == 2147483647) {
                upcoming = -1;
            } else {
                upcoming = next_in(words, value + 1);
            }
            return value;
        };
    );

    /// @brief Creates an empty set.
    export let create = func -> BitSet => new BitSet();

    /// @brief A set of the values in `items`.
    export let of = func(items: int[list]) -> BitSet {
        let result = new BitSet();
        result.add_all(items);
        return result;
    };
);
