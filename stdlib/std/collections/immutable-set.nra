let hash_set = import:Std.Collections.HashSet;
let.promote _ = import:Std.Collections.Iterator;
let.promote _ = import:Std.Collections.Set;

/// @brief Sets whose membership is fixed at construction. Elements use `equals` and
/// `hash_code`. Iteration follows the order of first occurrence.
/// @see [Std.Collections.ImmutableSet](https://github.com/Kayyo321/neura/wiki/Stdlib-Collections-ImmutableSet)
export let ImmutableSet = module (
    /// @brief A private token type that restricts construction to module factories.
    let Seal = enum (Token);

    /// @brief A read-only hash set with elements in first-occurrence order.
    export let ImmutableSet = class<T> implements Set<T> (
        /// @brief The private hash set storing distinct elements in first-occurrence order.
        let elements: hash_set.HashSet<T>;

        /// @brief Copies the supplied elements into a private hash set, dropping later duplicates.
        export let init = func(seal: Seal, values: T[list]) {
            elements = hash_set.create<T>();
            elements.add_all(values);
        };

        /// @brief Returns the number of distinct elements.
        export let size = func -> int => elements.size();

        /// @brief Returns true when there are no distinct elements.
        export let is_empty = func -> bool => elements.size() == 0;

        /// @brief Tests membership using the element's hash and equality.
        export let contains = func(value: T) -> bool => elements.contains(value);

        /// @brief A new built-in list in iteration order.
        export let to_list = func -> T[list] => elements.to_list();

        /// @brief Returns an iterator in first-occurrence order.
        export let iterator = func -> Iterator<T> => elements.iterator();

        /// @brief Calls `action` with each distinct element in first-occurrence order.
        export let for_each = func(action: func(T) -> void) {
            elements.for_each(action);
        };

        /// @brief Another ImmutableSet of the same size whose elements this set all
        /// contains.
        export let.override equals = func(other: class) -> bool {
            if (!(other is ImmutableSet<T>)) {
                return false;
            }
            let that = other as ImmutableSet<T>;
            if (that.size() != elements.size()) {
                return false;
            }
            let items = that.to_list();
            let count = items.length;
            let i = 0;
            while (i < count) {
                if (!elements.contains(items[i])) {
                    return false;
                }
                i += 1;
            }
            return true;
        };

        /// @brief The wrapping sum of the element hashes.
        export let.override hash_code = func -> uint32 => elements.hash_code();

        /// @brief `{a, b, c}` in iteration order. The elements exist before the set,
        /// so it can never contain itself.
        export let.override to_string = func -> string => elements.to_string();
    );

    /// @brief Creates a set from a shallow copy of `items`, dropping later duplicates.
    export let of = func<T>(items: T[list]) -> ImmutableSet<T> => new ImmutableSet<T>(Seal.Token, items);
);
