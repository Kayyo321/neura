let queue = import:Std.Collections.Queue;

// Access at both ends. `enqueue` is add_last and `dequeue` is remove_first.
export let Deque = module (
    export let Deque = interface<T>:queue.Queue<T> (
        let add_first = func(T value) -> void;
        let add_last = func(T value) -> void;
        // Trap with "no such element" when empty.
        let remove_first = func() -> T;
        let remove_last = func() -> T;
        let first = func() -> T;
        let last = func() -> T;
    );
);
