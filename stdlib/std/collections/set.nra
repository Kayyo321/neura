let.promote _ = import:Std.Collections.Collection;

/// @brief A read-only collection without duplicates (HashSet, TreeSet, BitSet,
/// ImmutableSet).
/// @see [Std.Collections.Set](https://github.com/Kayyo321/neura/wiki/Stdlib-Collections-Set)
#Since("0.1.0")
export let Set = module (
    /// @brief Read-only access to a collection of distinct elements.
    export let Set = interface<T>:Collection<T> ();
);
