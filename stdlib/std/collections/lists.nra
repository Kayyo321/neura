let list = import:Std.Collections.List;

/// @brief Helpers for built-in lists (Stdlib.md section 9.11) and the comparison of
/// list collections of different classes (section 9.10). An index outside a
/// list is the language's bounds trap.
/// @see [Std.Collections.Lists](https://github.com/Kayyo321/neura/wiki/Stdlib-Collections-Lists)
export let Lists = module (
    /// @brief A new list with the same elements.
    export let copy = func<T>(items: T[list]) -> T[list] {
        let result: T[list] = [];
        let count = items.length;
        let i = 0;
        while (i < count) {
            result.append(items[i]);
            i += 1;
        }
        return result;
    };

    /// @brief A new list with the elements of `a` followed by those of `b`.
    export let concat = func<T>(a: T[list], b: T[list]) -> T[list] {
        let result = copy<T>(a);
        let count = b.length;
        let i = 0;
        while (i < count) {
            result.append(b[i]);
            i += 1;
        }
        return result;
    };

    /// @brief Reverses the list in place. Not structural.
    export let reverse = func<T>(items: T[list]) {
        let i = 0;
        let j = items.length - 1;
        while (i < j) {
            let value = items[i];
            items[i] = items[j];
            items[j] = value;
            i += 1;
            j -= 1;
        }
    };

    /// @brief Exchanges two elements. Not structural.
    export let swap = func<T>(items: T[list], i: int, j: int) {
        let value = items[i];
        items[i] = items[j];
        items[j] = value;
    };

    /// @brief Replaces every element with `value`. Not structural.
    export let fill = func<T>(items: T[list], value: T) {
        let count = items.length;
        let i = 0;
        while (i < count) {
            items[i] = value;
            i += 1;
        }
    };

    /// @brief Inserts `value` before position `index`, or appends when the index equals the length. Appends the last element again and shifts the suffix right by
    /// indexed writes.
    export let insert_at = func<T>(items: T[list], index: int, value: T) {
        let count = items.length;
        if (index == count) {
            items.append(value);
            return;
        }
        // The read makes any other bad index a bounds trap before the list
        // changes.
        let displaced = items[index];
        items.append(items[count - 1]);
        let k = count - 1;
        while (k > index) {
            items[k] = items[k - 1];
            k -= 1;
        }
        items[index] = value;
    };

    /// @brief Removes elements from the end until `length` remain. Traps with
    /// "invalid argument: negative size" or "invalid argument: size above
    /// current size".
    export let truncate = func<T>(items: T[list], length: int) {
        if (length < 0) {
            trap_with_message("invalid argument: negative size");
        }
        if (length > items.length) {
            trap_with_message("invalid argument: size above current size");
        }
        while (items.length > length) {
            items.remove_at(items.length - 1);
        }
    };

    /// @brief Removes every element from the end of the same list.
    export let clear = func<T>(items: T[list]) {
        while (items.length > 0) {
            items.remove_at(items.length - 1);
        }
    };

    /// @brief A new list of `count` copies of `value`. Traps with "invalid argument:
    /// negative count".
    export let filled = func<T>(count: int, value: T) -> T[list] {
        if (count < 0) {
            trap_with_message("invalid argument: negative count");
        }
        let result: T[list] = [];
        let i = 0;
        while (i < count) {
            result.append(value);
            i += 1;
        }
        return result;
    };

    /// @brief A new list with the array's elements.
    export let from_array = func<T>(items: T[]) -> T[list] {
        let result: T[list] = [];
        let count = items.length;
        let i = 0;
        while (i < count) {
            result.append(items[i]);
            i += 1;
        }
        return result;
    };

    /// @brief Whether two lists of any classes have the same size and equal elements
    /// at each position, by equals with the element of `a` first.
    export let same_elements = func<T>(a: list.List<T>, b: list.List<T>) -> bool {
        if (a.size() != b.size()) {
            return false;
        }
        let left = a.iterator();
        let right = b.iterator();
        while (left.has_next() && right.has_next()) {
            if (!left.next().equals(right.next())) {
                return false;
            }
        }
        return !left.has_next() && !right.has_next();
    };
);
