let cell = import:Std.Core.Cell;
let iterators = import:Std.Collections.Iterator;
let.promote _ = import:Std.Collections.MutableMap;
let optional = import:Std.Core.Optional;
let ordering = import:Std.Core.Ordering;
let.promote _ = import:Std.Collections.SortedMap;

/// @brief Sorted maps implemented as AVL trees. The comparator defines key identity and order and
/// takes the probe key first during lookup. Iteration follows the in-order successor without
/// a stack. Updating a value for an existing key preserves iterator validity. Iterators and
/// member callbacks detect structural changes and trap with `collection modified during iteration`.
/// @see [Std.Collections.TreeMap](https://github.com/Kayyo321/neura/wiki/Stdlib-Collections-TreeMap)
#Since("0.1.0")
export let TreeMap = module (
    /// @brief A private token type that restricts construction to module factories.
    let Seal = enum (Token);

    /// @brief An AVL node holding an entry, parent and child links, and subtree height.
    let Node = class<K, V> (
        /// @brief The key held by the node.
        export let key: K;
        /// @brief The value currently associated with the key.
        export let value: V;
        /// @brief The subtree of smaller keys, or `nil`.
        export let left: Node<K, V> = nil;
        /// @brief The subtree of greater keys, or `nil`.
        export let right: Node<K, V> = nil;
        /// @brief The parent node, or `nil` for the root.
        export let parent: Node<K, V> = nil;
        /// @brief A leaf has height 1.
        export let height: int = 1;

        /// @brief Creates a leaf holding the supplied entry and parent link.
        export let init = func(item_key: K, item_value: V, above: Node<K, V>) {
            key = item_key;
            value = item_value;
            parent = above;
        };
    );

    /// @brief A mutable AVL tree map that identifies keys by comparator equality.
    export let TreeMap = class<K, V> implements MutableMap<K, V>, SortedMap<K, V> (
        /// @brief The root node, or `nil` when the tree is empty.
        let root: Node<K, V> = nil;
        /// @brief The number of entries stored in the tree.
        let count: int = 0;
        /// @brief The key comparator that defines identity and navigation order.
        last compare: func(K, K) -> ordering.Ordering;
        /// @brief The modification count, shared with iterators.
        last changes: cell.Cell<uint64>;
        /// @brief Whether this instance's text conversion is running.
        let printing: bool = false;

        /// @brief Starts an empty tree with the comparator supplied by the factory.
        export let init = func(seal: Seal, comparator: func(K, K) -> ordering.Ordering) {
            compare = comparator;
            changes = cell.of<uint64>(0);
        };

        /// @brief Returns the number of entries.
        export let size = func -> int => count;

        /// @brief Returns true when there are no entries.
        export let is_empty = func -> bool => count == 0;

        /// @brief Removes all entries and invalidates iterators.
        export let clear = func {
            root = nil;
            count = 0;
            changes.value = changes.value + 1;
        };

        /// @brief Tests for an existing key that compares equal to the probe.
        export let contains_key = func(key: K) -> bool => find_node(key) != nil;

        /// @brief Returns the associated value as `Some`, or `None` when the key is absent.
        #NoDiscard
        export let get = func(key: K) -> optional.Optional<V> {
            last node = find_node(key);
            if (node == nil) {
                return optional.Optional<V>.None;
            }
            return optional.Optional<V>.Some(node.value);
        };

        /// @brief Returns the associated value, or `fallback` when the key is absent.
        export let get_or = func(key: K, fallback: V) -> V {
            last node = find_node(key);
            if (node == nil) {
                return fallback;
            }
            return node.value;
        };

        /// @brief Returns the associated value. Traps with `no such element` when the key is absent.
        export let require = func(key: K) -> V {
            last node = find_node(key);
            if (node == nil) {
                trap_with_message("no such element");
            }
            return node.value;
        };

        /// @brief Stores the value for `key`. A comparator-equal entry keeps its original key and iterator validity.
        export let set = func(key: K, value: V) {
            last existing = insert(key, value);
            if (existing != nil) {
                existing.value = value;
            }
        };

        /// @brief Stores the value for `key` and returns its previous value as `Some`, or `None` for a new key.
        export let put = func(key: K, value: V) -> optional.Optional<V> {
            last existing = insert(key, value);
            if (existing == nil) {
                return optional.Optional<V>.None;
            }
            last previous = existing.value;
            existing.value = value;
            return optional.Optional<V>.Some(previous);
        };

        /// @brief Removes the entry for `key`. Returns true if an entry was present.
        export let delete = func(key: K) -> bool {
            last node = find_node(key);
            if (node == nil) {
                return false;
            }
            unlink(node);
            return true;
        };

        /// @brief Removes the entry for `key` and returns its value as `Some`, or `None` when absent.
        export let remove = func(key: K) -> optional.Optional<V> {
            last node = find_node(key);
            if (node == nil) {
                return optional.Optional<V>.None;
            }
            let value = node.value;
            unlink(node);
            return optional.Optional<V>.Some(value);
        };

        /// @brief Copies the keys to a new built-in list in ascending key order.
        export let keys = func -> K[list] {
            last result: K[list] = [];
            let node = leftmost(root);
            while (node != nil) {
                result.append(node.key);
                node = successor(node);
            }
            return result;
        };

        /// @brief Copies the values to a new built-in list in ascending key order.
        export let values = func -> V[list] {
            last result: V[list] = [];
            let node = leftmost(root);
            while (node != nil) {
                result.append(node.value);
                node = successor(node);
            }
            return result;
        };

        /// @brief Copies the `[key, value]` tuples to a new built-in list in ascending key order.
        export let entries = func -> [K, V][list] {
            last result: [K, V][list] = [];
            let node = leftmost(root);
            while (node != nil) {
                last item: [K, V] = [node.key, node.value];
                result.append(item);
                node = successor(node);
            }
            return result;
        };

        /// @brief Returns a fail-fast iterator over `[key, value]` tuples in ascending key order.
        export let iterator = func -> iterators.Iterator<[K, V]> =>
            new TreeMapIterator<K, V>(leftmost(root), changes);

        /// @brief Returns a fail-fast iterator over keys in ascending order.
        export let key_iterator = func -> iterators.Iterator<K> =>
            new TreeKeyIterator<K, V>(leftmost(root), changes);

        /// @brief Sets each entry of `other` in its ascending order.
        export let put_all = func(other: TreeMap<K, V>) {
            last items = other.entries();
            last total = items.length;
            let i = 0;
            while (i < total) {
                let [key, value] = items[i];
                set(key, value);
                i += 1;
            }
        };

        /// @brief Calls `action` with the key and value of each entry in ascending key order.
        /// @pre The action leaves the map structure unchanged.
        export let for_each = func(action: func(K, V) -> void) {
            last expected = changes.value;
            let node = leftmost(root);
            while (node != nil) {
                action(node.key, node.value);
                if (changes.value != expected) {
                    trap_with_message("collection modified during iteration");
                }
                node = successor(node);
            }
        };

        /// @brief Calls `drop` once per entry in ascending key order, then removes the matches.
        /// @pre The predicate leaves the map structure unchanged.
        /// @return The number of removed entries.
        export let remove_if = func(drop: func(K, V) -> bool) -> int {
            last expected = changes.value;
            last chosen: K[list] = [];
            let node = leftmost(root);
            while (node != nil) {
                last removing = drop(node.key, node.value);
                if (changes.value != expected) {
                    trap_with_message("collection modified during iteration");
                }
                if (removing) {
                    chosen.append(node.key);
                }
                node = successor(node);
            }
            last total = chosen.length;
            let i = 0;
            while (i < total) {
                unlink(find_node(chosen[i]));
                i += 1;
            }
            return total;
        };

        /// @brief Returns the associated value, or calls `make` once, stores its result, and returns it when absent.
        /// @pre The factory leaves the map structure unchanged.
        export let get_or_put = func(key: K, make: func() -> V) -> V {
            last node = find_node(key);
            if (node != nil) {
                return node.value;
            }
            last expected = changes.value;
            let value = make();
            if (changes.value != expected) {
                trap_with_message("collection modified during iteration");
            }
            insert(key, value);
            return value;
        };

        /// @brief Stores and returns `value` when the key is absent. Otherwise stores and returns `combine(old, value)`.
        /// @pre The combiner leaves the map structure unchanged.
        export let merge = func(key: K, value: V, combine: func(V, V) -> V) -> V {
            last node = find_node(key);
            if (node == nil) {
                insert(key, value);
                return value;
            }
            last expected = changes.value;
            last combined = combine(node.value, value);
            if (changes.value != expected) {
                trap_with_message("collection modified during iteration");
            }
            node.value = combined;
            return combined;
        };

        /// @brief Calls `f` with the key and its optional current value. Stores a `Some` result or removes the entry for `None`.
        /// @pre The callback leaves the map structure unchanged.
        /// @return The result of the callback.
        export let compute = func(key: K, f: func(K, optional.Optional<V>) -> optional.Optional<V>) -> optional.Optional<V> {
            last node = find_node(key);
            let current = optional.Optional<V>.None;
            if (node != nil) {
                current = optional.Optional<V>.Some(node.value);
            }
            last expected = changes.value;
            last outcome = f(key, current);
            if (changes.value != expected) {
                trap_with_message("collection modified during iteration");
            }
            match (outcome) {
                optional.Optional.Some(value) => {
                    if (node != nil) {
                        node.value = value;
                    } else {
                        insert(key, value);
                    }
                },
                optional.Optional.None => {
                    if (node != nil) {
                        unlink(node);
                    }
                },
            }
            return outcome;
        };

        /// @brief Tests whether `value.equals(held_value)` is true for any entry.
        export let contains_value = func(value: V) -> bool {
            let node = leftmost(root);
            while (node != nil) {
                if (value === node.value) {
                    return true;
                }
                node = successor(node);
            }
            return false;
        };

        /// @brief Returns the entry with the least key. Traps with `no such element` when empty.
        export let first = func -> [K, V] {
            if (root == nil) {
                trap_with_message("no such element");
            }
            last node = leftmost(root);
            last item: [K, V] = [node.key, node.value];
            return item;
        };

        /// @brief Returns the entry with the greatest key. Traps with `no such element` when empty.
        export let last = func -> [K, V] {
            if (root == nil) {
                trap_with_message("no such element");
            }
            last node = rightmost(root);
            last item: [K, V] = [node.key, node.value];
            return item;
        };

        /// @brief Removes and returns the entry with the least key. Traps with "no
        /// such element" when empty.
        export let remove_first = func -> [K, V] {
            if (root == nil) {
                trap_with_message("no such element");
            }
            last node = leftmost(root);
            last item: [K, V] = [node.key, node.value];
            unlink(node);
            return item;
        };

        /// @brief Removes and returns the entry with the greatest key. Traps with "no
        /// such element" when empty.
        export let remove_last = func -> [K, V] {
            if (root == nil) {
                trap_with_message("no such element");
            }
            last node = rightmost(root);
            last item: [K, V] = [node.key, node.value];
            unlink(node);
            return item;
        };

        /// @brief Returns a new list of entries in ascending key order from `from` inclusive to `to` exclusive.
        /// Returns an empty list when `to` is at or below `from`.
        export let range = func(from: K, to: K) -> [K, V][list] {
            last result: [K, V][list] = [];
            let node = ceiling_node(from, true);
            while (node != nil && compare(to, node.key) == ordering.Ordering.Greater) {
                last item: [K, V] = [node.key, node.value];
                result.append(item);
                node = successor(node);
            }
            return result;
        };

        /// @brief Copies the keys from `from` inclusive to `to` exclusive in ascending order.
        export let key_range = func(from: K, to: K) -> K[list] {
            last result: K[list] = [];
            let node = ceiling_node(from, true);
            while (node != nil && compare(to, node.key) == ordering.Ordering.Greater) {
                result.append(node.key);
                node = successor(node);
            }
            return result;
        };

        /// @brief Copies entries into a new list in descending key order.
        export let descending = func -> [K, V][list] {
            last result: [K, V][list] = [];
            let node = rightmost(root);
            while (node != nil) {
                last item: [K, V] = [node.key, node.value];
                result.append(item);
                node = predecessor(node);
            }
            return result;
        };

        /// @brief Copies the keys into a new list in descending order.
        export let descending_keys = func -> K[list] {
            last result: K[list] = [];
            let node = rightmost(root);
            while (node != nil) {
                result.append(node.key);
                node = predecessor(node);
            }
            return result;
        };

        /// @brief Returns the greatest key at most `key` as `Some`, or `None` when absent.
        #NoDiscard
        export let floor = func(key: K) -> optional.Optional<K> => key_of(floor_node(key, true));

        /// @brief Returns the least key at least `key` as `Some`, or `None` when absent.
        #NoDiscard
        export let ceiling = func(key: K) -> optional.Optional<K> => key_of(ceiling_node(key, true));

        /// @brief Returns the greatest key strictly below `key` as `Some`, or `None` when absent.
        #NoDiscard
        export let lower = func(key: K) -> optional.Optional<K> => key_of(floor_node(key, false));

        /// @brief Returns the least key strictly above `key` as `Some`, or `None` when absent.
        #NoDiscard
        export let higher = func(key: K) -> optional.Optional<K> => key_of(ceiling_node(key, false));

        /// @brief Returns the entry with the greatest key at most `key`, or `None` when absent.
        #NoDiscard
        export let floor_entry = func(key: K) -> optional.Optional<[K, V]> => entry_of(floor_node(key, true));

        /// @brief Returns the entry with the least key at least `key`, or `None` when absent.
        #NoDiscard
        export let ceiling_entry = func(key: K) -> optional.Optional<[K, V]> =>
            entry_of(ceiling_node(key, true));

        /// @brief Returns the entry with the greatest key strictly below `key`, or `None` when absent.
        #NoDiscard
        export let lower_entry = func(key: K) -> optional.Optional<[K, V]> => entry_of(floor_node(key, false));

        /// @brief Returns the entry with the least key strictly above `key`, or `None` when absent.
        #NoDiscard
        export let higher_entry = func(key: K) -> optional.Optional<[K, V]> =>
            entry_of(ceiling_node(key, false));

        /// @brief Traps with "invalid state: tree ..." on a broken invariant: AVL
        /// balance, stored heights, ascending key order, reciprocal parent
        /// links, a nil parent at the root, and the count.
        export let validate = func {
            if (root != nil && root.parent != nil) {
                trap_with_message("invalid state: tree root parent");
            }
            let visited = 0;
            let previous: Node<K, V> = nil;
            let node = leftmost(root);
            while (node != nil) {
                visited += 1;
                if (visited > count) {
                    trap_with_message("invalid state: tree count");
                }
                last left_height = height_of(node.left);
                last right_height = height_of(node.right);
                if (node.height != larger(left_height, right_height) + 1) {
                    trap_with_message("invalid state: tree height");
                }
                if (left_height > right_height + 1 || right_height > left_height + 1) {
                    trap_with_message("invalid state: tree balance");
                }
                if (node.left != nil && node.left.parent != node) {
                    trap_with_message("invalid state: tree parent link");
                }
                if (node.right != nil && node.right.parent != node) {
                    trap_with_message("invalid state: tree parent link");
                }
                last above = node.parent;
                if (above == nil) {
                    if (node != root) {
                        trap_with_message("invalid state: tree parent link");
                    }
                } else if (above.left != node && above.right != node) {
                    trap_with_message("invalid state: tree parent link");
                }
                if (previous != nil && compare(previous.key, node.key) != ordering.Ordering.Less) {
                    trap_with_message("invalid state: tree order");
                }
                previous = node;
                node = successor(node);
            }
            if (visited != count) {
                trap_with_message("invalid state: tree count");
            }
        };

        /// @brief Another TreeMap of the same size in which, for each of its entries,
        /// this map holds an equal value for the key.
        export let.override equals = func(other: class) -> bool {
            if (!(other is TreeMap<K, V>)) {
                return false;
            }
            last that = other as TreeMap<K, V>;
            if (that.size() != count) {
                return false;
            }
            last items = that.entries();
            last total = items.length;
            let i = 0;
            while (i < total) {
                let [key, value] = items[i];
                last node = find_node(key);
                if (node == nil || !node.value.equals(value)) {
                    return false;
                }
                i += 1;
            }
            return true;
        };

        /// @brief The wrapping sum over entries of the key hash exclusive-or the
        /// value hash.
        export let.override hash_code = func -> uint32 {
            let total: uint64 = 0;
            let node = leftmost(root);
            while (node != nil) {
                last mixed = node.key.hash_code() ^ node.value.hash_code();
                total = (total + (mixed as uint64)) & 4294967295;
                node = successor(node);
            }
            return total as uint32;
        };

        /// @brief Formats entries as `{k: v, k2: v2}` in ascending order. The map prints "(this collection)"
        /// where its own text reaches it again.
        export let.override to_string = func -> string {
            if (printing) {
                return "(this collection)";
            }
            printing = true;
            last parts: string[list] = [];
            let node = leftmost(root);
            while (node != nil) {
                parts.append(node.key.to_string() + ": " + node.value.to_string());
                node = successor(node);
            }
            printing = false;
            last text = parts.to_string();
            return "{" + text.slice(1, text.byte_length - 1) + "}";
        };

        /// @brief Finds the node whose key compares equal to `key`, or returns `nil` when absent.
        let find_node = func(key: K) -> Node<K, V> {
            let node = root;
            while (node != nil) {
                last order = compare(key, node.key);
                if (order == ordering.Ordering.Less) {
                    node = node.left;
                } else if (order == ordering.Ordering.Greater) {
                    node = node.right;
                } else {
                    return node;
                }
            }
            return nil;
        };

        /// @brief Returns the node that already holds the key, unchanged, or nil
        /// after attaching a new node and rebalancing.
        let insert = func(key: K, value: V) -> Node<K, V> {
            if (root == nil) {
                root = new Node<K, V>(key, value, nil);
                count = 1;
                changes.value = changes.value + 1;
                return nil;
            }
            let node = root;
            do {
                last order = compare(key, node.key);
                if (order == ordering.Ordering.Less) {
                    if (node.left == nil) {
                        node.left = new Node<K, V>(key, value, node);
                        break;
                    }
                    node = node.left;
                } else if (order == ordering.Ordering.Greater) {
                    if (node.right == nil) {
                        node.right = new Node<K, V>(key, value, node);
                        break;
                    }
                    node = node.right;
                } else {
                    return node;
                }
            }
            count += 1;
            changes.value = changes.value + 1;
            rebalance_from(node);
            return nil;
        };

        /// @brief Removes a node. A node with two children takes the key and value
        /// of its in-order successor, which is unlinked instead.
        let unlink = func(node: Node<K, V>) {
            let target = node;
            if (node.left != nil && node.right != nil) {
                target = leftmost(node.right);
                node.key = target.key;
                node.value = target.value;
            }
            let child = target.left;
            if (child == nil) {
                child = target.right;
            }
            last above = target.parent;
            if (child != nil) {
                child.parent = above;
            }
            replace_child(above, target, child);
            target.left = nil;
            target.right = nil;
            target.parent = nil;
            count -= 1;
            changes.value = changes.value + 1;
            rebalance_from(above);
        };

        /// @brief Walks up from `start`, recomputing heights and rotating where the
        /// children's heights differ by 2, until a subtree's height is
        /// unchanged.
        let rebalance_from = func(start: Node<K, V>) {
            let node = start;
            while (node != nil) {
                last previous = node.height;
                last left_height = height_of(node.left);
                last right_height = height_of(node.right);
                let top = node;
                if (left_height > right_height + 1) {
                    last child = node.left;
                    if (height_of(child.left) < height_of(child.right)) {
                        rotate_left(child);
                    }
                    top = rotate_right(node);
                } else if (right_height > left_height + 1) {
                    last child = node.right;
                    if (height_of(child.right) < height_of(child.left)) {
                        rotate_right(child);
                    }
                    top = rotate_left(node);
                } else {
                    node.height = larger(left_height, right_height) + 1;
                }
                if (top.height == previous) {
                    return;
                }
                node = top.parent;
            }
        };

        /// @brief Lifts the right child of `node` above it and returns the new subtree
        /// top.
        let rotate_left = func(node: Node<K, V>) -> Node<K, V> {
            last lifted = node.right;
            last inner = lifted.left;
            node.right = inner;
            if (inner != nil) {
                inner.parent = node;
            }
            last above = node.parent;
            lifted.parent = above;
            replace_child(above, node, lifted);
            lifted.left = node;
            node.parent = lifted;
            node.height = larger(height_of(node.left), height_of(inner)) + 1;
            lifted.height = larger(node.height, height_of(lifted.right)) + 1;
            return lifted;
        };

        /// @brief Lifts the left child of `node` above it and returns the new subtree
        /// top.
        let rotate_right = func(node: Node<K, V>) -> Node<K, V> {
            last lifted = node.left;
            last inner = lifted.right;
            node.left = inner;
            if (inner != nil) {
                inner.parent = node;
            }
            last above = node.parent;
            lifted.parent = above;
            replace_child(above, node, lifted);
            lifted.right = node;
            node.parent = lifted;
            node.height = larger(height_of(inner), height_of(node.right)) + 1;
            lifted.height = larger(height_of(lifted.left), node.height) + 1;
            return lifted;
        };

        /// @brief Points the link that held `old` at `replacement`: the parent's
        /// child link, or root when there is no parent.
        let replace_child = func(above: Node<K, V>, old: Node<K, V>, replacement: Node<K, V>) {
            if (above == nil) {
                root = replacement;
            } else if (above.left == old) {
                above.left = replacement;
            } else {
                above.right = replacement;
            }
        };

        /// @brief The node with the greatest key at most (or below) `key`.
        let floor_node = func(key: K, inclusive: bool) -> Node<K, V> {
            let best: Node<K, V> = nil;
            let node = root;
            while (node != nil) {
                last order = compare(key, node.key);
                if (order == ordering.Ordering.Equal && inclusive) {
                    return node;
                }
                if (order == ordering.Ordering.Greater) {
                    best = node;
                    node = node.right;
                } else {
                    node = node.left;
                }
            }
            return best;
        };

        /// @brief The node with the least key at least (or above) `key`.
        let ceiling_node = func(key: K, inclusive: bool) -> Node<K, V> {
            let best: Node<K, V> = nil;
            let node = root;
            while (node != nil) {
                last order = compare(key, node.key);
                if (order == ordering.Ordering.Equal && inclusive) {
                    return node;
                }
                if (order == ordering.Ordering.Less) {
                    best = node;
                    node = node.left;
                } else {
                    node = node.right;
                }
            }
            return best;
        };

        /// @brief Returns the node's key as `Some`, or `None` for `nil`.
        let key_of = func(node: Node<K, V>) -> optional.Optional<K> {
            if (node == nil) {
                return optional.Optional<K>.None;
            }
            return optional.Optional<K>.Some(node.key);
        };

        /// @brief Returns the node's entry as `Some`, or `None` for `nil`.
        let entry_of = func(node: Node<K, V>) -> optional.Optional<[K, V]> {
            if (node == nil) {
                return optional.Optional<[K, V]>.None;
            }
            last item: [K, V] = [node.key, node.value];
            return optional.Optional<[K, V]>.Some(item);
        };

        /// @brief Returns the cached subtree height, or zero for `nil`.
        let height_of = func(node: Node<K, V>) -> int {
            if (node == nil) {
                return 0;
            }
            return node.height;
        };

        /// @brief Returns the least-key node in the subtree, or `nil` for an empty subtree.
        let leftmost = func(start: Node<K, V>) -> Node<K, V> => leftmost_node<K, V>(start);

        /// @brief Returns the greatest-key node in the subtree, or `nil` for an empty subtree.
        let rightmost = func(start: Node<K, V>) -> Node<K, V> {
            if (start == nil) {
                return nil;
            }
            let node = start;
            while (node.right != nil) {
                node = node.right;
            }
            return node;
        };

        /// @brief Returns the next node in key order, or `nil` after the greatest key.
        let successor = func(node: Node<K, V>) -> Node<K, V> => successor_node<K, V>(node);

        /// @brief The in-order predecessor, through `left` and `parent`.
        let predecessor = func(node: Node<K, V>) -> Node<K, V> {
            if (node.left != nil) {
                return rightmost(node.left);
            }
            let child = node;
            let above = node.parent;
            while (above != nil && above.left == child) {
                child = above;
                above = above.parent;
            }
            return above;
        };
    );

    /// @brief Compares the modification count before every step.
    let TreeMapIterator = class<K, V> implements iterators.Iterator<[K, V]> (
        /// @brief The next node to visit, or `nil` at exhaustion.
        let upcoming: Node<K, V>;
        /// @brief The live modification counter shared with the tree.
        last changes: cell.Cell<uint64>;
        /// @brief The source version recorded when the iterator was created.
        last expected: uint64;

        /// @brief Captures the starting node and current modification count.
        export let init = func(start: Node<K, V>, counter: cell.Cell<uint64>) {
            upcoming = start;
            changes = counter;
            expected = counter.value;
        };

        /// @brief Reports whether another element remains. Traps with `collection modified during iteration` after a structural change.
        export let has_next = func -> bool {
            if (changes.value != expected) {
                trap_with_message("collection modified during iteration");
            }
            return upcoming != nil;
        };

        /// @brief Returns the next `[key, value]` tuple in ascending order and advances. Traps with `collection modified during iteration` after a structural change. Traps with `no such element` at exhaustion.
        export let next = func -> [K, V] {
            if (!has_next()) {
                trap_with_message("no such element");
            }
            last node = upcoming;
            upcoming = successor_node<K, V>(node);
            last item: [K, V] = [node.key, node.value];
            return item;
        };
    );

    /// @brief A fail-fast traversal over ascending keys without building entry tuples.
    let TreeKeyIterator = class<K, V> implements iterators.Iterator<K> (
        /// @brief The next node to visit, or `nil` at exhaustion.
        let upcoming: Node<K, V>;
        /// @brief The live modification counter shared with the tree.
        last changes: cell.Cell<uint64>;
        /// @brief The source version recorded when the iterator was created.
        last expected: uint64;

        /// @brief Captures the starting node and current modification count.
        export let init = func(start: Node<K, V>, counter: cell.Cell<uint64>) {
            upcoming = start;
            changes = counter;
            expected = counter.value;
        };

        /// @brief Reports whether another element remains. Traps with `collection modified during iteration` after a structural change.
        export let has_next = func -> bool {
            if (changes.value != expected) {
                trap_with_message("collection modified during iteration");
            }
            return upcoming != nil;
        };

        /// @brief Returns the next key in ascending order and advances. Traps with `collection modified during iteration` after a structural change. Traps with `no such element` at exhaustion.
        export let next = func -> K {
            if (!has_next()) {
                trap_with_message("no such element");
            }
            last node = upcoming;
            upcoming = successor_node<K, V>(node);
            return node.key;
        };
    );

    /// @brief An empty map ordered by `comparator`, which must define a total order.
    export let create = func<K, V>(comparator: func(K, K) -> ordering.Ordering) -> TreeMap<K, V> =>
        new TreeMap<K, V>(Seal.Token, comparator);

    /// @brief Walks left links to the least-key node, or returns `nil` for an empty subtree.
    let leftmost_node = func<K, V>(start: Node<K, V>) -> Node<K, V> {
        if (start == nil) {
            return nil;
        }
        let node = start;
        while (node.left != nil) {
            node = node.left;
        }
        return node;
    };

    /// @brief The in-order successor, through `right` and `parent`.
    let successor_node = func<K, V>(node: Node<K, V>) -> Node<K, V> {
        if (node.right != nil) {
            return leftmost_node<K, V>(node.right);
        }
        let child = node;
        let above = node.parent;
        while (above != nil && above.right == child) {
            child = above;
            above = above.parent;
        }
        return above;
    };

    /// @brief Returns the greater of the two integer arguments.
    let larger = func(a: int, b: int) -> int {
        if (a > b) {
            return a;
        }
        return b;
    };
);
