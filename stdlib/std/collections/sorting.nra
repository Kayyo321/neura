let ordering = import:Std.Core.Ordering;
let sort_kernels = import:Std.Internal.Kernels.Sort;

/// @brief Stable sorting and binary search over built-in lists (Stdlib.md section
/// 9.11). A comparator must define a total order. It must not change the
/// list structurally: the list's version is compared after every call and a
/// change traps with "collection modified during iteration".
/// @see [Std.Collections.Sorting](https://github.com/Kayyo321/neura/wiki/Stdlib-Collections-Sorting)
export let Sorting = module (
    /// @brief Runs of this length are sorted by binary insertion before merging.
    const BlockSize: int = 16;

    /// @brief Sorts items[start, end) in place with binary insertion. Each element
    /// goes after the last element of the sorted prefix that is not Greater
    /// than it, which keeps equal elements in their original order.
    let insertion_sort = func<T>(items: T[list], start: int, end: int, c: func(T, T) -> ordering.Ordering,
                                 version: uint64) {
        let i = start + 1;
        while (i < end) {
            let value = items[i];
            let low = start;
            let high = i;
            while (low < high) {
                let middle = low + (high - low) / 2;
                let order = c(items[middle], value);
                if (items.version != version) {
                    trap_with_message("collection modified during iteration");
                }
                if (order == ordering.Ordering.Greater) {
                    high = middle;
                } else {
                    low = middle + 1;
                }
            }
            let k = i;
            while (k > low) {
                items[k] = items[k - 1];
                k -= 1;
            }
            items[low] = value;
            i += 1;
        }
    };

    /// @brief Merges every adjacent pair of runs of `width` elements from
    /// source[source_start, source_start + count) into the same positions of
    /// destination, which starts at destination_start.
    let merge_pass = func<T>(source: T[list], source_start: int, destination: T[list], destination_start: int,
                             count: int, width: int, c: func(T, T) -> ordering.Ordering, items: T[list],
                             version: uint64) {
        let left = 0;
        while (left < count) {
            let middle = left + width;
            if (middle > count) {
                middle = count;
            }
            let right_end = middle + width;
            if (right_end > count) {
                right_end = count;
            }
            let copy_only = middle == right_end;
            if (!copy_only) {
                // A pair that is already in order is copied without merging.
                let order = c(source[source_start + middle - 1], source[source_start + middle]);
                if (items.version != version) {
                    trap_with_message("collection modified during iteration");
                }
                copy_only = order != ordering.Ordering.Greater;
            }
            if (copy_only) {
                let k = left;
                while (k < right_end) {
                    destination[destination_start + k] = source[source_start + k];
                    k += 1;
                }
            } else {
                let i = left;
                let j = middle;
                let k = left;
                while (i < middle && j < right_end) {
                    let right_value = source[source_start + j];
                    let left_value = source[source_start + i];
                    let order = c(right_value, left_value);
                    if (items.version != version) {
                        trap_with_message("collection modified during iteration");
                    }
                    // Take from the right run only when it is strictly less.
                    if (order == ordering.Ordering.Less) {
                        destination[destination_start + k] = right_value;
                        j += 1;
                    } else {
                        destination[destination_start + k] = left_value;
                        i += 1;
                    }
                    k += 1;
                }
                while (i < middle) {
                    destination[destination_start + k] = source[source_start + i];
                    i += 1;
                    k += 1;
                }
                while (j < right_end) {
                    destination[destination_start + k] = source[source_start + j];
                    j += 1;
                    k += 1;
                }
            }
            left = right_end;
        }
    };

    /// @brief Merges the sorted blocks of items[start, end) bottom-up. The buffer
    /// lives only in this helper's frame, so it is unreachable once the
    /// helper returns (section 5.5).
    let merge_blocks = func<T>(items: T[list], start: int, end: int, c: func(T, T) -> ordering.Ordering,
                               version: uint64) {
        let count = end - start;
        // The buffer holds references the list already holds, so it keeps
        // nothing extra alive and needs no "empty" element.
        let buffer: T[list] = [];
        let i = start;
        while (i < end) {
            buffer.append(items[i]);
            i += 1;
        }
        let in_buffer = false;
        let width = BlockSize;
        while (width < count) {
            if (in_buffer) {
                merge_pass<T>(buffer, 0, items, start, count, width, c, items, version);
            } else {
                merge_pass<T>(items, start, buffer, 0, count, width, c, items, version);
            }
            in_buffer = !in_buffer;
            if (width > count / 2) {
                width = count;
            } else {
                width *= 2;
            }
        }
        if (in_buffer) {
            // Element writes do not change the list's structural version.
            let k = 0;
            while (k < count) {
                items[start + k] = buffer[k];
                k += 1;
            }
        }
    };

    /// @brief Sorts items[start, end) stably. Traps with "invalid argument: range"
    /// unless 0 <= start <= end <= items.length.
    export let sort_range = func<T>(items: T[list], start: int, end: int, c: func(T, T) -> ordering.Ordering) {
        if (start < 0 || start > end || end > items.length) {
            trap_with_message("invalid argument: range");
        }
        let version = items.version;
        let block = start;
        while (block < end) {
            let block_end = end;
            if (end - block > BlockSize) {
                block_end = block + BlockSize;
            }
            insertion_sort<T>(items, block, block_end, c, version);
            block = block_end;
        }
        if (end - start > BlockSize) {
            merge_blocks<T>(items, start, end, c, version);
        }
    };

    /// @brief Sorts the whole list stably with at most about n log2 n comparator
    /// calls.
    export let sort = func<T>(items: T[list], c: func(T, T) -> ordering.Ordering) {
        sort_range<T>(items, 0, items.length, c);
    };

    /// @brief Sorts a list of numbers in ascending order, with the result of `sort` and the type's `compare`
    /// (`Float64.total_compare` for float64: -0.0 before 0.0, and every NaN last, in its original order with
    /// its bits unchanged). The built-in kernels neura.sort.i64, u64, and f64 sort the list for about one step
    /// per eight element comparisons; an int32 or uint32 list is widened into a new list for the kernel and
    /// written back by index. Element writes leave the list's version unchanged, as in `sort`.
    #Since("0.2.0")
    export let sort_ascending = func(items: int64[list]) {
        sort_kernels.i64(items);
    } or func(items: uint64[list]) {
        sort_kernels.u64(items);
    } or func(items: float64[list]) {
        sort_kernels.f64(items);
    } or func(items: int32[list]) {
        let wide: int64[list] = [];
        for (let item in items) {
            wide.append(item as int64);
        }
        sort_kernels.i64(wide);
        for (let i = 0; i < wide.length; i++) {
            items[i] = wide[i] as int32;
        }
    } or func(items: uint32[list]) {
        let wide: uint64[list] = [];
        for (let item in items) {
            wide.append(item as uint64);
        }
        sort_kernels.u64(wide);
        for (let i = 0; i < wide.length; i++) {
            items[i] = wide[i] as uint32;
        }
    };

    /// @brief `items` must be sorted by `c`. Returns the lowest index whose element is
    /// not Less than `value` when that element compares Equal, and otherwise
    /// -(insertion point) - 1.
    export let binary_search = func<T>(items: T[list], value: T, c: func(T, T) -> ordering.Ordering) -> int {
        let version = items.version;
        let low = 0;
        let high = items.length;
        while (low < high) {
            let middle = low + (high - low) / 2;
            let order = c(items[middle], value);
            if (items.version != version) {
                trap_with_message("collection modified during iteration");
            }
            if (order == ordering.Ordering.Less) {
                low = middle + 1;
            } else {
                high = middle;
            }
        }
        if (low < items.length) {
            let order = c(items[low], value);
            if (items.version != version) {
                trap_with_message("collection modified during iteration");
            }
            if (order == ordering.Ordering.Equal) {
                return low;
            }
        }
        return -low - 1;
    };
);
