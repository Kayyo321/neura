let cell = import:Std.Core.Cell;
let iterators = import:Std.Collections.Iterator;
let.promote _ = import:Std.Collections.MutableMap;
let optional = import:Std.Core.Optional;

/// @brief Maps for a fixed range of integer keys from zero through the limit minus one.
/// A dense key list and a dense value list hold occupied entries. `position[key]` is the
/// entry index or -1 when absent. Deletion fills the gap with the last dense entry.
/// Individual key lookup, insertion, and removal take constant time. Traversal scans
/// the key range in ascending order. Out-of-range keys cause a bounds trap.
/// @see [Std.Collections.OrdinalMap](https://github.com/Kayyo321/neura/wiki/Stdlib-Collections-OrdinalMap)
export let OrdinalMap = module (
    /// @brief A mutable map for a fixed range of integer keys. A key outside that range causes a bounds trap.
    export let OrdinalMap = class<V> implements MutableMap<int, V> (
        /// @brief Maps each legal key to its dense slot, or -1 when absent.
        let position: int[list];
        /// @brief Occupied keys indexed by dense entry slot.
        let dense_keys: int[list] = [];
        /// @brief The values parallel to the occupied keys.
        let dense_values: V[list] = [];
        /// @brief The structural modification count shared with iterators.
        let modifications: cell.Cell<uint64> = cell.of<uint64>(0);
        /// @brief Whether this instance's text conversion is running.
        let printing: bool = false;

        /// @brief An empty map for the keys 0 through `limit` - 1. Traps with
        /// "invalid argument: negative size".
        export let init = func(limit: int) {
            if (limit < 0) {
                trap_with_message("invalid argument: negative size");
            }
            let slots: int[list] = [];
            let i = 0;
            while (i < limit) {
                slots.append(-1);
                i += 1;
            }
            position = slots;
        };

        /// @brief Advances the version observed by active iterators.
        let changed = func {
            modifications.value = modifications.value + 1;
        };

        /// @brief Traps if a callback changed the map structurally.
        let check = func(expected: uint64) {
            if (modifications.value != expected) {
                trap_with_message("collection modified during iteration");
            }
        };

        /// @brief Appends a new entry for an absent key.
        let insert = func(key: int, value: V) {
            position[key] = dense_keys.length;
            dense_keys.append(key);
            dense_values.append(value);
            changed();
        };

        /// @brief Removes the entry at dense place `slot`, moving the last entry into
        /// it.
        let release = func(slot: int) {
            let last = dense_keys.length - 1;
            position[dense_keys[slot]] = -1;
            if (slot != last) {
                let moved = dense_keys[last];
                dense_keys[slot] = moved;
                dense_values[slot] = dense_values[last];
                position[moved] = slot;
            }
            dense_keys.remove_at(last);
            dense_values.remove_at(last);
            changed();
        };

        /// @brief Returns the number of entries.
        export let size = func -> int => dense_keys.length;

        /// @brief Returns true when there are no entries.
        export let is_empty = func -> bool => dense_keys.length == 0;

        /// @brief Removes all entries while preserving the permitted key range. Invalidates active iterators.
        export let clear = func {
            for (let key in dense_keys) {
                position[key] = -1;
            }
            let no_keys: int[list] = [];
            let no_values: V[list] = [];
            dense_keys = no_keys;
            dense_values = no_values;
            changed();
        };

        /// @brief Reports whether an entry exists for `key`.
        export let contains_key = func(key: int) -> bool => position[key] >= 0;

        /// @brief Returns the associated value as `Some`, or `None` when the key is absent.
        export let get = func(key: int) -> optional.Optional<V> {
            let slot = position[key];
            if (slot < 0) {
                return optional.Optional<V>.None;
            }
            return optional.Optional<V>.Some(dense_values[slot]);
        };

        /// @brief Returns the associated value, or `fallback` when the key is absent.
        export let get_or = func(key: int, fallback: V) -> V {
            let slot = position[key];
            if (slot < 0) {
                return fallback;
            }
            return dense_values[slot];
        };

        /// @brief Returns the associated value. Traps with `no such element` when the key is absent.
        export let require = func(key: int) -> V {
            let slot = position[key];
            if (slot < 0) {
                trap_with_message("no such element");
            }
            return dense_values[slot];
        };

        /// @brief Stores the value for `key`. Replacing an existing value preserves the key and iterator validity.
        export let set = func(key: int, value: V) {
            let slot = position[key];
            if (slot >= 0) {
                dense_values[slot] = value;
                return;
            }
            insert(key, value);
        };

        /// @brief Removes the entry for `key`. Returns true if an entry was present.
        export let delete = func(key: int) -> bool {
            let slot = position[key];
            if (slot < 0) {
                return false;
            }
            release(slot);
            return true;
        };

        /// @brief Stores the value for `key` and returns its previous value as `Some`, or `None` for a new key.
        export let put = func(key: int, value: V) -> optional.Optional<V> {
            let slot = position[key];
            if (slot >= 0) {
                let previous = dense_values[slot];
                dense_values[slot] = value;
                return optional.Optional<V>.Some(previous);
            }
            insert(key, value);
            return optional.Optional<V>.None;
        };

        /// @brief Removes the entry for `key` and returns its value as `Some`, or `None` when absent.
        export let remove = func(key: int) -> optional.Optional<V> {
            let slot = position[key];
            if (slot < 0) {
                return optional.Optional<V>.None;
            }
            let previous = dense_values[slot];
            release(slot);
            return optional.Optional<V>.Some(previous);
        };

        /// @brief Copies the keys to a new built-in list in ascending key order.
        export let keys = func -> int[list] {
            let result: int[list] = [];
            let limit = position.length;
            let key = 0;
            while (key < limit) {
                if (position[key] >= 0) {
                    result.append(key);
                }
                key += 1;
            }
            return result;
        };

        /// @brief Copies the values to a new built-in list in ascending key order.
        export let values = func -> V[list] {
            let result: V[list] = [];
            let limit = position.length;
            let key = 0;
            while (key < limit) {
                let slot = position[key];
                if (slot >= 0) {
                    result.append(dense_values[slot]);
                }
                key += 1;
            }
            return result;
        };

        /// @brief Copies the `[key, value]` tuples to a new built-in list in ascending key order.
        export let entries = func -> [int, V][list] {
            let result: [int, V][list] = [];
            let limit = position.length;
            let key = 0;
            while (key < limit) {
                let slot = position[key];
                if (slot >= 0) {
                    result.append([key, dense_values[slot]]);
                }
                key += 1;
            }
            return result;
        };

        /// @brief Returns a fail-fast iterator over `[key, value]` tuples in ascending key order.
        export let iterator = func -> iterators.Iterator<[int, V]> =>
            new OrdinalMapIterator<V>(position, dense_values, modifications);

        /// @brief Sets every entry from `other` in ascending key order. A source key at or beyond this map's construction limit causes a bounds trap.
        export let put_all = func(other: OrdinalMap<V>) {
            for (let entry in other.entries()) {
                set(entry[0], entry[1]);
            }
        };

        /// @brief Tests whether `value.equals(held_value)` is true for any entry.
        export let contains_value = func(value: V) -> bool {
            for (let element in dense_values) {
                if (value === element) {
                    return true;
                }
            }
            return false;
        };

        /// @brief Calls `action` with the key and value of each entry in ascending key order.
        /// @pre The action leaves the map structure unchanged.
        export let for_each = func(action: func(int, V) -> void) {
            let expected = modifications.value;
            let limit = position.length;
            let key = 0;
            while (key < limit) {
                let slot = position[key];
                if (slot >= 0) {
                    action(key, dense_values[slot]);
                    check(expected);
                }
                key += 1;
            }
        };

        /// @brief Calls `drop` once per entry in ascending key order and removes each match as it goes.
        /// @pre The predicate leaves the map structure unchanged.
        /// @return The number of removed entries.
        export let remove_if = func(drop: func(int, V) -> bool) -> int {
            let expected = modifications.value;
            let removed = 0;
            let limit = position.length;
            let key = 0;
            while (key < limit) {
                let slot = position[key];
                if (slot >= 0) {
                    let matched = drop(key, dense_values[slot]);
                    check(expected);
                    if (matched) {
                        release(slot);
                        removed += 1;
                        expected = modifications.value;
                    }
                }
                key += 1;
            }
            return removed;
        };

        /// @brief Returns the associated value, or calls `make` once, stores its result, and returns it when absent.
        /// @pre The factory leaves the map structure unchanged.
        export let get_or_put = func(key: int, make: func() -> V) -> V {
            let slot = position[key];
            if (slot >= 0) {
                return dense_values[slot];
            }
            let expected = modifications.value;
            let value = make();
            check(expected);
            insert(key, value);
            return value;
        };

        /// @brief Stores and returns `value` when the key is absent. Otherwise stores and returns `combine(old, value)`.
        /// @pre The combiner leaves the map structure unchanged.
        export let merge = func(key: int, value: V, combine: func(V, V) -> V) -> V {
            let slot = position[key];
            if (slot < 0) {
                insert(key, value);
                return value;
            }
            let expected = modifications.value;
            let combined = combine(dense_values[slot], value);
            check(expected);
            dense_values[slot] = combined;
            return combined;
        };

        /// @brief Calls `f` with the key and its optional current value. Stores a `Some` result or removes the entry for `None`.
        /// @pre The callback leaves the map structure unchanged.
        /// @return The result of the callback.
        export let compute = func(key: int, f: func(int, optional.Optional<V>) -> optional.Optional<V>) -> optional.Optional<V> {
            let expected = modifications.value;
            let result = f(key, get(key));
            check(expected);
            match (result) {
                optional.Optional.Some(value) => {
                    set(key, value);
                },
                optional.Optional.None => {
                    delete(key);
                },
            }
            return result;
        };

        /// @brief Reports whether `other` is an OrdinalMap with the same value type and equal associations. The permitted key limits may differ.
        export let.override equals = func(other: class) -> bool {
            if (!(other is OrdinalMap<V>)) {
                return false;
            }
            let that = other as OrdinalMap<V>;
            if (that.size() != dense_keys.length) {
                return false;
            }
            for (let entry in that.entries()) {
                let key = entry[0];
                if (key >= position.length) {
                    return false;
                }
                let slot = position[key];
                if (slot < 0 || !dense_values[slot].equals(entry[1])) {
                    return false;
                }
            }
            return true;
        };

        /// @brief The wrapping sum over entries of the key's hash exclusive-or the
        /// value's hash.
        export let.override hash_code = func -> uint32 {
            let sum: uint64 = 0;
            let count = dense_keys.length;
            let i = 0;
            while (i < count) {
                let entry_hash = dense_keys[i].hash_code() ^ dense_values[i].hash_code();
                sum = (sum + (entry_hash as uint64)) & 4294967295;
                i += 1;
            }
            return sum as uint32;
        };

        /// @brief Formats entries as `{k: v, k2: v2}` in key order. The map prints "(this collection)" where
        /// its own text reaches it again.
        export let.override to_string = func -> string {
            if (printing) {
                return "(this collection)";
            }
            printing = true;
            let text = "{";
            let first = true;
            let limit = position.length;
            let key = 0;
            while (key < limit) {
                let slot = position[key];
                if (slot >= 0) {
                    if (!first) {
                        text = text + ", ";
                    }
                    text = text + key.to_string() + ": " + dense_values[slot].to_string();
                    first = false;
                }
                key += 1;
            }
            printing = false;
            return text + "}";
        };
    );

    /// @brief A fail-fast traversal over occupied entries in ascending key order.
    let OrdinalMapIterator = class<V> implements iterators.Iterator<[int, V]> (
        /// @brief Maps each key to a value index, or -1 if absent.
        let position: int[list];
        /// @brief The value storage indexed by `position`.
        let dense_values: V[list];
        /// @brief The live modification counter shared with the source collection.
        let modifications: cell.Cell<uint64>;
        /// @brief The source version recorded when the iterator was created.
        let expected: uint64;
        /// @brief The next occupied key, or the key limit at exhaustion.
        let key: int = 0;

        /// @brief Captures the live storage and version, then finds the first occupied key.
        export let init = func(slots: int[list], values: V[list], counter: cell.Cell<uint64>) {
            position = slots;
            dense_values = values;
            modifications = counter;
            expected = counter.value;
            skip_absent();
        };

        /// @brief Advances to the next occupied key or the key limit.
        let skip_absent = func {
            while (key < position.length && position[key] < 0) {
                key += 1;
            }
        };

        /// @brief Reports whether another element remains. Traps with `collection modified during iteration` after a structural change.
        export let has_next = func -> bool {
            if (modifications.value != expected) {
                trap_with_message("collection modified during iteration");
            }
            return key < position.length;
        };

        /// @brief Returns the next entry in ascending key order and advances. Traps with `collection modified during iteration` after a structural change. Traps with `no such element` at exhaustion.
        export let next = func -> [int, V] {
            if (modifications.value != expected) {
                trap_with_message("collection modified during iteration");
            }
            if (key >= position.length) {
                trap_with_message("no such element");
            }
            let entry: [int, V] = [key, dense_values[position[key]]];
            key += 1;
            skip_absent();
            return entry;
        };
    );

    /// @brief An empty map for the keys 0 through `size` - 1. Traps with "invalid
    /// argument: negative size".
    export let create = func<V>(size: int) -> OrdinalMap<V> => new OrdinalMap<V>(size);
);
