let cell = import:Std.Core.Cell;
let.promote _ = import:Std.Collections.Deque;
let hashing = import:Std.Core.Hash;
let iterators = import:Std.Collections.Iterator;
let.promote _ = import:Std.Collections.MutableList;
let optional = import:Std.Core.Optional;
let ordering = import:Std.Core.Ordering;
let sequences = import:Std.Collections.Sequence;
let sorting = import:Std.Collections.Sorting;

/// @brief A doubly linked list of separately allocated nodes (Stdlib.md section
/// 9.5) following both the list and the deque contracts. Missing neighbors
/// are nil. A removed node's links are cleared, so an iterator holding it
/// does not keep the rest of the chain reachable.
/// @see [Std.Collections.LinkedList](https://github.com/Kayyo321/neura/wiki/Stdlib-Collections-LinkedList)
export let LinkedList = module (
    /// @brief An element and its links to its immediate neighbors.
    let Node = class<T> (
        /// @brief The element stored in the node.
        export let value: T;
        /// @brief The next node, or `nil` at the end.
        export let next: Node<T> = nil;
        /// @brief The previous node, or `nil` at the front.
        export let previous: Node<T> = nil;

        /// @brief Creates a detached node holding `item`.
        export let init = func(item: T) {
            value = item;
        };
    );

    /// @brief A doubly linked list that also supports queue and deque operations.
    export let LinkedList = class<T> implements MutableList<T>, Deque<T> (
        /// @brief The first node, or `nil` when the list is empty.
        let head: Node<T> = nil;
        /// @brief The last node, or `nil` when the list is empty.
        let tail: Node<T> = nil;
        /// @brief The number of linked nodes.
        let count: int = 0;
        /// @brief The structural modification count shared with iterators.
        let modifications: cell.Cell<uint64> = cell.of<uint64>(0);
        /// @brief Whether this instance's text conversion is running.
        let printing: bool = false;

        /// @brief Advances the version observed by active iterators.
        let changed = func {
            modifications.value = modifications.value + 1;
        };

        /// @brief The node at `index`, walking from the nearer end. Traps with
        /// "invalid argument: index out of range".
        let node_at = func(index: int) -> Node<T> {
            if (index < 0 || index >= count) {
                trap_with_message("invalid argument: index out of range");
            }
            if (index < count / 2) {
                let node = head;
                let i = 0;
                while (i < index) {
                    node = node.next;
                    i += 1;
                }
                return node;
            }
            let node = tail;
            let i = count - 1;
            while (i > index) {
                node = node.previous;
                i -= 1;
            }
            return node;
        };

        /// @brief Links a new node before `successor`, or at the end for nil.
        let link_before = func(successor: Node<T>, value: T) {
            let node = new Node<T>(value);
            if (successor == nil) {
                node.previous = tail;
                if (tail == nil) {
                    head = node;
                } else {
                    tail.next = node;
                }
                tail = node;
            } else {
                let predecessor = successor.previous;
                node.previous = predecessor;
                node.next = successor;
                successor.previous = node;
                if (predecessor == nil) {
                    head = node;
                } else {
                    predecessor.next = node;
                }
            }
            count += 1;
            changed();
        };

        /// @brief Reconnects the neighbors, clears the node's links, and returns its
        /// value.
        let unlink = func(node: Node<T>) -> T {
            let predecessor = node.previous;
            let successor = node.next;
            if (predecessor == nil) {
                head = successor;
            } else {
                predecessor.next = successor;
            }
            if (successor == nil) {
                tail = predecessor;
            } else {
                successor.previous = predecessor;
            }
            node.previous = nil;
            node.next = nil;
            count -= 1;
            changed();
            return node.value;
        };

        /// @brief Returns the number of elements.
        export let size = func -> int => count;

        /// @brief Returns true when there are no elements.
        export let is_empty = func -> bool => count == 0;

        /// @brief Traps with "invalid argument: index out of range" for an index
        /// outside 0 through size() - 1.
        export let get = func(index: int) -> T => node_at(index).value;

        /// @brief Replaces the element at `index` without invalidating iterators.
        /// An invalid index traps with `invalid argument: index out of range`.
        export let set = func(index: int, value: T) {
            node_at(index).value = value;
        };

        /// @brief Returns the first element. Traps with `no such element` when empty.
        export let first = func -> T {
            if (head == nil) {
                trap_with_message("no such element");
            }
            return head.value;
        };

        /// @brief Returns the last element. Traps with `no such element` when empty.
        export let last = func -> T {
            if (tail == nil) {
                trap_with_message("no such element");
            }
            return tail.value;
        };

        /// @brief Returns the first element as `Some`, or `None` when empty.
        export let first_or_none = func -> optional.Optional<T> {
            if (head == nil) {
                return optional.Optional<T>.None;
            }
            return optional.Optional<T>.Some(head.value);
        };

        /// @brief Returns the last element as `Some`, or `None` when empty.
        export let last_or_none = func -> optional.Optional<T> {
            if (tail == nil) {
                return optional.Optional<T>.None;
            }
            return optional.Optional<T>.Some(tail.value);
        };

        /// @brief The first element, or None when empty.
        export let peek = func -> optional.Optional<T> => first_or_none();

        /// @brief Appends `value` and returns true.
        export let add = func(value: T) -> bool {
            link_before(nil, value);
            return true;
        };

        /// @brief Appends `value` at the back.
        export let add_last = func(value: T) {
            link_before(nil, value);
        };

        /// @brief Appends `value` at the back.
        export let enqueue = func(value: T) {
            link_before(nil, value);
        };

        /// @brief Inserts `value` at the front.
        export let add_first = func(value: T) {
            link_before(head, value);
        };

        /// @brief Inserts before `index` or appends if the index equals the size. Traps
        /// with "invalid argument: index out of range" otherwise.
        export let add_at = func(index: int, value: T) {
            if (index == count) {
                link_before(nil, value);
                return;
            }
            link_before(node_at(index), value);
        };

        /// @brief Appends each element in order, reading by position up to the
        /// starting length.
        export let add_all = func(values: T[list]) {
            let total = values.length;
            let i = 0;
            while (i < total) {
                link_before(nil, values[i]);
                i += 1;
            }
        };

        /// @brief Unlinks and returns the element at `index`. Traps with `invalid argument: index out of range` for an invalid index.
        export let remove_at = func(index: int) -> T => unlink(node_at(index));

        /// @brief Removes and returns the first element. Traps with `no such element` when empty.
        export let remove_first = func -> T {
            if (head == nil) {
                trap_with_message("no such element");
            }
            return unlink(head);
        };

        /// @brief Removes and returns the last element. Traps with `no such element` when empty.
        export let remove_last = func -> T {
            if (tail == nil) {
                trap_with_message("no such element");
            }
            return unlink(tail);
        };

        /// @brief Removes and returns the first element. Traps with `no such element` when empty.
        export let dequeue = func -> T => remove_first();

        /// @brief Removes the first element and returns it as `Some`, or returns `None` when empty.
        export let try_dequeue = func -> optional.Optional<T> {
            if (head == nil) {
                return optional.Optional<T>.None;
            }
            return optional.Optional<T>.Some(unlink(head));
        };

        /// @brief Exchanges the values in two nodes without invalidating iterators.
        /// An invalid index traps with `invalid argument: index out of range`.
        export let swap = func(i: int, j: int) {
            let a = node_at(i);
            let b = node_at(j);
            let value = a.value;
            a.value = b.value;
            b.value = value;
        };

        /// @brief Reverses the element order in place without invalidating iterators.
        export let reverse = func {
            let left = head;
            let right = tail;
            let steps = count / 2;
            while (steps > 0) {
                let value = left.value;
                left.value = right.value;
                right.value = value;
                left = left.next;
                right = right.previous;
                steps -= 1;
            }
        };

        /// @brief Replaces each element with `value` without invalidating iterators.
        export let fill = func(value: T) {
            let node = head;
            while (node != nil) {
                node.value = value;
                node = node.next;
            }
        };

        /// @brief Removes elements from the end until `size` remain. Traps with
        /// "invalid argument: negative size" or "invalid argument: size above
        /// current size".
        export let truncate = func(size: int) {
            if (size < 0) {
                trap_with_message("invalid argument: negative size");
            }
            if (size > count) {
                trap_with_message("invalid argument: size above current size");
            }
            while (count > size) {
                unlink(tail);
            }
        };

        /// @brief Clears every node's links, so iterators that still hold a node
        /// keep nothing else reachable.
        export let clear = func {
            let node = head;
            while (node != nil) {
                let successor = node.next;
                node.previous = nil;
                node.next = nil;
                node = successor;
            }
            head = nil;
            tail = nil;
            count = 0;
            changed();
        };

        /// @brief A new LinkedList with the elements from `start` inclusive to `end`
        /// exclusive. Traps with "invalid argument: range" unless
        /// 0 <= start <= end <= size().
        export let slice = func(start: int, end: int) -> LinkedList<T> {
            if (start < 0 || start > end || end > count) {
                trap_with_message("invalid argument: range");
            }
            let result = new LinkedList<T>();
            if (start == end) {
                return result;
            }
            let node = node_at(start);
            let i = start;
            while (i < end) {
                result.add_last(node.value);
                node = node.next;
                i += 1;
            }
            return result;
        };

        /// @brief A new built-in list in order.
        export let to_list = func -> T[list] {
            let result: T[list] = [];
            let node = head;
            while (node != nil) {
                result.append(node.value);
                node = node.next;
            }
            return result;
        };

        /// @brief Returns a fail-fast iterator from the first node to the last.
        export let iterator = func -> iterators.Iterator<T> => new LinkedListIterator<T>(head, modifications);

        /// @brief A lazy pipeline over this list's fail-fast iterator (Stdlib.md
        /// section 9.12): a structural change while it runs traps.
        export let sequence = func -> sequences.Sequence<T> => sequences.from_iterator<T>(iterator());

        /// @brief Calls `action` in list order.
        /// @pre The action leaves the list structure unchanged.
        export let for_each = func(action: func(T) -> void) {
            let expected = modifications.value;
            let node = head;
            while (node != nil) {
                action(node.value);
                if (modifications.value != expected) {
                    trap_with_message("collection modified during iteration");
                }
                node = node.next;
            }
        };

        /// @brief Calls `drop` once per element in list order and unlinks the matches.
        /// @pre The predicate leaves the list structure unchanged.
        /// @return The number of removed elements.
        export let remove_if = func(drop: func(T) -> bool) -> int => remove_matching(drop, true);

        /// @brief Removes elements rejected by `keep` and returns the removal count.
        /// Calls the predicate once per element in list order.
        /// @pre The predicate leaves the list structure unchanged.
        export let retain_if = func(keep: func(T) -> bool) -> int => remove_matching(keep, false);

        /// @brief Walks the nodes in order and unlinks each node selected by the predicate.
        /// Checks the version after each predicate call and accepts version changes caused by its own removals.
        let remove_matching = func(test: func(T) -> bool, remove_when: bool) -> int {
            let expected = modifications.value;
            let removed = 0;
            let node = head;
            while (node != nil) {
                let successor = node.next;
                let matched = test(node.value);
                if (modifications.value != expected) {
                    trap_with_message("collection modified during iteration");
                }
                if (matched == remove_when) {
                    unlink(node);
                    removed += 1;
                    expected = modifications.value;
                }
                node = successor;
            }
            return removed;
        };

        /// @brief Returns the first index accepted by `test`, or -1 if no element matches.
        /// @pre The predicate leaves the list structure unchanged.
        export let index_where = func(test: func(T) -> bool) -> int {
            let expected = modifications.value;
            let node = head;
            let i = 0;
            while (node != nil) {
                let matched = test(node.value);
                if (modifications.value != expected) {
                    trap_with_message("collection modified during iteration");
                }
                if (matched) {
                    return i;
                }
                node = node.next;
                i += 1;
            }
            return -1;
        };

        /// @brief Stably sorts a copy of the values and writes them back into the existing nodes.
        /// @pre The comparator defines a total order and leaves the list structure unchanged.
        export let sort = func(c: func(T, T) -> ordering.Ordering) {
            let values = to_list();
            let expected = modifications.value;
            sorting.sort<T>(values, func(a: T, b: T) -> ordering.Ordering {
                let order = c(a, b);
                if (modifications.value != expected) {
                    trap_with_message("collection modified during iteration");
                }
                return order;
            });
            let node = head;
            let i = 0;
            while (node != nil) {
                node.value = values[i];
                node = node.next;
                i += 1;
            }
        };

        /// @brief Searches a copy and returns the first comparator-equal index, or `-insertion_point - 1` when absent.
        /// @pre The list is already sorted by `c`, which leaves the list structure unchanged.
        export let binary_search = func(value: T, c: func(T, T) -> ordering.Ordering) -> int {
            let expected = modifications.value;
            return sorting.binary_search<T>(to_list(), value, func(a: T, b: T) -> ordering.Ordering {
                let order = c(a, b);
                if (modifications.value != expected) {
                    trap_with_message("collection modified during iteration");
                }
                return order;
            });
        };

        /// @brief Tests membership with `value.equals(element)`.
        export let contains = func(value: T) -> bool => index_of(value) >= 0;

        /// @brief Returns the lowest index where `value.equals(element)` is true, or -1 when absent.
        export let index_of = func(value: T) -> int {
            let node = head;
            let i = 0;
            while (node != nil) {
                if (value === node.value) {
                    return i;
                }
                node = node.next;
                i += 1;
            }
            return -1;
        };

        /// @brief Returns the highest index where `value.equals(element)` is true, or -1 when absent.
        export let last_index_of = func(value: T) -> int {
            let node = tail;
            let i = count - 1;
            while (node != nil) {
                if (value === node.value) {
                    return i;
                }
                node = node.previous;
                i -= 1;
            }
            return -1;
        };

        /// @brief Removes the first element equal to `value`.
        export let remove = func(value: T) -> bool {
            let node = head;
            while (node != nil) {
                if (value === node.value) {
                    unlink(node);
                    return true;
                }
                node = node.next;
            }
            return false;
        };

        /// @brief Traps with "invalid state: ..." on a broken endpoint, reciprocal
        /// link, or count.
        export let validate = func {
            if ((head == nil) != (tail == nil)) {
                trap_with_message("invalid state: linked list endpoints");
            }
            if (head != nil && (head.previous != nil || tail.next != nil)) {
                trap_with_message("invalid state: linked list endpoints");
            }
            let walked = 0;
            let previous: Node<T> = nil;
            let node = head;
            while (node != nil) {
                if (node.previous != previous) {
                    trap_with_message("invalid state: linked list reciprocal links");
                }
                walked += 1;
                if (walked > count) {
                    trap_with_message("invalid state: linked list count");
                }
                previous = node;
                node = node.next;
            }
            if (previous != tail || walked != count) {
                trap_with_message("invalid state: linked list count");
            }
        };

        /// @brief Another LinkedList with the same element type, size, and equal
        /// elements at each index.
        export let.override equals = func(other: class) -> bool {
            if (!(other is LinkedList<T>)) {
                return false;
            }
            let that = other as LinkedList<T>;
            if (that.size() != count) {
                return false;
            }
            let theirs = that.iterator();
            let node = head;
            while (node != nil) {
                if (!node.value.equals(theirs.next())) {
                    return false;
                }
                node = node.next;
            }
            return true;
        };

        /// @brief Folds the element hashes in list order from 1, multiplying by 31 before each addition with 32-bit wraparound.
        export let.override hash_code = func -> uint32 {
            let result: uint32 = 1;
            let node = head;
            while (node != nil) {
                result = hashing.combine(result, node.value.hash_code());
                node = node.next;
            }
            return result;
        };

        /// @brief Formats the list as `[a, b, c]`. The list prints "(this collection)" where its own text
        /// reaches it again.
        export let.override to_string = func -> string {
            if (printing) {
                return "(this collection)";
            }
            printing = true;
            let text = to_list().to_string();
            printing = false;
            return text;
        };
    );

    /// @brief Holds the next node to return and compares the list's modification
    /// count before every step.
    let LinkedListIterator = class<T> implements iterators.Iterator<T> (
        /// @brief The next node to visit, or `nil` at exhaustion.
        let current: Node<T>;
        /// @brief The live modification counter shared with the source collection.
        let modifications: cell.Cell<uint64>;
        /// @brief The source version recorded when the iterator was created.
        let expected: uint64;

        /// @brief Captures the starting node and current modification count.
        export let init = func(start: Node<T>, counter: cell.Cell<uint64>) {
            current = start;
            modifications = counter;
            expected = counter.value;
        };

        /// @brief Reports whether another element remains. Traps with `collection modified during iteration` after a structural change.
        export let has_next = func -> bool {
            if (modifications.value != expected) {
                trap_with_message("collection modified during iteration");
            }
            return current != nil;
        };

        /// @brief Returns the next element and advances. Traps with `collection modified during iteration` after a structural change. Traps with `no such element` at exhaustion.
        export let next = func -> T {
            if (modifications.value != expected) {
                trap_with_message("collection modified during iteration");
            }
            if (current == nil) {
                trap_with_message("no such element");
            }
            let value = current.value;
            current = current.next;
            return value;
        };
    );

    /// @brief Creates an empty linked list.
    export let create = func<T> -> LinkedList<T> => new LinkedList<T>();

    /// @brief Copies `items`.
    export let of = func<T>(items: T[list]) -> LinkedList<T> {
        let result = new LinkedList<T>();
        result.add_all(items);
        return result;
    };
);
