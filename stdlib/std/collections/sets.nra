let.promote _ = import:Std.Collections.Set;

/// @brief Comparisons of sets of different classes through the read-only interface
/// (Stdlib.md section 9.10).
/// @see [Std.Collections.Sets](https://github.com/Kayyo321/neura/wiki/Stdlib-Collections-Sets)
export let Sets = module (
    /// @brief Whether the sets have the same size and `a` contains each element of
    /// `b`, by `a`'s own membership test.
    export let same_elements = func<T>(a: Set<T>, b: Set<T>) -> bool {
        if (a.size() != b.size()) {
            return false;
        }
        let items = b.iterator();
        while (items.has_next()) {
            if (!a.contains(items.next())) {
                return false;
            }
        }
        return true;
    };
);
