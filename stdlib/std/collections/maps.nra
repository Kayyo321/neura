let map = import:Std.Collections.Map;
let optional = import:Std.Core.Optional;

// Comparisons of maps of different classes through the read-only interface
// (Stdlib.md section 9.10).
export let Maps = module (
    // Whether the maps have the same size and, for each entry of `b`, `a`
    // holds a value for the key (by `a`'s own key lookup) that equals the
    // entry's value, with `a`'s value as the receiver.
    export let same_entries = func<K, V>(map.Map<K, V> a, map.Map<K, V> b) -> bool {
        if (a.size() != b.size()) {
            return false;
        }
        let items = b.iterator();
        while (items.has_next()) {
            let [key, value] = items.next();
            match (a.get(key)) {
                optional.Optional.Some(held) => {
                    if (!held.equals(value)) {
                        return false;
                    }
                },
                optional.Optional.None => {
                    return false;
                },
            }
        }
        return true;
    };
);
