let.promote _ = import:Std.Collections.Map;
let optional = import:Std.Core.Optional;

/// @brief Comparisons of maps of different classes through the read-only interface
/// (Stdlib.md section 9.10).
/// @see [Std.Collections.Maps](https://github.com/Kayyo321/neura/wiki/Stdlib-Collections-Maps)
#Since("0.1.0")
export let Maps = module (
    /// @brief Whether the maps have the same size and, for each entry of `b`, `a`
    /// holds a value for the key (by `a`'s own key lookup) that equals the
    /// entry's value, with `a`'s value as the receiver.
    export let same_entries = func<K, V>(a: Map<K, V>, b: Map<K, V>) -> bool {
        if (a.size() != b.size()) {
            return false;
        }
        last items = b.iterator();
        while (items.has_next()) {
            let [key, value] = items.next();
            match (a.get(key)) {
                optional.Optional.Some(held) => {
                    if (!(held === value)) {
                        return false;
                    }
                },
                optional.Optional.None => {
                    return false;
                },
            }
        }
        return true;
    };
);
