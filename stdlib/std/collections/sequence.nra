let array_list = import:Std.Collections.ArrayList;
let cell = import:Std.Core.Cell;
let hash_map = import:Std.Collections.HashMap;
let hash_set = import:Std.Collections.HashSet;
let.promote _ = import:Std.Collections.Iterable;
let.promote _ = import:Std.Collections.Iterator;
let optional = import:Std.Core.Optional;
let ordering = import:Std.Core.Ordering;
let sorting = import:Std.Collections.Sorting;

/// @brief Lazy, single-use pipelines composed from an availability check and an element pull.
/// Traversal is sequential and pull-based. An intermediate operation claims its input immediately
/// but defers evaluation until elements are requested. A second traversal operation on the same
/// sequence traps with `invalid state: sequence already used`. Equality and hashing use identity.
/// @see [Std.Collections.Sequence](https://github.com/Kayyo321/neura/wiki/Stdlib-Collections-Sequence)
export let Sequence = module (
    /// @brief A lazy traversal that can be handed to a downstream operation only once.
    export let Sequence = class<T> implements Iterable<T> (
        /// @brief The availability check for the next output, which may fill a buffer from the upstream source.
        let has_next: func() -> bool;
        /// @brief The callback that pulls and consumes the next output.
        let next: func() -> T;
        /// @brief Whether the pipeline has already been handed to an operation or iterator.
        let consumed: bool = false;

        /// @brief Constructs a lazy sequence from an availability check and an element pull.
        /// @param more Reports whether an element remains without consuming the next output.
        /// @param pull Returns the next element and advances. It follows the iterator exhaustion contract.
        export let init = func(more: func() -> bool, pull: func() -> T) {
            has_next = more;
            next = pull;
        };

        /// @brief Uses the sequence up and returns an iterator over its elements, so
        /// that for-each can visit a sequence once.
        export let iterator = func -> Iterator<T> {
            begin();
            return new SequenceIterator<T>(has_next, next);
        };

        /// @brief Returns a lazy sequence applying `f` once to each element as it is pulled.
        export let map = func<U>(f: func(T) -> U) -> Sequence<U> {
            begin();
            let pull = next;
            return new Sequence<U>(has_next, func() -> U {
                return f(pull());
            });
        };

        /// @brief The elements that pass `keep`.
        export let filter = func(keep: func(T) -> bool) -> Sequence<T> {
            begin();
            let more = has_next;
            let pull = next;
            let buffer: T[list] = [];
            return buffered<T>(buffer, func() -> bool {
                while (more()) {
                    let value = pull();
                    if (keep(value)) {
                        buffer.append(value);
                        return true;
                    }
                }
                return false;
            });
        };

        /// @brief The elements of each list `f` returns, in order.
        export let flat_map = func<U>(f: func(T) -> U[list]) -> Sequence<U> {
            begin();
            let more = has_next;
            let pull = next;
            let buffer: U[list] = [];
            return buffered<U>(buffer, func() -> bool {
                while (more()) {
                    let items = f(pull());
                    let count = items.length;
                    if (count > 0) {
                        let i = 0;
                        while (i < count) {
                            buffer.append(items[i]);
                            i += 1;
                        }
                        return true;
                    }
                }
                return false;
            });
        };

        /// @brief Returns a sequence of at most the first `n` elements and stops pulling after the last.
        /// Traps with "invalid argument: negative count" for a negative `n`.
        export let take = func(n: int) -> Sequence<T> {
            begin();
            if (n < 0) {
                trap_with_message("invalid argument: negative count");
            }
            let more = has_next;
            let pull = next;
            let remaining = cell.of<int>(n);
            return new Sequence<T>(func() -> bool {
                return remaining.value > 0 && more();
            }, func() -> T {
                if (remaining.value <= 0) {
                    trap_with_message("no such element");
                }
                remaining.value = remaining.value - 1;
                return pull();
            });
        };

        /// @brief All but the first `n` elements. Traps with "invalid argument:
        /// negative count" for a negative `n`.
        export let skip = func(n: int) -> Sequence<T> {
            begin();
            if (n < 0) {
                trap_with_message("invalid argument: negative count");
            }
            let more = has_next;
            let pull = next;
            let skipped = cell.of<bool>(false);
            let ready = func -> bool {
                if (!skipped.value) {
                    skipped.value = true;
                    let i = 0;
                    while (i < n && more()) {
                        pull();
                        i += 1;
                    }
                }
                return more();
            };
            return new Sequence<T>(ready, func() -> T {
                if (!ready()) {
                    trap_with_message("no such element");
                }
                return pull();
            });
        };

        /// @brief Returns a sequence of leading elements accepted by `test` up to the first rejection.
        export let take_while = func(test: func(T) -> bool) -> Sequence<T> {
            begin();
            let more = has_next;
            let pull = next;
            let done = cell.of<bool>(false);
            let buffer: T[list] = [];
            return buffered<T>(buffer, func() -> bool {
                if (done.value) {
                    return false;
                }
                if (more()) {
                    let value = pull();
                    if (test(value)) {
                        buffer.append(value);
                        return true;
                    }
                }
                done.value = true;
                return false;
            });
        };

        /// @brief The elements from the first that fails `test` on.
        export let skip_while = func(test: func(T) -> bool) -> Sequence<T> {
            begin();
            let more = has_next;
            let pull = next;
            let started = cell.of<bool>(false);
            let buffer: T[list] = [];
            return buffered<T>(buffer, func() -> bool {
                if (!started.value) {
                    started.value = true;
                    while (more()) {
                        let value = pull();
                        if (!test(value)) {
                            buffer.append(value);
                            return true;
                        }
                    }
                    return false;
                }
                if (more()) {
                    buffer.append(pull());
                    return true;
                }
                return false;
            });
        };

        /// @brief Each element with its position from 0.
        export let enumerate = func -> Sequence<[int, T]> {
            begin();
            let pull = next;
            let position = cell.of<int>(0);
            return new Sequence<[int, T]>(has_next, func() -> [int, T] {
                let value = pull();
                let item: [int, T] = [position.value, value];
                position.value = position.value + 1;
                return item;
            });
        };

        /// @brief Returns pairs of corresponding elements until either sequence ends.
        /// Uses `other` up as well.
        export let zip = func<U>(other: Sequence<U>) -> Sequence<[T, U]> {
            begin();
            let more = has_next;
            let pull = next;
            let other_more = other.take_has_next();
            let other_pull = other.take_next();
            return new Sequence<[T, U]>(func() -> bool {
                return more() && other_more();
            }, func() -> [T, U] {
                let first = pull();
                let item: [T, U] = [first, other_pull()];
                return item;
            });
        };

        /// @brief This sequence's elements, then those of `other`. Uses `other` up
        /// as well.
        export let chain = func(other: Sequence<T>) -> Sequence<T> {
            begin();
            let more = has_next;
            let pull = next;
            let other_more = other.take_has_next();
            let other_pull = other.take_next();
            return new Sequence<T>(func() -> bool {
                return more() || other_more();
            }, func() -> T {
                if (more()) {
                    return pull();
                }
                return other_pull();
            });
        };

        /// @brief Calls `action` with each element as it passes.
        export let peek = func(action: func(T) -> void) -> Sequence<T> {
            begin();
            let pull = next;
            return new Sequence<T>(has_next, func() -> T {
                let value = pull();
                action(value);
                return value;
            });
        };

        /// @brief Returns successive new lists of `n` elements, with a shorter final list when needed.
        /// Traps with "invalid argument: chunk size" when `n` is below 1.
        export let chunked = func(n: int) -> Sequence<T[list]> {
            begin();
            if (n < 1) {
                trap_with_message("invalid argument: chunk size");
            }
            let more = has_next;
            let pull = next;
            let buffer: T[list][list] = [];
            return buffered<T[list]>(buffer, func() -> bool {
                if (!more()) {
                    return false;
                }
                let chunk: T[list] = [];
                while (chunk.length < n && more()) {
                    chunk.append(pull());
                }
                buffer.append(chunk);
                return true;
            });
        };

        /// @brief Every run of `n` consecutive elements, each a new list, advancing
        /// by one. There are no windows when there are fewer than `n` elements. Traps with "invalid
        /// argument: window size" when `n` is below 1.
        export let windowed = func(n: int) -> Sequence<T[list]> {
            begin();
            if (n < 1) {
                trap_with_message("invalid argument: window size");
            }
            let more = has_next;
            let pull = next;
            let window: T[list] = [];
            let buffer: T[list][list] = [];
            return buffered<T[list]>(buffer, func() -> bool {
                if (window.length == n) {
                    if (!more()) {
                        return false;
                    }
                    window.remove_at(0);
                    window.append(pull());
                } else {
                    while (window.length < n) {
                        if (!more()) {
                            return false;
                        }
                        window.append(pull());
                    }
                }
                let copy: T[list] = [];
                let i = 0;
                while (i < n) {
                    copy.append(window[i]);
                    i += 1;
                }
                buffer.append(copy);
                return true;
            });
        };

        /// @brief Returns a sequence that buffers and stably sorts the entire input on first demand.
        /// @pre The comparator defines a total order.
        export let sorted = func(c: func(T, T) -> ordering.Ordering) -> Sequence<T> {
            begin();
            let more = has_next;
            let pull = next;
            let loaded = cell.of<bool>(false);
            let buffer: T[list] = [];
            return buffered<T>(buffer, func() -> bool {
                if (loaded.value) {
                    return false;
                }
                loaded.value = true;
                while (more()) {
                    buffer.append(pull());
                }
                sorting.sort<T>(buffer, c);
                return buffer.length > 0;
            });
        };

        /// @brief Returns a sequence that buffers the entire input on first demand, then emits it in reverse order.
        export let reversed = func -> Sequence<T> {
            begin();
            let more = has_next;
            let pull = next;
            let loaded = cell.of<bool>(false);
            let buffer: T[list] = [];
            return buffered<T>(buffer, func() -> bool {
                if (loaded.value) {
                    return false;
                }
                loaded.value = true;
                while (more()) {
                    buffer.append(pull());
                }
                let i = 0;
                let j = buffer.length - 1;
                while (i < j) {
                    let value = buffer[i];
                    buffer[i] = buffer[j];
                    buffer[j] = value;
                    i += 1;
                    j -= 1;
                }
                return buffer.length > 0;
            });
        };

        /// @brief Returns a sequence keeping only the first occurrence under the elements' equality and hash.
        export let distinct = func -> Sequence<T> {
            begin();
            let more = has_next;
            let pull = next;
            let seen = hash_set.create<T>();
            let buffer: T[list] = [];
            return buffered<T>(buffer, func() -> bool {
                while (more()) {
                    let value = pull();
                    if (seen.add(value)) {
                        buffer.append(value);
                        return true;
                    }
                }
                return false;
            });
        };

        /// @brief Consumes the sequence into a new built-in list in traversal order.
        export let to_list = func -> T[list] {
            begin();
            let result: T[list] = [];
            while (has_next()) {
                result.append(next());
            }
            return result;
        };

        /// @brief Consumes the sequence into a new ArrayList in traversal order.
        export let to_array_list = func -> array_list.ArrayList<T> => array_list.wrap<T>(to_list());

        /// @brief Consumes the sequence into two ArrayLists in input order. The first holds matches and the second holds nonmatches.
        export let partition = func(test: func(T) -> bool) -> [array_list.ArrayList<T>, array_list.ArrayList<T>] {
            begin();
            let passed: T[list] = [];
            let failed: T[list] = [];
            while (has_next()) {
                let value = next();
                if (test(value)) {
                    passed.append(value);
                } else {
                    failed.append(value);
                }
            }
            let result: [array_list.ArrayList<T>, array_list.ArrayList<T>] = [array_list.wrap<T>(passed), array_list.wrap<T>(failed)];
            return result;
        };

        /// @brief Consumes the sequence by applying `f` to the accumulator and each successive element. Returns `initial` when empty.
        export let fold = func<A>(initial: A, f: func(A, T) -> A) -> A {
            begin();
            let accumulator = initial;
            while (has_next()) {
                accumulator = f(accumulator, next());
            }
            return accumulator;
        };

        /// @brief Consumes the sequence and returns the number of elements. Count overflow traps with reason 1.
        export let count = func -> int {
            begin();
            let total = 0;
            while (has_next()) {
                next();
                total += 1;
            }
            return total;
        };

        /// @brief Consumes the sequence and calls `action` on each element in order.
        export let for_each = func(action: func(T) -> void) {
            begin();
            while (has_next()) {
                action(next());
            }
        };

        /// @brief Returns true at the first element accepted by `test`, or false at exhaustion.
        export let any = func(test: func(T) -> bool) -> bool {
            begin();
            while (has_next()) {
                if (test(next())) {
                    return true;
                }
            }
            return false;
        };

        /// @brief Returns false at the first element rejected by `test`, or true at exhaustion.
        export let all = func(test: func(T) -> bool) -> bool {
            begin();
            while (has_next()) {
                if (!test(next())) {
                    return false;
                }
            }
            return true;
        };

        /// @brief Returns false at the first element accepted by `test`, or true at exhaustion.
        export let none = func(test: func(T) -> bool) -> bool {
            begin();
            while (has_next()) {
                if (test(next())) {
                    return false;
                }
            }
            return true;
        };

        /// @brief Combines elements from left to right, starting with the first. Returns `None` when empty.
        export let reduce = func(f: func(T, T) -> T) -> optional.Optional<T> {
            begin();
            if (!has_next()) {
                return optional.Optional<T>.None;
            }
            let accumulator = next();
            while (has_next()) {
                accumulator = f(accumulator, next());
            }
            return optional.Optional<T>.Some(accumulator);
        };

        /// @brief Returns the first element as `Some`, or `None` when empty. Pulls at most one element.
        export let first = func -> optional.Optional<T> {
            begin();
            if (!has_next()) {
                return optional.Optional<T>.None;
            }
            return optional.Optional<T>.Some(next());
        };

        /// @brief Consumes all elements and returns the last as `Some`, or `None` when empty.
        export let last = func -> optional.Optional<T> {
            begin();
            if (!has_next()) {
                return optional.Optional<T>.None;
            }
            let value = next();
            while (has_next()) {
                value = next();
            }
            return optional.Optional<T>.Some(value);
        };

        /// @brief Returns the first element accepted by `test` as `Some`, or `None` at exhaustion.
        export let find = func(test: func(T) -> bool) -> optional.Optional<T> {
            begin();
            while (has_next()) {
                let value = next();
                if (test(value)) {
                    return optional.Optional<T>.Some(value);
                }
            }
            return optional.Optional<T>.None;
        };

        /// @brief Returns the first of the least elements according to `c`, or `None` when empty.
        export let min = func(c: func(T, T) -> ordering.Ordering) -> optional.Optional<T> =>
            extreme(c, ordering.Ordering.Less);

        /// @brief Returns the first of the greatest elements according to `c`, or `None` when empty.
        export let max = func(c: func(T, T) -> ordering.Ordering) -> optional.Optional<T> =>
            extreme(c, ordering.Ordering.Greater);

        /// @brief A HashSet of the elements in first-occurrence order, by equals and
        /// hash_code.
        export let to_set = func -> hash_set.HashSet<T> {
            begin();
            let result = hash_set.create<T>();
            while (has_next()) {
                result.add(next());
            }
            return result;
        };

        /// @brief A HashMap from key(element) to value(element), by the keys' equals
        /// and hash_code. Traps with "invalid argument: duplicate key" when two
        /// elements give equal keys.
        export let to_map = func<K, V>(key: func(T) -> K, value: func(T) -> V) -> hash_map.HashMap<K, V> {
            begin();
            let result = hash_map.create<K, V>();
            while (has_next()) {
                let element = next();
                let item_key = key(element);
                if (result.contains_key(item_key)) {
                    trap_with_message("invalid argument: duplicate key");
                }
                result.set(item_key, value(element));
            }
            return result;
        };

        /// @brief The elements grouped by key(element), groups in first-seen key
        /// order and each group in sequence order.
        export let group_by = func<K>(key: func(T) -> K) -> hash_map.HashMap<K, array_list.ArrayList<T>> {
            begin();
            let groups = hash_map.create<K, array_list.ArrayList<T>>();
            let make = func -> array_list.ArrayList<T> => array_list.create<T>();
            while (has_next()) {
                let element = next();
                groups.get_or_put(key(element), make).add(element);
            }
            return groups;
        };

        /// @brief Returns `Sequence` without claiming or evaluating the pipeline.
        export let.override to_string = func -> string => "Sequence";

        /// @brief Marks the sequence used and returns its has_next function, for an
        /// operation of another sequence that consumes this one.
        let take_has_next = func -> func() -> bool {
            begin();
            return has_next;
        };

        /// @brief The next function of a sequence take_has_next already used up.
        let take_next = func -> func() -> T => next;

        /// @brief Claims the pipeline for an operation. Traps with `invalid state: sequence already used` after the first claim.
        let begin = func {
            if (consumed) {
                trap_with_message("invalid state: sequence already used");
            }
            consumed = true;
        };

        /// @brief Scans the sequence for the first comparator minimum or maximum, as selected by `wanted`.
        let extreme = func(c: func(T, T) -> ordering.Ordering, wanted: ordering.Ordering) -> optional.Optional<T> {
            begin();
            if (!has_next()) {
                return optional.Optional<T>.None;
            }
            let best = next();
            while (has_next()) {
                let value = next();
                if (c(value, best) == wanted) {
                    best = value;
                }
            }
            return optional.Optional<T>.Some(best);
        };
    );

    /// @brief An iterator that owns the remaining traversal of a claimed sequence.
    let SequenceIterator = class<T> implements Iterator<T> (
        /// @brief The availability check for the next output.
        let more: func() -> bool;
        /// @brief The function that consumes and returns the next output.
        let pull: func() -> T;

        /// @brief Captures the two callbacks from the claimed sequence.
        export let init = func(has_more: func() -> bool, take: func() -> T) {
            more = has_more;
            pull = take;
        };

        /// @brief Reports whether another output is available. May evaluate upstream elements to prepare that output.
        export let has_next = func -> bool => more();

        /// @brief Returns the next output and advances. Traps with `no such element` at exhaustion.
        export let next = func -> T {
            if (!more()) {
                trap_with_message("no such element");
            }
            return pull();
        };
    );

    /// @brief A sequence whose elements come from `buffer`, which `refill` appends
    /// to when it is used up. `refill` returns false at the end and true only
    /// after appending at least one element.
    let buffered = func<U>(buffer: U[list], refill: func() -> bool) -> Sequence<U> {
        let position = cell.of<int>(0);
        let more = func -> bool {
            if (position.value < buffer.length) {
                return true;
            }
            while (buffer.length > 0) {
                buffer.remove_at(buffer.length - 1);
            }
            position.value = 0;
            return refill();
        };
        return new Sequence<U>(more, func() -> U {
            if (!more()) {
                trap_with_message("no such element");
            }
            let value = buffer[position.value];
            position.value = position.value + 1;
            return value;
        });
    };

    /// @brief The list's elements in order. It fails fast with "collection modified
    /// during iteration" when the list changes structurally, as the built-in
    /// for-each does.
    export let from_list = func<T>(items: T[list]) -> Sequence<T> {
        let position = cell.of<int>(0);
        let version = items.version;
        let more = func -> bool {
            if (items.version != version) {
                trap_with_message("collection modified during iteration");
            }
            return position.value < items.length;
        };
        return new Sequence<T>(more, func() -> T {
            if (!more()) {
                trap_with_message("no such element");
            }
            let value = items[position.value];
            position.value = position.value + 1;
            return value;
        });
    };

    /// @brief The remaining elements of an iterator, which keeps its own
    /// modification checks.
    export let from_iterator = func<T>(items: Iterator<T>) -> Sequence<T> {
        return new Sequence<T>(func() -> bool {
            return items.has_next();
        }, func() -> T {
            return items.next();
        });
    };

    /// @brief Creates a sequence with no elements.
    export let empty = func<T> -> Sequence<T> {
        return new Sequence<T>(func() -> bool {
            return false;
        }, func() -> T {
            trap_with_message("no such element");
        });
    };

    /// @brief An infinite sequence of make(), make(), ...
    export let generate = func<T>(make: func() -> T) -> Sequence<T> {
        return new Sequence<T>(func() -> bool {
            return true;
        }, make);
    };

    /// @brief Returns an infinite sequence starting with `seed` and repeatedly applying `step`. The step
    /// runs only when the next element is pulled.
    export let iterate = func<T>(seed: T, step: func(T) -> T) -> Sequence<T> {
        let state = cell.of<T>(seed);
        let started = cell.of<bool>(false);
        return new Sequence<T>(func() -> bool {
            return true;
        }, func() -> T {
            if (started.value) {
                state.value = step(state.value);
            } else {
                started.value = true;
            }
            return state.value;
        });
    };

    /// @brief Returns the integers in ascending order from `start` inclusive to `end` exclusive.
    /// The sequence is empty when `end` is at or below `start`.
    export let range = func(start: int, end: int) -> Sequence<int> {
        let position = cell.of<int>(start);
        let more = func -> bool => position.value < end;
        return new Sequence<int>(more, func() -> int {
            if (!more()) {
                trap_with_message("no such element");
            }
            let value = position.value;
            position.value = value + 1;
            return value;
        });
    };

    /// @brief The strings with `separator` between consecutive ones.
    export let join = func(s: Sequence<string>, separator: string) -> string {
        let items = s.iterator();
        let text = "";
        let first = true;
        while (items.has_next()) {
            if (first) {
                first = false;
            } else {
                text += separator;
            }
            text = text + items.next();
        }
        return text;
    };

    /// @brief Consumes the sequence by adding from zero in order. Overflow traps with reason 1.
    export let sum_int32 = func(s: Sequence<int>) -> int {
        let items = s.iterator();
        let total = 0;
        while (items.has_next()) {
            total = total + items.next();
        }
        return total;
    };

    /// @brief Consumes the sequence by adding from zero in order. Overflow traps with reason 1.
    export let sum_int64 = func(s: Sequence<int64>) -> int64 {
        let items = s.iterator();
        let total: int64 = 0;
        while (items.has_next()) {
            total = total + items.next();
        }
        return total;
    };

    /// @brief Consumes the sequence by adding left to right starting from the first element. Returns 0.0 when empty.
    export let sum_float64 = func(s: Sequence<float64>) -> float64 {
        let items = s.iterator();
        if (!items.has_next()) {
            return 0.0;
        }
        let total = items.next();
        while (items.has_next()) {
            total = total + items.next();
        }
        return total;
    };
);
