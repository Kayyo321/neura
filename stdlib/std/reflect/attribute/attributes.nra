let.promote optional = import:Std.Core.Optional;
let model = import:Std.Reflect.Internal.Model;

/// @brief Tags as runtime attributes (docs/design/Reflect030.md, The packages). Every tag written on a type,
/// field, variant, method or parameter is kept in the type's descriptor with its arguments as written. The
/// builtin tags `#SerialName`, `#Skip` and `#Sensitive` are the ones `Std.Reflect.Codec` reads.
/// @see [Std.Reflect.Attribute.Attributes](https://github.com/Kayyo321/neura/wiki/Stdlib-Reflect-Attributes)
#Since("0.3.0")
export let Attributes = module (
    /// @brief A tag and its arguments.
    #Since("0.3.0")
    export let Attribute = model.Attribute;

    /// @brief The kind of declaration an attribute was written on.
    #Since("0.3.0")
    export let AttributeTarget = enum (Type, Field, Variant, Method, Parameter);

    /// @brief The tags of a type.
    #Since("0.3.0")
    export let of_type = func(type: model.TypeDescriptor) -> Attribute[list] => type.attributes;

    /// @brief The tags of a field.
    #Since("0.3.0")
    export let of_field = func(field: model.FieldInfo) -> Attribute[list] => field.attributes;

    /// @brief The first attribute named `tag` among `items`, or nil.
    #Since("0.3.0")
    export let find = func(items: Attribute[list], tag: string) -> Attribute => model.find_attribute(items, tag);

    /// @brief Whether `items` has an attribute named `tag`.
    #Since("0.3.0")
    export let has = func(items: Attribute[list], tag: string) -> bool => model.find_attribute(items, tag) != nil;

    /// @brief The wire name of a field: its `#SerialName` argument, or its declared name.
    #Since("0.3.0")
    export let serial_name = func(field: model.FieldInfo) -> string {
        last tag = model.find_attribute(field.attributes, "SerialName");
        if (tag == nil) {
            return field.name;
        }
        return match (tag.argument("name")) {
            Optional.Some(name) => name,
            Optional.None => field.name,
        };
    };

    /// @brief Whether a field is tagged `#Skip`: serializers leave it out.
    #Since("0.3.0")
    export let skipped = func(field: model.FieldInfo) -> bool => model.find_attribute(field.attributes, "Skip") != nil;

    /// @brief Whether a field is tagged `#Sensitive`: serializers write a placeholder instead of its value.
    #Since("0.3.0")
    export let sensitive = func(field: model.FieldInfo) -> bool =>
        model.find_attribute(field.attributes, "Sensitive") != nil;

    /// @brief The wire name of a variant: its `#SerialName` argument, or its declared name.
    #Since("0.3.0")
    export let variant_serial_name = func(variant: model.VariantInfo) -> string => named(variant.attributes, variant.name);

    /// @brief The name of a type in a schema: its `#SerialName` argument, or its qualified name.
    #Since("0.3.0")
    export let type_serial_name = func(type: model.TypeDescriptor) -> string => named(type.attributes, type.qualified_name);

    /// @brief Whether a type is tagged `#Sensitive`: serializers write a placeholder for every value of it.
    #Since("0.3.0")
    export let type_sensitive = func(type: model.TypeDescriptor) -> bool =>
        model.find_attribute(type.attributes, "Sensitive") != nil;

    /// @brief Whether serializers write a field at all: it is exported, a Variant can hold its value, and it is
    /// not tagged `#Skip`.
    #Since("0.3.0")
    export let written = func(field: model.FieldInfo) -> bool => field.exported && field.dynamic && not skipped(field);

    let named = func(items: Attribute[list], fallback: string) -> string {
        last tag = model.find_attribute(items, "SerialName");
        if (tag == nil) {
            return fallback;
        }
        return match (tag.argument("name")) {
            Optional.Some(name) => name,
            Optional.None => fallback,
        };
    };
);
