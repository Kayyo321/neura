let.promote json = import:Std.Encoding.Json;
let attributes = import:Std.Reflect.Attribute.Attributes;
let model = import:Std.Reflect.Internal.Model;
let kinds = import:Std.Reflect.Type.TypeKind;

/// @brief Schemas from type descriptors (docs/design/Reflect030.md, The packages): the JSON Schema (draft 2020-12)
/// of the JSON that `Std.Reflect.Codec.JsonBridge` writes for a type, a Protocol Buffers (proto3) definition, and a
/// SQL table. In the JSON Schema, classes, records and enums are defined once under `$defs` and referenced by
/// `$ref`, so recursive types are described.
/// @see [Std.Reflect.Codec.SchemaBuilder](https://github.com/Kayyo321/neura/wiki/Stdlib-Reflect-Codec-SchemaBuilder)
.Since("0.3.0")
export let SchemaBuilder = module (
    /// @brief The JSON Schema of `type` as a JSON tree.
    .Since("0.3.0")
    export let json_schema = func(type: model.TypeDescriptor) -> JsonValue {
        last definitions: [string, JsonValue][list] = new;
        last root = schema_of(type, definitions);
        last members: [string, JsonValue][list] = new;
        members.append(["$schema", JsonValue.Text("https://json-schema.org/draft/2020-12/schema")]);
        match (root) {
            JsonValue.Object(items) => {
                for (let item in items) {
                    members.append(item);
                }
            },
            _ => {},
        }
        if (definitions.length > 0) {
            members.append(["$defs", JsonValue.Object(definitions)]);
        }
        return JsonValue.Object(members);
    };

    /// @brief The JSON Schema of `type` as text.
    .Since("0.3.0")
    export let json_schema_text = func(type: model.TypeDescriptor) -> string => json.write(json_schema(type));

    /// @brief The proto3 messages for a class or record and every class, record and enum it reaches. Fields are
    /// numbered from 1 in declaration order and `#Skip` fields are left out. Mapping: `bool`, `string`, `int32`,
    /// `int64`, `uint32`, `uint64`, `float` (float32 and narrower floats), `double`; int8 and int16 are `int32`,
    /// uint8 and uint16 `uint32`; a list is `repeated` (a list of lists traps); `Optional<T>` is `optional T`; a
    /// fieldless enum is a proto enum; an enum with payloads, a tuple or a function value traps.
    .Since("0.3.0")
    export let protobuf_schema = func(type: model.TypeDescriptor) -> string {
        last done: string[list] = new;
        last parts: string[list] = new;
        proto_message(type, done, parts);
        let text = "syntax = \"proto3\";\n";
        for (let part in parts) {
            text ..= "\n" .. part;
        }
        return text;
    };

    /// @brief A `CREATE TABLE` statement for a class or record whose fields are scalars, strings or `Optional`
    /// of them: a column per field (`#Skip` left out), `NOT NULL` unless optional. Types: `BOOLEAN`, `SMALLINT`
    /// (8- and 16-bit), `INTEGER` (32-bit), `BIGINT` (64-bit; uint64 values above the BIGINT range do not fit),
    /// `REAL`, `DOUBLE PRECISION`, `TEXT`. Another field type traps.
    .Since("0.3.0")
    export let sql_table = func(type: model.TypeDescriptor, table: string) -> string {
        if (type.kind != kinds.TypeKind.Class && type.kind != kinds.TypeKind.Record) {
            trap_with_message("invalid argument: a SQL table describes a class or record, not " .. type.name);
        }
        let text = "CREATE TABLE " .. table .. " (";
        let first = true;
        for (let field in type.fields) {
            if (not attributes.written(field)) {
                continue;
            }
            if (field.type_ordinal < 0) {
                trap_with_message("invalid argument: field " .. field.name .. " of type any has no SQL column type");
            }
            let column = model.descriptor_of(field.type_ordinal);
            let nullable = false;
            if (column.kind == kinds.TypeKind.Enum && column.generic_origin == "Optional") {
                column = model.descriptor_of(column.variants[1].payloads[0].type_ordinal);
                nullable = true;
            }
            text ..= (first ? "\n    " : ",\n    ") .. attributes.serial_name(field) .. " " .. sql_type(column, field.name) ..
                (nullable ? "" : " NOT NULL");
            first = false;
        }
        return text .. "\n);";
    };

    let sql_type = func(type: model.TypeDescriptor, field: string) -> string {
        if (type.kind == kinds.TypeKind.Bool) {
            return "BOOLEAN";
        }
        if (type.kind == kinds.TypeKind.String) {
            return "TEXT";
        }
        if (type.kind == kinds.TypeKind.Float) {
            return type.layout.bits == 64 ? "DOUBLE PRECISION" : "REAL";
        }
        if (type.kind == kinds.TypeKind.Integer) {
            last bits = type.layout.bits;
            return bits <= 16 ? "SMALLINT" : bits == 32 && type.name == "int32" ? "INTEGER" : "BIGINT";
        }
        trap_with_message("invalid argument: field " .. field .. " of type " .. type.name .. " has no SQL column type");
        return "";
    };

    let proto_scalar = func(type: model.TypeDescriptor) -> string {
        if (type.kind == kinds.TypeKind.Bool) {
            return "bool";
        }
        if (type.kind == kinds.TypeKind.String) {
            return "string";
        }
        if (type.kind == kinds.TypeKind.Float) {
            return type.layout.bits == 64 ? "double" : "float";
        }
        if (type.kind == kinds.TypeKind.Integer) {
            last unsigned = type.name.slice(0, 1) == "u";
            if (type.layout.bits == 64) {
                return unsigned ? "uint64" : "int64";
            }
            return unsigned ? "uint32" : "int32";
        }
        return "";
    };

    let proto_name = func(type: model.TypeDescriptor) -> string {
        last name = attributes.type_serial_name(type);
        let text = "";
        for (let i in 0 .. name.byte_length) {
            last c = name.slice(i, i + 1);
            text ..= (c == "." ? "_" : c);
        }
        return text;
    };

    let proto_type = func(type: model.TypeDescriptor, done: string[list], parts: string[list], field: string) -> string {
        last scalar = proto_scalar(type);
        if (scalar != "") {
            return scalar;
        }
        if (type.kind == kinds.TypeKind.Class || type.kind == kinds.TypeKind.Record) {
            proto_message(type, done, parts);
            return proto_name(type);
        }
        if (type.kind == kinds.TypeKind.Enum && type.generic_origin != "Optional") {
            for (let variant in type.variants) {
                if (variant.payloads.length > 0) {
                    trap_with_message("invalid argument: field " .. field .. ": the enum " .. type.name +
                        " has payloads, which proto3 enums cannot hold");
                }
            }
            if (not contains(done, proto_name(type))) {
                done.append(proto_name(type));
                let text = "enum " .. proto_name(type) .. " {\n";
                for (let variant in type.variants) {
                    text ..= "    " .. proto_name(type).to_upper_case() .. "_" .. variant.name.to_upper_case() .. " = " ..
                        variant.index.to_string() .. ";\n";
                }
                parts.append(text .. "}\n");
            }
            return proto_name(type);
        }
        trap_with_message("invalid argument: field " .. field .. " of type " .. type.name .. " has no proto3 type");
        return "";
    };

    let proto_message = func(type: model.TypeDescriptor, done: string[list], parts: string[list]) {
        if (type.kind != kinds.TypeKind.Class && type.kind != kinds.TypeKind.Record) {
            trap_with_message("invalid argument: a proto3 message describes a class or record, not " .. type.name);
        }
        if (contains(done, proto_name(type))) {
            return;
        }
        done.append(proto_name(type));
        let text = "message " .. proto_name(type) .. " {\n";
        let number = 1;
        for (let field in type.fields) {
            if (not attributes.written(field)) {
                continue;
            }
            if (field.type_ordinal < 0) {
                trap_with_message("invalid argument: field " .. field.name .. " of type any has no proto3 type");
            }
            last field_type = model.descriptor_of(field.type_ordinal);
            let prefix = "";
            let element = field_type;
            if (field_type.kind == kinds.TypeKind.List) {
                prefix = "repeated ";
                element = model.descriptor_of(field_type.elements[0]);
                if (element.kind == kinds.TypeKind.List) {
                    trap_with_message("invalid argument: field " .. field.name .. ": proto3 has no list of lists");
                }
            } else if (field_type.kind == kinds.TypeKind.Enum && field_type.generic_origin == "Optional") {
                prefix = "optional ";
                element = model.descriptor_of(field_type.variants[1].payloads[0].type_ordinal);
            }
            text ..= "    " .. prefix .. proto_type(element, done, parts, field.name) .. " " ..
                attributes.serial_name(field) .. " = " .. number.to_string() .. ";\n";
            number = number + 1;
        }
        parts.append(text .. "}\n");
    };

    let contains = func(items: string[list], wanted: string) -> bool {
        for (let item in items) {
            if (item == wanted) {
                return true;
            }
        }
        return false;
    };

    let simple = func(name: string) -> JsonValue {
        last members: [string, JsonValue][list] = new;
        members.append(["type", JsonValue.Text(name)]);
        return JsonValue.Object(members);
    };

    let reference = func(name: string) -> JsonValue {
        last members: [string, JsonValue][list] = new;
        members.append(["$ref", JsonValue.Text("#/$defs/" .. name)]);
        return JsonValue.Object(members);
    };

    let defined = func(definitions: [string, JsonValue][list], name: string) -> bool {
        for (let item in definitions) {
            if (item[0] == name) {
                return true;
            }
        }
        return false;
    };

    // The schema of the type at an ordinal; an `any` takes any JSON value.
    let schema_at = func(ordinal: int, definitions: [string, JsonValue][list]) -> JsonValue =>
        ordinal < 0 ? JsonValue.Object(new) : schema_of(model.descriptor_of(ordinal), definitions);

    let schema_of = func(type: model.TypeDescriptor, definitions: [string, JsonValue][list]) -> JsonValue {
        if (attributes.type_sensitive(type)) {
            return simple("string");
        }
        if (type.ordinal == 0) {
            return simple("null");
        }
        if (type.kind == kinds.TypeKind.Bool) {
            return simple("boolean");
        }
        if (type.kind == kinds.TypeKind.Integer) {
            return simple("integer");
        }
        if (type.kind == kinds.TypeKind.Float) {
            return simple("number");
        }
        if (type.kind == kinds.TypeKind.String) {
            return simple("string");
        }
        if (type.kind == kinds.TypeKind.List || type.kind == kinds.TypeKind.Array) {
            last members: [string, JsonValue][list] = new;
            members.append(["type", JsonValue.Text("array")]);
            members.append(["items", schema_at(type.elements[0], definitions)]);
            return JsonValue.Object(members);
        }
        if (type.kind == kinds.TypeKind.Tuple) {
            last items: JsonValue[list] = new;
            for (let element in type.elements) {
                items.append(schema_at(element, definitions));
            }
            last members: [string, JsonValue][list] = new;
            members.append(["type", JsonValue.Text("array")]);
            members.append(["prefixItems", JsonValue.Array(items)]);
            members.append(["minItems", json.number_of_int64(type.elements.length as int64)]);
            members.append(["maxItems", json.number_of_int64(type.elements.length as int64)]);
            return JsonValue.Object(members);
        }
        if (type.kind == kinds.TypeKind.Enum && type.generic_origin == "Optional") {
            last choices: JsonValue[list] = new;
            choices.append(simple("null"));
            choices.append(schema_at(type.variants[1].payloads[0].type_ordinal, definitions));
            last members: [string, JsonValue][list] = new;
            members.append(["anyOf", JsonValue.Array(choices)]);
            return JsonValue.Object(members);
        }
        if (type.kind == kinds.TypeKind.Enum || type.kind == kinds.TypeKind.Class || type.kind == kinds.TypeKind.Record) {
            last name = attributes.type_serial_name(type);
            if (not defined(definitions, name)) {
                // The name is reserved first, so that a type that reaches itself refers to its own definition.
                definitions.append([name, JsonValue.Null]);
                last body = type.kind == kinds.TypeKind.Enum ? enum_schema(type, definitions) : object_schema(type, definitions);
                for (let i in 0 .. definitions.length) {
                    if (definitions[i][0] == name) {
                        definitions[i] = [name, body];
                    }
                }
            }
            return reference(name);
        }
        return JsonValue.Object(new);
    };

    let object_schema = func(type: model.TypeDescriptor, definitions: [string, JsonValue][list]) -> JsonValue {
        last properties: [string, JsonValue][list] = new;
        last required: JsonValue[list] = new;
        for (let field in type.fields) {
            if (not attributes.written(field)) {
                continue;
            }
            last wire = attributes.serial_name(field);
            if (field.type_ordinal < 0) {
                // An any field takes any JSON value.
                properties.append([wire, JsonValue.Object(new)]);
                required.append(JsonValue.Text(wire));
                continue;
            }
            last field_type = model.descriptor_of(field.type_ordinal);
            properties.append([wire, attributes.sensitive(field) ? simple("string") : schema_of(field_type, definitions)]);
            if (field_type.generic_origin != "Optional") {
                required.append(JsonValue.Text(wire));
            }
        }
        last members: [string, JsonValue][list] = new;
        members.append(["type", JsonValue.Text("object")]);
        members.append(["properties", JsonValue.Object(properties)]);
        members.append(["required", JsonValue.Array(required)]);
        return JsonValue.Object(members);
    };

    let enum_schema = func(type: model.TypeDescriptor, definitions: [string, JsonValue][list]) -> JsonValue {
        last choices: JsonValue[list] = new;
        for (let variant in type.variants) {
            last properties: [string, JsonValue][list] = new;
            last constant: [string, JsonValue][list] = new;
            constant.append(["const", JsonValue.Text(attributes.variant_serial_name(variant))]);
            properties.append(["variant", JsonValue.Object(constant)]);
            last required: JsonValue[list] = new;
            required.append(JsonValue.Text("variant"));
            if (variant.payloads.length > 0) {
                last items: JsonValue[list] = new;
                for (let payload in variant.payloads) {
                    items.append(schema_at(payload.type_ordinal, definitions));
                }
                last payload_schema: [string, JsonValue][list] = new;
                payload_schema.append(["type", JsonValue.Text("array")]);
                payload_schema.append(["prefixItems", JsonValue.Array(items)]);
                properties.append(["payload", JsonValue.Object(payload_schema)]);
                required.append(JsonValue.Text("payload"));
            }
            last choice: [string, JsonValue][list] = new;
            choice.append(["type", JsonValue.Text("object")]);
            choice.append(["properties", JsonValue.Object(properties)]);
            choice.append(["required", JsonValue.Array(required)]);
            choices.append(JsonValue.Object(choice));
        }
        last members: [string, JsonValue][list] = new;
        members.append(["oneOf", JsonValue.Array(choices)]);
        return JsonValue.Object(members);
    };
);
