let.promote big_integer = import:Std.Math.BigInteger;
let.promote _ = import:Std.Core.Comparable;
let.promote _ = import:Std.Core.Error;
let hashing = import:Std.Core.Hash;
let optional = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Ordering;
let.promote result = import:Std.Core.Result;
let rounding = import:Std.Math.Internal.FloatRounding;

/// @brief An immutable decimal number: an unscaled BigInteger and an int scale, representing unscaled *
/// 10^(-scale) (Stdlib.md section 10.3).
///
/// add, subtract, and multiply are exact. Division takes an explicit result scale and RoundingMode. equals and
/// compare_to are numeric, so 2.0 equals 2.00; hash_code is computed on the form with trailing zeros stripped.
/// A scale that leaves the int range traps (reason 1), from checked int arithmetic or conversion.
/// @see [Std.Math.BigDecimal](https://github.com/Kayyo321/neura/wiki/Stdlib-Math-BigDecimal)
#Since("0.1.0")
export let BigDecimal = module (
    /// @brief Java's rounding modes: Up and Down round away from and toward zero, Ceiling and Floor toward
    /// positive and negative infinity, and the Half modes round to the nearest neighbour with ties away from
    /// zero, toward zero, or to the even neighbour.
    export let RoundingMode = enum (Up, Down, Ceiling, Floor, HalfUp, HalfDown, HalfEven);

    /// @brief An immutable decimal represented by an unscaled integer times ten raised to the negative scale.
    #[Final, NoDiscard]
    export let BigDecimal = class implements Comparable<BigDecimal> (
        /// @brief The integer coefficient, the unscaled value.
        export last unscaled: BigInteger;
        /// @brief The number of digits after the decimal point; negative for a multiple of a power of ten.
        export last scale: int;

        /// @brief The value unscaled * 10^(-scale). A nil unscaled value traps.
        export let init = func(unscaled_part: BigInteger, scale_part: int) {
            if (unscaled_part == nil) {
                trap_with_message("invalid argument: unscaled value is nil");
            }
            unscaled = unscaled_part;
            scale = scale_part;
        };

        /// @brief Returns minus one, zero, or one according to the coefficient's sign.
        #Pure
        export let sign = func -> int => unscaled.sign();

        /// @brief Reverses the sign and preserves the scale.
        export let negate = func -> BigDecimal => new(unscaled.negate(), scale);

        /// @brief Returns the absolute value and preserves the scale.
        export let abs = func -> BigDecimal => new(unscaled.abs(), scale);

        /// @brief Exact; the result has the larger scale.
        export let add = func(other: BigDecimal) -> BigDecimal {
            if (scale == other.scale) {
                return new(unscaled.add(other.unscaled), scale);
            }
            if (scale > other.scale) {
                last aligned = times_power_of_ten(other.unscaled, (scale as int64) - (other.scale as int64));
                return new(unscaled.add(aligned), scale);
            }
            last aligned = times_power_of_ten(unscaled, (other.scale as int64) - (scale as int64));
            return new(aligned.add(other.unscaled), other.scale);
        };

        /// @brief Exact; the result has the larger scale.
        export let subtract = func(other: BigDecimal) -> BigDecimal => add(other.negate());

        /// @brief Exact; the result's scale is the sum of the scales.
        #Pure
        export let multiply = func(other: BigDecimal) -> BigDecimal =>
            new(unscaled.multiply(other.unscaled), scale + other.scale);

        /// @brief this / other rounded to `result_scale` digits after the point with `mode`. A zero divisor
        /// traps (reason 1) in the BigInteger division.
        export let divide = func(other: BigDecimal, result_scale: int, mode: RoundingMode) -> BigDecimal {
            if (other.unscaled.is_zero()) {
                let _ = unscaled.divide(other.unscaled);
            }
            // this / other = (u / v) * 10^(other.scale - scale), so the
            // result's unscaled value is u * 10^e / v.
            last e = (result_scale as int64) - (scale as int64) + (other.scale as int64);
            let numerator = unscaled;
            let denominator = other.unscaled;
            if (e >= 0) {
                numerator = times_power_of_ten(numerator, e);
            } else {
                denominator = times_power_of_ten(denominator, -e);
            }
            return new(divide_rounded(numerator, denominator, mode), result_scale);
        };

        /// @brief The same value with `new_scale` digits after the point, rounded with `mode` when digits are
        /// dropped.
        export let set_scale = func(new_scale: int, mode: RoundingMode) -> BigDecimal {
            if (new_scale >= scale) {
                return new(times_power_of_ten(unscaled, (new_scale as int64) - (scale as int64)), new_scale);
            }
            last dropped = (scale as int64) - (new_scale as int64);
            return new(divide_by_power_of_ten(unscaled, dropped, mode), new_scale);
        };

        /// @brief The value rounded to `precision` significant digits with `mode`. A precision of 0 returns the
        /// value unchanged; a negative precision traps.
        export let round = func(precision: int, mode: RoundingMode) -> BigDecimal {
            if (precision < 0) {
                trap_with_message("invalid argument: negative precision");
            }
            last digits = digit_count(unscaled);
            if (precision == 0 || digits <= precision) {
                return new(unscaled, scale);
            }
            last dropped = (digits - precision) as int64;
            let rounded = divide_by_power_of_ten(unscaled, dropped, mode);
            let new_scale = (scale as int64) - dropped;
            if (digit_count(rounded) > precision) {
                // A carry such as 999 -> 1000: drop the extra zero.
                rounded = rounded.divide(big_integer.of_int64(10));
                new_scale--;
            }
            return new(rounded, new_scale as int);
        };

        /// @brief The numerically equal value with no trailing zeros in the unscaled value; zero has scale 0.
        export let strip_trailing_zeros = func -> BigDecimal {
            if (unscaled.is_zero()) {
                return new(big_integer.of_int64(0), 0);
            }
            let value = unscaled;
            let new_scale = scale as int64;
            last billion = big_integer.of_int64(1000000000);
            do {
                let [quotient, rest] = value.divide_and_remainder(billion);
                if (!rest.is_zero()) {
                    break;
                }
                value = quotient;
                new_scale -= 9;
            }
            do {
                let [quotient, rest] = value.divide_and_remainder(big_integer.of_int64(10));
                if (!rest.is_zero()) {
                    break;
                }
                value = quotient;
                new_scale--;
            }
            return new(value, new_scale as int);
        };

        /// @brief this^exponent exactly, with scale * exponent. pow(0) is 1 with scale 0; a negative exponent
        /// traps.
        #Pure
        export let pow = func(exponent: int) -> BigDecimal {
            if (exponent < 0) {
                trap_with_message("invalid argument: negative exponent");
            }
            return new(unscaled.pow(exponent), scale * exponent);
        };

        /// @brief The integer part rounded with `mode`.
        export let to_big_integer = func(mode: RoundingMode) -> BigInteger =>
            set_scale(0, mode).unscaled;

        /// @brief The nearest float64, ties to even; infinities beyond the range and signed zeros below it.
        export let to_float64 = func -> float64 {
            last s = unscaled.sign();
            if (s == 0) {
                return 0.0;
            }
            last negative = s < 0;
            if (scale <= 0) {
                if (scale < -400) { // at least 10^401
                    return rounding.compose(negative, 1, 2000, false);
                }
                return times_power_of_ten(unscaled, -(scale as int64)).to_float64();
            }
            last m = unscaled.abs();
            last bits = m.bit_length() as int64;
            if ((scale as int64) * 3 > bits + 1100) { // below 2^-1100
                return rounding.compose(negative, 1, -2000, false);
            }
            // q = floor(m * 2^shift / 10^scale) lies in [2^61, 2^63).
            last d = power_of_ten(scale);
            last shift = 62 + d.bit_length() - (bits as int);
            let numerator = m;
            let denominator = d;
            if (shift >= 0) {
                numerator = m.shift_left(shift);
            } else {
                denominator = d.shift_left(-shift);
            }
            let [quotient, rest] = numerator.divide_and_remainder(denominator);
            last top = optional.expect<int64>(quotient.to_int64(), "quotient below 2^63") as uint64;
            return rounding.compose(negative, top, -shift, !rest.is_zero());
        };

        /// @brief Compares numerical values independently of scale without aligning widely separated scales.
        #Pure
        export let compare_to = func(other: BigDecimal) -> Ordering {
            last sa = unscaled.sign();
            last sb = other.unscaled.sign();
            if (sa != sb) {
                if (sa < sb) {
                    return Ordering.Less;
                }
                return Ordering.Greater;
            }
            if (sa == 0) {
                return Ordering.Equal;
            }
            last gap = (scale as int64) - (other.scale as int64);
            if (gap > 18 || gap < -18) {
                // Compare the decimal exponents of the leading digits first,
                // so a large scale difference never builds a large power.
                last ea = (digit_count(unscaled) as int64) - (scale as int64);
                last eb = (digit_count(other.unscaled) as int64) - (other.scale as int64);
                if (ea != eb) {
                    if ((ea < eb) == (sa > 0)) {
                        return Ordering.Less;
                    }
                    return Ordering.Greater;
                }
            }
            if (gap >= 0) {
                return unscaled.compare_to(times_power_of_ten(other.unscaled, gap));
            }
            return times_power_of_ten(unscaled, -gap).compare_to(other.unscaled);
        };

        /// @brief Numeric equality: 2.0 equals 2.00.
        #Pure
        export let.override equals = func(other: class) -> bool {
            if (!(other is BigDecimal)) {
                return false;
            }
            return compare_to(other as BigDecimal) == Ordering.Equal;
        };

        /// @brief From 17, combines the hashes of the stripped form's unscaled value and scale.
        export let.override hash_code = func -> uint32 {
            last stripped = strip_trailing_zeros();
            last h = hashing.combine(17, stripped.unscaled.hash_code());
            return hashing.combine(h, stripped.scale.hash_code());
        };

        /// @brief Plain notation: exactly `scale` digits after the point when the scale is positive, and -scale
        /// appended zeros when it is negative. Zero with a negative scale prints as 0.
        export let.override to_string = func -> string {
            last digits = unscaled.abs().to_string();
            let text = "";
            if (unscaled.sign() < 0) {
                text = "-";
            }
            if (scale <= 0) {
                if (unscaled.is_zero()) {
                    return "0";
                }
                return text + digits + zeros_text(-(scale as int64));
            }
            last length = digits.byte_length;
            if (length > scale) {
                return text + digits.slice(0, length - scale) + "." + digits.slice(length - scale, length);
            }
            return text + "0." + zeros_text((scale - length) as int64) + digits;
        };
    );

    /// @brief Constructs an exact decimal from an int64 at scale zero.
    #[Pure, ThreadSafe]
    export let of_int64 = func(value: int64) -> BigDecimal =>
        new(big_integer.of_int64(value), 0);

    /// @brief Constructs a decimal from its unscaled integer and scale.
    #Pure
    export let of_big_integer = func(value: BigInteger, scale: int) -> BigDecimal =>
        new(value, scale);

    /// @brief The exact binary value of v with the smallest scale that holds it: 0.5 has scale 1 and 2.0 has
    /// scale 0. NaN and the infinities trap.
    #[Pure, ThreadSafe]
    export let of_float64 = func(v: float64) -> BigDecimal {
        last bits = v.to_bits();
        last field = ((bits >> 52) & 2047) as int;
        if (field == 2047) {
            trap_with_message("invalid argument: not a finite value");
        }
        last fraction = bits & 4503599627370495;
        if (field == 0 && fraction == 0) {
            return new(big_integer.of_int64(0), 0);
        }
        // v = m * 2^e
        let m = fraction;
        let e = -1074;
        if (field != 0) {
            m = fraction | 4503599627370496;
            e = field - 1075;
        }
        while ((m & 1) == 0 && e < 0) {
            m >>= 1;
            e++;
        }
        let unscaled_part = big_integer.of_uint64(m);
        if ((bits >> 63) != 0) {
            unscaled_part = unscaled_part.negate();
        }
        if (e >= 0) {
            return new(unscaled_part.shift_left(e), 0);
        }
        // m / 2^-e = m * 5^-e / 10^-e
        return new(unscaled_part.multiply(big_integer.of_int64(5).pow(-e)), -e);
    };

    /// @brief An optional sign, digits with an optional point (at least one digit overall), and an optional
    /// exponent: `e` or `E`, an optional sign, and digits.
    ///
    /// The scale is the number of fraction digits minus the exponent; one outside the int range fails with
    /// OutOfRange.
    #NoDiscard
    export let parse = func(text: string) -> Result<BigDecimal> {
        last length = text.byte_length;
        if (length == 0) {
            return failed(ParseErrorKind.Empty, 0, "empty input");
        }
        let i = 0;
        let negative = false;
        if (text.byte_at(0) == 43 || text.byte_at(0) == 45) {
            negative = text.byte_at(0) == 45;
            i = 1;
        }
        last integer_start = i;
        while (i < length && is_digit(text.byte_at(i))) {
            i++;
        }
        last integer_end = i;
        let fraction_start = i;
        let fraction_end = i;
        if (i < length && text.byte_at(i) == 46) {
            i++;
            fraction_start = i;
            while (i < length && is_digit(text.byte_at(i))) {
                i++;
            }
            fraction_end = i;
        }
        if (integer_end == integer_start && fraction_end == fraction_start) {
            return digit_expected(text, i);
        }
        let exponent: int64 = 0;
        if (i < length && (text.byte_at(i) == 101 || text.byte_at(i) == 69)) {
            i++;
            let exponent_negative = false;
            if (i < length && (text.byte_at(i) == 43 || text.byte_at(i) == 45)) {
                exponent_negative = text.byte_at(i) == 45;
                i++;
            }
            last exponent_start = i;
            while (i < length && is_digit(text.byte_at(i))) {
                if (exponent < 10000000000) {
                    exponent = exponent * 10 + ((text.byte_at(i) - 48) as int64);
                }
                i++;
            }
            if (i == exponent_start) {
                return digit_expected(text, i);
            }
            if (exponent_negative) {
                exponent = -exponent;
            }
        }
        if (i < length) {
            return failed(ParseErrorKind.InvalidCharacter, i, "invalid character");
        }
        last new_scale = ((fraction_end - fraction_start) as int64) - exponent;
        if (new_scale < -2147483648 || new_scale > 2147483647) {
            return failed(ParseErrorKind.OutOfRange, 0, "scale out of range for BigDecimal");
        }
        let digits = text.slice(integer_start, integer_end) + text.slice(fraction_start, fraction_end);
        if (negative) {
            digits = "-" + digits;
        }
        last unscaled_part = result.expect<BigInteger>(big_integer.parse(digits), "digits");
        return Result<BigDecimal>.Ok(new BigDecimal(unscaled_part, new_scale as int));
    };

    /// @brief Creates a decimal parse error at the supplied UTF-8 byte offset.
    let failed = func(kind: ParseErrorKind, offset: int, message: string) -> Result<BigDecimal> =>
        Result<BigDecimal>.Err(Error.Parse { kind: kind, offset: offset, message: message });

    /// @brief UnexpectedEnd at the end of the text, otherwise InvalidCharacter.
    let digit_expected = func(text: string, offset: int) -> Result<BigDecimal> {
        if (offset == text.byte_length) {
            return failed(ParseErrorKind.UnexpectedEnd, offset, "expected a digit");
        }
        return failed(ParseErrorKind.InvalidCharacter, offset, "invalid character");
    };

    /// @brief Tests whether a byte is an ASCII decimal digit.
    let is_digit = func(b: uint8) -> bool => b >= 48 && b <= 57;

    /// @brief 10^k for k >= 0.
    let power_of_ten = func(k: int) -> BigInteger {
        if (k <= 18) {
            let value: int64 = 1;
            for (let i = 0; i < k; i++) {
                value *= 10;
            }
            return big_integer.of_int64(value);
        }
        return big_integer.of_int64(10).pow(k);
    };

    /// @brief value * 10^k for k >= 0; k beyond the int range traps (reason 1).
    let times_power_of_ten = func(value: BigInteger, k: int64) -> BigInteger {
        if (k == 0 || value.is_zero()) {
            return value;
        }
        return value.multiply(power_of_ten(k as int));
    };

    /// @brief The number of decimal digits of |value|; 1 for zero.
    let digit_count = func(value: BigInteger) -> int {
        last text = value.to_string();
        if (value.sign() < 0) {
            return text.byte_length - 1;
        }
        return text.byte_length;
    };

    /// @brief value / 10^k rounded with mode, for k >= 0. When 10^k has more digits than value the quotient is
    /// 0 and only the rounding decides.
    let divide_by_power_of_ten = func(value: BigInteger, k: int64, mode: RoundingMode) -> BigInteger {
        if (k == 0 || value.is_zero()) {
            return value;
        }
        if (k > (digit_count(value) as int64) + 1) {
            // 0 < |value| < 10^k / 2.
            return rounded_quotient(big_integer.of_int64(0), value.sign() < 0, Ordering.Less, mode);
        }
        return divide_rounded(value, power_of_ten(k as int), mode);
    };

    /// @brief numerator / denominator rounded with mode; the denominator is nonzero.
    let divide_rounded = func(numerator: BigInteger, denominator: BigInteger, mode: RoundingMode) -> BigInteger {
        let [quotient, rest] = numerator.divide_and_remainder(denominator);
        if (rest.is_zero()) {
            return quotient;
        }
        last negative = numerator.sign() * denominator.sign() < 0;
        last half = rest.abs().shift_left(1).compare_to(denominator.abs());
        return rounded_quotient(quotient, negative, half, mode);
    };

    /// @brief A quotient truncated toward zero, rounded with mode, given the sign of the exact quotient and how
    /// twice the dropped remainder compares with the divisor (Less: below half, Equal: a tie, Greater: above
    /// half).
    let rounded_quotient = func(truncated: BigInteger, negative: bool, half: Ordering, mode: RoundingMode) -> BigInteger {
        let away = false;
        if (mode == RoundingMode.Up) {
            away = true;
        } else if (mode == RoundingMode.Down) {
            away = false;
        } else if (mode == RoundingMode.Ceiling) {
            away = !negative;
        } else if (mode == RoundingMode.Floor) {
            away = negative;
        } else if (mode == RoundingMode.HalfUp) {
            away = half != Ordering.Less;
        } else if (mode == RoundingMode.HalfDown) {
            away = half == Ordering.Greater;
        } else {
            away = half == Ordering.Greater || (half == Ordering.Equal && !truncated.is_even());
        }
        if (!away) {
            return truncated;
        }
        if (negative) {
            return truncated.subtract(big_integer.of_int64(1));
        }
        return truncated.add(big_integer.of_int64(1));
    };

    /// @brief count zeros, by doubling.
    let zeros_text = func(count: int64) -> string {
        let text = "";
        let block = "0";
        let n = count;
        while (n > 0) {
            if ((n & 1) != 0) {
                text += block;
            }
            n >>= 1;
            if (n > 0) {
                block += block;
            }
        }
        return text;
    };
);
