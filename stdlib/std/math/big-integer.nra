let.promote _ = import:Std.Core.Comparable;
let hashing = import:Std.Core.Hash;
let integer_text = import:Std.Core.Internal.IntegerText;
let.promote _ = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Ordering;
let.promote _ = import:Std.Core.Result;
let rounding = import:Std.Math.Internal.FloatRounding;

/// @brief An immutable arbitrary-precision integer (Stdlib.md section 10.2).
///
/// The value is a sign (-1, 0, or 1) and a magnitude: a built-in uint32 list of limbs, least significant first,
/// with no zero limb at the top. Zero has sign 0 and no limbs. The form is unique, so equality compares the
/// fields. No operation changes a list after a BigInteger owns it, so results share limb lists freely. Every
/// intermediate is a uint64 by the limb row of Stdlib.md section 7.2. A magnitude above 2^26 limbs traps with
/// `invalid argument: magnitude too large`.
/// @see [Std.Math.BigInteger](https://github.com/Kayyo321/neura/wiki/Stdlib-Math-BigInteger)
#Since("0.1.0")
export let BigInteger = module (
    /// @brief The maximum number of limbs in a magnitude.
    const MaxLimbs: int = 67108864;
    /// @brief The mask selecting the low 32 bits of a limb calculation.
    const Mask: uint64 = 4294967295;
    /// @brief The positional base of the little-endian limbs.
    const Base: uint64 = 4294967296;
    /// @brief Both operands of a product need this many limbs for Karatsuba.
    const KaratsubaLimbs: int = 48;

    /// @brief An immutable signed integer with a normalized little-endian magnitude.
    #[Final, NoDiscard]
    export let BigInteger = class implements Comparable<BigInteger> (
        /// @brief The normalized sign, which is minus one, zero, or one.
        last signum: int;
        /// @brief The magnitude in base 2^32 with no high zero limbs.
        last magnitude: uint32[list];

        /// @brief The value sign * limbs, limbs least significant first.
        ///
        /// Zero limbs at the top are dropped, and a zero magnitude has sign 0 whatever `sign` says; otherwise
        /// only the sign of `sign` matters. The new value owns `limbs`: the caller must not change the list
        /// afterwards.
        export let init = func(sign: int, limbs: uint32[list]) {
            while (limbs.length > 0 && limbs[limbs.length - 1] == 0) {
                limbs.remove_at(limbs.length - 1);
            }
            check_limbs(limbs.length);
            if (limbs.length == 0 || sign == 0) {
                if (limbs.length != 0) {
                    trap_with_message("invalid argument: zero sign with a nonzero magnitude");
                }
                signum = 0;
            } else if (sign < 0) {
                signum = -1;
            } else {
                signum = 1;
            }
            magnitude = limbs;
        };

        /// @brief Returns minus one, zero, or one according to the sign.
        #Pure
        export let sign = func -> int => signum;

        /// @brief Reports whether this integer is zero.
        #Pure
        export let is_zero = func -> bool => signum == 0;

        /// @brief Tests divisibility by two, including zero.
        #Pure
        export let is_even = func -> bool => signum == 0 || (magnitude[0] & 1) == 0;

        /// @brief Returns the value with its sign reversed.
        export let negate = func -> BigInteger => new(-signum, magnitude);

        /// @brief Returns the nonnegative magnitude.
        export let abs = func -> BigInteger => new(signum * signum, magnitude);

        /// @brief Returns the exact sum, subject to the limb limit.
        export let add = func(other: BigInteger) -> BigInteger =>
            signed_sum(signum, magnitude, other.signum, other.magnitude);

        /// @brief Returns the exact difference, subject to the limb limit.
        export let subtract = func(other: BigInteger) -> BigInteger =>
            signed_sum(signum, magnitude, -other.signum, other.magnitude);

        /// @brief Schoolbook with uint64 partial products; Karatsuba when both operands have at least 48 limbs.
        export let multiply = func(other: BigInteger) -> BigInteger {
            if (signum == 0 || other.signum == 0) {
                return new(0, []);
            }
            return new(signum * other.signum, multiply_magnitudes(magnitude, other.magnitude));
        };

        /// @brief The quotient truncated toward zero and the remainder with the dividend's sign, from one
        /// division. A zero divisor traps (reason 1) in the division by the divisor's sign.
        export let divide_and_remainder = func(other: BigInteger) -> [BigInteger, BigInteger] {
            let _ = signum / other.signum;
            let [quotient, rest] = divide_magnitudes(magnitude, other.magnitude);
            return [new BigInteger(signum * other.signum, quotient), new BigInteger(signum, rest)];
        };

        /// @brief Returns the quotient truncated toward zero. A zero divisor traps.
        export let divide = func(other: BigInteger) -> BigInteger {
            let [quotient, rest] = divide_and_remainder(other);
            return quotient;
        };

        /// @brief Returns the remainder from truncating division. A zero divisor traps.
        export let remainder = func(other: BigInteger) -> BigInteger {
            let [quotient, rest] = divide_and_remainder(other);
            return rest;
        };

        /// @brief The remainder with the modulus's sign: non-negative for a positive modulus. A zero modulus
        /// traps (reason 1).
        export let floor_mod = func(m: BigInteger) -> BigInteger {
            last rest = remainder(m);
            if (rest.signum != 0 && rest.signum != m.signum) {
                return rest.add(m);
            }
            return rest;
        };

        /// @brief Square and multiply. pow(0) is 1; a negative exponent traps.
        export let pow = func(exponent: int) -> BigInteger {
            if (exponent < 0) {
                trap_with_message("invalid argument: negative exponent");
            }
            if (exponent == 0) {
                return new(1, [1]);
            }
            if (signum == 0) {
                return new(0, []);
            }
            // The result has at least (bits - 1) * exponent + 1 bits.
            last bits = bit_length() as int64;
            if ((bits - 1) * (exponent as int64) + 1 > (MaxLimbs as int64) * 32) {
                trap_with_message("invalid argument: magnitude too large");
            }
            let power: uint32[list] = [1];
            let base = magnitude;
            let e = exponent;
            while (e > 0) {
                if ((e & 1) != 0) {
                    power = multiply_magnitudes(power, base);
                }
                e >>= 1;
                if (e > 0) {
                    base = multiply_magnitudes(base, base);
                }
            }
            let power_sign = 1;
            if (signum < 0 && (exponent & 1) != 0) {
                power_sign = -1;
            }
            return new(power_sign, power);
        };

        /// @brief Euclid's algorithm with remainders; the result is non-negative and gcd(0, 0) is 0.
        export let gcd = func(other: BigInteger) -> BigInteger {
            let a = magnitude;
            let b = other.magnitude;
            while (b.length > 0) {
                let [quotient, rest] = divide_magnitudes(a, b);
                a = b;
                b = rest;
            }
            return new(1, a);
        };

        /// @brief this^exponent mod modulus, in 0 through modulus - 1: left-to-right binary exponentiation
        /// reducing after each step. A negative exponent or a modulus that is not positive traps.
        export let mod_pow = func(exponent: BigInteger, modulus: BigInteger) -> BigInteger {
            if (modulus.signum <= 0) {
                trap_with_message("invalid argument: modulus not positive");
            }
            if (exponent.signum < 0) {
                trap_with_message("invalid argument: negative exponent");
            }
            last m = modulus.magnitude;
            last base = floor_mod(modulus).magnitude;
            let [unit_quotient, power] = divide_magnitudes([1], m);
            for (let bit = exponent.bit_length() - 1; bit >= 0; bit--) {
                let [square_quotient, square] = divide_magnitudes(multiply_magnitudes(power, power), m);
                power = square;
                if (exponent.test_bit(bit)) {
                    let [product_quotient, product] = divide_magnitudes(multiply_magnitudes(power, base), m);
                    power = product;
                }
            }
            return new(1, copy_limbs(power));
        };

        /// @brief The x in 0 through modulus - 1 with this * x = 1 (mod modulus), by extended Euclid, or nil
        /// when gcd(this, modulus) is not 1. A modulus that is not positive traps.
        export let mod_inverse = func(modulus: BigInteger) -> BigInteger {
            if (modulus.signum <= 0) {
                trap_with_message("invalid argument: modulus not positive");
            }
            let old_r = floor_mod(modulus);
            let r = modulus;
            let old_s = new BigInteger(1, [1]);
            let s = new BigInteger(0, []);
            while (r.signum != 0) {
                let [quotient, rest] = old_r.divide_and_remainder(r);
                old_r = r;
                r = rest;
                last next_s = old_s.subtract(quotient.multiply(s));
                old_s = s;
                s = next_s;
            }
            if (old_r.magnitude.length != 1 || old_r.magnitude[0] != 1) {
                return nil;
            }
            return old_s.floor_mod(modulus);
        };

        /// @brief this * 2^n. A negative n traps.
        export let shift_left = func(n: int) -> BigInteger {
            if (n < 0) {
                trap_with_message("invalid argument: negative shift count");
            }
            if (signum == 0) {
                return new(0, []);
            }
            return new(signum, shift_left_magnitude(magnitude, n));
        };

        /// @brief floor(this / 2^n): rounds toward negative infinity. A negative n traps.
        export let shift_right = func(n: int) -> BigInteger {
            if (n < 0) {
                trap_with_message("invalid argument: negative shift count");
            }
            let [shifted, lost] = shift_right_magnitude(magnitude, n);
            if (signum < 0 && lost) {
                shifted = add_magnitudes(shifted, [1]);
            }
            return new(signum, shifted);
        };

        /// @brief The number of bits of the magnitude; 0 for zero.
        #Pure
        export let bit_length = func -> int {
            if (signum == 0) {
                return 0;
            }
            last top = magnitude[magnitude.length - 1];
            return (magnitude.length - 1) * 32 + (32 - leading_zeros(top));
        };

        /// @brief Bit n of the magnitude. A negative n traps.
        #Pure
        export let test_bit = func(n: int) -> bool {
            if (n < 0) {
                trap_with_message("invalid argument: negative bit index");
            }
            last limb = n / 32;
            if (limb >= magnitude.length) {
                return false;
            }
            return ((magnitude[limb] >> (n % 32)) & 1) != 0;
        };

        /// @brief Compares signed values by sign and then magnitude.
        #Pure
        export let compare_to = func(other: BigInteger) -> Ordering {
            if (signum != other.signum) {
                if (signum < other.signum) {
                    return Ordering.Less;
                }
                return Ordering.Greater;
            }
            last c = compare_magnitudes(magnitude, other.magnitude) * signum;
            if (c < 0) {
                return Ordering.Less;
            }
            if (c > 0) {
                return Ordering.Greater;
            }
            return Ordering.Equal;
        };

        /// @brief Tests whether another BigInteger has the same sign and magnitude.
        #Pure
        export let.override equals = func(other: class) -> bool {
            if (!(other is BigInteger)) {
                return false;
            }
            last value = other as BigInteger;
            return signum == value.signum && magnitude === value.magnitude;
        };

        /// @brief Starts at 0, combines each limb from most to least significant, then negates (wrapping) for a
        /// negative value.
        #Pure
        export let.override hash_code = func -> uint32 {
            let h: uint32 = 0;
            for (let i = magnitude.length - 1; i >= 0; i--) {
                h = hashing.combine(h, magnitude[i]);
            }
            if (signum < 0 && h != 0) {
                return (Base - (h as uint64)) as uint32;
            }
            return h;
        };

        /// @brief Returns Some when the value fits in int64, or None otherwise.
        #[NoDiscard, Pure]
        export let to_int64 = func -> Optional<int64> {
            if (magnitude.length > 2) {
                return Optional<int64>.None;
            }
            let value: uint64 = 0;
            if (magnitude.length > 0) {
                value = magnitude[0] as uint64;
            }
            if (magnitude.length > 1) {
                value |= ((magnitude[1] as uint64) << 32);
            }
            if (signum >= 0) {
                if (value > 9223372036854775807) {
                    return Optional<int64>.None;
                }
                return Optional<int64>.Some(value as int64);
            }
            if (value > 9223372036854775808) {
                return Optional<int64>.None;
            }
            if (value == 9223372036854775808) {
                return Optional<int64>.Some(-9223372036854775808);
            }
            return Optional<int64>.Some(-(value as int64));
        };

        /// @brief The nearest float64, ties to even; an infinity beyond the range.
        export let to_float64 = func -> float64 {
            if (magnitude.length <= 2) {
                let value: uint64 = 0;
                if (magnitude.length > 0) {
                    value = magnitude[0] as uint64;
                }
                if (magnitude.length > 1) {
                    value |= ((magnitude[1] as uint64) << 32);
                }
                return rounding.compose(signum < 0, value, 0, false);
            }
            // Keep the top 64 bits; any lower one bit is sticky.
            last shift = (magnitude.length - 2) * 32 - leading_zeros(magnitude[magnitude.length - 1]);
            let [top, lost] = shift_right_magnitude(magnitude, shift);
            last value = (top[0] as uint64) | ((top[1] as uint64) << 32);
            return rounding.compose(signum < 0, value, shift, lost);
        };

        /// @brief Decimal, by repeated division by 10^9 and nine-digit groups.
        export let.override to_string = func -> string => magnitude_text(signum, magnitude, 10);

        /// @brief Lowercase digits. A radix outside 2 through 36 traps.
        export let to_string_radix = func(radix: int) -> string {
            integer_text.check_radix(radix);
            return magnitude_text(signum, magnitude, radix);
        };
    );

    // The methods above build their own zero and one instead of reading these constants: a constant object is
    // module state, which a spawned task may not read (Concurrency.md section 5.2).
    /// @brief The integer zero.
    export const Zero: BigInteger = new BigInteger(0, []);
    /// @brief The integer one.
    export const One: BigInteger = new BigInteger(1, [1]);
    /// @brief The integer ten.
    export const Ten: BigInteger = new BigInteger(1, [10]);

    /// @brief Constructs a BigInteger from any int64, including the minimum signed value.
    export let of_int64 = func(value: int64) -> BigInteger {
        if (value >= 0) {
            return of_uint64(value as uint64);
        }
        // -(value + 1) fits int64, so Min needs no overflowing negation.
        last magnitude_value = (-(value + 1)) as uint64 + 1;
        return new(-1, limbs_of(magnitude_value));
    };

    /// @brief Constructs a nonnegative BigInteger from an unsigned 64-bit value.
    export let of_uint64 = func(value: uint64) -> BigInteger => new(1, limbs_of(value));

    /// @brief Parses base-10 integer text or returns a parse error.
    #NoDiscard
    export let parse = func(text: string) -> Result<BigInteger> => parse_radix(text, 10);

    /// @brief An optional `+` or `-`, then one or more digits of the radix in either case (Stdlib.md section
    /// 7.1), with no range failure. A radix outside 2 through 36 traps.
    #NoDiscard
    export let parse_radix = func(text: string, radix: int) -> Result<BigInteger> {
        integer_text.check_radix(radix);
        match (integer_text.syntax_error(text, radix)) {
            Optional.Some(failure) => {
                return Result<BigInteger>.Err(failure);
            },
            Optional.None => {},
        }
        last start = integer_text.sign_length(text);
        let value_sign = 1;
        if (text.byte_at(0) == 45) {
            value_sign = -1;
        }
        let [chunk_digits, chunk] = radix_chunk(radix);
        last limbs: uint32[list] = [];
        last length = text.byte_length;
        let i = start;
        while (i < length) {
            let end = i + chunk_digits;
            if (end > length) {
                end = length;
            }
            let value: uint32 = 0;
            let scale: uint32 = 1;
            for (let j = i; j < end; j++) {
                value = value * (radix as uint32) + (integer_text.digit_value(text.byte_at(j)) as uint32);
                scale *= (radix as uint32);
            }
            multiply_add_in_place(limbs, scale, value);
            i = end;
        }
        // "-0" has no limbs, which makes it zero.
        return Result<BigInteger>.Ok(new BigInteger(value_sign, limbs));
    };

    // ---- Magnitudes: uint32 limb lists, least significant first. Helpers
    // never change their arguments; results are fresh lists.

    /// @brief Traps when a requested magnitude would exceed the limb limit.
    let check_limbs = func(count: int) {
        if (count > MaxLimbs) {
            trap_with_message("invalid argument: magnitude too large");
        }
    };

    /// @brief Splits an unsigned 64-bit value into little-endian 32-bit limbs.
    let limbs_of = func(value: uint64) -> uint32[list] {
        last limbs: uint32[list] = [];
        if (value != 0) {
            limbs.append((value & Mask) as uint32);
            if ((value >> 32) != 0) {
                limbs.append((value >> 32) as uint32);
            }
        }
        return limbs;
    };

    /// @brief Creates a zero-filled limb list of the requested length.
    let zeros = func(count: int) -> uint32[list] {
        last limbs: uint32[list] = [];
        for (let i = 0; i < count; i++) {
            limbs.append(0);
        }
        return limbs;
    };

    /// @brief Copies a limb list into independent storage.
    let copy_limbs = func(a: uint32[list]) -> uint32[list] {
        last limbs: uint32[list] = [];
        for (let i = 0; i < a.length; i++) {
            limbs.append(a[i]);
        }
        return limbs;
    };

    /// @brief Drops zero limbs at the top of a list this module just built.
    let trim = func(limbs: uint32[list]) -> uint32[list] {
        while (limbs.length > 0 && limbs[limbs.length - 1] == 0) {
            limbs.remove_at(limbs.length - 1);
        }
        return limbs;
    };

    /// @brief Limbs from..to-1 of a, trimmed.
    let slice_limbs = func(a: uint32[list], from: int, to: int) -> uint32[list] {
        last limbs: uint32[list] = [];
        if (to > a.length) {
            to = a.length;
        }
        for (let i = from; i < to; i++) {
            limbs.append(a[i]);
        }
        return trim(limbs);
    };

    /// @brief Counts leading zero bits in one 32-bit limb.
    let leading_zeros = func(limb: uint32) -> int {
        if (limb == 0) {
            return 32;
        }
        let count = 0;
        while ((limb & 2147483648) == 0) {
            limb <<= 1;
            count++;
        }
        return count;
    };

    /// @brief -1, 0, or 1 as a is below, equal to, or above b.
    let compare_magnitudes = func(a: uint32[list], b: uint32[list]) -> int {
        if (a.length != b.length) {
            if (a.length < b.length) {
                return -1;
            }
            return 1;
        }
        for (let i = a.length - 1; i >= 0; i--) {
            if (a[i] != b[i]) {
                if (a[i] < b[i]) {
                    return -1;
                }
                return 1;
            }
        }
        return 0;
    };

    /// @brief Adds magnitudes in base 2^32 and propagates the carry.
    let add_magnitudes = func(a: uint32[list], b: uint32[list]) -> uint32[list] {
        if (a.length < b.length) {
            last swap = a;
            a = b;
            b = swap;
        }
        check_limbs(a.length);
        last sum: uint32[list] = [];
        let carry: uint64 = 0;
        for (let i = 0; i < a.length; i++) {
            let t = (a[i] as uint64) + carry;
            if (i < b.length) {
                t += (b[i] as uint64);
            }
            sum.append((t & Mask) as uint32);
            carry = t >> 32;
        }
        if (carry != 0) {
            sum.append(carry as uint32);
        }
        return sum;
    };

    /// @brief a - b for a >= b.
    let subtract_magnitudes = func(a: uint32[list], b: uint32[list]) -> uint32[list] {
        last difference: uint32[list] = [];
        let borrow: uint64 = 0;
        for (let i = 0; i < a.length; i++) {
            last x = a[i] as uint64;
            let y = borrow;
            if (i < b.length) {
                y += (b[i] as uint64);
            }
            if (x >= y) {
                difference.append((x - y) as uint32);
                borrow = 0;
            } else {
                difference.append((x + Base - y) as uint32);
                borrow = 1;
            }
        }
        return trim(difference);
    };

    /// @brief sa * a + sb * b.
    let signed_sum = func(sa: int, a: uint32[list], sb: int, b: uint32[list]) -> BigInteger {
        if (sb == 0) {
            return new(sa, a);
        }
        if (sa == 0) {
            return new(sb, b);
        }
        if (sa == sb) {
            return new(sa, add_magnitudes(a, b));
        }
        last c = compare_magnitudes(a, b);
        if (c == 0) {
            return new(0, []);
        }
        if (c > 0) {
            return new(sa, subtract_magnitudes(a, b));
        }
        return new(sb, subtract_magnitudes(b, a));
    };

    /// @brief Dispatches to the schoolbook or Karatsuba multiplication algorithm.
    let multiply_magnitudes = func(a: uint32[list], b: uint32[list]) -> uint32[list] {
        last empty: uint32[list] = [];
        if (a.length == 0 || b.length == 0) {
            return empty;
        }
        if (a.length + b.length - 1 > MaxLimbs) {
            trap_with_message("invalid argument: magnitude too large");
        }
        if (a.length >= KaratsubaLimbs && b.length >= KaratsubaLimbs) {
            return karatsuba(a, b);
        }
        return schoolbook(a, b);
    };

    /// @brief Multiplies magnitudes using the schoolbook algorithm.
    let schoolbook = func(a: uint32[list], b: uint32[list]) -> uint32[list] {
        last product = zeros(a.length + b.length);
        for (let i = 0; i < a.length; i++) {
            last ai = a[i] as uint64;
            if (ai != 0) {
                let carry: uint64 = 0;
                for (let j = 0; j < b.length; j++) {
                    last t = ai * (b[j] as uint64) + (product[i + j] as uint64) + carry;
                    product[i + j] = (t & Mask) as uint32;
                    carry = t >> 32;
                }
                product[i + b.length] = carry as uint32;
            }
        }
        return trim(product);
    };

    /// @brief Splits both operands at half of the larger length: (a1 B + a0)(b1 B + b0) = z2 B^2 + z1 B + z0
    /// with z1 = (a0 + a1)(b0 + b1) - z0 - z2.
    let karatsuba = func(a: uint32[list], b: uint32[list]) -> uint32[list] {
        let half = a.length;
        if (b.length > half) {
            half = b.length;
        }
        half /= 2;
        last a0 = slice_limbs(a, 0, half);
        last a1 = slice_limbs(a, half, a.length);
        last b0 = slice_limbs(b, 0, half);
        last b1 = slice_limbs(b, half, b.length);
        last z0 = multiply_magnitudes(a0, b0);
        last z2 = multiply_magnitudes(a1, b1);
        last middle = multiply_magnitudes(add_magnitudes(a0, a1), add_magnitudes(b0, b1));
        last z1 = subtract_magnitudes(subtract_magnitudes(middle, z0), z2);
        last product = zeros(a.length + b.length + 1);
        add_into(product, z0, 0);
        add_into(product, z1, half);
        add_into(product, z2, 2 * half);
        return trim(product);
    };

    /// @brief target += source * B^offset, in place on a list built here; target is long enough for the sum.
    let add_into = func(target: uint32[list], source: uint32[list], offset: int) {
        let carry: uint64 = 0;
        let i = 0;
        while (i < source.length || carry != 0) {
            let t = (target[offset + i] as uint64) + carry;
            if (i < source.length) {
                t += (source[i] as uint64);
            }
            target[offset + i] = (t & Mask) as uint32;
            carry = t >> 32;
            i++;
        }
    };

    /// @brief limbs = limbs * factor + addend, in place on a list built here.
    let multiply_add_in_place = func(limbs: uint32[list], factor: uint32, addend: uint32) {
        let carry = addend as uint64;
        last f = factor as uint64;
        for (let i = 0; i < limbs.length; i++) {
            last t = (limbs[i] as uint64) * f + carry;
            limbs[i] = (t & Mask) as uint32;
            carry = t >> 32;
        }
        if (carry != 0) {
            limbs.append(carry as uint32);
            check_limbs(limbs.length);
        }
    };

    /// @brief Shifts an unsigned magnitude left by a nonnegative bit count.
    let shift_left_magnitude = func(a: uint32[list], n: int) -> uint32[list] {
        last limb_shift = n / 32;
        last bit_shift = n % 32;
        if (a.length + limb_shift > MaxLimbs) {
            trap_with_message("invalid argument: magnitude too large");
        }
        last shifted = zeros(limb_shift);
        if (bit_shift == 0) {
            for (let i = 0; i < a.length; i++) {
                shifted.append(a[i]);
            }
            return shifted;
        }
        let carry: uint32 = 0;
        for (let i = 0; i < a.length; i++) {
            shifted.append((a[i] << bit_shift) | carry);
            carry = a[i] >> (32 - bit_shift);
        }
        if (carry != 0) {
            shifted.append(carry);
        }
        return shifted;
    };

    /// @brief [floor(a / 2^n), whether a one bit was shifted out].
    let shift_right_magnitude = func(a: uint32[list], n: int) -> [uint32[list], bool] {
        last limb_shift = n / 32;
        last bit_shift = n % 32;
        last shifted: uint32[list] = [];
        if (limb_shift >= a.length) {
            return [shifted, a.length > 0];
        }
        let lost = false;
        for (let i = 0; i < limb_shift; i++) {
            if (a[i] != 0) {
                lost = true;
            }
        }
        if (bit_shift == 0) {
            for (let i = limb_shift; i < a.length; i++) {
                shifted.append(a[i]);
            }
            return [shifted, lost];
        }
        last low_mask = ((1 as uint32) << bit_shift) - 1;
        if ((a[limb_shift] & low_mask) != 0) {
            lost = true;
        }
        for (let i = limb_shift; i < a.length; i++) {
            let limb = a[i] >> bit_shift;
            if (i + 1 < a.length) {
                limb |= (a[i + 1] << (32 - bit_shift));
            }
            shifted.append(limb);
        }
        return [trim(shifted), lost];
    };

    /// @brief Short division by one nonzero limb: [quotient, remainder].
    let divide_by_limb = func(a: uint32[list], divisor: uint32) -> [uint32[list], uint32] {
        last quotient = zeros(a.length);
        last d = divisor as uint64;
        let rest: uint64 = 0;
        for (let i = a.length - 1; i >= 0; i--) {
            last current = (rest << 32) | (a[i] as uint64);
            quotient[i] = (current / d) as uint32;
            rest = current % d;
        }
        return [trim(quotient), rest as uint32];
    };

    /// @brief limbs = limbs / divisor in place on a list built here, dropping zero limbs at the top; returns
    /// the remainder.
    let divide_in_place = func(limbs: uint32[list], divisor: uint32) -> uint32 {
        last d = divisor as uint64;
        let rest: uint64 = 0;
        for (let i = limbs.length - 1; i >= 0; i--) {
            last current = (rest << 32) | (limbs[i] as uint64);
            limbs[i] = (current / d) as uint32;
            rest = current % d;
        }
        trim(limbs);
        return rest as uint32;
    };

    /// @brief [a / b, a % b] for b nonzero.
    let divide_magnitudes = func(a: uint32[list], b: uint32[list]) -> [uint32[list], uint32[list]] {
        last empty: uint32[list] = [];
        if (b.length == 0) {
            // Unreachable from the public members, which divide by the
            // divisor's sign first; this division traps the same way.
            let _ = a.length / b.length;
        }
        last c = compare_magnitudes(a, b);
        if (c < 0) {
            return [empty, a];
        }
        if (c == 0) {
            last unit: uint32[list] = [1];
            return [unit, empty];
        }
        if (b.length == 1) {
            let [quotient, rest] = divide_by_limb(a, b[0]);
            return [quotient, limbs_of(rest as uint64)];
        }
        return knuth_divide(a, b);
    };

    /// @brief Knuth's Algorithm D (TAOCP volume 2, 4.3.1) in base 2^32 for b.length >= 2 and a >= b.
    let knuth_divide = func(a: uint32[list], b: uint32[list]) -> [uint32[list], uint32[list]] {
        last n = b.length;
        last m = a.length - n;
        // D1: normalize so the divisor's top limb has its high bit set.
        last s = leading_zeros(b[n - 1]);
        last v = shift_left_magnitude(b, s);
        last u = shift_left_magnitude(a, s);
        while (u.length < a.length + 1) {
            u.append(0);
        }
        last quotient = zeros(m + 1);
        last top = v[n - 1] as uint64;
        last next = v[n - 2] as uint64;
        for (let j = m; j >= 0; j--) {
            // D3: estimate qhat from the top two limbs and correct it with
            // the third, so it is at most one too large.
            last numerator = ((u[j + n] as uint64) << 32) | (u[j + n - 1] as uint64);
            let qhat = numerator / top;
            let rhat = numerator % top;
            while (qhat >= Base || qhat * next > ((rhat << 32) | (u[j + n - 2] as uint64))) {
                qhat--;
                rhat += top;
                if (rhat >= Base) {
                    break;
                }
            }
            // D4: multiply and subtract qhat * v from u[j .. j+n].
            let borrow: uint64 = 0;
            let carry: uint64 = 0;
            for (let i = 0; i < n; i++) {
                last p = qhat * (v[i] as uint64) + carry;
                carry = p >> 32;
                last low = (p & Mask) + borrow;
                last x = u[i + j] as uint64;
                if (x >= low) {
                    u[i + j] = (x - low) as uint32;
                    borrow = 0;
                } else {
                    u[i + j] = (x + Base - low) as uint32;
                    borrow = 1;
                }
            }
            last x = u[j + n] as uint64;
            last needed = carry + borrow;
            last negative = x < needed;
            if (negative) {
                u[j + n] = (x + Base - needed) as uint32;
            } else {
                u[j + n] = (x - needed) as uint32;
            }
            // D6: add back when qhat was one too large.
            if (negative) {
                qhat--;
                let back: uint64 = 0;
                for (let i = 0; i < n; i++) {
                    last t = (u[i + j] as uint64) + (v[i] as uint64) + back;
                    u[i + j] = (t & Mask) as uint32;
                    back = t >> 32;
                }
                u[j + n] = (((u[j + n] as uint64) + back) & Mask) as uint32;
            }
            quotient[j] = qhat as uint32;
        }
        // D8: the remainder is u[0 .. n-1] shifted back.
        let [rest, lost] = shift_right_magnitude(slice_limbs(u, 0, n), s);
        return [trim(quotient), rest];
    };

    /// @brief The text of sign * magnitude in a radix from 2 through 36: repeated division by the largest power
    /// of the radix below 2^32 (10^9 for decimal), each chunk giving that many digits, least significant first;
    /// the top chunk has no leading zeros.
    let magnitude_text = func(sign: int, magnitude: uint32[list], radix: int) -> string {
        if (sign == 0) {
            return "0";
        }
        let [chunk_digits, chunk] = radix_chunk(radix);
        last base = radix as uint32;
        last reversed: uint8[list] = [];
        last rest = copy_limbs(magnitude);
        while (rest.length > 0) {
            let value = divide_in_place(rest, chunk);
            for (let i = 0; i < chunk_digits; i++) {
                if (rest.length == 0 && value == 0) {
                    break;
                }
                last digit = value % base;
                if (digit < 10) {
                    reversed.append((digit + 48) as uint8);
                } else {
                    reversed.append((digit + 87) as uint8);
                }
                value /= base;
            }
        }
        return integer_text.digits_text(reversed, sign < 0);
    };

    /// @brief [k, radix^k] for the largest k with radix^k below 2^32.
    let radix_chunk = func(radix: int) -> [int, uint32] {
        last r = radix as uint64;
        let power: uint64 = r;
        let digits = 1;
        while (power * r < Base) {
            power *= r;
            digits++;
        }
        return [digits, power as uint32];
    };
);
