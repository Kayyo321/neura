// Trigonometric kernels and argument reduction: a port of fdlibm 5.3's
// k_sin.c, k_cos.c, k_tan.c, e_rem_pio2.c, and k_rem_pio2.c, operation for
// operation (Stdlib.md section 10.1). Hexadecimal spellings in comments give
// fdlibm's constants; the Neura source writes them in decimal.
//
// ====================================================
// Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
//
// Developed at SunSoft, a Sun Microsystems, Inc. business.
// Permission to use, copy, modify, and distribute this
// software is freely granted, provided that this notice
// is preserved.
// ====================================================
//
// k_tan.c: Copyright 2004 Sun Microsystems, Inc. All Rights Reserved.
// Permission to use, copy, modify, and distribute this software is freely
// granted, provided that this notice is preserved.
let words = import:Std.Math.Internal.Words;

export let Trig = module (
    // __kernel_sin: sin(x + y) for |x| <= pi/4, where y is the tail of x.
    // iy is 0 when y is known to be zero.
    export let sin_kernel = func(x: float64, y: float64, iy: int) -> float64 {
        let half = 0.5;
        let S1 = float64.from_bits(13818544856648471881); // 0xBFC5555555555549 -1.66666666666666324348e-01
        let S2 = float64.from_bits(4575957461383575718); // 0x3F8111111110F8A6 8.33333333332248946124e-03
        let S3 = float64.from_bits(13774824197404582357); // 0xBF2A01A019C161D5 -1.98412698298579493134e-04
        let S4 = float64.from_bits(4523617212983017085); // 0x3EC71DE357B1FE7D 2.75573137070700676789e-06
        let S5 = float64.from_bits(13716528393433619691); // 0xBE5AE5E68A2B9CEB -2.50507602534068634195e-08
        let S6 = float64.from_bits(4460209850635244924); // 0x3DE5D93A5ACFD57C 1.58969099521155010221e-10
        let ix = words.high(x) & 2147483647; // 0x7fffffff
        if (ix < 1044381696) { // 0x3e400000 |x| < 2**-27; (int)x is 0
            return x;
        }
        let z = x * x;
        let v = z * x;
        let r = S2 + z * (S3 + z * (S4 + z * (S5 + z * S6)));
        if (iy == 0) {
            return x + v * (S1 + z * r);
        }
        return x - ((z * (half * y - v * r) - y) - v * S1);
    };

    // __kernel_cos: cos(x + y) for |x| <= pi/4.
    export let cos_kernel = func(x: float64, y: float64) -> float64 {
        let one = 1.0;
        let C1 = float64.from_bits(4586165620538955084); // 0x3FA555555555554C 4.16666666666666019037e-02
        let C2 = float64.from_bits(13787419979223748983); // 0xBF56C16C16C15177 -1.38888888888741095749e-03
        let C3 = float64.from_bits(4537941361668330896); // 0x3EFA01A019CB1590 2.48015872894767294178e-05
        let C4 = float64.from_bits(13732177093731308205); // 0xBE927E4F809C52AD -2.75573143513906633035e-07
        let C5 = float64.from_bits(4477121870137962948); // 0x3E21EE9EBDB4B1C4 2.08757232129817482790e-09
        let C6 = float64.from_bits(13666448951086692564); // 0xBDA8FAE9BE8838D4 -1.13596475577881948265e-11
        let ix = words.high(x) & 2147483647; // 0x7fffffff
        if (ix < 1044381696) { // 0x3e400000 |x| < 2**-27; (int)x is 0
            return one;
        }
        let z = x * x;
        let r = z * (C1 + z * (C2 + z * (C3 + z * (C4 + z * (C5 + z * C6)))));
        if (ix < 1070805811) { // 0x3FD33333 |x| < 0.3
            return one - (0.5 * z - (z * r - x * y));
        }
        let qx = 0.28125;
        if (ix <= 1072234496) { // 0x3fe90000 x <= 0.78125: qx = x/4 chopped
            qx = words.from_words(ix - 2097152, 0); // 0x00200000
        }
        let hz = 0.5 * z - qx;
        let a = one - qx;
        return a - (hz - (z * r - x * y));
    };

    // __kernel_tan: tan(x + y) for |x| <= pi/4 when iy is 1, and
    // -1/tan(x + y) when iy is -1.
    export let tan_kernel = func(x: float64, y: float64, iy: int) -> float64 {
        let one = 1.0;
        let T0 = float64.from_bits(4599676419421066595); // 0x3FD5555555555563 3.33333333333334091986e-01
        let T1 = float64.from_bits(4593971859893059194); // 0x3FC111111110FE7A 1.33333333333201242699e-01
        let T2 = float64.from_bits(4587938466107703806); // 0x3FABA1BA1BB341FE 5.39682539762260521377e-02
        let T3 = float64.from_bits(4581960672245896759); // 0x3F9664F48406D637 2.18694882948595424599e-02
        let T4 = float64.from_bits(4576262931677611155); // 0x3F8226E3E96E8493 8.86323982359930005737e-03
        let T5 = float64.from_bits(4570429193025094440); // 0x3F6D6D22C9560328 3.59207910759131235356e-03
        let T6 = float64.from_bits(4564358403679355669); // 0x3F57DBC8FEE08315 1.45620945432529025516e-03
        let T7 = float64.from_bits(4558562946408670465); // 0x3F4344D8F2F26501 5.88041240820264096874e-04
        let T8 = float64.from_bits(4553182066015801448); // 0x3F3026F71A8D1068 2.46463134818469906812e-04
        let T9 = float64.from_bits(4545397049192321702); // 0x3F147E88A03792A6 7.81794442939557092300e-05
        let T10 = float64.from_bits(4544897349388904425); // 0x3F12B80F32F0A7E9 7.14072491382608190305e-05
        let T11 = float64.from_bits(13759470804966331251); // 0xBEF375CBDB605373 -1.85586374855275456654e-05
        let T12 = float64.from_bits(4538267711989316308); // 0x3EFB2A7074BF7AD4 2.59073051863633712884e-05
        let pio4 = float64.from_bits(4605249457297304856); // 0x3FE921FB54442D18 7.85398163397448278999e-01
        let pio4lo = float64.from_bits(4359948597267291143); // 0x3C81A62633145C07 3.06161699786838301793e-17
        let hx = words.high(x);
        let ix = hx & 2147483647; // 0x7fffffff
        if (ix < 1043333120) { // 0x3e300000 |x| < 2**-28; (int)x is 0
            if (ix == 0 && words.low(x) == 0 && iy == -1) {
                return one / words.abs(x);
            }
            if (iy == 1) {
                return x;
            }
            // compute -1 / (x+y) carefully
            let w = x + y;
            let z = words.with_low(w, 0);
            let v = y - (z - x);
            let a = -one / w;
            let t = words.with_low(a, 0);
            let s = one + t * z;
            return t + a * (s + t * v);
        }
        if (ix >= 1072010280) { // 0x3FE59428 |x| >= 0.6744
            if (hx < 0) {
                x = -x;
                y = -y;
            }
            let z = pio4 - x;
            let w = pio4lo - y;
            x = z + w;
            y = 0.0;
        }
        let z = x * x;
        let w = z * z;
        // Break x^5*(T[1]+x^2*T[2]+...) into
        // x^5(T[1]+x^4*T[3]+...+x^20*T[11]) +
        // x^5(x^2*(T[2]+x^4*T[4]+...+x^22*[T12]))
        let r = T1 + w * (T3 + w * (T5 + w * (T7 + w * (T9 + w * T11))));
        let v = z * (T2 + w * (T4 + w * (T6 + w * (T8 + w * (T10 + w * T12)))));
        let s = z * x;
        r = y + z * (s * (r + v) + y);
        r = r + T0 * s;
        w = x + r;
        if (ix >= 1072010280) { // 0x3FE59428
            v = iy as float64;
            return ((1 - ((hx >> 30) & 2)) as float64) * (v - 2.0 * (x - (w * w / (w + v) - r)));
        }
        if (iy == 1) {
            return w;
        }
        // compute -1.0 / (x+r) accurately
        z = words.with_low(w, 0);
        v = r - (z - x);
        let a = -1.0 / w;
        let t = words.with_low(a, 0);
        s = 1.0 + t * z;
        return t + a * (s + t * v);
    };

    // __ieee754_rem_pio2: returns [n, y0, y1] with x - n*pi/2 = y0 + y1 and
    // |y0 + y1| <= pi/4 (n mod 8 for huge arguments, which suffices).
    export let rem_pio2 = func(x: float64) -> [int, float64, float64] {
        let half = 0.5;
        let two24 = float64.from_bits(4715268809856909312); // 0x4170000000000000 1.67772160000000000000e+07
        let invpio2 = float64.from_bits(4603909380684499075); // 0x3FE45F306DC9C883 6.36619772367581382433e-01
        let pio2_1 = float64.from_bits(4609753056924401664); // 0x3FF921FB54400000 1.57079632673412561417e+00
        let pio2_1t = float64.from_bits(4454258360616903473); // 0x3DD0B4611A626331 6.07710050650619224932e-11
        let pio2_2 = float64.from_bits(4454258360616747008); // 0x3DD0B4611A600000 6.07710050630396597660e-11
        let pio2_2t = float64.from_bits(4297306550709743731); // 0x3BA3198A2E037073 2.02226624879595063154e-21
        let pio2_3 = float64.from_bits(4297306550709518336); // 0x3BA3198A2E000000 2.02226624871116645580e-21
        let pio2_3t = float64.from_bits(4142048980368378305); // 0x397B839A252049C1 8.47842766036889956997e-32
        let hx = words.high(x);
        let ix = hx & 2147483647; // 0x7fffffff
        if (ix <= 1072243195) { // 0x3fe921fb |x| ~<= pi/4, no need for reduction
            return [0, x, 0.0];
        }
        if (ix < 1073928572) { // 0x4002d97c |x| < 3pi/4, special case with n=+-1
            if (hx > 0) {
                let z = x - pio2_1;
                if (ix != 1073291771) { // 0x3ff921fb 33+53 bit pi is good enough
                    let y0 = z - pio2_1t;
                    return [1, y0, (z - y0) - pio2_1t];
                }
                // near pi/2, use 33+33+53 bit pi
                z = z - pio2_2;
                let y0 = z - pio2_2t;
                return [1, y0, (z - y0) - pio2_2t];
            }
            let z = x + pio2_1;
            if (ix != 1073291771) { // 0x3ff921fb
                let y0 = z + pio2_1t;
                return [-1, y0, (z - y0) + pio2_1t];
            }
            z = z + pio2_2;
            let y0 = z + pio2_2t;
            return [-1, y0, (z - y0) + pio2_2t];
        }
        if (ix <= 1094263291) { // 0x413921fb |x| ~<= 2^19*(pi/2), medium size
            let t = words.abs(x);
            let n = (t * invpio2 + half) as int;
            let fn = n as float64;
            let r = t - fn * pio2_1;
            let w = fn * pio2_1t; // 1st round good to 85 bit
            let y0 = 0.0;
            if (n < 32 && ix != quadrant_high_word(n - 1)) {
                y0 = r - w; // quick check no cancellation
            } else {
                let j = ix >> 20;
                y0 = r - w;
                let i = j - ((words.high(y0) >> 20) & 2047); // 0x7ff
                if (i > 16) { // 2nd iteration needed, good to 118
                    t = r;
                    w = fn * pio2_2;
                    r = t - w;
                    w = fn * pio2_2t - ((t - r) - w);
                    y0 = r - w;
                    i = j - ((words.high(y0) >> 20) & 2047); // 0x7ff
                    if (i > 49) { // 3rd iteration need, 151 bits acc
                        t = r;
                        w = fn * pio2_3;
                        r = t - w;
                        w = fn * pio2_3t - ((t - r) - w);
                        y0 = r - w;
                    }
                }
            }
            let y1 = (r - y0) - w;
            if (hx < 0) {
                return [-n, -y0, -y1];
            }
            return [n, y0, y1];
        }
        // all other (large) arguments
        if (ix >= 2146435072) { // 0x7ff00000 x is inf or NaN
            let nan = x - x;
            return [0, nan, nan];
        }
        // set z = scalbn(|x|,ilogb(x)-23)
        let e0 = (ix >> 20) - 1046; // e0 = ilogb(z)-23;
        let z = words.from_words(ix - (e0 << 20), words.low(x));
        let tx: float64[list] = [];
        for (let i = 0; i < 2; i = i + 1) {
            let chunk = (z as int) as float64;
            tx.append(chunk);
            z = (z - chunk) * two24;
        }
        tx.append(z);
        let nx = 3;
        while (tx[nx - 1] == 0.0) { // skip zero term
            nx = nx - 1;
        }
        let [n, y0, y1] = rem_pio2_kernel(tx, e0, nx);
        if (hx < 0) {
            return [-n, -y0, -y1];
        }
        return [n, y0, y1];
    };

    // npio2_hw[i]: the high word of (i + 1)*pi/2.
    let quadrant_high_word = func(i: int) -> int {
        let table: int[] = [
            1073291771, 1074340347, 1074977148, 1075388923, 1075800698, 1076025724, // 0x3FF921FB 0x400921FB 0x4012D97C 0x401921FB 0x401F6A7A 0x4022D97C
            1076231611, 1076437499, 1076643386, 1076849274, 1076971356, 1077074300, // 0x4025FDBB 0x402921FB 0x402C463A 0x402F6A7A 0x4031475C 0x4032D97C
            1077177244, 1077280187, 1077383131, 1077486075, 1077589019, 1077691962, // 0x40346B9C 0x4035FDBB 0x40378FDB 0x403921FB 0x403AB41B 0x403C463A
            1077794906, 1077897850, 1077968460, 1078019932, 1078071404, 1078122876, // 0x403DD85A 0x403F6A7A 0x40407E4C 0x4041475C 0x4042106C 0x4042D97C
            1078174348, 1078225820, 1078277292, 1078328763, 1078380235, 1078431707, // 0x4043A28C 0x40446B9C 0x404534AC 0x4045FDBB 0x4046C6CB 0x40478FDB
            1078483179, 1078534651 // 0x404858EB 0x404921FB
        ];
        return table[i];
    };

    // two_over_pi: 2/pi in 24-bit chunks, most significant first.
    let two_over_pi = func() -> int[list] {
        let table: int[list] = [
            10680707, 7228996, 1387004, 2578385, 16069853, 12639074, // 0xA2F983 0x6E4E44 0x1529FC 0x2757D1 0xF534DD 0xC0DB62
            9804092, 4427841, 16666979, 11263675, 12935607, 2387514, // 0x95993C 0x439041 0xFE5163 0xABDEBB 0xC561B7 0x246E3A
            4345298, 14681673, 3074569, 13734428, 16653803, 1880361, // 0x424DD2 0xE00649 0x2EEA09 0xD1921C 0xFE1DEB 0x1CB129
            10960616, 8533493, 3062596, 8710556, 7349940, 6258241, // 0xA73EE8 0x8235F5 0x2EBB44 0x84E99C 0x7026B4 0x5F7E41
            3772886, 3769171, 3798172, 8675211, 12450088, 3874808, // 0x3991D6 0x398353 0x39F49C 0x845F8B 0xBDF928 0x3B1FF8
            9961438, 366607, 15675153, 9132554, 7151469, 3571407, // 0x97FFDE 0x05980F 0xEF2F11 0x8B5A0A 0x6D1F6D 0x367ECF
            2607881, 12013382, 4155038, 6285869, 7677882, 13102053, // 0x27CB09 0xB74F46 0x3F669E 0x5FEA2D 0x7527BA 0xC7EBE5
            15825725, 473591, 9065106, 15363067, 6271263, 9264392, // 0xF17B3D 0x0739F7 0x8A5292 0xEA6BFB 0x5FB11F 0x8D5D08
            5636912, 4652155, 7056368, 13614112, 10155062, 1944035, // 0x560330 0x46FC7B 0x6BABF0 0xCFBC20 0x9AF436 0x1DA9E3
            9527646, 15080200, 6658437, 6231200, 6832269, 16767104, // 0x91615E 0xE61B08 0x659985 0x5F14A0 0x68408D 0xFFD880
            5075751, 3212806, 1398474, 7579849, 6349435, 12618859 // 0x4D7327 0x310606 0x1556CA 0x73A8C9 0x60E27B 0xC08C6B
        ];
        return table;
    };

    // PIo2: pi/2 in 24-bit chunks, as float64 values.
    let pio2_chunks = func() -> float64[list] {
        let table: float64[list] = [
            float64.from_bits(4609753056584663040), // 0x3FF921FB40000000 1.57079625129699707031e+00
            float64.from_bits(4500296887714185216), // 0x3E74442D00000000 7.54978941586159635335e-08
            float64.from_bits(4393339057296375808), // 0x3CF8469880000000 5.39030252995776476554e-15
            float64.from_bits(4285399695318056960), // 0x3B78CC5160000000 3.28200341580791294123e-22
            float64.from_bits(4174867106174599168), // 0x39F01B8380000000 1.27065575308067607349e-29
            float64.from_bits(4069606033725587456), // 0x387A252040000000 1.22933308981111328932e-36
            float64.from_bits(3955147982449410048), // 0x36E3822280000000 2.73370053816464559624e-44
            float64.from_bits(3848874662444400640) // 0x3569F31D00000000 2.16741683877804819444e-51
        ];
        return table;
    };

    // floor of a non-negative value below 2^63; exact.
    let floor_nonnegative = func(v: float64) -> float64 {
        return (v as int64) as float64;
    };

    // __kernel_rem_pio2 with prec 2 (53-bit result in y0 + y1) and the
    // two_over_pi table. x holds nx 24-bit chunks of |input| scaled by
    // 2^-e0; returns [n mod 8, y0, y1].
    let rem_pio2_kernel = func(x: float64[list], e0: int, nx: int) -> [int, float64, float64] {
        let two24 = float64.from_bits(4715268809856909312); // 0x4170000000000000 1.67772160000000000000e+07
        let twon24 = float64.from_bits(4499096027743125504); // 0x3E70000000000000 5.96046447753906250000e-08
        let ipio2 = two_over_pi();
        let pio2 = pio2_chunks();
        let jk = 4; // init_jk[2]
        let jp = jk;
        // determine jx,jv,q0, note that 3>q0
        let jx = nx - 1;
        let jv = (e0 - 3) / 24;
        if (jv < 0) {
            jv = 0;
        }
        let q0 = e0 - 24 * (jv + 1);
        // set up f[0] to f[jx+jk] where f[jx+jk] = ipio2[jv+jk]
        let f: float64[list] = [];
        let iq: int[list] = [];
        let q: float64[list] = [];
        let fq: float64[list] = [];
        for (let i = 0; i < 20; i = i + 1) {
            f.append(0.0);
            iq.append(0);
            q.append(0.0);
            fq.append(0.0);
        }
        let j = jv - jx;
        let m = jx + jk;
        for (let i = 0; i <= m; i = i + 1) {
            if (j >= 0) {
                f[i] = ipio2[j] as float64;
            }
            j = j + 1;
        }
        // compute q[0],q[1],...q[jk]
        for (let i = 0; i <= jk; i = i + 1) {
            let fw = 0.0;
            for (let k = 0; k <= jx; k = k + 1) {
                fw = fw + x[k] * f[jx + i - k];
            }
            q[i] = fw;
        }
        let jz = jk;
        let n = 0;
        let ih = 0;
        let z = 0.0;
        let carry = 0;
        let recompute = true;
        while (recompute) {
            recompute = false;
            // distill q[] into iq[] reversingly
            let i = 0;
            j = jz;
            z = q[jz];
            while (j > 0) {
                let fw = ((twon24 * z) as int) as float64;
                iq[i] = (z - two24 * fw) as int;
                z = q[j - 1] + fw;
                i = i + 1;
                j = j - 1;
            }
            // compute n
            z = words.scalbn(z, q0); // actual value of z
            z = z - 8.0 * floor_nonnegative(z * 0.125); // trim off integer >= 8
            n = z as int;
            z = z - (n as float64);
            ih = 0;
            if (q0 > 0) { // need iq[jz-1] to determine n
                i = iq[jz - 1] >> (24 - q0);
                n = n + i;
                iq[jz - 1] = iq[jz - 1] - (i << (24 - q0));
                ih = iq[jz - 1] >> (23 - q0);
            } else if (q0 == 0) {
                ih = iq[jz - 1] >> 23;
            } else if (z >= 0.5) {
                ih = 2;
            }
            if (ih > 0) { // q > 0.5
                n = n + 1;
                carry = 0;
                for (let k = 0; k < jz; k = k + 1) { // compute 1-q
                    let v = iq[k];
                    if (carry == 0) {
                        if (v != 0) {
                            carry = 1;
                            iq[k] = 16777216 - v; // 0x1000000
                        }
                    } else {
                        iq[k] = 16777215 - v; // 0xffffff
                    }
                }
                if (q0 == 1) { // rare case: chance is 1 in 12
                    iq[jz - 1] = iq[jz - 1] & 8388607; // 0x7fffff
                } else if (q0 == 2) {
                    iq[jz - 1] = iq[jz - 1] & 4194303; // 0x3fffff
                }
                if (ih == 2) {
                    z = 1.0 - z;
                    if (carry != 0) {
                        z = z - words.scalbn(1.0, q0);
                    }
                }
            }
            // check if recomputation is needed
            if (z == 0.0) {
                let bits = 0;
                for (let k = jz - 1; k >= jk; k = k - 1) {
                    bits = bits | iq[k];
                }
                if (bits == 0) { // need recomputation
                    let k = 1;
                    while (iq[jk - k] == 0) { // k = no. of terms needed
                        k = k + 1;
                    }
                    for (let t = jz + 1; t <= jz + k; t = t + 1) { // add q[jz+1] to q[jz+k]
                        f[jx + t] = ipio2[jv + t] as float64;
                        let fw = 0.0;
                        for (let s = 0; s <= jx; s = s + 1) {
                            fw = fw + x[s] * f[jx + t - s];
                        }
                        q[t] = fw;
                    }
                    jz = jz + k;
                    recompute = true;
                }
            }
        }
        // chop off zero terms
        if (z == 0.0) {
            jz = jz - 1;
            q0 = q0 - 24;
            while (iq[jz] == 0) {
                jz = jz - 1;
                q0 = q0 - 24;
            }
        } else { // break z into 24-bit if necessary
            z = words.scalbn(z, -q0);
            if (z >= two24) {
                let fw = ((twon24 * z) as int) as float64;
                iq[jz] = (z - two24 * fw) as int;
                jz = jz + 1;
                q0 = q0 + 24;
                iq[jz] = fw as int;
            } else {
                iq[jz] = z as int;
            }
        }
        // convert integer "bit" chunk to floating-point value
        let fw = words.scalbn(1.0, q0);
        for (let i = jz; i >= 0; i = i - 1) {
            q[i] = fw * (iq[i] as float64);
            fw = fw * twon24;
        }
        // compute PIo2[0,...,jp]*q[jz,...,0]
        for (let i = jz; i >= 0; i = i - 1) {
            fw = 0.0;
            for (let k = 0; k <= jp && k <= jz - i; k = k + 1) {
                fw = fw + pio2[k] * q[i + k];
            }
            fq[jz - i] = fw;
        }
        // compress fq[] into y[]
        fw = 0.0;
        for (let i = jz; i >= 0; i = i - 1) {
            fw = fw + fq[i];
        }
        let y0 = fw;
        if (ih != 0) {
            y0 = -fw;
        }
        fw = fq[0] - fw;
        for (let i = 1; i <= jz; i = i + 1) {
            fw = fw + fq[i];
        }
        let y1 = fw;
        if (ih != 0) {
            y1 = -fw;
        }
        return [n & 7, y0, y1];
    };
);
