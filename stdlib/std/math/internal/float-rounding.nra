// Correct rounding of a binary value to float64, shared by
// BigInteger.to_float64 and BigDecimal.to_float64 (Stdlib.md sections 10.2
// and 10.3).
export let FloatRounding = module (
    // The float64 nearest to (-1)^negative * (top + s) * 2^exponent, ties to
    // even, where s is 0 when `sticky` is false and some value strictly
    // between 0 and 1 when it is true (bits below `top` that are not all
    // zero). Overflow gives an infinity and underflow a subnormal or a zero
    // of the same sign. `top` should hold at least 55 significant bits when
    // `sticky` is set, so that the sticky bits lie below the rounding bit.
    export let compose = func(bool negative, uint64 top, int exponent, bool sticky) -> float64 {
        let sign: uint64 = 0;
        if (negative) {
            sign = 9223372036854775808;
        }
        if (top == 0) {
            return float64.from_bits(sign);
        }
        // Normalize so that bit 63 is set; value = top * 2^exponent.
        let e = exponent as int64;
        while ((top >> 63) == 0) {
            top = top << 1;
            e = e - 1;
        }
        let binade = e + 63; // the value lies in [2^binade, 2^(binade + 1))
        if (binade > 1023) {
            return float64.from_bits(sign | 9218868437227405312);
        }
        // Keep 53 bits for a normal result, fewer for a subnormal one.
        let shift: int64 = 11;
        if (binade < -1022) {
            shift = 11 + (-1022 - binade);
        }
        let mantissa: uint64 = 0;
        let round = false;
        let rest = sticky;
        if (shift > 64) {
            rest = true;
        } else if (shift == 64) {
            round = true;
            rest = rest || (top & 9223372036854775807) != 0;
        } else {
            mantissa = top >> shift;
            round = ((top >> (shift - 1)) & 1) != 0;
            let below = (1 as uint64 << (shift - 1)) - 1;
            rest = rest || (top & below) != 0;
        }
        if (round && (rest || (mantissa & 1) != 0)) {
            mantissa = mantissa + 1;
        }
        if (binade < -1022) {
            // Subnormal encoding; a carry into 2^52 is the smallest normal.
            return float64.from_bits(sign | mantissa);
        }
        // mantissa is 2^52 through 2^53; a carry to 2^53 moves to the next
        // binade, and from the largest binade to infinity.
        let field = ((binade + 1023) as uint64) << 52;
        return float64.from_bits(sign | (field + mantissa - 4503599627370496));
    };
);
