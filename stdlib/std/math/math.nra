            z = words.scalbn(z, n);
        } else {
            z = words.with_high(z, words.high(z) + (n << 20));
        }
        return s * z;
    };

    // s_sin.c
    export let sin = func(x: float64) -> float64 {
        let ix = words.high(x) & 2147483647; // 0x7fffffff
        if (ix <= 1072243195) { // 0x3fe921fb |x| ~< pi/4
            return trig.sin_kernel(x, 0.0, 0);
        }
        if (ix >= 2146435072) { // 0x7ff00000 sin(Inf or NaN) is NaN
            return x - x;
        }
        // argument reduction needed
        let [n, y0, y1] = trig.rem_pio2(x);
        let quadrant = n & 3;
        if (quadrant == 0) {
            return trig.sin_kernel(y0, y1, 1);
        }
        if (quadrant == 1) {
            return trig.cos_kernel(y0, y1);
        }
        if (quadrant == 2) {
            return -trig.sin_kernel(y0, y1, 1);
        }
        return -trig.cos_kernel(y0, y1);
    };

    // s_cos.c
    export let cos = func(x: float64) -> float64 {
        let ix = words.high(x) & 2147483647; // 0x7fffffff
        if (ix <= 1072243195) { // 0x3fe921fb |x| ~< pi/4
            return trig.cos_kernel(x, 0.0);
        }
        if (ix >= 2146435072) { // 0x7ff00000 cos(Inf or NaN) is NaN
            return x - x;
        }
        // argument reduction needed
        let [n, y0, y1] = trig.rem_pio2(x);
        let quadrant = n & 3;
        if (quadrant == 0) {
            return trig.cos_kernel(y0, y1);
        }
        if (quadrant == 1) {
            return -trig.sin_kernel(y0, y1, 1);
        }
        if (quadrant == 2) {
            return -trig.cos_kernel(y0, y1);
        }
        return trig.sin_kernel(y0, y1, 1);
    };

    // s_tan.c
    export let tan = func(x: float64) -> float64 {
        let ix = words.high(x) & 2147483647; // 0x7fffffff
        if (ix <= 1072243195) { // 0x3fe921fb |x| ~< pi/4
            return trig.tan_kernel(x, 0.0, 1);
        }
        if (ix >= 2146435072) { // 0x7ff00000 tan(Inf or NaN) is NaN
            return x - x;
        }
        // argument reduction needed
        let [n, y0, y1] = trig.rem_pio2(x);
        return trig.tan_kernel(y0, y1, 1 - ((n & 1) << 1)); // 1 -- n even, -1 -- n odd
    };

    // R(x^2) of e_asin.c and e_acos.c: p/q.
    let asin_ratio = func(t: float64) -> float64 {
        let pS0 = float64.from_bits(4595172819793696085); // 0x3FC5555555555555 1.66666666666666657415e-01
        let pS1 = float64.from_bits(13822908529170411389); // 0xBFD4D61203EB6F7D -3.25565818622400915405e-01
        let pS2 = float64.from_bits(4596417465768494165); // 0x3FC9C1550E884455 2.01212532134862925881e-01
        let pS3 = float64.from_bits(13809305468778614587); // 0xBFA48228B5688F3B -4.00555345006794114027e-02
        let pS4 = float64.from_bits(4560439845004096136); // 0x3F49EFE07501B288 7.91534994289814532176e-04
        let pS5 = float64.from_bits(4540259411154564873); // 0x3F023DE10DFDF709 3.47933107596021167570e-05
        let qS1 = float64.from_bits(13835966419869248843); // 0xC0033A271C8A2D4B -2.40339491173441421878e+00
        let qS2 = float64.from_bits(4611733184086379208); // 0x40002AE59C598AC8 2.02094576023350569471e+00
        let qS3 = float64.from_bits(13827746767276147033); // 0xBFE6066C1B8D0159 -6.88283971605453293030e-01
        let qS4 = float64.from_bits(4590215604441354882); // 0x3FB3B8C5B12E9282 7.70381505559019352791e-02
        let p = t * (pS0 + t * (pS1 + t * (pS2 + t * (pS3 + t * (pS4 + t * pS5)))));
        let q = 1.0 + t * (qS1 + t * (qS2 + t * (qS3 + t * qS4)));
        return p / q;
    };

    // e_asin.c
    export let asin = func(x: float64) -> float64 {
        let pio2_hi = float64.from_bits(4609753056924675352); // 0x3FF921FB54442D18 1.57079632679489655800e+00
        let pio2_lo = float64.from_bits(4364452196894661639); // 0x3C91A62633145C07 6.12323399573676603587e-17
        let pio4_hi = float64.from_bits(4605249457297304856); // 0x3FE921FB54442D18 7.85398163397448278999e-01
        let hx = words.high(x);
        let ix = hx & 2147483647; // 0x7fffffff
        if (ix >= 1072693248) { // 0x3ff00000 |x|>= 1
            if (ix == 1072693248 && words.low(x) == 0) { // 0x3ff00000 asin(1)=+-pi/2 with inexact
                return x * pio2_hi + x * pio2_lo;
            }
            return (x - x) / (x - x); // asin(|x|>1) is NaN
        }
        if (ix < 1071644672) { // 0x3fe00000 |x|<0.5
            if (ix < 1044381696) { // 0x3e400000 if |x| < 2**-27
                return x;
            }
            let t = x * x;
            let w = asin_ratio(t);
            return x + x * w;
        }
        // 1> |x|>= 0.5
        let w = 1.0 - words.abs(x);
        let t = w * 0.5;
        let r = asin_ratio(t);
        let s = sqrt(t);
        if (ix >= 1072640819) { // 0x3FEF3333 if |x| > 0.975
            t = pio2_hi - (2.0 * (s + s * r) - pio2_lo);
        } else {
            w = words.with_low(s, 0);
            let c = (t - w * w) / (s + w);
            let p = 2.0 * s * r - (pio2_lo - 2.0 * c);
            let q = pio4_hi - 2.0 * w;
            t = pio4_hi - (p - q);
        }
        if (hx > 0) {
            return t;
        }
        return -t;
    };

    // e_acos.c
    export let acos = func(x: float64) -> float64 {
        let pi = float64.from_bits(4614256656552045848); // 0x400921FB54442D18 3.14159265358979311600e+00
        let pio2_hi = float64.from_bits(4609753056924675352); // 0x3FF921FB54442D18 1.57079632679489655800e+00
        let pio2_lo = float64.from_bits(4364452196894661639); // 0x3C91A62633145C07 6.12323399573676603587e-17
        let hx = words.high(x);
        let ix = hx & 2147483647; // 0x7fffffff
        if (ix >= 1072693248) { // 0x3ff00000 |x| >= 1
            if (ix == 1072693248 && words.low(x) == 0) { // 0x3ff00000 |x|==1
                if (hx > 0) { // acos(1) = 0
                    return 0.0;
                }
                return pi + 2.0 * pio2_lo; // acos(-1)= pi
            }
            return (x - x) / (x - x); // acos(|x|>1) is NaN
        }
        if (ix < 1071644672) { // 0x3fe00000 |x| < 0.5
            if (ix <= 1012924416) { // 0x3c600000 if|x|<2**-57
                return pio2_hi + pio2_lo;
            }
            let z = x * x;
            let r = asin_ratio(z);
            return pio2_hi - (x - (pio2_lo - x * r));
        }
        if (hx < 0) { // x < -0.5
            let z = (1.0 + x) * 0.5;
            let s = sqrt(z);
            let r = asin_ratio(z);
            let w = r * s - pio2_lo;
            return pi - 2.0 * (s + w);
        }
        // x > 0.5
        let z = (1.0 - x) * 0.5;
        let s = sqrt(z);
        let df = words.with_low(s, 0);
        let c = (z - df * df) / (s + df);
        let r = asin_ratio(z);
        let w = r * s + c;
        return 2.0 * (df + w);
    };

    // s_atan.c
    export let atan = func(x: float64) -> float64 {
        let aT0 = float64.from_bits(4599676419421066509); // 0x3FD555555555550D 3.33333333333329318027e-01
        let aT1 = float64.from_bits(13819745816549059524); // 0xBFC999999998EBC4 -1.99999999998764832476e-01
        let aT2 = float64.from_bits(4594314991288484863); // 0x3FC24924920083FF 1.42857142725034663711e-01
        let aT3 = float64.from_bits(13816042856347014769); // 0xBFBC71C6FE231671 -1.11111104054623557880e-01
        let aT4 = float64.from_bits(4591215095208222830); // 0x3FB745CDC54C206E 9.09088713343650656196e-02
        let aT5 = float64.from_bits(13813579038447671917); // 0xBFB3B0F2AF749A6D -7.69187620504482999495e-02
        let aT6 = float64.from_bits(4589464229703073105); // 0x3FB10D66A0D03D51 6.66107313738753120669e-02
        let aT7 = float64.from_bits(13811939918460419482); // 0xBFADDE2D52DEFD9A -5.83357013379057348645e-02
        let aT8 = float64.from_bits(4587333258118041067); // 0x3FA97B4B24760DEB 4.97687799461593236017e-02
        let aT9 = float64.from_bits(13808797612367309871); // 0xBFA2B4442C6A6C2F -3.65315727442169155270e-02
        let aT10 = float64.from_bits(4580351289466214929); // 0x3F90AD3AE322DA11 1.62858201153657823623e-02
        let one = 1.0;
        let hx = words.high(x);
        let ix = hx & 2147483647; // 0x7fffffff
        if (ix >= 1141899264) { // 0x44100000 if |x| >= 2^66
            if (ix > 2146435072 || (ix == 2146435072 && words.low(x) != 0)) { // 0x7ff00000 0x7ff00000 NaN
                return x + x;
            }
            let hi = float64.from_bits(4609753056924675352); // 0x3FF921FB54442D18 atan(inf)hi 1.57079632679489655800e+00
            let lo = float64.from_bits(4364452196894661639); // 0x3C91A62633145C07 atan(inf)lo 6.12323399573676603587e-17
            if (hx > 0) {
                return hi + lo;
            }
            return -hi - lo;
        }
        let id = -1;
        if (ix < 1071382528) { // 0x3fdc0000 |x| < 0.4375
            if (ix < 1042284544) { // 0x3e200000 |x| < 2^-29
                return x;
            }
        } else {
            x = words.abs(x);
            if (ix < 1072889856) { // 0x3ff30000 |x| < 1.1875
                if (ix < 1072037888) { // 0x3fe60000 7/16 <=|x|<11/16
                    id = 0;
                    x = (2.0 * x - one) / (2.0 + x);
                } else { // 11/16<=|x|< 19/16
                    id = 1;
                    x = (x - one) / (x + one);
                }
            } else {
                if (ix < 1073971200) { // 0x40038000 |x| < 2.4375
                    id = 2;
                    x = (x - 1.5) / (one + 1.5 * x);
                } else { // 2.4375 <= |x| < 2^66
                    id = 3;
                    x = -1.0 / x;
                }
            }
        }
        // end of argument reduction
        let z = x * x;
        let w = z * z;
        // break sum from i=0 to 10 aT[i]z**(i+1) into odd and even poly
        let s1 = z * (aT0 + w * (aT2 + w * (aT4 + w * (aT6 + w * (aT8 + w * aT10)))));
        let s2 = w * (aT1 + w * (aT3 + w * (aT5 + w * (aT7 + w * aT9))));
        if (id < 0) {
            return x - x * (s1 + s2);
        }
        let hi = 0.0;
        let lo = 0.0;
        if (id == 0) {
            hi = float64.from_bits(4602023952714414927); // 0x3FDDAC670561BB4F atan(0.5)hi 4.63647609000806093515e-01
            lo = float64.from_bits(4357843414468748770); // 0x3C7A2B7F222F65E2 atan(0.5)lo 2.26987774529616870924e-17
        } else if (id == 1) {
            hi = float64.from_bits(4605249457297304856); // 0x3FE921FB54442D18 atan(1.0)hi 7.85398163397448278999e-01
            lo = float64.from_bits(4359948597267291143); // 0x3C81A62633145C07 atan(1.0)lo 3.06161699786838301793e-17
        } else if (id == 2) {
            hi = float64.from_bits(4607027438436873883); // 0x3FEF730BD281F69B atan(1.5)hi 9.82793723247329054082e-01
            lo = float64.from_bits(4354989122426817469); // 0x3C7007887AF0CBBD atan(1.5)lo 1.39033110312309984516e-17
        } else {
            hi = float64.from_bits(4609753056924675352); // 0x3FF921FB54442D18 atan(inf)hi 1.57079632679489655800e+00
            lo = float64.from_bits(4364452196894661639); // 0x3C91A62633145C07 atan(inf)lo 6.12323399573676603587e-17
        }
        z = hi - ((x * (s1 + s2) - lo) - x);
        if (hx < 0) {
            return -z;
        }
        return z;
    };

    // e_atan2.c: the angle of the point (x, y).
    export let atan2 = func(y: float64, x: float64) -> float64 {
        let tiny = 1.0e-300;
        let pi_o_4 = float64.from_bits(4605249457297304856); // 0x3FE921FB54442D18 7.8539816339744827900E-01
        let pi_o_2 = float64.from_bits(4609753056924675352); // 0x3FF921FB54442D18 1.5707963267948965580E+00
        let pi = float64.from_bits(4614256656552045848); // 0x400921FB54442D18 3.1415926535897931160E+00
        let pi_lo = float64.from_bits(4368955796522032135); // 0x3CA1A62633145C07 1.2246467991473531772E-16
        let hx = words.high(x);
        let ix = hx & 2147483647; // 0x7fffffff
        let lx = words.low(x);
        let hy = words.high(y);
        let iy = hy & 2147483647; // 0x7fffffff
        let ly = words.low(y);
        if (ix > 2146435072 || (ix == 2146435072 && lx != 0) || iy > 2146435072 || (iy == 2146435072 && ly != 0)) { // 0x7ff00000 0x7ff00000 0x7ff00000 0x7ff00000
            return x + y; // x or y is NaN
        }
        if (hx == 1072693248 && lx == 0) { // 0x3ff00000 x=1.0
            return atan(y);
        }
        let m = ((hy >> 31) & 1) | ((hx >> 30) & 2); // 2*sign(x)+sign(y)
        // when y = 0
        if (iy == 0 && ly == 0) {
            if (m == 0 || m == 1) { // atan(+-0,+anything)=+-0
                return y;
            }
            if (m == 2) { // atan(+0,-anything) = pi
                return pi + tiny;
            }
            return -pi - tiny; // atan(-0,-anything) =-pi
        }
        // when x = 0
        if (ix == 0 && lx == 0) {
            if (hy < 0) {
                return -pi_o_2 - tiny;
            }
            return pi_o_2 + tiny;
        }
        // when x is INF
        if (ix == 2146435072) { // 0x7ff00000
            if (iy == 2146435072) { // 0x7ff00000
                if (m == 0) { // atan(+INF,+INF)
                    return pi_o_4 + tiny;
                }
                if (m == 1) { // atan(-INF,+INF)
                    return -pi_o_4 - tiny;
                }
                if (m == 2) { // atan(+INF,-INF)
                    return 3.0 * pi_o_4 + tiny;
                }
                return -3.0 * pi_o_4 - tiny; // atan(-INF,-INF)
            }
            if (m == 0) { // atan(+...,+INF)
                return 0.0;
            }
            if (m == 1) { // atan(-...,+INF)
                return -0.0;
            }
            if (m == 2) { // atan(+...,-INF)
                return pi + tiny;
            }
            return -pi - tiny; // atan(-...,-INF)
        }
        // when y is INF
        if (iy == 2146435072) { // 0x7ff00000
            if (hy < 0) {
                return -pi_o_2 - tiny;
            }
            return pi_o_2 + tiny;
        }
        // compute y/x
        let k = (iy - ix) >> 20;
        let z = 0.0;
        if (k > 60) { // |y/x| >  2**60
            z = pi_o_2 + 0.5 * pi_lo;
        } else if (hx < 0 && k < -60) { // |y|/x < -2**60
            z = 0.0;
        } else { // safe to do y/x
            z = atan(words.abs(y / x));
        }
        if (m == 0) { // atan(+,+)
            return z;
        }
        if (m == 1) { // atan(-,+)
            return -z;
        }
        if (m == 2) { // atan(+,-)
            return pi - (z - pi_lo);
        }
        return (z - pi_lo) - pi; // atan(-,-)
    };

    // e_sinh.c
    export let sinh = func(x: float64) -> float64 {
        let one = 1.0;
        let shuge = 1.0e307;
        let jx = words.high(x);
        let ix = jx & 2147483647; // 0x7fffffff
        // x is INF or NaN
        if (ix >= 2146435072) { // 0x7ff00000
            return x + x;
        }
        let h = 0.5;
        if (jx < 0) {
            h = -h;
        }
        // |x| in [0,22], return sign(x)*0.5*(E+E/(E+1)))
        if (ix < 1077280768) { // 0x40360000 |x|<22
            if (ix < 1043333120) { // 0x3e300000 |x|<2**-28; sinh(tiny) = tiny with inexact
                return x;
            }
            let t = expm1(words.abs(x));
            if (ix < 1072693248) { // 0x3ff00000
                return h * (2.0 * t - t * t / (t + one));
            }
            return h * (t + t / (t + one));
        }
        // |x| in [22, log(maxdouble)] return 0.5*exp(|x|)
        if (ix < 1082535490) { // 0x40862E42
            return h * exp(words.abs(x));
        }
        // |x| in [log(maxdouble), overflowthresold]
        let lx = words.low(x);
        if (ix < 1082536910 || (ix == 1082536910 && lx <= 2411329661)) { // 0x408633CE 0x408633ce 0x8fb9f87d
            let w = exp(0.5 * words.abs(x));
            let t = h * w;
            return t * w;
        }
        // |x| > overflowthresold, sinh(x) overflow
        return x * shuge;
    };

    // e_cosh.c
    export let cosh = func(x: float64) -> float64 {
        let one = 1.0;
        let half = 0.5;
        let huge = 1.0e300;
        let ix = words.high(x) & 2147483647; // 0x7fffffff
        // x is INF or NaN
        if (ix >= 2146435072) { // 0x7ff00000
            return x * x;
        }
        // |x| in [0,0.5*ln2], return 1+expm1(|x|)^2/(2*exp(|x|))
        if (ix < 1071001155) { // 0x3fd62e43
            let t = expm1(words.abs(x));
            let w = one + t;
            if (ix < 1015021568) { // 0x3c800000 cosh(tiny) = 1
                return w;
            }
            return one + (t * t) / (w + w);
        }
        // |x| in [0.5*ln2,22], return (exp(|x|)+1/exp(|x|)/2;
        if (ix < 1077280768) { // 0x40360000
            let t = exp(words.abs(x));
            return half * t + half / t;
        }
        // |x| in [22, log(maxdouble)] return half*exp(|x|)
        if (ix < 1082535490) { // 0x40862E42
            return half * exp(words.abs(x));
        }
        // |x| in [log(maxdouble), overflowthresold]
        let lx = words.low(x);
        if (ix < 1082536910 || (ix == 1082536910 && lx <= 2411329661)) { // 0x408633CE 0x408633ce 0x8fb9f87d
            let w = exp(half * words.abs(x));
            let t = half * w;
            return t * w;
        }
        // |x| > overflowthresold, cosh(x) overflow
        return huge * huge;
    };

    // s_tanh.c
    export let tanh = func(x: float64) -> float64 {
        let one = 1.0;
        let two = 2.0;
        let tiny = 1.0e-300;
        let jx = words.high(x);
        let ix = jx & 2147483647; // 0x7fffffff
        // x is INF or NaN
        if (ix >= 2146435072) { // 0x7ff00000
            if (jx >= 0) { // tanh(+-inf)=+-1
                return one / x + one;
            }
            return one / x - one; // tanh(NaN) = NaN
        }
        let z = 0.0;
        if (ix < 1077280768) { // 0x40360000 |x|<22
            if (ix < 1015021568) { // 0x3c800000 |x|<2**-55
                return x * (one + x); // tanh(small) = small
            }
            if (ix >= 1072693248) { // 0x3ff00000 |x|>=1
                let t = expm1(two * words.abs(x));
                z = one - two / (t + two);
            } else {
                let t = expm1(-two * words.abs(x));
                z = -t / (t + two);
            }
        } else { // |x| > 22, return +-1
            z = one - tiny; // raised inexact flag
        }
        if (jx >= 0) {
            return z;
        }
        return -z;
    };

    // Degrees to radians: x times the nearest float64 to pi/180.
    export let to_radians = func(degrees: float64) -> float64 {
        return degrees * float64.from_bits(4580687790476533049); // 0x3F91DF46A2529D39 0.017453292519943295
    };

    // Radians to degrees: x times the nearest float64 to 180/pi.
    export let to_degrees = func(radians: float64) -> float64 {
        return radians * float64.from_bits(4633260481411531256); // 0x404CA5DC1A63C1F8 57.29577951308232
    };
);
