        let a = j & 2147483647; // 0x7fffffff
        let k = (a >> 20) - 1023; // 0x3ff
        n = 0;
        if (a > 1071644672) { // 0x3fe00000 if |z| > 0.5, set n = [z+0.5]
            n = j + (1048576 >> (k + 1)); // 0x00100000
            k = ((n & 2147483647) >> 20) - 1023; // 0x7fffffff 0x3ff new k for n
            let t = words.from_words(n & ~(1048575 >> k), 0); // 0x000fffff
            n = ((n & 1048575) | 1048576) >> (20 - k); // 0x000fffff 0x00100000
            if (j < 0) {
                n = -n;
            }
            p_h = p_h - t;
