// Elementary functions on float64 (Stdlib.md section 10.1).
//
// sqrt is computed exactly by an integer square root of the significand.
// cbrt, hypot, exp, expm1, log, log1p, log10, pow, sin, cos, tan, asin,
// acos, atan, atan2, sinh, cosh, and tanh are a port of fdlibm 5.3
// (s_cbrt.c, e_hypot.c, e_exp.c, s_expm1.c, e_log.c, s_log1p.c, e_log10.c,
// e_pow.c, s_sin.c, s_cos.c, s_tan.c, e_asin.c, e_acos.c, s_atan.c,
// e_atan2.c, e_sinh.c, e_cosh.c, s_tanh.c), operation for operation, with
// the kernels in Std.Math.Internal.Trig. Constants are the bit patterns of
// fdlibm's constants; comments give fdlibm's hexadecimal and decimal
// spellings. Where fdlibm evaluates an expression only to raise the inexact
// flag (huge+x>one and similar tests that are always true), the port keeps
// the branch's result and omits the flag computation: Neura has no floating
// point flags. Every NaN result is the canonical NaN, because every NaN
// result comes from an arithmetic operation.
//
// log2 is not part of fdlibm 5.3. It follows e_log10.c: for x = 2^k * m it
// returns (k + i) + (1/ln 2) * log(m'), where m' is m or m/2 so that the
// logarithm is taken near 1, and it returns k exactly for a power of two.
//
// ====================================================
// Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
//
// Developed at SunSoft, a Sun Microsystems, Inc. business.
// Permission to use, copy, modify, and distribute this
// software is freely granted, provided that this notice
// is preserved.
// ====================================================
//
// e_pow.c: Copyright (C) 2004 by Sun Microsystems, Inc. All rights reserved.
// Permission to use, copy, modify, and distribute this software is freely
// granted, provided that this notice is preserved.
let trig = import:Std.Math.Internal.Trig;
let words = import:Std.Math.Internal.Words;

export let Math = module (
    export const Pi: float64 = float64.from_bits(4614256656552045848); // 0x400921FB54442D18 3.141592653589793
    export const Tau: float64 = float64.from_bits(4618760256179416344); // 0x401921FB54442D18 6.283185307179586
    export const E: float64 = float64.from_bits(4613303445314885481); // 0x4005BF0A8B145769 2.718281828459045
    export const Ln2: float64 = float64.from_bits(4604418534313441775); // 0x3FE62E42FEFA39EF 0.6931471805599453
    export const Ln10: float64 = float64.from_bits(4612367379483415830); // 0x40026BB1BBB55516 2.302585092994046
    export const Sqrt2: float64 = float64.from_bits(4609047870845172685); // 0x3FF6A09E667F3BCD 1.4142135623730951

    // Correctly rounded square root: the integer square root of the
    // significand, shifted to an even exponent and extended by 54 zero bits,
    // one result bit per step with a running remainder; then round to
    // nearest, ties to even. sqrt(-0.0) is -0.0; other negatives give NaN.
    export let sqrt = func(x: float64) -> float64 {
        if (x != x) {
            return x + x;
        }
        if (x == 0.0) {
            return x;
        }
        let b = x.to_bits();
        if (b >= 9223372036854775808) { // 0x8000000000000000
            return (x - x) / (x - x);
        }
        let e = ((b >> 52) & 2047) as int;
        if (e == 2047) {
            return x;
        }
        let m = b & 4503599627370495; // 0xFFFFFFFFFFFFF
        if (e == 0) { // subnormal: normalize the significand
            e = 1;
            while ((m & 4503599627370496) == 0) { // 0x10000000000000
                m = m << 1;
                e = e - 1;
            }
        } else {
            m = m | 4503599627370496; // 0x10000000000000
        }
        e = e - 1023; // x = m * 2^(e - 52)
        if ((e & 1) != 0) {
            m = m << 1;
            e = e - 1;
        }
        // q = floor(sqrt(m * 2^54)), 54 bits; r = m * 2^54 - q^2.
        let q: uint64 = 0;
        let r: uint64 = 0;
        for (let i = 0; i < 27; i = i + 1) {
            r = (r << 2) | ((m >> (52 - 2 * i)) & 3);
            let t = (q << 2) | 1;
            if (r >= t) {
                r = r - t;
                q = (q << 1) | 1;
            } else {
                q = q << 1;
            }
        }
        for (let i = 0; i < 27; i = i + 1) {
            r = r << 2;
            let t = (q << 2) | 1;
            if (r >= t) {
                r = r - t;
                q = (q << 1) | 1;
            } else {
                q = q << 1;
            }
        }
        let significand = q >> 1;
        if ((q & 1) != 0 && (r != 0 || (significand & 1) != 0)) {
            significand = significand + 1;
        }
        let exponent = (e / 2 + 1023) as uint64;
        return float64.from_bits((exponent << 52) + (significand - 4503599627370496)); // 0x10000000000000
    };

    // s_cbrt.c
    export let cbrt = func(x: float64) -> float64 {
        let B1 = 715094163; // B1 = (682-0.03306235651)*2**20
        let B2 = 696219795; // B2 = (664-0.03306235651)*2**20
        let c0 = float64.from_bits(4603064841997850097); // 0x3FE15F15F15F15F1 19/35 5.42857142857142815906e-01
        let d0 = float64.from_bits(13827900089180538932); // 0xBFE691DE2532C834 -864/1225 -7.05306122448979611050e-01
        let e0 = float64.from_bits(4609048195788499471); // 0x3FF6A0EA0EA0EA0F 99/70 1.41428571428571436819e+00
        let f0 = float64.from_bits(4609916747145206638); // 0x3FF9B6DB6DB6DB6E 45/28 1.60714285714285720630e+00
        let g0 = float64.from_bits(4600105333671292343); // 0x3FD6DB6DB6DB6DB7 5/14 3.57142857142857150787e-01
        let hx = words.high(x);
        let negative = hx < 0;
        hx = hx & 2147483647; // 0x7fffffff
        if (hx >= 2146435072) { // 0x7ff00000 cbrt(NaN,INF) is itself
            return x + x;
        }
        if (hx == 0 && words.low(x) == 0) { // cbrt(0) is itself
            return x;
        }
        x = words.with_high(x, hx); // x <- |x|
        // rough cbrt to 5 bits
        let t = 0.0;
        if (hx < 1048576) { // 0x00100000 subnormal number
            t = words.from_words(1129316352, 0); // 0x43500000 set t= 2**54
            t = t * x;
            t = words.with_high(t, words.high(t) / 3 + B2);
        } else {
            t = words.from_words(hx / 3 + B1, 0);
        }
        // new cbrt to 23 bits, may be implemented in single precision
        let r = t * t / x;
        let s = c0 + r * t;
        t = t * (g0 + f0 / (s + e0 + d0 / s));
        // chopped to 20 bits and make it larger than cbrt(x)
        t = words.from_words(words.high(t) + 1, 0); // 0x00000001
        // one step newton iteration to 53 bits with error less than 0.667 ulps
        s = t * t; // t*t is exact
        r = x / s;
        let w = t + t;
        r = (r - t) / (w + r); // r-s is exact
        t = t + t * r;
        // restore the sign bit
        if (negative) {
            return -t;
        }
        return t;
    };

    // e_hypot.c: sqrt(x*x + y*y) without undue overflow or underflow.
    export let hypot = func(x: float64, y: float64) -> float64 {
        let ha = words.high(x) & 2147483647; // 0x7fffffff high word of x
        let hb = words.high(y) & 2147483647; // 0x7fffffff high word of y
        let a = x;
        let b = y;
        if (hb > ha) {
            a = y;
            b = x;
            let j = ha;
            ha = hb;
            hb = j;
        }
        a = words.with_high(a, ha); // a <- |a|
        b = words.with_high(b, hb); // b <- |b|
        if ((ha - hb) > 62914560) { // 0x3c00000 x/y > 2**60
            return a + b;
        }
        let k = 0;
        if (ha > 1596981248) { // 0x5f300000 a>2**500
            if (ha >= 2146435072) { // 0x7ff00000 Inf or NaN
                let w = a + b;
                if ((ha & 1048575) == 0 && words.low(a) == 0) { // 0xfffff
                    w = a;
                }
                if (hb == 2146435072 && words.low(b) == 0) { // 0x7ff00000
                    w = b;
                }
                return w;
            }
            // scale a and b by 2**-600
            ha = ha - 629145600; // 0x25800000
            hb = hb - 629145600; // 0x25800000
            k = k + 600;
            a = words.with_high(a, ha);
            b = words.with_high(b, hb);
        }
        if (hb < 548405248) { // 0x20b00000 b < 2**-500
            if (hb <= 1048575) { // 0x000fffff subnormal b or 0
                if (hb == 0 && words.low(b) == 0) {
                    return a;
                }
                let t1 = words.from_words(2144337920, 0); // 0x7fd00000 t1=2^1022
                b = b * t1;
                a = a * t1;
                k = k - 1022;
            } else { // scale a and b by 2^600
                ha = ha + 629145600; // 0x25800000 a *= 2^600
                hb = hb + 629145600; // 0x25800000 b *= 2^600
                k = k - 600;
                a = words.with_high(a, ha);
                b = words.with_high(b, hb);
            }
        }
        // medium size a and b
        let w = a - b;
        if (w > b) {
            let t1 = words.from_words(ha, 0);
            let t2 = a - t1;
            w = sqrt(t1 * t1 - (b * (-b) - t2 * (t1 + a)));
        } else {
            a = a + a;
            let y1 = words.from_words(hb, 0);
            let y2 = b - y1;
            let t1 = words.from_words(ha + 1048576, 0); // 0x00100000
            let t2 = a - t1;
            w = sqrt(t1 * y1 - (w * (-w) - (t1 * y2 + t2 * b)));
        }
        if (k != 0) {
            let t1 = words.from_words(1072693248 + (k << 20), 0); // 0x3ff00000
            return t1 * w;
        }
        return w;
    };

    // e_exp.c
    export let exp = func(x: float64) -> float64 {
        let one = 1.0;
        let huge = 1.0e300;
        let twom1000 = float64.from_bits(103582791429521408); // 0x0170000000000000 2**-1000 9.33263618503218878990e-302
        let o_threshold = float64.from_bits(4649454530587146735); // 0x40862E42FEFA39EF 7.09782712893383973096e+02
        let u_threshold = float64.from_bits(13873137513782915153); // 0xC0874910D52D3051 -7.45133219101941108420e+02
        let ln2_hi = float64.from_bits(4604418534311723008); // 0x3FE62E42FEE00000 6.93147180369123816490e-01
        let ln2_lo = float64.from_bits(4461442080421002358); // 0x3DEA39EF35793C76 1.90821492927058770002e-10
        let invln2 = float64.from_bits(4609176140021203710); // 0x3FF71547652B82FE 1.44269504088896338700e+00
        let P1 = float64.from_bits(4595172819793696062); // 0x3FC555555555553E 1.66666666666666019037e-01
        let P2 = float64.from_bits(13791923578850950547); // 0xBF66C16C16BEBD93 -2.77777777770155933842e-03
        let P3 = float64.from_bits(4544508515198557740); // 0x3F11566AAF25DE2C 6.61375632143793436117e-05
        let P4 = float64.from_bits(13743786778040626161); // 0xBEBBBD41C5D26BF1 -1.65339022054652515390e-06
        let P5 = float64.from_bits(4496342204012209360); // 0x3E66376972BEA4D0 4.13813679705723846039e-08
        let hx = words.high(x);
        let xsb = (hx >> 31) & 1; // sign bit of x
        hx = hx & 2147483647; // 0x7fffffff high word of |x|
        // filter out non-finite argument
        if (hx >= 1082535490) { // 0x40862E42 if |x|>=709.78...
            if (hx >= 2146435072) { // 0x7ff00000
                if ((hx & 1048575) != 0 || words.low(x) != 0) { // 0xfffff NaN
                    return x + x;
                }
                if (xsb == 0) { // exp(+-inf)={inf,0}
                    return x;
                }
                return 0.0;
            }
            if (x > o_threshold) { // overflow
                return huge * huge;
            }
            if (x < u_threshold) { // underflow
                return twom1000 * twom1000;
            }
        }
        // argument reduction
        let hi = 0.0;
        let lo = 0.0;
        let k = 0;
        if (hx > 1071001154) { // 0x3fd62e42 if |x| > 0.5 ln2
            if (hx < 1072734898) { // 0x3FF0A2B2 and |x| < 1.5 ln2
                if (xsb == 0) {
                    hi = x - ln2_hi;
                    lo = ln2_lo;
                    k = 1;
                } else {
                    hi = x + ln2_hi;
                    lo = -ln2_lo;
                    k = -1;
                }
            } else {
                if (xsb == 0) {
                    k = (invln2 * x + 0.5) as int;
                } else {
                    k = (invln2 * x - 0.5) as int;
                }
                let t = k as float64;
                hi = x - t * ln2_hi; // t*ln2HI is exact here
                lo = t * ln2_lo;
            }
            x = hi - lo;
        } else if (hx < 1043333120) { // 0x3e300000 when |x|<2**-28
            return one + x;
        }
        // x is now in primary range
        let t = x * x;
        let c = x - t * (P1 + t * (P2 + t * (P3 + t * (P4 + t * P5))));
        if (k == 0) {
            return one - ((x * c) / (c - 2.0) - x);
        }
        let y = one - ((lo - (x * c) / (2.0 - c)) - hi);
        if (k >= -1021) {
            return words.with_high(y, words.high(y) + (k << 20)); // add k to y's exponent
        }
        y = words.with_high(y, words.high(y) + ((k + 1000) << 20)); // add k to y's exponent
        return y * twom1000;
    };

    // s_expm1.c: exp(x) - 1, accurate near zero.
    export let expm1 = func(x: float64) -> float64 {
        let one = 1.0;
        let huge = 1.0e300;
        let tiny = 1.0e-300;
        let o_threshold = float64.from_bits(4649454530587146735); // 0x40862E42FEFA39EF 7.09782712893383973096e+02
        let ln2_hi = float64.from_bits(4604418534311723008); // 0x3FE62E42FEE00000 6.93147180369123816490e-01
        let ln2_lo = float64.from_bits(4461442080421002358); // 0x3DEA39EF35793C76 1.90821492927058770002e-10
        let invln2 = float64.from_bits(4609176140021203710); // 0x3FF71547652B82FE 1.44269504088896338700e+00
        let Q1 = float64.from_bits(13808336697493098740); // 0xBFA11111111110F4 -3.33333333333331316428e-02
        let Q2 = float64.from_bits(4564962959435912581); // 0x3F5A01A019FE5585 1.58730158725481460165e-03
        let Q3 = float64.from_bits(13768856570209950647); // 0xBF14CE199EAADBB7 -7.93650757867487942473e-05
        let Q4 = float64.from_bits(4526346094260933177); // 0x3ED0CFCA86E65239 4.00821782732936239552e-06
        let Q5 = float64.from_bits(13730065378259354413); // 0xBE8AFDB76E09C32D -2.01099218183624371326e-07
        let hx = words.high(x);
        let negative = hx < 0; // sign bit of x
        hx = hx & 2147483647; // 0x7fffffff high word of |x|
        // filter out huge and non-finite argument
        if (hx >= 1078159482) { // 0x4043687A if |x|>=56*ln2
            if (hx >= 1082535490) { // 0x40862E42 if |x|>=709.78...
                if (hx >= 2146435072) { // 0x7ff00000
                    if ((hx & 1048575) != 0 || words.low(x) != 0) { // 0xfffff NaN
                        return x + x;
                    }
                    if (!negative) { // exp(+-inf)={inf,-1}
                        return x;
                    }
                    return -1.0;
                }
                if (x > o_threshold) { // overflow
                    return huge * huge;
                }
            }
            if (negative) { // x < -56*ln2, return -1.0 with inexact
                return tiny - one;
            }
        }
        // argument reduction
        let k = 0;
        let c = 0.0;
        if (hx > 1071001154) { // 0x3fd62e42 if  |x| > 0.5 ln2
            let hi = 0.0;
            let lo = 0.0;
            if (hx < 1072734898) { // 0x3FF0A2B2 and |x| < 1.5 ln2
                if (!negative) {
                    hi = x - ln2_hi;
                    lo = ln2_lo;
                    k = 1;
                } else {
                    hi = x + ln2_hi;
                    lo = -ln2_lo;
                    k = -1;
                }
            } else {
                if (!negative) {
                    k = (invln2 * x + 0.5) as int;
                } else {
                    k = (invln2 * x - 0.5) as int;
                }
                let t = k as float64;
                hi = x - t * ln2_hi; // t*ln2_hi is exact here
                lo = t * ln2_lo;
            }
            x = hi - lo;
            c = (hi - x) - lo;
        } else if (hx < 1016070144) { // 0x3c900000 when |x|<2**-54, return x
            let t = huge + x; // return x with inexact flags when x!=0
            return x - (t - (huge + x));
        }
        // x is now in primary range
        let hfx = 0.5 * x;
        let hxs = x * hfx;
        let r1 = one + hxs * (Q1 + hxs * (Q2 + hxs * (Q3 + hxs * (Q4 + hxs * Q5))));
        let t = 3.0 - r1 * hfx;
        let e = hxs * ((r1 - t) / (6.0 - x * t));
        if (k == 0) { // c is 0
            return x - (x * e - hxs);
        }
        e = (x * (e - c) - c);
        e = e - hxs;
        if (k == -1) {
            return 0.5 * (x - e) - 0.5;
        }
        if (k == 1) {
            if (x < -0.25) {
                return -2.0 * (e - (x + 0.5));
            }
            return one + 2.0 * (x - e);
        }
        if (k <= -2 || k > 56) { // suffice to return exp(x)-1
            let y = one - (e - x);
            y = words.with_high(y, words.high(y) + (k << 20)); // add k to y's exponent
            return y - one;
        }
        let y = 0.0;
        if (k < 20) {
            t = words.from_words(1072693248 - (2097152 >> k), 0); // 0x3ff00000 0x200000 t=1-2^-k
            y = t - (e - x);
            y = words.with_high(y, words.high(y) + (k << 20)); // add k to y's exponent
        } else {
            t = words.from_words((1023 - k) << 20, 0); // 0x3ff 2^-k
            y = x - (e + t);
            y = y + one;
            y = words.with_high(y, words.high(y) + (k << 20)); // add k to y's exponent
        }
        return y;
    };

    // e_log.c
    export let log = func(x: float64) -> float64 {
        let ln2_hi = float64.from_bits(4604418534311723008); // 0x3FE62E42FEE00000 6.93147180369123816490e-01
        let ln2_lo = float64.from_bits(4461442080421002358); // 0x3DEA39EF35793C76 1.90821492927058770002e-10
        let two54 = float64.from_bits(4850376798678024192); // 0x4350000000000000 1.80143985094819840000e+16
        let Lg1 = float64.from_bits(4604180019048437139); // 0x3FE5555555555593 6.666666666666735130e-01
        let Lg2 = float64.from_bits(4600877379321592324); // 0x3FD999999997FA04 3.999999999940941908e-01
        let Lg3 = float64.from_bits(4598818590951641945); // 0x3FD2492494229359 2.857142874366239149e-01
        let Lg4 = float64.from_bits(4597174411056806063); // 0x3FCC71C51D8E78AF 2.222219843214978396e-01
        let Lg5 = float64.from_bits(4595719342595441630); // 0x3FC7466496CB03DE 1.818357216161805012e-01
        let Lg6 = float64.from_bits(4594685411790997151); // 0x3FC39A09D078C69F 1.531383769920937332e-01
        let Lg7 = float64.from_bits(4594499633228436036); // 0x3FC2F112DF3E5244 1.479819860511658591e-01
        let third = float64.from_bits(4599676419421066581); // 0x3FD5555555555555 0.33333333333333333
        let zero = 0.0;
        let hx = words.high(x);
        let k = 0;
        if (hx < 1048576) { // 0x00100000 x < 2**-1022
            if ((hx & 2147483647) == 0 && words.low(x) == 0) { // 0x7fffffff log(+-0)=-inf
                return -two54 / zero;
            }
            if (hx < 0) { // log(-#) = NaN
                return (x - x) / zero;
            }
            k = k - 54;
            x = x * two54; // subnormal number, scale up x
            hx = words.high(x);
        }
        if (hx >= 2146435072) { // 0x7ff00000
            return x + x;
        }
        k = k + (hx >> 20) - 1023;
        hx = hx & 1048575; // 0x000fffff
        let i = (hx + 614244) & 1048576; // 0x95f64 0x100000
        x = words.with_high(x, hx | (i ^ 1072693248)); // 0x3ff00000 normalize x or x/2
        k = k + (i >> 20);
        let f = x - 1.0;
        if ((1048575 & (2 + hx)) < 3) { // 0x000fffff |f| < 2**-20
            if (f == zero) {
                if (k == 0) {
                    return zero;
                }
                let dk = k as float64;
                return dk * ln2_hi + dk * ln2_lo;
            }
            let R = f * f * (0.5 - third * f);
            if (k == 0) {
                return f - R;
            }
            let dk = k as float64;
            return dk * ln2_hi - ((R - dk * ln2_lo) - f);
        }
        let s = f / (2.0 + f);
        let dk = k as float64;
        let z = s * s;
        i = hx - 398458; // 0x6147a
        let w = z * z;
        let j = 440401 - hx; // 0x6b851
        let t1 = w * (Lg2 + w * (Lg4 + w * Lg6));
        let t2 = z * (Lg1 + w * (Lg3 + w * (Lg5 + w * Lg7)));
        i = i | j;
        let R = t2 + t1;
        if (i > 0) {
            let hfsq = 0.5 * f * f;
            if (k == 0) {
                return f - (hfsq - s * (hfsq + R));
            }
            return dk * ln2_hi - ((hfsq - (s * (hfsq + R) + dk * ln2_lo)) - f);
        }
        if (k == 0) {
            return f - s * (f - R);
        }
        return dk * ln2_hi - ((s * (f - R) - dk * ln2_lo) - f);
    };

    // s_log1p.c: log(1 + x), accurate near zero.
    export let log1p = func(x: float64) -> float64 {
        let ln2_hi = float64.from_bits(4604418534311723008); // 0x3FE62E42FEE00000 6.93147180369123816490e-01
        let ln2_lo = float64.from_bits(4461442080421002358); // 0x3DEA39EF35793C76 1.90821492927058770002e-10
        let two54 = float64.from_bits(4850376798678024192); // 0x4350000000000000 1.80143985094819840000e+16
        let Lp1 = float64.from_bits(4604180019048437139); // 0x3FE5555555555593 6.666666666666735130e-01
        let Lp2 = float64.from_bits(4600877379321592324); // 0x3FD999999997FA04 3.999999999940941908e-01
        let Lp3 = float64.from_bits(4598818590951641945); // 0x3FD2492494229359 2.857142874366239149e-01
        let Lp4 = float64.from_bits(4597174411056806063); // 0x3FCC71C51D8E78AF 2.222219843214978396e-01
        let Lp5 = float64.from_bits(4595719342595441630); // 0x3FC7466496CB03DE 1.818357216161805012e-01
        let Lp6 = float64.from_bits(4594685411790997151); // 0x3FC39A09D078C69F 1.531383769920937332e-01
        let Lp7 = float64.from_bits(4594499633228436036); // 0x3FC2F112DF3E5244 1.479819860511658591e-01
        let two_thirds = float64.from_bits(4604180019048437077); // 0x3FE5555555555555 0.66666666666666666
        let zero = 0.0;
        let hx = words.high(x);
        let ax = hx & 2147483647; // 0x7fffffff
        let k = 1;
        let f = 0.0;
        let hu = 0;
        if (hx < 1071284858) { // 0x3FDA827A x < 0.41422
            if (ax >= 1072693248) { // 0x3ff00000 x <= -1.0
                if (x == -1.0) { // log1p(-1)=+inf
                    return -two54 / zero;
                }
                return (x - x) / (x - x); // log1p(x<-1)=NaN
            }
            if (ax < 1042284544) { // 0x3e200000 |x| < 2**-29
                if (ax < 1016070144) { // 0x3c900000 |x| < 2**-54
                    return x;
                }
                return x - x * x * 0.5;
            }
            if (hx > 0 || hx <= -1076707645) { // 0xbfd2bec3 -0.2929<x<0.41422
                k = 0;
                f = x;
                hu = 1;
            }
        }
        if (hx >= 2146435072) { // 0x7ff00000
            return x + x;
        }
        let c = 0.0;
        if (k != 0) {
            let u = 0.0;
            if (hx < 1128267776) { // 0x43400000
                u = 1.0 + x;
                hu = words.high(u);
                k = (hu >> 20) - 1023;
                if (k > 0) { // correction term
                    c = 1.0 - (u - x);
                } else {
                    c = x - (u - 1.0);
                }
                c = c / u;
            } else {
                u = x;
                hu = words.high(u);
                k = (hu >> 20) - 1023;
                c = 0.0;
            }
            hu = hu & 1048575; // 0x000fffff
            if (hu < 434334) { // 0x6a09e
                u = words.with_high(u, hu | 1072693248); // 0x3ff00000 normalize u
            } else {
                k = k + 1;
                u = words.with_high(u, hu | 1071644672); // 0x3fe00000 normalize u/2
                hu = (1048576 - hu) >> 2; // 0x00100000
            }
            f = u - 1.0;
        }
        let hfsq = 0.5 * f * f;
        let dk = k as float64;
        if (hu == 0) { // |f| < 2**-20
            if (f == zero) {
                if (k == 0) {
                    return zero;
                }
                c = c + dk * ln2_lo;
                return dk * ln2_hi + c;
            }
            let R = hfsq * (1.0 - two_thirds * f);
            if (k == 0) {
                return f - R;
            }
            return dk * ln2_hi - ((R - (dk * ln2_lo + c)) - f);
        }
        let s = f / (2.0 + f);
        let z = s * s;
        let R = z * (Lp1 + z * (Lp2 + z * (Lp3 + z * (Lp4 + z * (Lp5 + z * (Lp6 + z * Lp7))))));
        if (k == 0) {
            return f - (hfsq - s * (hfsq + R));
        }
        return dk * ln2_hi - ((hfsq - (s * (hfsq + R) + (dk * ln2_lo + c))) - f);
    };

    // e_log10.c
    export let log10 = func(x: float64) -> float64 {
        let two54 = float64.from_bits(4850376798678024192); // 0x4350000000000000 1.80143985094819840000e+16
        let ivln10 = float64.from_bits(4601495173785380110); // 0x3FDBCB7B1526E50E 4.34294481903251816668e-01
        let log10_2hi = float64.from_bits(4599094494223097856); // 0x3FD34413509F6000 3.01029995663611771306e-01
        let log10_2lo = float64.from_bits(4420844829172378422); // 0x3D59FEF311F12B36 3.69423907715893078616e-13
        let zero = 0.0;
        let hx = words.high(x);
        let k = 0;
        if (hx < 1048576) { // 0x00100000 x < 2**-1022
            if ((hx & 2147483647) == 0 && words.low(x) == 0) { // 0x7fffffff log(+-0)=-inf
                return -two54 / zero;
            }
            if (hx < 0) { // log(-#) = NaN
                return (x - x) / zero;
            }
            k = k - 54;
            x = x * two54; // subnormal number, scale up x
            hx = words.high(x);
        }
        if (hx >= 2146435072) { // 0x7ff00000
            return x + x;
        }
        k = k + (hx >> 20) - 1023;
        let i = 0;
        if (k < 0) {
            i = 1;
        }
        hx = (hx & 1048575) | ((1023 - i) << 20); // 0x000fffff 0x3ff
        let y = (k + i) as float64;
        x = words.with_high(x, hx);
        let z = y * log10_2lo + ivln10 * log(x);
        return z + y * log10_2hi;
    };

    // Base-2 logarithm, shaped like e_log10.c (see the file comment).
    export let log2 = func(x: float64) -> float64 {
        let two54 = float64.from_bits(4850376798678024192); // 0x4350000000000000 1.80143985094819840000e+16
        let ivln2 = float64.from_bits(4609176140021203710); // 0x3FF71547652B82FE 1.44269504088896338700e+00
        let zero = 0.0;
        let hx = words.high(x);
        let k = 0;
        if (hx < 1048576) { // 0x00100000 x < 2**-1022
            if ((hx & 2147483647) == 0 && words.low(x) == 0) { // 0x7fffffff log(+-0)=-inf
                return -two54 / zero;
            }
            if (hx < 0) { // log(-#) = NaN
                return (x - x) / zero;
            }
            k = k - 54;
            x = x * two54; // subnormal number, scale up x
            hx = words.high(x);
        }
        if (hx >= 2146435072) { // 0x7ff00000
            return x + x;
        }
        k = k + (hx >> 20) - 1023;
        if ((hx & 1048575) == 0 && words.low(x) == 0) { // 0x000fffff exact power of two
            return k as float64;
        }
        let i = 0;
        if (k < 0) {
            i = 1;
        }
        hx = (hx & 1048575) | ((1023 - i) << 20); // 0x000fffff 0x3ff
        let y = (k + i) as float64;
        x = words.with_high(x, hx);
        let z = ivln2 * log(x);
        return z + y;
    };

    // e_pow.c: x raised to y.
    export let pow = func(x: float64, y: float64) -> float64 {
        let zero = 0.0;
        let one = 1.0;
        let two = 2.0;
        let two53 = float64.from_bits(4845873199050653696); // 0x4340000000000000 9007199254740992.0
        let huge = 1.0e300;
        let tiny = 1.0e-300;
        // poly coefs for (3/2)*(log(x)-2s-2/3*s**3
        let L1 = float64.from_bits(4603579539098120963); // 0x3FE3333333333303 5.99999999999994648725e-01
        let L2 = float64.from_bits(4601392076422097919); // 0x3FDB6DB6DB6FABFF 4.28571428578550184252e-01
        let L3 = float64.from_bits(4599676419357746765); // 0x3FD55555518F264D 3.33333329818377432918e-01
        let L4 = float64.from_bits(4598584653024936193); // 0x3FD17460A91D4101 2.72728123808534006489e-01
        let L5 = float64.from_bits(4597478449480325989); // 0x3FCD864A93C9DB65 2.30660745775561754067e-01
        let L6 = float64.from_bits(4596625081194860271); // 0x3FCA7E284A454EEF 2.06975017800338417784e-01
        let P1 = float64.from_bits(4595172819793696062); // 0x3FC555555555553E 1.66666666666666019037e-01
        let P2 = float64.from_bits(13791923578850950547); // 0xBF66C16C16BEBD93 -2.77777777770155933842e-03
        let P3 = float64.from_bits(4544508515198557740); // 0x3F11566AAF25DE2C 6.61375632143793436117e-05
        let P4 = float64.from_bits(13743786778040626161); // 0xBEBBBD41C5D26BF1 -1.65339022054652515390e-06
        let P5 = float64.from_bits(4496342204012209360); // 0x3E66376972BEA4D0 4.13813679705723846039e-08
        let lg2 = float64.from_bits(4604418534313441775); // 0x3FE62E42FEFA39EF 6.93147180559945286227e-01
        let lg2_h = float64.from_bits(4604418534330597376); // 0x3FE62E4300000000 6.93147182464599609375e-01
        let lg2_l = float64.from_bits(13700051638354996281); // 0xBE205C610CA86C39 -1.90465429995776804525e-09
        let ovt = float64.from_bits(4365981760143196926); // 0x3C971547652B82FE 8.0085662595372944372e-0017 -(1024-log2(ovfl+.5ulp))
        let cp = float64.from_bits(4606838314010018813); // 0x3FEEC709DC3A03FD 9.61796693925975554329e-01 =2/(3ln2)
        let cp_h = float64.from_bits(4606838314073325568); // 0x3FEEC709E0000000 9.61796700954437255859e-01 =(float)cp
        let cp_l = float64.from_bits(13708446955223056885); // 0xBE3E2FE0145B01F5 -7.02846165095275826516e-09 =tail of cp_h
        let ivln2 = float64.from_bits(4609176140021203710); // 0x3FF71547652B82FE 1.44269504088896338700e+00 =1/ln2
        let ivln2_h = float64.from_bits(4609176139934466048); // 0x3FF7154760000000 1.44269502162933349609e+00 =24b 1/ln2
        let ivln2_l = float64.from_bits(4491406094830001988); // 0x3E54AE0BF85DDF44 1.92596299112661746887e-08 =1/ln2 tail
        let third = float64.from_bits(4599676419421066581); // 0x3FD5555555555555 0.3333333333333333333333
        let hx = words.high(x);
        let lx = words.low(x);
        let hy = words.high(y);
        let ly = words.low(y);
        let ix = hx & 2147483647; // 0x7fffffff
        let iy = hy & 2147483647; // 0x7fffffff
        // y==zero: x**0 = 1
        if (iy == 0 && ly == 0) {
            return one;
        }
        // +-NaN return x+y
        if (ix > 2146435072 || (ix == 2146435072 && lx != 0) || iy > 2146435072 || (iy == 2146435072 && ly != 0)) { // 0x7ff00000 0x7ff00000 0x7ff00000 0x7ff00000
            return x + y;
        }
        // determine if y is an odd int when x < 0
        // yisint = 0 ... y is not an integer
        // yisint = 1 ... y is an odd int
        // yisint = 2 ... y is an even int
        let yisint = 0;
        if (hx < 0) {
