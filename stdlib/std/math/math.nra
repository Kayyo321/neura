                    if ((j << (52 - k)) == ly) {
                        yisint = 2 - ((j & 1) as int);
                    }
                } else if (ly == 0) {
                    let j = iy >> (20 - k);
                    if ((j << (20 - k)) == iy) {
                        yisint = 2 - (j & 1);
                    }
                }
            }
        }
        // special value of y
        if (ly == 0) {
            if (iy == 2146435072) { // 0x7ff00000 y is +-inf
                if (ix == 1072693248 && lx == 0) { // 0x3ff00000 inf**+-1 is NaN
                    return y - y;
                }
                if (ix >= 1072693248) { // 0x3ff00000 (|x|>1)**+-inf = inf,0
                    if (hy >= 0) {
                        return y;
                    }
                    return zero;
                }
                if (hy < 0) { // (|x|<1)**-,+inf = inf,0
                    return -y;
                }
                return zero;
            }
            if (iy == 1072693248) { // 0x3ff00000 y is  +-1
                if (hy < 0) {
                    return one / x;
                }
                return x;
            }
            if (hy == 1073741824) { // 0x40000000 y is  2
                return x * x;
            }
            if (hy == 1071644672) { // 0x3fe00000 y is  0.5
                if (hx >= 0) { // x >= +0
                    return sqrt(x);
                }
            }
        }
        let ax = words.abs(x);
        // special value of x
        if (lx == 0) {
            if (ix == 2146435072 || ix == 0 || ix == 1072693248) { // 0x7ff00000 0x3ff00000
                let z = ax; // x is +-0,+-inf,+-1
                if (hy < 0) { // z = (1/|x|)
                    z = one / z;
                }
                if (hx < 0) {
                    if (ix == 1072693248 && yisint == 0) { // 0x3ff00000 (-1)**non-int is NaN
                        z = (z - z) / (z - z);
                    } else if (yisint == 1) { // (x<0)**odd = -(|x|**odd)
                        z = -z;
                    }
                }
                return z;
            }
        }
        let n = (hx >> 31) + 1;
        // (x<0)**(non-int) is NaN
        if (n == 0 && yisint == 0) {
            return (x - x) / (x - x);
        }
        let s = one; // s (sign of result -ve**odd) = -1 else = 1
        if (n == 0 && yisint == 1) { // (-ve)**(odd int)
            s = -one;
        }
        let t1 = 0.0;
        let t2 = 0.0;
        // |y| is huge
        if (iy > 1105199104) { // 0x41e00000 if |y| > 2**31
            if (iy > 1139802112) { // 0x43f00000 if |y| > 2**64, must o/uflow
                if (ix <= 1072693247) { // 0x3fefffff
                    if (hy < 0) {
                        return huge * huge;
                    }
                    return tiny * tiny;
                }
                if (ix >= 1072693248) { // 0x3ff00000
                    if (hy > 0) {
                        return huge * huge;
                    }
                    return tiny * tiny;
                }
            }
            // over/underflow if x is not close to one
            if (ix < 1072693247) { // 0x3fefffff
                if (hy < 0) {
                    return s * huge * huge;
                }
                return s * tiny * tiny;
            }
            if (ix > 1072693248) { // 0x3ff00000
                if (hy > 0) {
                    return s * huge * huge;
                }
                return s * tiny * tiny;
            }
            // now |1-x| is tiny <= 2**-20, suffice to compute
            // log(x) by x-x^2/2+x^3/3-x^4/4
            let t = ax - one; // t has 20 trailing zeros
            let w = (t * t) * (0.5 - t * (third - t * 0.25));
            let u = ivln2_h * t; // ivln2_h has 21 sig. bits
            let v = t * ivln2_l - w * ivln2;
            t1 = words.with_low(u + v, 0);
            t2 = v - (t1 - u);
        } else {
            n = 0;
            // take care subnormal number
            if (ix < 1048576) { // 0x00100000
                ax = ax * two53;
                n = n - 53;
                ix = words.high(ax);
            }
            n = n + (ix >> 20) - 1023; // 0x3ff
            let j = ix & 1048575; // 0x000fffff
            // determine interval
            ix = j | 1072693248; // 0x3ff00000 normalize ix
            let k = 0;
            if (j <= 235662) { // 0x3988E |x|<sqrt(3/2)
                k = 0;
            } else if (j < 767610) { // 0xBB67A |x|<sqrt(3)
                k = 1;
            } else {
                k = 0;
                n = n + 1;
                ix = ix - 1048576; // 0x00100000
            }
            ax = words.with_high(ax, ix);
            let bp = 1.0; // bp[0]=1.0, bp[1]=1.5
            let dp_h = 0.0;
            let dp_l = 0.0;
            if (k == 1) {
                bp = 1.5;
                dp_h = float64.from_bits(4603444093224222720); // 0x3FE2B80340000000 5.84962487220764160156e-01
                dp_l = float64.from_bits(4489242115478376454); // 0x3E4CFDEB43CFD006 1.35003920212974897128e-08
            }
            // compute ss = s_h+s_l = (x-1)/(x+1) or (x-1.5)/(x+1.5)
            let u = ax - bp;
            let v = one / (ax + bp);
            let ss = u * v;
            let s_h = words.with_low(ss, 0);
            // t_h=ax+bp[k] High
            let t_h = words.from_words(((ix >> 1) | 536870912) + 524288 + (k << 18), 0); // 0x20000000 0x00080000
            let t_l = ax - (t_h - bp);
            let s_l = v * ((u - s_h * t_h) - s_h * t_l);
            // compute log(ax)
            let s2 = ss * ss;
            let r = s2 * s2 * (L1 + s2 * (L2 + s2 * (L3 + s2 * (L4 + s2 * (L5 + s2 * L6)))));
            r = r + s_l * (s_h + ss);
            s2 = s_h * s_h;
            t_h = words.with_low(3.0 + s2 + r, 0);
            t_l = r - ((t_h - 3.0) - s2);
            // u+v = ss*(1+...)
            u = s_h * t_h;
            v = s_l * t_h + t_l * ss;
            // 2/(3log2)*(ss+...)
            let p_h = words.with_low(u + v, 0);
            let p_l = v - (p_h - u);
            let z_h = cp_h * p_h; // cp_h+cp_l = 2/(3*log2)
            let z_l = cp_l * p_h + p_l * cp + dp_l;
            // log2(ax) = (ss+..)*2/(3*log2) = n + dp_h + z_h + z_l
            let t = n as float64;
            t1 = words.with_low(((z_h + z_l) + dp_h) + t, 0);
            t2 = z_l - (((t1 - t) - dp_h) - z_h);
        }
        // split up y into y1+y2 and compute (y1+y2)*(t1+t2)
        let y1 = words.with_low(y, 0);
        let p_l = (y - y1) * t1 + y * t2;
        let p_h = y1 * t1;
        let z = p_l + p_h;
        let j = words.high(z);
        let i = words.low(z);
        if (j >= 1083179008) { // 0x40900000 z >= 1024
            if (j != 1083179008 || i != 0) { // 0x40900000 if z > 1024
                return s * huge * huge; // overflow
            }
            if (p_l + ovt > z - p_h) { // overflow
                return s * huge * huge;
            }
        } else if ((j & 2147483647) >= 1083231232) { // 0x7fffffff 0x4090cc00 z <= -1075
            if (j != -1064252416 || i != 0) { // 0xc090cc00 z < -1075
                return s * tiny * tiny; // underflow
            }
            if (p_l <= z - p_h) { // underflow
                return s * tiny * tiny;
            }
