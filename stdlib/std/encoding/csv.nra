let builders = import:Std.Core.StringBuilder;
let error = import:Std.Core.Error;
let result = import:Std.Core.Result;
let strings = import:Std.Text.Strings;

// Comma-separated values (RFC 4180; Stdlib.md section 13.1). Fields are
// separated by commas and records by LF or CRLF. A field that starts with a
// quote is quoted: it ends at the next single quote, and inside it commas,
// CR, LF, and doubled quotes ("" for one quote) are data. Any other byte,
// including a CR that does not start a CRLF, is data in either kind of
// field.
export let Csv = module (
    // The records of the text, each a list of its fields. The empty text has
    // no records; a final line break does not add an empty record; an empty
    // line is a record with one empty field. Parse errors:
    //
    // - Syntax, "quote in unquoted field": at the quote.
    // - Syntax, "text after closing quote": at the first byte after the
    //   closing quote that is not a comma or a line break.
    // - UnexpectedEnd, "unterminated quoted field": at the text's length.
    export let parse = func(text: string) -> result.Result<string[list][list]> {
        let records: string[list][list] = [];
        let count = text.byte_length;
        let record: string[list] = [];
        let i = 0;
        while (i < count) {
            // i is at the start of a field.
            let end = 0;
            if (text.byte_at(i) == 34) {
                end = quoted_end(text, i + 1);
                if (end < 0) {
                    return failure(error.ParseErrorKind.UnexpectedEnd, count, "unterminated quoted field");
                }
                record.append(unquote(text, i + 1, end));
                end = end + 1;
                if (end < count && !is_separator(text, end)) {
                    return failure(error.ParseErrorKind.Syntax, end, "text after closing quote");
                }
            } else {
                end = i;
                while (end < count) {
                    let b = text.byte_at(end);
                    if (b == 44 or 10 or 13 or 34) {
                        if (b == 34) {
                            return failure(error.ParseErrorKind.Syntax, end, "quote in unquoted field");
                        }
                        if (b != 13 || is_separator(text, end)) {
                            break;
                        }
                    }
                    end = end + 1;
                }
                record.append(text.slice(i, end));
            }
            // end is at a comma, a line break, or the end of the text.
            if (end == count) {
                records.append(record);
                return result.Result<string[list][list]>.Ok(records);
            }
            let b = text.byte_at(end);
            if (b == 44) {
                i = end + 1;
                if (i == count) {
                    // A final comma ends an empty last field.
                    record.append("");
                    records.append(record);
                    return result.Result<string[list][list]>.Ok(records);
                }
            } else {
                records.append(record);
                record = [];
                if (b == 13) {
                    i = end + 2;
                } else {
                    i = end + 1;
                }
            }
        }
        return result.Result<string[list][list]>.Ok(records);
    };

    // The rows as CSV text: fields joined by commas, each record followed by
    // LF. A field is quoted, with each quote doubled, only when it contains a
    // comma, a quote, a CR, or an LF. A row with no fields is written as an
    // empty line, which parses as one empty field.
    export let write = func(rows: string[list][list]) -> string {
        let out = builders.create();
        for (let row in rows) {
            let first = true;
            for (let field in row) {
                if (!first) {
                    out.append(",");
                }
                first = false;
                if (needs_quotes(field)) {
                    out.append("\"");
                    out.append(strings.replace(field, "\"", "\"\""));
                    out.append("\"");
                } else {
                    out.append(field);
                }
            }
            out.append("\n");
        }
        return out.to_string();
    };

    // Whether the byte at the offset is a comma, an LF, or the CR of a CRLF.
    let is_separator = func(text: string, offset: int) -> bool {
        let b = text.byte_at(offset);
        if (b == 44 or 10) {
            return true;
        }
        return b == 13 && offset + 1 < text.byte_length && text.byte_at(offset + 1) == 10;
    };

    // The offset of the quote that closes a quoted field whose content
    // starts at `start`, or -1 when the text ends first.
    let quoted_end = func(text: string, start: int) -> int {
        let count = text.byte_length;
        let j = start;
        while (j < count) {
            if (text.byte_at(j) == 34) {
                if (j + 1 < count && text.byte_at(j + 1) == 34) {
                    j = j + 2;
                    continue;
                }
                return j;
            }
            j = j + 1;
        }
        return -1;
    };

    // The content between `start` and `end` with each doubled quote made
    // single.
    let unquote = func(text: string, start: int, end: int) -> string {
        let content = text.slice(start, end);
        if (strings.index_of(content, "\"") < 0) {
            return content;
        }
        return strings.replace(content, "\"\"", "\"");
    };

    let needs_quotes = func(field: string) -> bool {
        let count = field.byte_length;
        for (let i = 0; i < count; i = i + 1) {
            if (field.byte_at(i) == 44 or 34 or 13 or 10) {
                return true;
            }
        }
        return false;
    };

    let failure = func(kind: error.ParseErrorKind, offset: int, message: string) -> result.Result<string[list][list]> {
        return result.Result<string[list][list]>.Err(error.Error.Parse { kind: kind, offset: offset, message: message });
    };
);
