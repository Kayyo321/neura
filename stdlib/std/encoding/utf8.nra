let kernels = import:Std.Internal.Kernels.Encoding;
let.promote _ = import:Std.Core.Result;
let strings = import:Std.Text.Strings;

/// @brief UTF-8 (Stdlib.md section 13.1) with the validity rules of section 8.1: shortest form only, no
/// surrogates, nothing above U+10FFFF.
///
/// Encoding and decoding share Std.Text.Strings, so an error here is the error Strings.from_bytes reports.
/// @see [Std.Encoding.Utf8](https://github.com/Kayyo321/neura/wiki/Stdlib-Encoding-Utf8)
#Since("0.1.0")
export let Utf8 = module (
    /// @brief A copy of the string's bytes.
    #NoDiscard
    export let encode = func(s: string) -> uint8[list] => strings.to_bytes(s);

    /// @brief The text, or an Encoding error at the offset `validate` returns. The message is "invalid start
    /// byte", "invalid continuation byte", or "unexpected end of data".
    #NoDiscard
    export let decode = func(bytes: uint8[list]) -> Result<string> => strings.from_bytes(bytes);

    /// @brief The text with each maximal ill-formed subsequence (Unicode's maximal subpart practice) replaced
    /// by one U+FFFD.
    #NoDiscard
    export let decode_lossy = func(bytes: uint8[list]) -> string => strings.from_bytes_lossy(bytes);

    /// @brief -1 when the bytes are valid UTF-8; otherwise the offset of the first byte that cannot begin or
    /// continue a valid sequence's prefix, which is the length of the longest valid prefix.
    ///
    /// The neura.encoding.utf8_validate kernel scans the bytes (docs/runtime/Kernels.md); the Neura code it
    /// replaced is the oracle of tests/stdlib/utf8/kernel-oracle.nra.
    #NoDiscard
    export let validate = func(bytes: uint8[list]) -> int => kernels.utf8_validate(bytes) as int;
);
