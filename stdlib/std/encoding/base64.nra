let kernel_status = import:Std.Core.Internal.KernelStatus;
let kernels = import:Std.Internal.Kernels.Encoding;
let.promote _ = import:Std.Core.Result;

/// @brief Base 64 (RFC 4648; Stdlib.md section 13.1) with the standard alphabet (section 4) and the URL- and
/// filename-safe alphabet (section 5).
///
/// The padded encoders end the text with `=` to a multiple of four characters; the _unpadded encoders omit it.
///
/// Decoding is strict. A padded decoder requires the text's length to be a multiple of four, with `=` only as
/// one or two final characters; an unpadded decoder rejects `=` and a final group of one character. Every other
/// byte outside the alphabet, including whitespace, line breaks, and the other alphabet's two symbols, is
/// rejected, and the unused low bits of the last character must be zero. Failures are Encoding errors. The
/// first error in the text's structure (characters, padding, and length) is reported; only a well-formed text
/// is checked for trailing bits. The messages and offsets:
///
/// - "invalid character": a byte outside the alphabet, at its offset.
/// - "invalid padding": a `=` that cannot be padding, or a character after
/// padding, at its offset.
/// - "unexpected padding": a `=` given to an unpadded decoder, at its offset.
/// - "unexpected end of data": the text ends inside a group, at the length.
/// - "nonzero trailing bits": the last character has unused bits set, at
/// its offset.
///
/// The built-in kernels neura.encoding.base64_encode and base64_decode compute every variant
/// (docs/runtime/Kernels.md). The Neura implementation they replaced is the oracle of
/// tests/stdlib/base64/kernel-oracle.nra.
/// @see [Std.Encoding.Base64](https://github.com/Kayyo321/neura/wiki/Stdlib-Encoding-Base64)
#Since("0.1.0")
export let Base64 = module (
    /// @brief Encodes bytes with the standard alphabet and padding.
    #NoDiscard
    export let encode = func(bytes: uint8[list]) -> string => kernels.base64_encode(bytes, false, true);

    /// @brief Encodes bytes with the standard alphabet and omits padding.
    #NoDiscard
    export let encode_unpadded = func(bytes: uint8[list]) -> string => kernels.base64_encode(bytes, false, false);

    /// @brief Encodes bytes with the URL-safe alphabet and padding.
    #NoDiscard
    export let encode_url = func(bytes: uint8[list]) -> string => kernels.base64_encode(bytes, true, true);

    /// @brief Encodes bytes with the URL-safe alphabet and omits padding.
    #NoDiscard
    export let encode_url_unpadded = func(bytes: uint8[list]) -> string =>
        kernels.base64_encode(bytes, true, false);

    /// @brief Strict decoding of padded standard text.
    #NoDiscard
    export let decode = func(text: string) -> Result<uint8[list]> => decode_with(text, false, true);

    /// @brief Strict decoding of unpadded standard text.
    #NoDiscard
    export let decode_unpadded = func(text: string) -> Result<uint8[list]> => decode_with(text, false, false);

    /// @brief Strict decoding of padded URL-safe text.
    #NoDiscard
    export let decode_url = func(text: string) -> Result<uint8[list]> => decode_with(text, true, true);

    /// @brief Strict decoding of unpadded URL-safe text.
    #NoDiscard
    export let decode_url_unpadded = func(text: string) -> Result<uint8[list]> => decode_with(text, true, false);

    /// @brief Decodes with the selected alphabet and padding policy and turns a kernel failure into its
    /// Encoding error.
    let decode_with = func(text: string, url: bool, padded: bool) -> Result<uint8[list]> {
        let [status, offset, bytes] = kernels.base64_decode(text, url, padded);
        if (status != kernel_status.Ok) {
            return Result<uint8[list]>.Err(kernel_status.encoding_error(status, offset));
        }
        return Result<uint8[list]>.Ok(bytes);
    };
);
