let bytes = import:Std.Io.Internal.Bytes;
let.promote _ = import:Std.Time.Duration;
let host = import:Std.Net.Socket.Internal.HostCalls;
let host_error = import:Std.Core.Internal.HostError;
let.promote _ = import:Std.Core.Error;
let.promote _ = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Result;
let socket = import:Std.Net.Internal.Socket;
let.promote _ = import:Std.Net.Core.SocketAddr;
let.promote _ = import:Std.Net.Socket.StreamSocket;
let support = import:Std.Net.Socket.Internal.Support;
let.promote _ = import:Std.Core.Unit;

/// @brief A TLS 1.2 or 1.3 stream over TCP: a `Std.Net.Socket.StreamSocket` of `Std.Net.Core.SocketAddr` whose
/// bytes are encrypted by the host's TLS provider. Needs the net capability.
///
/// `TlsConnector` and `TlsAcceptor` open streams. The record layer runs in the host's TLS library (OpenSSL 4.1 in
/// builds configured with `NEURA_ENABLE_SERVER_TLS`). Reading, writing and close call `neura.net.tls.*`.
/// A failed write ends the stream's I/O with that error. Close still releases the stream.
/// Shutdown sends TLS `close_notify` on the write side. `local_address` reports the underlying socket address.
/// After close every operation except close fails with Closed.
/// @see [Std.Net.Tls.TlsStream](https://github.com/Kayyo321/neura/wiki/Stdlib-Net-Tls-TlsStream)
.Since("0.3.0")
export let TlsStream = module (
    let tls_local_address = func(stream: int64) -> host.AddressOutcome host("neura.net.tls.local_address", 1);
    let tls_shutdown_write = func(stream: int64, timeout: int64) -> host.DoneOutcome host("neura.net.tls.shutdown_write", 1);

    let tls_write_bounded = func(stream: int64, data: uint8[list], timeout: int64) -> host.CountOutcome
        host("neura.net.tls.write", 2);

    let ChainOutcome = enum (Ok(uint8[list][list]), Error(uint32));
    let tls_peer_chain = func(stream: int64) -> ChainOutcome host("neura.net.tls.peer_chain", 1);

    /// @brief One TLS stream.
    .[Final, NoDiscard(reason: "a stream must be closed"), NotThreadSafe]
    export let TlsStream = class implements StreamSocket<SocketAddr> (
        /// @brief The host's TLS stream ID.
        last id: int64;
        /// @brief The address text used in error messages.
        last label: string;
        /// @brief The dialed peer, when known.
        last peer: Optional<SocketAddr>;
        /// @brief The ALPN protocol the handshake selected; empty when none.
        export last alpn: string;
        /// @brief The read timeout in nanoseconds; zero uses the thirty-second provider default.
        let timeout_nanos: int64 = 0;
        /// @brief Writes have a finite default budget of thirty seconds.
        let write_timeout_nanos: int64 = 30000000000;
        /// @brief Tracks whether the stream may still use the host ID.
        let open_now: bool = true;
        let write_closed: bool = false;
        let write_error: uint32 = 0;

        let write_failure = func -> Error => host_error.io(write_error,
            host_error.kind_of(write_error) == IoErrorKind.Unsupported
            ? "TLS operation is unavailable in this runtime"
            : "TLS write failed", label);

        /// @brief Use `TlsConnector` or `TlsAcceptor`; the handle comes from the library.
        export let init = func(opened: socket.Handle, dialed: Optional<SocketAddr>, selected: string) {
            id = opened.id;
            label = opened.address;
            peer = dialed;
            alpn = selected;
        };

        /// @brief Up to `max` decrypted bytes; an empty list once the peer has closed the stream. A maximum
        /// below 1 traps.
        .NoDiscard
        export let read = func(max: int) -> Result<uint8[list]> {
            bytes.check_maximum(max);
            return Result<uint8[list]>.Err(bytes.closed("stream", label)) unless open_now;
            return match (host.tls_read(id, max, timeout_nanos)) {
                host.BytesOutcome.Ok(chunk) => Result<uint8[list]>.Ok(chunk),
                host.BytesOutcome.Error(code) => Result<uint8[list]>.Err(host_error.io(code, host_error.kind_of(code) == IoErrorKind.Unsupported
                    ? "TLS operation is unavailable in this runtime"
                    : "TLS read failed", label)),
            };
        };

        /// @brief Encrypts and writes every byte, repeating partial host writes.
        .NoDiscard
        export let write = func(data: uint8[list]) -> Result<Unit> {
            return Result<Unit>.Err(bytes.closed("stream", label)) unless open_now && not write_closed;
            return Result<Unit>.Err(write_failure()) unless write_error == 0;
            let remaining = data;
            while (remaining.length > 0) {
                match (tls_write_bounded(id, remaining, write_timeout_nanos)) {
                    host.CountOutcome.Ok(count) => {
                        if (count <= 0) {
                            return Result<Unit>.Err(bytes.no_progress("TLS write failed", label));
                        }
                        remaining = bytes.copy_range(remaining, count < remaining.length ? count : remaining.length,
                            remaining.length);
                    },
                    host.CountOutcome.Error(code) => {
                        write_error = code;
                        return Result<Unit>.Err(write_failure());
                    },
                }
            }
            return bytes.ok();
        };

        /// @brief The next decrypted bytes (at most `ReceiveChunk`), or `None` at the end of the peer's data.
        .NoDiscard
        export let receive = func -> Result<Optional<uint8[list]>> {
            last chunk = read(ReceiveChunk)?;
            return if (chunk.length == 0) -> Result<Optional<uint8[list]>>.Ok(Optional<uint8[list]>.None)
                else -> Result<Optional<uint8[list]>>.Ok(Optional<uint8[list]>.Some(chunk));
        };

        /// @brief Sends every byte; the `Std.Net.Transport` form of `write`.
        .NoDiscard
        export let send = func(data: uint8[list]) -> Result<Unit> => write(data);

        /// @brief The longest a read waits; zero uses the thirty-second provider default.
        export let read_timeout = func -> Duration => of_nanos(timeout_nanos);

        /// @brief Sets the read timeout. A negative timeout traps with "invalid argument: negative timeout".
        export let set_read_timeout = func(timeout: Duration) {
            timeout_nanos = support.timeout_nanos(timeout);
        };

        /// @brief Sets a positive timeout for each host write or write shutdown; zero or negative traps.
        .Since("0.3.1")
        export let set_write_timeout = func(timeout: Duration) {
            last nanos = support.timeout_nanos(timeout);
            if (nanos == 0) {
                trap_with_message("invalid argument: TLS write timeout must be positive");
            }
            write_timeout_nanos = nanos;
        };

        /// @brief The verified peer chain as DER certificates, leaf first, including the trust anchor.
        /// A server stream without client certificate verification returns PermissionDenied.
        .[Since("0.3.1"), NoDiscard]
        export let peer_certificate_chain = func -> Result<uint8[list][list]> {
            return Result<uint8[list][list]>.Err(bytes.closed("stream", label)) unless open_now;
            return match (tls_peer_chain(id)) {
                ChainOutcome.Ok(chain) => Result<uint8[list][list]>.Ok(chain),
                ChainOutcome.Error(code) => Result<uint8[list][list]>.Err(
                    host_error.io(code, "verified peer certificate chain unavailable", label)),
            };
        };

        /// @brief The dialed peer, or `None` for an accepted stream (not reported by the host).
        export let peer_address = func -> Optional<SocketAddr> => peer;

        /// @brief The underlying socket's local address.
        .NoDiscard
        export let local_address = func -> Result<SocketAddr> {
            return Result<SocketAddr>.Err(bytes.closed("stream", label)) unless open_now;
            return match (tls_local_address(id)) {
                host.AddressOutcome.Ok(reported) => support.reported_address(reported),
                host.AddressOutcome.Error(code) => Result<SocketAddr>.Err(
                    host_error.io(code, "local address failed", label)),
            };
        };

        /// @brief Sends authenticated `close_notify` for Write within the write timeout.
        /// Read and Both return Unsupported without changing state.
        .NoDiscard
        export let shutdown = func(how: Shutdown) -> Result<Unit> {
            return Result<Unit>.Err(bytes.closed("stream", label)) unless open_now;
            return Result<Unit>.Err(write_failure()) unless write_error == 0;
            if (how != Shutdown.Write) {
                return Result<Unit>.Err(host_error.io(13 as uint32, "TLS read shutdown is unsupported", label));
            }
            if (not write_closed) {
                match (tls_shutdown_write(id, write_timeout_nanos)) {
                    host.DoneOutcome.Ok => {
                        write_closed = true;
                    },
                    host.DoneOutcome.Error(failure) => {
                        return Result<Unit>.Err(host_error.io(failure, "TLS write shutdown failed", label));
                    },
                }
            }
            return bytes.ok();
        };

        /// @brief Requires kernel record processing in both directions. Set `TlsConfigBuilder.set_kernel_offload`
        /// before the handshake. Returns Unsupported when the build, OS or negotiated cipher cannot offload.
        .NoDiscard
        export let enable_kernel_offload = func -> Result<Unit> {
            return Result<Unit>.Err(bytes.closed("stream", label)) unless open_now;
            return match (host.tls_enable_kernel_offload(id)) {
                host.DoneOutcome.Ok => bytes.ok(),
                host.DoneOutcome.Error(code) => Result<Unit>.Err(host_error.io(code, "kernel TLS failed", label)),
            };
        };

        /// @brief Releases the stream, sending `close_notify` if the record layer is still usable.
        /// Closing again returns Ok; the stream is closed even when the host reports an error.
        export let close = func -> Result<Unit> {
            return bytes.ok() unless open_now;
            open_now = false;
            return match (host.tls_close(id)) {
                host.DoneOutcome.Ok => bytes.ok(),
                host.DoneOutcome.Error(code) => Result<Unit>.Err(host_error.io(code, host_error.kind_of(code) == IoErrorKind.Unsupported
                    ? "TLS operation is unavailable in this runtime"
                    : "TLS close failed", label)),
            };
        };

        /// @brief Text such as "TlsStream(to 192.0.2.1:443, alpn h2)".
        export let.override to_string = func -> string {
            last side = match (peer) {
                Optional.Some(address) => "to " .. address.to_string(),
                Optional.None => "accepted on " .. label,
            };
            return "TlsStream(" .. side .. (alpn.byte_length > 0 ? ", alpn " .. alpn : "") .. ")";
        };
    );
);
