let.promote _ = import:Std.Net.Socket.DatagramSocket;
let.promote _ = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Result;
let.promote _ = import:Std.Core.Unit;
let.promote _ = import:Std.Net.Core.SocketAddr;
let.promote _ = import:Std.Net.Socket.StreamSocket;
let.promote _ = import:Std.Net.Tls.TlsConfig;
let.promote _ = import:Std.Net.Transport;
let bytes = import:Std.Io.Internal.Bytes;
let duration = import:Std.Time.Duration;
let errors = import:Std.Core.Error;
let host_error = import:Std.Core.Internal.HostError;
let system_clock = import:Std.Time.SystemClock;

/// @brief A TLS 1.3 record transport over a caller-supplied connected stream.
///
/// `tls13` wraps the stream using a host OpenSSL TLS 1.3 engine. The host consumes and produces TLS records;
/// the library sends and receives them through the caller's stream and owns that stream after starting a
/// handshake. The net capability is required, and explicit credentials require the fs capability. A nonzero
/// handshake timeout also uses the clock capability.
/// @see [Std.Net.Tls.Handshake](https://github.com/Kayyo321/neura/wiki/Stdlib-Net-Tls-Handshake)
.Since("0.3.0")
export let Handshake = module (
    let IdOutcome = enum (Ok(int64), Error(uint32));
    let StepOutcome = enum (Ok([int, uint8[list], uint8[list], uint32]), Error(uint32));
    let DoneOutcome = enum (Ok, Error(uint32));
    let engine_open = func(server: bool, name: string, alpn: string[list], ca: string, certificate: string,
        key: string) -> IdOutcome host("neura.net.tls.engine.open", 1);

    let engine_exchange = func(engine: int64, operation: int, inbound: uint8[list], message: uint8[list])
        -> StepOutcome host("neura.net.tls.engine.exchange", 1);

    let engine_release = func(engine: int64) -> DoneOutcome host("neura.net.tls.engine.release", 1);
    let DatagramStepOutcome = enum (Ok([int, uint8[list][list], uint8[list], int64, uint32]), Error(uint32));
    let datagram_open = func(server: bool, name: string, alpn: string[list], ca: string, certificate: string,
        key: string, local_host: string, local_port: int, peer_host: string, peer_port: int, timeout: int64)
        -> IdOutcome host("neura.net.dtls.engine.open", 1);

    let datagram_exchange = func(engine: int64, operation: int, inbound: uint8[list], sender_host: string,
        sender_port: int, message: uint8[list], timeout: int64) -> DatagramStepOutcome
        host("neura.net.dtls.engine.exchange", 1);

    let datagram_release = func(engine: int64) -> DoneOutcome host("neura.net.dtls.engine.release", 1);
    const HandshakeStep: int = 0;
    const ReadStep: int = 1;
    const WriteStep: int = 2;
    const CloseStep: int = 3;
    const AbandonStep: int = 5;
    const WantsInput: int = 0;
    const PeerClosed: int = 2;
    const RecordSize: int = 16384;

    .[Final, NotThreadSafe]
    let RecordTransport = class implements Transport<uint8[list], uint8[list]> (
        last id: int64;
        last wire: StreamSocket<SocketAddr>;
        let opened: bool = true;

        export let init = func(handle: int64, stream: StreamSocket<SocketAddr>) {
            id = handle;
            wire = stream;
        };

        export let handshake = func(timeout: duration.Duration) -> Result<Unit> {
            last original = wire.read_timeout();
            wire.set_read_timeout(duration.of_nanos(0));
            last outcome = process(HandshakeStep, new, timeout);
            wire.set_read_timeout(original);
            return match (outcome) {
                Result.Ok(_) => bytes.ok(),
                Result.Err(e) => Result<Unit>.Err(e),
            };
        };

        export let receive = func -> Result<Optional<uint8[list]>> {
            if (not opened) {
                return Result<Optional<uint8[list]>>.Err(bytes.closed("TLS stream", ""));
            }
            return process(ReadStep, new, duration.of_nanos(0));
        };

        export let send = func(data: uint8[list]) -> Result<Unit> {
            if (not opened) {
                return Result<Unit>.Err(bytes.closed("TLS stream", ""));
            }
            let from = 0;
            while (from < data.length) {
                last remaining = data.length - from;
                last length = remaining < RecordSize ? remaining : RecordSize;
                last chunk: uint8[list] = new;
                for (let i in 0 .. length) {
                    chunk.append(data[from + i]);
                }
                process(WriteStep, chunk, duration.of_nanos(0))?;
                from += length;
            }
            return bytes.ok();
        };

        export let close = func -> Result<Unit> {
            return bytes.ok() unless opened;
            last notified = process(CloseStep, new, duration.of_nanos(0));
            last released = abort();
            return match (notified) {
                Result.Ok(_) => released,
                Result.Err(e) => Result<Unit>.Err(e),
            };
        };

        export let abort = func -> Result<Unit> {
            opened = false;
            last released = engine_release(id);
            last closed = wire.close();
            return match (released) {
                DoneOutcome.Ok => closed,
                DoneOutcome.Error(code) => Result<Unit>.Err(host_error.io(code, "TLS engine release failed", "")),
            };
        };

        let process = func(operation: int, message: uint8[list], timeout: duration.Duration)
            -> Result<Optional<uint8[list]>> {
            last limit = timeout.to_nanos();
            last clock = system_clock.create();
            let start: int64 = 0;
            if (limit > 0) {
                start = (clock.monotonic()?).to_nanos();
            }
            let inbound: uint8[list] = new;
            while (true) {
                match (engine_exchange(id, operation, inbound, message)) {
                    StepOutcome.Error(code) => {
                        return Result<Optional<uint8[list]>>.Err(host_error.io(code, "TLS record processing failed", ""));
                    },
                    StepOutcome.Ok(exchange) => {
                        let [status, outgoing, received, failure] = exchange;
                        if (failure != 0) {
                            if (outgoing.length != 0) {
                                let _ = wire.write(outgoing);
                            }
                            return Result<Optional<uint8[list]>>.Err(host_error.io(failure,
                                "TLS record processing failed", ""));
                        }
                        if (outgoing.length != 0) {
                            wire.write(outgoing)?;
                        }
                        if (status == PeerClosed || operation == CloseStep) {
                            return Result<Optional<uint8[list]>>.Ok(Optional<uint8[list]>.None);
                        }
                        if (status != WantsInput) {
                            return Result<Optional<uint8[list]>>.Ok(Optional<uint8[list]>.Some(received));
                        }
                    },
                }
                if (limit > 0) {
                    last elapsed = (clock.monotonic()?).to_nanos() - start;
                    if (elapsed >= limit) {
                        return Result<Optional<uint8[list]>>.Err(host_error.io(12, "TLS handshake timed out", ""));
                    }
                    wire.set_read_timeout(duration.of_nanos(limit - elapsed));
                }
                inbound = wire.read(65536)?;
                if (inbound.length == 0) {
                    return Result<Optional<uint8[list]>>.Err(host_error.io(11, "TLS peer closed without close_notify", ""));
                }
            }
        };
    );

    /// @brief Completes a TLS 1.3 handshake over `stream` as the configured client or server. A client verifies
    /// the configured server name, or the peer's numeric address when the name is empty. Once the engine starts,
    /// this call owns the supplied stream, including closing it on handshake failure.
    .NoDiscard
    export let tls13 = func(config: TlsConfig, stream: StreamSocket<SocketAddr>)
        -> Result<Transport<uint8[list], uint8[list]>> {
        if (config.max_version != TlsVersion.Tls13 || config.kernel_offload) {
            return Result<Transport<uint8[list], uint8[list]>>.Err(errors.custom("tls.config",
                "stream TLS requires version 1.3 and does not use kernel offload"));
        }
        last server = config.role == TlsRole.Server;
        let name = config.server_name;
        if (not server && name.byte_length == 0) {
            match (stream.peer_address()) {
                Optional.Some(peer) => {
                    name = peer.host_text();
                },
                Optional.None => {
                    return Result<Transport<uint8[list], uint8[list]>>.Err(errors.custom("tls.config",
                        "a verified TLS client needs a server name or a numeric peer address"));
                },
            }
        }
        last ca = server ? config.client_ca_file : config.ca_file;
        match (engine_open(server, name, config.alpn(), ca, config.certificate_file, config.key_file)) {
            IdOutcome.Error(code) => {
                return Result<Transport<uint8[list], uint8[list]>>.Err(host_error.io(code, "TLS engine initialization failed", name));
            },
            IdOutcome.Ok(id) => {
                last transport = new RecordTransport(id, stream);
                match (transport.handshake(config.handshake_timeout)) {
                    Result.Ok(_) => {
                        return Result<Transport<uint8[list], uint8[list]>>.Ok(transport);
                    },
                    Result.Err(e) => {
                        transport.abort();
                        return Result<Transport<uint8[list], uint8[list]>>.Err(e);
                    },
                }
            },
        }
    };

    .[Final, NotThreadSafe]
    let DatagramTransport = class implements Transport<uint8[list], uint8[list]> (
        last id: int64;
        last wire: DatagramSocket<SocketAddr>;
        last peer: SocketAddr;
        let opened: bool = true;

        export let init = func(handle: int64, socket: DatagramSocket<SocketAddr>, address: SocketAddr) {
            id = handle;
            wire = socket;
            peer = address;
        };

        export let handshake = func(timeout: duration.Duration) -> Result<Unit> {
            process(HandshakeStep, new, timeout)?;
            return bytes.ok();
        };

        export let receive = func -> Result<Optional<uint8[list]>> => process(ReadStep, new, wire.read_timeout());

        export let send = func(data: uint8[list]) -> Result<Unit> {
            if (data.length > 1024) {
                return Result<Unit>.Err(host_error.io(4, "DTLS message exceeds 1024 bytes", peer.to_string()));
            }
            if (data.length == 0) {
                return opened ? bytes.ok() : Result<Unit>.Err(bytes.closed("DTLS transport", peer.to_string()));
            }
            process(WriteStep, data, duration.of_nanos(0))?;
            return bytes.ok();
        };

        export let close = func -> Result<Unit> {
            return bytes.ok() unless opened;
            last notified = process(CloseStep, new, duration.of_nanos(0));
            last released = abort();
            return match (notified) {
                Result.Ok(_) => released,
                Result.Err(e) => Result<Unit>.Err(e),
            };
        };

        export let abort = func -> Result<Unit> {
            return bytes.ok() unless opened;
            opened = false;
            last released = datagram_release(id);
            last closed = wire.close();
            return match (released) {
                DoneOutcome.Ok => closed,
                DoneOutcome.Error(code) => Result<Unit>.Err(host_error.io(code, "DTLS engine release failed", "")),
            };
        };

        let process = func(operation: int, message: uint8[list], timeout: duration.Duration)
            -> Result<Optional<uint8[list]>> {
            if (not opened) {
                return Result<Optional<uint8[list]>>.Err(bytes.closed("DTLS transport", peer.to_string()));
            }
            last original = wire.read_timeout();
            last outcome = process_wire(operation, message, timeout);
            wire.set_read_timeout(original);
            match (outcome) {
                Result.Err(_) => {
                    // A socket error leaves no operation pending in the host: a read
                    // stays usable, and an unfinished other operation ends the engine.
                    let _ = datagram_exchange(id, AbandonStep, new, "", 0, new, 0);
                },
                Result.Ok(_) => {},
            }
            return outcome;
        };

        let process_wire = func(operation: int, message: uint8[list], timeout: duration.Duration)
            -> Result<Optional<uint8[list]>> {
            let inbound: uint8[list] = new;
            let sender_host = "";
            let sender_port = 0;
            while (true) {
                match (datagram_exchange(id, operation, inbound, sender_host, sender_port, message, timeout.to_nanos())) {
                    DatagramStepOutcome.Error(code) => {
                        return Result<Optional<uint8[list]>>.Err(host_error.io(code, "DTLS processing failed", peer.to_string()));
                    },
                    DatagramStepOutcome.Ok(exchange) => {
                        let [status, outgoing, received, wait_nanos, failure] = exchange;
                        for (let packet in outgoing) {
                            // One host packet remains one UDP datagram, including handshake flights.
                            last sent = wire.send_to(packet, peer)?;
                            if (sent != packet.length) {
                                return Result<Optional<uint8[list]>>.Err(host_error.io(11, "short DTLS datagram send", peer.to_string()));
                            }
                        }
                        if (failure != 0) {
                            return Result<Optional<uint8[list]>>.Err(host_error.io(failure, "DTLS processing failed", peer.to_string()));
                        }
                        if (status == PeerClosed || operation == CloseStep) {
                            return Result<Optional<uint8[list]>>.Ok(Optional<uint8[list]>.None);
                        }
                        if (status != WantsInput) {
                            return Result<Optional<uint8[list]>>.Ok(Optional<uint8[list]>.Some(received));
                        }
                        if (wait_nanos == 0) {
                            // The host drained BIO backpressure; retry without
                            // re-enqueueing the packet or waiting for a peer.
                            inbound = new;
                            sender_host = "";
                            sender_port = 0;
                            continue;
                        }
                        wire.set_read_timeout(duration.of_nanos(wait_nanos));
                    },
                }
                inbound = new;
                sender_host = "";
                sender_port = 0;
                match (wire.receive_from(65535)) {
                    Result.Ok(packet) => {
                        match (packet.sender) {
                            Optional.Some(sender) => {
                                inbound = packet.data;
                                sender_host = sender.host_text();
                                sender_port = sender.port;
                            },
                            Optional.None => {},
                        }
                    },
                    Result.Err(e) => {
                        // A receive timer is a protocol timer tick, not a fresh deadline.
                        // The host keeps the operation's original absolute expiry.
                        match (e) {
                            errors.Error.Io { kind, message: text, path } => {
                                if (kind != errors.IoErrorKind.TimedOut) {
                                    return Result<Optional<uint8[list]>>.Err(e);
                                }
                            },
                            _ => {
                                return Result<Optional<uint8[list]>>.Err(e);
                            },
                        }
                    },
                }
            }
        };
    );

    /// @brief Runs DTLS 1.3 with a fixed numeric peer over a bound datagram socket. A client verifies
    /// `server_name`, or the peer IP when empty; a server validates address cookies before accepting.
    /// Takes ownership of the socket after the engine opens, including closing it on handshake failure.
    /// Messages are at most 1,024 bytes and retain their boundaries. Unexpected senders are dropped.
    /// Every operation has one absolute deadline: the configured handshake timeout, the socket's read timeout
    /// for receive, or 30 seconds for send/close; a zero timeout uses 30 seconds. Timers drive retransmissions.
    /// A receive that times out or fails on the socket leaves the association usable; a handshake, send or
    /// close that times out or fails ends it.
    /// Requires net; explicit credential files also require fs. DTLS never uses kernel TLS offload.
    .[NoDiscard, Since("0.3.1")]
    export let dtls13 = func(config: TlsConfig, socket: DatagramSocket<SocketAddr>, peer: SocketAddr)
        -> Result<Transport<uint8[list], uint8[list]>> {
        if (config.max_version != TlsVersion.Tls13 || config.kernel_offload) {
            return Result<Transport<uint8[list], uint8[list]>>.Err(errors.custom("tls.config",
                "DTLS requires version 1.3 and does not use kernel offload"));
        }
        last local = socket.local_address()?;
        last server = config.role == TlsRole.Server;
        last name = config.server_name.byte_length == 0 ? peer.host_text() : config.server_name;
        last ca = server ? config.client_ca_file : config.ca_file;
        match (datagram_open(server, name, config.alpn(), ca, config.certificate_file, config.key_file,
            local.host_text(), local.port, peer.host_text(), peer.port, config.handshake_timeout.to_nanos())) {
            IdOutcome.Error(code) => {
                return Result<Transport<uint8[list], uint8[list]>>.Err(host_error.io(code, "DTLS engine initialization failed", name));
            },
            IdOutcome.Ok(id) => {
                last transport = new DatagramTransport(id, socket, peer);
                match (transport.handshake(config.handshake_timeout)) {
                    Result.Ok(_) => {
                        return Result<Transport<uint8[list], uint8[list]>>.Ok(transport);
                    },
                    Result.Err(e) => {
                        let _ = transport.abort();
                        return Result<Transport<uint8[list], uint8[list]>>.Err(e);
                    },
                }
            },
        }
    };
);
