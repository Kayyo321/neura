let bytes = import:Std.Io.Internal.Bytes;
let duration = import:Std.Time.Duration;
let error = import:Std.Core.Error;
let host = import:Std.Net.Socket.Internal.HostCalls;
let host_error = import:Std.Core.Internal.HostError;
let optional = import:Std.Core.Optional;
let system_clock = import:Std.Time.SystemClock;
let tls_config = import:Std.Net.Tls.TlsConfig;
let uri = import:Std.Net.Core.Uri;
let hashing = import:Std.Core.Hash;
let header_map = import:Std.Net.Http.Headers;
let.promote _ = import:Std.Core.Result;
let strings = import:Std.Text.Strings;
let.promote _ = import:Std.Core.Unit;

/// @brief HTTP/2 (RFC 9113) wire data: the connection preface, frame types and flags, settings and error codes,
/// and the codecs of the 9-octet frame header and the SETTINGS payload, bounded TLS frame output and HPACK.
///
/// The frame header is Length (24), Type (8), Flags (8), Reserved (1), Stream Identifier (31) (section 4.1); the
/// reserved bit is ignored on receipt and never sent. A SETTINGS payload is a sequence of 6-octet entries, a
/// 16-bit identifier and a 32-bit value (section 6.5.1); `decode_settings` applies the value checks of section
/// 6.5.2 and RFC 8441 section 3 and reports a violation as `error.custom(<HTTP/2 error name>, <reason>)`.
/// Unknown identifiers are kept (receivers ignore them). Opening a connection needs TCP and TLS with ALPN "h2"
/// from the runtime. HPACK uses the pinned nghttp2 host codec when HTTP/2 is enabled; otherwise it returns
/// Unsupported. Each codec call is an independent field section: dynamic table state is not shared across
/// calls. Connection control and framing stay in the circuit; this low-level sender does not manage streams
/// or consume peer SETTINGS. It conservatively sends at most the initial 16,384-byte maximum per frame.
/// @see [Std.Net.Http.H2](https://github.com/Kayyo321/neura/wiki/Stdlib-Net-Http-H2)
.Since("0.3.0")
export let H2 = module (
    /// @brief The client connection preface, "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n" (section 3.4).
    export const Preface: string = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n";

    /// @brief The size of a frame header in octets (section 4.1).
    export const FrameHeaderSize: int = 9;

    /// @brief DATA, 0x00 (section 6.1).
    export const FrameData: int = 0;
    /// @brief HEADERS, 0x01 (section 6.2).
    export const FrameHeaders: int = 1;
    /// @brief PRIORITY, 0x02 (section 6.3, deprecated).
    export const FramePriority: int = 2;
    /// @brief RST_STREAM, 0x03 (section 6.4).
    export const FrameRstStream: int = 3;
    /// @brief SETTINGS, 0x04 (section 6.5).
    export const FrameSettings: int = 4;
    /// @brief PUSH_PROMISE, 0x05 (section 6.6).
    export const FramePushPromise: int = 5;
    /// @brief PING, 0x06 (section 6.7).
    export const FramePing: int = 6;
    /// @brief GOAWAY, 0x07 (section 6.8).
    export const FrameGoaway: int = 7;
    /// @brief WINDOW_UPDATE, 0x08 (section 6.9).
    export const FrameWindowUpdate: int = 8;
    /// @brief CONTINUATION, 0x09 (section 6.10).
    export const FrameContinuation: int = 9;

    /// @brief Flag END_STREAM (DATA, HEADERS) and ACK (SETTINGS, PING), 0x01.
    export const FlagEndStream: int = 1;
    /// @brief Flag ACK of SETTINGS and PING, 0x01 (sections 6.5, 6.7).
    export const FlagAck: int = 1;
    /// @brief Flag END_HEADERS, 0x04 (sections 6.2, 6.6, 6.10).
    export const FlagEndHeaders: int = 4;
    /// @brief Flag PADDED, 0x08 (sections 6.1, 6.2, 6.6).
    export const FlagPadded: int = 8;
    /// @brief Flag PRIORITY of HEADERS, 0x20 (section 6.2).
    export const FlagPriority: int = 32;

    /// @brief SETTINGS_HEADER_TABLE_SIZE, 0x01; initial value 4,096 (section 6.5.2).
    export const SettingHeaderTableSize: int = 1;
    /// @brief SETTINGS_ENABLE_PUSH, 0x02; initial value 1, only 0 or 1.
    export const SettingEnablePush: int = 2;
    /// @brief SETTINGS_MAX_CONCURRENT_STREAMS, 0x03; initially unlimited.
    export const SettingMaxConcurrentStreams: int = 3;
    /// @brief SETTINGS_INITIAL_WINDOW_SIZE, 0x04; initial value 65,535, at most 2^31-1.
    export const SettingInitialWindowSize: int = 4;
    /// @brief SETTINGS_MAX_FRAME_SIZE, 0x05; initial value 16,384, 16,384 through 16,777,215.
    export const SettingMaxFrameSize: int = 5;
    /// @brief SETTINGS_MAX_HEADER_LIST_SIZE, 0x06; initially unlimited.
    export const SettingMaxHeaderListSize: int = 6;
    /// @brief SETTINGS_ENABLE_CONNECT_PROTOCOL, 0x08; only 0 or 1 (RFC 8441 section 3).
    export const SettingEnableConnectProtocol: int = 8;

    /// @brief The initial SETTINGS_HEADER_TABLE_SIZE.
    export const InitialHeaderTableSize: int64 = 4096;
    /// @brief The initial SETTINGS_INITIAL_WINDOW_SIZE, 2^16-1.
    export const InitialWindowSize: int64 = 65535;
    /// @brief The initial and smallest SETTINGS_MAX_FRAME_SIZE, 2^14.
    export const MinMaxFrameSize: int64 = 16384;
    /// @brief The largest SETTINGS_MAX_FRAME_SIZE and frame length, 2^24-1.
    export const MaxFrameLength: int64 = 16777215;
    /// @brief The largest flow-control window, 2^31-1.
    export const MaxWindowSize: int64 = 2147483647;

    /// @brief NO_ERROR, 0x00 (section 7).
    export const ErrorNoError: int = 0;
    /// @brief PROTOCOL_ERROR, 0x01.
    export const ErrorProtocol: int = 1;
    /// @brief INTERNAL_ERROR, 0x02.
    export const ErrorInternal: int = 2;
    /// @brief FLOW_CONTROL_ERROR, 0x03.
    export const ErrorFlowControl: int = 3;
    /// @brief SETTINGS_TIMEOUT, 0x04.
    export const ErrorSettingsTimeout: int = 4;
    /// @brief STREAM_CLOSED, 0x05.
    export const ErrorStreamClosed: int = 5;
    /// @brief FRAME_SIZE_ERROR, 0x06.
    export const ErrorFrameSize: int = 6;
    /// @brief REFUSED_STREAM, 0x07.
    export const ErrorRefusedStream: int = 7;
    /// @brief CANCEL, 0x08.
    export const ErrorCancel: int = 8;
    /// @brief COMPRESSION_ERROR, 0x09.
    export const ErrorCompression: int = 9;
    /// @brief CONNECT_ERROR, 0x0a.
    export const ErrorConnect: int = 10;
    /// @brief ENHANCE_YOUR_CALM, 0x0b.
    export const ErrorEnhanceYourCalm: int = 11;
    /// @brief INADEQUATE_SECURITY, 0x0c.
    export const ErrorInadequateSecurity: int = 12;
    /// @brief HTTP_1_1_REQUIRED, 0x0d.
    export const ErrorHttp11Required: int = 13;

    /// @brief A frame header (section 4.1).
    .[Final, Immutable, ThreadSafe]
    export let FrameHeader = class (
        /// @brief The payload length, 0 through 2^24-1.
        export last length: int;
        /// @brief The frame type, 0 through 255.
        export last frame_type: int;
        /// @brief The flags, 0 through 255.
        export last flags: int;
        /// @brief The stream identifier, 0 through 2^31-1.
        export last stream_id: int64;

        /// @brief Stores the fields; `encode_frame_header` checks their ranges.
        export let init = func(size: int, kind: int, flag_bits: int, stream: int64) {
            length = size;
            frame_type = kind;
            flags = flag_bits;
            stream_id = stream;
        };

        /// @brief Whether every bit of `flag` is set.
        export let has_flag = func(flag: int) -> bool => (flags & flag) == flag;

        /// @brief Equal fields.
        export let.override equals = func(other: class) -> bool {
            if (other is not that: FrameHeader) {
                return false;
            }
            return length == that.length && frame_type == that.frame_type && flags == that.flags
                && stream_id == that.stream_id;
        };

        /// @brief Combines the fields.
        export let.override hash_code = func -> uint32 => hashing.combine(17, strings.hash(to_string()));

        /// @brief The fields by name.
        export let.override to_string = func -> string =>
            "FrameHeader{length=" .. length.to_string() .. ", type=" .. frame_type.to_string() .. ", flags="
            .. flags.to_string() .. ", stream=" .. stream_id.to_string() .. "}";
    );

    /// @brief The identifiers and values of a SETTINGS frame, in order.
    .[Final, NotThreadSafe]
    export let Settings = class (
        /// @brief The identifiers, 0 through 65,535.
        export last ids: int[list] = new;
        /// @brief The values, 0 through 2^32-1, parallel to `ids`.
        export last values: int64[list] = new;

        /// @brief An empty list.
        export let init = func {
        };

        /// @brief Appends a setting. Traps with "invalid argument: setting" when the identifier or value does
        /// not fit 16 or 32 bits.
        export let add = func(id: int, value: int64) {
            if (id < 0 || id > 65535 || value < 0 || value > 4294967295) {
                trap_with_message("invalid argument: setting");
            }
            ids.append(id);
            values.append(value);
        };

        /// @brief The last value of `id` (later entries override earlier ones, section 6.5.3), or `fallback`.
        export let get_or = func(id: int, fallback: int64) -> int64 {
            let found = fallback;
            for (let i = 0; i < ids.length; i++) {
                if (ids[i] == id) {
                    found = values[i];
                }
            }
            return found;
        };

        /// @brief Equal settings in the same order.
        export let.override equals = func(other: class) -> bool {
            if (other is not that: Settings) {
                return false;
            }
            return to_string() == that.to_string();
        };

        /// @brief The hash of the text form.
        export let.override hash_code = func -> uint32 => hashing.combine(17, strings.hash(to_string()));

        /// @brief "Settings{id=value, ...}".
        export let.override to_string = func -> string {
            let text = "Settings{";
            for (let i = 0; i < ids.length; i++) {
                if (i > 0) {
                    text ..= ", ";
                }
                text ..= ids[i].to_string() .. "=" .. values[i].to_string();
            }
            return text .. "}";
        };
    );

    /// @brief The preface as bytes.
    .[NoDiscard, Pure, ThreadSafe]
    export let preface_bytes = func -> uint8[list] {
        last bytes: uint8[list] = new;
        for (let i = 0; i < Preface.byte_length; i++) {
            bytes.append(Preface.byte_at(i));
        }
        return bytes;
    };

    /// @brief The 9 octets of `header`, the reserved bit unset. Traps with "invalid argument: frame header" when
    /// a field is out of range.
    .[NoDiscard]
    export let encode_frame_header = func(header: FrameHeader) -> uint8[list] {
        if (header.length < 0 || (header.length as int64) > MaxFrameLength || header.frame_type < 0
            || header.frame_type > 255 || header.flags < 0 || header.flags > 255 || header.stream_id < 0
            || header.stream_id > MaxWindowSize) {
            trap_with_message("invalid argument: frame header");
        }
        last bytes: uint8[list] = new;
        bytes.append((header.length >> 16) as uint8);
        bytes.append(((header.length >> 8) & 255) as uint8);
        bytes.append((header.length & 255) as uint8);
        bytes.append(header.frame_type as uint8);
        bytes.append(header.flags as uint8);
        last stream = header.stream_id;
        bytes.append((stream >> 24) as uint8);
        bytes.append(((stream >> 16) & 255) as uint8);
        bytes.append(((stream >> 8) & 255) as uint8);
        bytes.append((stream & 255) as uint8);
        return bytes;
    };

    /// @brief The frame header at `offset`; the reserved bit is ignored. Err (UnexpectedEnd) when fewer than 9
    /// bytes remain.
    .[NoDiscard]
    export let decode_frame_header = func(bytes: uint8[list], offset: int) -> Result<FrameHeader> {
        if (offset < 0 || offset + FrameHeaderSize > bytes.length) {
            return Result<FrameHeader>.Err(error.Error.Parse {
                kind: error.ParseErrorKind.UnexpectedEnd, offset: bytes.length, message: "truncated frame header" });
        }
        last length = ((bytes[offset] as int) << 16) | ((bytes[offset + 1] as int) << 8) | (bytes[offset + 2] as int);
        last stream = (((bytes[offset + 5] & 127) as int64) << 24) | ((bytes[offset + 6] as int64) << 16)
            | ((bytes[offset + 7] as int64) << 8) | (bytes[offset + 8] as int64);
        return Result<FrameHeader>.Ok(
            new FrameHeader(length, bytes[offset + 3] as int, bytes[offset + 4] as int, stream));
    };

    /// @brief The SETTINGS payload holding `settings` in order (section 6.5.1).
    .[NoDiscard]
    export let encode_settings = func(settings: Settings) -> uint8[list] {
        last bytes: uint8[list] = new;
        for (let i = 0; i < settings.ids.length; i++) {
            last id = settings.ids[i];
            last value = settings.values[i];
            bytes.append((id >> 8) as uint8);
            bytes.append((id & 255) as uint8);
            bytes.append((value >> 24) as uint8);
            bytes.append(((value >> 16) & 255) as uint8);
            bytes.append(((value >> 8) & 255) as uint8);
            bytes.append((value & 255) as uint8);
        }
        return bytes;
    };

    /// @brief The settings of a SETTINGS payload. Errors are `error.custom` with the HTTP/2 error name as the
    /// code: FRAME_SIZE_ERROR for a length that is not a multiple of 6 (section 6.5); PROTOCOL_ERROR for
    /// ENABLE_PUSH or ENABLE_CONNECT_PROTOCOL other than 0 or 1, or MAX_FRAME_SIZE outside 16,384 through
    /// 16,777,215; FLOW_CONTROL_ERROR for INITIAL_WINDOW_SIZE above 2^31-1 (section 6.5.2).
    .[NoDiscard]
    export let decode_settings = func(payload: uint8[list]) -> Result<Settings> {
        if (payload.length % 6 != 0) {
            return Result<Settings>.Err(error.custom("FRAME_SIZE_ERROR", "SETTINGS length is not a multiple of 6"));
        }
        last settings = new Settings();
        for (let at = 0; at < payload.length; at += 6) {
            last id = ((payload[at] as int) << 8) | (payload[at + 1] as int);
            last value = ((payload[at + 2] as int64) << 24) | ((payload[at + 3] as int64) << 16)
                | ((payload[at + 4] as int64) << 8) | (payload[at + 5] as int64);
            if ((id == SettingEnablePush || id == SettingEnableConnectProtocol) && value > 1) {
                return Result<Settings>.Err(
                    error.custom("PROTOCOL_ERROR", "setting " .. id.to_string() .. " must be 0 or 1"));
            }
            if (id == SettingInitialWindowSize && value > MaxWindowSize) {
                return Result<Settings>.Err(error.custom("FLOW_CONTROL_ERROR", "initial window size above 2^31-1"));
            }
            if (id == SettingMaxFrameSize && (value < MinMaxFrameSize || value > MaxFrameLength)) {
                return Result<Settings>.Err(error.custom("PROTOCOL_ERROR", "max frame size out of range"));
            }
            settings.add(id, value);
        }
        return Result<Settings>.Ok(settings);
    };

    let Seal = enum (Value);
    let EncodedOutcome = enum (Ok(uint8[list]), Error(uint32));
    let FieldsOutcome = enum (Ok(string[list]), Error(uint32));
    let encode_fields = func(fields: string[list]) -> EncodedOutcome host("neura.http.hpack.encode", 1);
    let decode_fields = func(block: uint8[list]) -> FieldsOutcome host("neura.http.hpack.decode", 1);
    let connect_tls = func(target: string, port: int, timeout: int64, name: string, protocols: string[list],
        ca_file: string, minimum: int, maximum: int, certificate: string, key: string, offload: bool) -> host.TlsOutcome
        host("neura.net.tls.connect_overlapped", 1);

    let write_tls = func(stream: int64, data: uint8[list], timeout: int64) -> host.CountOutcome
        host("neura.net.tls.write_overlapped", 1);

    let read_tls = func(stream: int64, maximum: int, timeout: int64) -> host.BytesOutcome
        host("neura.net.tls.read_overlapped", 1);

    let shutdown_tls = func(stream: int64, timeout: int64) -> host.DoneOutcome
        host("neura.net.tls.shutdown_write_overlapped", 1);

    /// @brief A low-level HTTP/2 frame sender over a verified TLS connection. It does not read peer frames,
    /// acknowledge their settings, enforce stream lifecycle, or multiplex requests; `Http.Fetch` owns that driver.
    .[Final, NotThreadSafe]
    export let H2Connection = class (
        /// @brief The authority the connection was opened to.
        export last authority: string;
        last id: int64;
        last timeout_nanos: int64;
        let open_now: bool = true;

        /// @brief Created only by `connect` or `connect_with`.
        export let init = func(seal: Seal, target: string, stream: int64, timeout: int64) {
            authority = target;
            id = stream;
            timeout_nanos = timeout;
        };

        /// @brief Writes one complete frame within the connection's positive per-operation deadline.
        /// A write waiting on TLS lets other tasks run.
        /// Length/payload disagreements and fixed-size frame violations return FRAME_SIZE_ERROR; invalid
        /// stream identifiers return PROTOCOL_ERROR. Frames remain limited to 16,384 payload bytes.
        .[Since("0.3.1"), NoDiscard]
        export let send_frame = func(header: FrameHeader, payload: uint8[list]) -> Result<Unit> {
            return Result<Unit>.Err(bytes.closed("HTTP/2 connection", authority)) unless open_now;
            validate_frame(header, payload)?;
            last start = (system_clock.create().monotonic()?).to_nanos();
            match (write_bytes(id, frame_bytes(header, payload), start, timeout_nanos, authority)) {
                Result.Ok(_) => {
                    return bytes.ok();
                },
                Result.Err(failure) => {
                    // A partial frame cannot be retried safely on the same stream.
                    let _ = abort();
                    return Result<Unit>.Err(failure);
                },
            }
        };

        /// @brief Sends GOAWAY with last-stream-id zero, sends close_notify and discards inbound data until
        /// peer close_notify, within one deadline. TLS waits let other tasks run. Releases TLS on success
        /// or failure. Closing again succeeds.
        /// A negative `error_code` returns InvalidInput without closing.
        .[Since("0.3.1"), NoDiscard]
        export let close = func(error_code: int) -> Result<Unit> {
            return bytes.ok() unless open_now;
            if (error_code < 0) {
                return Result<Unit>.Err(host_error.io(4, "negative HTTP/2 error code", authority));
            }
            last notified = close_wire(error_code);
            last released = abort();
            return match (notified) {
                Result.Ok(_) => released,
                Result.Err(failure) => Result<Unit>.Err(failure),
            };
        };

        let close_wire = func(error_code: int) -> Result<Unit> {
            last start = (system_clock.create().monotonic()?).to_nanos();
            last payload: uint8[list] = new([0, 0, 0, 0, (error_code >> 24) as uint8,
                ((error_code >> 16) & 255) as uint8, ((error_code >> 8) & 255) as uint8, (error_code & 255) as uint8]);
            last wire = frame_bytes(new FrameHeader(8, FrameGoaway, 0, 0), payload);
            write_bytes(id, wire, start, timeout_nanos, authority)?;
            return finish_shutdown(id, start, timeout_nanos, authority);
        };

        let abort = func -> Result<Unit> {
            return bytes.ok() unless open_now;
            open_now = false;
            return match (host.tls_close(id)) {
                host.DoneOutcome.Ok => bytes.ok(),
                host.DoneOutcome.Error(code) => Result<Unit>.Err(host_error.io(code, "TLS close failed", authority)),
            };
        };

        /// @brief The authority.
        export let.override to_string = func -> string => "H2Connection{" .. authority .. "}";
    );

    let frame_bytes = func(header: FrameHeader, payload: uint8[list]) -> uint8[list] {
        last wire = encode_frame_header(header);
        for (let b in payload) {
            wire.append(b);
        }
        return wire;
    };

    let write_bytes = func(id: int64, data: uint8[list], start: int64, budget: int64, authority: string)
        -> Result<Unit> {
        last clock = system_clock.create();
        let offset = 0;
        while (offset < data.length) {
            last remaining_bytes = bytes.copy_range(data, offset, data.length);
            last remaining = budget - ((clock.monotonic()?).to_nanos() - start);
            if (remaining <= 0) {
                return Result<Unit>.Err(host_error.io(12, "HTTP/2 write timed out", authority));
            }
            match (write_tls(id, remaining_bytes, remaining)) {
                host.CountOutcome.Ok(count) => {
                    if (count <= 0 || count > data.length - offset) {
                        return Result<Unit>.Err(host_error.io(11, "invalid TLS write count", authority));
                    }
                    offset += count;
                },
                host.CountOutcome.Error(code) => {
                    return Result<Unit>.Err(host_error.io(code, "HTTP/2 write failed", authority));
                },
            }
        }
        return bytes.ok();
    };

    let finish_shutdown = func(id: int64, start: int64, budget: int64, authority: string) -> Result<Unit> {
        last clock = system_clock.create();
        last shutdown_budget = budget - ((clock.monotonic()?).to_nanos() - start);
        if (shutdown_budget <= 0) {
            return Result<Unit>.Err(host_error.io(12, "HTTP/2 close timed out", authority));
        }
        match (shutdown_tls(id, shutdown_budget)) {
            host.DoneOutcome.Error(code) => {
                return Result<Unit>.Err(host_error.io(code, "HTTP/2 TLS shutdown failed", authority));
            },
            host.DoneOutcome.Ok => {},
        }
        while (true) {
            last remaining = budget - ((clock.monotonic()?).to_nanos() - start);
            if (remaining <= 0) {
                return Result<Unit>.Err(host_error.io(12, "HTTP/2 close timed out", authority));
            }
            match (read_tls(id, 16384, remaining)) {
                host.BytesOutcome.Ok(data) => {
                    if (data.length == 0) {
                        return bytes.ok();
                    }
                },
                host.BytesOutcome.Error(code) => {
                    return Result<Unit>.Err(host_error.io(code, "HTTP/2 TLS close failed", authority));
                },
            }
        }
    };

    /// @brief Opens verified TLS with ALPN h2 and system trust, then writes the preface and SETTINGS.
    /// The complete connect operation has a thirty-second deadline. Network waits park the calling task
    /// while other tasks run. Needs net and clock capabilities.
    .[Since("0.3.1"), NoDiscard]
    export let connect = func(authority: string, settings: Settings) -> Result<H2Connection> {
        last builder = tls_config.builder();
        builder.set_alpn(new(["h2"]));
        builder.set_handshake_timeout(duration.of_seconds(30));
        return connect_with(authority, settings, builder.build_client()?);
    };

    /// @brief As `connect`, with explicit trust/credentials and a positive total handshake/preface deadline.
    /// `config` must be a client configuration offering exactly h2. Later sends use the same duration as a
    /// fresh per-operation deadline. Explicit trust/credential files also require the fs capability.
    .[Since("0.3.1"), NoDiscard]
    export let connect_with = func(authority: string, settings: Settings, config: tls_config.TlsConfig)
        -> Result<H2Connection> {
        last protocols = config.alpn();
        last budget = config.handshake_timeout.to_nanos();
        if (config.role != tls_config.TlsRole.Client || protocols.length != 1 || protocols[0] != "h2" || budget <= 0) {
            return Result<H2Connection>.Err(error.custom("h2.config", "client ALPN h2 and a positive deadline are required"));
        }
        if (settings.ids.length != settings.values.length) {
            return Result<H2Connection>.Err(error.custom("FRAME_SIZE_ERROR", "settings lists disagree"));
        }
        for (let i in 0 .. settings.ids.length) {
            if (settings.ids[i] < 0 || settings.ids[i] > 65535 || settings.values[i] < 0 || settings.values[i] > 4294967295) {
                return Result<H2Connection>.Err(error.custom("PROTOCOL_ERROR", "setting outside wire range"));
            }
        }
        last payload = encode_settings(settings);
        decode_settings(payload)?;
        validate_frame(new FrameHeader(payload.length, FrameSettings, 0, 0), payload)?;
        last parsed = uri.parse("https://" .. authority .. "/")?;
        if (optional.value_or<string>(parsed.authority(), "") != authority || optional.is_some<string>(parsed.userinfo)
            || parsed.path != "/" || optional.is_some<string>(parsed.query) || optional.is_some<string>(parsed.fragment)) {
            return Result<H2Connection>.Err(error.custom("h2.authority", "expected a host and optional port"));
        }
        last normalized = parsed.normalize()?;
        last target = normalized.decoded_host()?;
        if (target.byte_length == 0) {
            return Result<H2Connection>.Err(error.custom("h2.authority", "empty host"));
        }
        last port = optional.value_or<int>(normalized.port, 443);
        last name = config.server_name.byte_length == 0 ? target : config.server_name;
        last clock = system_clock.create();
        last start = (clock.monotonic()?).to_nanos();
        last opened = connect_tls(target, port, budget, name, protocols, config.ca_file,
            config.min_version == tls_config.TlsVersion.Tls12 ? 12 : 13,
            config.max_version == tls_config.TlsVersion.Tls12 ? 12 : 13,
            config.certificate_file, config.key_file, config.kernel_offload);
        match (opened) {
            host.TlsOutcome.Error(code) => {
                return Result<H2Connection>.Err(host_error.io(code, "HTTP/2 TLS connect failed", authority));
            },
            host.TlsOutcome.Ok(connection) => {
                let [id, selected] = connection;
                if (selected != "h2") {
                    match (clock.monotonic()) {
                        Result.Ok(now) => {
                            last remaining = budget - (now.to_nanos() - start);
                            if (remaining > 0) {
                                let _ = shutdown_tls(id, remaining);
                            }
                        },
                        Result.Err(_) => {},
                    }
                    let _ = host.tls_close(id);
                    return Result<H2Connection>.Err(error.custom("h2.alpn", "peer did not negotiate h2"));
                }
                last wire = preface_bytes();
                for (let b in frame_bytes(new FrameHeader(payload.length, FrameSettings, 0, 0), payload)) {
                    wire.append(b);
                }
                match (write_bytes(id, wire, start, budget, authority)) {
                    Result.Ok(_) => {
                        return Result<H2Connection>.Ok(new H2Connection(Seal.Value, authority, id, budget));
                    },
                    Result.Err(failure) => {
                        let _ = host.tls_close(id);
                        return Result<H2Connection>.Err(failure);
                    },
                }
            },
        }
    };

    /// @brief Compresses regular header fields as an independent HPACK block. Names are lowercased.
    /// Unlike the former stub, encoding returns a Result. See `hpack_encode_fields` for limits and state.
    .[Since("0.3.1"), NoDiscard]
    export let hpack_encode = func(fields: header_map.Headers) -> Result<uint8[list]> {
        last pairs: [string, string][list] = new;
        for (let i in 0 .. fields.size()) {
            pairs.append([strings.to_ascii_lower(fields.name_at(i)), fields.value_at(i)]);
        }
        return hpack_encode_fields(pairs);
    };

    /// @brief Decodes regular fields into Headers. A pseudo-header returns PROTOCOL_ERROR rather than
    /// reaching Headers' token-name trap; use `hpack_decode_fields` for complete HTTP/2 field sections.
    .[Since("0.3.1"), NoDiscard]
    export let hpack_decode = func(block: uint8[list]) -> Result<header_map.Headers> {
        last fields = hpack_decode_fields(block)?;
        last headers: header_map.Headers = new;
        for (let field in fields) {
            let [name, value] = field;
            if (not header_map.is_token(name) || not header_map.is_valid_value(value)) {
                return Result<header_map.Headers>.Err(error.custom("PROTOCOL_ERROR", "field cannot be represented by Headers"));
            }
            headers.add(name, value);
        }
        return Result<header_map.Headers>.Ok(headers);
    };

    /// @brief Compresses lowercase name/value pairs, including pseudo-header names. Each call uses a new
    /// encoder with dynamic table size zero and no indexing. At most 256 fields and 65,536 total name/value
    /// bytes or encoded bytes; a conservative encoder allocation bound also applies. Invalid field text is
    /// PROTOCOL_ERROR, limits are hpack.limit, and an HTTP/2-disabled provider returns typed Unsupported.
    .[Since("0.3.1"), NoDiscard]
    export let hpack_encode_fields = func(fields: [string, string][list]) -> Result<uint8[list]> {
        // Host collections carry scalar text elements. Keep tuple conversion
        // in the library so the public API retains its name/value pairs.
        last flat: string[list] = new;
        for (let field in fields) {
            let [name, value] = field;
            flat.append(name);
            flat.append(value);
        }
        return match (encode_fields(flat)) {
            EncodedOutcome.Ok(block) => Result<uint8[list]>.Ok(block),
            EncodedOutcome.Error(code) => Result<uint8[list]>.Err(codec_error(code, "PROTOCOL_ERROR")),
        };
    };

    /// @brief Decodes a complete independent block with an initial 4,096-byte dynamic table, including RFC
    /// 7541 Huffman strings and table references created within this block. No table state survives a call.
    /// Bounds are those of `hpack_encode_fields`; malformed text/encoding is COMPRESSION_ERROR.
    .[Since("0.3.1"), NoDiscard]
    export let hpack_decode_fields = func(block: uint8[list]) -> Result<[string, string][list]> {
        match (decode_fields(block)) {
            FieldsOutcome.Ok(fields) => {
                if (fields.length % 2 != 0) {
                    return Result<[string, string][list]>.Err(
                        error.custom("COMPRESSION_ERROR", "HPACK host returned an incomplete name/value pair"));
                }
                last pairs: [string, string][list] = new;
                for (let i = 0; i < fields.length; i += 2) {
                    pairs.append([fields[i], fields[i + 1]]);
                }
                return Result<[string, string][list]>.Ok(pairs);
            },
            FieldsOutcome.Error(code) => {
                return Result<[string, string][list]>.Err(codec_error(code, "COMPRESSION_ERROR"));
            },
        }
    };

    let codec_error = func(code: uint32, invalid: string) -> error.Error {
        if (code == 4) {
            return error.custom(invalid, "invalid HPACK field section");
        }
        if (code == 16) {
            return error.custom("hpack.limit", "HPACK field section exceeds its size limit");
        }
        return host_error.io(code, "HPACK codec unavailable or failed", "");
    };

    let validate_frame = func(header: FrameHeader, payload: uint8[list]) -> Result<Unit> {
        if (header.length != payload.length || header.length < 0 || header.length > 16384) {
            return Result<Unit>.Err(error.custom("FRAME_SIZE_ERROR", "payload length disagrees or exceeds 16,384"));
        }
        if (header.frame_type < 0 || header.frame_type > 255 || header.flags < 0 || header.flags > 255
            || header.stream_id < 0 || header.stream_id > MaxWindowSize) {
            return Result<Unit>.Err(error.custom("PROTOCOL_ERROR", "frame header outside wire range"));
        }
        last kind = header.frame_type;
        if (((kind == FrameData || kind == FrameHeaders || kind == FramePriority || kind == FrameRstStream
            || kind == FramePushPromise || kind == FrameContinuation) && header.stream_id == 0)
            || ((kind == FrameSettings || kind == FramePing || kind == FrameGoaway) && header.stream_id != 0)) {
            return Result<Unit>.Err(error.custom("PROTOCOL_ERROR", "invalid stream identifier for frame type"));
        }
        if ((kind == FramePriority && header.length != 5) || (kind == FrameRstStream && header.length != 4)
            || (kind == FramePing && header.length != 8) || (kind == FrameGoaway && header.length < 8)
            || (kind == FrameWindowUpdate && header.length != 4)
            || (kind == FrameSettings && ((header.has_flag(FlagAck) && header.length != 0) || header.length % 6 != 0))) {
            return Result<Unit>.Err(error.custom("FRAME_SIZE_ERROR", "invalid fixed-size frame payload"));
        }
        if (kind == FrameSettings && not header.has_flag(FlagAck)) {
            decode_settings(payload)?;
        }
        if (kind == FrameWindowUpdate && ((payload[0] & 127) | payload[1] | payload[2] | payload[3]) == 0) {
            return Result<Unit>.Err(error.custom("PROTOCOL_ERROR", "zero window increment"));
        }
        return bytes.ok();
    };
);
