let.promote _ = import:Std.Core.Error;
let host_error = import:Std.Core.Internal.HostError;
let optional = import:Std.Core.Optional;
let result = import:Std.Core.Result;
let strings = import:Std.Text.Strings;
let.promote _ = import:Std.Time.Duration;

/// @brief HTTP requests through the host's `neura.http.fetch` service, version 1 (docs/runtime/Providers.md,
/// "HTTP fetch"). In a browser the request is the browser's own `fetch`, so the browser decides origins, CORS,
/// cookies, redirects and caching; the host checks the request and enforces the limits W-3 (8 MiB for a request
/// or response body) and W-4 (16 fetches in flight).
///
/// Native fetch requires `http_client`, an absolute HTTP(S) URL, and an available TLS provider for HTTPS.
/// It verifies the peer and its name against the runner's configured trust store, applies a single deadline
/// across redirects, and uses no ambient cookie jar or authentication state.
///
/// A response with any status, 404 and 500 included, is `Ok`: the status is the server's answer. `Err` means
/// there is no answer. Its I/O kind is InvalidInput for a malformed request, TimedOut when the timeout passed,
/// Unsupported for a scheme other than http and https, CapabilityDenied when the host does not grant the
/// `http_client` group or the origin, and Cancelled when the calling task's scope was cancelled. Three
/// failures have no I/O kind and are custom errors with the codes `http.TooLarge`, `http.Busy` and
/// `http.OutcomeUnknown`; `failure_of` classifies every error. OutcomeUnknown is a network failure or a refusal
/// the browser does not explain (CORS among them): the server may or may not have acted on the request.
///
/// `send` overlaps in a program with tasks: the calling task waits and the others run. Without tasks the
/// program waits for the answer. Native runs grant the group with `--allow-http-client`.
.Since("0.3.0")
export let Fetch = module (
    /// @brief Whether the browser sends cookies and HTTP authentication with the request.
    .Since("0.3.0")
    export let Credentials = enum (Omit, SameOrigin, Include);

    /// @brief Why a fetch produced no response.
    .Since("0.3.0")
    export let FetchFailure = enum (
        InvalidInput, TimedOut, Unsupported, CapabilityDenied, Cancelled, TooLarge, Busy, OutcomeUnknown, Other
    );

    /// @brief The host's answer: status, headers as alternating names and values, and body, or a host error
    /// code.
    let FetchOutcome = enum (Ok([uint32, string[list], uint8[list]]), Error(uint32));
    /// @brief Sends one request. Arguments: method, URL, headers as alternating names and values, body, timeout
    /// in nanoseconds (0 selects the native 30-second default), credentials mode (0 omit, 1 same-origin, 2 include).
    let fetch = func(method: string, url: string, headers: string[list], body: uint8[list], timeout: int64,
        credentials: uint32) -> FetchOutcome host("neura.http.fetch", 1);

    /// @brief The default timeout of a request, 30 seconds, as for generated clients.
    export const DefaultTimeoutSeconds: int64 = 30;

    /// @brief An HTTP response: the status, the header pairs the host exposes (in a browser, lowercase names,
    /// and for a cross-origin response only those CORS exposes), and the body bytes.
    .[Final, Since("0.3.0")]
    export let Response = class (
        /// @brief The HTTP status code.
        export last status: int;
        /// @brief The response body.
        export last body: uint8[list];
        last pairs: [string, string][list];

        /// @brief Creates a response from its parts.
        export let init = func(code: int, header_pairs: [string, string][list], bytes: uint8[list]) {
            status = code;
            pairs = header_pairs;
            body = bytes;
        };

        /// @brief Whether the status is 200 to 299.
        .Pure
        export let ok = func -> bool => status >= 200 && status <= 299;

        /// @brief The header pairs in the host's order.
        .Pure
        export let headers = func -> [string, string][list] {
            last copy: [string, string][list] = new;
            for (let pair in pairs) {
                copy.append(pair);
            }
            return copy;
        };

        /// @brief The value of the first header with this name, compared without regard to ASCII case.
        .Pure
        export let header = func(name: string) -> optional.Optional<string> {
            for (let pair in pairs) {
                if (strings.equals_ignore_ascii_case(pair[0], name)) {
                    return optional.Optional<string>.Some(pair[1]);
                }
            }
            return optional.Optional<string>.None;
        };

        /// @brief The body as UTF-8 text, or an Encoding error.
        .NoDiscard
        export let text = func -> result.Result<string> => strings.from_bytes(body);

        /// @brief The status and the body's size.
        .Pure
        export let.override to_string = func -> string =>
            "Response(" .. status.to_string() .. ", " .. body.length.to_string() .. " bytes)";
    );

    /// @brief A request to send: a method, a URL (absolute, or relative to the page in a browser), headers, a
    /// body, a timeout and a credentials mode. Each `with_` member returns a new request.
    .[Final, Since("0.3.0")]
    export let Request = class (
        /// @brief The method, such as GET or POST.
        export last method: string;
        /// @brief The URL.
        export last url: string;
        /// @brief The body; empty for none.
        export last body: uint8[list];
        /// @brief The longest the exchange may take. Zero or less uses the host's default.
        export last timeout: Duration;
        /// @brief The credentials mode.
        export last credentials: Credentials;
        last pairs: [string, string][list];

        /// @brief Creates a request from all of its parts.
        export let init = func(verb: string, target: string, header_pairs: [string, string][list], bytes: uint8[list],
            limit: Duration, mode: Credentials) {
            method = verb;
            url = target;
            pairs = header_pairs;
            body = bytes;
            timeout = limit;
            credentials = mode;
        };

        /// @brief The header pairs in the order they were added.
        .Pure
        export let headers = func -> [string, string][list] => copy_pairs(pairs);

        /// @brief The same request with one more header.
        .Pure
        export let with_header = func(name: string, value: string) -> Request {
            last more = copy_pairs(pairs);
            more.append([name, value]);
            return new(method, url, more, body, timeout, credentials);
        };

        /// @brief The same request with this body.
        .Pure
        export let with_body = func(bytes: uint8[list]) -> Request =>
            new(method, url, pairs, bytes, timeout, credentials);

        /// @brief The same request with a text body and a Content-Type header.
        .Pure
        export let with_text = func(content_type: string, text: string) -> Request {
            last more = copy_pairs(pairs);
            more.append(["Content-Type", content_type]);
            return new(method, url, more, strings.to_bytes(text), timeout, credentials);
        };

        /// @brief The same request with this timeout.
        .Pure
        export let with_timeout = func(limit: Duration) -> Request => new(method, url, pairs, body, limit, credentials);

        /// @brief The same request with this credentials mode.
        .Pure
        export let with_credentials = func(mode: Credentials) -> Request =>
            new(method, url, pairs, body, timeout, mode);

        /// @brief Sends the request and waits for the response.
        .NoDiscard
        export let send = func -> result.Result<Response> {
            last nanos = timeout.to_nanos();
            return match (fetch(method, url, flatten(pairs), body, nanos < 0 ? 0 : nanos, mode_code(credentials))) {
                FetchOutcome.Ok(answer) =>
                    result.Result<Response>.Ok(new Response(answer[0] as int, pair_up(answer[1]), answer[2])),
                FetchOutcome.Error(code) => result.Result<Response>.Err(error_of(code, method .. " " .. url)),
            };
        };

        /// @brief The method and URL.
        .Pure
        export let.override to_string = func -> string => method .. " " .. url;
    );

    /// @brief A request with no headers or body, the default timeout, and same-origin credentials.
    .Pure
    export let request = func(method: string, url: string) -> Request {
        last none: [string, string][list] = new;
        last empty: uint8[list] = new;
        return new Request(method, url, none, empty, of_seconds(DefaultTimeoutSeconds), Credentials.SameOrigin);
    };

    /// @brief Sends a GET request with the defaults of `request`.
    .NoDiscard
    export let get = func(url: string) -> result.Result<Response> => request("GET", url).send();

    /// @brief Sends a POST request with a text body of the content type, and the defaults of `request`.
    .NoDiscard
    export let post_text = func(url: string, content_type: string, text: string) -> result.Result<Response> =>
        request("POST", url).with_text(content_type, text).send();

    /// @brief Classifies an error that `send` returned; any other error is Other.
    .Pure
    export let failure_of = func(e: Error) -> FetchFailure => match (e) {
        Error.Io { kind, message: _, path: _ } => failure_of_kind(kind),
        Error.Custom(detail) => failure_of_code(detail.code()),
        _ => FetchFailure.Other,
    };

    .Pure
    let failure_of_kind = func(kind: IoErrorKind) -> FetchFailure => match (kind) {
        IoErrorKind.InvalidInput => FetchFailure.InvalidInput,
        IoErrorKind.TimedOut => FetchFailure.TimedOut,
        IoErrorKind.Unsupported => FetchFailure.Unsupported,
        IoErrorKind.CapabilityDenied => FetchFailure.CapabilityDenied,
        IoErrorKind.Cancelled => FetchFailure.Cancelled,
        _ => FetchFailure.Other,
    };

    .Pure
    let failure_of_code = func(code: string) -> FetchFailure {
        if (code == "http.TooLarge") {
            return FetchFailure.TooLarge;
        }
        if (code == "http.Busy") {
            return FetchFailure.Busy;
        }
        return if (code == "http.OutcomeUnknown") -> FetchFailure.OutcomeUnknown
            else -> FetchFailure.Other;
    };

    /// @brief The error of a host code: codes 1 to 15 are I/O errors, 16 to 18 the custom errors above.
    .Pure
    let error_of = func(code: uint32, what: string) -> Error {
        if (code == 16) {
            return custom("http.TooLarge", what .. ": a body exceeds the host's limit");
        }
        if (code == 17) {
            return custom("http.Busy", what .. ": too many fetches are in flight");
        }
        return if (code == 18) -> custom("http.OutcomeUnknown", what .. ": no response; the server may have acted")
            else -> host_error.io(code, "fetch failed", what);
    };

    .Pure
    let mode_code = func(mode: Credentials) -> uint32 => match (mode) {
        Credentials.Omit => 0,
        Credentials.SameOrigin => 1,
        Credentials.Include => 2,
    };

    /// @brief Header pairs as the host takes them: name, value, name, value.
    .Pure
    let flatten = func(pairs: [string, string][list]) -> string[list] {
        last flat: string[list] = new;
        for (let pair in pairs) {
            flat.append(pair[0]);
            flat.append(pair[1]);
        }
        return flat;
    };

    /// @brief Header pairs from the host's alternating names and values; an odd last name is dropped.
    .Pure
    let pair_up = func(flat: string[list]) -> [string, string][list] {
        last pairs: [string, string][list] = new;
        for (let i: int = 0; i + 1 < flat.length; i += 2) {
            pairs.append([flat[i], flat[i + 1]]);
        }
        return pairs;
    };

    .Pure
    let copy_pairs = func(pairs: [string, string][list]) -> [string, string][list] {
        last copy: [string, string][list] = new;
        for (let pair in pairs) {
            copy.append(pair);
        }
        return copy;
    };
);
