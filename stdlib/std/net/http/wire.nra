let builders = import:Std.Core.StringBuilder;
let errors = import:Std.Core.Error;
let hashing = import:Std.Core.Hash;
let http_headers = import:Std.Net.Http.Headers;
let http_status = import:Std.Net.Http.Status;
let.promote _ = import:Std.Core.Result;
let.promote _ = import:Std.Core.Unit;
let strings = import:Std.Text.Strings;

/// @brief HTTP/1.1 message syntax (RFC 9112): request and response heads, their limits, incremental head reading,
/// body framing and head serialization.
///
/// A head is the start-line, the field lines and the empty line that ends them. Parsing works on the head's bytes,
/// which must be UTF-8 (so a field value may hold obs-text only as UTF-8; other bytes are 400). Lines are split at
/// the byte level after the UTF-8 check, where an LF can only be a line end (RFC 9112 section 2.2). A line ends in
/// CRLF; a single LF is accepted as well unless `Limits.allow_bare_lf` is false (RFC 9112 section 2.2 lets a
/// recipient recognize it). A bare CR is invalid (400). Empty lines before a start-line are ignored (RFC 9112
/// section 2.2).
///
/// A message the parser refuses is `Result.Err` holding `errors.custom("http.status.NNN", message)`, NNN being the
/// status a server answers with; `rejection_status` reads it back. For a response head the same codes name the
/// kind of fault. When several faults are present, the first found wins, in this order: head size (431), UTF-8
/// and line ends (400), start-line (400), version (505), method not known (501), field lines in order (400, and
/// 431 at the field past the limit), Host (400), Transfer-Encoding with HTTP/1.0 or with Content-Length (400),
/// transfer codings (501, 400), Content-Length (400), Content-Length over the body limit (413).
/// @see [Std.Net.Http.Wire](https://github.com/Kayyo321/neura/wiki/Stdlib-Net-Http-Wire)
#Since("0.3.0")
export let Wire = module (
    /// @brief How the length of a message body is found (RFC 9112 section 6.3).
    export let BodyFraming = enum (
        /// @brief No body follows the head.
        None,
        /// @brief Exactly this many bytes follow (Content-Length).
        Length(int64),
        /// @brief The body is in the chunked transfer coding (RFC 9112 section 7.1).
        Chunked,
        /// @brief A response body that ends when the server closes the connection.
        UntilClose
    );

    /// @brief The limits a recipient applies to a message. Read-only once built.
    ///
    /// The defaults are those of the server host: a 16,384-byte head (Apps030 `S-5`), 100 header fields, a
    /// 1,048,576-byte body (`S-6`), a 4,096-byte chunk-size line with its extensions, a 16,384-byte trailer section,
    /// bare LF accepted in heads, and the nine standard methods as the known ones.
    #[Final, Immutable, ThreadSafe]
    export let Limits = class (
        /// @brief The most bytes of a head, empty line and ignored leading empty lines included.
        export last max_head_bytes: int;
        /// @brief The most field lines of a head or trailer section.
        export last max_header_fields: int;
        /// @brief The most bytes of a message body (Content-Length or decoded chunked data).
        export last max_body_bytes: int64;
        /// @brief The most bytes of one chunk-size line, extensions included, CRLF excluded.
        export last max_chunk_line_bytes: int;
        /// @brief The most bytes of a chunked trailer section, its empty line included.
        export last max_trailer_bytes: int;
        /// @brief Whether a single LF ends a head line (RFC 9112 section 2.2).
        export last allow_bare_lf: bool;
        /// @brief The methods a server implements, each followed by one space; others are 501.
        last methods: string;

        /// @brief The default limits.
        export let init = func {
            max_head_bytes = 16384;
            max_header_fields = 100;
            max_body_bytes = 1048576;
            max_chunk_line_bytes = 4096;
            max_trailer_bytes = 16384;
            allow_bare_lf = true;
            methods = StandardMethods;
        }
        /// @brief The given head, field and body limits and the other defaults. Each must be positive; otherwise
        /// traps with "invalid argument: <name>".
        or func(head_bytes: int, header_fields: int, body_bytes: int64) {
            check_positive(head_bytes as int64, "head_bytes");
            check_positive(header_fields as int64, "header_fields");
            check_positive(body_bytes, "body_bytes");
            max_head_bytes = head_bytes;
            max_header_fields = header_fields;
            max_body_bytes = body_bytes;
            max_chunk_line_bytes = 4096;
            max_trailer_bytes = 16384;
            allow_bare_lf = true;
            methods = StandardMethods;
        }
        /// @brief Every limit given. The numbers must be positive and each method a token; otherwise traps with
        /// "invalid argument: <name>".
        or func(head_bytes: int, header_fields: int, body_bytes: int64, chunk_line_bytes: int, trailer_bytes: int,
                bare_lf: bool, known_methods: string[]) {
            check_positive(head_bytes as int64, "head_bytes");
            check_positive(header_fields as int64, "header_fields");
            check_positive(body_bytes, "body_bytes");
            check_positive(chunk_line_bytes as int64, "chunk_line_bytes");
            check_positive(trailer_bytes as int64, "trailer_bytes");
            max_head_bytes = head_bytes;
            max_header_fields = header_fields;
            max_body_bytes = body_bytes;
            max_chunk_line_bytes = chunk_line_bytes;
            max_trailer_bytes = trailer_bytes;
            allow_bare_lf = bare_lf;
            let known = "";
            for (let m in known_methods) {
                if (!http_headers.is_token(m)) {
                    trap_with_message("invalid argument: known_methods");
                }
                known = known + m + " ";
            }
            methods = known;
        };

        /// @brief Whether `method` (exact case) is one the server implements.
        export let knows_method = func(method: string) -> bool =>
            http_headers.is_token(method) && strings.contains(" " + methods, " " + method + " ");

        /// @brief Equal when every limit and the known methods (in order) are equal.
        export let.override equals = func(other: class) -> bool {
            if (!(other is Limits)) {
                return false;
            }
            last limits = other as Limits;
            return max_head_bytes == limits.max_head_bytes && max_header_fields == limits.max_header_fields
                && max_body_bytes == limits.max_body_bytes && max_chunk_line_bytes == limits.max_chunk_line_bytes
                && max_trailer_bytes == limits.max_trailer_bytes && allow_bare_lf == limits.allow_bare_lf
                && methods == limits.methods;
        };

        /// @brief Combines every limit and the known methods.
        export let.override hash_code = func -> uint32 {
            let hash = hashing.combine(17, max_head_bytes as uint32);
            hash = hashing.combine(hash, max_header_fields as uint32);
            hash = hashing.combine(hash, hashing.of_int64(max_body_bytes));
            hash = hashing.combine(hash, max_chunk_line_bytes as uint32);
            hash = hashing.combine(hash, max_trailer_bytes as uint32);
            hash = hashing.combine(hash, hashing.of_bool(allow_bare_lf));
            return hashing.combine(hash, strings.hash(methods));
        };

        /// @brief The limits as text.
        export let.override to_string = func -> string {
            last known = strings.trim(methods);
            return $"Limits{{head={max_head_bytes}, fields={max_header_fields}, body={max_body_bytes}, "
                + $"chunk_line={max_chunk_line_bytes}, trailer={max_trailer_bytes}, bare_lf={allow_bare_lf}, "
                + $"methods={known}}}";
        };
    );

    /// @brief A request's start-line and header fields (RFC 9112 section 3).
    #[Final, NotThreadSafe]
    export let RequestHead = class (
        /// @brief The method token, exact case.
        export last method: string;
        /// @brief The request-target as sent.
        export last target: string;
        /// @brief The HTTP-version text, "HTTP/1.1" or "HTTP/1.0".
        export last version: string;
        /// @brief The header fields; the map is shared, not copied.
        export last headers: http_headers.Headers;

        /// @brief A head of the given parts. Traps with "invalid argument: <name>" when the method is not a token,
        /// the target is empty or holds a byte outside visible ASCII, or the version is not "HTTP/" DIGIT "." DIGIT.
        export let init = func(method_text: string, target_text: string, version_text: string,
                fields: http_headers.Headers) {
            if (!http_headers.is_token(method_text)) {
                trap_with_message("invalid argument: method");
            }
            if (!is_target(target_text)) {
                trap_with_message("invalid argument: target");
            }
            if (version_major(version_text) < 0) {
                trap_with_message("invalid argument: version");
            }
            method = method_text;
            target = target_text;
            version = version_text;
            headers = fields;
        };

        /// @brief The minor version digit.
        export let minor_version = func -> int => version_minor(version);

        /// @brief Equal parts and equal header maps.
        export let.override equals = func(other: class) -> bool {
            if (!(other is RequestHead)) {
                return false;
            }
            last head = other as RequestHead;
            return method == head.method && target == head.target && version == head.version
                && headers.equals(head.headers);
        };

        /// @brief Combines the parts and the header map.
        export let.override hash_code = func -> uint32 {
            let hash: uint32 = 17;
            hash = hashing.combine(hash, strings.hash(method));
            hash = hashing.combine(hash, strings.hash(target));
            hash = hashing.combine(hash, strings.hash(version));
            return hashing.combine(hash, headers.hash_code());
        };

        /// @brief The request-line and the header map.
        export let.override to_string = func -> string =>
            "RequestHead{" + method + " " + target + " " + version + ", " + headers.to_string() + "}";
    );

    /// @brief A response's status-line and header fields (RFC 9112 section 4).
    #[Final, NotThreadSafe]
    export let ResponseHead = class (
        /// @brief The HTTP-version text.
        export last version: string;
        /// @brief The status code, 100 through 599.
        export last status: int;
        /// @brief The reason phrase, possibly empty.
        export last reason: string;
        /// @brief The header fields; the map is shared, not copied.
        export last headers: http_headers.Headers;

        /// @brief A head of the given parts. Traps with "invalid argument: <name>" when the version is not
        /// "HTTP/" DIGIT "." DIGIT, the status is outside 100 through 599, or the reason holds a control byte other
        /// than tab.
        export let init = func(version_text: string, status_code: int, reason_text: string,
                fields: http_headers.Headers) {
            if (version_major(version_text) < 0) {
                trap_with_message("invalid argument: version");
            }
            if (!http_status.is_valid(status_code)) {
                trap_with_message("invalid argument: status");
            }
            if (!http_headers.is_valid_value(reason_text)) {
                trap_with_message("invalid argument: reason");
            }
            version = version_text;
            status = status_code;
            reason = reason_text;
            headers = fields;
        };

        /// @brief The minor version digit.
        export let minor_version = func -> int => version_minor(version);

        /// @brief Equal parts and equal header maps.
        export let.override equals = func(other: class) -> bool {
            if (!(other is ResponseHead)) {
                return false;
            }
            last head = other as ResponseHead;
            return version == head.version && status == head.status && reason == head.reason
                && headers.equals(head.headers);
        };

        /// @brief Combines the parts and the header map.
        export let.override hash_code = func -> uint32 {
            let hash: uint32 = 17;
            hash = hashing.combine(hash, strings.hash(version));
            hash = hashing.combine(hash, status as uint32);
            hash = hashing.combine(hash, strings.hash(reason));
            return hashing.combine(hash, headers.hash_code());
        };

        /// @brief The status-line and the header map.
        export let.override to_string = func -> string =>
            "ResponseHead{" + version + " " + status.to_string() + " " + reason + ", " + headers.to_string() + "}";
    );

    /// @brief Collects bytes until a complete head is buffered, enforcing the head limit as they arrive.
    ///
    /// The head ends at the first empty line after a non-empty line; empty lines before the start-line are part of
    /// the head and ignored by the parsers. Bytes after the head are kept as the remainder. A head with no end
    /// within `max_head_bytes` fails as soon as the buffer passes that size (431), so an endless head fails at the
    /// limit plus one byte. After a failure every `feed` returns the same error.
    #[Final, NotThreadSafe]
    export let HeadReader = class (
        /// @brief The limits applied.
        last limits: Limits;
        /// @brief Every byte received.
        last buffer: uint8[list] = new;
        /// @brief The next byte to examine.
        let scan: int = 0;
        /// @brief The offset of the line being examined.
        let line_start: int = 0;
        /// @brief Whether a non-empty line has ended.
        let seen_line: bool = false;
        /// @brief The length of the head, or -1 while incomplete.
        let head_end: int = -1;
        /// @brief Whether the head limit was passed.
        let failed: bool = false;

        /// @brief A reader with the default limits.
        export let init = func {
            limits = new Limits();
        }
        /// @brief A reader with the given limits.
        or func(applied: Limits) {
            limits = applied;
        };

        /// @brief Adds received bytes. Ok(true) once a complete head is buffered (later bytes join the remainder);
        /// Ok(false) while more are needed; 431 when the head passes `max_head_bytes`.
        #NoDiscard
        export let feed = func(chunk: uint8[list]) -> Result<bool> {
            if (failed) {
                return too_large<bool>(limits.max_head_bytes);
            }
            for (let b in chunk) {
                buffer.append(b);
            }
            if (head_end >= 0) {
                return Result<bool>.Ok(true);
            }
            while (scan < buffer.length) {
                if (buffer[scan] == 10) {
                    last length = scan - line_start;
                    last empty = length == 0 || (length == 1 && buffer[line_start] == 13);
                    if (empty && seen_line) {
                        head_end = scan + 1;
                        scan++;
                        break;
                    }
                    if (!empty) {
                        seen_line = true;
                    }
                    line_start = scan + 1;
                }
                scan++;
            }
            if (head_end < 0) {
                if (buffer.length > limits.max_head_bytes) {
                    failed = true;
                    return too_large<bool>(limits.max_head_bytes);
                }
                return Result<bool>.Ok(false);
            }
            if (head_end > limits.max_head_bytes) {
                failed = true;
                return too_large<bool>(limits.max_head_bytes);
            }
            return Result<bool>.Ok(true);
        };

        /// @brief Whether a complete head is buffered.
        export let is_complete = func -> bool => head_end >= 0;

        /// @brief The head's bytes, empty line included, as a new list. Traps with "invalid state: head is not
        /// complete" before `feed` returned Ok(true).
        #NoDiscard
        export let head_bytes = func -> uint8[list] {
            check_complete();
            return copy_range(buffer, 0, head_end);
        };

        /// @brief The buffered head parsed as a request head. Traps as `head_bytes` does when incomplete.
        #NoDiscard
        export let request_head = func -> Result<RequestHead> => parse_request_head(head_bytes(), limits);

        /// @brief The buffered head parsed as a response head. Traps as `head_bytes` does when incomplete.
        #NoDiscard
        export let response_head = func -> Result<ResponseHead> => parse_response_head(head_bytes(), limits);

        /// @brief The bytes received after the head, as a new list. Traps as `head_bytes` does when incomplete.
        #NoDiscard
        export let remainder = func -> uint8[list] {
            check_complete();
            return copy_range(buffer, head_end, buffer.length);
        };

        /// @brief The reader's progress as text.
        export let.override to_string = func -> string =>
            $"HeadReader{{buffered={buffer.length}, head={head_end}, failed={failed}}}";

        /// @brief Traps unless the head is complete.
        let check_complete = func {
            if (head_end < 0) {
                trap_with_message("invalid state: head is not complete");
            }
        };
    );

    /// @brief The error a server answers with `status`: a custom error whose code is "http.status.NNN".
    #[NoDiscard, Pure, ThreadSafe]
    export let rejection = func(status: int, message: string) -> errors.Error =>
        errors.custom("http.status." + status.to_string(), message);

    /// @brief The status of an error made by `rejection`, or 0 for any other error.
    #[Pure, ThreadSafe]
    export let rejection_status = func(e: errors.Error) -> int => match (e) {
        errors.Error.Custom(detail) => status_of_code(detail.code()),
        _ => 0,
    };

    /// @brief Parses the bytes of a request head, from the start-line (after any empty lines) through the empty
    /// line, against `limits`.
    ///
    /// Rejections: a head longer than `max_head_bytes` (431); a head that is not UTF-8, has a bare CR, a bare LF
    /// when not allowed, bytes after the empty line, or no empty line (400, RFC 9112 section 2.2); a request-line
    /// that is not method SP request-target SP HTTP-version, or a target with a byte outside visible ASCII (400,
    /// RFC 9112 section 3); a method that is not a token (400) or not known by `limits` (501); a version that is
    /// well formed but not HTTP/1.x (505); a field line with leading whitespace, i.e. obs-fold or whitespace after
    /// the start-line (400, RFC 9112 sections 5.2 and 2.2); whitespace between field name and colon (400, RFC 9112
    /// section 5.1); a field name that is not a token or a value with a control byte (400); more than
    /// `max_header_fields` fields (431); a missing Host (in HTTP/1.0 too, as the Backend030 host rule says), more than one Host, or a Host value that is
    /// not a host and port (400, RFC 9112 section 3.2); Transfer-Encoding in HTTP/1.0 (400, RFC 9112 section 6.1);
    /// both Transfer-Encoding and Content-Length (400, RFC 9112 section 6.3 item 3); a transfer coding other than
    /// chunked (501, RFC 9112 section 6.1); chunked twice, with parameters, or an empty Transfer-Encoding (400,
    /// RFC 9112 section 7.1); a Content-Length that is not digits, or a list of differing values (400, RFC 9112
    /// section 6.3 item 5); a Content-Length over `max_body_bytes` (413).
    #NoDiscard
    export let parse_request_head = func(bytes: uint8[list], limits: Limits) -> Result<RequestHead> {
        last lines = head_lines(bytes, limits)?;
        last start = first_line(lines);
        last line = lines[start];
        last first_space = index_of_byte(line, 32, 0);
        last second_space = first_space < 0 ? -1 : index_of_byte(line, 32, first_space + 1);
        if (first_space <= 0 || second_space <= first_space + 1 || index_of_byte(line, 32, second_space + 1) >= 0) {
            return fail<RequestHead>(400, "malformed request-line");
        }
        last method = line.slice(0, first_space);
        last target = line.slice(first_space + 1, second_space);
        last version = line.slice(second_space + 1, line.byte_length);
        if (!http_headers.is_token(method)) {
            return fail<RequestHead>(400, "method is not a token");
        }
        if (!is_target(target)) {
            return fail<RequestHead>(400, "malformed request-target");
        }
        last major = version_major(version);
        if (major < 0) {
            return fail<RequestHead>(400, "malformed HTTP-version");
        }
        if (major != 1) {
            return fail<RequestHead>(505, "HTTP version " + version + " is not supported");
        }
        if (!limits.knows_method(method)) {
            return fail<RequestHead>(501, "method " + method + " is not implemented");
        }
        last fields = fields_from_lines(lines, start + 1, lines.length - 1, limits, false)?;
        last hosts = fields.get_all("Host");
        if (hosts.length > 1) {
            return fail<RequestHead>(400, "more than one Host field");
        }
        if (hosts.length == 0) {
            return fail<RequestHead>(400, "missing Host field");
        }
        if (hosts.length == 1 && !is_host_value(hosts[0])) {
            return fail<RequestHead>(400, "invalid Host field value");
        }
        if (fields.contains("Transfer-Encoding")) {
            if (version_minor(version) == 0) {
                return fail<RequestHead>(400, "Transfer-Encoding in an HTTP/1.0 message");
            }
            if (fields.contains("Content-Length")) {
                return fail<RequestHead>(400, "both Transfer-Encoding and Content-Length");
            }
        }
        last head = new RequestHead(method, target, version, fields);
        last framing = request_body_length(head)?;
        match (framing) {
            BodyFraming.Length(n) => {
                if (n > limits.max_body_bytes) {
                    return fail<RequestHead>(413, $"Content-Length {n} is over the limit of {limits.max_body_bytes}");
                }
            },
            _ => {},
        }
        return Result<RequestHead>.Ok(head);
    }
    /// @brief `parse_request_head` with the default limits.
    or func(bytes: uint8[list]) -> Result<RequestHead> {
        return parse_request_head(bytes, new Limits());
    };

    /// @brief Parses the bytes of a response head through the empty line, against `limits`.
    ///
    /// The checks are those of `parse_request_head` that apply to a status-line: head size (431), UTF-8 and line
    /// ends (400), a status-line that is not HTTP-version SP 3DIGIT [SP reason-phrase], a code outside 100 through
    /// 599 or a reason with a control byte (400, RFC 9112 section 4), a version that is not HTTP/1.x (505),
    /// whitespace after the status-line (400, RFC 9112 section 2.2), field syntax (400), the field count (431),
    /// Transfer-Encoding with HTTP/1.0 or with Content-Length (400) and an invalid Content-Length (400). Unlike a
    /// request, an obs-fold is replaced by one space (RFC 9112 section 5.2) and whitespace between a field name and
    /// its colon is removed (RFC 9112 section 5.1); a missing space after the code is accepted. Host, method and
    /// body-size rules do not apply.
    #NoDiscard
    export let parse_response_head = func(bytes: uint8[list], limits: Limits) -> Result<ResponseHead> {
        last lines = head_lines(bytes, limits)?;
        last start = first_line(lines);
        last line = lines[start];
        last space = index_of_byte(line, 32, 0);
        if (space <= 0) {
            return fail<ResponseHead>(400, "malformed status-line");
        }
        last version = line.slice(0, space);
        last major = version_major(version);
        if (major < 0) {
            return fail<ResponseHead>(400, "malformed HTTP-version");
        }
        if (major != 1) {
            return fail<ResponseHead>(505, "HTTP version " + version + " is not supported");
        }
        if (line.byte_length < space + 4 || (line.byte_length > space + 4 && line.byte_at(space + 4) != 32)) {
            return fail<ResponseHead>(400, "malformed status-code");
        }
        let status = 0;
        for (let i = space + 1; i < space + 4; i++) {
            last b = line.byte_at(i);
            if (b < 48 || b > 57) {
                return fail<ResponseHead>(400, "malformed status-code");
            }
            status = status * 10 + ((b - 48) as int);
        }
        if (!http_status.is_valid(status)) {
            return fail<ResponseHead>(400, "status-code outside 100 through 599");
        }
        last reason = line.byte_length > space + 4 ? line.slice(space + 5, line.byte_length) : "";
        if (!http_headers.is_valid_value(reason)) {
            return fail<ResponseHead>(400, "control character in reason-phrase");
        }
        last fields = fields_from_lines(lines, start + 1, lines.length - 1, limits, true)?;
        if (fields.contains("Transfer-Encoding")) {
            if (version_minor(version) == 0) {
                return fail<ResponseHead>(400, "Transfer-Encoding in an HTTP/1.0 message");
            }
            if (fields.contains("Content-Length")) {
                return fail<ResponseHead>(400, "both Transfer-Encoding and Content-Length");
            }
        } else if (fields.contains("Content-Length")) {
            content_length(fields)?;
        }
        return Result<ResponseHead>.Ok(new ResponseHead(version, status, reason, fields));
    }
    /// @brief `parse_response_head` with the default limits.
    or func(bytes: uint8[list]) -> Result<ResponseHead> {
        return parse_response_head(bytes, new Limits());
    };

    /// @brief Parses a field section: field lines, each ending in CRLF (or a single LF when `limits` allows),
    /// without the empty line that ends the section. Used for trailer sections and multipart part heads.
    ///
    /// Errors as for the fields of a head: 400 for a bad line end, an empty line, a line without a colon, a name
    /// that is not a token, whitespace before the colon (removed instead when `lenient`), a value with a control
    /// byte, or a line with leading whitespace (unfolded into the previous value instead when `lenient`, except on
    /// the first line); 431 past `max_header_fields`.
    #NoDiscard
    export let parse_field_section = func(text: string, limits: Limits, lenient: bool) -> Result<http_headers.Headers> {
        last lines = split_lines(text, limits.allow_bare_lf)?;
        return fields_from_lines(lines, 0, lines.length, limits, lenient);
    };

    /// @brief The framing of a request's body (RFC 9112 section 6.3 items 3 to 7): Chunked when
    /// Transfer-Encoding is present (it must be exactly "chunked": another coding is 501, chunked twice or with
    /// parameters is 400), else Length for a valid Content-Length (400 otherwise), else None.
    #NoDiscard
    export let request_body_length = func(head: RequestHead) -> Result<BodyFraming> {
        if (head.headers.contains("Transfer-Encoding")) {
            last chunked = chunked_last(head.headers, true)?;
            if (!chunked) {
                return fail<BodyFraming>(400, "chunked is not the final transfer coding");
            }
            return Result<BodyFraming>.Ok(BodyFraming.Chunked);
        }
        if (head.headers.contains("Content-Length")) {
            last n = content_length(head.headers)?;
            return Result<BodyFraming>.Ok(BodyFraming.Length(n));
        }
        return Result<BodyFraming>.Ok(BodyFraming.None);
    };

    /// @brief The framing of a response's body (RFC 9112 section 6.3) given the method of its request: None for a
    /// response to HEAD, a 1xx, 204 or 304 (item 1) and a 2xx to CONNECT, after which the connection is a tunnel
    /// (item 2); Chunked when chunked is the final transfer coding and UntilClose for other codings (item 4,
    /// Transfer-Encoding overriding Content-Length, item 3); Length for a valid Content-Length, 400 for an invalid
    /// one (items 5, 6); UntilClose otherwise (item 8).
    #NoDiscard
    export let response_body_length = func(head: ResponseHead, request_method: string) -> Result<BodyFraming> {
        if (request_method == "HEAD" || http_status.has_no_content(head.status)) {
            return Result<BodyFraming>.Ok(BodyFraming.None);
        }
        if (request_method == "CONNECT" && http_status.is_success(head.status)) {
            return Result<BodyFraming>.Ok(BodyFraming.None);
        }
        if (head.headers.contains("Transfer-Encoding")) {
            last chunked = chunked_last(head.headers, false)?;
            return Result<BodyFraming>.Ok(chunked ? BodyFraming.Chunked : BodyFraming.UntilClose);
        }
        if (head.headers.contains("Content-Length")) {
            last n = content_length(head.headers)?;
            return Result<BodyFraming>.Ok(BodyFraming.Length(n));
        }
        return Result<BodyFraming>.Ok(BodyFraming.UntilClose);
    };

    /// @brief The value of the Content-Length fields: 1*DIGIT, or a list of equal such values (RFC 9112
    /// section 6.3 item 5). 400 when absent, empty, not digits, differing, or above the int64 range.
    #NoDiscard
    export let content_length = func(fields: http_headers.Headers) -> Result<int64> {
        last values = fields.list_elements("Content-Length");
        if (values.length == 0) {
            return fail<int64>(400, "empty Content-Length");
        }
        let result: int64 = -1;
        for (let text in values) {
            last n = decimal(text);
            if (n < 0) {
                return fail<int64>(400, "invalid Content-Length");
            }
            if (result >= 0 && n != result) {
                return fail<int64>(400, "differing Content-Length values");
            }
            result = n;
        }
        return Result<int64>.Ok(result);
    };

    /// @brief The head as bytes: the request-line, each field as "Name: value", each line ending in CRLF, then
    /// CRLF.
    #NoDiscard
    export let write_request_head = func(head: RequestHead) -> uint8[list] {
        last out = builders.create();
        out.append(head.method);
        out.append(" ");
        out.append(head.target);
        out.append(" ");
        out.append(head.version);
        out.append("\r\n");
        write_fields(out, head.headers);
        return strings.to_bytes(out.to_string());
    };

    /// @brief The head as bytes: the status-line, with the reason phrase of `Status.reason_phrase` when the head's
    /// reason is empty, then the fields as `write_request_head` writes them.
    #NoDiscard
    export let write_response_head = func(head: ResponseHead) -> uint8[list] {
        last out = builders.create();
        out.append(head.version);
        out.append(" ");
        out.append(head.status.to_string());
        out.append(" ");
        out.append(head.reason.byte_length > 0 ? head.reason : http_status.reason_phrase(head.status));
        out.append("\r\n");
        write_fields(out, head.headers);
        return strings.to_bytes(out.to_string());
    };

    /// @brief Appends the fields as "Name: value" CRLF lines, then the empty line.
    let write_fields = func(out: builders.StringBuilder, fields: http_headers.Headers) {
        for (let i = 0; i < fields.size(); i++) {
            out.append(fields.name_at(i));
            out.append(": ");
            out.append(fields.value_at(i));
            out.append("\r\n");
        }
        out.append("\r\n");
    };

    /// @brief Whether `text` is "HTTP/" DIGIT "." DIGIT.
    #[Pure, ThreadSafe]
    export let is_version = func(text: string) -> bool => version_major(text) >= 0;

    /// @brief The nine standard method tokens, each followed by one space.
    const StandardMethods: string = "GET HEAD POST PUT DELETE CONNECT OPTIONS TRACE PATCH ";

    /// @brief Traps unless `value` is positive.
    let check_positive = func(value: int64, name: string) {
        if (value <= 0) {
            trap_with_message("invalid argument: " + name);
        }
    };

    /// @brief An Err holding `rejection(status, message)`.
    let fail = func<T>(status: int, message: string) -> Result<T> => Result<T>.Err(rejection(status, message));

    /// @brief The 431 for a head over `limit` bytes.
    let too_large = func<T>(limit: int) -> Result<T> => fail<T>(431, $"head is over the limit of {limit} bytes");

    /// @brief The three-digit status in a "http.status.NNN" code, or 0.
    let status_of_code = func(code: string) -> int {
        if (code.byte_length != 15 || !strings.starts_with(code, "http.status.")) {
            return 0;
        }
        let status = 0;
        for (let i = 12; i < 15; i++) {
            last b = code.byte_at(i);
            if (b < 48 || b > 57) {
                return 0;
            }
            status = status * 10 + ((b - 48) as int);
        }
        return status;
    };

    /// @brief The head's lines without terminators, after the size, UTF-8 and line-end checks; the last line is
    /// the empty line that ends the head and the only empty line after the start-line.
    let head_lines = func(bytes: uint8[list], limits: Limits) -> Result<string[list]> {
        if (bytes.length > limits.max_head_bytes) {
            return too_large<string[list]>(limits.max_head_bytes);
        }
        let [valid, text] = string.from_utf8(bytes);
        if (!valid) {
            return fail<string[list]>(400, "head is not UTF-8");
        }
        last lines = split_lines(text, limits.allow_bare_lf)?;
        last start = first_line(lines);
        if (start >= lines.length) {
            return fail<string[list]>(400, "empty head");
        }
        for (let i = start + 1; i < lines.length; i++) {
            if (lines[i].byte_length == 0) {
                if (i != lines.length - 1) {
                    return fail<string[list]>(400, "bytes after the end of the head");
                }
                return Result<string[list]>.Ok(lines);
            }
        }
        return fail<string[list]>(400, "head does not end with an empty line");
    };

    /// @brief The index of the first non-empty line.
    let first_line = func(lines: string[list]) -> int {
        let i = 0;
        while (i < lines.length && lines[i].byte_length == 0) {
            i++;
        }
        return i;
    };

    /// @brief Splits text into lines at CRLF (and at a single LF when allowed); the text must end with a line end.
    let split_lines = func(text: string, bare_lf: bool) -> Result<string[list]> {
        last lines: string[list] = new;
        last count = text.byte_length;
        let start = 0;
        let i = 0;
        while (i < count) {
            last b = text.byte_at(i);
            if (b == 13) {
                if (i + 1 >= count || text.byte_at(i + 1) != 10) {
                    return fail<string[list]>(400, "bare CR");
                }
                lines.append(text.slice(start, i));
                i += 2;
                start = i;
            } else if (b == 10) {
                if (!bare_lf) {
                    return fail<string[list]>(400, "bare LF");
                }
                lines.append(text.slice(start, i));
                i++;
                start = i;
            } else {
                i++;
            }
        }
        if (start != count) {
            return fail<string[list]>(400, "line without a line end");
        }
        return Result<string[list]>.Ok(lines);
    };

    /// @brief The fields of lines[from, to), all non-empty.
    let fields_from_lines = func(lines: string[list], from: int, to: int, limits: Limits, lenient: bool)
            -> Result<http_headers.Headers> {
        last names: string[list] = new;
        last values: string[list] = new;
        for (let i = from; i < to; i++) {
            last line = lines[i];
            if (line.byte_length == 0) {
                return fail<http_headers.Headers>(400, "empty line in a field section");
            }
            last lead = line.byte_at(0);
            if (lead == 32 || lead == 9) {
                if (!lenient || names.length == 0) {
                    return fail<http_headers.Headers>(400, "field line starts with whitespace (obs-fold)");
                }
                last more = http_headers.trim_value(line);
                if (!http_headers.is_valid_value(more)) {
                    return fail<http_headers.Headers>(400, "invalid field value");
                }
                last at = values.length - 1;
                values[at] = values[at].byte_length == 0 ? more : values[at] + " " + more;
                continue;
            }
            last colon = index_of_byte(line, 58, 0);
            if (colon < 0) {
                return fail<http_headers.Headers>(400, "field line without a colon");
            }
            let name_end = colon;
            if (name_end > 0 && (line.byte_at(name_end - 1) == 32 || line.byte_at(name_end - 1) == 9)) {
                if (!lenient) {
                    return fail<http_headers.Headers>(400, "whitespace between field name and colon");
                }
                while (name_end > 0 && (line.byte_at(name_end - 1) == 32 || line.byte_at(name_end - 1) == 9)) {
                    name_end--;
                }
            }
            last name = line.slice(0, name_end);
            if (!http_headers.is_token(name)) {
                return fail<http_headers.Headers>(400, "field name is not a token");
            }
            last value = http_headers.trim_value(line.slice(colon + 1, line.byte_length));
            if (!http_headers.is_valid_value(value)) {
                return fail<http_headers.Headers>(400, "invalid value of field " + name);
            }
            if (names.length >= limits.max_header_fields) {
                return fail<http_headers.Headers>(431, $"more than {limits.max_header_fields} header fields");
            }
            names.append(name);
            values.append(value);
        }
        return Result<http_headers.Headers>.Ok(http_headers.of(names, values));
    };

    /// @brief Validates Transfer-Encoding; whether chunked is the final coding. A request may only use chunked:
    /// another coding is 501. Chunked twice, chunked with parameters or an empty list is 400.
    let chunked_last = func(fields: http_headers.Headers, request: bool) -> Result<bool> {
        last codings = fields.list_elements("Transfer-Encoding");
        if (codings.length == 0) {
            return fail<bool>(400, "empty Transfer-Encoding");
        }
        let chunked_count = 0;
        let last_chunked = false;
        for (let coding in codings) {
            last semicolon = index_of_byte(coding, 59, 0);
            last name = http_headers.trim_value(semicolon < 0 ? coding : coding.slice(0, semicolon));
            last_chunked = strings.equals_ignore_ascii_case(name, "chunked");
            if (last_chunked) {
                if (semicolon >= 0) {
                    return fail<bool>(400, "chunked has no parameters");
                }
                chunked_count++;
            } else if (request) {
                return fail<bool>(501, "transfer coding " + name + " is not implemented");
            }
        }
        if (chunked_count > 1) {
            return fail<bool>(400, "chunked applied more than once");
        }
        return Result<bool>.Ok(last_chunked);
    };

    /// @brief The value of 1*DIGIT text, or -1 when it is not digits or exceeds int64.
    let decimal = func(text: string) -> int64 {
        if (text.byte_length == 0) {
            return -1;
        }
        let n: int64 = 0;
        for (let i = 0; i < text.byte_length; i++) {
            last b = text.byte_at(i);
            if (b < 48 || b > 57) {
                return -1;
            }
            last digit = (b - 48) as int64;
            if (n > (9223372036854775807 - digit) / 10) {
                return -1;
            }
            n = n * 10 + digit;
        }
        return n;
    };

    /// @brief The major digit of "HTTP/" DIGIT "." DIGIT, or -1.
    let version_major = func(text: string) -> int {
        if (text.byte_length != 8 || !strings.starts_with(text, "HTTP/") || text.byte_at(6) != 46) {
            return -1;
        }
        last major = text.byte_at(5);
        last minor = text.byte_at(7);
        if (major < 48 || major > 57 || minor < 48 || minor > 57) {
            return -1;
        }
        return (major - 48) as int;
    };

    /// @brief The minor digit of a version accepted by `version_major`.
    let version_minor = func(text: string) -> int => (text.byte_at(7) - 48) as int;

    /// @brief Whether every byte is visible ASCII and there is at least one (RFC 9112 section 3.2).
    let is_target = func(text: string) -> bool {
        if (text.byte_length == 0) {
            return false;
        }
        for (let i = 0; i < text.byte_length; i++) {
            last b = text.byte_at(i);
            if (b <= 32 || b >= 127) {
                return false;
            }
        }
        return true;
    };

    /// @brief Whether a Host value is uri-host [":" port] made of reg-name, IP-literal and port characters
    /// (RFC 9110 section 7.2, RFC 3986 section 3.2.2): unreserved, sub-delims, "%", ":", "[" and "]". May be empty.
    let is_host_value = func(text: string) -> bool {
        for (let i = 0; i < text.byte_length; i++) {
            last b = text.byte_at(i);
            last alnum = (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122);
            // - . _ ~ ! $ & ' ( ) * + , ; = % : [ ]
            if (!alnum && !(b == 45 or 46 or 95 or 126 or 33 or 36 or 38 or 39 or 40 or 41 or 42 or 43 or 44 or 59
                    or 61 or 37 or 58 or 91 or 93)) {
                return false;
            }
        }
        return true;
    };

    /// @brief The offset of the first byte `b` at or after `from`, or -1.
    let index_of_byte = func(text: string, b: uint8, from: int) -> int {
        for (let i = from; i < text.byte_length; i++) {
            if (text.byte_at(i) == b) {
                return i;
            }
        }
        return -1;
    };

    /// @brief A new list holding bytes[start, end).
    let copy_range = func(bytes: uint8[list], start: int, end: int) -> uint8[list] {
        last out: uint8[list] = new;
        for (let i = start; i < end; i++) {
            out.append(bytes[i]);
        }
        return out;
    };
);
