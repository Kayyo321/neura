let errors = import:Std.Core.Error;
let hashing = import:Std.Core.Hash;
let messages = import:Std.Net.Dns.Message;
let names = import:Std.Net.Dns.Name;
let.promote _ = import:Std.Core.Result;
let resolvers = import:Std.Net.Dns.StubResolver;
let strings = import:Std.Text.Strings;

/// @brief NAPTR lookups (RFC 3403, the DNS database of the DDDS algorithm, RFC 3402) over a `StubResolver`.
///
/// `sort_rules` orders by ORDER, then PREFERENCE, both ascending (RFC 3403 section 4.1). `select` keeps the rules
/// offering a service and, as section 4.1 requires, only those of the lowest ORDER that has any such rule ("once a
/// match is found the client MUST NOT consider records with a different Order"). A rule with flag "S", "A" or "U"
/// is terminal; one with empty flags continues the lookup at its replacement. `follow` walks non-terminal
/// replacement rules to a terminal one, at most `MaxRewrites` steps. The REGEXP field is returned as text and not
/// evaluated (Neura 0.3.0 has no POSIX ERE engine): `follow` skips rules that use a regexp instead of a
/// replacement and says so in its error when nothing else matches.
/// @see [Std.Net.Dns.NaptrLookup](https://github.com/Kayyo321/neura/wiki/Stdlib-Net-Dns-NaptrLookup)
#Since("0.3.0")
export let NaptrLookup = module (
    /// @brief The most non-terminal rewrites `follow` makes.
    export const MaxRewrites: int = 8;

    /// @brief One NAPTR rule.
    #Final
    export let NaptrRule = class (
        /// @brief ORDER (lower first; a different order is a different rule).
        export last order: int;
        /// @brief PREFERENCE among rules of one order (lower first).
        export last preference: int;
        /// @brief FLAGS ("S", "A", "U", "P" or empty).
        export last flags: string;
        /// @brief SERVICES, such as "SIP+D2U" or "E2U+sip".
        export last services: string;
        /// @brief REGEXP (not evaluated).
        export last regexp: string;
        /// @brief REPLACEMENT (the root when the regexp is used).
        export last replacement: names.DnsName;

        /// @brief A rule.
        export let init = func(rule_order: int, rule_preference: int, rule_flags: string, rule_services: string,
            rule_regexp: string, rule_replacement: names.DnsName) {
            order = rule_order;
            preference = rule_preference;
            flags = rule_flags;
            services = rule_services;
            regexp = rule_regexp;
            replacement = rule_replacement;
        };

        /// @brief Whether the flags end the lookup ("S", "A" or "U", any case).
        #NoDiscard
        export let is_terminal = func -> bool {
            last upper = strings.to_ascii_upper(flags);
            return strings.contains(upper, "S") || strings.contains(upper, "A") || strings.contains(upper, "U");
        };

        /// @brief Whether `service` is one of the services, '+'-separated, ignoring ASCII case.
        #NoDiscard
        export let offers = func(service: string) -> bool {
            if (strings.equals_ignore_ascii_case(services, service)) {
                return true;
            }
            for (let part in strings.split(services, "+")) {
                if (strings.equals_ignore_ascii_case(part, service)) {
                    return true;
                }
            }
            return false;
        };

        /// @brief Equal when every field is.
        export let.override equals = func(other: class) -> bool {
            if (!(other is NaptrRule)) {
                return false;
            }
            last that = other as NaptrRule;
            return order == that.order && preference == that.preference && flags == that.flags
                && services == that.services && regexp == that.regexp && replacement.equals(that.replacement);
        };

        /// @brief Combines the fields.
        export let.override hash_code = func -> uint32 => hashing.combine(hashing.combine(hashing.combine(
            replacement.hash_code(), order as uint32), preference as uint32), strings.hash(flags + services + regexp));

        /// @brief Text such as "100 10 \"S\" \"SIP+D2U\" \"\" _sip._udp.example.com.".
        export let.override to_string = func -> string => order.to_string() + " " + preference.to_string() + " \""
            + flags + "\" \"" + services + "\" \"" + regexp + "\" " + replacement.to_string();
    );

    /// @brief NAPTR lookups through a resolver.
    #[Final, NotThreadSafe]
    export let NaptrLookup = class (
        /// @brief The resolver.
        last resolver: resolvers.StubResolver;

        /// @brief A lookup over `stub`.
        export let init = func(stub: resolvers.StubResolver) {
            resolver = stub;
        };

        /// @brief The NAPTR rules of `domain`, sorted.
        #NoDiscard
        export let lookup = func(domain: string) -> Result<NaptrRule[list]> {
            last answer = resolver.lookup(domain, messages.TypeNaptr)?;
            return Result<NaptrRule[list]>.Ok(sort_rules(rules_from(answer.records)));
        };

        /// @brief Follows rules offering `service` from `domain` to a terminal rule. Err (Custom `dns.naptr`)
        /// when no rule matches, only regexp rules match, or after `MaxRewrites` rewrites.
        #NoDiscard
        export let follow = func(domain: string, service: string) -> Result<NaptrRule> {
            let current = domain;
            for (let step = 0; step <= MaxRewrites; step++) {
                last chosen = select(lookup(current)?, service);
                let used_regexp = false;
                let next: Result<NaptrRule> = Result<NaptrRule>.Err(errors.custom("dns.naptr",
                    "no NAPTR rule offers " + service + " at " + current));
                for (let rule in chosen) {
                    if (rule.regexp != "" && rule.replacement.is_root()) {
                        used_regexp = true;
                        continue;
                    }
                    next = Result<NaptrRule>.Ok(rule);
                    break;
                }
                match (next) {
                    Result.Ok(rule) => {
                        if (rule.is_terminal()) {
                            return next;
                        }
                        current = rule.replacement.to_string();
                    },
                    Result.Err(_) => {
                        if (used_regexp) {
                            return Result<NaptrRule>.Err(errors.custom("dns.naptr",
                                "only regexp rules match; REGEXP is not evaluated in Neura 0.3.0"));
                        }
                        return next;
                    },
                }
            }
            return Result<NaptrRule>.Err(errors.custom("dns.naptr", "more than " + MaxRewrites.to_string()
                + " NAPTR rewrites"));
        };

        /// @brief Text "NaptrLookup".
        export let.override to_string = func -> string => "NaptrLookup";
    );

    /// @brief The NAPTR rules among records, in record order.
    #NoDiscard
    export let rules_from = func(records: messages.ResourceRecord[list]) -> NaptrRule[list] {
        last out: NaptrRule[list] = new;
        for (let record in records) {
            match (record.data) {
                messages.RecordData.Naptr { order, preference, flags, services, regexp, replacement } => {
                    out.append(new NaptrRule(order, preference, flags, services, regexp, replacement));
                },
                _ => {
                },
            }
        }
        return out;
    };

    /// @brief The rules sorted by order, then preference (stable).
    #NoDiscard
    export let sort_rules = func(rules: NaptrRule[list]) -> NaptrRule[list] {
        last out: NaptrRule[list] = new;
        for (let rule in rules) {
            out.append(rule);
        }
        for (let i = 1; i < out.length; i++) {
            let j = i;
            while (j > 0 && before(out[j], out[j - 1])) {
                last swap = out[j - 1];
                out[j - 1] = out[j];
                out[j] = swap;
                j--;
            }
        }
        return out;
    };

    /// @brief The sorted rules offering `service` within the lowest order that has one.
    #NoDiscard
    export let select = func(rules: NaptrRule[list], service: string) -> NaptrRule[list] {
        last sorted = sort_rules(rules);
        last out: NaptrRule[list] = new;
        let order = -1;
        for (let rule in sorted) {
            if (!rule.offers(service)) {
                continue;
            }
            if (order < 0) {
                order = rule.order;
            }
            if (rule.order == order) {
                out.append(rule);
            }
        }
        return out;
    };

    /// @brief Whether `a` sorts strictly before `b`.
    let before = func(a: NaptrRule, b: NaptrRule) -> bool =>
        a.order < b.order || (a.order == b.order && a.preference < b.preference);
);
