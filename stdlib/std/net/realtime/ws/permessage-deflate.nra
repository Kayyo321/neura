let errors = import:Std.Core.Error;
let exts = import:Std.Net.Realtime.Ws.Extensions;
let.promote _ = import:Std.Net.Realtime.Ws.Frame;
let hashing = import:Std.Core.Hash;
let.promote _ = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Result;

/// @brief The permessage-deflate extension (RFC 7692): negotiation, and the message transformation framing.
///
/// Negotiation is real: `parse_offer` and `parse_response` read the four parameters of section 7.1 and reject
/// an unknown parameter, a repeated one, or an invalid value (section 7); `negotiate` is the server's choice
/// among a client's offers; `validate_response` is the client's check of the server's answer (section 5).
/// Window bits are 8 to 15 written in decimal without leading zeros. The tail handling of section 7.2 (strip
/// and restore `00 00 ff ff`) is real. DEFLATE itself (RFC 1951) is not in the standard library, so
/// `DeflateCodec.compress` and `DeflateCodec.decompress` are stubs, and `Std.Net.Realtime.Ws.WebSocket` never
/// offers the extension. Failures are Custom errors with the code `ws.handshake`.
/// @see [Std.Net.Realtime.Ws.PermessageDeflate](https://github.com/Kayyo321/neura/wiki/Stdlib-Net-Realtime-Ws-PermessageDeflate)
#Since("0.3.0")
export let PermessageDeflate = module (
    /// @brief The registered extension name.
    export const ExtensionName: string = "permessage-deflate";

    /// @brief The four agreed or offered parameters.
    ///
    /// A window-bits field is 0 when the parameter is absent and 8 to 15 when it has a value;
    /// `client_max_window_bits` is -1 for the valueless form, which only an offer may use.
    #[Final, Immutable]
    export let DeflateParams = class (
        /// @brief The server does not reuse its LZ77 window between messages.
        export last server_no_context_takeover: bool;
        /// @brief The client does not reuse its LZ77 window between messages.
        export last client_no_context_takeover: bool;
        /// @brief The server's window bits, or 0.
        export last server_max_window_bits: int;
        /// @brief The client's window bits, 0, or -1 (offered without a value).
        export last client_max_window_bits: int;

        /// @brief Stores the parameters. Window bits outside 0 and 8 to 15 (and -1 for the client) trap with
        /// "invalid argument: window bits".
        export let init = func(server_no_takeover: bool, client_no_takeover: bool, server_bits: int,
            client_bits: int) {
            if (server_bits != 0 && (server_bits < 8 || server_bits > 15)) {
                trap_with_message("invalid argument: window bits");
            }
            if (client_bits != 0 && client_bits != -1 && (client_bits < 8 || client_bits > 15)) {
                trap_with_message("invalid argument: window bits");
            }
            server_no_context_takeover = server_no_takeover;
            client_no_context_takeover = client_no_takeover;
            server_max_window_bits = server_bits;
            client_max_window_bits = client_bits;
        };

        /// @brief The element, as written in a Sec-WebSocket-Extensions header.
        #NoDiscard
        export let to_extension = func -> exts.Extension {
            last params: exts.ExtensionParam[list] = new;
            if (server_no_context_takeover) {
                params.append(new exts.ExtensionParam("server_no_context_takeover", Optional<string>.None));
            }
            if (client_no_context_takeover) {
                params.append(new exts.ExtensionParam("client_no_context_takeover", Optional<string>.None));
            }
            if (server_max_window_bits > 0) {
                params.append(new exts.ExtensionParam("server_max_window_bits",
                    Optional<string>.Some(server_max_window_bits.to_string())));
            }
            if (client_max_window_bits == -1) {
                params.append(new exts.ExtensionParam("client_max_window_bits", Optional<string>.None));
            } else if (client_max_window_bits > 0) {
                params.append(new exts.ExtensionParam("client_max_window_bits",
                    Optional<string>.Some(client_max_window_bits.to_string())));
            }
            return new exts.Extension(ExtensionName, params);
        };

        /// @brief Equal when the four parameters are.
        export let.override equals = func(other: class) -> bool {
            if (other is not that: DeflateParams) {
                return false;
            }
            return server_no_context_takeover == that.server_no_context_takeover
                && client_no_context_takeover == that.client_no_context_takeover
                && server_max_window_bits == that.server_max_window_bits
                && client_max_window_bits == that.client_max_window_bits;
        };

        /// @brief Combines the four parameters.
        export let.override hash_code = func -> uint32 {
            let hash = hashing.combine(17, hashing.of_bool(server_no_context_takeover));
            hash = hashing.combine(hash, hashing.of_bool(client_no_context_takeover));
            hash = hashing.combine(hash, hashing.of_int64(server_max_window_bits as int64));
            return hashing.combine(hash, hashing.of_int64(client_max_window_bits as int64));
        };

        /// @brief The header form.
        export let.override to_string = func -> string => to_extension().to_string();
    );

    /// @brief What a server is willing to agree to.
    #[Final, Immutable]
    export let ServerConfig = class (
        /// @brief Accept offers that limit the server's window (`server_max_window_bits`).
        export last accept_server_window_limit: bool;
        /// @brief Always answer `server_no_context_takeover`.
        export last server_no_context_takeover: bool;
        /// @brief Ask the client not to take over context (`client_no_context_takeover`).
        export last client_no_context_takeover: bool;
        /// @brief The client window bits to request when the client supports the parameter, or 0.
        export last client_max_window_bits: int;

        /// @brief Stores the policy. Window bits outside 0 and 8 to 15 trap with "invalid argument: window bits".
        export let init = func(accept_limit: bool, server_no_takeover: bool, client_no_takeover: bool,
            client_bits: int) {
            if (client_bits != 0 && (client_bits < 8 || client_bits > 15)) {
                trap_with_message("invalid argument: window bits");
            }
            accept_server_window_limit = accept_limit;
            server_no_context_takeover = server_no_takeover;
            client_no_context_takeover = client_no_takeover;
            client_max_window_bits = client_bits;
        };

        /// @brief The four settings.
        export let.override to_string = func -> string =>
            "ServerConfig(accept_server_window_limit " .. accept_server_window_limit.to_string()
            .. ", server_no_context_takeover " .. server_no_context_takeover.to_string()
            .. ", client_no_context_takeover " .. client_no_context_takeover.to_string()
            .. ", client_max_window_bits " .. client_max_window_bits.to_string() .. ")";
    );

    /// @brief Reads a client's offer element (RFC 7692 section 7). Fails for another extension name, an unknown
    /// or repeated parameter, a value on a takeover parameter, or window bits that are not 8 to 15 without
    /// leading zeros (`server_max_window_bits` needs a value; `client_max_window_bits` may have none).
    #NoDiscard
    export let parse_offer = func(element: exts.Extension) -> Result<DeflateParams> => read(element, true);

    /// @brief Reads a server's response element (RFC 7692 section 7): as `parse_offer`, except that
    /// `client_max_window_bits` needs a value.
    #NoDiscard
    export let parse_response = func(element: exts.Extension) -> Result<DeflateParams> => read(element, false);

    /// @brief The server's answer to a client's offers: the agreed parameters of the first acceptable
    /// permessage-deflate offer, or `None` to decline them all.
    ///
    /// An offer is skipped when it is invalid, or when it limits the server's window and the configuration does
    /// not accept that. The answer carries `server_no_context_takeover` when the offer or the configuration
    /// asks for it, the offer's `server_max_window_bits`, `client_no_context_takeover` when the configuration
    /// asks for it, and the configuration's `client_max_window_bits` (capped by the offer's value) only when the
    /// offer included that parameter (section 7.1.2.2).
    #NoDiscard
    export let negotiate = func(offers: exts.Extension[list], config: ServerConfig) -> Optional<DeflateParams> {
        for (let element in offers) {
            if (element.name != ExtensionName) {
                continue;
            }
            match (parse_offer(element)) {
                Result.Err(_) => {
                    continue;
                },
                Result.Ok(offer) => {
                    if (offer.server_max_window_bits > 0 && not config.accept_server_window_limit) {
                        continue;
                    }
                    let client_bits = 0;
                    if (offer.client_max_window_bits != 0 && config.client_max_window_bits > 0) {
                        client_bits = config.client_max_window_bits;
                        if (offer.client_max_window_bits > 0 && offer.client_max_window_bits < client_bits) {
                            client_bits = offer.client_max_window_bits;
                        }
                    }
                    return Optional<DeflateParams>.Some(new DeflateParams(
                        offer.server_no_context_takeover || config.server_no_context_takeover,
                        config.client_no_context_takeover, offer.server_max_window_bits, client_bits));
                },
            }
        }
        return Optional<DeflateParams>.None;
    };

    /// @brief The client's check of a server's response element against its offers (RFC 7692 sections 5 and
    /// 7.1): the response must parse, and some valid offer must allow it: `client_max_window_bits` only when
    /// that offer had the parameter, and `server_max_window_bits` no larger than that offer's value.
    #NoDiscard
    export let validate_response = func(offers: exts.Extension[list], response: exts.Extension) -> Result<DeflateParams> {
        last agreed = parse_response(response)?;
        for (let element in offers) {
            if (element.name != ExtensionName) {
                continue;
            }
            match (parse_offer(element)) {
                Result.Err(_) => {
                    continue;
                },
                Result.Ok(offer) => {
                    if (agreed.client_max_window_bits > 0 && offer.client_max_window_bits == 0) {
                        continue;
                    }
                    if (offer.server_max_window_bits > 0 && (agreed.server_max_window_bits == 0
                        || agreed.server_max_window_bits > offer.server_max_window_bits)) {
                        continue;
                    }
                    return Result<DeflateParams>.Ok(agreed);
                },
            }
        }
        return fail<DeflateParams>("the permessage-deflate response matches no offer");
    };

    /// @brief The compressed payload with the final `00 00 ff ff` removed, as a sender sends it (RFC 7692
    /// section 7.2.1). A payload without that tail is returned unchanged.
    #NoDiscard
    export let strip_tail = func(compressed: uint8[list]) -> uint8[list] {
        last n = compressed.length;
        last tail = n >= 4 && compressed[n - 4] == 0 && compressed[n - 3] == 0 && compressed[n - 2] == 255
            && compressed[n - 1] == 255;
        last keep = tail ? n - 4 : n;
        last out: uint8[list] = new;
        for (let i = 0; i < keep; i++) {
            out.append(compressed[i]);
        }
        return out;
    };

    /// @brief The received payload with `00 00 ff ff` appended, as a receiver inflates it (RFC 7692 section
    /// 7.2.2).
    #NoDiscard
    export let append_tail = func(payload: uint8[list]) -> uint8[list] {
        last out: uint8[list] = new;
        for (let b in payload) {
            out.append(b);
        }
        out.append(0);
        out.append(0);
        out.append(255);
        out.append(255);
        return out;
    };

    /// @brief The per-connection compressor and decompressor for agreed parameters and a role.
    #[Final, NotThreadSafe]
    export let DeflateCodec = class (
        /// @brief The agreed parameters.
        export last params: DeflateParams;
        /// @brief The endpoint this codec serves.
        export last role: Role;

        /// @brief Stores the agreement and role.
        export let init = func(agreed: DeflateParams, endpoint: Role) {
            params = agreed;
            role = endpoint;
        };

        /// @brief The payload of a compressed message: DEFLATE of the message, tail stripped.
        /// @stub no DEFLATE (RFC 1951) compressor in the standard library
        #NoDiscard
        export let compress = func(message: uint8[list]) -> Result<uint8[list]> {
            trap_with_message("unsupported: Std.Net.Realtime.Ws.PermessageDeflate.DeflateCodec.compress is not implemented in Neura 0.3.0 (no DEFLATE (RFC 1951) compressor in the standard library)");
        };

        /// @brief The message of a compressed payload: inflate of the payload with the tail restored.
        /// @stub no DEFLATE (RFC 1951) decompressor in the standard library
        #NoDiscard
        export let decompress = func(payload: uint8[list]) -> Result<uint8[list]> {
            trap_with_message("unsupported: Std.Net.Realtime.Ws.PermessageDeflate.DeflateCodec.decompress is not implemented in Neura 0.3.0 (no DEFLATE (RFC 1951) decompressor in the standard library)");
        };

        /// @brief The agreement and role.
        export let.override to_string = func -> string =>
            "DeflateCodec(" .. params.to_string() .. ", " .. role.to_string() .. ")";
    );

    /// @brief Reads an element as an offer (`offer` true) or a response.
    let read = func(element: exts.Extension, offer: bool) -> Result<DeflateParams> {
        if (element.name != ExtensionName) {
            return fail<DeflateParams>("not a permessage-deflate element: " .. element.name);
        }
        let server_no_takeover = false;
        let client_no_takeover = false;
        let server_bits = 0;
        let client_bits = 0;
        for (let param in element.params) {
            if (element.count(param.name) > 1) {
                return fail<DeflateParams>("repeated parameter " .. param.name);
            }
            if (param.name == "server_no_context_takeover" || param.name == "client_no_context_takeover") {
                if (is_some<string>(param.value)) {
                    return fail<DeflateParams>(param.name .. " takes no value");
                }
                if (param.name == "server_no_context_takeover") {
                    server_no_takeover = true;
                } else {
                    client_no_takeover = true;
                }
            } else if (param.name == "server_max_window_bits") {
                server_bits = window_bits(param.value);
                if (server_bits == 0) {
                    return fail<DeflateParams>("server_max_window_bits needs a value from 8 to 15");
                }
            } else if (param.name == "client_max_window_bits") {
                if (offer && not is_some<string>(param.value)) {
                    client_bits = -1;
                } else {
                    client_bits = window_bits(param.value);
                    if (client_bits == 0) {
                        return fail<DeflateParams>("client_max_window_bits needs a value from 8 to 15");
                    }
                }
            } else {
                return fail<DeflateParams>("unknown parameter " .. param.name);
            }
        }
        return Result<DeflateParams>.Ok(new DeflateParams(server_no_takeover, client_no_takeover, server_bits,
            client_bits));
    };

    /// @brief The value 8 to 15 written without leading zeros, or 0 for anything else.
    let window_bits = func(value: Optional<string>) -> int => match (value) {
        Optional.None => 0,
        Optional.Some(text) => text == "8" or "9" or "10" or "11" or "12" or "13" or "14" or "15"
            ? parse_small(text) : 0,
    };

    /// @brief The decimal value of one or two ASCII digits.
    let parse_small = func(text: string) -> int {
        let n = 0;
        for (let i = 0; i < text.byte_length; i++) {
            n = n * 10 + ((text.byte_at(i) - 48) as int);
        }
        return n;
    };

    /// @brief A negotiation failure.
    let fail = func<T>(message: string) -> Result<T> => Result<T>.Err(errors.custom("ws.handshake", message));
);
