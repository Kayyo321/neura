let bytes = import:Std.Io.Internal.Bytes;
let closeable = import:Std.Io.Closeable;
let duration = import:Std.Time.Duration;
let host_error = import:Std.Core.Internal.HostError;
let result = import:Std.Core.Result;
let socket = import:Std.Net.Internal.Socket;
let unit = import:Std.Core.Unit;

// A connected, blocking TCP stream (Stdlib.md section 11.4). Its bound read
// method is a byte source and its bound write method a byte sink. Needs the
// net capability. After close every operation except close fails with
// Closed.
export let TcpStream = module (
    let IdOutcome = enum (Ok(int64), Error(uint32));
    let BytesOutcome = enum (Ok(uint8[list]), Error(uint32));
    let CountOutcome = enum (Ok(int), Error(uint32));
    let DoneOutcome = enum (Ok, Error(uint32));
    let connect_socket = func(string host, int port, int64 timeout_nanos) -> IdOutcome host("neura.net.connect", 1);
    let read_socket = func(int64 socket, int max, int64 timeout_nanos) -> BytesOutcome host("neura.net.read", 1);
    let write_socket = func(int64 socket, uint8[list] data) -> CountOutcome host("neura.net.write", 1);
    let close_socket = func(int64 socket) -> DoneOutcome host("neura.net.close", 1);

    export let TcpStream = class implements closeable.Closeable (
        let handle: socket.Handle = nil;
        let open_now: bool = true;
        let read_timeout: int64 = 0;

        // Use connect or TcpListener.accept; the handle comes from the
        // library.
        export let init = func(socket.Handle opened) -> void {
            handle = opened;
        };

        // Up to `max` bytes; an empty list once the peer has closed its side.
        // Waits at most the read timeout, then fails with TimedOut. A maximum
        // below 1 traps.
        export let read = func(int max) -> result.Result<uint8[list]> {
            bytes.check_maximum(max);
            if (!open_now) {
                return result.Result<uint8[list]>.Err(bytes.closed("stream", handle.address));
            }
            return match (read_socket(handle.id, max, read_timeout)) {
                BytesOutcome.Ok(chunk) => result.Result<uint8[list]>.Ok(chunk),
                BytesOutcome.Error(code) => result.Result<uint8[list]>.Err(host_error.io(code, "stream read failed", handle.address)),
            };
        };

        // Writes every byte, repeating partial host writes.
        export let write = func(uint8[list] data) -> result.Result<unit.Unit> {
            if (!open_now) {
                return result.Result<unit.Unit>.Err(bytes.closed("stream", handle.address));
            }
            let remaining = data;
            while (remaining.length > 0) {
                match (write_socket(handle.id, remaining)) {
                    CountOutcome.Ok(count) => {
                        if (count <= 0) {
                            return result.Result<unit.Unit>.Err(bytes.no_progress("stream write failed", handle.address));
                        }
                        if (count >= remaining.length) {
                            return bytes.ok();
                        }
                        remaining = bytes.copy_range(remaining, count, remaining.length);
                    },
                    CountOutcome.Error(code) => {
                        return result.Result<unit.Unit>.Err(host_error.io(code, "stream write failed", handle.address));
                    },
                }
            }
            return bytes.ok();
        };

        // The longest a read waits; zero waits without limit. A negative
        // timeout traps with "invalid argument: negative timeout".
        export let set_read_timeout = func(duration.Duration timeout) -> void {
            read_timeout = timeout_nanos(timeout);
        };

        // Releases the connection. Closing again does nothing and returns
        // Ok; the stream is closed even when the host reports an error.
        export let close = func() -> result.Result<unit.Unit> {
            if (!open_now) {
                return bytes.ok();
            }
            open_now = false;
            return match (close_socket(handle.id)) {
                DoneOutcome.Ok => bytes.ok(),
                DoneOutcome.Error(code) => result.Result<unit.Unit>.Err(host_error.io(code, "stream close failed", handle.address)),
            };
        };
    );

    // Connects to `host` (a name or an address) and `port`, waiting at most
    // `timeout` (zero waits without limit). A port outside 0 through 65,535
    // traps with "invalid argument: port"; a negative timeout traps with
    // "invalid argument: negative timeout".
    export let connect = func(string host, int port, duration.Duration timeout) -> result.Result<TcpStream> {
        socket.check_port(port);
        let nanos = timeout_nanos(timeout);
        let address = socket.address_of(host, port);
        return match (connect_socket(host, port, nanos)) {
            IdOutcome.Ok(id) => result.Result<TcpStream>.Ok(new TcpStream(new socket.Handle(id, address))),
            IdOutcome.Error(code) => result.Result<TcpStream>.Err(host_error.io(code, "connect failed", address)),
        };
    };

    let timeout_nanos = func(duration.Duration timeout) -> int64 {
        let nanos = timeout.to_nanos();
        if (nanos < 0) {
            trap_with_message("invalid argument: negative timeout");
        }
        return nanos;
    };
);
