let durations = import:Std.Time.Duration;
let randoms = import:Std.Random.Random;

/// @brief Exponential backoff with optional jitter, drawn from an injected random source.
///
/// For attempt `n` (the first retry is attempt 1) the ceiling is `c = min(cap, base * 2^(n - 1))` nanoseconds. With
/// `u = next_float64()` uniform in [0, 1) from the injected generator, the delay is (following "Exponential Backoff
/// And Jitter", Marc Brooker, AWS Architecture Blog, 2015):
///
/// | Jitter | Delay |
/// | --- | --- |
/// | `None` | `c` |
/// | `Full` | `floor(c * u)`, uniform in [0, c) |
/// | `Equal` | `c / 2 + floor((c - c / 2) * u)` with integer halving, uniform in [c / 2, c) |
///
/// Each `delay` call with `Full` or `Equal` draws exactly one value from the generator, so a seeded generator gives
/// the same delays on every run.
/// @see [Std.Net.Resilience.Backoff](https://github.com/Kayyo321/neura/wiki/Stdlib-Net-Resilience-Backoff)
#Since("0.3.0")
export let Backoff = module (
    /// @brief How the delay is spread below its ceiling.
    export let Jitter = enum (None, Full, Equal);

    /// @brief Exponential backoff with jitter.
    #[Final, NotThreadSafe]
    export let Backoff = class (
        /// @brief The ceiling of the first retry, in nanoseconds.
        last base: int64;
        /// @brief The largest ceiling, in nanoseconds.
        last cap: int64;
        /// @brief The jitter mode.
        last jitter: Jitter;
        /// @brief The random source.
        last random: randoms.Random;

        /// @brief Backoff from `initial` doubling up to `maximum`. Traps with "invalid argument: <name>" unless
        /// `initial` is positive and `maximum` is at least `initial`.
        export let init = func(initial: durations.Duration, maximum: durations.Duration, spread: Jitter,
                source: randoms.Random) {
            if (initial.to_nanos() <= 0) {
                trap_with_message("invalid argument: initial");
            }
            if (maximum.to_nanos() < initial.to_nanos()) {
                trap_with_message("invalid argument: maximum");
            }
            base = initial.to_nanos();
            cap = maximum.to_nanos();
            jitter = spread;
            random = source;
        };

        /// @brief The ceiling `min(cap, base * 2^(attempt - 1))`; `attempt` must be at least 1, else the call traps
        /// with "invalid argument: attempt".
        export let ceiling = func(attempt: int) -> durations.Duration {
            if (attempt < 1) {
                trap_with_message("invalid argument: attempt");
            }
            let c = base;
            for (let i = 1; i < attempt && c < cap; i++) {
                c = c > cap / 2 ? cap : c * 2;
            }
            return durations.of_nanos(c < cap ? c : cap);
        };

        /// @brief The delay before retry `attempt`, drawing one random value for `Full` and `Equal` jitter.
        export let delay = func(attempt: int) -> durations.Duration {
            last c = ceiling(attempt).to_nanos();
            return match (jitter) {
                Jitter.None => durations.of_nanos(c),
                Jitter.Full => durations.of_nanos(scaled(c)),
                Jitter.Equal => durations.of_nanos(c / 2 + scaled(c - c / 2)),
            };
        };

        /// @brief Text such as "Backoff(PT0.1S to PT10S, Full jitter)".
        export let.override to_string = func -> string =>
            "Backoff(" + durations.of_nanos(base).to_string() + " to " + durations.of_nanos(cap).to_string() + ", "
                + jitter.to_string() + " jitter)";

        /// @brief floor(span * u) for one draw u in [0, 1).
        let scaled = func(span: int64) -> int64 => ((span as float64) * random.next_float64()) as int64;
    );

    /// @brief Exponential backoff with jitter.
    #NoDiscard
    export let exponential = func(initial: durations.Duration, maximum: durations.Duration, jitter: Jitter,
        random: randoms.Random) -> Backoff => new Backoff(initial, maximum, jitter, random);
);
