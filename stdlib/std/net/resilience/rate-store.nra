let durations = import:Std.Time.Duration;
let optional = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Result;

/// @brief The distributed hook of `GcraLimiter`: a store of one int64 per key (the GCRA theoretical arrival time,
/// in nanoseconds since the Unix epoch) with an atomic compare-and-set.
///
/// An implementation backed by an external store (Redis, a database, a coordination service) lets several
/// processes share one limit: each reads the key, computes the new arrival time, and writes it only if the key
/// still holds what it read, retrying otherwise. `InMemoryRateStore` is the in-process implementation. All
/// limiters sharing a store must read the same wall clock, within the clock skew the limit can tolerate.
/// @see [Std.Net.Resilience.RateStore](https://github.com/Kayyo321/neura/wiki/Stdlib-Net-Resilience-RateStore)
#Since("0.3.0")
export let RateStore = module (
    /// @brief An atomic per-key store of theoretical arrival times.
    export let RateStore = interface (
        /// @brief The value stored for `key`, or None. Err when the store cannot be read.
        #NoDiscard
        let get = func(key: string) -> Result<optional.Optional<int64>>;
        /// @brief Stores `value` for `key` only if the key holds `expected` (None: the key is absent) and returns
        /// whether it did. `ttl` is how long the value matters; a store may drop the key after it. Err when the
        /// store cannot be written.
        #NoDiscard
        let compare_and_set = func(key: string, expected: optional.Optional<int64>, value: int64,
            ttl: durations.Duration) -> Result<bool>;
    );
);
