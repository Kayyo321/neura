let.promote _ = import:Std.Net.Quic.CongestionController;

/// @brief The CUBIC congestion controller of RFC 9438 for QUIC, in exact integer arithmetic.
///
/// With C = 0.4 segments per second cubed and beta_cubic = 0.7 (sections 4.6 and 5), windows in bytes of
/// `max_datagram_size` segments and times in whole milliseconds:
///
/// - `k_millis`: K = cbrt((W_max - cwnd_epoch) / C) (Figure 2), rounded down to whole milliseconds (exact: the
///   integer cube root of the rounded-down quotient), and 0 when W_max is not above cwnd_epoch;
/// - `w_cubic`: W_cubic(t) = C * (t - K)^3 + W_max (Figure 1), with the cubic term rounded toward zero to whole
///   bytes and |t - K| capped at 2,000,000 ms; the result is kept from 0 through `MaxWindow`;
/// - `w_est_increase`: alpha_cubic * acked * size / cwnd bytes (Figure 4 in bytes) with alpha_cubic =
///   3 * (1 - 0.7) / (1 + 0.7) = 9/17 until W_est reaches cwnd_prior, then 1, rounded down.
///
/// Slow start is that of RFC 9002 (Reno). Congestion avoidance starts an epoch at the first acknowledgment at or
/// above `ssthresh`: W_est = cwnd_epoch = cwnd, and when W_max is not above cwnd (slow start ended without a
/// loss, section 4.10) W_max = cwnd and K = 0. On each acknowledgment the target is W_cubic(t + RTT) kept within
/// cwnd and 1.5 * cwnd (section 4.2); when W_cubic(t) is below W_est and W_est is above cwnd the window becomes
/// W_est (the Reno-friendly region, section 4.3), and otherwise it grows by (target - cwnd) * acked / cwnd
/// (sections 4.4 and 4.5). A congestion event outside recovery saves cwnd_prior, sets W_max to cwnd, or to cwnd
/// * (1 + 0.7) / 2 with fast convergence when cwnd is below the previous W_max (section 4.7), sets ssthresh =
/// cwnd = max(cwnd * 0.7, minimum window) (section 4.6, using the window rather than the flight size, so the
/// window does not grow while the sender is application-limited) and ends the epoch. Persistent congestion sets
/// the minimum window. Recovery periods follow RFC 9002 as in `NewReno`.
/// @see [Std.Net.Quic.Cubic](https://github.com/Kayyo321/neura/wiki/Stdlib-Net-Quic-Cubic)
.Since("0.3.0")
export let Cubic = module (
    /// @brief The largest |t - K| in milliseconds used in W_cubic.
    const MaxOffsetMillis: int64 = 2000000;

    /// @brief One connection's CUBIC state.
    .[Final, NotThreadSafe]
    export let Cubic = class implements CongestionController (
        /// @brief The maximum datagram size (SMSS) in bytes.
        export last max_datagram_size: int64;
        /// @brief True when fast convergence (section 4.7) is enabled.
        export last fast_convergence: bool;
        /// @brief The congestion window.
        let cwnd: int64;
        /// @brief The slow-start threshold.
        let threshold: int64 = MaxWindow;
        /// @brief The bytes in flight.
        let in_flight: int64 = 0;
        /// @brief When the current recovery period started, or -1.
        let recovery_start: int64 = -1;
        /// @brief True while application- or flow-control-limited.
        let app_limited: bool = false;
        /// @brief W_max in bytes; 0 before the first congestion event.
        let w_max: int64 = 0;
        /// @brief cwnd_prior in bytes.
        let cwnd_prior: int64 = 0;
        /// @brief The start of the congestion-avoidance epoch, or -1.
        let epoch_start: int64 = -1;
        /// @brief K in milliseconds for the current epoch.
        let k: int64 = 0;
        /// @brief W_est in bytes.
        let w_est: int64 = 0;

        /// @brief A controller for a path with this maximum datagram size (1,200 through 65,527 bytes, else a
        /// trap), with or without fast convergence.
        export let init = func(datagram_size: int64, use_fast_convergence: bool) {
            check_datagram_size(datagram_size);
            max_datagram_size = datagram_size;
            fast_convergence = use_fast_convergence;
            cwnd = initial_window(datagram_size);
        };

        /// @brief The congestion window.
        export let window = func -> int64 => cwnd;

        /// @brief The slow-start threshold.
        .Pure
        export let ssthresh = func -> int64 => threshold;

        /// @brief W_max in bytes (0 before the first congestion event or epoch).
        .Pure
        export let max_window = func -> int64 => w_max;

        /// @brief K of the current epoch in milliseconds.
        .Pure
        export let k_of_epoch = func -> int64 => k;

        /// @brief W_est in bytes.
        .Pure
        export let reno_estimate = func -> int64 => w_est;

        /// @brief The bytes in flight.
        export let bytes_in_flight = func -> int64 => in_flight;

        /// @brief True when `bytes` more fit in the window.
        export let can_send = func(bytes: int64) -> bool => in_flight + bytes <= cwnd;

        /// @brief Adds a sent packet to the bytes in flight.
        export let on_packet_sent = func(bytes: int64, sent_nanos: int64) {
            check_event(bytes, sent_nanos);
            in_flight += bytes;
        };

        /// @brief Grows the window for an acknowledgment; `delay_nanos` is the smoothed RTT.
        export let on_packet_acked = func(bytes: int64, sent_nanos: int64, now_nanos: int64, delay_nanos: int64) {
            check_event(bytes, now_nanos);
            in_flight = remove_in_flight(in_flight, bytes);
            if (app_limited || sent_nanos <= recovery_start) {
                return;
            }
            if (cwnd < threshold) {
                cwnd = capped(cwnd + bytes);
                return;
            }
            if (epoch_start < 0) {
                epoch_start = now_nanos;
                w_est = cwnd;
                if (w_max <= cwnd) {
                    w_max = cwnd;
                    k = 0;
                } else {
                    k = k_millis(w_max, cwnd, max_datagram_size);
                }
                if (cwnd_prior == 0) {
                    cwnd_prior = cwnd;
                }
            }
            last t = (now_nanos - epoch_start) / 1000000;
            last rtt = (delay_nanos < 0 ? 0 : delay_nanos) / 1000000;
            let target = w_cubic(t + rtt, k, w_max, max_datagram_size);
            if (target < cwnd) {
                target = cwnd;
            }
            if (target > cwnd * 3 / 2) {
                target = cwnd * 3 / 2;
            }
            w_est = capped(w_est + w_est_increase(bytes, max_datagram_size, cwnd, w_est >= cwnd_prior));
            if (w_cubic(t, k, w_max, max_datagram_size) < w_est && w_est > cwnd) {
                cwnd = w_est;
            } else {
                cwnd = capped(cwnd + (target - cwnd) * bytes / cwnd);
            }
        };

        /// @brief Removes lost bytes and reacts as to a congestion event.
        export let on_packets_lost = func(bytes: int64, latest_sent_nanos: int64, now_nanos: int64) {
            check_event(bytes, now_nanos);
            in_flight = remove_in_flight(in_flight, bytes);
            on_congestion_event(latest_sent_nanos, now_nanos);
        };

        /// @brief Multiplicative decrease with fast convergence (sections 4.6 and 4.7).
        export let on_congestion_event = func(sent_nanos: int64, now_nanos: int64) {
            check_event(0, now_nanos);
            if (sent_nanos <= recovery_start) {
                return;
            }
            recovery_start = now_nanos;
            epoch_start = -1;
            if (fast_convergence && cwnd < w_max) {
                w_max = cwnd * 17 / 20;
            } else {
                w_max = cwnd;
            }
            cwnd_prior = cwnd;
            last reduced = cwnd * 7 / 10;
            last floor = minimum_window(max_datagram_size);
            threshold = reduced > floor ? reduced : floor;
            cwnd = threshold;
        };

        /// @brief Sets the minimum window, ends recovery and the epoch.
        export let on_persistent_congestion = func {
            cwnd = minimum_window(max_datagram_size);
            recovery_start = -1;
            epoch_start = -1;
        };

        /// @brief Whether the sender is application- or flow-control-limited.
        export let set_app_limited = func(limited: bool) {
            app_limited = limited;
        };

        /// @brief "Cubic".
        export let name = func -> string => "Cubic";

        /// @brief Text such as "Cubic(window 12000, in flight 0)".
        export let.override to_string = func -> string =>
            "Cubic(window " .. cwnd.to_string() .. ", in flight " .. in_flight.to_string() .. ")";
    );

    /// @brief K in whole milliseconds, rounded down: cbrt((w_max - cwnd_epoch) / (C * size)) seconds, with
    /// windows in bytes; 0 when `w_max` is not above `cwnd_epoch`.
    .Pure
    export let k_millis = func(w_max: int64, cwnd_epoch: int64, max_datagram_size: int64) -> int64 {
        return if (w_max <= cwnd_epoch) -> 0
            else -> integer_cube_root((w_max - cwnd_epoch) * 5000000000 / (2 * max_datagram_size));
    };

    /// @brief W_cubic(t) in bytes for `t_millis` into the epoch (see the module documentation).
    .Pure
    export let w_cubic = func(t_millis: int64, k: int64, w_max: int64, max_datagram_size: int64) -> int64 {
        let d = t_millis - k;
        last negative = d < 0;
        if (negative) {
            d = -d;
        }
        if (d > MaxOffsetMillis) {
            d = MaxOffsetMillis;
        }
        // 0.4 * size * (d / 1000)^3 = 2 * size * d^3 / (5 * 10^9), rounded toward zero.
        last cube = d * d * d;
        last whole = 2 * max_datagram_size * (cube / 1000000000);
        last part = 2 * max_datagram_size * (cube % 1000000000);
        last offset = whole / 5 + ((whole % 5) * 1000000000 + part) / 5000000000;
        let result = negative ? w_max - offset : w_max + offset;
        if (result < 0) {
            result = 0;
        }
        return capped(result);
    };

    /// @brief The W_est increase for `acked` bytes: alpha * acked * size / cwnd, with alpha 9/17, or 1 when
    /// `full_alpha` (W_est has reached cwnd_prior), rounded down.
    .Pure
    export let w_est_increase = func(acked: int64, max_datagram_size: int64, cwnd: int64, full_alpha: bool) -> int64 =>
        full_alpha ? acked * max_datagram_size / cwnd : 9 * acked * max_datagram_size / (17 * cwnd);

    /// @brief The largest n with n^3 <= value (value non-negative).
    .Pure
    export let integer_cube_root = func(value: int64) -> int64 {
        if (value < 0) {
            trap_with_message("invalid argument: negative cube");
        }
        let low: int64 = 0;
        let high: int64 = 2097151;
        while (low < high) {
            last mid = low + (high - low + 1) / 2;
            if (mid * mid * mid <= value) {
                low = mid;
            } else {
                high = mid - 1;
            }
        }
        return low;
    };
);
