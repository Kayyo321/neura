let bytes = import:Std.Io.Internal.Bytes;
let.promote _ = import:Std.Time.Duration;
let errors = import:Std.Core.Error;
let host = import:Std.Net.Quic.Internal.HostCalls;
let.promote _ = import:Std.Net.MultiplexedTransport;
let.promote _ = import:Std.Core.Optional;
let.promote _ = import:Std.Net.Quic.QuicConfig;
let.promote _ = import:Std.Net.Quic.QuicStream;
let.promote _ = import:Std.Core.Result;
let.promote _ = import:Std.Net.Quic.SessionTicket;
let.promote _ = import:Std.Net.Core.SocketAddr;
let stream_ids = import:Std.Net.Quic.StreamId;
let support = import:Std.Net.Socket.Internal.Support;
let tls = import:Std.Net.Tls.TlsConfig;
let.promote _ = import:Std.Core.Unit;

/// @brief A QUIC connection (RFC 9000) over the pinned OpenSSL 4.1 QUIC stack, as an immutable handle that any
/// task may hold, and as a `Std.Net.MultiplexedTransport` of stream IDs and byte frames.
///
/// The connection's state lives in the host provider. The handle holds its ID, its side, the selected ALPN
/// protocol and a default timeout fixed at `connect` or `accept`, so it crosses a spawn or a channel and several
/// tasks can each wait on their own stream of one connection (Concurrency.md, "Host resource handles"). One
/// `accept`/`accept_stream` may be pending per connection; a second fails at once with the Custom error
/// `quic.busy`. After any task closes the connection, every operation on it and its streams fails with
/// `IoErrorKind.Closed`.
///
/// Limited by the pinned QUIC stack (typed `Unsupported`): RFC 9221 datagrams (`send`, `receive`, and a
/// configuration with `max_datagram_frame_size` above 0), application-directed migration (`migrate`), 0-RTT
/// early data, a congestion controller other than NewReno, and stream limits other than the stack's 100. Session
/// tickets are not yet offered.
/// @see [Std.Net.Quic.QuicConnection](https://github.com/Kayyo321/neura/wiki/Stdlib-Net-Quic-QuicConnection)
.Since("0.3.0")
export let QuicConnection = module (
    /// @brief The stream limit the pinned stack advertises; any other configured limit is unsupported.
    .Since("0.3.1")
    export const StackStreamLimit: int64 = 100;
    /// @brief The idle timeout the connections use, the stack's default; any other configured value is refused.
    .Since("0.3.1")
    export const StackIdleTimeoutNanos: int64 = 30000000000;
    /// @brief The maximum UDP payload the connections send, the stack's default; any other value is refused.
    .Since("0.3.1")
    export const StackDatagramSize: int64 = 1200;

    /// @brief One QUIC connection.
    .[Final, Immutable]
    export let QuicConnection = class implements MultiplexedTransport<int64, uint8[list]> (
        /// @brief The provider's connection ID.
        last id: int64;
        /// @brief The address text used in error messages.
        last label: string;
        /// @brief True on the client side.
        export last client: bool;
        /// @brief The ALPN protocol the handshake selected.
        export last alpn: string;
        /// @brief The default timeout of waiting operations in nanoseconds; zero waits without limit.
        last timeout_nanos: int64;

        /// @brief Use `connect` or `QuicEndpoint.accept`; the ID comes from the library.
        export let init = func(connection: int64, address: string, is_client: bool, protocol: string,
            default_timeout: int64) {
            id = connection;
            label = address;
            client = is_client;
            alpn = protocol;
            timeout_nanos = default_timeout;
        };

        /// @brief The default timeout of waiting operations; zero waits without limit.
        .Since("0.3.1")
        export let timeout = func -> Duration => of_nanos(timeout_nanos);

        /// @brief Opens a stream of this side, bidirectional or send-only, without waiting. Fails with
        /// `quic.busy` at the peer's stream limit.
        .[NoDiscard, Since("0.3.1")]
        export let open = func(bidirectional: bool) -> Result<QuicStream> {
            return match (host.open_stream(id, bidirectional)) {
                host.StreamOutcome.Ok(stream) => Result<QuicStream>.Ok(new QuicStream(id, stream, true,
                    timeout_nanos, label)),
                host.StreamOutcome.Error(code) => Result<QuicStream>.Err(
                    host.error_of(code, "QUIC stream open failed", label)),
            };
        };

        /// @brief Waits for the next stream the peer opens, with the default timeout or `timeout`.
        .[NoDiscard, Since("0.3.1")]
        export let accept = func -> Result<QuicStream> => accept_within(timeout_nanos)
            or func(timeout: Duration) -> Result<QuicStream> => accept_within(support.timeout_nanos(timeout));

        /// @brief As `open`, returning the stream ID (`MultiplexedTransport`).
        .NoDiscard
        export let open_stream = func(bidirectional: bool) -> Result<int64> {
            last stream = open(bidirectional)?;
            return Result<int64>.Ok(stream.id);
        };

        /// @brief As `accept`, returning the stream ID (`MultiplexedTransport`).
        .NoDiscard
        export let accept_stream = func -> Result<int64> {
            last stream = accept_within(timeout_nanos)?;
            return Result<int64>.Ok(stream.id);
        };

        /// @brief Sends `frame` on `stream`. A stream this side cannot send on (the peer's unidirectional
        /// stream) is a `quic.stream_state` error.
        .NoDiscard
        export let send_on = func(stream: int64, frame: uint8[list]) -> Result<Unit> {
            return Result<Unit>.Err(state_error(stream, "is receive-only for this side")) unless stream_ids.may_send(stream, client);
            return handle(stream).write(frame);
        };

        /// @brief The next bytes of `stream`, or `None` once the peer finished it.
        .NoDiscard
        export let receive_on = func(stream: int64) -> Result<Optional<uint8[list]>> {
            return Result<Optional<uint8[list]>>.Err(state_error(stream, "is send-only for this side")) unless stream_ids.may_receive(stream, client);
            return handle(stream).read(65536);
        };

        /// @brief Finishes this side of `stream` (a STREAM frame with FIN).
        .NoDiscard
        export let finish_stream = func(stream: int64) -> Result<Unit> {
            return Result<Unit>.Err(state_error(stream, "is receive-only for this side")) unless stream_ids.may_send(stream, client);
            handle(stream).finish()?;
            return bytes.ok();
        };

        /// @brief Unsupported: the pinned QUIC stack has no RFC 9221 datagrams.
        .NoDiscard
        export let send = func(data: uint8[list]) -> Result<Unit> => Result<Unit>.Err(limited("RFC 9221 datagrams"));

        /// @brief Unsupported: the pinned QUIC stack has no RFC 9221 datagrams.
        .NoDiscard
        export let receive = func -> Result<Optional<uint8[list]>> =>
            Result<Optional<uint8[list]>>.Err(limited("RFC 9221 datagrams"));

        /// @brief Unsupported: the pinned QUIC stack has no application-directed migration.
        .NoDiscard
        export let migrate = func(local: SocketAddr) -> Result<Unit> =>
            Result<Unit>.Err(limited("application-directed connection migration"));

        /// @brief Unsupported until session resumption is offered.
        .NoDiscard
        export let session_ticket = func -> Result<Optional<SessionTicket>> =>
            Result<Optional<SessionTicket>>.Err(limited("session tickets"));

        /// @brief Closes the connection with application error 0 (CONNECTION_CLOSE).
        export let close = func -> Result<Unit> {
            close_with(0, "")?;
            return bytes.ok();
        };

        /// @brief Closes the connection with an application error code (0 through 2^62 - 1) and a reason, after
        /// the streams' buffered data. Every handle of the connection fails with `Closed` from the start.
        /// `true` when the connection terminated within the default timeout (or two seconds without one),
        /// `false` when it was released before that.
        .Since("0.3.1")
        export let close_with = func(code: int64, reason: string) -> Result<bool> {
            return match (host.close(id, code, reason, timeout_nanos)) {
                host.CloseOutcome.Ok(terminated) => Result<bool>.Ok(terminated),
                host.CloseOutcome.Error(failure) => Result<bool>.Err(host.error_of(failure, "QUIC close failed", label)),
            };
        };

        /// @brief Text such as "QuicConnection(client, h3, 192.0.2.1:443)".
        export let.override to_string = func -> string =>
            "QuicConnection(" .. (client ? "client" : "server") .. ", " .. alpn .. ", " .. label .. ")";

        let accept_within = func(nanos: int64) -> Result<QuicStream> {
            return match (host.accept_stream(id, nanos)) {
                host.AcceptedOutcome.Ok(accepted) => Result<QuicStream>.Ok(accepted_stream(accepted)),
                host.AcceptedOutcome.Error(code) => Result<QuicStream>.Err(
                    host.error_of(code, "QUIC stream accept failed", label)),
            };
        };

        let accepted_stream = func(accepted: [int64, bool]) -> QuicStream {
            let [stream, bidirectional] = accepted;
            return new QuicStream(id, stream, false, timeout_nanos, label);
        };

        let handle = func(stream: int64) -> QuicStream =>
            new QuicStream(id, stream, stream_ids.is_client_initiated(stream) == client, timeout_nanos, label);
    );

    /// @brief Opens a QUIC connection to `address` with a client configuration (its TLS settings give the server
    /// name, CA file and ALPN). The handshake is bounded by the TLS handshake timeout, which is also the default
    /// timeout of later waiting operations. A ticket, 0-RTT bytes, or a configuration the pinned stack cannot
    /// honour (see the module documentation) fail with `Unsupported` before any host call.
    .NoDiscard
    export let connect = func(address: SocketAddr, config: QuicConfig, ticket: Optional<SessionTicket>,
        early_bytes: uint8[list]) -> Result<QuicConnection> {
        check_limits(config)?;
        match (ticket) {
            Optional.Some(_) => {
                return Result<QuicConnection>.Err(limited("session resumption"));
            },
            Optional.None => {},
        }
        if (early_bytes.length > 0) {
            return Result<QuicConnection>.Err(limited("0-RTT early data"));
        }
        last text = address.to_string();
        last tls_config = config.tls_config;
        last nanos = support.timeout_nanos(tls_config.handshake_timeout);
        return match (host.connect(address.host_text(), address.port, nanos, tls_config.server_name, tls_config.alpn(),
            tls_config.ca_file)) {
            host.ConnectionOutcome.Ok(opened) => Result<QuicConnection>.Ok(connection_of(opened, text, true, nanos)),
            host.ConnectionOutcome.Error(code) => Result<QuicConnection>.Err(
                host.error_of(code, "QUIC connect failed", text)),
        };
    };

    /// @brief A connection handle from the host's [ID, ALPN]. Library use: `QuicEndpoint.accept` builds its
    /// connections with it.
    .Since("0.3.1")
    export let connection_of = func(opened: [int64, string], address: string, is_client: bool, nanos: int64)
        -> QuicConnection {
        let [id, protocol] = opened;
        return new QuicConnection(id, address, is_client, protocol, nanos);
    };

    /// @brief `Ok` when the pinned QUIC stack can honour `config`, else the typed `Unsupported` of the first
    /// setting it cannot.
    .[NoDiscard, Since("0.3.1")]
    export let check_limits = func(config: QuicConfig) -> Result<Unit> {
        if (config.max_datagram_frame_size > 0) {
            return Result<Unit>.Err(limited("RFC 9221 datagrams"));
        }
        if (config.early_data) {
            return Result<Unit>.Err(limited("0-RTT early data"));
        }
        if (config.congestion != CongestionAlgorithm.NewReno) {
            return Result<Unit>.Err(limited("congestion controller " .. config.congestion.to_string()));
        }
        if (config.max_bidirectional_streams != StackStreamLimit || config.max_unidirectional_streams != StackStreamLimit) {
            return Result<Unit>.Err(limited("stream limits other than " .. StackStreamLimit.to_string()));
        }
        // Not offered yet, refused rather than ignored.
        last settings = config.tls_config;
        if (config.idle_timeout.to_nanos() != StackIdleTimeoutNanos) {
            return Result<Unit>.Err(not_offered("an idle timeout other than 30 seconds"));
        }
        if (config.max_datagram_size != StackDatagramSize) {
            return Result<Unit>.Err(not_offered("a maximum datagram size other than 1200 bytes"));
        }
        if (settings.client_ca_file != "" || (settings.role == tls.TlsRole.Client && settings.certificate_file != "")) {
            return Result<Unit>.Err(not_offered("mutual TLS"));
        }
        if (settings.kernel_offload) {
            return Result<Unit>.Err(not_offered("kernel TLS offload"));
        }
        return bytes.ok();
    };

    /// @brief A typed `Unsupported` for a setting `Std.Net.Quic` does not honour yet.
    let not_offered = func(feature: string) -> errors.Error =>
        errors.Error.Io { kind: errors.IoErrorKind.Unsupported, message: feature
            .. " is not offered by Std.Net.Quic yet", path: "" };

    /// @brief A typed `Unsupported` for a feature the pinned QUIC stack lacks.
    let limited = func(feature: string) -> errors.Error =>
        errors.Error.Io { kind: errors.IoErrorKind.Unsupported, message: feature
            .. " are limited by the pinned QUIC stack (OpenSSL 4.1)", path: "" };

    /// @brief A `quic.stream_state` error.
    let state_error = func(stream: int64, text: string) -> errors.Error =>
        errors.custom("quic.stream_state", "stream " .. stream.to_string() .. " " .. text);
);
