let bbr = import:Std.Net.Quic.Bbr;
let.promote _ = import:Std.Net.Quic.CongestionController;
let.promote _ = import:Std.Time.Duration;
let cubic = import:Std.Net.Quic.Cubic;
let errors = import:Std.Core.Error;
let ledbat = import:Std.Net.Quic.Ledbat;
let new_reno = import:Std.Net.Quic.NewReno;
let.promote _ = import:Std.Core.Result;
let stream_ids = import:Std.Net.Quic.StreamId;
let tls = import:Std.Net.Tls.TlsConfig;
let varint = import:Std.Net.Quic.VarInt;

/// @brief The settings of a QUIC endpoint: TLS, transport parameters, and the congestion controller.
///
/// `create` checks them and reports the first problem as a Custom error with the code `quic.config`: the TLS
/// configuration must allow only TLS 1.3 (RFC 9001 section 4.2: "Clients MUST NOT offer TLS versions older than
/// 1.3") and list at least one ALPN protocol (section 8.1); the stream limits are at most 2^60 (RFC 9000 section
/// 4.6); `max_datagram_frame_size` is at most 2^62 - 1, 0 meaning DATAGRAM frames are not accepted (RFC 9221
/// section 3); the idle timeout is not negative (0 means none); and the maximum datagram size is 1,200 through
/// 65,527 bytes (RFC 9002 section B.2). `new_controller` builds the chosen congestion controller for a new
/// connection; BBRv3 is a stub.
/// @see [Std.Net.Quic.QuicConfig](https://github.com/Kayyo321/neura/wiki/Stdlib-Net-Quic-QuicConfig)
.Since("0.3.0")
export let QuicConfig = module (
    /// @brief The congestion controllers.
    export let CongestionAlgorithm = enum (NewReno, Cubic, Ledbat, Bbr3);

    /// @brief A validated QUIC configuration.
    .Final
    export let QuicConfig = class (
        /// @brief The TLS 1.3 configuration, with ALPN.
        export last tls_config: tls.TlsConfig;
        /// @brief `initial_max_streams_bidi`: bidirectional streams the peer may open.
        export last max_bidirectional_streams: int64;
        /// @brief `initial_max_streams_uni`: unidirectional streams the peer may open.
        export last max_unidirectional_streams: int64;
        /// @brief `max_datagram_frame_size`; 0 refuses DATAGRAM frames.
        export last max_datagram_frame_size: uint64;
        /// @brief `max_idle_timeout`; zero means none.
        export last idle_timeout: Duration;
        /// @brief The maximum UDP payload the endpoint sends.
        export last max_datagram_size: int64;
        /// @brief The congestion controller of new connections.
        export last congestion: CongestionAlgorithm;
        /// @brief True when a client sends, or a server accepts, 0-RTT data.
        export last early_data: bool;

        /// @brief Use `create`.
        export let init = func(tls_settings: tls.TlsConfig, bidirectional: int64, unidirectional: int64,
            datagram_frame_size: uint64, idle: Duration, datagram_size: int64, algorithm: CongestionAlgorithm,
            zero_rtt: bool) {
            tls_config = tls_settings;
            max_bidirectional_streams = bidirectional;
            max_unidirectional_streams = unidirectional;
            max_datagram_frame_size = datagram_frame_size;
            idle_timeout = idle;
            max_datagram_size = datagram_size;
            congestion = algorithm;
            early_data = zero_rtt;
        };

        /// @brief A new congestion controller of the configured algorithm (Cubic with fast convergence, LEDBAT
        /// with a 100 ms target). Bbr3 traps (see `Bbr.bbr3`).
        .NoDiscard
        export let new_controller = func -> CongestionController {
            if (congestion == CongestionAlgorithm.NewReno) {
                return new new_reno.NewReno(max_datagram_size);
            }
            if (congestion == CongestionAlgorithm.Cubic) {
                return new cubic.Cubic(max_datagram_size, true);
            }
            return if (congestion == CongestionAlgorithm.Ledbat) -> new ledbat.Ledbat(max_datagram_size, of_millis(100))
                else -> bbr.bbr3(max_datagram_size);
        };

        /// @brief Text such as "QuicConfig(Cubic, alpn h3, 100/100 streams, datagrams 65535)".
        export let.override to_string = func -> string {
            last protocols = tls_config.alpn();
            let alpn = "";
            for (let name in protocols) {
                alpn ..= (alpn.byte_length > 0 ? "," : "") .. name;
            }
            return "QuicConfig(" .. congestion.to_string() .. ", alpn " .. alpn .. ", "
                .. max_bidirectional_streams.to_string() .. "/" .. max_unidirectional_streams.to_string() .. " streams, "
                .. "datagrams " .. max_datagram_frame_size.to_string() .. ")";
        };
    );

    /// @brief A checked configuration (see the module documentation).
    .NoDiscard
    export let create = func(tls_config: tls.TlsConfig, max_bidirectional_streams: int64,
        max_unidirectional_streams: int64, max_datagram_frame_size: uint64, idle_timeout: Duration,
        max_datagram_size: int64, congestion: CongestionAlgorithm, early_data: bool) -> Result<QuicConfig> {
        if (tls_config.min_version != tls.TlsVersion.Tls13) {
            return invalid("QUIC needs TLS 1.3 only");
        }
        if (tls_config.alpn().length == 0) {
            return invalid("QUIC needs at least one ALPN protocol");
        }
        if (max_bidirectional_streams < 0 || max_bidirectional_streams > stream_ids.MaxStreamCount
            || max_unidirectional_streams < 0 || max_unidirectional_streams > stream_ids.MaxStreamCount) {
            return invalid("a stream limit must be 0 through 2^60");
        }
        if (max_datagram_frame_size > varint.MaxValue) {
            return invalid("max_datagram_frame_size must be at most 2^62 - 1");
        }
        if (idle_timeout.to_nanos() < 0) {
            return invalid("the idle timeout is negative");
        }
        if (max_datagram_size < MinDatagramSize || max_datagram_size > 65527) {
            return invalid("the maximum datagram size must be 1200 through 65527 bytes");
        }
        return Result<QuicConfig>.Ok(new QuicConfig(tls_config, max_bidirectional_streams, max_unidirectional_streams,
            max_datagram_frame_size, idle_timeout, max_datagram_size, congestion, early_data));
    };

    /// @brief A `quic.config` failure.
    let invalid = func(text: string) -> Result<QuicConfig> =>
        Result<QuicConfig>.Err(errors.custom("quic.config", text));
);
