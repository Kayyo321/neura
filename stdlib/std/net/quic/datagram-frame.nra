let.promote _ = import:Std.Core.Error;
let.promote _ = import:Std.Core.Result;
let varint = import:Std.Net.Quic.VarInt;

/// @brief QUIC DATAGRAM frames (RFC 9221): unreliable application datagrams inside QUIC packets.
///
/// The frame type is 0x30 (48) when the data runs to the end of the packet and 0x31 (49) when a Length field
/// (a variable-length integer) precedes it (section 4); empty datagrams are allowed. A peer announces support
/// with the `max_datagram_frame_size` transport parameter (0x20, section 3), the largest whole frame it accepts;
/// `fits` checks a frame against it. The encodings are real. Sending and receiving them needs a QUIC
/// transport, which Neura 0.3.0 does not have (see `QuicConnection`).
/// @see [Std.Net.Quic.DatagramFrame](https://github.com/Kayyo321/neura/wiki/Stdlib-Net-Quic-DatagramFrame)
.Since("0.3.0")
export let DatagramFrame = module (
    /// @brief The frame type without a Length field.
    export const TypeWithoutLength: uint64 = 48;
    /// @brief The frame type with a Length field.
    export const TypeWithLength: uint64 = 49;
    /// @brief The transport parameter ID of `max_datagram_frame_size`.
    export const MaxDatagramFrameSizeParameter: uint64 = 32;

    /// @brief The frame carrying `data`, with a Length field when `with_length` (required unless the frame is
    /// the last in its packet).
    .NoDiscard
    export let encode = func(data: uint8[list], with_length: bool) -> uint8[list] {
        let out: uint8[list] = new;
        varint.append(out, with_length ? TypeWithLength : TypeWithoutLength);
        if (with_length) {
            varint.append(out, data.length as uint64);
        }
        for (let b in data) {
            out.append(b);
        }
        return out;
    };

    /// @brief The size of the encoded frame.
    .Pure
    export let encoded_size = func(data_length: int, with_length: bool) -> int =>
        1 + (with_length ? varint.encoded_length(data_length as uint64) : 0) + data_length;

    /// @brief True when a frame of this datagram stays within the peer's `max_datagram_frame_size` (zero means
    /// the peer does not accept DATAGRAM frames).
    .Pure
    export let fits = func(data_length: int, with_length: bool, max_frame_size: uint64) -> bool =>
        max_frame_size > 0 && (encoded_size(data_length, with_length) as uint64) <= max_frame_size;

    /// @brief Decodes the DATAGRAM frame at `offset` of a packet payload that ends at `bytes.length`: the data
    /// and the offset after the frame. A Parse error when the type is not 0x30 or 0x31 (Syntax) or the bytes
    /// end early (UnexpectedEnd).
    .NoDiscard
    export let decode = func(bytes: uint8[list], offset: int) -> Result<[uint8[list], int]> {
        let [kind, type_size] = varint.decode(bytes, offset)?;
        if (kind != TypeWithoutLength && kind != TypeWithLength) {
            return Result<[uint8[list], int]>.Err(Error.Parse { kind: ParseErrorKind.Syntax, offset: offset,
                message: "not a DATAGRAM frame type" });
        }
        let start = offset + type_size;
        let end = bytes.length;
        if (kind == TypeWithLength) {
            let [length, length_size] = varint.decode(bytes, start)?;
            start = start + length_size;
            if (length > ((bytes.length - start) as uint64)) {
                return Result<[uint8[list], int]>.Err(Error.Parse { kind: ParseErrorKind.UnexpectedEnd,
                    offset: start, message: "the DATAGRAM data is shorter than its Length field" });
            }
            end = start + (length as int);
        }
        let data: uint8[list] = new;
        let i = start;
        while (i < end) {
            data.append(bytes[i]);
            i++;
        }
        return Result<[uint8[list], int]>.Ok([data, end]);
    };
);
