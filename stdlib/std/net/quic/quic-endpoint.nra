let bytes = import:Std.Io.Internal.Bytes;
let.promote _ = import:Std.Time.Duration;
let host = import:Std.Net.Quic.Internal.HostCalls;
let.promote _ = import:Std.Net.Listener;
let.promote _ = import:Std.Net.Quic.QuicConfig;
let.promote _ = import:Std.Net.Quic.QuicConnection;
let.promote _ = import:Std.Core.Result;
let.promote _ = import:Std.Net.Core.SocketAddr;
let support = import:Std.Net.Socket.Internal.Support;
let tls = import:Std.Net.Tls.TlsConfig;
let.promote _ = import:Std.Core.Unit;

/// @brief A QUIC server endpoint: a UDP port that accepts QUIC connections, as a `Std.Net.Listener` of
/// `QuicConnection`s, and an immutable handle that any task may hold. Needs the net and fs capabilities.
///
/// `bind` needs a server configuration whose TLS settings hold the certificate and key, checked before any host
/// call ("invalid argument: a QUIC endpoint needs a server configuration"), and a configuration the pinned QUIC
/// stack can honour (`QuicConnection.check_limits`). A server configuration with a client CA file requires and
/// verifies a client certificate (mutual TLS); the idle timeout and maximum datagram size are requested from
/// every client as transport parameters. One `accept` may be pending at a time; a second fails at
/// once with `quic.busy`. Closing the endpoint closes the connections it accepted, since they share its port;
/// afterwards their operations fail with `IoErrorKind.Closed`.
/// @see [Std.Net.Quic.QuicEndpoint](https://github.com/Kayyo321/neura/wiki/Stdlib-Net-Quic-QuicEndpoint)
.Since("0.3.0")
export let QuicEndpoint = module (
    /// @brief A listening QUIC endpoint.
    .[Final, Immutable]
    export let QuicEndpoint = class implements Listener<SocketAddr, QuicConnection> (
        /// @brief The provider's endpoint ID.
        last id: int64;
        /// @brief The bound address with the chosen port.
        last bound: SocketAddr;
        /// @brief The handshake timeout, the default timeout of `accept`.
        last timeout_nanos: int64;
        /// @brief The configuration's `read_timeout`, the default timeout of accepted connections.
        last read_nanos: int64;

        /// @brief Use `bind`: only the library holds the seal and the provider's ID.
        export let init = func(seal: host.Seal, endpoint: int64, address: SocketAddr, default_timeout: int64,
            read_timeout: int64) {
            id = endpoint;
            bound = address;
            timeout_nanos = default_timeout;
            read_nanos = read_timeout;
        };

        /// @brief The bound address.
        export let address = func -> SocketAddr => bound;

        /// @brief Waits for the next connection and completes its handshake within the configured handshake
        /// timeout (`Listener`).
        .NoDiscard
        export let accept = func -> Result<QuicConnection> => accept_nanos(timeout_nanos);

        /// @brief As `accept`, within `timeout` (zero: none). A separate name, because `accept` implements
        /// `Listener` and an overload group cannot.
        .[NoDiscard, Since("0.3.1")]
        export let accept_within = func(timeout: Duration) -> Result<QuicConnection> =>
            accept_nanos(support.timeout_nanos(timeout));

        /// @brief Closes the endpoint and every connection it accepted, and releases the port.
        export let close = func -> Result<Unit> {
            return match (host.close(id, 0, "", 0)) {
                host.CloseOutcome.Ok(_) => bytes.ok(),
                host.CloseOutcome.Error(code) => Result<Unit>.Err(host.error_of(code, "close failed", bound.to_string())),
            };
        };

        /// @brief Text such as "QuicEndpoint(0.0.0.0:443)".
        export let.override to_string = func -> string => "QuicEndpoint(" .. bound.to_string() .. ")";

        let accept_nanos = func(nanos: int64) -> Result<QuicConnection> {
            return match (host.accept(id, nanos)) {
                host.ConnectionOutcome.Ok(accepted) => Result<QuicConnection>.Ok(
                    connection_of(host.Seal.Library, accepted, bound.to_string(), false, read_nanos)),
                host.ConnectionOutcome.Error(code) => Result<QuicConnection>.Err(
                    host.error_of(code, "QUIC accept failed", bound.to_string())),
            };
        };
    );

    /// @brief Listens for QUIC on `address` (port 0 asks for a free port) with a server configuration.
    .NoDiscard
    export let bind = func(address: SocketAddr, config: QuicConfig) -> Result<QuicEndpoint> {
        if (config.tls_config.role != tls.TlsRole.Server) {
            trap_with_message("invalid argument: a QUIC endpoint needs a server configuration");
        }
        check_limits(config)?;
        last text = address.to_string();
        last settings = config.tls_config;
        return match (host.listen(address.host_text(), address.port, settings.certificate_file, settings.key_file,
            settings.alpn(), support.timeout_nanos(config.idle_timeout), config.max_datagram_size as int,
            settings.client_ca_file)) {
            host.EndpointOutcome.Ok(opened) => Result<QuicEndpoint>.Ok(endpoint_of(opened, address,
                support.timeout_nanos(settings.handshake_timeout), support.timeout_nanos(config.read_timeout))),
            host.EndpointOutcome.Error(code) => Result<QuicEndpoint>.Err(host.error_of(code, "QUIC bind failed", text)),
        };
    };

    /// @brief An endpoint from the host's [ID, port].
    let endpoint_of = func(opened: [int64, int], address: SocketAddr, nanos: int64, read_nanos: int64) -> QuicEndpoint {
        let [id, port] = opened;
        return new QuicEndpoint(host.Seal.Library, id, new SocketAddr(address.ip, port), nanos, read_nanos);
    };
);
