/// @brief Host bindings for sockets beyond TCP streams (docs/runtime/NVM.md, "Socket services"): UDP, Unix-domain
/// stream and datagram sockets, socket options, system name resolution and sending a file. The public Std.Net
/// types wrap them; the IDs share the table of Std.Net.TcpStream and Std.Net.TcpListener, so a Unix stream reads,
/// writes, accepts and closes through the same services. Every call needs the net capability (send_file also
/// fs) and fails with error 14 without it. None of these calls overlaps with other tasks.
export let Sockets = module (
    /// @brief A socket or other ID, or an unsigned host error code.
    export let IdOutcome = enum (Ok(int64), Error(uint32));
    /// @brief A byte count, or an unsigned host error code.
    export let CountOutcome = enum (Ok(int), Error(uint32));
    /// @brief Bytes read, or an unsigned host error code.
    export let BytesOutcome = enum (Ok(uint8[list]), Error(uint32));
    /// @brief A 64-bit count or option value, or an unsigned host error code.
    export let LongOutcome = enum (Ok(int64), Error(uint32));
    /// @brief Success without a value, or an unsigned host error code.
    export let DoneOutcome = enum (Ok, Error(uint32));
    /// @brief A datagram: its bytes, the sender's address (a numeric IP address, or a Unix path with `@` for
    /// the Linux abstract namespace) and port (0 for Unix), or an unsigned host error code.
    export let DatagramOutcome = enum (Ok([uint8[list], string, int]), Error(uint32));
    /// @brief Numeric address texts, or an unsigned host error code.
    export let AddressesOutcome = enum (Ok(string[list]), Error(uint32));

    /// @brief The option numbers of `set_option` and `get_option`. Booleans are 0 or 1; times are seconds
    /// except UserTimeout, in milliseconds; buffer sizes are bytes. An option the platform lacks fails with
    /// Unsupported (13).
    export let REUSE_ADDRESS = 1;
    export let REUSE_PORT = 2;
    export let NO_DELAY = 3;
    export let FAST_OPEN = 4;
    export let USER_TIMEOUT = 5;
    export let KEEP_ALIVE = 6;
    export let KEEP_IDLE = 7;
    export let KEEP_INTERVAL = 8;
    export let KEEP_COUNT = 9;
    export let RECEIVE_BUFFER = 10;
    export let SEND_BUFFER = 11;
    export let BROADCAST = 12;

    /// @brief A UDP socket bound to a numeric address (empty for any IPv4 address, or "localhost") and port
    /// (0 asks for one; Std.Net.TcpListener's local_port reads it).
    export let udp_bind = func(host: string, port: int) -> IdOutcome host("neura.net.udp.bind", 1);
    /// @brief Sends one datagram to a numeric address and port; the count sent.
    export let udp_send_to = func(socket: int64, host: string, port: int, bytes: uint8[list]) -> CountOutcome
        host("neura.net.udp.send_to", 1);
    /// @brief Receives one datagram of at most `max` bytes, waiting at most `timeout_nanos` (0 waits without
    /// limit); TimedOut (12) when none arrives.
    export let udp_receive_from = func(socket: int64, max: int, timeout_nanos: int64) -> DatagramOutcome
        host("neura.net.udp.receive_from", 1);
    /// @brief A Unix-domain stream connected to `path` (`@name` for the Linux abstract namespace).
    export let unix_connect = func(path: string) -> IdOutcome host("neura.net.unix.connect", 1);
    /// @brief A Unix-domain stream listener bound to `path`; accept with Std.Net's accept service.
    export let unix_listen = func(path: string) -> IdOutcome host("neura.net.unix.listen", 1);
    /// @brief A Unix-domain datagram socket, bound to `path` unless it is empty.
    export let unix_datagram = func(path: string) -> IdOutcome host("neura.net.unix.datagram", 1);
    /// @brief Sends one datagram to the Unix socket at `path`.
    export let unix_send_to = func(socket: int64, path: string, bytes: uint8[list]) -> CountOutcome
        host("neura.net.unix.send_to", 1);
    /// @brief Receives one datagram from a Unix datagram socket.
    export let unix_receive_from = func(socket: int64, max: int, timeout_nanos: int64) -> DatagramOutcome
        host("neura.net.unix.receive_from", 1);
    /// @brief Sets a socket option to `value`.
    export let set_option = func(socket: int64, option: int, value: int64) -> DoneOutcome
        host("neura.net.option.set", 1);
    /// @brief Reads a socket option.
    export let get_option = func(socket: int64, option: int) -> LongOutcome host("neura.net.option.get", 1);
    /// @brief The numeric addresses of `host` from the system resolver (getaddrinfo): family 0 for any, 4 or 6.
    /// It blocks every task while it waits. NotFound (1) when the name does not exist.
    export let resolve = func(host: string, family: int) -> AddressesOutcome host("neura.net.resolve", 1);
    /// @brief The bound port of a TCP or UDP socket.
    export let local_port = func(socket: int64) -> CountOutcome host("neura.net.local_port", 1);
    /// @brief Accepts one stream from a TCP or Unix listener. Overlapping and cancellable.
    export let accept = func(listener: int64) -> IdOutcome host("neura.net.accept", 2);
    /// @brief Up to `max` bytes from a stream; empty at its end. Overlapping and cancellable.
    export let read = func(socket: int64, max: int, timeout_nanos: int64) -> BytesOutcome host("neura.net.read", 2);
    /// @brief Writes a prefix of `bytes` to a stream and returns its length. Overlapping and cancellable.
    export let write = func(socket: int64, bytes: uint8[list]) -> CountOutcome host("neura.net.write", 2);
    /// @brief Releases any socket ID.
    export let close = func(socket: int64) -> DoneOutcome host("neura.net.close", 1);
    /// @brief Sends `count` bytes of an open file from `offset` to a connected stream; the count sent.
    export let send_file = func(socket: int64, file: int64, offset: int64, count: int64) -> LongOutcome
        host("neura.net.send_file", 1);
);
