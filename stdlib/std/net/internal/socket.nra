// The host ID of an open socket and the address text it was opened with.
// Only Std.Net creates one; the ID never leaves the library.
export let Socket = module (
    export let Handle = class (
        export let id: int64 = 0;
        export let address: string = "";

        export let init = func(host_id: int64, address_text: string) {
            id = host_id;
            address = address_text;
        };
    );

    // A port outside 0 through 65,535 traps.
    export let check_port = func(port: int) {
        if (port < 0 || port > 65535) {
            trap_with_message("invalid argument: port");
        }
    };

    export let address_of = func(host: string, port: int) -> string => host + ":" + port.to_string();
);
