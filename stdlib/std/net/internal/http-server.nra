/// @brief The host services of a server image (docs/design/Backend030.md, "Provider ABI"). Only Std.App uses
/// them. A request worker of neura-server-host answers them; under any other runner every call fails with
/// error 14 (CapabilityDenied).
export let HttpServer = module (
    /// @brief The assigned request: kind (1 request, 2 startup check), identifier, method, target, header
    /// fields as alternating lowercase names and values, body length, peer address, scheme, and deadline in
    /// Unix nanoseconds. Header and log fields cross the host boundary as one flat list of names and values.
    export let RequestOutcome = enum (
        Ok([uint32, string, string, string, string[list], int64, string, string, int64]),
        Error(uint32)
    );

    /// @brief Returned bytes or an unsigned host error code.
    export let BytesOutcome = enum (Ok(uint8[list]), Error(uint32));
    /// @brief Host success without a value or an unsigned host error code.
    export let DoneOutcome = enum (Ok, Error(uint32));
    /// @brief A configuration lookup: found flag and value, or an unsigned host error code.
    export let ConfigOutcome = enum (Ok([bool, string]), Error(uint32));

    /// @brief The request the host assigned to this execution. A second call fails with InvalidInput.
    export let next_request = func() -> RequestOutcome host("neura.http.server.next", 1);
    /// @brief Up to `max` further bytes of the request body, waiting for the client to send them; an empty list
    /// at its end. Fails when the body cannot be read to its end.
    export let read_body = func(max: int) -> BytesOutcome host("neura.http.server.body.read", 1);
    /// @brief Sends the status, the header pairs and the first body bytes; `complete` ends the body.
    export let respond = func(status: uint32, headers: string[list], body: uint8[list], complete: bool)
        -> DoneOutcome host("neura.http.server.respond", 1);

    /// @brief Sends further response body bytes after a respond whose body was not complete.
    export let write_body = func(bytes: uint8[list]) -> DoneOutcome host("neura.http.server.body.write", 1);
    /// @brief Ends a response body that respond left open.
    export let close_body = func() -> DoneOutcome host("neura.http.server.body.close", 1);
    /// @brief The host configuration value of `key`.
    export let config = func(key: string) -> ConfigOutcome host("neura.app.config", 1);
    /// @brief Writes one JSON log record through the host: level 0 trace through 4 error, a message, and
    /// named fields.
    export let log = func(level: uint32, message: string, fields: string[list]) -> DoneOutcome
        host("neura.app.log", 1);

    /// @brief Adds `value` to the host counter `name` (kind 1) or sets the host gauge `name` (kind 2), shown
    /// on the admin listener's /metrics.
    export let metric = func(name: string, kind: uint32, value: int64) -> DoneOutcome host("neura.app.metric", 1);
);
