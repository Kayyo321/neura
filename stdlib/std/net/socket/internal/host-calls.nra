/// @brief The host calls of `Std.Net.Socket` and `Std.Net.Tls`. Library use only.
///
/// The first group binds the base runtime's TCP services (`neura.net.connect`, `listen`, `local_port`,
/// `accept`, `close`); reading and writing go through `Std.Net.TcpStream`. The second group binds the socket
/// services that `Std.Net.Internal.Sockets` also binds (UDP, Unix-domain sockets, options, TLS streams,
/// `send_file`), with the same parameters and outcome shapes. The third group names operations that no runtime
/// offers yet; each traps, and its runtime need is recorded in the design note.
#Since("0.3.0")
export let HostCalls = module (
    /// @brief A socket or other ID, or an unsigned host error code.
    export let IdOutcome = enum (Ok(int64), Error(uint32));
    /// @brief A byte count or port, or an unsigned host error code.
    export let CountOutcome = enum (Ok(int), Error(uint32));
    /// @brief Bytes read, or an unsigned host error code.
    export let BytesOutcome = enum (Ok(uint8[list]), Error(uint32));
    /// @brief A 64-bit count or option value, or an unsigned host error code.
    export let LongOutcome = enum (Ok(int64), Error(uint32));
    /// @brief Success without a value, or an unsigned host error code.
    export let DoneOutcome = enum (Ok, Error(uint32));
    /// @brief A datagram, its sender's numeric address (or Unix path, `@` for abstract) and port, or an
    /// unsigned host error code.
    export let DatagramOutcome = enum (Ok([uint8[list], string, int]), Error(uint32));
    /// @brief A TLS stream ID and the selected ALPN protocol (empty when none), or an unsigned host error code.
    export let TlsOutcome = enum (Ok([int64, string]), Error(uint32));
    /// @brief A numeric address (or Unix path) and port, or an unsigned host error code.
    export let AddressOutcome = enum (Ok([string, int]), Error(uint32));
    /// @brief Coalesced datagrams, the sender's address and port, and the segment size, or an unsigned host
    /// error code.
    export let CoalescedOutcome = enum (Ok([uint8[list], string, int, int]), Error(uint32));

    // The option numbers of `neura.net.option.set` and `get`, as in Std.Net.Internal.Sockets.
    /// @brief Option SO_REUSEADDR.
    export const ReuseAddress: int = 1;
    /// @brief Option SO_REUSEPORT.
    export const ReusePort: int = 2;
    /// @brief Option TCP_NODELAY.
    export const NoDelay: int = 3;
    /// @brief Option TCP_FASTOPEN, the queue length.
    export const FastOpen: int = 4;
    /// @brief Option TCP_USER_TIMEOUT, in milliseconds.
    export const UserTimeout: int = 5;
    /// @brief Option SO_KEEPALIVE.
    export const KeepAlive: int = 6;
    /// @brief Option TCP_KEEPIDLE (TCP_KEEPALIVE on macOS), in seconds.
    export const KeepIdle: int = 7;
    /// @brief Option TCP_KEEPINTVL, in seconds.
    export const KeepInterval: int = 8;
    /// @brief Option TCP_KEEPCNT.
    export const KeepCount: int = 9;
    /// @brief Option SO_RCVBUF, in bytes.
    export const ReceiveBuffer: int = 10;
    /// @brief Option SO_SNDBUF, in bytes.
    export const SendBuffer: int = 11;
    /// @brief Option SO_BROADCAST.
    export const Broadcast: int = 12;

    // Group 1: the base runtime's TCP services.
    /// @brief A TCP connection to a host and port within the timeout (0 without limit). Overlapping and
    /// cancellable (version 2).
    export let connect = func(host: string, port: int, timeout_nanos: int64) -> IdOutcome host("neura.net.connect", 2);
    /// @brief A listening TCP socket; port 0 asks for a free port.
    export let listen = func(host: string, port: int) -> IdOutcome host("neura.net.listen", 1);
    /// @brief The bound port of a socket (getsockname).
    export let local_port = func(socket: int64) -> CountOutcome host("neura.net.local_port", 1);
    /// @brief Accepts one stream from a listener. Overlapping and cancellable (version 2).
    export let accept = func(listener: int64) -> IdOutcome host("neura.net.accept", 2);
    /// @brief Releases any socket ID.
    export let close = func(socket: int64) -> DoneOutcome host("neura.net.close", 1);

    // Group 2: the socket services of Std.Net.Internal.Sockets, bound with the same names, versions, parameters
    // and outcome shapes.
    /// @brief A UDP socket bound to a numeric address and port. As `Std.Net.Internal.Sockets.udp_bind`.
    export let udp_bind = func(host: string, port: int) -> IdOutcome host("neura.net.udp.bind", 1);
    /// @brief Sends one datagram; the count sent. As `udp_send_to`.
    export let udp_send_to = func(socket: int64, host: string, port: int, bytes: uint8[list]) -> CountOutcome
        host("neura.net.udp.send_to", 1);

    /// @brief Receives one datagram; TimedOut (12) when none arrives in time. As `udp_receive_from`.
    export let udp_receive_from = func(socket: int64, max: int, timeout_nanos: int64) -> DatagramOutcome
        host("neura.net.udp.receive_from", 1);

    /// @brief A Unix-domain stream (`@name` abstract). As `unix_connect`.
    export let unix_connect = func(path: string) -> IdOutcome host("neura.net.unix.connect", 1);
    /// @brief A Unix-domain stream listener. As `unix_listen`.
    export let unix_listen = func(path: string) -> IdOutcome host("neura.net.unix.listen", 1);
    /// @brief A Unix-domain datagram socket, bound unless the path is empty. As `unix_datagram`.
    export let unix_datagram = func(path: string) -> IdOutcome host("neura.net.unix.datagram", 1);
    /// @brief Sends one Unix datagram. As `unix_send_to`.
    export let unix_send_to = func(socket: int64, path: string, bytes: uint8[list]) -> CountOutcome
        host("neura.net.unix.send_to", 1);

    /// @brief Receives one Unix datagram. As `unix_receive_from`.
    export let unix_receive_from = func(socket: int64, max: int, timeout_nanos: int64) -> DatagramOutcome
        host("neura.net.unix.receive_from", 1);

    /// @brief Sets a numbered socket option; Unsupported (13) when the platform lacks it. As `set_option`.
    export let set_option = func(socket: int64, option: int, value: int64) -> DoneOutcome
        host("neura.net.option.set", 1);

    /// @brief A verified TLS client stream; PermissionDenied (2) when verification fails, Unsupported (13) in a
    /// build without TLS. As `tls_connect`.
    export let tls_connect = func(host: string, port: int, timeout_nanos: int64, server_name: string,
        alpn: string[list], ca_file: string) -> TlsOutcome host("neura.net.tls.connect", 1);

    /// @brief Accepts one TLS server stream. As `tls_accept`.
    export let tls_accept = func(listener: int64, certificate_file: string, key_file: string, alpn: string[list],
        timeout_nanos: int64) -> TlsOutcome host("neura.net.tls.accept", 1);

    /// @brief Decrypted bytes; empty at the end. As `tls_read`.
    export let tls_read = func(stream: int64, max: int, timeout_nanos: int64) -> BytesOutcome
        host("neura.net.tls.read", 1);

    /// @brief Encrypts and sends a prefix; its length. As `tls_write`.
    export let tls_write = func(stream: int64, bytes: uint8[list]) -> CountOutcome host("neura.net.tls.write", 1);
    /// @brief Sends close_notify and releases the stream. As `tls_close`.
    export let tls_close = func(stream: int64) -> DoneOutcome host("neura.net.tls.close", 1);
    /// @brief Sends part of an open file to a stream; the count sent. As `send_file`.
    export let send_file = func(socket: int64, file: int64, offset: int64, count: int64) -> LongOutcome
        host("neura.net.send_file", 1);

    // Group 3: operations no runtime offers yet.
    /// @brief Ends reading (0), writing (1) or both (2) of a stream. Needed service: neura.net.shutdown.
    /// @stub no host service for shutdown(2)
    export let shutdown = func(socket: int64, how: int) -> DoneOutcome {
        trap_with_message("unsupported: Std.Net.Socket.Internal.HostCalls.shutdown is not implemented in Neura 0.3.0 (no host service for shutdown(2))");
    };

    /// @brief The numeric local address and port (getsockname). Needed service: neura.net.local_address.
    /// @stub no host service reports a socket's local address
    export let local_address = func(socket: int64) -> AddressOutcome {
        trap_with_message("unsupported: Std.Net.Socket.Internal.HostCalls.local_address is not implemented in Neura 0.3.0 (no host service reports a socket's local address)");
    };

    /// @brief A Multipath TCP stream (IPPROTO_MPTCP). Needed service: neura.net.mptcp.connect.
    /// @stub no MPTCP host service; it is a stub on the runtime-services branch too
    export let mptcp_connect = func(host: string, port: int, timeout_nanos: int64) -> IdOutcome {
        trap_with_message("unsupported: Std.Net.Socket.Internal.HostCalls.mptcp_connect is not implemented in Neura 0.3.0 (no MPTCP host service; it is a stub on the runtime-services branch too)");
    };

    /// @brief A Multipath TCP listener. Needed service: neura.net.mptcp.listen.
    /// @stub no MPTCP host service; it is a stub on the runtime-services branch too
    export let mptcp_listen = func(host: string, port: int) -> IdOutcome {
        trap_with_message("unsupported: Std.Net.Socket.Internal.HostCalls.mptcp_listen is not implemented in Neura 0.3.0 (no MPTCP host service; it is a stub on the runtime-services branch too)");
    };

    /// @brief A raw IP socket (SOCK_RAW) for family 4 or 6 and an IP protocol number. Needed service:
    /// neura.net.raw.open.
    /// @stub no raw-socket host service
    export let raw_open = func(family: int, protocol: int) -> IdOutcome {
        trap_with_message("unsupported: Std.Net.Socket.Internal.HostCalls.raw_open is not implemented in Neura 0.3.0 (no raw-socket host service)");
    };

    /// @brief Sends one raw datagram to a numeric address. Needed service: neura.net.raw.send_to.
    /// @stub no raw-socket host service
    export let raw_send_to = func(socket: int64, host: string, bytes: uint8[list]) -> CountOutcome {
        trap_with_message("unsupported: Std.Net.Socket.Internal.HostCalls.raw_send_to is not implemented in Neura 0.3.0 (no raw-socket host service)");
    };

    /// @brief Receives one raw datagram with its sender. Needed service: neura.net.raw.receive_from.
    /// @stub no raw-socket host service
    export let raw_receive_from = func(socket: int64, max: int, timeout_nanos: int64) -> DatagramOutcome {
        trap_with_message("unsupported: Std.Net.Socket.Internal.HostCalls.raw_receive_from is not implemented in Neura 0.3.0 (no raw-socket host service)");
    };

    /// @brief Moves bytes between two descriptors through a pipe. Needed service: neura.net.splice.
    /// @stub no splice host service; the providers have no pipe handles
    export let splice = func(source: int64, target: int64, count: int64) -> LongOutcome {
        trap_with_message("unsupported: Std.Net.Socket.Internal.HostCalls.splice is not implemented in Neura 0.3.0 (no splice host service; the providers have no pipe handles)");
    };

    /// @brief Sends with MSG_ZEROCOPY. Needed service: neura.net.send_zerocopy.
    /// @stub no MSG_ZEROCOPY host service; host values are copied at the boundary
    export let send_zerocopy = func(socket: int64, bytes: uint8[list]) -> CountOutcome {
        trap_with_message("unsupported: Std.Net.Socket.Internal.HostCalls.send_zerocopy is not implemented in Neura 0.3.0 (no MSG_ZEROCOPY host service; host values are copied at the boundary)");
    };

    /// @brief Sends a buffer as datagrams of segment_size bytes with UDP_SEGMENT. Needed service:
    /// neura.net.udp.send_segmented.
    /// @stub no UDP GSO host service
    export let udp_send_segmented = func(socket: int64, host: string, port: int, bytes: uint8[list],
        segment_size: int) -> CountOutcome {
        trap_with_message("unsupported: Std.Net.Socket.Internal.HostCalls.udp_send_segmented is not implemented in Neura 0.3.0 (no UDP GSO host service)");
    };

    /// @brief Receives coalesced datagrams with UDP_GRO and their segment size. Needed service:
    /// neura.net.udp.receive_coalesced.
    /// @stub no UDP GRO host service
    export let udp_receive_coalesced = func(socket: int64, max: int, timeout_nanos: int64) -> CoalescedOutcome {
        trap_with_message("unsupported: Std.Net.Socket.Internal.HostCalls.udp_receive_coalesced is not implemented in Neura 0.3.0 (no UDP GRO host service)");
    };

    /// @brief Asks the driver to wait with backend 1 io_uring, 2 epoll, 3 kqueue or 4 poll. Needed service:
    /// neura.runtime.event_loop.
    /// @stub the runtime driver waits with poll(2) only
    export let select_event_loop = func(backend: int) -> DoneOutcome {
        trap_with_message("unsupported: Std.Net.Socket.Internal.HostCalls.select_event_loop is not implemented in Neura 0.3.0 (the runtime driver waits with poll(2) only)");
    };

    /// @brief A TLS client stream with a version range (12 or 13) and an optional client certificate. Needed service:
    /// neura.net.tls.connect version 2.
    /// @stub neura.net.tls.connect takes no version range or client certificate
    export let tls_connect_extended = func(host: string, port: int, timeout_nanos: int64, server_name: string,
        alpn: string[list], ca_file: string, min_version: int, max_version: int, certificate_file: string,
        key_file: string) -> TlsOutcome {
        trap_with_message("unsupported: Std.Net.Socket.Internal.HostCalls.tls_connect_extended is not implemented in Neura 0.3.0 (neura.net.tls.connect takes no version range or client certificate)");
    };

    /// @brief A TLS server stream that requires and verifies a client certificate against client_ca_file. Needed
    /// service: neura.net.tls.accept version 2.
    /// @stub neura.net.tls.accept requests no client certificate
    export let tls_accept_mutual = func(listener: int64, certificate_file: string, key_file: string, alpn: string[list],
        timeout_nanos: int64, min_version: int, max_version: int, client_ca_file: string) -> TlsOutcome {
        trap_with_message("unsupported: Std.Net.Socket.Internal.HostCalls.tls_accept_mutual is not implemented in Neura 0.3.0 (neura.net.tls.accept requests no client certificate)");
    };

    /// @brief Moves the record layer of a TLS stream into the kernel (kTLS). Needed service:
    /// neura.net.tls.kernel_offload.
    /// @stub kTLS is a stub on the runtime-services branch
    export let tls_enable_kernel_offload = func(stream: int64) -> DoneOutcome {
        trap_with_message("unsupported: Std.Net.Socket.Internal.HostCalls.tls_enable_kernel_offload is not implemented in Neura 0.3.0 (kTLS is a stub on the runtime-services branch)");
    };

    /// @brief A TCP listener whose options (numbers as for set_option) are set before bind(2) and listen(2), as
    /// SO_REUSEADDR, SO_REUSEPORT and TCP_FASTOPEN need. Needed service: neura.net.listen version 3.
    /// @stub no host service sets options before bind; neura.net.listen binds at once
    export let listen_with_options = func(host: string, port: int, options: int[list],
        values: int64[list]) -> IdOutcome {
        trap_with_message("unsupported: Std.Net.Socket.Internal.HostCalls.listen_with_options is not implemented in Neura 0.3.0 (no host service sets options before bind; neura.net.listen binds at once)");
    };

    /// @brief A UDP socket whose options are set before bind(2), as SO_REUSEADDR and SO_REUSEPORT need. Needed service:
    /// neura.net.udp.bind version 2.
    /// @stub no host service sets options before bind; neura.net.udp.bind binds at once
    export let udp_bind_with_options = func(host: string, port: int, options: int[list],
        values: int64[list]) -> IdOutcome {
        trap_with_message("unsupported: Std.Net.Socket.Internal.HostCalls.udp_bind_with_options is not implemented in Neura 0.3.0 (no host service sets options before bind; neura.net.udp.bind binds at once)");
    };
);
