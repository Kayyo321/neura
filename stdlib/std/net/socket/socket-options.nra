let.promote _ = import:Std.Time.Duration;
let errors = import:Std.Core.Error;
let hashing = import:Std.Core.Hash;
let.promote _ = import:Std.Core.Result;

/// @brief Type-safe socket options: a builder that checks every value against the socket kind it is for, and
/// the validated, immutable option set that `TcpConnector`, `TcpServer`, `UdpSocket` and the Unix sockets apply.
///
/// The builder covers `SO_REUSEADDR`, `SO_REUSEPORT` (kernel load balancing across sockets bound to one port),
/// `TCP_NODELAY`, `TCP_FASTOPEN` (the server's queue length), `TCP_USER_TIMEOUT`, `SO_KEEPALIVE` with its idle,
/// interval and count timers, `SO_RCVBUF`, `SO_SNDBUF`, `SO_BROADCAST`, and Multipath TCP, which is not a
/// socket option but the protocol the socket is created with. `build` checks the values and reports the first
/// problem as a Custom error with the code `socket.options`:
///
/// - an option that does not apply to the kind: TCP options (no-delay, user timeout, keepalive and its timers,
///   multipath) on a UDP or Unix socket, fast open on anything but a TCP listener, `SO_REUSEPORT` on anything
///   but a TCP listener or UDP socket, `SO_REUSEADDR` on a Unix socket, broadcast on anything but UDP;
/// - the user timeout negative, not whole milliseconds, or above 2,147,483,647 milliseconds;
/// - a keepalive timer without keepalive enabled; the idle time or interval not whole seconds or outside 1
///   through 32,767 seconds, the probe count outside 1 through 127 (the limits of Linux `tcp(7)`, checked on
///   every host);
/// - a fast-open queue length or buffer size below 1.
///
/// Applying the set calls the host's option service once per option in option-number order. An option the
/// platform lacks fails with Unsupported; an empty set needs no host call. The operating system may adjust a value (Linux doubles buffer
/// sizes). On Windows, `reuse_address` gives the semantics of `SO_EXCLUSIVEADDRUSE`, because `SO_REUSEADDR` there
/// lets another socket take over a bound port, and `reuse_port`, `user_timeout` and multipath fail with
/// Unsupported; the others set the Windows option of the same name.
/// @see [Std.Net.Socket.SocketOptions](https://github.com/Kayyo321/neura/wiki/Stdlib-Net-Socket-SocketOptions)
#Since("0.3.0")
export let SocketOptions = module (
    /// @brief The kind of socket an option set is built for.
    export let SocketKind = enum (TcpStream, TcpListener, Udp, UnixStream, UnixDatagram);

    /// @brief The index of the multipath flag in the value list, after the twelve option numbers.
    const MultipathSlot: int = 13;
    /// @brief The highest TCP_KEEPIDLE and TCP_KEEPINTVL in seconds (Linux MAX_TCP_KEEPIDLE, MAX_TCP_KEEPINTVL).
    const MaxKeepSeconds: int64 = 32767;
    /// @brief The highest TCP_KEEPCNT (Linux MAX_TCP_KEEPCNT).
    const MaxKeepCount: int64 = 127;
    /// @brief The highest user timeout in milliseconds (the option is a C int).
    const MaxUserTimeoutMillis: int64 = 2147483647;

    /// @brief The option names by option number, for messages and text.
    let name_of = func(option: int) -> string {
        last names: string[list] = new(["", "reuse_address", "reuse_port", "no_delay", "fast_open", "user_timeout",
            "keep_alive", "keep_alive_idle", "keep_alive_interval", "keep_alive_count", "receive_buffer",
            "send_buffer", "broadcast", "multipath"]);
        return names[option];
    };

    /// @brief A validated option set: the host option numbers and values in option-number order, and whether
    /// the socket uses Multipath TCP.
    #Final
    export let SocketOptions = class (
        /// @brief The kind the set was validated for.
        export last kind: SocketKind;
        /// @brief True when the socket is created with Multipath TCP (`IPPROTO_MPTCP`).
        export last multipath: bool;
        /// @brief The pairs of option number and value.
        last pairs: [int, int64][list];

        /// @brief Use `SocketOptionsBuilder.build` or `none`.
        export let init = func(for_kind: SocketKind, settings: [int, int64][list], uses_multipath: bool) {
            kind = for_kind;
            pairs = settings;
            multipath = uses_multipath;
        };

        /// @brief The option numbers and values in option-number order (the numbers of
        /// `neura.net.option.set`: 1 `SO_REUSEADDR` through 12 `SO_BROADCAST`; booleans are 0 or 1, the user
        /// timeout is in milliseconds and the keepalive timers in seconds). A copy.
        #NoDiscard
        export let settings = func -> [int, int64][list] {
            let copy: [int, int64][list] = new;
            for (let pair in pairs) {
                copy.append(pair);
            }
            return copy;
        };

        /// @brief True when no option is set and multipath is off, so applying needs no host call.
        #Pure
        export let is_empty = func -> bool => pairs.length == 0 && not multipath;

        /// @brief The value set for option number `option`, or -1 when it is not set.
        #Pure
        export let value_of = func(option: int) -> int64 {
            for (let pair in pairs) {
                let [number, value] = pair;
                if (number == option) {
                    return value;
                }
            }
            return -1;
        };

        /// @brief Equal when the kind, the settings and the multipath flag are.
        export let.override equals = func(other: class) -> bool {
            if (other is not that: SocketOptions) {
                return false;
            }
            if (kind != that.kind || multipath != that.multipath || pairs.length != that.pairs.length) {
                return false;
            }
            let i = 0;
            while (i < pairs.length) {
                let [a, x] = pairs[i];
                let [b, y] = that.pairs[i];
                if (a != b || x != y) {
                    return false;
                }
                i++;
            }
            return true;
        };

        /// @brief A hash consistent with equals.
        export let.override hash_code = func -> uint32 {
            let h = hashing.combine(hashing.of_bool(multipath), kind.to_string().hash_code());
            for (let pair in pairs) {
                let [number, value] = pair;
                h = hashing.combine(h, number.hash_code());
                h = hashing.combine(h, value.hash_code());
            }
            return h;
        };

        /// @brief Text such as "SocketOptions(TcpStream: no_delay=1, keep_alive=1)".
        export let.override to_string = func -> string {
            let text = "SocketOptions(" .. kind.to_string() .. ":";
            let first = true;
            for (let pair in pairs) {
                let [number, value] = pair;
                text ..= (first ? " " : ", ") .. name_of(number) .. "=" .. value.to_string();
                first = false;
            }
            if (multipath) {
                text ..= (first ? " " : ", ") .. "multipath";
            }
            return text .. ")";
        };
    );

    /// @brief Collects option values; `build` validates them for one socket kind. Setting an option again
    /// replaces its value.
    #[Final, NotThreadSafe]
    export let SocketOptionsBuilder = class (
        /// @brief Requested values by option number (index 13 is multipath). Durations in nanoseconds.
        last values: int64[list] = new;
        /// @brief Whether each value was set.
        last present: bool[list] = new;

        /// @brief An empty builder.
        export let init = func {
            let i = 0;
            while (i <= MultipathSlot) {
                values.append(0);
                present.append(false);
                i++;
            }
        };

        /// @brief `SO_REUSEADDR` (on Windows, the semantics of `SO_EXCLUSIVEADDRUSE`).
        export let set_reuse_address = func(enabled: bool) {
            put(1, flag(enabled));
        };

        /// @brief `SO_REUSEPORT`: several sockets bind the same port and the kernel spreads the load. Unsupported
        /// on Windows.
        export let set_reuse_port = func(enabled: bool) {
            put(2, flag(enabled));
        };

        /// @brief `TCP_NODELAY`: disables Nagle's algorithm.
        export let set_no_delay = func(enabled: bool) {
            put(3, flag(enabled));
        };

        /// @brief `TCP_FASTOPEN` on a listener: the queue length of pending fast-open requests.
        export let set_fast_open = func(queue_length: int) {
            put(4, queue_length as int64);
        };

        /// @brief `TCP_USER_TIMEOUT`: how long sent data may stay unacknowledged before the connection is
        /// dropped; zero keeps the system default. Unsupported on Windows.
        export let set_user_timeout = func(timeout: Duration) {
            put(5, timeout.to_nanos());
        };

        /// @brief `SO_KEEPALIVE`.
        export let set_keep_alive = func(enabled: bool) {
            put(6, flag(enabled));
        };

        /// @brief `TCP_KEEPIDLE`: idle time before the first probe. Needs keepalive.
        export let set_keep_alive_idle = func(idle: Duration) {
            put(7, idle.to_nanos());
        };

        /// @brief `TCP_KEEPINTVL`: time between probes. Needs keepalive.
        export let set_keep_alive_interval = func(interval: Duration) {
            put(8, interval.to_nanos());
        };

        /// @brief `TCP_KEEPCNT`: unanswered probes before the connection is dropped. Needs keepalive.
        export let set_keep_alive_count = func(probes: int) {
            put(9, probes as int64);
        };

        /// @brief `SO_RCVBUF` in bytes.
        export let set_receive_buffer = func(bytes: int) {
            put(10, bytes as int64);
        };

        /// @brief `SO_SNDBUF` in bytes.
        export let set_send_buffer = func(bytes: int) {
            put(11, bytes as int64);
        };

        /// @brief `SO_BROADCAST`.
        export let set_broadcast = func(enabled: bool) {
            put(12, flag(enabled));
        };

        /// @brief Creates the socket with Multipath TCP (`IPPROTO_MPTCP`, Linux 5.6 and later; Unsupported on
        /// Windows).
        export let set_multipath = func(enabled: bool) {
            put(MultipathSlot, flag(enabled));
        };

        /// @brief The validated option set for `kind`, or the first problem as a Custom error with the code
        /// `socket.options` (see the module documentation).
        #NoDiscard
        export let build = func(kind: SocketKind) -> Result<SocketOptions> {
            let option = 1;
            while (option <= MultipathSlot) {
                if (present[option] && not applies(option, kind)) {
                    return invalid(name_of(option) .. " does not apply to a " .. kind.to_string() .. " socket");
                }
                option++;
            }
            let pairs: [int, int64][list] = new;
            for (let number in [1, 2, 3]) {
                add(pairs, number);
            }
            if (present[4]) {
                if (values[4] < 1) {
                    return invalid("fast_open needs a queue length of at least 1");
                }
                pairs.append([4, values[4]]);
            }
            if (present[5]) {
                last nanos = values[5];
                if (nanos < 0 || nanos % 1000000 != 0 || nanos / 1000000 > MaxUserTimeoutMillis) {
                    return invalid("user_timeout must be whole milliseconds from 0 through 2147483647");
                }
                pairs.append([5, nanos / 1000000]);
            }
            add(pairs, 6);
            last keep_alive_on = present[6] && values[6] == 1;
            for (let number in [7, 8]) {
                if (present[number]) {
                    return invalid(name_of(number) .. " needs keep_alive enabled") unless keep_alive_on;
                    last nanos = values[number];
                    if (nanos % 1000000000 != 0 || nanos < 1000000000 || nanos / 1000000000 > MaxKeepSeconds) {
                        return invalid(name_of(number) .. " must be whole seconds from 1 through 32767");
                    }
                    pairs.append([number, nanos / 1000000000]);
                }
            }
            if (present[9]) {
                return invalid("keep_alive_count needs keep_alive enabled") unless keep_alive_on;
                if (values[9] < 1 || values[9] > MaxKeepCount) {
                    return invalid("keep_alive_count must be from 1 through 127");
                }
                pairs.append([9, values[9]]);
            }
            for (let number in [10, 11]) {
                if (present[number]) {
                    if (values[number] < 1) {
                        return invalid(name_of(number) .. " must be at least 1 byte");
                    }
                    pairs.append([number, values[number]]);
                }
            }
            add(pairs, 12);
            last multipath = present[MultipathSlot] && values[MultipathSlot] == 1;
            return Result<SocketOptions>.Ok(new SocketOptions(kind, pairs, multipath));
        };

        /// @brief Text such as "SocketOptionsBuilder".
        export let.override to_string = func -> string => "SocketOptionsBuilder";

        /// @brief Records a requested value.
        let put = func(number: int, value: int64) {
            values[number] = value;
            present[number] = true;
        };

        /// @brief Appends a set value that needs no conversion.
        let add = func(pairs: [int, int64][list], number: int) {
            if (present[number]) {
                pairs.append([number, values[number]]);
            }
        };
    );

    /// @brief An empty builder.
    #NoDiscard
    export let builder = func -> SocketOptionsBuilder => new SocketOptionsBuilder();

    /// @brief The empty option set for `kind`: nothing to apply.
    #NoDiscard
    export let none = func(kind: SocketKind) -> SocketOptions =>
        new SocketOptions(kind, new, false);

    /// @brief Whether option number `option` (13 for multipath) applies to sockets of `kind`.
    #Pure
    export let applies = func(option: int, kind: SocketKind) -> bool {
        last tcp = kind == SocketKind.TcpStream || kind == SocketKind.TcpListener;
        if (option == 1) {
            return kind != SocketKind.UnixStream && kind != SocketKind.UnixDatagram;
        }
        if (option == 2) {
            return kind == SocketKind.TcpListener || kind == SocketKind.Udp;
        }
        if (option == 4) {
            return kind == SocketKind.TcpListener;
        }
        if (option == 10 || option == 11) {
            return true;
        }
        return if (option == 12) -> kind == SocketKind.Udp
            else -> tcp;
    };

    /// @brief 1 for true, 0 for false.
    let flag = func(enabled: bool) -> int64 => enabled ? 1 : 0;

    /// @brief A `socket.options` failure.
    let invalid = func(text: string) -> Result<SocketOptions> =>
        Result<SocketOptions>.Err(errors.custom("socket.options", text));
);
