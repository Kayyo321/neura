let bytes = import:Std.Io.Internal.Bytes;
let closeable = import:Std.Io.Closeable;
let host_error = import:Std.Core.Internal.HostError;
let result = import:Std.Core.Result;
let socket = import:Std.Net.Internal.Socket;
let tcp_stream = import:Std.Net.TcpStream;
let unit = import:Std.Core.Unit;

// A listening TCP socket (Stdlib.md section 11.4). Needs the net
// capability. After close, accept fails with Closed.
export let TcpListener = module (
    let IdOutcome = enum (Ok(int64), Error(uint32));
    let PortOutcome = enum (Ok(int), Error(uint32));
    let DoneOutcome = enum (Ok, Error(uint32));
    let listen_socket = func(host: string, port: int) -> IdOutcome host("neura.net.listen", 1);
    let socket_port = func(socket: int64) -> PortOutcome host("neura.net.local_port", 1);
    let accept_socket = func(listener: int64) -> IdOutcome host("neura.net.accept", 1);
    let close_socket = func(socket: int64) -> DoneOutcome host("neura.net.close", 1);

    export let TcpListener = class implements closeable.Closeable (
        let handle: socket.Handle = nil;
        let port: int = 0;
        let open_now: bool = true;

        // Use bind; the handle comes from the library.
        export let init = func(opened: socket.Handle, bound_port: int) -> void {
            handle = opened;
            port = bound_port;
        };

        // Waits for the next connection.
        export let accept = func() -> result.Result<tcp_stream.TcpStream> {
            if (!open_now) {
                return result.Result<tcp_stream.TcpStream>.Err(bytes.closed("listener", handle.address));
            }
            return match (accept_socket(handle.id)) {
                IdOutcome.Ok(id) => result.Result<tcp_stream.TcpStream>.Ok(new tcp_stream.TcpStream(new socket.Handle(id, ""))),
                IdOutcome.Error(code) => result.Result<tcp_stream.TcpStream>.Err(host_error.io(code, "accept failed", handle.address)),
            };
        };

        // The port the listener is bound to; for a bind to port 0, the one
        // the host chose. Still available after close.
        export let local_port = func() -> int {
            return port;
        };

        export let close = func() -> result.Result<unit.Unit> {
            if (!open_now) {
                return bytes.ok();
            }
            open_now = false;
            return match (close_socket(handle.id)) {
                DoneOutcome.Ok => bytes.ok(),
                DoneOutcome.Error(code) => result.Result<unit.Unit>.Err(host_error.io(code, "listener close failed", handle.address)),
            };
        };
    );

    // Listens on `host` (a name or an address; empty for every interface)
    // and `port`; port 0 asks the host for a free port. A port outside 0
    // through 65,535 traps with "invalid argument: port".
    export let bind = func(host: string, port: int) -> result.Result<TcpListener> {
        socket.check_port(port);
        let address = socket.address_of(host, port);
        let id: int64 = 0;
        match (listen_socket(host, port)) {
            IdOutcome.Ok(opened) => {
                id = opened;
            },
            IdOutcome.Error(code) => {
                return result.Result<TcpListener>.Err(host_error.io(code, "bind failed", address));
            },
        }
        return match (socket_port(id)) {
            PortOutcome.Ok(bound) => result.Result<TcpListener>.Ok(new TcpListener(new socket.Handle(id, address), bound)),
            PortOutcome.Error(code) => close_after(id, code, address),
        };
    };

    let close_after = func(id: int64, code: uint32, address: string) -> result.Result<TcpListener> {
        close_socket(id);
        return result.Result<TcpListener>.Err(host_error.io(code, "bind failed", address));
    };
);
