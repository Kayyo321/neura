let bytes = import:Std.Io.Internal.Bytes;
let.promote _ = import:Std.Io.Closeable;
let host_error = import:Std.Core.Internal.HostError;
let.promote _ = import:Std.Core.Result;
let socket = import:Std.Net.Internal.Socket;
let.promote _ = import:Std.Net.TcpStream;
let.promote _ = import:Std.Core.Unit;

/// @brief A listening TCP socket (Stdlib.md section 11.4). Needs the net capability. After close, accept fails
/// with Closed.
///
/// Overlap and cancellation (Concurrency.md section 10.4). In a program with tasks, `accept` overlaps: the
/// calling task waits for a connection and the other tasks run. It uses version 2 of its host service, so
/// cancelling the task's scope while it waits ends it with an Io error of kind Cancelled, unless a connection
/// arrived first, in which case `accept` returns that stream. A cancelled `accept` takes no connection from the
/// queue. `bind` and `close` do not wait and are not cancellable. Without tasks `accept` waits as before.
/// @see [Std.Net.TcpListener](https://github.com/Kayyo321/neura/wiki/Stdlib-Net-TcpListener)
export let TcpListener = module (
    /// @brief Represents a host success with an identifier or position, or an unsigned host error code.
    let IdOutcome = enum (Ok(int64), Error(uint32));
    /// @brief Carries the bound port or a provider error code.
    let PortOutcome = enum (Ok(int), Error(uint32));
    /// @brief Represents host success without a value or an unsigned host error code.
    let DoneOutcome = enum (Ok, Error(uint32));
    /// @brief Requests a listening socket for a host and port.
    let listen_socket = func(host: string, port: int) -> IdOutcome host("neura.net.listen", 1);
    /// @brief Queries the provider for the actual bound port.
    let socket_port = func(socket: int64) -> PortOutcome host("neura.net.local_port", 1);
    /// @brief Waits for the provider to accept a connection. Overlapping and cancellable (version 2).
    let accept_socket = func(listener: int64) -> IdOutcome host("neura.net.accept", 2);
    /// @brief Requests that the provider release the socket handle.
    let close_socket = func(socket: int64) -> DoneOutcome host("neura.net.close", 1);

    /// @brief Owns a listening socket and retains its port after close.
    export let TcpListener = class implements Closeable (
        /// @brief Holds the provider handle and the context used in error messages.
        let handle: socket.Handle = nil;
        /// @brief The port the provider actually bound.
        let port: int = 0;
        /// @brief Tracks whether the wrapper may still use the host handle.
        let open_now: bool = true;

        /// @brief Use bind; the handle comes from the library.
        export let init = func(opened: socket.Handle, bound_port: int) {
            handle = opened;
            port = bound_port;
        };

        /// @brief Waits for the next connection. Fails with Cancelled when the task's scope is cancelled first.
        export let accept = func -> Result<TcpStream> {
            if (!open_now) {
                return Result<TcpStream>.Err(bytes.closed("listener", handle.address));
            }
            return match (accept_socket(handle.id)) {
                IdOutcome.Ok(id) => Result<TcpStream>.Ok(new TcpStream(new socket.Handle(id, ""))),
                IdOutcome.Error(code) => Result<TcpStream>.Err(host_error.io(code, "accept failed", handle.address)),
            };
        };

        /// @brief The port the listener is bound to; for a bind to port 0, the one the host chose. Still
        /// available after close.
        export let local_port = func -> int => port;

        /// @brief Releases the listener. Repeated calls succeed, and an initial close error still leaves it
        /// closed.
        export let close = func -> Result<Unit> {
            if (!open_now) {
                return bytes.ok();
            }
            open_now = false;
            return match (close_socket(handle.id)) {
                DoneOutcome.Ok => bytes.ok(),
                DoneOutcome.Error(code) => Result<Unit>.Err(host_error.io(code, "listener close failed", handle.address)),
            };
        };
    );

    /// @brief Listens on `host` (a name or an address; empty for every interface) and `port`; port 0 asks the
    /// host for a free port.
    ///
    /// A port outside 0 through 65,535 traps with "invalid argument: port".
    export let bind = func(host: string, port: int) -> Result<TcpListener> {
        socket.check_port(port);
        let address = socket.address_of(host, port);
        let id: int64 = 0;
        match (listen_socket(host, port)) {
            IdOutcome.Ok(opened) => {
                id = opened;
            },
            IdOutcome.Error(code) => {
                return Result<TcpListener>.Err(host_error.io(code, "bind failed", address));
            },
        }
        return match (socket_port(id)) {
            PortOutcome.Ok(bound) => Result<TcpListener>.Ok(new TcpListener(new socket.Handle(id, address), bound)),
            PortOutcome.Error(code) => close_after(id, code, address),
        };
    };

    /// @brief Closes a newly bound socket after a port query fails, then reports the query error.
    let close_after = func(id: int64, code: uint32, address: string) -> Result<TcpListener> {
        close_socket(id);
        return Result<TcpListener>.Err(host_error.io(code, "bind failed", address));
    };
);
