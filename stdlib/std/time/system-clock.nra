let.promote _ = import:Std.Time.Clock;
let.promote _ = import:Std.Time.Duration;
let host_error = import:Std.Core.Internal.HostError;
let instant = import:Std.Time.Instant;
let result = import:Std.Core.Result;
let.promote _ = import:Std.Core.Unit;

/// @brief The host's clocks (Stdlib.md section 12.1). Needs the clock capability; without it every member fails
/// with CapabilityDenied.
///
/// Overlap and cancellation (Concurrency.md section 10.4). `sleep` overlaps in a program with tasks: the calling
/// task waits for a deadline on the run's monotonic clock and the other tasks run; no thread sleeps. It uses
/// version 2 of its host service, so cancelling the task's scope while it sleeps ends it with an Io error of
/// kind Cancelled, unless the time had already passed. A cancelled sleep has no effect other than ending early.
/// `now` and `monotonic` read the clock at once and are not cancellable. Without tasks `sleep` waits as before.
/// @see [Std.Time.SystemClock](https://github.com/Kayyo321/neura/wiki/Stdlib-Time-SystemClock)
#Since("0.1.0")
export let SystemClock = module (
    /// @brief Carries the provider's UTC epoch seconds and nanosecond fraction or an error code.
    let WallOutcome = enum (Ok([int64, int]), Error(uint32));
    /// @brief Carries a monotonic nanosecond reading or a provider error code.
    let NanosOutcome = enum (Ok(int64), Error(uint32));
    /// @brief Represents host success without a value or an unsigned host error code.
    let DoneOutcome = enum (Ok, Error(uint32));
    /// @brief Requests the current wall-clock reading from the provider.
    let wall_clock = func -> WallOutcome host("neura.clock.wall", 1);
    /// @brief Requests the current monotonic reading from the provider.
    let monotonic_clock = func -> NanosOutcome host("neura.clock.monotonic", 1);
    /// @brief Asks the provider to wait for the specified nanosecond count. Overlapping and cancellable
    /// (version 2).
    let sleep_for = func(nanos: int64) -> DoneOutcome host("neura.clock.sleep", 2);

    /// @brief A clock whose operations use the runtime's clock capability.
    export let SystemClock = class implements Clock (
        /// @brief The host's wall clock as an instant.
        #NoDiscard
        export let now = func -> result.Result<instant.Instant> {
            return match (wall_clock()) {
                WallOutcome.Ok(reading) => result.Result<instant.Instant>.Ok(instant.of_epoch_seconds(reading[0], reading[1])),
                WallOutcome.Error(code) => result.Result<instant.Instant>.Err(host_error.io(code, "clock read failed", "")),
            };
        };

        /// @brief The host's monotonic clock, from an origin fixed for the run.
        #NoDiscard
        export let monotonic = func -> result.Result<Duration> {
            return match (monotonic_clock()) {
                NanosOutcome.Ok(nanos) => result.Result<Duration>.Ok(of_nanos(nanos)),
                NanosOutcome.Error(code) => result.Result<Duration>.Err(host_error.io(code, "clock read failed", "")),
            };
        };

        /// @brief Waits for the duration; a zero or negative duration asks the host to wait for zero
        /// nanoseconds. Fails with Cancelled when the task's scope is cancelled first.
        export let sleep = func(span: Duration) -> result.Result<Unit> {
            last nanos = span.to_nanos();
            return match (sleep_for(nanos < 0 ? 0 : nanos)) {
                DoneOutcome.Ok => result.Result<Unit>.Ok(Unit.Value),
                DoneOutcome.Error(code) => result.Result<Unit>.Err(host_error.io(code, "sleep failed", "")),
            };
        };
    );

    /// @brief Creates a clock backed by the host's wall and monotonic clocks.
    #[Pure, ThreadSafe]
    export let create = func -> SystemClock => new;
);
