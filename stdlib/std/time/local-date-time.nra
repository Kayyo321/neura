let calendar = import:Std.Time.Internal.Calendar;
let.promote _ = import:Std.Core.Comparable;
let duration = import:Std.Time.Duration;
let hashing = import:Std.Core.Hash;
let instant = import:Std.Time.Instant;
let local_date = import:Std.Time.LocalDate;
let local_time = import:Std.Time.LocalTime;
let.promote _ = import:Std.Core.Ordering;
let result = import:Std.Core.Result;
let zone_offset = import:Std.Time.ZoneOffset;

// A date and a time of day without an offset (Stdlib.md section 12.1).
export let LocalDateTime = module (
    export let LocalDateTime = class implements Comparable<LocalDateTime> (
        let date_value: local_date.LocalDate;
        let time_value: local_time.LocalTime;

        export let init = func(on: local_date.LocalDate, at: local_time.LocalTime) {
            date_value = on;
            time_value = at;
        };

        export let date = func -> local_date.LocalDate => date_value;

        export let time = func -> local_time.LocalTime => time_value;

        // Carries whole days into the date. Traps with "invalid argument:
        // date out of range" when the date leaves its range.
        export let plus = func(span: duration.Duration) -> LocalDateTime {
            let nanos = span.to_nanos();
            let days = calendar.floor_div(nanos, calendar.NanosPerDay);
            let time_of_day = time_value.to_nano_of_day() + calendar.floor_mod(nanos, calendar.NanosPerDay);
            if (time_of_day >= calendar.NanosPerDay) {
                days++;
                time_of_day -= calendar.NanosPerDay;
            }
            return new LocalDateTime(date_value.plus_days(days), local_time.of_nano_of_day(time_of_day));
        };

        // The instant at which UTC reads this date and time minus the
        // offset.
        export let at_offset = func(offset: zone_offset.ZoneOffset) -> instant.Instant {
            let time_of_day = time_value.to_nano_of_day();
            let seconds = date_value.to_epoch_day() * calendar.SecondsPerDay + time_of_day / calendar.NanosPerSecond -
                (offset.total_seconds() as int64);
            return instant.of_epoch_seconds(seconds, (time_of_day % calendar.NanosPerSecond) as int);
        };

        export let compare_to = func(other: LocalDateTime) -> Ordering {
            let by_date = date_value.compare_to(other.date_value);
            if (by_date != Ordering.Equal) {
                return by_date;
            }
            return time_value.compare_to(other.time_value);
        };

        export let.override equals = func(other: class) -> bool {
            if (!(other is LocalDateTime)) {
                return false;
            }
            let moment = other as LocalDateTime;
            return date_value === moment.date_value && time_value === moment.time_value;
        };

        export let.override hash_code = func -> uint32 {
            return hashing.combine(hashing.combine(17, date_value.hash_code()), time_value.hash_code());
        };

        // The date, T, and the time.
        export let.override to_string = func -> string => date_value.to_string() + "T" + time_value.to_string();
    );

    export let of = func(on: local_date.LocalDate, at: local_time.LocalTime) -> LocalDateTime {
        return new LocalDateTime(on, at);
    };

    // The LocalDate form, T, and the LocalTime form, with their errors.
    export let parse = func(text: string) -> result.Result<LocalDateTime> {
        let scan = new calendar.Scanner(text);
        let [year, month, day] = calendar.read_date(scan);
        scan.expect(84, "'T'");
        let nanos = calendar.read_time(scan);
        scan.finish();
        if (!scan.ok()) {
            return result.Result<LocalDateTime>.Err(scan.failure());
        }
        let moment = new LocalDateTime(local_date.of(year as int, month, day), local_time.of_nano_of_day(nanos));
        return result.Result<LocalDateTime>.Ok(moment);
    };
);
