let.promote _ = import:Std.Time.Clock;
let.promote _ = import:Std.Time.Duration;
let instant = import:Std.Time.Instant;
let result = import:Std.Core.Result;
let.promote _ = import:Std.Core.Unit;

/// @brief A Clock for tests (Stdlib.md section 12.1): it reads an instant that only set, advance, and sleep
/// change, and it never fails.
/// @see [Std.Time.FixedClock](https://github.com/Kayyo321/neura/wiki/Stdlib-Time-FixedClock)
export let FixedClock = module (
    /// @brief A manually controlled clock with independent wall and monotonic readings.
    export let FixedClock = class implements Clock (
        /// @brief The current simulated instant.
        let current: instant.Instant;
        /// @brief The monotonic reading: the total of every advance and sleep.
        let elapsed: Duration = of_nanos(0);

        /// @brief Starts at the supplied instant with a zero monotonic reading.
        export let init = func(start: instant.Instant) {
            current = start;
        };

        /// @brief Returns the current simulated wall-clock reading.
        export let now = func -> result.Result<instant.Instant> => result.Result<instant.Instant>.Ok(current);

        /// @brief Starts at zero and grows only with advance and sleep, so set never moves it.
        export let monotonic = func -> result.Result<Duration> => result.Result<Duration>.Ok(elapsed);

        /// @brief Advances by a positive duration and returns at once; a zero or negative duration does
        /// nothing.
        export let sleep = func(span: Duration) -> result.Result<Unit> {
            if (span.to_nanos() > 0) {
                advance(span);
            }
            return result.Result<Unit>.Ok(Unit.Value);
        };

        /// @brief Replaces the instant; the monotonic reading does not change.
        export let set = func(moment: instant.Instant) {
            current = moment;
        };

        /// @brief Moves the instant and the monotonic reading forward. A negative duration traps with "invalid
        /// argument: negative duration", since the monotonic reading never decreases.
        export let advance = func(span: Duration) {
            if (span.is_negative()) {
                trap_with_message("invalid argument: negative duration");
            }
            current = current.plus(span);
            elapsed = elapsed.plus(span);
        };
    );

    /// @brief Creates a clock starting at the supplied instant.
    export let of = func(start: instant.Instant) -> FixedClock => new FixedClock(start);
);
