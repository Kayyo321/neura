let calendar = import:Std.Time.Internal.Calendar;
let.promote _ = import:Std.Core.Comparable;
let hashing = import:Std.Core.Hash;
let.promote _ = import:Std.Core.Ordering;
let result = import:Std.Core.Result;

/// @brief A signed count of nanoseconds in one int64, about 292 years either way (Stdlib.md section 12.1).
///
/// Every factory and member uses checked arithmetic: a result outside int64 traps with reason 1.
/// @see [Std.Time.Duration](https://github.com/Kayyo321/neura/wiki/Stdlib-Time-Duration)
#Since("0.1.0")
export let Duration = module (
    /// @brief An immutable signed duration represented as an exact count of nanoseconds.
    #[Final, NoDiscard, Immutable, ThreadSafe]
    export let Duration = class implements Comparable<Duration> (
        /// @brief The signed number of nanoseconds.
        last total: int64;

        /// @brief Stores the signed nanosecond count.
        export let init = func(nanos: int64) {
            total = nanos;
        };

        /// @brief Adds two durations with checked nanosecond arithmetic.
        #Pure
        export let plus = func(other: Duration) -> Duration => new(total + other.total);

        /// @brief Subtracts another duration with checked nanosecond arithmetic.
        #Pure
        export let minus = func(other: Duration) -> Duration => new(total - other.total);

        /// @brief Scales the duration by an integer. Overflow traps.
        #Pure
        export let multiplied_by = func(factor: int64) -> Duration => new(total * factor);

        /// @brief Truncates toward zero. A zero divisor traps (reason 1), as does the most negative duration
        /// divided by -1.
        #Pure
        export let divided_by = func(divisor: int64) -> Duration => new(total / divisor);

        /// @brief Reverses the sign. The most negative duration cannot be negated.
        #Pure
        export let negated = func -> Duration => new(-total);

        /// @brief Returns the nonnegative magnitude. The most negative duration traps.
        #Pure
        export let abs = func -> Duration {
            if (total < 0) {
                return new(-total);
            }
            return new(total);
        };

        /// @brief Reports whether the nanosecond count is zero.
        #Pure
        export let is_zero = func -> bool => total == 0;

        /// @brief Reports whether the nanosecond count is below zero.
        #Pure
        export let is_negative = func -> bool => total < 0;

        /// @brief Returns the exact signed nanosecond count.
        #Pure
        export let to_nanos = func -> int64 => total;

        /// @brief The to_ conversions truncate toward zero.
        #Pure
        export let to_micros = func -> int64 => total / 1000;

        /// @brief Returns whole milliseconds, truncating toward zero.
        #Pure
        export let to_millis = func -> int64 => total / 1000000;

        /// @brief Returns whole seconds, truncating toward zero.
        #Pure
        export let to_seconds = func -> int64 => total / calendar.NanosPerSecond;

        /// @brief The nanoseconds converted to float64, divided by 10^9. Exact conversion, so correctly
        /// rounded, while the count is at most 2^53.
        #Pure
        export let to_seconds_float64 = func -> float64 => (total as float64) / 1000000000.0;

        /// @brief Orders durations by their signed nanosecond counts.
        #Pure
        export let compare_to = func(other: Duration) -> Ordering {
            if (total < other.total) {
                return Ordering.Less;
            }
            if (total > other.total) {
                return Ordering.Greater;
            }
            return Ordering.Equal;
        };

        /// @brief Tests equality of signed nanosecond counts.
        #Pure
        export let.override equals = func(other: class) -> bool {
            return other is Duration && total == (other as Duration).total;
        };

        /// @brief Hashes the signed nanosecond count.
        #Pure
        export let.override hash_code = func -> uint32 => hashing.combine(17, hashing.of_int64(total));

        /// @brief ISO 8601: PT, then hours, minutes, and seconds with their unit letters, zero units omitted,
        /// the fraction trimmed of trailing zeros.
        ///
        /// Zero is PT0S; a negative duration is - and the text of its magnitude.
        #Pure
        export let.override to_string = func -> string {
            last magnitude = magnitude_of(total);
            if (magnitude == 0) {
                return "PT0S";
            }
            last hours = magnitude / 3600000000000;
            let rest = magnitude % 3600000000000;
            last minutes = rest / 60000000000;
            rest %= 60000000000;
            last seconds = rest / 1000000000;
            last nanos = rest % 1000000000;
            let text = "PT";
            if (hours > 0) {
                text = text + hours.to_string() + "H";
            }
            if (minutes > 0) {
                text = text + minutes.to_string() + "M";
            }
            if (seconds > 0 || nanos > 0) {
                text = text + seconds.to_string() + trimmed_fraction(nanos) + "S";
            }
            return total < 0 ? "-" + text : text;
        };
    );

    /// @brief The duration of zero nanoseconds.
    export const Zero: Duration = new Duration(0);

    /// @brief Constructs a duration from an exact nanosecond count.
    #[Pure, ThreadSafe]
    export let of_nanos = func(nanos: int64) -> Duration => new(nanos);

    /// @brief Converts microseconds to nanoseconds. Overflow traps.
    #[Pure, ThreadSafe]
    export let of_micros = func(micros: int64) -> Duration => new(micros * 1000);

    /// @brief Converts milliseconds to nanoseconds. Overflow traps.
    #[Pure, ThreadSafe]
    export let of_millis = func(millis: int64) -> Duration => new(millis * 1000000);

    /// @brief Converts seconds to nanoseconds. Overflow traps.
    #[Pure, ThreadSafe]
    export let of_seconds = func(seconds: int64) -> Duration => new(seconds * calendar.NanosPerSecond);

    /// @brief Converts 60-second minutes to nanoseconds. Overflow traps.
    #[Pure, ThreadSafe]
    export let of_minutes = func(minutes: int64) -> Duration => new(minutes * calendar.NanosPerMinute);

    /// @brief Converts 60-minute hours to nanoseconds. Overflow traps.
    #[Pure, ThreadSafe]
    export let of_hours = func(hours: int64) -> Duration => new(hours * calendar.NanosPerHour);

    /// @brief A day is 24 hours.
    #[Pure, ThreadSafe]
    export let of_days = func(days: int64) -> Duration => new(days * calendar.NanosPerDay);

    /// @brief An optional sign, P, an optional day count with D, then optionally T and at least one of hours
    /// (H), minutes (M), and seconds (S) in that order; seconds may have a fraction of one through nine digits.
    ///
    /// At least one component is required, and letters are uppercase. The to_string form always parses. Errors:
    /// Empty; InvalidCharacter or UnexpectedEnd at the first byte that does not fit; OutOfRange at the first
    /// digit of the component that leaves int64.
    #[NoDiscard, ThreadSafe]
    export let parse = func(text: string) -> result.Result<Duration> {
        last scan = new calendar.Scanner(text);
        let negative = false;
        if (scan.accept(45)) {
            negative = true;
        } else {
            let _ = scan.accept(43);
        }
        scan.expect(80, "'P'");
        // The magnitude may reach 2^63 only for a negative duration.
        last limit: uint64 = negative ? 9223372036854775808 : 9223372036854775807;
        last state = new Accumulator(limit);
        let has_days = false;
        if (scan.peek_digit()) {
            last start = scan.position();
            let [days, _] = scan.digits();
            scan.expect(68, "'D'");
            state.add(scan, start, days, 86400000000000, 0);
            has_days = true;
        }
        if (scan.accept(84)) {
            // 1 after H, 2 after M, 3 after S.
            let stage = 0;
            let more = true;
            while (more && scan.ok()) {
                last start = scan.position();
                let [value, _] = scan.digits();
                let nanos = 0;
                if (scan.accept(46)) {
                    nanos = scan.fraction();
                    scan.expect(83, "'S'");
                    stage = 3;
                } else if (stage < 1 && scan.accept(72)) {
                    stage = 1;
                    state.add(scan, start, value, 3600000000000, 0);
                } else if (stage < 2 && scan.accept(77)) {
                    stage = 2;
                    state.add(scan, start, value, 60000000000, 0);
                } else if (scan.accept(83)) {
                    stage = 3;
                } else {
                    scan.unexpected(unit_names(stage));
                }
                if (stage == 3) {
                    state.add(scan, start, value, 1000000000, nanos as uint64);
                    more = false;
                }
                if (scan.at_end()) {
                    more = false;
                }
            }
        } else if (!has_days) {
            scan.unexpected("digit or 'T'");
        }
        scan.finish();
        if (!scan.ok()) {
            return result.Result<Duration>.Err(scan.failure());
        }
        return result.Result<Duration>.Ok(new Duration(signed_of(state.magnitude, negative)));
    };

    /// @brief Sums component magnitudes in uint64 against the sign's limit.
    let Accumulator = class (
        /// @brief The unsigned magnitude accumulated so far.
        export let magnitude: uint64 = 0;
        /// @brief The greatest magnitude representable with the parsed sign.
        last limit: uint64;

        /// @brief Starts an empty accumulation with the supplied limit.
        export let init = func(bound: uint64) {
            limit = bound;
        };

        /// @brief Adds value * unit + extra, or reports OutOfRange at `start`.
        export let add = func(scan: calendar.Scanner, start: int, value: uint64, unit: uint64, extra: uint64) {
            if (!scan.ok()) {
                return;
            }
            if (value > (limit - extra) / unit) {
                scan.out_of_range(start, "duration out of range");
                return;
            }
            last part = value * unit + extra;
            if (part > limit - magnitude) {
                scan.out_of_range(start, "duration out of range");
                return;
            }
            magnitude += part;
        };
    );

    /// @brief Returns the valid time-unit suffixes at the current parser stage.
    let unit_names = func(stage: int) -> string {
        if (stage == 0) {
            return "'H', 'M', 'S', or '.'";
        }
        if (stage == 1) {
            return "'M', 'S', or '.'";
        }
        return "'S' or '.'";
    };

    /// @brief |value| as uint64; the most negative value needs no negation.
    let magnitude_of = func(value: int64) -> uint64 {
        if (value >= 0) {
            return value as uint64;
        }
        return ((-(value + 1)) as uint64) + 1;
    };

    /// @brief The inverse of magnitude_of; the magnitude is within the sign's limit.
    let signed_of = func(magnitude: uint64, negative: bool) -> int64 {
        if (!negative) {
            return magnitude as int64;
        }
        if (magnitude == 0) {
            return 0;
        }
        return -((magnitude - 1) as int64) - 1;
    };

    /// @brief Nine digits without trailing zeros, after a point; empty for zero.
    let trimmed_fraction = func(nanos: uint64) -> string {
        if (nanos == 0) {
            return "";
        }
        last digits = calendar.padded(nanos as int64, 9);
        let end = 9;
        while (digits.byte_at(end - 1) == 48) {
            end--;
        }
        return "." + digits.slice(0, end);
    };
);
