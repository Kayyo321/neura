let calendar = import:Std.Time.Internal.Calendar;
let comparable = import:Std.Core.Comparable;
let hashing = import:Std.Core.Hash;
let ordering = import:Std.Core.Ordering;
let result = import:Std.Core.Result;

// A fixed offset from UTC in whole minutes, -18:00 through +18:00 (Stdlib.md
// section 12.1). There are no named zones and no daylight-saving rules.
export let ZoneOffset = module (
    export let ZoneOffset = class implements comparable.Comparable<ZoneOffset> (
        let seconds: int;

        export let init = func(int total) -> void {
            seconds = total;
        };

        // -64,800 through 64,800, a multiple of 60.
        export let total_seconds = func() -> int {
            return seconds;
        };

        // By total seconds, west before east.
        export let compare_to = func(ZoneOffset other) -> ordering.Ordering {
            if (seconds < other.seconds) {
                return ordering.Ordering.Less;
            }
            if (seconds > other.seconds) {
                return ordering.Ordering.Greater;
            }
            return ordering.Ordering.Equal;
        };

        export let.override equals = func(class other) -> bool {
            return other is ZoneOffset && seconds == (other as ZoneOffset).seconds;
        };

        export let.override hash_code = func() -> uint32 {
            return hashing.combine(17, seconds.hash_code());
        };

        // Z for zero; otherwise +HH:MM or -HH:MM.
        export let.override to_string = func() -> string {
            return calendar.offset_text(seconds);
        };
    );

    export const Utc: ZoneOffset = new ZoneOffset(0);

    // Hours -18 through 18 and minutes -59 through 59 with the same sign
    // (either may be zero), at most 18:00 from zero. Anything else traps
    // with "invalid argument: invalid zone offset".
    export let of_hours_minutes = func(int hours, int minutes) -> ZoneOffset {
        if (hours < -18 || hours > 18 || minutes < -59 || minutes > 59 || (hours > 0 && minutes < 0) ||
            (hours < 0 && minutes > 0)) {
            trap_with_message("invalid argument: invalid zone offset");
        }
        let total = hours * 3600 + minutes * 60;
        if (total < -calendar.MaxOffsetSeconds || total > calendar.MaxOffsetSeconds) {
            trap_with_message("invalid argument: invalid zone offset");
        }
        return new ZoneOffset(total);
    };

    // Z, or a sign and HH:MM no further than 18:00 from zero. -00:00 and
    // +00:00 are Utc. Errors: Empty; InvalidCharacter or UnexpectedEnd at
    // the first byte that does not fit; OutOfRange at an hour above 18 or a
    // minute above 59, or at the sign when the total exceeds 18:00.
    export let parse = func(string text) -> result.Result<ZoneOffset> {
        let scan = new calendar.Scanner(text);
        let total = calendar.read_offset(scan);
        scan.finish();
        if (!scan.ok()) {
            return result.Result<ZoneOffset>.Err(scan.failure());
        }
        return result.Result<ZoneOffset>.Ok(new ZoneOffset(total));
    };
);
