/// @brief The handle of a task started with `spawn` (Concurrency.md section 4.1). A handle is scope-bound: it
/// stays inside the `scope` block that started its task, so it cannot be returned, stored in a field, or captured.
/// @see [Std.Concurrent.Task](https://github.com/Kayyo321/neura/wiki/Stdlib-Concurrent-Task)
export let Task = module (
    /// @brief A call running as a task, or its result once the call has returned.
    export let Task = class<T> (
        let id: uint64;

        let init = func(task: uint64) {
            id = task;
        };

        /// @brief Waits until the task has finished and returns its result. Joining again returns the same
        /// value. A join is never cancelled.
        export let join = func -> T => join_task<T>(id);

        /// @brief Whether the task has finished. Never waits.
        export let is_finished = func -> bool => task_finished(id);

        /// @brief What a select waits on for this task. Used by the select statement.
        export let select_handle = func -> uint64 => id;

        /// @brief The result of a join that a select committed. Used by the select statement.
        export let join_selected = func(code: uint32) -> T => take<T>();
    );

    let join_task = func<T>(task: uint64) -> T scheduler("join");

    let take = func<T> -> T scheduler("take");

    let task_finished = func(task: uint64) -> bool scheduler("is_finished");
);
