/// @brief Mutable state that tasks may share, one at a time (Concurrency.md section 8). The guard owns the
/// state; a task reaches it only inside `with`, and nothing that refers to it can leave.
/// @see [Std.Concurrent.Guarded](https://github.com/Kayyo321/neura/wiki/Stdlib-Concurrent-Guarded)
#Since("0.1.0")
export let Guarded = module (
    /// @brief A guard around one mutable T.
    #Final
    export let Guarded = class<T> (
        /// @brief A guard that owns the state. Use create, which builds the state inside the guard.
        export let init = func(state: T) {
            open_guard<T>(instance, state);
        };

        /// @brief Runs `body` with exclusive access to the state and returns its result. A second task that
        /// calls with waits until the first returns. The body's captures and its result are transferable, so
        /// no reference to the state escapes. Calling with on a guard the task already holds traps.
        export let with = func<U>(body: func(T) -> U) -> U {
            last checked = transferable<(func(T) -> U)>(body);
            last state = enter_guard<T>(instance);
            last result = transferable<U>(checked(state));
            exit_guard<T>(instance);
            return result;
        };
    );

    /// @brief A guard around the state that `initializer` builds. The initializer's captures are
    /// transferable, so the state it builds is reachable only through the guard.
    export let create = func<T>(initializer: func() -> T) -> Guarded<T> {
        last checked = transferable<(func() -> T)>(initializer);
        return new(checked());
    };

    let open_guard = func<T>(guard: Guarded<T>, state: T) scheduler("guard.open");

    let enter_guard = func<T>(guard: Guarded<T>) -> T scheduler("guard.enter");

    let exit_guard = func<T>(guard: Guarded<T>) scheduler("guard.exit");

    let transferable = func<V>(value: V) -> V scheduler("transfer.check");
);
