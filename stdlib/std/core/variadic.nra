/// @brief Defines the argument representation shared by variadic formatting APIs.
/// @see [Std.Core.Variadic](https://github.com/Kayyo321/neura/wiki/Stdlib-Core-Variadic)
#Since("0.1.0")
export let Variadic = module (
    /// @brief Carries a packed argument with its primitive format or object-reference category preserved.
    #Since("0.1.0")
    export let Argument = enum (
        Text(string),
        Signed(int64),
        Unsigned(uint64),
        Floating16(float16),
        BFloating16(bfloat16),
        Floating32(float32),
        Floating(float64),
        Boolean(bool),
        Object(class)
    );
);
