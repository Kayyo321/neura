let error = import:Std.Core.Error;
let ordering = import:Std.Core.Ordering;
let result = import:Std.Core.Result;

// Companion functions for bool (Stdlib.md section 7.4).
export let Bool = module (
    // 1 for true, 0 for false.
    export let to_int = func(bool v) -> int {
        if (v) {
            return 1;
        }
        return 0;
    };

    export let xor = func(bool a, bool b) -> bool {
        return a != b;
    };

    // The natural order: false before true. Usable as a comparator.
    export let compare = func(bool a, bool b) -> ordering.Ordering {
        if (a == b) {
            return ordering.Ordering.Equal;
        }
        if (b) {
            return ordering.Ordering.Less;
        }
        return ordering.Ordering.Greater;
    };

    // 1231 for true and 1237 for false (section 5.2).
    export let hash = func(bool v) -> uint32 {
        return v.hash_code();
    };

    export let to_string = func(bool v) -> string {
        if (v) {
            return "true";
        }
        return "false";
    };

    // Accepts exactly `true` and `false`. The empty text fails with Empty; a
    // proper prefix of either word with UnexpectedEnd at its length; any
    // other text with InvalidCharacter at the first byte that matches
    // neither word.
    export let parse = func(string text) -> result.Result<bool> {
        if (text == "true") {
            return result.Result<bool>.Ok(true);
        }
        if (text == "false") {
            return result.Result<bool>.Ok(false);
        }
        let length = text.byte_length;
        if (length == 0) {
            return result.Result<bool>.Err(
                error.Error.Parse { kind: error.ParseErrorKind.Empty, offset: 0, message: "empty input" });
        }
        let matched = common_prefix(text, "true");
        let other = common_prefix(text, "false");
        if (other > matched) {
            matched = other;
        }
        if (matched == length) {
            return result.Result<bool>.Err(error.Error.Parse {
                kind: error.ParseErrorKind.UnexpectedEnd, offset: length, message: "expected true or false"
            });
        }
        return result.Result<bool>.Err(error.Error.Parse {
            kind: error.ParseErrorKind.InvalidCharacter, offset: matched, message: "invalid character"
        });
    };

    // The number of leading bytes that `text` shares with `word`.
    let common_prefix = func(string text, string word) -> int {
        let count = 0;
        while (count < text.byte_length && count < word.byte_length && text.byte_at(count) == word.byte_at(count)) {
            count = count + 1;
        }
        return count;
    };
);
