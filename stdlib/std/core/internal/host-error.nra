let.promote _ = import:Std.Core.Error;

// Maps a host service's uint32 error code to an Io error (Stdlib.md section
// 4.5). Codes 1 through 14 are the first fourteen IoErrorKind values in
// order; every other code is Other.
export let HostError = module (
    export let kind_of = func(code: uint32) -> IoErrorKind {
        if (code == 1) { return IoErrorKind.NotFound; }
        if (code == 2) { return IoErrorKind.PermissionDenied; }
        if (code == 3) { return IoErrorKind.AlreadyExists; }
        if (code == 4) { return IoErrorKind.InvalidInput; }
        if (code == 5) { return IoErrorKind.Interrupted; }
        if (code == 6) { return IoErrorKind.UnexpectedEnd; }
        if (code == 7) { return IoErrorKind.NotADirectory; }
        if (code == 8) { return IoErrorKind.IsADirectory; }
        if (code == 9) { return IoErrorKind.DirectoryNotEmpty; }
        if (code == 10) { return IoErrorKind.ConnectionRefused; }
        if (code == 11) { return IoErrorKind.ConnectionReset; }
        if (code == 12) { return IoErrorKind.TimedOut; }
        if (code == 13) { return IoErrorKind.Unsupported; }
        if (code == 14) { return IoErrorKind.CapabilityDenied; }
        return IoErrorKind.Other;
    };

    export let io = func(code: uint32, message: string, path: string) -> Error =>
        Error.Io { kind: kind_of(code), message: message, path: path };
);
