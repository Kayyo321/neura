/// @brief The reference arithmetic of float text conversion (Stdlib.md section 7.5): a non-negative integer
/// stored as a built-in uint32 list of limbs, least significant first.
///
/// Every limb operation follows the limb row of section 7.2: a limb product plus a carry plus an existing limb
/// is at most (2^32 - 1)^2 + 2(2^32 - 1) = 2^64 - 1, so every intermediate fits uint64. Library files only.
export let WideUint = module (
    /// @brief Selects the low 32 bits of a widened limb calculation.
    const LimbMask: uint64 = 4294967295;
    /// @brief The positional base of the 32-bit limb representation.
    const LimbBase: uint64 = 4294967296;
    /// @brief The base used to convert the magnitude into decimal digit groups.
    const Billion: uint32 = 1000000000;
    /// @brief 5^13, the largest power of five below 2^32.
    const FivePower13: uint32 = 1220703125;

    /// @brief A mutable nonnegative integer stored in normalized little-endian limbs.
    #Final
    export let WideUint = class (
        /// @brief No zero limb at the top; zero has no limbs.
        export let limbs: uint32[list] = [];

        /// @brief Reports whether the value has no nonzero limbs.
        #Pure
        export let is_zero = func -> bool => limbs.length == 0;

        /// @brief Tests the low bit, treating an empty limb list as even.
        #Pure
        export let is_odd = func -> bool => limbs.length > 0 && (limbs[0] & 1) == 1;

        /// @brief Copies the limbs into an independent value.
        #Pure
        export let copy = func -> WideUint {
            last duplicate = new WideUint();
            last target = duplicate.limbs;
            for (let limb in limbs) {
                target.append(limb);
            }
            return duplicate;
        };

        /// @brief Returns the number of significant bits, or zero for zero.
        #Pure
        export let bit_length = func -> int {
            last count = limbs.length;
            if (count == 0) {
                return 0;
            }
            let top = limbs[count - 1];
            let bits = 0;
            while (top != 0) {
                bits++;
                top >>= 1;
            }
            return (count - 1) * 32 + bits;
        };

        /// @brief -1, 0, or 1 as this value is below, equal to, or above `other`.
        #Pure
        export let compare = func(other: WideUint) -> int {
            last a = limbs;
            last b = other.limbs;
            if (a.length != b.length) {
                if (a.length < b.length) {
                    return -1;
                }
                return 1;
            }
            for (let i = a.length - 1; i >= 0; i--) {
                if (a[i] != b[i]) {
                    if (a[i] < b[i]) {
                        return -1;
                    }
                    return 1;
                }
            }
            return 0;
        };

        /// @brief The value when it is below 2^64; traps otherwise.
        #Pure
        export let to_uint64 = func -> uint64 {
            last count = limbs.length;
            if (count > 2) {
                trap_with_message("invalid state: wide integer exceeds uint64");
            }
            let value: uint64 = 0;
            if (count == 2) {
                value = (limbs[1] as uint64) << 32;
            }
            if (count >= 1) {
                value |= (limbs[0] as uint64);
            }
            return value;
        };

        /// @brief Adds another magnitude in place and propagates carries across limbs.
        export let add = func(other: WideUint) {
            last a = limbs;
            last b = other.limbs;
            let count = b.length;
            if (a.length > count) {
                count = a.length;
            }
            let carry: uint64 = 0;
            for (let i = 0; i < count; i++) {
                let sum = carry;
                if (i < a.length) {
                    sum += (a[i] as uint64);
                }
                if (i < b.length) {
                    sum += (b[i] as uint64);
                }
                last low = (sum & LimbMask) as uint32;
                if (i < a.length) {
                    a[i] = low;
                } else {
                    a.append(low);
                }
                carry = sum >> 32;
            }
            if (carry != 0) {
                a.append(carry as uint32);
            }
        };

        /// @brief Requires this value to be at least `other`.
        export let subtract = func(other: WideUint) {
            if (compare(other) < 0) {
                trap_with_message("invalid state: wide integer subtraction below zero");
            }
            last a = limbs;
            last b = other.limbs;
            let borrow: uint64 = 0;
            for (let i = 0; i < a.length; i++) {
                if (i >= b.length && borrow == 0) {
                    break;
                }
                let subtrahend = borrow;
                if (i < b.length) {
                    subtrahend += (b[i] as uint64);
                }
                last current = a[i] as uint64;
                if (current >= subtrahend) {
                    a[i] = (current - subtrahend) as uint32;
                    borrow = 0;
                } else {
                    // current < subtrahend <= 2^32, so the sum stays below 2^32.
                    a[i] = (current + LimbBase - subtrahend) as uint32;
                    borrow = 1;
                }
            }
            normalize();
        };

        /// @brief Adds a single limb in place, extending storage on a final carry.
        export let add_small = func(value: uint32) {
            last a = limbs;
            let carry = value as uint64;
            let i = 0;
            while (carry != 0) {
                if (i == a.length) {
                    a.append(carry as uint32);
                    return;
                }
                last sum = (a[i] as uint64) + carry;
                a[i] = (sum & LimbMask) as uint32;
                carry = sum >> 32;
                i++;
            }
        };

        /// @brief Multiplies by a single limb in place and keeps the result normalized.
        export let multiply_small = func(factor: uint32) {
            if (factor == 0) {
                limbs = [];
                return;
            }
            last a = limbs;
            last wide_factor = factor as uint64;
            let carry: uint64 = 0;
            for (let i = 0; i < a.length; i++) {
                last product = (a[i] as uint64) * wide_factor + carry;
                a[i] = (product & LimbMask) as uint32;
                carry = product >> 32;
            }
            if (carry != 0) {
                a.append(carry as uint32);
            }
        };

        /// @brief Divides in place and returns the remainder.
        ///
        /// A zero divisor traps (reason 1). The running remainder is below the divisor, so shifting it into the
        /// high half never discards a bit. The remainder is recovered by a multiplication, which costs far less
        /// than a second division.
        export let divide_small = func(divisor: uint32) -> uint32 {
            last a = limbs;
            last wide_divisor = divisor as uint64;
            let remainder: uint64 = 0;
            for (let i = a.length - 1; i >= 0; i--) {
                last current = (remainder << 32) | (a[i] as uint64);
                last quotient = current / wide_divisor;
                a[i] = quotient as uint32;
                remainder = current - quotient * wide_divisor;
            }
            normalize();
            return remainder as uint32;
        };

        /// @brief Multiplies the magnitude in place by a power of ten.
        export let multiply_pow10 = func(exponent: int) {
            let remaining = exponent;
            while (remaining >= 9) {
                multiply_small(Billion);
                remaining -= 9;
            }
            multiply_small(small_power(10, remaining));
        };

        /// @brief Divides by 5^exponent, rounding toward zero.
        ///
        /// Returns true when a remainder was discarded: the chained floor divisions give the floor of the whole
        /// division, and it is exact exactly when every step is.
        export let divide_pow5 = func(exponent: int) -> bool {
            let inexact = false;
            let remaining = exponent;
            while (remaining >= 13) {
                if (divide_small(FivePower13) != 0) {
                    inexact = true;
                }
                remaining -= 13;
            }
            if (remaining > 0 && divide_small(small_power(5, remaining)) != 0) {
                inexact = true;
            }
            return inexact;
        };

        /// @brief Shifts the magnitude left in place, inserting zero bits below it.
        export let shift_left = func(count: int) {
            if (count == 0 || limbs.length == 0) {
                return;
            }
            last whole = count / 32;
            last part = count % 32;
            last shifted: uint32[list] = [];
            for (let i = 0; i < whole; i++) {
                shifted.append(0);
            }
            if (part == 0) {
                for (let limb in limbs) {
                    shifted.append(limb);
                }
            } else {
                let carry: uint64 = 0;
                for (let limb in limbs) {
                    last wide = ((limb as uint64) << part) | carry;
                    shifted.append((wide & LimbMask) as uint32);
                    carry = wide >> 32;
                }
                if (carry != 0) {
                    shifted.append(carry as uint32);
                }
            }
            limbs = shifted;
        };

        /// @brief Shifts right, discarding the low bits.
        export let shift_right = func(count: int) {
            if (count == 0) {
                return;
            }
            last whole = count / 32;
            last part = count % 32;
            last a = limbs;
            if (whole >= a.length) {
                limbs = [];
                return;
            }
            last shifted: uint32[list] = [];
            for (let i = whole; i < a.length; i++) {
                let value = (a[i] as uint64) >> part;
                if (part != 0 && i + 1 < a.length) {
                    value |= (((a[i + 1] as uint64) << (32 - part)) & LimbMask);
                }
                shifted.append(value as uint32);
            }
            limbs = shifted;
            normalize();
        };

        /// @brief Compares the value of the low `count` bits (count >= 1) with 2^(count - 1): -1 below, 0
        /// equal, 1 above.
        #Pure
        export let low_bits_versus_half = func(count: int) -> int {
            last a = limbs;
            last index = (count - 1) / 32;
            last bit = (count - 1) % 32;
            if (index >= a.length || ((a[index] >> bit) & 1) == 0) {
                return -1;
            }
            let below: uint32 = 1;
            below = (below << bit) - 1;
            if ((a[index] & below) != 0) {
                return 1;
            }
            for (let i = 0; i < index; i++) {
                if (a[i] != 0) {
                    return 1;
                }
            }
            return 0;
        };

        /// @brief Whether the low `count` bits are all zero.
        #Pure
        export let low_bits_zero = func(count: int) -> bool {
            last a = limbs;
            last whole = count / 32;
            for (let i = 0; i < whole && i < a.length; i++) {
                if (a[i] != 0) {
                    return false;
                }
            }
            last part = count % 32;
            if (part > 0 && whole < a.length) {
                let mask: uint32 = 1;
                mask = (mask << part) - 1;
                if ((a[whole] & mask) != 0) {
                    return false;
                }
            }
            return true;
        };

        /// @brief Decimal digits, most significant first; "0" for zero.
        #Pure
        export let to_decimal = func -> string {
            if (limbs.length == 0) {
                return "0";
            }
            last work = copy();
            last groups: uint32[list] = [];
            while (!work.is_zero()) {
                groups.append(work.divide_small(Billion));
            }
            last bytes: uint8[list] = [];
            append_group(bytes, groups[groups.length - 1], false);
            for (let i = groups.length - 2; i >= 0; i--) {
                append_group(bytes, groups[i], true);
            }
            let [valid, text] = string.from_utf8(bytes);
            return text;
        };

        /// @brief Removes high zero limbs to restore the canonical representation.
        let normalize = func {
            last a = limbs;
            while (a.length > 0 && a[a.length - 1] == 0) {
                a.remove_at(a.length - 1);
            }
        };

        /// @brief The digits of one base-10^9 group, padded to nine when `full`.
        let append_group = func(bytes: uint8[list], group: uint32, full: bool) {
            last digits: uint8[list] = [];
            let rest = group;
            while (rest != 0) {
                digits.append((48 + rest % 10) as uint8);
                rest /= 10;
            }
            if (full) {
                while (digits.length < 9) {
                    digits.append(48);
                }
            }
            for (let i = digits.length - 1; i >= 0; i--) {
                bytes.append(digits[i]);
            }
        };
    );

    /// @brief Creates a fresh zero magnitude with no limbs.
    #Pure
    export let zero = func -> WideUint => new;

    /// @brief Splits an unsigned 64-bit value into up to two limbs.
    #Pure
    export let of = func(value: uint64) -> WideUint {
        last result_value = new WideUint();
        if (value != 0) {
            result_value.limbs.append((value & LimbMask) as uint32);
            last high = value >> 32;
            if (high != 0) {
                result_value.limbs.append(high as uint32);
            }
        }
        return result_value;
    };

    /// @brief base^exponent for a result below 2^32.
    let small_power = func(base: uint32, exponent: int) -> uint32 {
        let value: uint32 = 1;
        for (let i = 0; i < exponent; i++) {
            value *= base;
        }
        return value;
    };
);
