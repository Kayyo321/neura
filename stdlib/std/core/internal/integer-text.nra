let.promote _ = import:Std.Core.Error;
let.promote _ = import:Std.Core.Optional;

/// @brief Text helpers shared by the integer companion modules (Stdlib.md section 7.1): radix checks, digit
/// bytes, padding, and the parsing grammar's syntax errors.
///
/// The value accumulation stays in each type's module.
export let IntegerText = module (
    /// @brief Traps unless the radix is between 2 and 36 inclusive.
    export let check_radix = func(radix: int) {
        if (radix < 2 || radix > 36) {
            trap_with_message("invalid argument: radix outside 2 through 36");
        }
    };

    /// @brief The lowercase ASCII digit for a value from 0 through 35.
    export let digit_byte = func(value: int) -> uint8 {
        if (value < 10) {
            return (value + 48) as uint8;
        }
        return (value + 87) as uint8;
    };

    /// @brief The value of an ASCII digit byte, letters in either case, or 36 when the byte is not a digit of
    /// any radix.
    export let digit_value = func(b: uint8) -> int {
        if (b >= 48 && b <= 57) {
            return (b - 48) as int;
        }
        if (b >= 97 && b <= 122) {
            return (b - 87) as int;
        }
        if (b >= 65 && b <= 90) {
            return (b - 55) as int;
        }
        return 36;
    };

    /// @brief The text of digits stored least significant first, with a leading `-` when `negative` is set.
    export let digits_text = func(reversed: uint8[list], negative: bool) -> string {
        let bytes: uint8[list] = [];
        if (negative) {
            bytes.append(45);
        }
        for (let i = reversed.length - 1; i >= 0; i--) {
            bytes.append(reversed[i]);
        }
        let [valid, text] = string.from_utf8(bytes);
        return text;
    };

    /// @brief Left-pads `text` with copies of `pad` to `min_width` characters. A `0` pad goes after a leading
    /// `-`. `pad` must be one scalar value.
    export let pad_number = func(text: string, min_width: int, pad: string) -> string {
        let pad_length = pad.byte_length;
        if (pad_length == 0 || sequence_length(pad.byte_at(0)) != pad_length) {
            trap_with_message("invalid argument: pad is not one scalar value");
        }
        let missing = min_width - text.byte_length;
        if (missing <= 0) {
            return text;
        }
        let padding = "";
        for (let i = 0; i < missing; i++) {
            padding += pad;
        }
        if (pad == "0" && text.byte_at(0) == 45) {
            return "-" + padding + text.slice(1, text.byte_length);
        }
        return padding + text;
    };

    /// @brief The first error of the grammar: an optional `+` or `-`, then one or more digits of the radix.
    /// None when the text matches.
    export let syntax_error = func(text: string, radix: int) -> Optional<Error> {
        let length = text.byte_length;
        if (length == 0) {
            return Optional<Error>.Some(parse_error(ParseErrorKind.Empty, 0, "empty input"));
        }
        let start = sign_length(text);
        if (start == length) {
            return Optional<Error>.Some(
                parse_error(ParseErrorKind.UnexpectedEnd, length, "expected a digit"));
        }
        for (let i = start; i < length; i++) {
            if (digit_value(text.byte_at(i)) >= radix) {
                return Optional<Error>.Some(
                    parse_error(ParseErrorKind.InvalidCharacter, i, "invalid character"));
            }
        }
        return Optional<Error>.None;
    };

    /// @brief 1 when the text starts with `+` or `-`, otherwise 0.
    export let sign_length = func(text: string) -> int {
        let first = text.byte_at(0);
        if (first == 43 || first == 45) {
            return 1;
        }
        return 0;
    };

    /// @brief Creates an out-of-range parse error for the given numeric type.
    export let out_of_range = func(type_name: string) -> Error =>
        parse_error(ParseErrorKind.OutOfRange, 0, "value out of range for " + type_name);

    /// @brief Creates a parse error at the supplied byte offset.
    let parse_error = func(kind: ParseErrorKind, offset: int, message: string) -> Error =>
        Error.Parse { kind: kind, offset: offset, message: message };

    /// @brief The length of the UTF-8 sequence that a lead byte starts.
    let sequence_length = func(lead: uint8) -> int {
        if (lead < 128) {
            return 1;
        }
        if (lead < 224) {
            return 2;
        }
        if (lead < 240) {
            return 3;
        }
        return 4;
    };
);
