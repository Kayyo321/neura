let.promote _ = import:Std.Core.Comparable;
let.promote _ = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Ordering;
let data = import:Std.Core.Internal.UnicodeProperties;
let lookup = import:Std.Core.Internal.UnicodeLookup;
let ucd = import:Std.Core.Internal.UnicodeCharacter;
let unicode_case = import:Std.Text.Internal.UnicodeCase;
let unicode_names = import:Std.Core.Internal.UnicodeNameLookup;

/// @brief Unicode characters (Stdlib.md section 8.5): Java's Character over Unicode 17.0.0, in two shapes.
///
/// The module functions take a code point as a uint32, like Java's static methods take an int. They are total
/// over uint32: a value above 0x10FFFF has the properties of an unassigned code point, and only the functions
/// that build text or UTF-16 units trap for it. Surrogate code points U+D800 through U+DFFF have category
/// Surrogate. The class Character holds one Unicode scalar value (a code point that is not a surrogate), so its
/// text is always one character; its methods are the module functions applied to that value.
///
/// The properties come from the Unicode Character Database 17.0.0, the version of the String case tables,
/// through tables generated by scripts/generate-unicode-tables.py and searched by bisection. Case mapping is
/// the simple one-to-one mapping of UnicodeData.txt; to_upper_string and to_lower_string give the full
/// mappings that String.to_upper_case and to_lower_case use, which can expand a character, such as U+00DF to
/// "SS".
/// @see [Std.Core.Character](https://github.com/Kayyo321/neura/wiki/Stdlib-Core-Character)
#Since("0.3.0")
export let Character = module (
    /// @brief The smallest code point, U+0000.
    export const MinCodePoint: uint32 = 0;
    /// @brief The largest code point, U+10FFFF.
    export const MaxCodePoint: uint32 = 1114111;
    /// @brief The first supplementary code point, U+10000.
    export const MinSupplementaryCodePoint: uint32 = 65536;
    /// @brief The first high (leading) surrogate, U+D800.
    export const MinHighSurrogate: uint32 = 55296;
    /// @brief The last high (leading) surrogate, U+DBFF.
    export const MaxHighSurrogate: uint32 = 56319;
    /// @brief The first low (trailing) surrogate, U+DC00.
    export const MinLowSurrogate: uint32 = 56320;
    /// @brief The last low (trailing) surrogate, U+DFFF.
    export const MaxLowSurrogate: uint32 = 57343;
    /// @brief The first surrogate, U+D800.
    export const MinSurrogate: uint32 = 55296;
    /// @brief The last surrogate, U+DFFF.
    export const MaxSurrogate: uint32 = 57343;
    /// @brief The smallest radix of digit and for_digit.
    export const MinRadix: int = 2;
    /// @brief The largest radix of digit and for_digit.
    export const MaxRadix: int = 36;
    /// @brief The version of the Unicode Character Database behind every property.
    export const UnicodeVersion: string = "17.0.0";

    /// @brief The General_Category values in Unicode's order. Java's getType constants map one to one:
    /// OpenPunctuation is START_PUNCTUATION, ClosePunctuation END_PUNCTUATION, SpacingMark
    /// COMBINING_SPACING_MARK, DecimalNumber DECIMAL_DIGIT_NUMBER, and NonspacingMark NON_SPACING_MARK.
    export let GeneralCategory = enum (
        UppercaseLetter, LowercaseLetter, TitlecaseLetter, ModifierLetter, OtherLetter, NonspacingMark,
        SpacingMark, EnclosingMark, DecimalNumber, LetterNumber, OtherNumber, ConnectorPunctuation,
        DashPunctuation, OpenPunctuation, ClosePunctuation, InitialPunctuation, FinalPunctuation, OtherPunctuation,
        MathSymbol, CurrencySymbol, ModifierSymbol, OtherSymbol, SpaceSeparator, LineSeparator,
        ParagraphSeparator, Control, Format, Surrogate, PrivateUse, Unassigned
    );

    /// @brief The Bidi_Class values, in the order of Java's DIRECTIONALITY constants, and Undefined, which
    /// get_directionality returns for code points that are not defined.
    export let BidiClass = enum (
        LeftToRight, RightToLeft, ArabicLetter, EuropeanNumber, EuropeanSeparator, EuropeanTerminator,
        ArabicNumber, CommonSeparator, NonspacingMark, BoundaryNeutral, ParagraphSeparator, SegmentSeparator,
        WhiteSpace, OtherNeutral, LeftToRightEmbedding, LeftToRightOverride, RightToLeftEmbedding,
        RightToLeftOverride, PopDirectionalFormat, LeftToRightIsolate, RightToLeftIsolate, FirstStrongIsolate,
        PopDirectionalIsolate, Undefined
    );

    /// @brief One Unicode scalar value with value semantics: equal when the code points are equal, hashed as
    /// the code point (Java's hashCode is the char value), ordered by code point, and printed as the
    /// character itself.
    #[Final, NoDiscard, Immutable, ThreadSafe]
    export let Character = class implements Comparable<Character> (
        /// @brief The Unicode scalar value.
        export last code_point: uint32;

        /// @brief The character of a Unicode scalar value. Traps with "invalid argument: not a Unicode scalar
        /// value" for a surrogate or a value above 0x10FFFF.
        export let init = func(value: uint32) {
            ucd.check_scalar(value);
            code_point = value;
        };

        /// @brief The one-character string.
        #Pure
        export let.override to_string = func -> string => ucd.text(code_point);

        /// @brief Tests whether another Character holds the same code point.
        export let.override equals = func(other: class) -> bool {
            if (other is not that: Character) {
                return false;
            }
            return code_point == that.code_point;
        };

        /// @brief The code point, as for a uint32 (Stdlib.md section 5.2).
        #Pure
        export let.override hash_code = func -> uint32 => code_point;

        /// @brief Orders by code point.
        #Pure
        export let compare_to = func(other: Character) -> Ordering => order(code_point, other.code_point);

        /// @brief The general category.
        #Pure
        export let get_type = func -> GeneralCategory => category_of(ucd.category(code_point));

        /// @brief The directionality (Bidi_Class), Undefined for an unassigned character.
        #Pure
        export let get_directionality = func -> BidiClass => bidi_of(ucd.directionality(code_point));

        /// @brief Tests the Uppercase property.
        #Pure
        export let is_upper = func -> bool => ucd.has(data.Uppercase, code_point);

        /// @brief Tests the Lowercase property.
        #Pure
        export let is_lower = func -> bool => ucd.has(data.Lowercase, code_point);

        /// @brief Tests for general category Lt.
        #Pure
        export let is_title_case = func -> bool => ucd.category(code_point) == 2;

        /// @brief Tests for a letter (general category L).
        #Pure
        export let is_letter = func -> bool => ucd.is_letter(code_point);

        /// @brief Tests for a decimal digit (general category Nd).
        #Pure
        export let is_digit = func -> bool => ucd.is_digit(code_point);

        /// @brief Tests for a letter or a decimal digit.
        #Pure
        export let is_letter_or_digit = func -> bool => ucd.is_letter_or_digit(code_point);

        /// @brief Tests the Alphabetic property.
        #Pure
        export let is_alphabetic = func -> bool => ucd.has(data.Alphabetic, code_point);

        /// @brief Tests for a letter, as is_letter.
        #Pure
        export let is_alpha = func -> bool => ucd.is_letter(code_point);

        /// @brief Tests for a Unicode numeric value.
        #Pure
        export let is_numeric = func -> bool => ucd.numeric_index(code_point) != 0;

        /// @brief Tests for a letter or a character with a numeric value.
        #Pure
        export let is_alpha_numeric = func -> bool =>
            ucd.is_letter(code_point) || ucd.numeric_index(code_point) != 0;

        /// @brief Tests Java's white space set.
        #Pure
        export let is_whitespace = func -> bool => ucd.is_whitespace(code_point);

        /// @brief Tests for general category Zs, Zl, or Zp.
        #Pure
        export let is_space_char = func -> bool => ucd.is_space_char(code_point);

        /// @brief Tests the White_Space property.
        #Pure
        export let is_space = func -> bool => ucd.has(data.WhiteSpace, code_point);

        /// @brief Tests for an ISO control character.
        #Pure
        export let is_iso_control = func -> bool => ucd.is_iso_control(code_point);

        /// @brief Tests whether the character is assigned (its category is not Unassigned).
        #Pure
        export let is_defined = func -> bool => ucd.category(code_point) != ucd.Unassigned;

        /// @brief Tests the Ideographic property.
        #Pure
        export let is_ideographic = func -> bool => ucd.has(data.Ideographic, code_point);

        /// @brief Tests the Bidi_Mirrored property.
        #Pure
        export let is_mirrored = func -> bool => ucd.has(data.BidiMirrored, code_point);

        /// @brief Tests whether the character is in the Basic Multilingual Plane.
        #Pure
        export let is_bmp = func -> bool => code_point < MinSupplementaryCodePoint;

        /// @brief Tests whether the character is outside the Basic Multilingual Plane.
        #Pure
        export let is_supplementary = func -> bool => code_point >= MinSupplementaryCodePoint;

        /// @brief The simple uppercase mapping.
        #Pure
        export let to_upper = func -> Character => new(ucd.simple_case(code_point, 0));

        /// @brief The simple lowercase mapping.
        #Pure
        export let to_lower = func -> Character => new(ucd.simple_case(code_point, 1));

        /// @brief The simple titlecase mapping.
        #Pure
        export let to_title = func -> Character => new(ucd.simple_case(code_point, 2));

        /// @brief The full uppercase mapping, as String.to_upper_case gives it.
        #Pure
        export let to_upper_string = func -> string => unicode_case.upper(ucd.text(code_point), "");

        /// @brief The full lowercase mapping, as String.to_lower_case gives it.
        #Pure
        export let to_lower_string = func -> string => unicode_case.lower(ucd.text(code_point), "");

        /// @brief The digit value in the radix, or -1; see the module function digit.
        #Pure
        export let digit = func(radix: int) -> int => ucd.digit(code_point, radix);

        /// @brief The numeric value; see the module function numeric_value.
        #Pure
        export let numeric_value = func -> int => ucd.numeric_value(code_point);

        /// @brief The number of UTF-16 code units, 1 or 2.
        #Pure
        export let char_count = func -> int => code_point >= MinSupplementaryCodePoint ? 2 : 1;

        /// @brief The number of UTF-8 bytes, 1 through 4.
        #Pure
        export let utf8_length = func -> int => utf8_bytes(code_point);
    );

    /// @brief The two-letter category abbreviations in declaration order.
    const CategoryCodes: string = "LuLlLtLmLoMnMcMeNdNlNoPcPdPsPePiPfPoSmScSkSoZsZlZpCcCfCsCoCn";

    /// @brief The Bidi_Class abbreviations in declaration order, joined, and an empty one for Undefined.
    const BidiCodes: string = "LRALENESETANCSNSMBNBSWSONLRELRORLERLOPDFLRIRLIFSIPDI";
    /// @brief The three-digit start of each text in BidiCodes, then its length.
    const BidiCodeOffsets: string = "00000100200400600800:00<00>00A00C00D00E00G00I00L00O00R00U00X00[00^00a00d00d";

    /// @brief The category with a declaration ordinal.
    #Pure
    let category_of = func(index: int) -> GeneralCategory {
        if (index < 15) {
            if (index < 7) {
                if (index < 3) {
                    if (index < 1) {
                        return GeneralCategory.UppercaseLetter;
                    }
                    if (index < 2) {
                        return GeneralCategory.LowercaseLetter;
                    }
                    return GeneralCategory.TitlecaseLetter;
                }
                if (index < 5) {
                    if (index < 4) {
                        return GeneralCategory.ModifierLetter;
                    }
                    return GeneralCategory.OtherLetter;
                }
                return if (index < 6) -> GeneralCategory.NonspacingMark else -> GeneralCategory.SpacingMark;
            }
            if (index < 11) {
                if (index < 9) {
                    if (index < 8) {
                        return GeneralCategory.EnclosingMark;
                    }
                    return GeneralCategory.DecimalNumber;
                }
                return if (index < 10) -> GeneralCategory.LetterNumber else -> GeneralCategory.OtherNumber;
            }
            if (index < 13) {
                if (index < 12) {
                    return GeneralCategory.ConnectorPunctuation;
                }
                return GeneralCategory.DashPunctuation;
            }
            return if (index < 14) -> GeneralCategory.OpenPunctuation else -> GeneralCategory.ClosePunctuation;
        }
        if (index < 22) {
            if (index < 18) {
                if (index < 16) {
                    return GeneralCategory.InitialPunctuation;
                }
                if (index < 17) {
                    return GeneralCategory.FinalPunctuation;
                }
                return GeneralCategory.OtherPunctuation;
            }
            if (index < 20) {
                return if (index < 19) -> GeneralCategory.MathSymbol else -> GeneralCategory.CurrencySymbol;
            }
            return if (index < 21) -> GeneralCategory.ModifierSymbol else -> GeneralCategory.OtherSymbol;
        }
        if (index < 26) {
            if (index < 24) {
                return if (index < 23) -> GeneralCategory.SpaceSeparator else -> GeneralCategory.LineSeparator;
            }
            return if (index < 25) -> GeneralCategory.ParagraphSeparator else -> GeneralCategory.Control;
        }
        if (index < 28) {
            return if (index < 27) -> GeneralCategory.Format else -> GeneralCategory.Surrogate;
        }
        return if (index < 29) -> GeneralCategory.PrivateUse else -> GeneralCategory.Unassigned;
    };

    /// @brief The bidi class with a declaration ordinal.
    #Pure
    let bidi_of = func(index: int) -> BidiClass {
        if (index < 12) {
            if (index < 6) {
                if (index < 3) {
                    if (index < 1) {
                        return BidiClass.LeftToRight;
                    }
                    return if (index < 2) -> BidiClass.RightToLeft else -> BidiClass.ArabicLetter;
                }
                if (index < 4) {
                    return BidiClass.EuropeanNumber;
                }
                return if (index < 5) -> BidiClass.EuropeanSeparator else -> BidiClass.EuropeanTerminator;
            }
            if (index < 9) {
                if (index < 7) {
                    return BidiClass.ArabicNumber;
                }
                return if (index < 8) -> BidiClass.CommonSeparator else -> BidiClass.NonspacingMark;
            }
            if (index < 10) {
                return BidiClass.BoundaryNeutral;
            }
            return if (index < 11) -> BidiClass.ParagraphSeparator else -> BidiClass.SegmentSeparator;
        }
        if (index < 18) {
            if (index < 15) {
                if (index < 13) {
                    return BidiClass.WhiteSpace;
                }
                return if (index < 14) -> BidiClass.OtherNeutral else -> BidiClass.LeftToRightEmbedding;
            }
            if (index < 16) {
                return BidiClass.LeftToRightOverride;
            }
            return if (index < 17) -> BidiClass.RightToLeftEmbedding else -> BidiClass.RightToLeftOverride;
        }
        if (index < 21) {
            if (index < 19) {
                return BidiClass.PopDirectionalFormat;
            }
            return if (index < 20) -> BidiClass.LeftToRightIsolate else -> BidiClass.RightToLeftIsolate;
        }
        if (index < 22) {
            return BidiClass.FirstStrongIsolate;
        }
        return if (index < 23) -> BidiClass.PopDirectionalIsolate else -> BidiClass.Undefined;
    };

    // Values

    /// @brief The Character of a Unicode scalar value. Traps with "invalid argument: not a Unicode scalar
    /// value" for a surrogate or a value above 0x10FFFF.
    #[NoDiscard, Pure, ThreadSafe]
    export let of = func(code_point: uint32) -> Character => new(code_point);

    /// @brief The Character of a Unicode scalar value, or None for a surrogate or a value above 0x10FFFF.
    #[NoDiscard, Pure, ThreadSafe]
    export let try_of = func(code_point: uint32) -> Optional<Character> =>
        ucd.is_scalar(code_point) ? Optional<Character>.Some(new(code_point)) : Optional<Character>.None;

    /// @brief The Character of a string that holds exactly one scalar value, or None.
    #[NoDiscard, Pure, ThreadSafe]
    export let from_text = func(text: string) -> Optional<Character> {
        if (text.byte_length == 0 || text.byte_length > 4) {
            return Optional<Character>.None;
        }
        last length = utf8_bytes(lead_scalar(text));
        if (length != text.byte_length) {
            return Optional<Character>.None;
        }
        return Optional<Character>.Some(new(lead_scalar(text)));
    };

    /// @brief The one-character string of a scalar value (Java's toString(int)). Traps as `of` does.
    #[Pure, ThreadSafe]
    export let to_string = func(code_point: uint32) -> string => ucd.text(code_point);

    /// @brief The code point as its hash, as for a uint32 (Java's hashCode(char)).
    #[Pure, ThreadSafe]
    export let hash = func(code_point: uint32) -> uint32 => code_point;

    /// @brief Orders two code points numerically.
    #[Pure, ThreadSafe]
    export let compare = func(left: uint32, right: uint32) -> Ordering => order(left, right);

    // Properties

    /// @brief The General_Category; Surrogate for U+D800 through U+DFFF and Unassigned above 0x10FFFF.
    #[Pure, ThreadSafe]
    export let get_type = func(code_point: uint32) -> GeneralCategory => category_of(ucd.category(code_point));

    /// @brief The two-letter abbreviation of a category, such as "Lu".
    #[Pure, ThreadSafe]
    export let category_code = func(category: GeneralCategory) -> string =>
        CategoryCodes.slice((category as int) * 2, (category as int) * 2 + 2);

    /// @brief The Bidi_Class of a defined code point (Java's getDirectionality); Undefined for a code point
    /// whose category is Unassigned, including noncharacters, and above 0x10FFFF.
    #[Pure, ThreadSafe]
    export let get_directionality = func(code_point: uint32) -> BidiClass =>
        bidi_of(ucd.directionality(code_point));

    /// @brief The Bidi_Class, including the default the UCD gives unassigned code points (for example
    /// RightToLeft in the Hebrew block and BoundaryNeutral for noncharacters); Undefined above 0x10FFFF.
    #[Pure, ThreadSafe]
    export let bidi_class = func(code_point: uint32) -> BidiClass => bidi_of(ucd.bidi_class(code_point));

    /// @brief The abbreviation of a bidi class, such as "AL"; an empty string for Undefined.
    #[Pure, ThreadSafe]
    export let bidi_code = func(bidi: BidiClass) -> string => lookup.entry(BidiCodes, BidiCodeOffsets, bidi as int);

    /// @brief Tests the Uppercase property: category Lu or Other_Uppercase (Java's isUpperCase).
    #[Pure, ThreadSafe]
    export let is_upper = func(code_point: uint32) -> bool => ucd.has(data.Uppercase, code_point);

    /// @brief Tests the Lowercase property: category Ll or Other_Lowercase (Java's isLowerCase).
    #[Pure, ThreadSafe]
    export let is_lower = func(code_point: uint32) -> bool => ucd.has(data.Lowercase, code_point);

    /// @brief Tests for category Lt, such as U+01C5 (Java's isTitleCase).
    #[Pure, ThreadSafe]
    export let is_title_case = func(code_point: uint32) -> bool => ucd.category(code_point) == 2;

    /// @brief Tests for category Lu, Ll, Lt, Lm, or Lo (Java's isLetter).
    #[Pure, ThreadSafe]
    export let is_letter = func(code_point: uint32) -> bool => ucd.is_letter(code_point);

    /// @brief Tests for category Nd (Java's isDigit).
    #[Pure, ThreadSafe]
    export let is_digit = func(code_point: uint32) -> bool => ucd.is_digit(code_point);

    /// @brief Tests for a letter or category Nd (Java's isLetterOrDigit).
    #[Pure, ThreadSafe]
    export let is_letter_or_digit = func(code_point: uint32) -> bool => ucd.is_letter_or_digit(code_point);

    /// @brief Tests the Alphabetic property: letters, category Nl, and Other_Alphabetic (Java's isAlphabetic).
    #[Pure, ThreadSafe]
    export let is_alphabetic = func(code_point: uint32) -> bool => ucd.has(data.Alphabetic, code_point);

    /// @brief Tests for a letter, the same set as is_letter (Python's str.isalpha).
    #[Pure, ThreadSafe]
    export let is_alpha = func(code_point: uint32) -> bool => ucd.is_letter(code_point);

    /// @brief Tests for a Unicode Numeric_Value, any Numeric_Type other than None (Python's str.isnumeric).
    /// Includes decimal digits, other digits, fractions, Roman numerals, and the CJK ideographs with numeric
    /// values in Unihan.
    #[Pure, ThreadSafe]
    export let is_numeric = func(code_point: uint32) -> bool => ucd.numeric_index(code_point) != 0;

    /// @brief Tests is_alpha or is_numeric (Python's str.isalnum).
    #[Pure, ThreadSafe]
    export let is_alpha_numeric = func(code_point: uint32) -> bool =>
        ucd.is_letter(code_point) || ucd.numeric_index(code_point) != 0;

    /// @brief Tests Java's white space: category Zs, Zl, or Zp except the no-break spaces U+00A0, U+2007,
    /// and U+202F, and U+0009 through U+000D and U+001C through U+001F (Java's isWhitespace). The String
    /// companion's strip and indentation use the same set.
    #[Pure, ThreadSafe]
    export let is_whitespace = func(code_point: uint32) -> bool => ucd.is_whitespace(code_point);

    /// @brief Tests for category Zs, Zl, or Zp (Java's isSpaceChar).
    #[Pure, ThreadSafe]
    export let is_space_char = func(code_point: uint32) -> bool => ucd.is_space_char(code_point);

    /// @brief Tests the Unicode White_Space property: U+0009 through U+000D, U+0020, U+0085, U+00A0, and the
    /// separators of categories Zs, Zl, and Zp. Unlike is_whitespace it includes the no-break spaces and NEL and
    /// excludes U+001C through U+001F.
    #[Pure, ThreadSafe]
    export let is_space = func(code_point: uint32) -> bool => ucd.has(data.WhiteSpace, code_point);

    /// @brief Tests for U+0000 through U+001F and U+007F through U+009F (Java's isISOControl).
    #[Pure, ThreadSafe]
    export let is_iso_control = func(code_point: uint32) -> bool => ucd.is_iso_control(code_point);

    /// @brief Tests whether the category is not Unassigned (Java's isDefined). Surrogates and private use code
    /// points are defined; noncharacters are not.
    #[Pure, ThreadSafe]
    export let is_defined = func(code_point: uint32) -> bool => ucd.category(code_point) != ucd.Unassigned;

    /// @brief Tests the Ideographic property (Java's isIdeographic).
    #[Pure, ThreadSafe]
    export let is_ideographic = func(code_point: uint32) -> bool => ucd.has(data.Ideographic, code_point);

    /// @brief Tests the Bidi_Mirrored property (Java's isMirrored).
    #[Pure, ThreadSafe]
    export let is_mirrored = func(code_point: uint32) -> bool => ucd.has(data.BidiMirrored, code_point);

    /// @brief Tests whether a code point may start a Unicode identifier: ID_Start or U+2E2F VERTICAL TILDE
    /// (Java's isUnicodeIdentifierStart, its profile of UAX #31).
    #[Pure, ThreadSafe]
    export let is_identifier_start = func(code_point: uint32) -> bool => ucd.is_identifier_start(code_point);

    /// @brief Tests whether a code point may continue a Unicode identifier: ID_Continue, U+2E2F, or
    /// is_identifier_ignorable (Java's isUnicodeIdentifierPart).
    #[Pure, ThreadSafe]
    export let is_identifier_part = func(code_point: uint32) -> bool => ucd.is_identifier_part(code_point);

    /// @brief Tests U+0000 through U+0008, U+000E through U+001B, U+007F through U+009F, and category Cf
    /// (Java's isIdentifierIgnorable).
    #[Pure, ThreadSafe]
    export let is_identifier_ignorable = func(code_point: uint32) -> bool =>
        ucd.is_identifier_ignorable(code_point);

    /// @brief Tests whether a code point may start a Java identifier: a letter or category Nl, Sc, or Pc
    /// (Java's isJavaIdentifierStart).
    #[Pure, ThreadSafe]
    export let is_java_identifier_start = func(code_point: uint32) -> bool =>
        ucd.is_java_identifier_start(code_point);

    /// @brief Tests whether a code point may continue a Java identifier: a letter, category Sc, Pc, Nd, Nl,
    /// Mc, or Mn, or is_identifier_ignorable (Java's isJavaIdentifierPart).
    #[Pure, ThreadSafe]
    export let is_java_identifier_part = func(code_point: uint32) -> bool => ucd.is_java_identifier_part(code_point);

    /// @brief Tests the Emoji property of UTS #51 (Java's isEmoji). Digits, `#`, and `*` have it.
    #[Pure, ThreadSafe]
    export let is_emoji = func(code_point: uint32) -> bool => ucd.has(data.Emoji, code_point);

    /// @brief Tests the Emoji_Presentation property (Java's isEmojiPresentation).
    #[Pure, ThreadSafe]
    export let is_emoji_presentation = func(code_point: uint32) -> bool =>
        ucd.has(data.EmojiPresentation, code_point);

    /// @brief Tests the Emoji_Modifier property, the skin tone modifiers (Java's isEmojiModifier).
    #[Pure, ThreadSafe]
    export let is_emoji_modifier = func(code_point: uint32) -> bool => ucd.has(data.EmojiModifier, code_point);

    /// @brief Tests the Emoji_Modifier_Base property (Java's isEmojiModifierBase).
    #[Pure, ThreadSafe]
    export let is_emoji_modifier_base = func(code_point: uint32) -> bool =>
        ucd.has(data.EmojiModifierBase, code_point);

    /// @brief Tests the Emoji_Component property (Java's isEmojiComponent).
    #[Pure, ThreadSafe]
    export let is_emoji_component = func(code_point: uint32) -> bool => ucd.has(data.EmojiComponent, code_point);

    /// @brief Tests the Extended_Pictographic property (Java's isExtendedPictographic).
    #[Pure, ThreadSafe]
    export let is_extended_pictographic = func(code_point: uint32) -> bool =>
        ucd.has(data.ExtendedPictographic, code_point);

    // Case

    /// @brief The simple uppercase mapping of UnicodeData.txt; the code point itself when it has none
    /// (Java's toUpperCase(int)). U+00DF maps to itself; to_upper_string gives "SS".
    #[Pure, ThreadSafe]
    export let to_upper = func(code_point: uint32) -> uint32 => ucd.simple_case(code_point, 0);

    /// @brief The simple lowercase mapping; the code point itself when it has none (Java's toLowerCase(int)).
    #[Pure, ThreadSafe]
    export let to_lower = func(code_point: uint32) -> uint32 => ucd.simple_case(code_point, 1);

    /// @brief The simple titlecase mapping, which is the uppercase mapping where UnicodeData.txt gives none
    /// (Java's toTitleCase(int)). U+01C6 maps to U+01C5.
    #[Pure, ThreadSafe]
    export let to_title = func(code_point: uint32) -> uint32 => ucd.simple_case(code_point, 2);

    /// @brief The full uppercase mapping with the root rules of String.to_upper_case, which can be several
    /// characters: U+00DF gives "SS". Traps as `of` does.
    #[Pure, ThreadSafe]
    export let to_upper_string = func(code_point: uint32) -> string => unicode_case.upper(ucd.text(code_point), "")
        /// @brief The full uppercase mapping with the rules of a language tag, as String.to_upper_case(tag):
        /// "tr" and "az" map i to U+0130.
        or func(code_point: uint32, language_tag: string) -> string =>
            unicode_case.upper(ucd.text(code_point), language_tag);

    /// @brief The full lowercase mapping with the root rules of String.to_lower_case: U+0130 gives "i"
    /// followed by U+0307. A lone U+03A3 has no letter before it, so it maps to U+03C3, not the final
    /// sigma. Traps as `of` does.
    #[Pure, ThreadSafe]
    export let to_lower_string = func(code_point: uint32) -> string => unicode_case.lower(ucd.text(code_point), "")
        /// @brief The full lowercase mapping with the rules of a language tag, as String.to_lower_case(tag):
        /// "tr" and "az" map I to U+0131.
        or func(code_point: uint32, language_tag: string) -> string =>
            unicode_case.lower(ucd.text(code_point), language_tag);

    // Digits and numbers

    /// @brief The value of a digit in a radix (Java's digit(int, int)): the decimal digit value of a category
    /// Nd code point, or 10 through 35 for A through Z and a through z in ASCII or fullwidth form, when the
    /// value is below the radix; otherwise -1. Unlike Java, a radix outside 2 through 36 traps with
    /// "invalid argument: radix outside 2 through 36" (Stdlib.md section 5.1).
    #[Pure, ThreadSafe]
    export let digit = func(code_point: uint32, radix: int) -> int => ucd.digit(code_point, radix);

    /// @brief The lowercase ASCII digit for a value from 0 through radix - 1 (Java's forDigit). Unlike Java,
    /// which returns U+0000, a radix outside 2 through 36 traps as in digit and a value outside the radix
    /// traps with "invalid argument: digit out of range", as Scalars.from_digit does.
    #[Pure, ThreadSafe]
    export let for_digit = func(value: int, radix: int) -> uint32 => ucd.for_digit(value, radix);

    /// @brief Java's getNumericValue over the Unicode Numeric_Value property: 10 through 35 for A through Z
    /// and a through z in ASCII or fullwidth form; the value when it is an integer from 0 through 2^31 - 1,
    /// such as 50 for U+216C ROMAN NUMERAL FIFTY; -2 for a fraction, a negative value, or a larger value; and
    /// -1 when there is none. The CJK ideographs with Unihan numeric values have them, such as 5 for U+4E94.
    #[Pure, ThreadSafe]
    export let numeric_value = func(code_point: uint32) -> int => ucd.numeric_value(code_point);

    /// @brief The exact Unicode Numeric_Value as text, an integer or a fraction such as "1/2" or "-1/2", or
    /// None when there is none. Latin letters have none.
    #[Pure, ThreadSafe]
    export let numeric_value_text = func(code_point: uint32) -> Optional<string> {
        last index = ucd.numeric_index(code_point);
        return index == 0 ? Optional<string>.None : Optional<string>.Some(ucd.numeric_text(index));
    };

    // Names

    /// @brief Java's getName: the name of a code point, or None when it is unassigned or above 0x10FFFF.
    ///
    /// A code point listed by name in UnicodeData.txt has its Unicode Name, such as `LATIN SMALL LETTER A`,
    /// `GRINNING FACE`, or `CJK COMPATIBILITY IDEOGRAPH-F900`. A control has Java's name for it, its Unicode 1.0
    /// name such as `NULL` and `LINE FEED (LF)`, with `BEL` for U+0007 and the aliases `PADDING CHARACTER`,
    /// `HIGH OCTET PRESET`, and `SINGLE GRAPHIC CHARACTER INTRODUCER` for U+0080, U+0081, and U+0099. Every
    /// other assigned code point, the CJK unified ideographs, Hangul syllables, Tangut ideographs, surrogates,
    /// private use, and U+0084, has Java's block form: the block name in capitals with spaces for its spaces,
    /// hyphens, and underscores, a space, and the code point in uppercase hex without leading zeros, such as
    /// `CJK UNIFIED IDEOGRAPHS 4E00`, `HANGUL SYLLABLES AC00`, and `LATIN 1 SUPPLEMENT 84`. unicode_name gives
    /// the Unicode Name instead. Unlike Java, which throws, a value above 0x10FFFF gives None.
    #[Pure, ThreadSafe]
    export let get_name = func(code_point: uint32) -> Optional<string> {
        if (code_point > MaxCodePoint) {
            return Optional<string>.None;
        }
        last name = unicode_names.java_name(code_point);
        return name.byte_length == 0 ? Optional<string>.None : Optional<string>.Some(name);
    };

    /// @brief The Unicode Name property (Python's unicodedata.name), or None when the code point has none:
    /// controls, surrogates, private use, noncharacters, unassigned code points, and values above 0x10FFFF.
    /// The names of Hangul syllables and of the patterned ranges are generated: `HANGUL SYLLABLE GAG`,
    /// `CJK UNIFIED IDEOGRAPH-4E00`, `TANGUT IDEOGRAPH-17000`, `KHITAN SMALL SCRIPT CHARACTER-18B00`,
    /// `NUSHU CHARACTER-1B170`, `EGYPTIAN HIEROGLYPH-13460`, and `CJK COMPATIBILITY IDEOGRAPH-F900`.
    #[Pure, ThreadSafe]
    export let unicode_name = func(code_point: uint32) -> Optional<string> {
        if (code_point > MaxCodePoint) {
            return Optional<string>.None;
        }
        last name = unicode_names.unicode_name(code_point);
        return name.byte_length == 0 ? Optional<string>.None : Optional<string>.Some(name);
    };

    /// @brief Java's codePointOf: the code point with a name that get_name or unicode_name returns, compared
    /// after removing leading and trailing characters up to U+0020 and uppercasing with the root rules, so
    /// `" latin small letter a "` gives U+0061. Name aliases other than Java's control names, the loose
    /// matching of UAX #44, and named sequences are not accepted. Traps with "invalid argument: not a Unicode
    /// character name" for any other text; try_code_point_of returns None instead.
    #[Pure, ThreadSafe]
    export let code_point_of = func(name: string) -> uint32 {
        last found = unicode_names.code_point_of(name);
        if (found < 0) {
            trap_with_message("invalid argument: not a Unicode character name");
        }
        return found as uint32;
    };

    /// @brief code_point_of, with None for a text that is not a name.
    #[Pure, ThreadSafe]
    export let try_code_point_of = func(name: string) -> Optional<uint32> {
        last found = unicode_names.code_point_of(name);
        return found < 0 ? Optional<uint32>.None : Optional<uint32>.Some(found as uint32);
    };

    // Code points and encodings

    /// @brief Tests whether a value is at most 0x10FFFF (Java's isValidCodePoint).
    #[Pure, ThreadSafe]
    export let is_valid_code_point = func(code_point: uint32) -> bool => code_point <= MaxCodePoint;

    /// @brief Tests for a Unicode scalar value: at most 0x10FFFF and not a surrogate.
    #[Pure, ThreadSafe]
    export let is_scalar_value = func(code_point: uint32) -> bool => ucd.is_scalar(code_point);

    /// @brief Tests for a code point below U+10000 (Java's isBmpCodePoint).
    #[Pure, ThreadSafe]
    export let is_bmp = func(code_point: uint32) -> bool => code_point < MinSupplementaryCodePoint;

    /// @brief Tests for U+10000 through U+10FFFF (Java's isSupplementaryCodePoint).
    #[Pure, ThreadSafe]
    export let is_supplementary = func(code_point: uint32) -> bool =>
        code_point >= MinSupplementaryCodePoint && code_point <= MaxCodePoint;

    /// @brief Tests for U+D800 through U+DFFF (Java's isSurrogate).
    #[Pure, ThreadSafe]
    export let is_surrogate = func(unit: uint32) -> bool => unit >= MinSurrogate && unit <= MaxSurrogate;

    /// @brief Tests for U+D800 through U+DBFF (Java's isHighSurrogate).
    #[Pure, ThreadSafe]
    export let is_high_surrogate = func(unit: uint32) -> bool => unit >= MinHighSurrogate && unit <= MaxHighSurrogate;

    /// @brief Tests for U+DC00 through U+DFFF (Java's isLowSurrogate).
    #[Pure, ThreadSafe]
    export let is_low_surrogate = func(unit: uint32) -> bool => unit >= MinLowSurrogate && unit <= MaxLowSurrogate;

    /// @brief Tests a high surrogate followed by a low surrogate (Java's isSurrogatePair).
    #[Pure, ThreadSafe]
    export let is_surrogate_pair = func(high: uint32, low: uint32) -> bool =>
        is_high_surrogate(high) && is_low_surrogate(low);

    /// @brief The supplementary code point of a surrogate pair (Java's toCodePoint). Unlike Java, which does
    /// not validate, a pair that is not one traps with "invalid argument: not a surrogate pair".
    #[Pure, ThreadSafe]
    export let to_code_point = func(high: uint32, low: uint32) -> uint32 {
        if (not is_surrogate_pair(high, low)) {
            trap_with_message("invalid argument: not a surrogate pair");
        }
        return ((high - MinHighSurrogate) << 10) + (low - MinLowSurrogate) + MinSupplementaryCodePoint;
    };

    /// @brief The high surrogate of a supplementary code point (Java's highSurrogate). Unlike Java, which
    /// returns an unspecified unit, another value traps with "invalid argument: not a supplementary code point".
    #[Pure, ThreadSafe]
    export let high_surrogate = func(code_point: uint32) -> uint16 {
        check_supplementary(code_point);
        return (((code_point - MinSupplementaryCodePoint) >> 10) + MinHighSurrogate) as uint16;
    };

    /// @brief The low surrogate of a supplementary code point (Java's lowSurrogate). Traps as high_surrogate.
    #[Pure, ThreadSafe]
    export let low_surrogate = func(code_point: uint32) -> uint16 {
        check_supplementary(code_point);
        return (((code_point - MinSupplementaryCodePoint) & 1023) + MinLowSurrogate) as uint16;
    };

    /// @brief The number of UTF-16 code units of a code point: 2 from U+10000, otherwise 1. Like Java's
    /// charCount it does not validate the value.
    #[Pure, ThreadSafe]
    export let char_count = func(code_point: uint32) -> int => code_point >= MinSupplementaryCodePoint ? 2 : 1;

    /// @brief The UTF-16 code units of a code point, one for a BMP code point (a surrogate code point gives
    /// itself) and a surrogate pair from U+10000 (Java's toChars). A value above 0x10FFFF traps with
    /// "invalid argument: not a Unicode code point".
    #[NoDiscard, Pure, ThreadSafe]
    export let to_chars = func(code_point: uint32) -> uint16[list] {
        if (code_point > MaxCodePoint) {
            trap_with_message("invalid argument: not a Unicode code point");
        }
        last units: uint16[list] = new;
        if (code_point < MinSupplementaryCodePoint) {
            units.append(code_point as uint16);
        } else {
            units.append(high_surrogate(code_point));
            units.append(low_surrogate(code_point));
        }
        return units;
    };

    /// @brief The number of UTF-8 bytes of a scalar value, 1 through 4. Traps as `of` does.
    #[Pure, ThreadSafe]
    export let utf8_length = func(code_point: uint32) -> int {
        ucd.check_scalar(code_point);
        return utf8_bytes(code_point);
    };

    /// @brief The number of UTF-16 code units of a scalar value, 1 or 2. Traps as `of` does.
    #[Pure, ThreadSafe]
    export let utf16_length = func(code_point: uint32) -> int {
        ucd.check_scalar(code_point);
        return char_count(code_point);
    };

    /// @brief The UTF-8 bytes of a scalar value. Traps as `of` does.
    #[NoDiscard, Pure, ThreadSafe]
    export let to_utf8 = func(code_point: uint32) -> uint8[list] => ucd.utf8(code_point);

    /// @brief The code point at a UTF-16 index: a surrogate pair's code point when a high surrogate there is
    /// followed by a low surrogate, otherwise the unit itself (Java's codePointAt). An index outside the list
    /// traps as a list read does.
    #[Pure, ThreadSafe]
    export let code_point_at = func(units: uint16[list], index: int) -> uint32 {
        last first = units[index] as uint32;
        if (is_high_surrogate(first) && index + 1 < units.length) {
            last second = units[index + 1] as uint32;
            if (is_low_surrogate(second)) {
                return to_code_point(first, second);
            }
        }
        return first;
    };

    /// @brief The code point that ends before a UTF-16 index (Java's codePointBefore): a surrogate pair's
    /// code point when the units at index - 2 and index - 1 form one, otherwise the unit at index - 1.
    #[Pure, ThreadSafe]
    export let code_point_before = func(units: uint16[list], index: int) -> uint32 {
        last second = units[index - 1] as uint32;
        if (is_low_surrogate(second) && index >= 2) {
            last first = units[index - 2] as uint32;
            if (is_high_surrogate(first)) {
                return to_code_point(first, second);
            }
        }
        return second;
    };

    /// @brief The number of code points in units start through end - 1, a surrogate pair counting once and an
    /// unpaired surrogate counting as one code point (Java's codePointCount). Traps with "invalid argument:
    /// range outside the list" unless 0 <= start <= end <= the length.
    #[Pure, ThreadSafe]
    export let code_point_count = func(units: uint16[list], start: int, end: int) -> int {
        if (start < 0 || start > end || end > units.length) {
            trap_with_message("invalid argument: range outside the list");
        }
        let count = 0;
        let index = start;
        while (index < end) {
            if (is_high_surrogate(units[index] as uint32) && index + 1 < end &&
                is_low_surrogate(units[index + 1] as uint32)) {
                index += 2;
            } else {
                index += 1;
            }
            count += 1;
        }
        return count;
    };

    /// @brief The UTF-16 index `offset` code points away from `index`, forward for a positive offset and
    /// backward for a negative one (Java's offsetByCodePoints). Traps with "invalid argument: offset outside
    /// the list" when the move leaves the list.
    #[Pure, ThreadSafe]
    export let offset_by_code_points = func(units: uint16[list], index: int, offset: int) -> int {
        if (index < 0 || index > units.length) {
            trap_with_message("invalid argument: offset outside the list");
        }
        let position = index;
        if (offset >= 0) {
            for (let i = 0; i < offset; i += 1) {
                if (position >= units.length) {
                    trap_with_message("invalid argument: offset outside the list");
                }
                position += char_count(code_point_at(units, position));
            }
        } else {
            for (let i = 0; i < -offset; i += 1) {
                if (position <= 0) {
                    trap_with_message("invalid argument: offset outside the list");
                }
                position -= char_count(code_point_before(units, position));
            }
        }
        return position;
    };

    /// @brief The unit with its two bytes swapped (Java's reverseBytes(char)).
    #[Pure, ThreadSafe]
    export let reverse_bytes = func(unit: uint16) -> uint16 => ((unit << 8) | (unit >> 8)) as uint16;

    /// @brief The number of UTF-8 bytes of a value below 0x110000.
    let utf8_bytes = func(code_point: uint32) -> int =>
        code_point < 128 ? 1 : code_point < 2048 ? 2 : code_point < 65536 ? 3 : 4;

    /// @brief Decodes the scalar value at offset 0 of valid UTF-8 text.
    let lead_scalar = func(text: string) -> uint32 {
        last first = text.byte_at(0) as uint32;
        if (first < 128) {
            return first;
        }
        let value: uint32 = 0;
        let count = 0;
        if (first >= 240) {
            value = first & 7;
            count = 3;
        } else if (first >= 224) {
            value = first & 15;
            count = 2;
        } else {
            value = first & 31;
            count = 1;
        }
        for (let i = 1; i <= count; i += 1) {
            value = (value << 6) | ((text.byte_at(i) as uint32) & 63);
        }
        return value;
    };

    /// @brief Orders two code points.
    let order = func(left: uint32, right: uint32) -> Ordering =>
        left < right ? Ordering.Less : left > right ? Ordering.Greater : Ordering.Equal;

    /// @brief Traps unless the value is U+10000 through U+10FFFF.
    let check_supplementary = func(code_point: uint32) {
        if (not is_supplementary(code_point)) {
            trap_with_message("invalid argument: not a supplementary code point");
        }
    };
);
