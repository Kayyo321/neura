let integer_kernels = import:Std.Internal.Kernels.IntegerText;
let integer_text = import:Std.Core.Internal.IntegerText;
let kernel_status = import:Std.Core.Internal.KernelStatus;
let.promote _ = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Ordering;
let.promote _ = import:Std.Core.Result;

/// @brief Companion functions for uint32 (Stdlib.md section 7.1).
///
/// Every operation uses checked arithmetic; the wrapping forms follow the recipes of section 7.2, so no
/// intermediate value leaves its type.
/// @see [Std.Core.UInt32](https://github.com/Kayyo321/neura/wiki/Stdlib-Core-UInt32)
#Since("0.1.0")
export let UInt32 = module (
    /// @brief The smallest value representable by this integer type.
    export const Min: uint32 = 0;
    /// @brief The largest value representable by this integer type.
    export const Max: uint32 = 4294967295;
    /// @brief The number of bits in the integer representation.
    export const Bits: int = 32;

    /// @brief Returns zero for zero and one for every other value.
    export let sign = func(v: uint32) -> int => v == 0 ? 0 : 1;

    /// @brief Returns the smaller of the two operands.
    export let min = func(a: uint32, b: uint32) -> uint32 => b < a ? b : a;

    /// @brief Returns the larger of the two operands.
    export let max = func(a: uint32, b: uint32) -> uint32 => b > a ? b : a;

    /// @brief Traps with "invalid argument: low exceeds high".
    export let clamp = func(v: uint32, low: uint32, high: uint32) -> uint32 {
        if (low > high) {
            trap_with_message("invalid argument: low exceeds high");
        }
        if (v < low) {
            return low;
        }
        if (v > high) {
            return high;
        }
        return v;
    };

    /// @brief The natural order; usable as a comparator.
    export let compare = func(a: uint32, b: uint32) -> Ordering {
        if (a < b) {
            return Ordering.Less;
        }
        if (a > b) {
            return Ordering.Greater;
        }
        return Ordering.Equal;
    };

    /// @brief Square-and-multiply with checked multiplication (an overflow traps with reason 1).
    ///
    /// The factor is squared only while exponent bits remain, so each intermediate divides the result. A
    /// negative exponent traps; pow(0, 0) is 1.
    export let pow = func(base: uint32, exponent: int) -> uint32 {
        if (exponent < 0) {
            trap_with_message("invalid argument: negative exponent");
        }
        let product: uint32 = 1;
        let factor = base;
        let remaining = exponent;
        while (remaining > 0) {
            if ((remaining & 1) == 1) {
                product *= factor;
            }
            remaining >>= 1;
            if (remaining > 0) {
                factor *= factor;
            }
        }
        return product;
    };

    /// @brief Euclid's algorithm. gcd(0, 0) is 0.
    export let gcd = func(a: uint32, b: uint32) -> uint32 {
        let x = a;
        let y = b;
        while (y != 0) {
            last remainder = x % y;
            x = y;
            y = remainder;
        }
        return x;
    };

    /// @brief None where the operator would trap. Each test runs before the operation, so nothing overflows.
    #NoDiscard
    export let checked_add = func(a: uint32, b: uint32) -> Optional<uint32> {
        if (b > Max - a) {
            return Optional<uint32>.None;
        }
        return Optional<uint32>.Some(a + b);
    };

    /// @brief Returns the difference in Some, or None when it falls outside the type's range.
    #NoDiscard
    export let checked_sub = func(a: uint32, b: uint32) -> Optional<uint32> {
        if (a < b) {
            return Optional<uint32>.None;
        }
        return Optional<uint32>.Some(a - b);
    };

    /// @brief Returns the product in Some, or None when it falls outside the type's range.
    #NoDiscard
    export let checked_mul = func(a: uint32, b: uint32) -> Optional<uint32> {
        if (a != 0 && b > Max / a) {
            return Optional<uint32>.None;
        }
        return Optional<uint32>.Some(a * b);
    };

    /// @brief Returns the quotient in Some, or None when the divisor is zero.
    #NoDiscard
    export let checked_div = func(a: uint32, b: uint32) -> Optional<uint32> {
        if (b == 0) {
            return Optional<uint32>.None;
        }
        return Optional<uint32>.Some(a / b);
    };

    /// @brief Returns the remainder in Some, or None when the divisor is zero.
    #NoDiscard
    export let checked_rem = func(a: uint32, b: uint32) -> Optional<uint32> {
        if (b == 0) {
            return Optional<uint32>.None;
        }
        return Optional<uint32>.Some(a % b);
    };

    /// @brief The result modulo 2^Bits (section 7.2): the operands are widened to uint64, where a sum is below
    /// 2^33 and a product below 2^64, and the result is masked to the width.
    export let wrapping_add = func(a: uint32, b: uint32) -> uint32 =>
        (((a as uint64) + (b as uint64)) & 4294967295) as uint32;

    /// @brief 2^Bits is added before subtracting, so the uint64 difference stays non-negative.
    export let wrapping_sub = func(a: uint32, b: uint32) -> uint32 =>
        (((a as uint64) + 4294967296 - (b as uint64)) & 4294967295) as uint32;

    /// @brief Multiplies modulo two raised to the type's bit width.
    export let wrapping_mul = func(a: uint32, b: uint32) -> uint32 =>
        (((a as uint64) * (b as uint64)) & 4294967295) as uint32;

    /// @brief Negates modulo two raised to the type's bit width.
    export let wrapping_neg = func(a: uint32) -> uint32 => wrapping_sub(0, a);

    /// @brief Clamp to Min or Max instead of overflowing.
    export let saturating_add = func(a: uint32, b: uint32) -> uint32 {
        if (b > Max - a) {
            return Max;
        }
        return a + b;
    };

    /// @brief Subtracts and clamps an out-of-range result to the nearest representable bound.
    export let saturating_sub = func(a: uint32, b: uint32) -> uint32 {
        if (a < b) {
            return Min;
        }
        return a - b;
    };

    /// @brief Multiplies and clamps an out-of-range result to the nearest representable bound.
    export let saturating_mul = func(a: uint32, b: uint32) -> uint32 {
        if (a != 0 && b > Max / a) {
            return Max;
        }
        return a * b;
    };

    /// @brief For unsigned operands these are the ordinary quotient and remainder. A zero divisor traps (reason
    /// 1).
    export let floor_div = func(a: uint32, b: uint32) -> uint32 => a / b;

    /// @brief Returns the unsigned remainder. A zero divisor traps.
    export let floor_mod = func(a: uint32, b: uint32) -> uint32 => a % b;

    /// @brief Bit counts over Bits bits by masks and shifts. Each step adds neighbouring fields whose sums fit
    /// in the wider field, so nothing overflows.
    export let count_ones = func(v: uint32) -> int {
        let x = v;
        x = (x & 1431655765) + ((x >> 1) & 1431655765);
        x = (x & 858993459) + ((x >> 2) & 858993459);
        x = (x & 252645135) + ((x >> 4) & 252645135);
        x = (x & 16711935) + ((x >> 8) & 16711935);
        x = (x & 65535) + ((x >> 16) & 65535);
        return x as int;
    };

    /// @brief A binary search for the highest set bit: a left shift only discards bits already known to be
    /// zero.
    export let leading_zeros = func(v: uint32) -> int {
        if (v == 0) {
            return Bits;
        }
        let x = v;
        let count = 0;
        if ((x >> 16) == 0) {
            count += 16;
            x <<= 16;
        }
        if ((x >> 24) == 0) {
            count += 8;
            x <<= 8;
        }
        if ((x >> 28) == 0) {
            count += 4;
            x <<= 4;
        }
        if ((x >> 30) == 0) {
            count += 2;
            x <<= 2;
        }
        if ((x >> 31) == 0) {
            count++;
            x <<= 1;
        }
        return count;
    };

    /// @brief Counts zero bits from the least significant end. Zero returns the full bit width.
    export let trailing_zeros = func(v: uint32) -> int {
        if (v == 0) {
            return Bits;
        }
        let x = v;
        let count = 0;
        if ((x & 65535) == 0) {
            count += 16;
            x >>= 16;
        }
        if ((x & 255) == 0) {
            count += 8;
            x >>= 8;
        }
        if ((x & 15) == 0) {
            count += 4;
            x >>= 4;
        }
        if ((x & 3) == 0) {
            count += 2;
            x >>= 2;
        }
        if ((x & 1) == 0) {
            count++;
            x >>= 1;
        }
        return count;
    };

    /// @brief `n` is reduced to 0 through Bits - 1 first. A rotation by 0 returns `v`; otherwise both shift
    /// counts are between 1 and Bits - 1.
    export let rotate_left = func(v: uint32, n: int) -> uint32 {
        last count = rotation(n);
        if (count == 0) {
            return v;
        }
        return (v << count) | (v >> (Bits - count));
    };

    /// @brief Rotates the bits right, reducing the distance modulo the bit width.
    export let rotate_right = func(v: uint32, n: int) -> uint32 {
        last count = rotation(n);
        if (count == 0) {
            return v;
        }
        return (v >> count) | (v << (Bits - count));
    };

    /// @brief The identity: every integer module has both conversions.
    export let to_unsigned = func(v: uint32) -> uint32 => v;

    /// @brief The same-width signed type with the same bit pattern (section 7.2).
    export let to_signed = func(v: uint32) -> int32 {
        if (v < 2147483648) {
            return v as int32;
        }
        // v - 2^32 is between -2^31 and -1.
        return ((v as int64) - 4294967296) as int32;
    };

    /// @brief Section 5.2: the two's complement pattern as a uint32; the 64-bit types fold the high half into
    /// the low half.
    export let hash = func(v: uint32) -> uint32 => v.hash_code();

    /// @brief Decimal, with `-` for negative values (section 5.2).
    export let to_string = func(v: uint32) -> string => v.to_string();

    /// @brief Lowercase digits. A radix outside 2 through 36 traps. The neura.integer.format_u64 kernel
    /// writes the digits.
    export let to_string_radix = func(v: uint32, radix: int) -> string =>
        integer_kernels.format_u64(v as uint64, radix as int64);

    /// @brief to_string_radix, left-padded with copies of `pad` to `min_width` characters, sign included. A `0`
    /// pad goes after the sign. `pad` must be one scalar value.
    export let format = func(v: uint32, radix: int, min_width: int, pad: string) -> string =>
        integer_text.pad_number(to_string_radix(v, radix), min_width, pad);

    /// @brief Parses a base-10 integer, returning an error for invalid text or a value outside the type's
    /// range.
    #NoDiscard
    export let parse = func(text: string) -> Result<uint32> => parse_radix(text, 10);

    /// @brief An optional `+` or `-`, then one or more digits of the radix in either case.
    ///
    /// Syntax errors are reported first (Empty, UnexpectedEnd at the end, InvalidCharacter at the offending
    /// byte); a well-formed value outside the type fails with OutOfRange at offset 0. A `-` is accepted only
    /// for zero. A radix outside 2 through 36 traps.
    ///
    /// The neura.integer.parse_u64 kernel parses the text as uint64, and the value is then checked
    /// against the type's range.
    #NoDiscard
    export let parse_radix = func(text: string, radix: int) -> Result<uint32> {
        let [status, offset, value] = integer_kernels.parse_u64(text, radix as int64);
        if (status != kernel_status.Ok) {
            return Result<uint32>.Err(kernel_status.parse_error(status, offset, "uint32"));
        }
        if (value > (Max as uint64)) {
            return Result<uint32>.Err(integer_text.out_of_range("uint32"));
        }
        return Result<uint32>.Ok(value as uint32);
    };

    /// @brief `n` modulo Bits, between 0 and Bits - 1.
    let rotation = func(n: int) -> int {
        last count = n % Bits;
        if (count < 0) {
            return count + Bits;
        }
        return count;
    };
);
