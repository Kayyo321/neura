let.promote cell = import:Std.Core.Cell;
let hash_kernels = import:Std.Internal.Kernels.Hash;

/// @brief Accumulates UTF-8 text (Stdlib.md section 8.2).
///
/// The layout is one built-in uint8 list that always holds valid UTF-8: every append adds whole characters and
/// truncate cuts only at a character boundary.
///
/// The language has no expression for a method's own receiver, so a builder returns itself through a link that
/// its factory fills in. Builders are made with the module function `create`; the constructor takes a token
/// that only this module can name.
/// @see [Std.Core.StringBuilder](https://github.com/Kayyo321/neura/wiki/Stdlib-Core-StringBuilder)
export let StringBuilder = module (
    /// @brief Restricts construction to the module's factories.
    let Seal = enum (Token);

    /// @brief Accumulates mutable UTF-8 bytes and produces immutable string snapshots.
    export let StringBuilder = class (
        /// @brief Stores the current UTF-8 bytes.
        let bytes: uint8[list] = [];
        /// @brief Tracks the builder through a shared cell for bound operations that need its identity.
        let link: Cell<StringBuilder>;

        /// @brief Initializes a builder with the supplied backing bytes and construction token.
        export let init = func(seal: Seal, owner: Cell<StringBuilder>) {
            link = owner;
        };

        /// @brief Appends the bytes of `s` and returns this builder.
        export let append = func(s: string) -> StringBuilder {
            let count = s.byte_length;
            for (let i = 0; i < count; i++) {
                bytes.append(s.byte_at(i));
            }
            return link.value;
        };

        /// @brief Appends the UTF-8 encoding of a Unicode scalar value. Traps for a surrogate or a value above
        /// 0x10FFFF.
        export let append_scalar = func(scalar: uint32) -> StringBuilder {
            if (scalar < 128) {
                bytes.append(scalar as uint8);
            } else if (scalar < 2048) {
                bytes.append((192 | (scalar >> 6)) as uint8);
                bytes.append((128 | (scalar & 63)) as uint8);
            } else if (scalar < 65536) {
                if (scalar >= 55296 && scalar <= 57343) {
                    trap_with_message("invalid argument: not a Unicode scalar value");
                }
                bytes.append((224 | (scalar >> 12)) as uint8);
                bytes.append((128 | ((scalar >> 6) & 63)) as uint8);
                bytes.append((128 | (scalar & 63)) as uint8);
            } else {
                if (scalar > 1114111) {
                    trap_with_message("invalid argument: not a Unicode scalar value");
                }
                bytes.append((240 | (scalar >> 18)) as uint8);
                bytes.append((128 | ((scalar >> 12) & 63)) as uint8);
                bytes.append((128 | ((scalar >> 6) & 63)) as uint8);
                bytes.append((128 | (scalar & 63)) as uint8);
            }
            return link.value;
        };

        /// @brief Appends `s` and one LF.
        export let append_line = func(s: string) -> StringBuilder {
            append(s);
            bytes.append(10);
            return link.value;
        };

        /// @brief Appends `count` copies of `s`. A negative count traps.
        export let append_repeated = func(s: string, count: int) -> StringBuilder {
            if (count < 0) {
                trap_with_message("invalid argument: negative count");
            }
            for (let i = 0; i < count; i++) {
                append(s);
            }
            return link.value;
        };

        /// @brief The scalar appends use the built-in decimal and float text (Stdlib.md sections 5.2 and 7.5).
        export let append_int = func(v: int64) -> StringBuilder => append(v.to_string());

        /// @brief Appends the decimal text of an unsigned integer.
        export let append_uint = func(v: uint64) -> StringBuilder => append(v.to_string());

        /// @brief Appends the primitive text representation of a floating-point value.
        export let append_float = func(v: float64) -> StringBuilder => append(v.to_string());

        /// @brief Appends lowercase Boolean text.
        export let append_bool = func(v: bool) -> StringBuilder {
            if (v) {
                return append("true");
            }
            return append("false");
        };

        /// @brief Appends `value.to_string()`.
        export let append_value = func<T>(value: T) -> StringBuilder => append(value.to_string());

        /// @brief Returns the number of accumulated UTF-8 bytes.
        export let byte_length = func -> int => bytes.length;

        /// @brief Reports whether there are any accumulated bytes.
        export let is_empty = func -> bool => bytes.length == 0;

        /// @brief Keeps the first `new_length` bytes. The length must be between 0 and the current byte length
        /// and fall on a character boundary.
        export let truncate = func(new_length: int) {
            let length = bytes.length;
            if (new_length < 0 || new_length > length) {
                trap_with_message("invalid argument: byte length out of range");
            }
            if (new_length == length) {
                return;
            }
            if ((bytes[new_length] & 192) == 128) {
                trap_with_message("invalid argument: not a character boundary");
            }
            if (new_length < length - new_length) {
                bytes = copy_prefix(new_length);
                return;
            }
            for (let last = length - 1; last >= new_length; last--) {
                bytes.remove_at(last);
            }
        };

        /// @brief Removes all accumulated bytes.
        export let clear = func {
            bytes = [];
        };

        /// @brief The current UTF-8 bytes determine equality and hashing.
        export let.override equals = func(other: class) -> bool {
            if (!(other is StringBuilder)) {
                return false;
            }
            let builder = other as StringBuilder;
            return bytes === builder.bytes;
        };

        /// @brief Hashes the current text contents.
        export let.override hash_code = func -> uint32 => hash_kernels.list_u8(bytes);

        /// @brief The accumulated text. The builder stays usable.
        export let.override to_string = func -> string {
            let [valid, text] = string.from_utf8(bytes);
            if (!valid) {
                trap_with_message("invalid state: string builder holds invalid UTF-8");
            }
            return text;
        };

        /// @brief Copies the requested prefix of the backing bytes.
        let copy_prefix = func(count: int) -> uint8[list] {
            let kept: uint8[list] = [];
            for (let i = 0; i < count; i++) {
                kept.append(bytes[i]);
            }
            return kept;
        };
    );

    /// @brief A new, empty builder.
    export let create = func -> StringBuilder {
        let owner = cell.of<StringBuilder>(nil);
        let builder = new StringBuilder(Seal.Token, owner);
        owner.value = builder;
        return builder;
    };
);
