    /// @brief The first and last code points of each block, four digits each, in declaration order from
    /// the first block after NoBlock.
    const Bounds: string = "0000001o0020003o0040005o0060009?009@00:_00:`00;o00<000=_00=`00?o00@000Co00D000D_00D`00F?00F@00Go00H000Ko00L000M?00M@00Mo00N000No00O000Oo00P000Po00Q000QO00QP00Q_00Q`00RO00RP00So00T000Uo00V000Wo00X000Yo00Z000[o00\\000]o00^000_o00`000ao00b000co00d000eo00f000go00h000io00j000ko00l000oo0100012O012P013o0140017o018001=o01>001>O01>P01?o01@001Io01J001JO01JP01Ko01L001LO01LP01Lo01M001MO01MP01Mo01N001Oo01P001R_01R`01So01T001U?01U@01Uo01V001WO01WP01Wo01X001XO01XP01Z_01Z`01[o01\\001]o01^001^o01_001_o01`001a?01a@01ao01b001b?01b@01bo01c001c?01c@01co01d001eo01f001fo01g001go01h001ko01l001oo0200021_021`022O022P023?023@023o0240025?025@026?026@027o028002;o02<002?o02@002@o02A002AO02AP02Co02D002Eo02F002FO02FP02Go02H002Ko02L002No02O002O_02O`02Oo02P002So02T002Uo02V002Wo02X002[o02\\002_o02`002aO02aP02ao02b002co02d002d_02d`02eo02f002gO02gP02go02h002io02j002ko02l002oO02o`02oo0300030o0310032O032P033o0340034_034`036?036@036O036P036o0370037_037`037o038003;o03<003?o03@004fo04g004go04h009oo0:000:B?0:B@0:C?0:C@0:Co0:D00:Ho0:I00:JO0:JP0:Ko0:L00:LO0:LP0:Oo0:P00:P_0:P`0:Po0:Q00:Qo0:R00:SO0:SP0:So0:T00:T_0:T`0:UO0:UP0:Uo0:V00:WO0:WP0:Wo0:X00:YO0:YP0:Yo0:Z00:[O0:[P0:[o0:\\00:\\_0:\\`0:]_0:]`0:^o0:_00:_o0:`00=N_0=N`0=Oo0=P00=]o0=^00=_o0=`00=oo0>000?So0?T00?[o0?\\00?]?0?]@0?go0?h00?h?0?h@0?hO0?hP0?h_0?h`0?i?0?i@0?i_0?i`0?ko0?l00?o_0?o`0?oo0@000@1o0@200@3o0@400@4o0@500@6?0@6@0@7?0@7@0@7o0@:00@:O0@:P0@;O0@;P0@;o0@<00@<_0@<`0@=?0@=@0@=o0@>00@>O0@>P0@?O0@@00@A?0@A@0@Ao0@B00@B_0@B`0@Co0@D00@D_0@D`0@E_0@E`0@Fo0@G00@Go0@H00@Mo0@N00@No0@P00@Po0@Q00@QO0@QP0@Qo0@R00@R_0@SP0@So0@T00@TO0@TP0@To0@U00@UO0@V00@VO0@VP0@Wo0@X00@YO0@YP0@Yo0@Z00@ZO0@[00@[o0@\\00@\\o0@]00@]O0@]P0@]o0@^00@^_0@`00@a?0@b00@co0@d00@do0@e00@f?0@iP0@io0@j00@jo0@k00@ko0@l00@l_0@l`0@m_0@m`0@n_0@n`0@oO0@oP0@oo0A000A1o0A200A3?0A3@0A3o0A400A5?0A5@0A5o0A600A7O0A7P0A7o0A800A9?0A:00A:_0A:`0A;o0A<00A=o0A>00A?o0A@00AAo0AB00ACO0AF00AGo0AH00AIO0AIP0AIo0AJ00AK?0AK@0AKo0AL00AM?0AP00AQ?0ARP0ASo0AT00AUO0AVP0AWo0AX00AY?0AY@0AZ_0AZ`0AZo0A[00A[o0A\\00A]O0A]P0A]o0A_00A_o0A`00Aa_0Aa`0Abo0Ad00AeO0AeP0Af_0Af`0Ag_0AkP0Ako0Al00AmO0An`0Ano0Ao00Aoo0B000B?o0B@00BAo0BB00BE?0Bn@0Boo0C000C@_0C@`0CAO0CAP0D?o0D@00DIo0F400F4o0FP00FXo0FY00FY_0FY`0F[?0F[@0F[o0F\\00F^?0Fe00Feo0Fi00FjO0FjP0FkO0Fl00FnO0FoP0Foo0G000HOo0HP00H[o0H\\00Hco0Hd00Heo0Hf00Hgo0Jo`0Joo0K000K3o0K400K4_0K4`0K5_0K5`0K;o0K`00KbO0KbP0Kb_0L`00Ljo0Lk00Lko0Ll00Lo?0M000M3o0M400M7o0M800M9?0M;00M;O0M;P0M;o0M<00M=O0M=P0M=o0M@00MOo0MP00MZ_0Ml00Moo0N000N0_0N0`0N2?0N400N5?0N:@0N:o0N;00N;o0NC@0NCo0NG@0NGo0NK00NKo0NOP0NOo0NP00NSO0NT00NUO0Na`0Nbo0Nd00Ne?0Nh00Nko0O000O0_0O0`0O2O0O2P0O3o0O400O7o0O800O;o0O<00OGo0OH00OI?0OI@0OIo0OJ00OKo0OL00OMo0ON00OOo0OP00OSo0OT00OWo0OX00OY_0OY`0O[o0O\\00O_o0P000ZKO0ZL00[Lo0[M00[PO0[PP0\\j_0\\j`0^__0^_`0^iO0_P00_XO0`000a=?0a=@0b>_0b>`0cAo3P003P1o3P403P7_3`003ooo40004?oo";

    /// @brief The block of a code point; NoBlock outside every block and above 0x10FFFF.
    #[Pure, ThreadSafe]
    export let of = func(code_point: uint32) -> UnicodeBlock =>
        variant(code_point > 1114111 ? 0 : lookup.range_value(Table, code_point));

    /// @brief The name in Blocks.txt, such as `Latin-1 Supplement`; `No_Block` for NoBlock.
    #[Pure, ThreadSafe]
    export let name = func(block: UnicodeBlock) -> string =>
        lookup.entry(BlockNames, BlockNamesOffsets, block as int);

    /// @brief The first code point of the block. Traps with "invalid argument: NoBlock has no range" for
    /// NoBlock.
    #[Pure, ThreadSafe]
    export let first = func(block: UnicodeBlock) -> uint32 {
        check_block(block);
        return lookup.word(Bounds, ((block as int) - 1) * 8, 4) as uint32;
    };

    /// @brief The last code point of the block. Traps as `first` does for NoBlock.
    #[Pure, ThreadSafe]
    export let last = func(block: UnicodeBlock) -> uint32 {
        check_block(block);
        return lookup.word(Bounds, ((block as int) - 1) * 8 + 4, 4) as uint32;
    };

    /// @brief Traps for NoBlock.
    #Pure
    let check_block = func(block: UnicodeBlock) {
        if (block == UnicodeBlock.NoBlock) {
            trap_with_message("invalid argument: NoBlock has no range");
        }
    };

    /// @brief The UnicodeBlock with this name, compared with UAX #44 loose matching: ASCII case, spaces,
    /// underscores, and hyphens are ignored. None for any other name.
    #[Pure, ThreadSafe]
    export let for_name = func(text: string) -> Optional<UnicodeBlock> {
        last index = lookup.find_loose(LooseNames, LooseOffsets, text);
        return index < 0 ? Optional<UnicodeBlock>.None
            : Optional<UnicodeBlock>.Some(variant(lookup.word(LooseVariants, index * 2, 2) as int));
    };

    /// @brief Every variant in declaration order.
    #[Pure, ThreadSafe]
    export let all = func() -> UnicodeBlock[list] {
        last result: UnicodeBlock[list] = new;
        for (let index in 0 .. 347) {
            result.append(variant(index));
        }
        return result;
    };

    /// @brief The variant with a declaration ordinal.
    #Pure
    let variant = func(index: int) -> UnicodeBlock {
        if (index < 173) {
            if (index < 86) {
                if (index < 43) {
                    if (index < 21) {
                        if (index < 10) {
                            if (index < 5) {
                                if (index < 2) {
                                    if (index < 1) {
                                        return UnicodeBlock.NoBlock;
                                    }
                                    return UnicodeBlock.BasicLatin;
                                }
                                if (index < 3) {
                                    return UnicodeBlock.Latin1Supplement;
                                }
                                if (index < 4) {
                                    return UnicodeBlock.LatinExtendedA;
                                }
                                return UnicodeBlock.LatinExtendedB;
                            }
                            if (index < 7) {
                                if (index < 6) {
                                    return UnicodeBlock.IpaExtensions;
                                }
                                return UnicodeBlock.SpacingModifierLetters;
                            }
                            if (index < 8) {
                                return UnicodeBlock.CombiningDiacriticalMarks;
                            }
                            return if (index < 9) -> UnicodeBlock.GreekAndCoptic else -> UnicodeBlock.Cyrillic;
                        }
                        if (index < 15) {
                            if (index < 12) {
                                if (index < 11) {
                                    return UnicodeBlock.CyrillicSupplement;
                                }
                                return UnicodeBlock.Armenian;
                            }
                            if (index < 13) {
                                return UnicodeBlock.Hebrew;
                            }
                            return if (index < 14) -> UnicodeBlock.Arabic else -> UnicodeBlock.Syriac;
                        }
                        if (index < 18) {
                            if (index < 16) {
                                return UnicodeBlock.ArabicSupplement;
                            }
                            return if (index < 17) -> UnicodeBlock.Thaana else -> UnicodeBlock.NKo;
                        }
                        if (index < 19) {
                            return UnicodeBlock.Samaritan;
                        }
                        return if (index < 20) -> UnicodeBlock.Mandaic else -> UnicodeBlock.SyriacSupplement;
                    }
                    if (index < 32) {
                        if (index < 26) {
                            if (index < 23) {
                                if (index < 22) {
                                    return UnicodeBlock.ArabicExtendedB;
                                }
                                return UnicodeBlock.ArabicExtendedA;
                            }
                            if (index < 24) {
                                return UnicodeBlock.Devanagari;
                            }
                            return if (index < 25) -> UnicodeBlock.Bengali else -> UnicodeBlock.Gurmukhi;
                        }
                        if (index < 29) {
                            if (index < 27) {
                                return UnicodeBlock.Gujarati;
                            }
                            return if (index < 28) -> UnicodeBlock.Oriya else -> UnicodeBlock.Tamil;
                        }
                        if (index < 30) {
                            return UnicodeBlock.Telugu;
                        }
                        return if (index < 31) -> UnicodeBlock.Kannada else -> UnicodeBlock.Malayalam;
                    }
                    if (index < 37) {
                        if (index < 34) {
                            return if (index < 33) -> UnicodeBlock.Sinhala else -> UnicodeBlock.Thai;
                        }
                        if (index < 35) {
                            return UnicodeBlock.Lao;
                        }
                        return if (index < 36) -> UnicodeBlock.Tibetan else -> UnicodeBlock.Myanmar;
                    }
                    if (index < 40) {
                        if (index < 38) {
                            return UnicodeBlock.Georgian;
                        }
                        return if (index < 39) -> UnicodeBlock.HangulJamo else -> UnicodeBlock.Ethiopic;
                    }
                    if (index < 41) {
                        return UnicodeBlock.EthiopicSupplement;
                    }
                    if (index < 42) {
                        return UnicodeBlock.Cherokee;
                    }
                    return UnicodeBlock.UnifiedCanadianAboriginalSyllabics;
                }
                if (index < 64) {
                    if (index < 53) {
                        if (index < 48) {
                            if (index < 45) {
                                return if (index < 44) -> UnicodeBlock.Ogham else -> UnicodeBlock.Runic;
                            }
                            if (index < 46) {
                                return UnicodeBlock.Tagalog;
                            }
                            return if (index < 47) -> UnicodeBlock.Hanunoo else -> UnicodeBlock.Buhid;
                        }
                        if (index < 50) {
                            return if (index < 49) -> UnicodeBlock.Tagbanwa else -> UnicodeBlock.Khmer;
                        }
                        if (index < 51) {
                            return UnicodeBlock.Mongolian;
                        }
                        if (index < 52) {
                            return UnicodeBlock.UnifiedCanadianAboriginalSyllabicsExtended;
                        }
                        return UnicodeBlock.Limbu;
                    }
                    if (index < 58) {
                        if (index < 55) {
                            return if (index < 54) -> UnicodeBlock.TaiLe else -> UnicodeBlock.NewTaiLue;
                        }
                        if (index < 56) {
                            return UnicodeBlock.KhmerSymbols;
                        }
                        return if (index < 57) -> UnicodeBlock.Buginese else -> UnicodeBlock.TaiTham;
                    }
                    if (index < 61) {
                        if (index < 59) {
                            return UnicodeBlock.CombiningDiacriticalMarksExtended;
                        }
                        return if (index < 60) -> UnicodeBlock.Balinese else -> UnicodeBlock.Sundanese;
                    }
                    if (index < 62) {
                        return UnicodeBlock.Batak;
                    }
                    return if (index < 63) -> UnicodeBlock.Lepcha else -> UnicodeBlock.OlChiki;
                }
                if (index < 75) {
                    if (index < 69) {
                        if (index < 66) {
                            if (index < 65) {
                                return UnicodeBlock.CyrillicExtendedC;
                            }
                            return UnicodeBlock.GeorgianExtended;
                        }
                        if (index < 67) {
                            return UnicodeBlock.SundaneseSupplement;
                        }
                        if (index < 68) {
                            return UnicodeBlock.VedicExtensions;
                        }
                        return UnicodeBlock.PhoneticExtensions;
                    }
                    if (index < 72) {
                        if (index < 70) {
                            return UnicodeBlock.PhoneticExtensionsSupplement;
                        }
                        if (index < 71) {
                            return UnicodeBlock.CombiningDiacriticalMarksSupplement;
                        }
                        return UnicodeBlock.LatinExtendedAdditional;
                    }
                    if (index < 73) {
                        return UnicodeBlock.GreekExtended;
                    }
                    if (index < 74) {
                        return UnicodeBlock.GeneralPunctuation;
                    }
                    return UnicodeBlock.SuperscriptsAndSubscripts;
                }
                if (index < 80) {
                    if (index < 77) {
                        if (index < 76) {
                            return UnicodeBlock.CurrencySymbols;
                        }
                        return UnicodeBlock.CombiningDiacriticalMarksForSymbols;
                    }
                    if (index < 78) {
                        return UnicodeBlock.LetterlikeSymbols;
                    }
                    return if (index < 79) -> UnicodeBlock.NumberForms else -> UnicodeBlock.Arrows;
                }
                if (index < 83) {
                    if (index < 81) {
                        return UnicodeBlock.MathematicalOperators;
                    }
                    if (index < 82) {
                        return UnicodeBlock.MiscellaneousTechnical;
                    }
                    return UnicodeBlock.ControlPictures;
                }
                if (index < 84) {
                    return UnicodeBlock.OpticalCharacterRecognition;
                }
                return if (index < 85) -> UnicodeBlock.EnclosedAlphanumerics else -> UnicodeBlock.BoxDrawing;
            }
            if (index < 129) {
                if (index < 107) {
                    if (index < 96) {
                        if (index < 91) {
                            if (index < 88) {
                                if (index < 87) {
                                    return UnicodeBlock.BlockElements;
                                }
                                return UnicodeBlock.GeometricShapes;
                            }
                            if (index < 89) {
                                return UnicodeBlock.MiscellaneousSymbols;
                            }
                            if (index < 90) {
                                return UnicodeBlock.Dingbats;
                            }
                            return UnicodeBlock.MiscellaneousMathematicalSymbolsA;
                        }
                        if (index < 93) {
                            if (index < 92) {
                                return UnicodeBlock.SupplementalArrowsA;
                            }
                            return UnicodeBlock.BraillePatterns;
                        }
                        if (index < 94) {
                            return UnicodeBlock.SupplementalArrowsB;
                        }
                        if (index < 95) {
                            return UnicodeBlock.MiscellaneousMathematicalSymbolsB;
                        }
                        return UnicodeBlock.SupplementalMathematicalOperators;
                    }
                    if (index < 101) {
                        if (index < 98) {
                            if (index < 97) {
                                return UnicodeBlock.MiscellaneousSymbolsAndArrows;
                            }
                            return UnicodeBlock.Glagolitic;
                        }
                        if (index < 99) {
                            return UnicodeBlock.LatinExtendedC;
                        }
                        return if (index < 100) -> UnicodeBlock.Coptic else -> UnicodeBlock.GeorgianSupplement;
                    }
                    if (index < 104) {
                        if (index < 102) {
                            return UnicodeBlock.Tifinagh;
                        }
                        if (index < 103) {
                            return UnicodeBlock.EthiopicExtended;
                        }
                        return UnicodeBlock.CyrillicExtendedA;
                    }
                    if (index < 105) {
                        return UnicodeBlock.SupplementalPunctuation;
                    }
                    if (index < 106) {
                        return UnicodeBlock.CjkRadicalsSupplement;
                    }
                    return UnicodeBlock.KangxiRadicals;
                }
                if (index < 118) {
                    if (index < 112) {
                        if (index < 109) {
                            if (index < 108) {
                                return UnicodeBlock.IdeographicDescriptionCharacters;
                            }
                            return UnicodeBlock.CjkSymbolsAndPunctuation;
                        }
                        if (index < 110) {
                            return UnicodeBlock.Hiragana;
                        }
                        return if (index < 111) -> UnicodeBlock.Katakana else -> UnicodeBlock.Bopomofo;
                    }
                    if (index < 115) {
                        if (index < 113) {
                            return UnicodeBlock.HangulCompatibilityJamo;
                        }
                        return if (index < 114) -> UnicodeBlock.Kanbun else -> UnicodeBlock.BopomofoExtended;
                    }
                    if (index < 116) {
                        return UnicodeBlock.CjkStrokes;
                    }
                    if (index < 117) {
                        return UnicodeBlock.KatakanaPhoneticExtensions;
                    }
                    return UnicodeBlock.EnclosedCjkLettersAndMonths;
                }
                if (index < 123) {
                    if (index < 120) {
                        if (index < 119) {
                            return UnicodeBlock.CjkCompatibility;
                        }
                        return UnicodeBlock.CjkUnifiedIdeographsExtensionA;
                    }
                    if (index < 121) {
                        return UnicodeBlock.YijingHexagramSymbols;
                    }
                    if (index < 122) {
                        return UnicodeBlock.CjkUnifiedIdeographs;
                    }
                    return UnicodeBlock.YiSyllables;
                }
                if (index < 126) {
                    if (index < 124) {
                        return UnicodeBlock.YiRadicals;
                    }
                    return if (index < 125) -> UnicodeBlock.Lisu else -> UnicodeBlock.Vai;
                }
                if (index < 127) {
                    return UnicodeBlock.CyrillicExtendedB;
                }
                return if (index < 128) -> UnicodeBlock.Bamum else -> UnicodeBlock.ModifierToneLetters;
            }
            if (index < 151) {
                if (index < 140) {
                    if (index < 134) {
                        if (index < 131) {
                            if (index < 130) {
                                return UnicodeBlock.LatinExtendedD;
                            }
