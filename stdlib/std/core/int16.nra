let integer_kernels = import:Std.Internal.Kernels.IntegerText;
let integer_text = import:Std.Core.Internal.IntegerText;
let kernel_status = import:Std.Core.Internal.KernelStatus;
let.promote _ = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Ordering;
let.promote _ = import:Std.Core.Result;
let unsigned = import:Std.Core.UInt16;

/// @brief Companion functions for int16 (Stdlib.md section 7.1).
///
/// Every operation uses checked arithmetic; the wrapping forms follow the recipes of section 7.2, so no
/// intermediate value leaves its type.
/// @see [Std.Core.Int16](https://github.com/Kayyo321/neura/wiki/Stdlib-Core-Int16)
#Since("0.1.0")
export let Int16 = module (
    /// @brief The smallest value representable by this integer type.
    export const Min: int16 = -32768;
    /// @brief The largest value representable by this integer type.
    export const Max: int16 = 32767;
    /// @brief The number of bits in the integer representation.
    export const Bits: int = 16;

    /// @brief Traps (reason 1) for Min, from the negation.
    export let abs = func(v: int16) -> int16 => v < 0 ? -v : v;

    /// @brief Returns minus one, zero, or one according to the sign of the value.
    export let sign = func(v: int16) -> int {
        if (v < 0) {
            return -1;
        }
        if (v > 0) {
            return 1;
        }
        return 0;
    };

    /// @brief Returns the smaller of the two operands.
    export let min = func(a: int16, b: int16) -> int16 => b < a ? b : a;

    /// @brief Returns the larger of the two operands.
    export let max = func(a: int16, b: int16) -> int16 => b > a ? b : a;

    /// @brief Traps with "invalid argument: low exceeds high".
    export let clamp = func(v: int16, low: int16, high: int16) -> int16 {
        if (low > high) {
            trap_with_message("invalid argument: low exceeds high");
        }
        if (v < low) {
            return low;
        }
        if (v > high) {
            return high;
        }
        return v;
    };

    /// @brief The natural order; usable as a comparator.
    export let compare = func(a: int16, b: int16) -> Ordering {
        if (a < b) {
            return Ordering.Less;
        }
        if (a > b) {
            return Ordering.Greater;
        }
        return Ordering.Equal;
    };

    /// @brief Square-and-multiply with checked multiplication (an overflow traps with reason 1).
    ///
    /// The factor is squared only while exponent bits remain, so each intermediate divides the result. A
    /// negative exponent traps; pow(0, 0) is 1.
    export let pow = func(base: int16, exponent: int) -> int16 {
        if (exponent < 0) {
            trap_with_message("invalid argument: negative exponent");
        }
        let product: int16 = 1;
        let factor = base;
        let remaining = exponent;
        while (remaining > 0) {
            if ((remaining & 1) == 1) {
                product *= factor;
            }
            remaining >>= 1;
            if (remaining > 0) {
                factor *= factor;
            }
        }
        return product;
    };

    /// @brief Euclid's algorithm in the negative range, where every magnitude fits. gcd(0, 0) is 0. Traps
    /// (reason 1) when the result, 2^(Bits - 1), does not fit.
    export let gcd = func(a: int16, b: int16) -> int16 {
        let x = a;
        if (x > 0) {
            x = -x;
        }
        let y = b;
        if (y > 0) {
            y = -y;
        }
        while (y != 0) {
            last remainder = x % y;
            x = y;
            y = remainder;
        }
        return -x;
    };

    /// @brief None where the operator would trap. Each test runs before the operation, so nothing overflows.
    #NoDiscard
    export let checked_add = func(a: int16, b: int16) -> Optional<int16> {
        if ((b > 0 && a > Max - b) || (b < 0 && a < Min - b)) {
            return Optional<int16>.None;
        }
        return Optional<int16>.Some(a + b);
    };

    /// @brief Returns the difference in Some, or None when it falls outside the type's range.
    #NoDiscard
    export let checked_sub = func(a: int16, b: int16) -> Optional<int16> {
        if ((b < 0 && a > Max + b) || (b > 0 && a < Min + b)) {
            return Optional<int16>.None;
        }
        return Optional<int16>.Some(a - b);
    };

    /// @brief Returns the product in Some, or None when it falls outside the type's range.
    #NoDiscard
    export let checked_mul = func(a: int16, b: int16) -> Optional<int16> {
        if (multiply_overflows(a, b)) {
            return Optional<int16>.None;
        }
        return Optional<int16>.Some(a * b);
    };

    /// @brief None for a zero divisor and for Min / -1.
    #NoDiscard
    export let checked_div = func(a: int16, b: int16) -> Optional<int16> {
        if (b == 0 || (a == Min && b == -1)) {
            return Optional<int16>.None;
        }
        return Optional<int16>.Some(a / b);
    };

    /// @brief None for a zero divisor. Min % -1 is 0, as for the operator.
    #NoDiscard
    export let checked_rem = func(a: int16, b: int16) -> Optional<int16> {
        if (b == 0) {
            return Optional<int16>.None;
        }
        return Optional<int16>.Some(a % b);
    };

    /// @brief The result modulo 2^Bits: the operation runs on the unsigned pattern and converts back (section
    /// 7.2).
    export let wrapping_add = func(a: int16, b: int16) -> int16 =>
        unsigned.to_signed(unsigned.wrapping_add(to_unsigned(a), to_unsigned(b)));

    /// @brief Subtracts modulo two raised to the type's bit width.
    export let wrapping_sub = func(a: int16, b: int16) -> int16 =>
        unsigned.to_signed(unsigned.wrapping_sub(to_unsigned(a), to_unsigned(b)));

    /// @brief Multiplies modulo two raised to the type's bit width.
    export let wrapping_mul = func(a: int16, b: int16) -> int16 =>
        unsigned.to_signed(unsigned.wrapping_mul(to_unsigned(a), to_unsigned(b)));

    /// @brief Min wraps to itself.
    export let wrapping_neg = func(a: int16) -> int16 =>
        unsigned.to_signed(unsigned.wrapping_neg(to_unsigned(a)));

    /// @brief Clamp to Min or Max instead of overflowing.
    export let saturating_add = func(a: int16, b: int16) -> int16 {
        if (b > 0 && a > Max - b) {
            return Max;
        }
        if (b < 0 && a < Min - b) {
            return Min;
        }
        return a + b;
    };

    /// @brief Subtracts and clamps an out-of-range result to the nearest representable bound.
    export let saturating_sub = func(a: int16, b: int16) -> int16 {
        if (b < 0 && a > Max + b) {
            return Max;
        }
        if (b > 0 && a < Min + b) {
            return Min;
        }
        return a - b;
    };

    /// @brief Multiplies and clamps an out-of-range result to the nearest representable bound.
    export let saturating_mul = func(a: int16, b: int16) -> int16 {
        if (multiply_overflows(a, b)) {
            if ((a < 0) != (b < 0)) {
                return Min;
            }
            return Max;
        }
        return a * b;
    };

    /// @brief The quotient rounded toward negative infinity. A zero divisor and Min / -1 trap (reason 1) in the
    /// division.
    export let floor_div = func(a: int16, b: int16) -> int16 {
        last quotient = a / b;
        if (a % b != 0 && (a < 0) != (b < 0)) {
            return quotient - 1;
        }
        return quotient;
    };

    /// @brief The remainder with the divisor's sign. A zero divisor traps (reason 1).
    export let floor_mod = func(a: int16, b: int16) -> int16 {
        last remainder = a % b;
        if (remainder != 0 && (remainder < 0) != (b < 0)) {
            return remainder + b;
        }
        return remainder;
    };

    /// @brief Bit counts and rotations over the two's complement pattern.
    export let count_ones = func(v: int16) -> int => unsigned.count_ones(to_unsigned(v));

    /// @brief Counts zero bits from the most significant end. Zero returns the full bit width.
    export let leading_zeros = func(v: int16) -> int => unsigned.leading_zeros(to_unsigned(v));

    /// @brief Counts zero bits from the least significant end. Zero returns the full bit width.
    export let trailing_zeros = func(v: int16) -> int => unsigned.trailing_zeros(to_unsigned(v));

    /// @brief Rotates the bits left, reducing the distance modulo the bit width.
    export let rotate_left = func(v: int16, n: int) -> int16 =>
        unsigned.to_signed(unsigned.rotate_left(to_unsigned(v), n));

    /// @brief Rotates the bits right, reducing the distance modulo the bit width.
    export let rotate_right = func(v: int16, n: int) -> int16 =>
        unsigned.to_signed(unsigned.rotate_right(to_unsigned(v), n));

    /// @brief The same-width unsigned type with the same bit pattern (section 7.2).
    export let to_unsigned = func(v: int16) -> uint16 {
        if (v >= 0) {
            return v as uint16;
        }
        // A negative value is at least -2^15, so v + 2^16 is
        // between 2^15 and 2^16 - 1.
        return ((v as int64) + 65536) as uint16;
    };

    /// @brief The identity: every integer module has both conversions.
    export let to_signed = func(v: int16) -> int16 => v;

    /// @brief Section 5.2: the two's complement pattern as a uint32; the 64-bit types fold the high half into
    /// the low half.
    export let hash = func(v: int16) -> uint32 => v.hash_code();

    /// @brief Decimal, with `-` for negative values (section 5.2).
    export let to_string = func(v: int16) -> string => v.to_string();

    /// @brief Lowercase digits, with `-` for a negative value. A radix outside 2 through 36 traps. The
    /// neura.integer.format_i64 kernel writes the digits.
    export let to_string_radix = func(v: int16, radix: int) -> string =>
        integer_kernels.format_i64(v as int64, radix as int64);

    /// @brief to_string_radix, left-padded with copies of `pad` to `min_width` characters, sign included. A `0`
    /// pad goes after the sign. `pad` must be one scalar value.
    export let format = func(v: int16, radix: int, min_width: int, pad: string) -> string =>
        integer_text.pad_number(to_string_radix(v, radix), min_width, pad);

    /// @brief Parses a base-10 integer, returning an error for invalid text or a value outside the type's
    /// range.
    #NoDiscard
    export let parse = func(text: string) -> Result<int16> => parse_radix(text, 10);

    /// @brief An optional `+` or `-`, then one or more digits of the radix in either case.
    ///
    /// Syntax errors are reported first (Empty, UnexpectedEnd at the end, InvalidCharacter at the offending
    /// byte); a well-formed value outside the type fails with OutOfRange at offset 0. A radix outside 2
    /// through 36 traps.
    ///
    /// The neura.integer.parse_i64 kernel parses the text as int64, and the value is then checked
    /// against the type's range.
    #NoDiscard
    export let parse_radix = func(text: string, radix: int) -> Result<int16> {
        let [status, offset, value] = integer_kernels.parse_i64(text, radix as int64);
        if (status != kernel_status.Ok) {
            return Result<int16>.Err(kernel_status.parse_error(status, offset, "int16"));
        }
        if (value < (Min as int64) || value > (Max as int64)) {
            return Result<int16>.Err(integer_text.out_of_range("int16"));
        }
        return Result<int16>.Ok(value as int16);
    };

    /// @brief Whether a * b leaves the type. The int64 product of two values of at most 32 bits cannot
    /// overflow.
    let multiply_overflows = func(a: int16, b: int16) -> bool {
        last product = (a as int64) * (b as int64);
        return product < (Min as int64) || product > (Max as int64);
    };
);
