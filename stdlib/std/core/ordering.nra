/// @brief Comparison results (Stdlib.md section 5.3). Comparators return Ordering, never an integer, so the
/// overflowing subtraction idiom cannot be written.
/// @see [Std.Core.Ordering](https://github.com/Kayyo321/neura/wiki/Stdlib-Core-Ordering)
export let Ordering = module (
    /// @brief The three outcomes of comparing a left operand to a right operand.
    export let Ordering = enum (Less, Equal, Greater);

    /// @brief Swaps Less and Greater while preserving Equal.
    export let reverse = func(o: Ordering) -> Ordering {
        if (o == Ordering.Less) {
            return Ordering.Greater;
        }
        if (o == Ordering.Greater) {
            return Ordering.Less;
        }
        return Ordering.Equal;
    };

    /// @brief `first` unless it is Equal, for comparing by several keys.
    export let then = func(first: Ordering, second: Ordering) -> Ordering =>
        first == Ordering.Equal ? second : first;

    /// @brief Tests whether the left operand precedes the right.
    export let is_less = func(o: Ordering) -> bool => o == Ordering.Less;

    /// @brief Tests whether the left operand precedes or equals the right.
    export let is_at_most = func(o: Ordering) -> bool => o != Ordering.Greater;

    /// @brief Tests whether the left operand follows the right.
    export let is_greater = func(o: Ordering) -> bool => o == Ordering.Greater;

    /// @brief Tests whether the left operand follows or equals the right.
    export let is_at_least = func(o: Ordering) -> bool => o != Ordering.Less;
);
