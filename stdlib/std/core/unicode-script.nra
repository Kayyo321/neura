    /// @brief The script of a code point; Unknown for unassigned code points, noncharacters, and values
    /// above 0x10FFFF.
    #[Pure, ThreadSafe]
    export let of = func(code_point: uint32) -> UnicodeScript =>
        variant(code_point > 1114111 ? 167 : lookup.range_value(Table, code_point));

    /// @brief The Unicode long name, such as `Old_Italic`.
    #[Pure, ThreadSafe]
    export let name = func(script: UnicodeScript) -> string =>
        lookup.entry(LongNames, LongNamesOffsets, script as int);

    /// @brief The four-letter ISO 15924 code, such as `Ital`.
    #[Pure, ThreadSafe]
    export let code = func(script: UnicodeScript) -> string =>
        lookup.entry(Codes, CodesOffsets, script as int);

    /// @brief The UnicodeScript with this name, compared with UAX #44 loose matching: ASCII case, spaces,
    /// underscores, and hyphens are ignored. None for any other name.
    #[Pure, ThreadSafe]
    export let for_name = func(text: string) -> Optional<UnicodeScript> {
        last index = lookup.find_loose(LooseNames, LooseOffsets, text);
        return index < 0 ? Optional<UnicodeScript>.None
            : Optional<UnicodeScript>.Some(variant(lookup.word(LooseVariants, index * 2, 2) as int));
    };

    /// @brief Every variant in declaration order.
    #[Pure, ThreadSafe]
    export let all = func() -> UnicodeScript[list] {
        last result: UnicodeScript[list] = new;
        for (let index = 0; index < 175; index += 1) {
            result.append(variant(index));
        }
        return result;
    };

    /// @brief The variant with a declaration ordinal.
    #Pure
    let variant = func(index: int) -> UnicodeScript {
        if (index < 87) {
            if (index < 43) {
                if (index < 21) {
                    if (index < 10) {
                        if (index < 5) {
                            if (index < 2) {
                                if (index < 1) {
                                    return UnicodeScript.Adlam;
                                }
                                return UnicodeScript.Ahom;
                            }
                            if (index < 3) {
                                return UnicodeScript.AnatolianHieroglyphs;
                            }
                            if (index < 4) {
                                return UnicodeScript.Arabic;
                            }
                            return UnicodeScript.Armenian;
                        }
                        if (index < 7) {
                            if (index < 6) {
                                return UnicodeScript.Avestan;
                            }
                            return UnicodeScript.Balinese;
                        }
                        if (index < 8) {
                            return UnicodeScript.Bamum;
                        }
                        if (index < 9) {
                            return UnicodeScript.BassaVah;
                        }
                        return UnicodeScript.Batak;
                    }
                    if (index < 15) {
                        if (index < 12) {
                            if (index < 11) {
                                return UnicodeScript.Bengali;
                            }
                            return UnicodeScript.BeriaErfe;
                        }
                        if (index < 13) {
                            return UnicodeScript.Bhaiksuki;
                        }
                        if (index < 14) {
                            return UnicodeScript.Bopomofo;
                        }
                        return UnicodeScript.Brahmi;
                    }
                    if (index < 18) {
                        if (index < 16) {
                            return UnicodeScript.Braille;
                        }
                        if (index < 17) {
                            return UnicodeScript.Buginese;
                        }
                        return UnicodeScript.Buhid;
                    }
                    if (index < 19) {
                        return UnicodeScript.CanadianAboriginal;
                    }
                    if (index < 20) {
                        return UnicodeScript.Carian;
                    }
                    return UnicodeScript.CaucasianAlbanian;
                }
                if (index < 32) {
                    if (index < 26) {
                        if (index < 23) {
                            if (index < 22) {
                                return UnicodeScript.Chakma;
                            }
                            return UnicodeScript.Cham;
                        }
                        if (index < 24) {
                            return UnicodeScript.Cherokee;
                        }
                        if (index < 25) {
                            return UnicodeScript.Chorasmian;
                        }
                        return UnicodeScript.Common;
                    }
                    if (index < 29) {
                        if (index < 27) {
                            return UnicodeScript.Coptic;
                        }
                        if (index < 28) {
                            return UnicodeScript.Cuneiform;
                        }
                        return UnicodeScript.Cypriot;
                    }
                    if (index < 30) {
                        return UnicodeScript.CyproMinoan;
                    }
                    if (index < 31) {
                        return UnicodeScript.Cyrillic;
                    }
                    return UnicodeScript.Deseret;
                }
