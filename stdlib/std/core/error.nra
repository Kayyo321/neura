let hashing = import:Std.Core.Hash;

/// @brief Returned failures (Stdlib.md section 6.3). An Error is an ordinary value read with match; adding a
/// variant is a major-version change.
/// @see [Std.Core.Error](https://github.com/Kayyo321/neura/wiki/Stdlib-Core-Error)
export let Error = module (
    /// @brief Host error codes 1 through 14 map to the first fourteen kinds in order. The library produces
    /// Closed and InvalidData itself. Host error code 15 maps to Cancelled, the answer of a cancellable host
    /// request (a read, write, accept, connect, or sleep in a task whose scope was cancelled) that was cancelled
    /// before it finished. Cancelled comes last so that the kinds before it keep their order.
    export let IoErrorKind = enum (
        NotFound, PermissionDenied, AlreadyExists, InvalidInput, Interrupted, UnexpectedEnd, NotADirectory,
        IsADirectory, DirectoryNotEmpty, ConnectionRefused, ConnectionReset, TimedOut, Unsupported,
        CapabilityDenied, Closed, InvalidData, Other, Cancelled
    );

    /// @brief Classifies malformed text, premature endings, and out-of-range values.
    export let ParseErrorKind = enum (Empty, InvalidCharacter, OutOfRange, UnexpectedEnd, Syntax);

    /// @brief The base of errors defined outside the library. `code` is a stable identifier such as
    /// billing.card_declined.
    export let ErrorDetail = class (
        /// @brief Returns the detail's application-defined code.
        export let code = func() -> string;
        /// @brief Returns the detail's human-readable message.
        export let message = func() -> string;
    );

    /// @brief Stores a custom error's code and message as strings.
    export let SimpleDetail = class:ErrorDetail (
        /// @brief The application-defined error code.
        let code_text: string;
        /// @brief The human-readable detail.
        let message_text: string;

        /// @brief Initializes both parts of the error detail.
        export let init = func(code_value: string, message_value: string) {
            super.init();
            code_text = code_value;
            message_text = message_value;
        };

        /// @brief Returns the stored error code.
        export let.override code = func -> string => code_text;

        /// @brief Returns the stored detail message.
        export let.override message = func -> string => message_text;

        /// @brief Two simple details are equal when their code and message are.
        export let.override equals = func(other: class) -> bool {
            if (!(other is SimpleDetail)) {
                return false;
            }
            let detail = other as SimpleDetail;
            return code_text == detail.code() && message_text == detail.message();
        };

        /// @brief Combines the hashes of the code and message.
        export let.override hash_code = func -> uint32 =>
            hashing.combine(hashing.combine(17, code_text.hash_code()), message_text.hash_code());

        /// @brief Returns the formatted custom error detail.
        export let.override to_string = func -> string => code_text + ": " + message_text;
    );

    /// @brief Represents an expected failure and its category-specific context.
    export let Error = enum (
        Io { kind: IoErrorKind, message: string, path: string },
        Parse { kind: ParseErrorKind, offset: int, message: string },
        Encoding { offset: int, message: string },
        Custom(ErrorDetail),
        Context { message: string, cause: Error }
    );

    /// @brief A transferable copy of an Error, so that a failure can cross a channel or a spawn
    /// (Concurrency.md section 5.1). It mirrors Error with one change: Custom, which holds an ErrorDetail
    /// object, is flattened to the detail's code and message texts. Convert with to_portable before sending and
    /// from_portable after receiving.
    export let PortableError = enum (
        Io { kind: IoErrorKind, message: string, path: string },
        Parse { kind: ParseErrorKind, offset: int, message: string },
        Encoding { offset: int, message: string },
        Custom { code: string, message: string },
        Context { message: string, cause: PortableError }
    );

    /// @brief A Custom error holding a SimpleDetail.
    export let custom = func(code: string, text: string) -> Error =>
        Error.Custom(new SimpleDetail(code, text));

    /// @brief Wraps an error with a message that describes the operation that failed.
    export let context = func(cause: Error, text: string) -> Error =>
        Error.Context { message: text, cause: cause };

    /// @brief The transferable copy of an error. A Custom error keeps its code and message but loses its
    /// ErrorDetail object, so a subclass's other members are gone; every other variant is copied as it is.
    export let to_portable = func(e: Error) -> PortableError => match (e) {
        Error.Io { kind, message: text, path } => PortableError.Io { kind: kind, message: text, path: path },
        Error.Parse { kind, offset, message: text } =>
            PortableError.Parse { kind: kind, offset: offset, message: text },
        Error.Encoding { offset, message: text } => PortableError.Encoding { offset: offset, message: text },
        Error.Custom(detail) => PortableError.Custom { code: detail.code(), message: detail.message() },
        Error.Context { message: text, cause } =>
            PortableError.Context { message: text, cause: to_portable(cause) },
    };

    /// @brief The error a portable copy stands for. A Custom copy comes back holding a SimpleDetail with the
    /// same code and message, so message(from_portable(to_portable(e))) equals message(e).
    export let from_portable = func(p: PortableError) -> Error => match (p) {
        PortableError.Io { kind, message: text, path } => Error.Io { kind: kind, message: text, path: path },
        PortableError.Parse { kind, offset, message: text } =>
            Error.Parse { kind: kind, offset: offset, message: text },
        PortableError.Encoding { offset, message: text } => Error.Encoding { offset: offset, message: text },
        PortableError.Custom { code, message: text } => custom(code, text),
        PortableError.Context { message: text, cause } =>
            Error.Context { message: text, cause: from_portable(cause) },
    };

    /// @brief Returns the spelling of an I/O error category.
    export let io_kind_name = func(kind: IoErrorKind) -> string => kind.to_string();

    /// @brief Returns the spelling of a parse error category.
    export let parse_kind_name = func(kind: ParseErrorKind) -> string => kind.to_string();

    /// @brief Formats an error with its category and context.
    export let message = func(e: Error) -> string => match (e) {
        Error.Io { kind, message: text, path } => io_text(kind, text, path),
        Error.Parse { kind: _, offset, message: text } => "parse error at " + offset.to_string() + ": " + text,
        Error.Encoding { offset, message: text } => "invalid encoding at " + offset.to_string() + ": " + text,
        Error.Custom(detail) => detail.message(),
        Error.Context { message: text, cause } => text + ": " + message(cause),
    };

    /// @brief Formats an I/O failure with its kind and optional path.
    let io_text = func(kind: IoErrorKind, text: string, path: string) -> string {
        if (path == "") {
            return io_kind_name(kind) + ": " + text;
        }
        return io_kind_name(kind) + ": " + text + " (" + path + ")";
    };

    /// @brief Follows Context causes to the end.
    export let root_cause = func(e: Error) -> Error {
        let current = e;
        do {
            match (current) {
                Error.Context { message: _, cause } => {
                    current = cause;
                },
                _ => {
                    return current;
                },
            }
        }
    };

    /// @brief The error, then each cause in order.
    export let chain = func(e: Error) -> Error[list] {
        let result: Error[list] = [];
        let current = e;
        let more = true;
        while (more) {
            result.append(current);
            match (current) {
                Error.Context { message: _, cause } => {
                    current = cause;
                },
                _ => {
                    more = false;
                },
            }
        }
        return result;
    };

    /// @brief Structural equality. Custom details compare with their equals member.
    export let equals = func(a: Error, b: Error) -> bool {
        match (a) {
            Error.Io { kind, message: text, path } => {
                match (b) {
                    Error.Io { kind: other_kind, message: other_text, path: other_path } => {
                        return kind == other_kind && text == other_text && path == other_path;
                    },
                    _ => { return false; },
                }
            },
            Error.Parse { kind, offset, message: text } => {
                match (b) {
                    Error.Parse { kind: other_kind, offset: other_offset, message: other_text } => {
                        return kind == other_kind && offset == other_offset && text == other_text;
                    },
                    _ => { return false; },
                }
            },
            Error.Encoding { offset, message: text } => {
                match (b) {
                    Error.Encoding { offset: other_offset, message: other_text } => {
                        return offset == other_offset && text == other_text;
                    },
                    _ => { return false; },
                }
            },
            Error.Custom(detail) => {
                match (b) {
                    Error.Custom(other_detail) => { return detail === other_detail; },
                    _ => { return false; },
                }
            },
            Error.Context { message: text, cause } => {
                match (b) {
                    Error.Context { message: other_text, cause: other_cause } => {
                        return text == other_text && equals(cause, other_cause);
                    },
                    _ => { return false; },
                }
            },
        }
    };

    /// @brief Starts from the variant's position and combines each field's hash.
    export let hash = func(e: Error) -> uint32 => match (e) {
        Error.Io { kind, message: text, path } =>
            hashing.combine(hashing.combine(hashing.combine(0, kind.hash_code()), text.hash_code()), path.hash_code()),
        Error.Parse { kind, offset, message: text } =>
            hashing.combine(hashing.combine(hashing.combine(1, kind.hash_code()), offset.hash_code()), text.hash_code()),
        Error.Encoding { offset, message: text } =>
            hashing.combine(hashing.combine(2, offset.hash_code()), text.hash_code()),
        Error.Custom(detail) => hashing.combine(3, detail.hash_code()),
        Error.Context { message: text, cause } =>
            hashing.combine(hashing.combine(4, text.hash_code()), hash(cause)),
    };

    /// @brief The same text as message.
    export let to_string = func(e: Error) -> string => message(e);
);
