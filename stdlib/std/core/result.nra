let.promote error = import:Std.Core.Error;
let hashing = import:Std.Core.Hash;
let.promote _ = import:Std.Core.Optional;

/// @brief The one representation of a fallible outcome (Stdlib.md section 6.2). An operation with no value
/// returns Result<Unit>.
/// @see [Std.Core.Result](https://github.com/Kayyo321/neura/wiki/Stdlib-Core-Result)
export let Result = module (
    /// @brief Represents a successful payload (Ok) or an expected failure (Err).
    export let Result = enum<T> (Ok(T), Err(Error));

    /// @brief Reports whether the result holds a success payload.
    export let is_ok = func<T>(r: Result<T>) -> bool => match (r) {
        Result.Ok(_) => true,
        Result.Err(_) => false,
    };

    /// @brief Reports whether the result holds an error.
    export let is_err = func<T>(r: Result<T>) -> bool => match (r) {
        Result.Ok(_) => false,
        Result.Err(_) => true,
    };

    /// @brief Returns the success payload or the already-evaluated fallback.
    export let value_or = func<T>(r: Result<T>, fallback: T) -> T => match (r) {
        Result.Ok(value) => value,
        Result.Err(_) => fallback,
    };

    /// @brief The value, or a trap whose message is the detail, ": ", and the error's message.
    export let expect = func<T>(r: Result<T>, detail: string) -> T {
        match (r) {
            Result.Ok(value) => {
                return value;
            },
            Result.Err(failure) => {
                trap_with_message(detail + ": " + error.message(failure));
            },
        }
    };

    /// @brief Returns Some for success and discards an error by returning None.
    export let to_optional = func<T>(r: Result<T>) -> Optional<T> => match (r) {
        Result.Ok(value) => Optional<T>.Some(value),
        Result.Err(_) => Optional<T>.None,
    };

    /// @brief Wraps an Err in a Context error; returns an Ok unchanged.
    export let with_context = func<T>(r: Result<T>, message: string) -> Result<T> => match (r) {
        Result.Ok(_) => r,
        Result.Err(failure) => Result<T>.Err(error.context(failure, message)),
    };

    /// @brief Transforms only a successful payload, preserving an error unchanged.
    export let map = func<T, U>(r: Result<T>, f: func(T) -> U) -> Result<U> => match (r) {
        Result.Ok(value) => Result<U>.Ok(f(value)),
        Result.Err(failure) => Result<U>.Err(failure),
    };

    /// @brief Calls the function on success and returns its result, or propagates the original error.
    export let and_then = func<T, U>(r: Result<T>, f: func(T) -> Result<U>) -> Result<U> => match (r) {
        Result.Ok(value) => f(value),
        Result.Err(failure) => Result<U>.Err(failure),
    };

    /// @brief Transforms only the error payload, preserving success unchanged.
    export let map_error = func<T>(r: Result<T>, f: func(Error) -> Error) -> Result<T> => match (r) {
        Result.Ok(_) => r,
        Result.Err(failure) => Result<T>.Err(f(failure)),
    };

    /// @brief Both Ok with equal values, or both Err with structurally equal errors.
    export let equals = func<T>(a: Result<T>, b: Result<T>) -> bool {
        match (a) {
            Result.Ok(value) => {
                return match (b) {
                    Result.Ok(other) => value === other,
                    Result.Err(_) => false,
                };
            },
            Result.Err(failure) => {
                return match (b) {
                    Result.Ok(_) => false,
                    Result.Err(other) => error.equals(failure, other),
                };
            },
        }
    };

    /// @brief Hash.combine(1, the value's hash) for Ok and Hash.combine(2, the error's hash) for Err.
    export let hash = func<T>(r: Result<T>) -> uint32 => match (r) {
        Result.Ok(value) => hashing.combine(1, value.hash_code()),
        Result.Err(failure) => hashing.combine(2, error.hash(failure)),
    };

    /// @brief Formats the success value or the error with its variant name.
    export let to_string = func<T>(r: Result<T>) -> string => match (r) {
        Result.Ok(value) => "Ok(" + value.to_string() + ")",
        Result.Err(failure) => "Err(" + error.message(failure) + ")",
    };
);
