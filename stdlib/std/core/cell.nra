// A mutable box. Closures capture locals by value, so a callback that needs
// to count or accumulate captures a Cell and updates its value.
export let Cell = module (
    export let Cell = class<T> (
        export let value: T;

        export let init = func(initial: T) {
            value = initial;
        };
    );

    export let of = func<T>(value: T) -> Cell<T> => new Cell<T>(value);
);
