let charsets = import:Std.Text.Charsets;
let formatting = import:Std.Io.Internal.Formatting;
let ordering = import:Std.Core.Ordering;
let regex = import:Std.Text.Regex;
let result = import:Std.Core.Result;
let string_builder = import:Std.Core.StringBuilder;
let unicode_case = import:Std.Text.Internal.UnicodeCase;
let unicode_scalars = import:Std.Text.Scalars;
let strings = import:Std.Text.Strings;
let variadic = import:Std.Core.Variadic;

// The primitive companion for immutable UTF-8 text.
export let String = module:strings (
    export let Charset = charsets.Charset;

    export let concat = func(s: string, suffix: string) -> string => s + suffix;

    export let substring = func(s: string, start: int) -> string => s.slice(start, s.byte_length)
        or func(s: string, start: int, end: int) -> string => s.slice(start, end);

    export let sub_sequence = func(s: string, start: int, end: int) -> string => s.slice(start, end);

    export let content_equals = func(s: string, other: string) -> bool => s == other
        or func(s: string, other: string_builder.StringBuilder) -> bool =>
            other != nil && s == other.to_string();

    export let compare_to = func(s: string, other: string) -> int => match (strings.compare(s, other)) {
        ordering.Ordering.Less => -1,
        ordering.Ordering.Equal => 0,
        ordering.Ordering.Greater => 1,
    };

    export let compare_to_ignore_ascii_case = func(s: string, other: string) -> int =>
        compare_to(strings.to_ascii_lower(s), strings.to_ascii_lower(other));

    export let to_lower_case = func(s: string) -> string => unicode_case.lower(s, "")
        or func(s: string, language_tag: string) -> string => unicode_case.lower(s, language_tag);

    export let to_upper_case = func(s: string) -> string => unicode_case.upper(s, "")
        or func(s: string, language_tag: string) -> string => unicode_case.upper(s, language_tag);

    export let compare_to_ignore_case = func(s: string, other: string) -> int =>
        unicode_case.compare_ignore_case(s, other);

    export let equals_ignore_case = func(s: string, other: string) -> bool =>
        compare_to_ignore_case(s, other) == 0;

    export let case_fold = func(s: string) -> string => unicode_case.fold(s);

    export let compare_to_fold_case = func(s: string, other: string) -> int =>
        compare_to(case_fold(s), case_fold(other));

    export let equals_fold_case = func(s: string, other: string) -> bool =>
        s == other || case_fold(s) == case_fold(other);

    export let starts_with_at = func(s: string, prefix: string, offset: int) -> bool =>
        region_matches(s, offset, prefix, 0, prefix.byte_length);

    export let region_matches = func(s: string, start: int, other: string, other_start: int, byte_count: int)
        -> bool {
        if (!valid_region(s, start, byte_count) || !valid_region(other, other_start, byte_count)) {
            return false;
        }
        return s.slice(start, start + byte_count) == other.slice(other_start, other_start + byte_count);
    };

    export let region_matches_ignore_ascii_case =
        func(s: string, start: int, other: string, other_start: int, byte_count: int) -> bool {
            if (!valid_region(s, start, byte_count) || !valid_region(other, other_start, byte_count)) {
                return false;
            }
            return strings.equals_ignore_ascii_case(
                s.slice(start, start + byte_count), other.slice(other_start, other_start + byte_count)
            );
        };

    export let region_matches_ignore_case =
        func(s: string, start: int, other: string, other_start: int, byte_count: int) -> bool {
            if (!valid_region(s, start, byte_count) || !valid_region(other, other_start, byte_count)) {
                return false;
            }
            return equals_ignore_case(s.slice(start, start + byte_count),
                other.slice(other_start, other_start + byte_count));
        };

    export let index_of_range = func(s: string, needle: string, start: int, end: int) -> int {
        let found = strings.index_of(s.slice(start, end), needle);
        return found < 0 ? -1 : start + found;
    };

    export let index_of_code_point = func(s: string, scalar: uint32) -> int =>
        strings.index_of(s, strings.from_scalars([scalar]));

    export let last_index_of_from = func(s: string, needle: string, from: int) -> int {
        check_boundary(s, from);
        let offset = from;
        while (true) {
            if (starts_with_at(s, needle, offset)) {
                return offset;
            }
            if (offset == 0) {
                return -1;
            }
            offset = previous_boundary(s, offset);
        }
    };

    export let last_index_of_code_point = func(s: string, scalar: uint32) -> int =>
        strings.last_index_of(s, strings.from_scalars([scalar]));

    export let code_point_at = func(s: string, offset: int) -> uint32 => strings.scalar_at(s, offset);

    export let code_point_before = func(s: string, offset: int) -> uint32 =>
        strings.scalar_at(s, offset_by_code_points(s, offset, -1));

    export let code_point_count = func(s: string, start: int, end: int) -> int =>
        strings.scalar_count(s.slice(start, end));

    export let code_points = func(s: string) -> uint32[list] => strings.scalars(s);

    export let get_bytes = func(s: string) -> uint8[list] => strings.to_bytes(s)
        or func(s: string, charset: Charset) -> uint8[list] => charsets.encode(s, charset)
        or func(s: string, charset_name: string) -> uint8[list] =>
            charsets.encode(s, result.expect<Charset>(charsets.for_name(charset_name), "encode text"));

    export let try_get_bytes = func(s: string, charset: Charset) -> result.Result<uint8[list]> =>
        charsets.try_encode(s, charset)
        or func(s: string, charset_name: string) -> result.Result<uint8[list]> =>
            match (charsets.for_name(charset_name)) {
                result.Result.Ok(charset) => charsets.try_encode(s, charset),
                result.Result.Err(failure) => result.Result<uint8[list]>.Err(failure),
            };

    export let decode_bytes = func(bytes: uint8[list]) -> string => charsets.decode(bytes, Charset.Utf8)
        or func(bytes: uint8[list], charset: Charset) -> string => charsets.decode(bytes, charset)
        or func(bytes: uint8[list], charset_name: string) -> string =>
            charsets.decode(bytes, result.expect<Charset>(charsets.for_name(charset_name), "decode bytes"));

    export let try_decode_bytes = func(bytes: uint8[list]) -> result.Result<string> =>
        charsets.try_decode(bytes, Charset.Utf8)
        or func(bytes: uint8[list], charset: Charset) -> result.Result<string> =>
            charsets.try_decode(bytes, charset)
        or func(bytes: uint8[list], charset_name: string) -> result.Result<string> =>
            match (charsets.for_name(charset_name)) {
                result.Result.Ok(charset) => charsets.try_decode(bytes, charset),
                result.Result.Err(failure) => result.Result<string>.Err(failure),
            };

    // Explicit UTF-16 adapters. Other positional operations use UTF-8.
    export let utf16_length = func(s: string) -> int {
        let length = 0;
        let bytes = s.byte_length;
        for (let i = 0; i < bytes; i += 1) {
            let byte = s.byte_at(i);
            if ((byte & 192) != 128) {
                length += byte >= 240 ? 2 : 1;
            }
        }
        return length;
    };

    export let char_at = func(s: string, index: int) -> uint16 {
        if (index < 0) {
            trap_with_message("invalid argument: UTF-16 index out of range");
        }
        let offset = 0;
        let remaining = index;
        while (offset < s.byte_length) {
            let scalar = strings.scalar_at(s, offset);
            let width = utf16_width(scalar);
            if (remaining < width) {
                return utf16_unit(scalar, remaining);
            }
            remaining -= width;
            offset += unicode_scalars.utf8_length(scalar);
        }
        trap_with_message("invalid argument: UTF-16 index out of range");
    };

    export let to_char_array = func(s: string) -> uint16[list] => utf16_window(s, 0, s.byte_length);

    export let chars = func(s: string) -> uint16[list] => to_char_array(s);

    export let get_chars =
        func(s: string, start: int, end: int, destination: uint16[], destination_start: int) {
            let units = checked_utf16_window(s, start, end, destination.length, destination_start);
            for (let i = 0; i < units.length; i += 1) {
                destination[destination_start + i] = units[i];
            }
        } or func(s: string, start: int, end: int, destination: uint16[list], destination_start: int) {
            let units = checked_utf16_window(s, start, end, destination.length, destination_start);
            for (let i = 0; i < units.length; i += 1) {
                destination[destination_start + i] = units[i];
            }
        };

    export let from_char_array = func(units: uint16[list]) -> string {
        let text = string_builder.create();
        let i = 0;
        while (i < units.length) {
            let first = units[i] as uint32;
            i += 1;
            if (first < 55296 || first > 57343) {
                text.append_scalar(first);
                continue;
            }
            if (first >= 56320 || i == units.length) {
                trap_with_message("invalid argument: unpaired UTF-16 surrogate");
            }
            let second = units[i] as uint32;
            if (second < 56320 || second > 57343) {
                trap_with_message("invalid argument: unpaired UTF-16 surrogate");
            }
            i += 1;
            text.append_scalar(65536 + ((first - 55296) << 10) + (second - 56320));
        }
        return text.to_string();
    };

    export let offset_by_code_points = func(s: string, offset: int, count: int) -> int {
        check_boundary(s, offset);
        let pos = offset;
        let remaining = count;
        while (remaining > 0) {
            if (pos == s.byte_length) {
                trap_with_message("invalid argument: code point offset out of range");
            }
            pos += unicode_scalars.utf8_length(strings.scalar_at(s, pos));
            remaining -= 1;
        }
        while (remaining < 0) {
            if (pos == 0) {
                trap_with_message("invalid argument: code point offset out of range");
            }
            pos = previous_boundary(s, pos);
            remaining += 1;
        }
        return pos;
    };

    export let.override trim = func(s: string) -> string {
        let start = 0;
        let end = s.byte_length;
        while (start < end && s.byte_at(start) <= 32) {
            start += 1;
        }
        while (end > start && s.byte_at(end - 1) <= 32) {
            end -= 1;
        }
        return s.slice(start, end);
    };

    export let is_blank = func(s: string) -> bool => leading_whitespace_end(s, s.byte_length as int64) == s.byte_length;

    export let strip = func(s: string) -> string => strip_trailing(strip_leading(s));

    export let strip_leading = func(s: string) -> string =>
        s.slice(leading_whitespace_end(s, s.byte_length as int64), s.byte_length);

    export let strip_trailing = func(s: string) -> string {
        let end = s.byte_length;
        while (end > 0) {
            let prev = previous_boundary(s, end);
            if (!is_whitespace(strings.scalar_at(s, prev))) {
                break;
            }
            end = prev;
        }
        return s.slice(0, end);
    };

    // CR, LF, and CRLF each end a line. An empty string has no lines.
    export let.override lines = func(s: string) -> string[list] {
        let pieces: string[list] = [];
        let start = 0;
        let i = 0;
        let length = s.byte_length;
        while (i < length) {
            let byte = s.byte_at(i);
            if (byte == 10 || byte == 13) {
                pieces.append(s.slice(start, i));
                if (byte == 13 && i + 1 < length && s.byte_at(i + 1) == 10) {
                    i += 1;
                }
                start = i + 1;
            }
            i += 1;
        }
        if (start < length) {
            pieces.append(s.slice(start, length));
        }
        return pieces;
    };

    // Positive counts add spaces. Negative counts remove up to that many
    // leading whitespace code points. Each resulting line ends with LF.
    export let indent = func(s: string, count: int) -> string {
        let parts = lines(s);
        if (parts.length == 0) {
            return "";
        }
        let prefix = count > 0 ? strings.repeat(" ", count) : "";
        let remove_count = count < 0 ? -(count as int64) : 0;
        let changed: string[list] = [];
        for (let line in parts) {
            let start = leading_whitespace_end(line, remove_count);
            changed.append(prefix + line.slice(start, line.byte_length));
        }
        changed.append("");
        return strings.join(changed, "\n");
    };

    // Removes incidental indentation and trailing whitespace per line.
    // A terminal line separator fixes the removable indentation at zero.
    export let strip_indent = func(s: string) -> string {
        let parts = lines(s);
        if (parts.length == 0) {
            return "";
        }
        let final_byte = s.byte_at(s.byte_length - 1);
        let has_final_separator = final_byte == 10 || final_byte == 13;
        let common = 0;
        if (!has_final_separator) {
            let last = parts[parts.length - 1];
            common = code_point_count(last, 0, leading_whitespace_end(last, last.byte_length as int64));
            for (let line in parts) {
                let end = leading_whitespace_end(line, line.byte_length as int64);
                if (end != line.byte_length) {
                    let count = code_point_count(line, 0, end);
                    if (count < common) {
                        common = count;
                    }
                }
            }
        }
        let changed: string[list] = [];
        for (let line in parts) {
            let start = leading_whitespace_end(line, common as int64);
            changed.append(strip_trailing(line.slice(start, line.byte_length)));
        }
        if (has_final_separator) {
            changed.append("");
        }
        return strings.join(changed, "\n");
    };

    export let matches = func(s: string, pattern: string) -> bool =>
        compile_pattern(pattern).matches_fully(s);

    export let replace_code_point = func(s: string, target: uint32, replacement: uint32) -> string =>
        strings.replace(s, strings.from_scalars([target]), strings.from_scalars([replacement]));

    export let replace_all = func(s: string, pattern: string, replacement: string) -> string =>
        compile_pattern(pattern).replace_all(s, replacement);

    export let replace_first_regex = func(s: string, pattern: string, replacement: string) -> string =>
        compile_pattern(pattern).replace_first(s, replacement);

    export let split_regex = func(s: string, pattern: string) -> string[list] =>
        compile_pattern(pattern).split(s);

    export let split_regex_limit = func(s: string, pattern: string, limit: int) -> string[list] =>
        split_pattern(s, pattern, limit, false);

    export let split_with_delimiters = func(s: string, pattern: string, limit: int) -> string[list] =>
        split_pattern(s, pattern, limit, true);

    export let formatted = func(s: string, args: ...) -> string =>
        vformatted(s, args);

    export let vformatted = func(s: string, args: variadic.Argument[]) -> string =>
        result.expect<string>(formatting.try_vformat(s, args), "invalid format");

    export let value_of = func<T>(value: T) -> string => value.to_string();

    export let transform = func<T>(s: string, operation: func(string) -> T) -> T => operation(s);

    export let translate_escapes = func(s: string) -> string {
        let text = string_builder.create();
        let start = 0;
        let pos = 0;
        while (pos < s.byte_length) {
            if (s.byte_at(pos) != 92) {
                pos += 1;
                continue;
            }
            text.append(s.slice(start, pos));
            pos += 1;
            if (pos == s.byte_length) {
                trap_with_message("invalid argument: incomplete escape");
            }
            let escape = s.byte_at(pos);
            pos += 1;
            if (escape >= 48 && escape <= 55) {
                let value = (escape as uint32) - 48;
                let digits = escape <= 51 ? 2 : 1;
                while (digits > 0 && pos < s.byte_length) {
                    let digit = s.byte_at(pos);
                    if (digit < 48 || digit > 55) {
                        break;
                    }
                    value = value * 8 + (digit as uint32) - 48;
                    pos += 1;
                    digits -= 1;
                }
                text.append_scalar(value);
            } else if (escape == 13 || escape == 10) {
                if (escape == 13 && pos < s.byte_length && s.byte_at(pos) == 10) {
                    pos += 1;
                }
            } else {
                text.append_scalar(escaped_scalar(escape));
            }
            start = pos;
        }
        text.append(s.slice(start, s.byte_length));
        return text.to_string();
    };

    let valid_region = func(s: string, start: int, count: int) -> bool =>
        count >= 0 && strings.is_boundary(s, start) && count <= s.byte_length - start &&
        strings.is_boundary(s, start + count);

    let utf16_width = func(scalar: uint32) -> int => scalar <= 65535 ? 1 : 2;

    let utf16_unit = func(scalar: uint32, index: int) -> uint16 {
        if (scalar <= 65535) {
            return scalar as uint16;
        }
        let payload = scalar - 65536;
        return (index == 0 ? 55296 + (payload >> 10) : 56320 + (payload & 1023)) as uint16;
    };

    let utf16_window = func(s: string, start: int, end: int) -> uint16[list] {
        let units: uint16[list] = [];
        let offset = 0;
        let index = 0;
        while (index < end && offset < s.byte_length) {
            let scalar = strings.scalar_at(s, offset);
            let width = utf16_width(scalar);
            for (let i = 0; i < width && index < end; i += 1) {
                if (index >= start) {
                    units.append(utf16_unit(scalar, i));
                }
                index += 1;
            }
            offset += unicode_scalars.utf8_length(scalar);
        }
        return units;
    };

    let checked_utf16_window =
        func(s: string, start: int, end: int, destination_length: int, destination_start: int) -> uint16[list] {
            if (start < 0 || end < start || end > utf16_length(s)) {
                trap_with_message("invalid argument: UTF-16 range out of bounds");
            }
            if (destination_start < 0 || destination_start > destination_length - (end - start)) {
                trap_with_message("invalid argument: destination range out of bounds");
            }
            return utf16_window(s, start, end);
        };

    let check_boundary = func(s: string, offset: int) {
        if (!strings.is_boundary(s, offset)) {
            trap_with_message("invalid argument: offset is not a character boundary");
        }
    };

    let previous_boundary = func(s: string, offset: int) -> int {
        let pos = offset - 1;
        while ((s.byte_at(pos) & 192) == 128) {
            pos -= 1;
        }
        return pos;
    };

    // Java whitespace excludes the three non-breaking spaces. The set is
    // fixed here so results never depend on a host's locale or tables.
    let is_whitespace = func(scalar: uint32) -> bool =>
        (scalar >= 9 && scalar <= 13) || (scalar >= 28 && scalar <= 32) || scalar == 5760 ||
        (scalar >= 8192 && scalar <= 8202 && scalar != 8199) || scalar == 8232 || scalar == 8233 ||
        scalar == 8287 || scalar == 12288;

    let leading_whitespace_end = func(s: string, count: int64) -> int {
        let end = 0;
        let remaining = count;
        while (end < s.byte_length && remaining != 0) {
            let scalar = strings.scalar_at(s, end);
            if (!is_whitespace(scalar)) {
                break;
            }
            end += unicode_scalars.utf8_length(scalar);
            remaining -= 1;
        }
        return end;
    };

    let compile_pattern = func(pattern: string) -> regex.Regex =>
        result.expect<regex.Regex>(regex.compile(pattern), "invalid regular expression");

    let split_pattern = func(s: string, pattern: string, limit: int, keep_delimiters: bool) -> string[list] {
        if (limit < 1) {
            trap_with_message("invalid argument: limit below 1");
        }
        let expression = compile_pattern(pattern);
        let pieces: string[list] = [];
        let start = 0;
        let from = 0;
        let remaining = limit - 1;
        while (remaining > 0) {
            let found = expression.find_from(s, from);
            if (found == nil) {
                break;
            }
            let match_start = found.start();
            pieces.append(s.slice(start, match_start));
            if (keep_delimiters) {
                pieces.append(found.text());
            }
            start = found.end();
            remaining -= 1;
            from = start;
            if (match_start == start) {
                if (start == s.byte_length) {
                    break;
                }
                from = offset_by_code_points(s, start, 1);
            }
        }
        pieces.append(s.slice(start, s.byte_length));
        return pieces;
    };

    let escaped_scalar = func(escape: uint8) -> uint32 {
        if (escape == 34 || escape == 39 || escape == 92) {
            return escape as uint32;
        }
        if (escape == 98) {
            return 8;
        }
        if (escape == 116) {
            return 9;
        }
        if (escape == 110) {
            return 10;
        }
        if (escape == 102) {
            return 12;
        }
        if (escape == 114) {
            return 13;
        }
        if (escape == 115) {
            return 32;
        }
        trap_with_message("invalid argument: unrecognized escape");
    };
);
