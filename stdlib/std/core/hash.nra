// Hash building blocks (Stdlib.md section 5.2). Every result is a uint32 and
// every step is computed without wrapping intrinsics.
export let Hash = module (
    // 31 * seed + value, modulo 2^32. The product is below 2^37 in uint64.
    export let combine = func(uint32 seed, uint32 value) -> uint32 {
        let sum = (seed as uint64) * 31 + (value as uint64);
        return (sum & 4294967295) as uint32;
    };

    // Mixes the high half into the low half before a table masks the hash.
    export let spread = func(uint32 hash) -> uint32 {
        return hash ^ (hash >> 16);
    };

    // 1231 for true and 1237 for false.
    export let of_bool = func(bool value) -> uint32 {
        if (value) {
            return 1231;
        }
        return 1237;
    };

    // The low 32 bits exclusive-or the high 32 bits of the two's complement
    // pattern.
    export let of_int64 = func(int64 value) -> uint32 {
        return value.hash_code();
    };

    export let of_uint64 = func(uint64 value) -> uint32 {
        return ((value & 4294967295) ^ (value >> 32)) as uint32;
    };
);
