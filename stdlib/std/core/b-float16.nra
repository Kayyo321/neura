let float_text = import:Std.Core.Internal.FloatText;
let.promote _ = import:Std.Core.Ordering;
let.promote _ = import:Std.Core.Result;

/// @brief Companion functions for bfloat16 (Stdlib.md section 7.3).
///
/// Format: binary32's 8-bit exponent with a 7-bit fraction. Bit-level operations use the exact encoding (N1);
/// text conversion follows section 7.5.
/// @see [Std.Core.BFloat16](https://github.com/Kayyo321/neura/wiki/Stdlib-Core-BFloat16)
export let BFloat16 = module (
    /// @brief The largest finite value.
    export const Max: bfloat16 = bfloat16.from_bits(32639);
    /// @brief The smallest positive (subnormal) value.
    export const MinPositive: bfloat16 = bfloat16.from_bits(1);
    /// @brief The smallest positive normal value.
    export const MinNormal: bfloat16 = bfloat16.from_bits(128);
    /// @brief The difference between 1.0 and the next larger value.
    export const Epsilon: bfloat16 = bfloat16.from_bits(15360);
    /// @brief The positive infinity of this format.
    export const Infinity: bfloat16 = bfloat16.from_bits(32640);
    /// @brief The negative infinity of this format.
    export const NegativeInfinity: bfloat16 = bfloat16.from_bits(65408);
    /// @brief The canonical quiet NaN.
    export const NaN: bfloat16 = bfloat16.from_bits(32704);

    /// @brief The mask selecting the sign bit.
    const SignBit: uint16 = 32768;
    /// @brief The mask selecting the exponent and fraction bits.
    const Magnitude: uint16 = 32767;

    /// @brief Reports whether the value is a NaN.
    export let is_nan = func(v: bfloat16) -> bool => v != v;

    /// @brief Reports whether the value is either signed infinity.
    export let is_infinite = func(v: bfloat16) -> bool => (v.to_bits() & Magnitude) == 32640;

    /// @brief Reports whether the value is finite, including zero and subnormal values.
    export let is_finite = func(v: bfloat16) -> bool => (v.to_bits() & 32640) != 32640;

    /// @brief Reads the sign bit, so it is true for -0.0 and for a NaN with the sign bit set.
    export let is_negative = func(v: bfloat16) -> bool => (v.to_bits() & SignBit) != 0;

    /// @brief Clears the sign bit; never rounds.
    export let abs = func(v: bfloat16) -> bfloat16 => bfloat16.from_bits(v.to_bits() & Magnitude);

    /// @brief The magnitude of `magnitude` with the sign bit of `sign`.
    export let copy_sign = func(magnitude: bfloat16, sign: bfloat16) -> bfloat16 =>
        bfloat16.from_bits((magnitude.to_bits() & Magnitude) | (sign.to_bits() & SignBit));

    /// @brief NaN (canonical) if either operand is NaN; -0.0 is less than 0.0.
    export let min = func(a: bfloat16, b: bfloat16) -> bfloat16 {
        if (a != a || b != b) {
            return NaN;
        }
        if (a < b) {
            return a;
        }
        if (b < a) {
            return b;
        }
        if (is_negative(a)) {
            return a;
        }
        return b;
    };

    /// @brief Returns the greater value, propagating NaN and preferring positive zero over negative zero.
    export let max = func(a: bfloat16, b: bfloat16) -> bfloat16 {
        if (a != a || b != b) {
            return NaN;
        }
        if (a > b) {
            return a;
        }
        if (b > a) {
            return b;
        }
        if (is_negative(a)) {
            return b;
        }
        return a;
    };

    /// @brief max(v, low), then min with high, so a NaN `v` gives NaN. Traps when either bound is NaN or `low`
    /// exceeds `high` (-0.0 is below 0.0).
    export let clamp = func(v: bfloat16, low: bfloat16, high: bfloat16) -> bfloat16 {
        if (low != low || high != high) {
            trap_with_message("invalid argument: NaN bound");
        }
        if (total_compare(low, high) == Ordering.Greater) {
            trap_with_message("invalid argument: low exceeds high");
        }
        return min(max(v, low), high);
    };

    /// @brief Rounding to an integral value. All keep the sign of zero (ceil(-0.5) is -0.0); infinities are
    /// unchanged and a NaN becomes the canonical NaN.
    export let floor = func(v: bfloat16) -> bfloat16 => round_with(v, 0);

    /// @brief Rounds toward positive infinity, retaining the sign of zero.
    export let ceil = func(v: bfloat16) -> bfloat16 => round_with(v, 1);

    /// @brief Rounds toward zero, retaining the sign of zero.
    export let trunc = func(v: bfloat16) -> bfloat16 => round_with(v, 2);

    /// @brief Halves round away from zero.
    export let round = func(v: bfloat16) -> bfloat16 => round_with(v, 3);

    /// @brief Halves round to the even neighbour.
    export let round_even = func(v: bfloat16) -> bfloat16 => round_with(v, 4);

    /// @brief Returns the raw bit pattern as an unsigned integer.
    export let to_bits = func(v: bfloat16) -> uint16 => v.to_bits();

    /// @brief Interprets an unsigned integer as a raw floating-point bit pattern.
    export let from_bits = func(bits: uint16) -> bfloat16 => bfloat16.from_bits(bits);

    /// @brief The total order of section 5.3: -Infinity, negative values, -0.0, 0.0, positive values, Infinity,
    /// then every NaN (all NaNs equal).
    export let total_compare = func(a: bfloat16, b: bfloat16) -> Ordering {
        let a_nan = a != a;
        let b_nan = b != b;
        if (a_nan || b_nan) {
            if (a_nan && b_nan) {
                return Ordering.Equal;
            }
            if (a_nan) {
                return Ordering.Greater;
            }
            return Ordering.Less;
        }
        if (a < b) {
            return Ordering.Less;
        }
        if (a > b) {
            return Ordering.Greater;
        }
        let a_negative = is_negative(a);
        if (a_negative == is_negative(b)) {
            return Ordering.Equal;
        }
        if (a_negative) {
            return Ordering.Less;
        }
        return Ordering.Greater;
    };

    /// @brief Same bit pattern, except that every NaN equals every NaN; 0.0 and -0.0 differ (section 5.2).
    export let equals = func(a: bfloat16, b: bfloat16) -> bool => a === b;

    /// @brief Returns the primitive hash consistent with canonical-NaN and signed-zero equality.
    export let hash = func(v: bfloat16) -> uint32 => v.hash_code();

    /// @brief The shortest text that parses back to the same value (section 7.5).
    export let to_string = func(v: bfloat16) -> string => v.to_string();

    /// @brief Exactly `digits` fraction digits (0 through 100; no point for 0), correctly rounded, ties to
    /// even. Other digit counts trap.
    export let to_fixed = func(v: bfloat16, digits: int) -> string =>
        float_text.to_fixed(v.to_bits() as uint64, 7, 8, digits);

    /// @brief `d.ddd` with `digits` fraction digits (0 through 100), `e`, and the decimal exponent; correctly
    /// rounded, ties to even.
    export let to_exponential = func(v: bfloat16, digits: int) -> string =>
        float_text.to_exponential(v.to_bits() as uint64, 7, 8, digits);

    /// @brief The grammar of section 7.5, converted exactly and rounded once, ties to even. Too large becomes
    /// an infinity and too small a signed zero.
    export let parse = func(text: string) -> Result<bfloat16> => match (float_text.parse(text, 7, 8)) {
        float_text.Parsed.Failure(failure) => Result<bfloat16>.Err(failure),
        float_text.Parsed.Bits(bits) => Result<bfloat16>.Ok(bfloat16.from_bits(bits as uint16)),
        float_text.Parsed.Near(near) => Result<bfloat16>.Ok(near as bfloat16),
    };

    /// @brief Applies the requested rounding mode to the format's raw bit pattern.
    let round_with = func(v: bfloat16, mode: int) -> bfloat16 =>
        bfloat16.from_bits(float_text.round_bits(v.to_bits() as uint64, 7, 8, mode) as uint16);
);
