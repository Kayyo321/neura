/// @brief The result of an operation that succeeds without a value: Result<Unit>.
/// @see [Std.Core.Unit](https://github.com/Kayyo321/neura/wiki/Stdlib-Core-Unit)
#Since("0.1.0")
export let Unit = module (
    /// @brief The single value used when success has no payload.
    #Since("0.1.0")
    export let Unit = enum (Value);
);
