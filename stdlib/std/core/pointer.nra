let cell = import:Std.Core.Cell;
let closeable = import:Std.Io.Closeable;
let optional = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Result;
let.promote _ = import:Std.Core.Unit;

/// @brief Managed storage references and checked collection views.
.Since("0.3.1")
export let Pointer = module (
    // A private nominal marker for erased pointers at the native boundary.
    let ManagedPointer = class ();

    let Source = enum<T> (
        Array(T[]),
        List(T[list]),
    );

    let bounds_failure = func {
        pointer_bounds_failure();
    };

    let stale_view = func {
        pointer_stale_view();
    };

    let check_range = func(first: int, end: int, length: int) {
        if (first < 0 || end < first || end > length) {
            bounds_failure();
        }
    };

    /// @brief A mutable view of a cell's retained storage.
    .[Final, NotThreadSafe, Since("0.3.1")]
    export let Pointer = class<T>:ManagedPointer (
        last backing: cell.Cell<T>;

        /// @brief Retains the storage of the supplied live cell.
        export let init = func(storage: cell.Cell<T>) {
            super.init();
            backing = retain_cell_storage(storage);
        };

        /// @brief Reads the current stored value.
        export let read = func -> T => backing.value;

        /// @brief Replaces the current stored value.
        export let write = func(value: T) {
            backing.value = value;
        };

        /// @brief Shares access to a deeply immutable stored value.
        export let as_const = func -> ConstPointer<T> => new(backing);

        /// @brief Returns another mutable view of the same storage.
        export let clone = func -> Pointer<T> => new(backing);
    );

    /// @brief A read-only view that keeps a cell's storage live. A Pointer to the same storage can still change it, so
    /// the view stays in the task that holds it.
    .[Final, NotThreadSafe, Since("0.3.1")]
    export let ConstPointer = class<T>:ManagedPointer (
        last backing: cell.Cell<T>;

        let init = func(storage: cell.Cell<T>) {
            super.init();
            backing = storage;
        };

        /// @brief Reads the stored value. T must be deeply immutable.
        export let read = func -> T => backing.value;

        /// @brief Returns another read-only view of the same storage.
        export let clone = func -> ConstPointer<T> => new(backing);
    );

    /// @brief A non-copying, bounds-checked view of a contiguous array or list region.
    .[Final, NotThreadSafe, Since("0.3.1")]
    export let ListPointer = class<T>:ManagedPointer (
        last source: Source<T>;
        last first: int;
        last limit: int;
        last version: uint64;

        /// @brief Creates a view of [start, end) in a fixed-length array.
        export let init = func(values: T[], start: int, end: int) {
            super.init();
            check_range(start, end, values.length);
            source = Source<T>.Array(values);
            first = start;
            limit = end;
            version = 0;
        } or func(values: T[list], start: int, end: int) {
            super.init();
            check_range(start, end, values.length);
            source = Source<T>.List(values);
            first = start;
            limit = end;
            version = values.version;
        };

        let check_live = func {
            match (source) {
                Source.List(values) => {
                    if (values.version != version) {
                        stale_view();
                    }
                },
                Source.Array(_) => {},
            }
        };

        let offset = func(index: int) -> int {
            check_live();
            if (index < 0 || index >= limit - first) {
                bounds_failure();
            }
            return first + index;
        };

        /// @brief Returns the number of elements in the view.
        export let len = func -> int {
            check_live();
            return limit - first;
        };

        /// @brief Reads the element at a checked index relative to this view.
        export let value_at = func(index: int) -> T {
            last position = offset(index);
            return match (source) {
                Source.Array(values) => values[position],
                Source.List(values) => values[position],
            };
        };

        /// @brief Replaces the element at a checked index without changing the list version.
        export let set = func(index: int, value: T) {
            last position = offset(index);
            match (source) {
                Source.Array(values) => {
                    values[position] = value;
                },
                Source.List(values) => {
                    values[position] = value;
                },
            }
        };

        /// @brief Creates a checked subview of [start, end) relative to this view.
        export let sub = func(start: int, end: int) -> ListPointer<T> {
            check_live();
            check_range(start, end, limit - first);
            return match (source) {
                Source.Array(values) => new ListPointer<T>(values, first + start, first + end),
                Source.List(values) => new ListPointer<T>(values, first + start, first + end),
            };
        };

        /// @brief Reports whether the view contains no elements.
        export let is_empty = func -> bool => len() == 0;
    );

    /// @brief Exclusive ownership of a class instance (Neura0.3.1.md section 2.4). Declared with its target and
    /// task-transfer rules; it has no public constructor until its operations land.
    .[Final, NotThreadSafe, Since("0.3.1")]
    export let UniquePointer = class<T>:ManagedPointer (
        let init = func {
            super.init();
        };
    );

    // Whether a shared target is still held. A group expires when its last owner claim ends, and the target is
    // then dropped, so that collection can reclaim it once nothing else holds it.
    let Slot = enum<T> (
        Owned(T),
        Expired,
    );

    // The constructor argument that only this module can name, which keeps the internal overloads private.
    let Claim = enum (
        Counted,
    );

    // The state that every owner and weak reference of one shared target reaches. Its methods' callers change it
    // only in straight-line field operations, before their first call or allocation, so no task switch falls
    // between a read and the write that depends on it (tests/pointer/polls.py checks this).
    let SharedGroup = class<T> (
        export let slot: Slot<T>;
        export let owners: int64 = 1;
        export let writing: bool = false;

        export let init = func(target: T) {
            slot = Slot<T>.Owned(target);
        };
    );

    /// @brief Shared ownership of a managed object (section 2.5). Each SharedPointer is one owner claim of a
    /// group; `clone`, and `upgrade` on a WeakPointer, add claims, and `release` ends one. When the last claim
    /// ends, the group expires: every WeakPointer of it returns None. Tasks may share a SharedPointer whose target
    /// type is deeply immutable.
    .[Final, Since("0.3.1")]
    export let SharedPointer = class<T>:ManagedPointer implements closeable.Closeable (
        last group: SharedGroup<T>;
        let released: bool = false;

        /// @brief Takes ownership of `target`, which nothing else may refer to: a new object, an array or list
        /// literal, or a local that holds one and is used only here (E0465).
        export let init = func(target: T) {
            super.init();
            group = new SharedGroup<T>(retain_object_storage(target));
        } or func(joined: SharedGroup<T>, claim: Claim) {
            super.init();
            group = joined;
        };

        /// @brief Returns another owner claim of the same target.
        export let clone = func -> SharedPointer<T> {
            if (released) {
                trap_with_message("invalid state: released SharedPointer");
            }
            group.owners = group.owners + 1;
            return new SharedPointer<T>(group, Claim.Counted);
        };

        /// @brief Returns the target under Neura's ordinary reference rules.
        export let read = func -> T {
            if (released) {
                trap_with_message("invalid state: released SharedPointer");
            }
            match (group.slot) {
                Slot.Owned(target) => {
                    return target;
                },
                Slot.Expired => {},
            }
            trap_with_message("invalid state: expired SharedPointer");
        };

        /// @brief Runs `body` with the target and returns its result. Traps while a with_mut of the same target
        /// runs.
        export let with_read = func<U>(body: func(T) -> U) -> U {
            if (released) {
                trap_with_message("invalid state: released SharedPointer");
            }
            if (group.writing) {
                trap_with_message("invalid state: SharedPointer is borrowed by with_mut");
            }
            return body(read());
        };

        /// @brief Runs `body` with the target, marking the target as written until it returns. A with_mut or
        /// with_read of the same target inside it traps. A body that needs a result writes it into the target, or
        /// uses with_read.
        export let with_mut = func(body: func(T) -> void) {
            if (released) {
                trap_with_message("invalid state: released SharedPointer");
            }
            if (group.writing) {
                trap_with_message("invalid state: SharedPointer is borrowed by with_mut");
            }
            group.writing = true;
            body(read());
            group.writing = false;
        };

        /// @brief Returns a WeakPointer to the target, which adds no owner claim.
        export let downgrade = func -> WeakPointer<T> {
            if (released) {
                trap_with_message("invalid state: released SharedPointer");
            }
            return new WeakPointer<T>(group, Claim.Counted);
        };

        /// @brief Ends this owner claim. Every alias of this SharedPointer is released with it. When no claim
        /// remains, the target expires. A second release traps.
        export let release = func {
            if (released) {
                trap_with_message("invalid state: SharedPointer released twice");
            }
            released = true;
            group.owners = group.owners - 1;
            if (group.owners == 0) {
                group.slot = Slot<T>.Expired;
            }
        };

        /// @brief Releases this owner claim if it is held, for `using`. Closing again does nothing.
        export let close = func -> Result<Unit> {
            if (not released) {
                released = true;
                group.owners = group.owners - 1;
                if (group.owners == 0) {
                    group.slot = Slot<T>.Expired;
                }
            }
            return Result<Unit>.Ok(Unit.Value);
        };

        /// @brief Names the pointer; the target is not shown.
        export let.override to_string = func -> string => "SharedPointer";
    );

    /// @brief A non-owning reference to a shared object (section 2.6). It does not extend the target's owner
    /// claims: once the last SharedPointer of the target is released, `upgrade` returns None. Before that, the
    /// target stays allocated.
    .[Final, Since("0.3.1")]
    export let WeakPointer = class<T>:ManagedPointer (
        last group: SharedGroup<T>;

        /// @brief A weak reference to a group. Only SharedPointer.downgrade can name its arguments.
        export let init = func(shared: SharedGroup<T>, claim: Claim) {
            super.init();
            group = shared;
        };

        /// @brief Returns a new owner claim of the target, or None when the target has expired.
        export let upgrade = func -> optional.Optional<SharedPointer<T>> {
            match (group.slot) {
                Slot.Owned(_) => {},
                Slot.Expired => {
                    return optional.Optional<SharedPointer<T>>.None;
                },
            }
            group.owners = group.owners + 1;
            return optional.Optional<SharedPointer<T>>.Some(new SharedPointer<T>(group, Claim.Counted));
        };

        /// @brief Reports whether the target is still held by an owner claim.
        export let is_alive = func -> bool => match (group.slot) {
            Slot.Owned(_) => true,
            Slot.Expired => false,
        };

        /// @brief Names the pointer.
        export let.override to_string = func -> string => "WeakPointer";
    );

    /// @brief A cache reference to a shared object (section 2.7). It has no public constructor until its operations
    /// land.
    .[Final, Since("0.3.1")]
    export let SoftPointer = class<T>:ManagedPointer (
        let init = func {
            super.init();
        };
    );

    /// @brief An atomically replaced reference to a deeply immutable object (section 2.8). It has no public
    /// constructor until its operations land.
    .[Final, Since("0.3.1")]
    export let AtomicPointer = class<T>:ManagedPointer (
        let init = func {
            super.init();
        };
    );

    /// @brief State that tasks reach one at a time (section 2.9). It has no public constructor until its operations
    /// land.
    .[Final, Since("0.3.1")]
    export let LockedPointer = class<T>:ManagedPointer (
        let init = func {
            super.init();
        };
    );
);
