let hashing = import:Std.Core.Hash;
let iterables = import:Std.Collections.Iterable;
let iterators = import:Std.Collections.Iterator;

/// @brief An immutable arithmetic progression of int values (Stdlib.md section 6.5): `start` inclusive, `end`
/// exclusive, and a nonzero `step`.
///
/// A negative step counts down while the value is greater than `end`. Positions and sizes are computed in
/// int64, so no intermediate overflows.
/// @see [Std.Core.IntRange](https://github.com/Kayyo321/neura/wiki/Stdlib-Core-IntRange)
#Since("0.1.0")
export let IntRange = module (
    /// @brief An immutable half-open arithmetic progression with a nonzero stride.
    #[Final, Since("0.1.0"), Immutable, ThreadSafe]
    export let IntRange = class implements iterables.Iterable<int> (
        /// @brief The inclusive start bound.
        #Since("0.2.0")
        export last start: int;
            | get: start;

        /// @brief The exclusive end bound.
        #Since("0.2.0")
        export last end: int;
            | get: end;

        /// @brief The signed stride between successive values; never zero.
        #Since("0.2.0")
        export last step: int;
            | get: step;

        /// @brief Stores the bounds and step. A zero step traps.
        export let init = func(start_value: int, end_value: int, step_value: int) {
            if (step_value == 0) {
                trap_with_message("invalid argument: zero step");
            }
            start = start_value;
            end = end_value;
            step = step_value;
        };

        /// @brief Progressions compare by their defining bounds and step.
        #Pure
        export let.override equals = func(other: class) -> bool {
            if (!(other is IntRange)) {
                return false;
            }
            last that = other as IntRange;
            return start == that.start && end == that.end && step == that.step;
        };

        /// @brief Combines the start, end, and step into a hash.
        #Pure
        export let.override hash_code = func -> uint32 {
            last start_hash = hashing.combine(17, start.hash_code());
            last bounds_hash = hashing.combine(start_hash, end.hash_code());
            return hashing.combine(bounds_hash, step.hash_code());
        };

        /// @brief Formats the progression as `start..end:step`.
        #Pure
        export let.override to_string = func -> string =>
            start.to_string() + ".." + end.to_string() + ":" + step.to_string();

        /// @brief The number of values. Computed in int64; a range with more than Int32.Max values traps
        /// (reason 1) in the conversion to int.
        #Pure
        export let size = func -> int => count() as int;

        /// @brief Reports whether the bounds leave no values in the stride's direction.
        #Pure
        export let is_empty = func -> bool => (step > 0) ? start >= end : start <= end;

        /// @brief Tests whether the value lies within the bounds and on a stride boundary.
        #Pure
        export let contains = func(value: int) -> bool {
            last offset = (value as int64) - (start as int64);
            last stride = step as int64;
            if (step > 0) {
                return value >= start && value < end && offset % stride == 0;
            }
            return value <= start && value > end && offset % stride == 0;
        };

        /// @brief The value at `index`. An index outside 0 through size() - 1 traps with "invalid argument:
        /// index out of range".
        #Pure
        export let get = func(index: int) -> int {
            if (index < 0 || (index as int64) >= count()) {
                trap_with_message("invalid argument: index out of range");
            }
            return ((start as int64) + (index as int64) * (step as int64)) as int;
        };

        /// @brief A new built-in list of the values in order.
        #Pure
        export let to_list = func -> int[list] {
            last values: int[list] = [];
            let current = start as int64;
            last stop = end as int64;
            last stride = step as int64;
            if (step > 0) {
                while (current < stop) {
                    values.append(current as int);
                    current += stride;
                }
            } else {
                while (current > stop) {
                    values.append(current as int);
                    current += stride;
                }
            }
            return values;
        };

        /// @brief An iterator over the values in order, for for-each and other Iterable consumers.
        #Pure
        export let iterator = func -> iterators.Iterator<int> => new IntRangeIterator(start, end, step);

        /// @brief The exact number of values as an int64.
        let count = func -> int64 {
            if (is_empty()) {
                return 0;
            }
            let distance = (end as int64) - (start as int64);
            let stride = step as int64;
            if (step < 0) {
                distance = -distance;
                stride = -stride;
            }
            return (distance + stride - 1) / stride;
        };
    );

    /// @brief Steps through a progression's values. Positions are int64, so the last step cannot overflow.
    #Final
    let IntRangeIterator = class implements iterators.Iterator<int> (
        /// @brief The next value to return.
        let current: int64;
        /// @brief The exclusive end bound.
        last stop: int64;
        /// @brief The signed stride.
        last stride: int64;

        /// @brief Starts before the first value of `start_value..end_value:step_value`.
        export let init = func(start_value: int, end_value: int, step_value: int) {
            current = start_value as int64;
            stop = end_value as int64;
            stride = step_value as int64;
        };

        /// @brief Reports whether another value remains.
        #Pure
        export let has_next = func -> bool => (stride > 0) ? current < stop : current > stop;

        /// @brief Returns the next value and advances. Traps with `no such element` at exhaustion.
        export let next = func -> int {
            if (!has_next()) {
                trap_with_message("no such element");
            }
            last value = current as int;
            current += stride;
            return value;
        };
    );

    /// @brief The values from `start` up to, but not including, `end`.
    #[NoDiscard, Since("0.1.0"), Pure, ThreadSafe]
    export let of = func(start: int, end: int) -> IntRange => new(start, end, 1);

    /// @brief A zero step traps with "invalid argument: zero step".
    #[NoDiscard, Since("0.1.0"), Pure, ThreadSafe]
    export let stepped = func(start: int, end: int, step: int) -> IntRange => new(start, end, step);
);
