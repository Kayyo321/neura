let ordering = import:Std.Core.Ordering;

// Comparator combinators (Stdlib.md section 5.3). A comparator is a native
// function value of type (T, T) -> Ordering that defines a total order.
export let Comparators = module (
    // The opposite order of `c`.
    export let reversed = func<T>(func(T, T) -> ordering.Ordering c) -> func(T, T) -> ordering.Ordering {
        return func(T a, T b) -> ordering.Ordering {
            return ordering.reverse(c(a, b));
        };
    };

    // Orders values by the keys that `key` extracts, compared with `c`.
    // `key` runs once per operand on each comparison.
    export let by_key = func<T, K>(func(T) -> K key, func(K, K) -> ordering.Ordering c)
        -> func(T, T) -> ordering.Ordering {
        return func(T a, T b) -> ordering.Ordering {
            return c(key(a), key(b));
        };
    };

    // `first`, and `second` only where `first` finds the values equal.
    export let then = func<T>(func(T, T) -> ordering.Ordering first, func(T, T) -> ordering.Ordering second)
        -> func(T, T) -> ordering.Ordering {
        return func(T a, T b) -> ordering.Ordering {
            let order = first(a, b);
            if (order != ordering.Ordering.Equal) {
                return order;
            }
            return second(a, b);
        };
    };
);
