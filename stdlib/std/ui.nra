let build = import:Std.Ui.Internal.Build;
let channels = import:Std.Concurrent.Channel;
let console = import:Std.Io.Console;
let error = import:Std.Core.Error;
let result = import:Std.Core.Result;
let storage = import:Std.Ui.Internal.Storage;
let strings = import:Std.Text.Strings;
let.promote _ = import:Std.Core.Error;

/// @brief Values produced by native HTML factories.
export let Ui = module (
    /// @brief One rendered fragment and its evaluated slot values.
    #[Final, NotThreadSafe]
    export let View = class (
        #Internal
        export last descriptor: string;
        #Internal
        export last fragment: uint32;
        #Internal
        export last slots: storage.Slot;

        #Internal
        export let init = func(descriptor: string, fragment: uint32, slots: storage.Slot) => set;
    );

    /// @brief A URL checked for use in a template attribute.
    #[Final, Immutable]
    export let Url = class (
        #Internal
        export last text: string;

        #Internal
        export let init = func(text: string) => set;
    );

    /// @brief A numeric CSS custom property value and its unit.
    #[Final, Immutable]
    export let CssValue = class (
        #Internal
        export last value: float64;
        #Internal
        export last unit: string;

        #Internal
        export let init = func(value: float64, unit: string) => set;
    );

    /// @brief Returns a URL after checking that it is a reference or uses an allowed scheme.
    export let url = func(text: string) -> Url {
        let delimiter = true;
        let i = 0;
        while (i < text.byte_length) {
            last byte = text.byte_at(i);
            if (byte <= 32 || byte == 127 || byte == 92) {
                trap_with_message("invalid UI URL character");
            }
            if (delimiter && byte == 58) {
                last scheme = strings.to_ascii_lower(text.slice(0, i));
                if (scheme != "http" && scheme != "https" && scheme != "mailto" && scheme != "tel") {
                    trap_with_message("URL scheme not allowed in a template");
                }
                delimiter = false;
            }
            if (byte == 47 || byte == 63 || byte == 35) {
                delimiter = false;
            }
            i += 1;
        }
        return new Url(text);
    };

    let css_value = func(value: float64, unit: string) -> CssValue {
        if (value - value != 0.0) {
            trap_with_message("a CSS value must be finite");
        }
        return new CssValue(value, unit);
    };

    /// @brief A CSS length with a supported unit.
    export let length = func(value: float64, unit: string) -> CssValue {
        if (unit != "px" && unit != "em" && unit != "rem" && unit != "ch" && unit != "vw" && unit != "vh"
            && unit != "cm" && unit != "mm" && unit != "in" && unit != "pt" && unit != "pc") {
            trap_with_message("invalid CSS length unit");
        }
        return css_value(value, unit);
    };

    /// @brief A CSS color from a 24-bit RGB value.
    export let color = func(rgb: uint32) -> CssValue {
        if (rgb > 16777215) {
            trap_with_message("CSS color requires a 24-bit RGB value");
        }
        return css_value(rgb as float64, "rgb");
    };

    /// @brief A unitless CSS number.
    export let number = func(value: float64) -> CssValue => css_value(value, "");

    /// @brief A CSS percentage.
    export let percent = func(value: float64) -> CssValue => css_value(value, "%");

    /// @brief The device that supplied a pointer event.
    export let PointerKind = enum (Mouse, Pen, Touch, Other);

    #[Final, Immutable]
    export let Modifiers = class (
        export last alt: bool;
        export last ctrl: bool;
        export last meta: bool;
        export last shift: bool;

        #Internal
        export let init = func(alt: bool, ctrl: bool, meta: bool, shift: bool) => set;
    );

    #[Final, Immutable]
    export let ClickEvent = class (
        export last button: uint8;
        export last x: float64;
        export last y: float64;
        export last modifiers: Modifiers;
        export last detail: int32;

        #Internal
        export let init = func(button: uint8, x: float64, y: float64, modifiers: Modifiers, detail: int32) => set;
    );

    #[Final, Immutable]
    export let InputEvent = class (
        export last value: string;
        export last checked: bool;
        export last composing: bool;

        #Internal
        export let init = func(value: string, checked: bool, composing: bool) => set;
    );

    #[Final, Immutable]
    export let ChangeEvent = class (
        export last value: string;
        export last checked: bool;

        #Internal
        export let init = func(value: string, checked: bool) => set;
    );

    #[Final, Immutable]
    export let SubmitEvent = class (
        export last submitter: string;

        #Internal
        export let init = func(submitter: string) => set;
    );

    #[Final, Immutable]
    export let KeyEvent = class (
        export last key: string;
        export last code: string;
        export last modifiers: Modifiers;
        export last repeat: bool;

        #Internal
        export let init = func(key: string, code: string, modifiers: Modifiers, repeat: bool) => set;
    );

    #[Final, Immutable]
    export let FocusEvent = class (
    );

    #[Final, Immutable]
    export let PointerEvent = class (
        export last x: float64;
        export last y: float64;
        export last button: uint8;
        export last kind: PointerKind;
        export last modifiers: Modifiers;

        #Internal
        export let init = func(x: float64, y: float64, button: uint8, kind: PointerKind, modifiers: Modifiers) => set;
    );

    #[Final, Immutable]
    export let ScrollEvent = class (
        export last top: float64;
        export last left: float64;

        #Internal
        export let init = func(top: float64, left: float64) => set;
    );

    #[Final, Immutable]
    export let ToggleEvent = class (
        export last open: bool;

        #Internal
        export let init = func(open: bool) => set;
    );

    #[Final, Immutable]
    export let CloseEvent = class (
        export last return_value: string;

        #Internal
        export let init = func(return_value: string) => set;
    );

    // State, components and roots (docs/apps/Components.md).

    /// @brief Stops one subscriber of a `State`. `close()` may be called any number of times.
    #[Final, NotThreadSafe]
    export let Subscription = class (
        let open: bool = true;

        /// @brief Stops the notifications. Later calls do nothing.
        export let close = func {
            open = false;
        };

        /// @brief Reports whether the subscriber is still notified.
        export let is_open = func -> bool => open;

        /// @brief `Subscription(open)` or `Subscription(closed)`.
        export let.override to_string = func -> string {
            if (open) {
                return "Subscription(open)";
            }
            return "Subscription(closed)";
        };
    );

    /// @brief One subscriber of a state and the handle that closes it.
    #[Final, NotThreadSafe]
    let Subscriber = class<T> (
        export last handle: Subscription;
        export last listener: func(T) -> void;

        export let init = func(handle: Subscription, listener: func(T) -> void) => set;

        /// @brief `Subscriber(` and its subscription `)`.
        export let.override to_string = func -> string => "Subscriber(" + handle.to_string() + ")";
    );

    /// @brief One value of a deeply immutable type, observed by subscribers in one task.
    /// `T` must be deeply immutable (E0580). Each accepted `set` or `update` replaces the value at
    /// once and notifies every open subscriber once, in subscription order, with the new value,
    /// even when it equals the old one, unless the state was built with an `equal` function that
    /// reports the two equal. A `set` made while the state is notifying replaces the value and
    /// queues its notification, which runs when the current round ends; more than 100 rounds in
    /// one notification traps with `state update loop`.
    #[Final, NotThreadSafe, Frozen]
    export let State = class<T> (
        let value: T;
        let equal: func(T, T) -> bool;
        let has_equal: bool = false;
        let subscribers: Subscriber<T>[list] = new;
        let pending: T[list] = new;
        let notifying: bool = false;

        /// @brief A state holding `initial` that notifies on every accepted update.
        export let init = func(initial: T) {
            value = initial;
            equal = new func(a: T, b: T) -> bool => false;
        };

        /// @brief Returns the current value.
        export let get = func -> T => value;

        /// @brief Replaces the value and notifies, unless the `equal` function given to `with_equality` reports the old and new values equal.
        export let set = func(next: T) {
            if (has_equal) {
                last same = equal;
                if (same(value, next)) {
                    return;
                }
            }
            value = next;
            if (notifying) {
                pending.append(next);
                return;
            }
            notifying = true;
            deliver(next);
            let rounds = 1;
            while (pending.length > 0) {
                rounds += 1;
                if (rounds > 100) {
                    trap_with_message("state update loop");
                }
                last queued = pending[0];
                pending.remove_at(0);
                deliver(queued);
            }
            notifying = false;
        };

        /// @brief Calls `change` once with the current value and sets its result. `change` is not retained.
        export let update = func(change: func(T) -> T) {
            set(change(value));
        };

        /// @brief Adds a subscriber that is notified after each accepted update until its subscription is closed.
        export let subscribe = func(listener: func(T) -> void) -> Subscription {
            last handle = new Subscription();
            subscribers.append(new Subscriber<T>(handle, listener));
            return handle;
        };

        /// @brief The number of subscribers whose subscription is open.
        export let subscriber_count = func -> int {
            let count = 0;
            for (let i = 0; i < subscribers.length; i++) {
                if (subscribers[i].handle.is_open()) {
                    count += 1;
                }
            }
            return count;
        };

        /// @brief Suppresses the notification of an update whose value `same` reports equal to the current one. `same` is retained.
        #Internal
        export let use_equality = func(same: func(T, T) -> bool) {
            equal = same;
            has_equal = true;
        };

        let deliver = func(current: T) {
            last count = subscribers.length;
            for (let i = 0; i < count; i++) {
                last entry = subscribers[i];
                if (entry.handle.is_open()) {
                    last listener = entry.listener;
                    listener(current);
                }
            }
            let j = 0;
            while (j < subscribers.length) {
                if (subscribers[j].handle.is_open()) {
                    j += 1;
                } else {
                    subscribers.remove_at(j);
                }
            }
        };

        /// @brief `State(` and the value's text `)`.
        export let.override to_string = func -> string => "State(" + value.to_string() + ")";
    );

    /// @brief A state holding `initial` whose updates notify only when `same(old, new)` is false. `same` is retained.
    export let with_equality = func<T>(initial: T, same: func(T, T) -> bool) -> State<T> {
        last state = new State<T>(initial);
        state.use_equality(same);
        return state;
    };

    /// @brief A state and the function that renders a view of its value, mounted at most once at a time.
    /// Build one with `component`. It renders when it is mounted and after each turn in which its state
    /// notified; unmounting closes its subscription and raises its generation.
    #[Final, NotThreadSafe]
    export let Component = class (
        last render_view: func() -> View;
        last attach: func(Component) -> Subscription;
        #Internal
        export let subscription: Subscription = nil;
        #Internal
        export let children: Component[list] = new;
        #Internal
        export let owner: Root = nil;
        #Internal
        export let dirty: bool = false;
        #Internal
        export let view: View = nil;
        let generation_count: uint64 = 0;
        let render_total: int64 = 0;
        /// Called with the root each time the component is mounted, after it subscribes.
        #Internal
        export let mount_actions: (func(Root) -> void)[list] = new;
        /// Called each time the component is unmounted, after its children and before its generation rises.
        #Internal
        export let unmount_actions: (func() -> void)[list] = new;

        #Internal
        export let init = func(render_view: func() -> View, attach: func(Component) -> Subscription) => set;

        /// @brief Raised by each unmount; a completion or event that carries an older generation is discarded.
        export let generation = func -> uint64 => generation_count;

        /// @brief Reports whether the component is part of a root.
        export let is_mounted = func -> bool => owner != nil;

        /// @brief The number of times the component has rendered.
        export let render_count = func -> int64 => render_total;

        /// @brief The view of the last render, or nil before the first.
        export let current_view = func -> View => view;

        /// @brief Marks the component for rendering at the end of the turn, when it is mounted.
        #Internal
        export let invalidate = func {
            if (owner != nil) {
                dirty = true;
            }
        };

        #Internal
        export let render_now = func -> View {
            last render = render_view;
            last next = render();
            view = next;
            dirty = false;
            render_total += 1;
            return next;
        };

        #Internal
        export let attach_to = func(root: Root) {
            owner = root;
            last subscribe = attach;
            subscription = subscribe(instance);
            dirty = true;
            for (let i = 0; i < mount_actions.length; i++) {
                last action = mount_actions[i];
                action(root);
            }
        };

        #Internal
        export let detach = func {
            for (let i = 0; i < children.length; i++) {
                children[i].detach();
            }
            children = new;
            if (subscription != nil) {
                subscription.close();
                subscription = nil;
            }
            for (let i = 0; i < unmount_actions.length; i++) {
                last action = unmount_actions[i];
                action();
            }
            owner = nil;
            dirty = false;
            view = nil;
            generation_count += 1;
        };

        /// @brief `Component(generation N, mounted)` or `Component(generation N)`.
        export let.override to_string = func -> string {
            if (owner != nil) {
                return "Component(generation " + generation_count.to_string() + ", mounted)";
            }
            return "Component(generation " + generation_count.to_string() + ")";
        };
    );

    /// @brief A component that renders `state`'s value with `render`. `render` is retained, so a
    /// capturing function is written `new func`. Rendering should only read and allocate; the
    /// compiler does not check that yet.
    export let component = func<T>(state: State<T>, render: func(T) -> View) -> Component =>
        new Component(
            new func() -> View => render(state.get()),
            new func(target: Component) -> Subscription => state.subscribe(new func(value: T) {
                target.invalidate();
            }));

    /// @brief A view that embeds `child`. The child renders by itself when its own state changes;
    /// the parent's render does not run again for it.
    export let slot = func(child: Component) -> View => new View("neura:slot", 0, new storage.Payload<Component>(0, child));

    /// @brief Why a commit failed validation.
    export let DiagnosticKind = enum (ViewReused, DuplicateKey, LimitExceeded);

    /// @brief A commit the host refused without changing anything.
    #[Final, Immutable]
    export let Diagnostic = class (
        export last kind: DiagnosticKind;
        export last message: string;
        export last slot: uint32;
        export last index: int64;
        export last key: string;

        export let init = func(kind: DiagnosticKind, message: string, slot: uint32, index: int64, key: string) => set;

        /// @brief The kind and the message.
        export let.override to_string = func -> string => kind.to_string() + ": " + message;

        /// @brief Another diagnostic with equal fields.
        export let.override equals = func(other: class) -> bool {
            if (!(other is Diagnostic)) {
                return false;
            }
            last that = other as Diagnostic;
            return kind == that.kind && message == that.message && slot == that.slot && index == that.index
                && key == that.key;
        };

        /// @brief Combines the hashes of the fields.
        export let.override hash_code = func -> uint32 =>
            kind.hash_code() ^ message.hash_code() ^ slot.hash_code() ^ index.hash_code() ^ key.hash_code();
    );

    /// @brief What a host did with a commit: applied it, or refused it and kept the previous view.
    export let RenderOutcome = enum (Committed, Invalid(Diagnostic));

    /// @brief A failed commit, as given to a root's render-failure handler. `Fault` means the host
    /// failed while applying: the root stops taking events until `reset`.
    export let RenderFailure = enum (Invalid(Diagnostic), Fault(Error));

    /// @brief A root-level event: events were dropped while the root was overloaded.
    export let RootEvent = enum (InputOverflow(uint32));

    /// @brief One component and the view it rendered in a turn.
    #[Final, NotThreadSafe]
    export let Rendered = class (
        export last component: Component;
        export last view: View;

        #Internal
        export let init = func(component: Component, view: View) => set;

        /// @brief `Rendered(` the component `)`.
        export let.override to_string = func -> string => "Rendered(" + component.to_string() + ")";
    );

    /// @brief The renders of one turn, parents before children, sent to the host as one request.
    #[Final, NotThreadSafe]
    export let Commit = class (
        export last sequence: uint64;
        export last rendered: Rendered[list];

        #Internal
        export let init = func(sequence: uint64, rendered: Rendered[list]) => set;

        /// @brief `Commit(` the sequence number and the number of renders `)`.
        export let.override to_string = func -> string =>
            "Commit(" + sequence.to_string() + ", " + rendered.length.to_string() + " renders)";
    );

    /// @brief The services a root needs from the document or window that shows it. The web, desktop
    /// and model hosts implement it; `mount` takes one.
    export let Host = interface (
        /// @brief Opens a root on `target` (a selector or a window name); `Err` for a second root on one target or too many roots.
        let open = func(target: string) -> result.Result<uint64>;
        /// @brief Applies one turn's renders.
        let commit = func(root: uint64, batch: Commit) -> result.Result<RenderOutcome>;
        /// @brief Waits until events arrive and posts them with `root.post`; false when no event will ever come.
        let wait = func(root: Root) -> bool;
        /// @brief After an input overflow, posts one input event for each controlled element whose value changed.
        let resynchronize = func(root: Root);
        /// @brief Empties a faulted root so that it accepts a fresh view.
        let reset = func(root: uint64);
        /// @brief Closes the root.
        let close = func(root: uint64);
    );

    /// @brief One event waiting in a root's queue.
    #[Final, NotThreadSafe]
    let QueuedEvent = class (
        export last listener: uint64;
        export last target: Component;
        export last generation: uint64;
        export last coalesce: bool;
        export let deliver: func() -> void;
        export last overflow: uint32;

        export let init = func(listener: uint64, target: Component, generation: uint64, coalesce: bool,
                               deliver: func() -> void, overflow: uint32) => set;

        /// @brief `QueuedEvent(` the listener, or the overflow count `)`.
        export let.override to_string = func -> string {
            if (overflow > 0) {
                return "QueuedEvent(overflow " + overflow.to_string() + ")";
            }
            return "QueuedEvent(listener " + listener.to_string() + ")";
        };
    );

    /// The listener number of a navigation in a root's queue.
    let navigation_listener: uint64 = 18446744073709551615;

    /// Starts one command run; its only use is to give a run's start function a type of its own.
    #[Final, Immutable]
    let Launch = class (
        export last ticket: uint64;

        export let init = func(ticket: uint64) => set;

        /// @brief `Launch(` the ticket `)`.
        export let.override to_string = func -> string => "Launch(" + ticket.to_string() + ")";
    );

    /// One command run registered with a root.
    #[Final, NotThreadSafe]
    let Ticket = class (
        export last id: uint64;
        export last launch: func(Launch, channels.Sender<uint64>) -> void;
        export last finish: func(uint64) -> bool;
        export last cancel: func() -> void;
        export let stopped: bool = false;

        export let init = func(id: uint64, launch: func(Launch, channels.Sender<uint64>) -> void,
                               finish: func(uint64) -> bool, cancel: func() -> void) => set;

        /// Asks the run to cancel, once.
        export let stop = func {
            if (!stopped) {
                stopped = true;
                last request = cancel;
                request();
            }
        };

        /// @brief `Ticket(` the id `)`.
        export let.override to_string = func -> string => "Ticket(" + id.to_string() + ")";
    );

    /// What one turn's renders changed in the component tree, so that a refused commit can undo it.
    #[Final, NotThreadSafe]
    let Journal = class (
        export last nodes: Component[list] = new;
        export last old_children: (Component[list])[list] = new;
        export last old_views: View[list] = new;
        export last attached: Component[list] = new;
        export last removed: Component[list] = new;

        /// Records `node`'s children and view before it renders.
        export let rendering = func(node: Component) {
            nodes.append(node);
            old_children.append(node.children);
            old_views.append(node.view);
        };

        /// Reports whether `child` was dropped earlier in this turn, and takes it off that list.
        export let moved = func(child: Component) -> bool {
            for (let i = 0; i < removed.length; i++) {
                if (removed[i] == child) {
                    removed.remove_at(i);
                    return true;
                }
            }
            return false;
        };

        /// Unmounts the children this turn mounted and restores every rendered component's children and view.
        export let roll_back = func {
            for (let i = attached.length - 1; i >= 0; i--) {
                if (attached[i].owner != nil) {
                    attached[i].detach();
                }
            }
            for (let i = nodes.length - 1; i >= 0; i--) {
                nodes[i].children = old_children[i];
                nodes[i].view = old_views[i];
            }
        };

        /// @brief `Journal(` the numbers of renders, mounts and unmounts `)`.
        export let.override to_string = func -> string =>
            "Journal(" + nodes.length.to_string() + " renders, " + attached.length.to_string() + " mounted, "
            + removed.length.to_string() + " unmounted)";
    );

    /// @brief Counts that show what a root holds and has done.
    #[Final, Immutable]
    export let RootStats = class (
        export last components: int32;
        export last subscriptions: int32;
        export last queued: int32;
        export last turns: uint64;
        export last renders: uint64;
        export last commits: uint64;
        export last dropped: uint64;
        export last discarded: uint64;

        #Internal
        export let init = func(components: int32, subscriptions: int32, queued: int32, turns: uint64, renders: uint64,
                               commits: uint64, dropped: uint64, discarded: uint64) => set;

        /// @brief Every count, by name.
        export let.override to_string = func -> string =>
            "components " + components.to_string() + ", subscriptions " + subscriptions.to_string() + ", queued "
            + queued.to_string() + ", turns " + turns.to_string() + ", renders " + renders.to_string() + ", commits "
            + commits.to_string() + ", dropped " + dropped.to_string() + ", discarded " + discarded.to_string();

        /// @brief Other stats with equal counts.
        export let.override equals = func(other: class) -> bool {
            if (!(other is RootStats)) {
                return false;
            }
            return to_string() == (other as RootStats).to_string();
        };

        /// @brief The hash of the counts' text.
        export let.override hash_code = func -> uint32 => to_string().hash_code();
    );

    /// @brief A mounted component tree and its event loop. One turn takes the next event, calls its
    /// handler, renders each component whose state notified, once, parents before children, and
    /// commits the renders as one host request.
    #[Final, NotThreadSafe]
    export let Root = class (
        last host: Host;
        last handle: uint64;
        last top: Component;
        let queue: QueuedEvent[list] = new;
        let queue_limit: int = 1024;
        let dropped: uint32 = 0;
        let closed: bool = false;
        let faulted: bool = false;
        let failure_handler: func(RenderFailure) -> void;
        let overflow_handler: func(RootEvent) -> void;
        let has_overflow_handler: bool = false;
        let resynchronizing: bool = false;
        let resynchronized: QueuedEvent[list] = new;
        let sequence: uint64 = 0;
        let turn_total: uint64 = 0;
        let render_total: uint64 = 0;
        let commit_total: uint64 = 0;
        let dropped_total: uint64 = 0;
        let discarded_total: uint64 = 0;
        // Commands: every ticket in flight, the launches not yet started, and the U-10 limit.
        let tickets: Ticket[list] = new;
        let launches: Ticket[list] = new;
        let ticket_count: uint64 = 0;
        let command_limit: int = 32;
        let running_commands: bool = false;
        let stale_total: uint64 = 0;
        // Navigations the host reports, and the element to focus after the turn's commit.
        let navigation: Subscriber<string>[list] = new;
        let pending_focus: string = "";

        #Internal
        export let init = func(host: Host, handle: uint64, top: Component) {
            instance.host = host;
            instance.handle = handle;
            instance.top = top;
            failure_handler = new func(failure: RenderFailure) {
                console.print_line("neura.ui: render failure: " + describe_failure(failure));
            };
            overflow_handler = new func(event: RootEvent) {};
        };

        /// @brief Replaces the handler of failed commits. The default prints the failure and keeps the previous view.
        export let on_render_failure = func(handler: func(RenderFailure) -> void) {
            failure_handler = handler;
        };

        /// @brief Sets the handler of `RootEvent.InputOverflow`, delivered before the first event accepted after an overflow.
        export let on_overflow = func(handler: func(RootEvent) -> void) {
            overflow_handler = handler;
            has_overflow_handler = true;
        };

        /// @brief Sets the number of queued events at which the root is overloaded (U-7, default 1,024; at most 65,536).
        export let set_queue_limit = func(limit: int) {
            if (limit < 1 || limit > 65536) {
                trap_with_message("invalid argument: a queue limit is 1 to 65,536 events");
            }
            queue_limit = limit;
        };

        /// @brief The host's handle of this root.
        export let host_handle = func -> uint64 => handle;

        /// @brief The component the root was mounted with.
        export let component = func -> Component => top;

        /// @brief Reports whether the root stopped after a host failure.
        export let is_faulted = func -> bool => faulted;

        /// @brief Reports whether the root was closed.
        export let is_closed = func -> bool => closed;

        /// @brief Reports whether events are being dropped because the queue is full.
        export let is_overloaded = func -> bool => dropped > 0;

        /// @brief Queues an event for `listener` of `target`, called by a host. A coalesced event
        /// replaces the queued one of the same listener and keeps its place. Over the queue limit an
        /// event that cannot be coalesced is dropped and counted, and false is returned. An event whose
        /// component unmounted before its turn is discarded.
        export let post = func(listener: uint64, target: Component, coalesce: bool, deliver: func() -> void) -> bool {
            if (closed) {
                return false;
            }
            if (resynchronizing) {
                last current = target == nil ? 0 : target.generation();
                resynchronized.append(new QueuedEvent(listener, target, current, false, deliver, 0));
                return true;
            }
            if (coalesce) {
                for (let i = 0; i < queue.length; i++) {
                    last queued = queue[i];
                    if (queued.coalesce && queued.listener == listener && queued.target == target) {
                        queued.deliver = deliver;
                        return true;
                    }
                }
            }
            if (queue.length >= queue_limit) {
                dropped += 1;
                dropped_total += 1;
                return false;
            }
            if (dropped > 0) {
                queue.append(new QueuedEvent(0, nil, 0, false, new func() {}, dropped));
                dropped = 0;
            }
            last generation = target == nil ? 0 : target.generation();
            queue.append(new QueuedEvent(listener, target, generation, coalesce, deliver, 0));
            return true;
        };

        /// @brief Runs one turn. Returns false when the root is closed or faulted, or the host has no more events.
        export let turn = func -> bool {
            if (closed || faulted) {
                return false;
            }
            if (queue.length == 0 && !host.wait(instance)) {
                return false;
            }
            if (queue.length == 0) {
                return !closed;
            }
            last event = queue[0];
            queue.remove_at(0);
            turn_total += 1;
            if (event.overflow > 0) {
                if (has_overflow_handler) {
                    last handler = overflow_handler;
                    handler(RootEvent.InputOverflow(event.overflow));
                }
                // The resynchronized inputs come before the events queued after the overflow.
                resynchronizing = true;
                host.resynchronize(instance);
                resynchronizing = false;
                if (resynchronized.length > 0) {
                    last merged = resynchronized;
                    for (let i = 0; i < queue.length; i++) {
                        merged.append(queue[i]);
                    }
                    queue = merged;
                    resynchronized = new;
                }
                flush();
                return !closed;
            }
            if (event.target != nil && (event.target.owner != instance || event.target.generation() != event.generation)) {
                discarded_total += 1;
                return true;
            }
            last deliver = event.deliver;
            deliver();
            flush();
            return !closed && !faulted;
        };

        /// @brief Runs turns until the root is closed or faulted, or the host has no more events. A root
        /// whose components run commands uses `run_with_commands` instead: a command started under `run`
        /// traps with `a command needs root.run_with_commands()`.
        export let run = func {
            while (true) {
                if (launches.length > 0) {
                    trap_with_message("a command needs root.run_with_commands()");
                }
                if (!turn()) {
                    return;
                }
            }
        };

        /// @brief Runs turns, as `run` does, inside a scope that owns every command task the root starts.
        /// Each turn is either the next event or the completion of a command. With commands in flight and
        /// no event queued, the root waits for both together when the host is a `TaskHost`, and otherwise
        /// for the next completion. It returns when the root is closed or faulted, or when the host has no
        /// more events and no command is in flight; it cancels the commands still running and returns
        /// after their tasks have finished.
        export let run_with_commands = func {
            if (running_commands) {
                trap_with_message("root.run_with_commands() is already running");
            }
            running_commands = true;
            scope (tasks) {
                const [done, completions, _] = channels.open<uint64>(1024);
                while (true) {
                    while (launches.length > 0) {
                        last next = launches[0];
                        launches.remove_at(0);
                        last start = next.launch;
                        spawn start(new Launch(next.id), done);
                    }
                    if (closed || faulted) {
                        break;
                    }
                    match (completions.try_receive()) {
                        channels.TryReceived.Value(ticket) => {
                            complete(ticket);
                            continue;
                        },
                        _ => {},
                    }
                    if (queue.length > 0) {
                        turn();
                        continue;
                    }
                    if (tickets.length == 0) {
                        if (!host.wait(instance)) {
                            break;
                        }
                        continue;
                    }
                    if (host is TaskHost) {
                        match ((host as TaskHost).wait_with(instance, completions)) {
                            Wake.Events => {},
                            Wake.Completed(ticket) => {
                                complete(ticket);
                            },
                            Wake.Ended => {
                                await_completion(completions);
                            },
                        }
                    } else {
                        await_completion(completions);
                    }
                }
                for (let i = 0; i < tickets.length; i++) {
                    tickets[i].stop();
                }
                launches = new;
                tasks.cancel();
            }
            // Every task has finished: apply what the stopped runs reported, outside any turn.
            last remaining = tickets;
            tickets = new;
            for (let i = 0; i < remaining.length; i++) {
                last finish = remaining[i].finish;
                if (!finish(remaining[i].id)) {
                    stale_total += 1;
                }
            }
            running_commands = false;
        };

        /// @brief Sets the number of commands in flight at which `Command.run` is rejected (U-10, default 32; at most 1,024).
        export let set_command_limit = func(limit: int) {
            if (limit < 1 || limit > 1024) {
                trap_with_message("invalid argument: a command limit is 1 to 1,024 commands");
            }
            command_limit = limit;
        };

        /// @brief The number of command runs started and not yet finished, the stopped ones included.
        export let commands_in_flight = func -> int32 => tickets.length as int32;

        /// @brief How many command completions were discarded because their generation was old.
        export let stale_completions = func -> uint64 => stale_total;

        /// @brief The host as a `HistoryHost`, or nil when it keeps no history.
        export let history = func -> HistoryHost {
            if (host is HistoryHost) {
                return host as HistoryHost;
            }
            return nil;
        };

        /// @brief Adds a listener for navigations the program did not make (back, forward, an edited
        /// address), which the host reports with `post_navigation`.
        export let on_navigation = func(listener: func(string) -> void) -> Subscription {
            last handle = new Subscription();
            navigation.append(new Subscriber<string>(handle, listener));
            return handle;
        };

        /// @brief Queues a navigation to `path`, called by a host. A queued navigation is replaced by a
        /// later one, and navigations are never dropped by the queue limit.
        export let post_navigation = func(path: string) {
            if (closed) {
                return;
            }
            last self = instance;
            last deliver = new func() {
                self.navigated(path);
            };
            for (let i = 0; i < queue.length; i++) {
                if (queue[i].listener == navigation_listener && queue[i].target == nil) {
                    queue[i].deliver = deliver;
                    return;
                }
            }
            queue.append(new QueuedEvent(navigation_listener, nil, 0, true, deliver, 0));
        };

        /// @brief Asks the host to focus the element whose `id` is `element_id` once the current turn has
        /// committed. A later request in the same turn replaces it; a host that is not a `FocusHost` ignores it.
        export let request_focus = func(element_id: string) {
            pending_focus = element_id;
        };

        #Internal
        export let navigated = func(path: string) {
            last count = navigation.length;
            for (let i = 0; i < count; i++) {
                last entry = navigation[i];
                if (entry.handle.is_open()) {
                    last listener = entry.listener;
                    listener(path);
                }
            }
            let j = 0;
            while (j < navigation.length) {
                if (navigation[j].handle.is_open()) {
                    j += 1;
                } else {
                    navigation.remove_at(j);
                }
            }
        };

        /// @brief Reports whether another command may start: fewer than the limit are in flight.
        #Internal
        export let can_launch = func -> bool => tickets.length < command_limit;

        /// @brief Registers a command run; `launch` starts its task under `run_with_commands`, `finish`
        /// applies its completion in a turn, and `stop` asks it to cancel.
        #Internal
        export let launch = func(start: func(Launch, channels.Sender<uint64>) -> void, finish: func(uint64) -> bool,
                                 stop: func() -> void) -> uint64 {
            ticket_count += 1;
            last ticket = new Ticket(ticket_count, start, finish, stop);
            tickets.append(ticket);
            launches.append(ticket);
            return ticket_count;
        };

        /// @brief Asks the run `id` to cancel. A run not started yet is dropped, never completes, and
        /// true is returned.
        #Internal
        export let stop_ticket = func(id: uint64) -> bool {
            for (let i = 0; i < launches.length; i++) {
                if (launches[i].id == id) {
                    launches.remove_at(i);
                    remove_ticket(id);
                    return true;
                }
            }
            for (let i = 0; i < tickets.length; i++) {
                if (tickets[i].id == id) {
                    tickets[i].stop();
                    return false;
                }
            }
            return true;
        };

        let remove_ticket = func(id: uint64) -> Ticket {
            for (let i = 0; i < tickets.length; i++) {
                if (tickets[i].id == id) {
                    last found = tickets[i];
                    tickets.remove_at(i);
                    return found;
                }
            }
            return nil;
        };

        // One turn: the completion of the run `id`.
        let complete = func(id: uint64) {
            last ticket = remove_ticket(id);
            if (ticket == nil || closed || faulted) {
                return;
            }
            turn_total += 1;
            last finish = ticket.finish;
            if (!finish(id)) {
                stale_total += 1;
            }
            flush();
        };

        let await_completion = func(completions: channels.Receiver<uint64>) {
            match (completions.receive()) {
                channels.Received.Value(ticket) => {
                    complete(ticket);
                },
                _ => {},
            }
        };

        /// @brief Clears a fault: the host empties the root, every component renders again and the root takes events.
        export let reset = func {
            if (closed) {
                return;
            }
            host.reset(handle);
            faulted = false;
            invalidate_all(top);
            flush();
        };

        /// @brief Unmounts the component tree and closes the root on the host.
        export let close = func {
            if (closed) {
                return;
            }
            closed = true;
            top.detach();
            queue = new;
            host.close(handle);
        };

        /// @brief The root's counts.
        export let stats = func -> RootStats {
            last counts: int32[] = [0, 0];
            count_tree(top, counts);
            return new RootStats(counts[0], counts[1], queue.length, turn_total, render_total, commit_total,
                                 dropped_total, discarded_total);
        };

        #Internal
        export let start = func {
            top.attach_to(instance);
            flush();
        };

        let count_tree = func(node: Component, counts: int32[]) {
            if (node.owner == nil) {
                return;
            }
            counts[0] += 1;
            if (node.subscription != nil && node.subscription.is_open()) {
                counts[1] += 1;
            }
            for (let i = 0; i < node.children.length; i++) {
                count_tree(node.children[i], counts);
            }
        };

        let invalidate_all = func(node: Component) {
            node.dirty = true;
            for (let i = 0; i < node.children.length; i++) {
                invalidate_all(node.children[i]);
            }
        };

        let flush = func {
            if (closed || faulted) {
                return;
            }
            commit_renders();
            if (pending_focus != "" && !closed && !faulted) {
                last element = pending_focus;
                pending_focus = "";
                if (host is FocusHost) {
                    (host as FocusHost).focus(handle, element);
                }
            }
        };

        // Renders the dirty components and commits them. The children a render embeds are mounted
        // at once, and the ones it drops are unmounted only when the host commits; a refused or failed
        // commit unmounts the new children and restores each rendered component's children and view.
        let commit_renders = func {
            last journal = new Journal();
            last rendered: Rendered[list] = new;
            render_tree(top, rendered, journal);
            if (rendered.length == 0) {
                return;
            }
            sequence += 1;
            match (host.commit(handle, new Commit(sequence, rendered))) {
                result.Result.Ok(outcome) => {
                    match (outcome) {
                        RenderOutcome.Committed => {
                            commit_total += 1;
                            for (let i = 0; i < journal.removed.length; i++) {
                                if (journal.removed[i].owner != nil) {
                                    journal.removed[i].detach();
                                }
                            }
                        },
                        RenderOutcome.Invalid(diagnostic) => {
                            journal.roll_back();
                            last handler = failure_handler;
                            handler(RenderFailure.Invalid(diagnostic));
                        },
                    }
                },
                result.Result.Err(problem) => {
                    journal.roll_back();
                    faulted = true;
                    last handler = failure_handler;
                    handler(RenderFailure.Fault(problem));
                },
            }
        };

        let render_tree = func(node: Component, out: Rendered[list], journal: Journal) {
            if (node.dirty) {
                journal.rendering(node);
                last view = node.render_now();
                render_total += 1;
                out.append(new Rendered(node, view));
                last found: Component[list] = new;
                children_of(view, found);
                for (let i = 0; i < node.children.length; i++) {
                    last old = node.children[i];
                    if (!contains_component(found, old)) {
                        journal.removed.append(old);
                    }
                }
                for (let i = 0; i < found.length; i++) {
                    last child = found[i];
                    if (!contains_component(node.children, child)) {
                        if (child.owner == nil) {
                            child.attach_to(instance);
                            journal.attached.append(child);
                        } else if (child.owner == instance && journal.moved(child)) {
                            // Dropped by a parent rendered earlier in this turn: the child moves.
                        } else {
                            trap_with_message("a component is mounted twice");
                        }
                    }
                }
                node.children = found;
            }
            for (let i = 0; i < node.children.length; i++) {
                render_tree(node.children[i], out, journal);
            }
        };

        /// @brief `Root(handle N)` with its state.
        export let.override to_string = func -> string {
            let text = "Root(handle " + handle.to_string();
            if (closed) {
                text = text + ", closed";
            }
            if (faulted) {
                text = text + ", faulted";
            }
            return text + ")";
        };
    );

    let contains_component = func(items: Component[list], item: Component) -> bool {
        for (let i = 0; i < items.length; i++) {
            if (items[i] == item) {
                return true;
            }
        }
        return false;
    };

    // The components embedded by slots in `view`, in document order.
    let children_of = func(view: View, found: Component[list]) {
        if (view == nil) {
            return;
        }
        let slot = view.slots;
        while (slot != nil) {
            if (slot is storage.Payload<Component>) {
                found.append((slot as storage.Payload<Component>).value);
            } else if (slot is storage.Payload<View>) {
                children_of((slot as storage.Payload<View>).value, found);
            } else if (slot is storage.Payload<build.Items>) {
                let item = (slot as storage.Payload<build.Items>).value.first;
                while (item != nil) {
                    children_of(item.view, found);
                    item = item.next;
                }
            }
            slot = slot.next;
        }
    };

    let describe_failure = func(failure: RenderFailure) -> string => match (failure) {
        RenderFailure.Invalid(diagnostic) => "invalid commit: " + diagnostic.to_string(),
        RenderFailure.Fault(problem) => "host fault: " + error.message(problem),
    };

    // Commands and the optional host services (docs/apps/Components.md#commands).

    /// @brief What a root's `TaskHost.wait_with` saw first.
    export let Wake = enum (
        /// The host posted events to the root.
        Events,
        /// A command run finished; its ticket, read from the completions channel.
        Completed(uint64),
        /// The host has no more events; the root waits for the commands in flight.
        Ended
    );

    /// @brief A host that can wait for its own events and for command completions together. A root
    /// whose commands are in flight, with no event queued, calls `wait_with` instead of `wait`. The
    /// host returns `Events` after posting events, or `Completed` with a value it received from
    /// `completions`, whichever comes first, and `Ended` when no event will ever come. A host may open
    /// a scope of its own for the wait, for example to race a host request against the channel, as long
    /// as every task it starts has finished when `wait_with` returns.
    export let TaskHost = interface (
        let wait_with = func(root: Root, completions: channels.Receiver<uint64>) -> Wake;
    );

    /// @brief A host that keeps the history of a document: the router reads and changes the location
    /// through it. Paths are absolute (`/parts/7`). The host reports a navigation the program did not
    /// make with `root.post_navigation(path)`.
    export let HistoryHost = interface (
        /// @brief The current path.
        let location = func() -> string;
        /// @brief Adds `path` to the history without loading a page; returns the current path.
        let push_location = func(path: string) -> string;
        /// @brief Replaces the current entry with `path`; returns the current path.
        let replace_location = func(path: string) -> string;
        /// @brief The `href` text of a link to `path` in this host's routing mode (`#/parts/7` for hash routing).
        let link = func(path: string) -> string;
    );

    /// @brief A host that can move the keyboard focus to an element of a root, named by its `id`.
    export let FocusHost = interface (
        /// @brief Focuses the element; false when the root has no element with that `id`.
        let focus = func(root: uint64, element_id: string) -> bool;
    );

    /// @brief What `Command.run` did: started the work, or started nothing.
    export let RunOutcome = enum (Started, Rejected);

    /// @brief The state of a command: never run, running, or how its latest run ended.
    export let CommandState = enum<O> (Idle, Running, Succeeded(O), Failed(error.PortableError), Cancelled);

    /// One finished run and the generation it was started in.
    #[Final, Immutable]
    let Finished = class<O> (
        export last generation: uint64;
        export last state: CommandState<O>;

        export let init = func(generation: uint64, state: CommandState<O>) => set;

        /// @brief `Finished(` the generation `)`.
        export let.override to_string = func -> string => "Finished(generation " + generation.to_string() + ")";
    );

    // The task of one command run: it runs `work` in a scope of its own, so that stopping the run
    // cancels only that work, then reports the outcome and the ticket.
    let perform = func<I, O>(work: func(I) -> result.Result<O>, input: I, generation: uint64,
                             results: channels.Sender<Finished<O>>, stop: channels.Receiver<int>,
                             done: channels.Sender<uint64>, ticket: uint64) {
        scope (own) {
            let job = spawn work(input);
            select {
                let outcome = job.join() => {
                    match (outcome) {
                        result.Result.Ok(value) => {
                            results.try_send(new Finished<O>(generation, CommandState<O>.Succeeded(value)));
                        },
                        result.Result.Err(problem) => {
                            results.try_send(new Finished<O>(generation,
                                CommandState<O>.Failed(error.to_portable(problem))));
                        },
                    }
                },
                let _ = stop.receive() => {
                    own.cancel();
                    let _ = job.join();
                    results.try_send(new Finished<O>(generation, CommandState<O>.Cancelled));
                },
            }
        }
        done.send(ticket);
    };

    /// @brief Work that waits, started from a handler and finished in a later turn. `work` runs as a
    /// task in the scope of `root.run_with_commands`, so it must be task-safe and its captures, `I` and
    /// `O` transferable (E0601, E0602); its failure reaches the component as a `PortableError`. The
    /// command's `state` is a `State` that components render. Each `run`, each `cancel` of a running
    /// command and each unmount of the component the command is bound to raise its generation, and a
    /// completion of an older generation changes nothing. `work` learns of a cancellation through
    /// `Std.Concurrent.Cancellation.requested()` or a parked operation that returns `Cancelled`.
    #[Final, NotThreadSafe]
    export let Command = class<I, O> (
        last work: func(I) -> result.Result<O>;
        /// @brief `Idle` until the first run, `Running` while the latest run works, then how it ended.
        export last state: State<CommandState<O>>;
        let owner: Component = nil;
        let generation_count: uint64 = 0;
        let in_flight: uint64[list] = new;
        let running_root: Root = nil;

        /// @brief A command that runs `work`. Bind it to a component with `bind` before running it.
        export let init = func(work: func(I) -> result.Result<O>) {
            instance.work = work;
            state = new State<CommandState<O>>(CommandState<O>.Idle);
        };

        /// @brief Makes `component` the command's owner: the command runs on the owner's root, and
        /// unmounting the owner cancels the command and raises its generation. A command is bound once.
        export let bind = func(component: Component) {
            if (owner != nil) {
                trap_with_message("a command is bound to one component");
            }
            owner = component;
            last self = instance;
            component.unmount_actions.append(new func() {
                self.abandon();
            });
        };

        /// @brief Starts `work(input)` on the owner's root and sets the state to `Running`. `Rejected`,
        /// with nothing started, when the command is not bound to a mounted component or the root already
        /// has its limit of commands in flight (U-10, 32 by default).
        export let run = func(input: I) -> RunOutcome {
            if (owner == nil || owner.owner == nil || !owner.owner.can_launch()) {
                return RunOutcome.Rejected;
            }
            last root = owner.owner;
            generation_count += 1;
            last generation = generation_count;
            const [results, outcomes, _] = channels.open<Finished<O>>(1);
            const [_, stop, stopping] = channels.open<int>(0);
            last job = work;
            last self = instance;
            last ticket = root.launch(
                new func(launch: Launch, done: channels.Sender<uint64>) {
                    perform<I, O>(job, input, generation, results, stop, done, launch.ticket);
                },
                new func(id: uint64) -> bool => self.finish(id, outcomes),
                new func() {
                    stopping.close();
                });
            in_flight.append(ticket);
            running_root = root;
            state.set(CommandState<O>.Running);
            return RunOutcome.Started;
        };

        /// @brief Cancels the runs in flight, raises the generation and sets the state to `Cancelled`.
        /// A command with no run in flight is left as it is.
        export let cancel = func {
            if (in_flight.length == 0) {
                return;
            }
            stop_all();
            generation_count += 1;
            state.set(CommandState<O>.Cancelled);
        };

        /// @brief Raised by each run, each cancel of a running command and each unmount of the owner.
        export let generation = func -> uint64 => generation_count;

        /// @brief The number of this command's runs that have not finished.
        export let runs_in_flight = func -> int32 => in_flight.length as int32;

        /// Unmounting the owner: cancel the runs in flight and raise the generation.
        #Internal
        export let abandon = func {
            last running = in_flight.length > 0;
            stop_all();
            generation_count += 1;
            if (running) {
                state.set(CommandState<O>.Cancelled);
            }
        };

        /// Applies a finished run in the root's turn; false when its generation is old.
        #Internal
        export let finish = func(ticket: uint64, outcomes: channels.Receiver<Finished<O>>) -> bool {
            forget(ticket);
            match (outcomes.try_receive()) {
                channels.TryReceived.Value(finished) => {
                    if (finished.generation != generation_count) {
                        return false;
                    }
                    state.set(finished.state);
                    return true;
                },
                _ => {
                    return false;
                },
            }
        };

        let stop_all = func {
            let i = 0;
            while (i < in_flight.length) {
                if (running_root == nil || running_root.stop_ticket(in_flight[i])) {
                    in_flight.remove_at(i);
                } else {
                    i += 1;
                }
            }
        };

        let forget = func(ticket: uint64) {
            for (let i = 0; i < in_flight.length; i++) {
                if (in_flight[i] == ticket) {
                    in_flight.remove_at(i);
                    return;
                }
            }
        };

        /// @brief `Command(generation N, M in flight)`.
        export let.override to_string = func -> string =>
            "Command(generation " + generation_count.to_string() + ", " + in_flight.length.to_string() + " in flight)";
    );

    /// @brief Opens a root on `target` of `host`, renders `top` and commits it. `Err` when the host
    /// refuses the target (a second root on one element, more than U-9 roots) or `top` is mounted.
    export let mount = func(host: Host, target: string, top: Component) -> result.Result<Root> {
        if (top.is_mounted()) {
            return result.Result<Root>.Err(error.custom("ui.mounted", "the component is already mounted"));
        }
        match (host.open(target)) {
            result.Result.Ok(handle) => {
                last root = new Root(host, handle, top);
                root.start();
                return result.Result<Root>.Ok(root);
            },
            result.Result.Err(problem) => {
                return result.Result<Root>.Err(problem);
            },
        }
    };
);
