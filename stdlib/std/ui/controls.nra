let forms = import:Std.Ui.Forms;
let frozen = import:Std.Collections.Frozen;
let optional = import:Std.Core.Optional;
let ui = import:Std.Ui;

/// @brief Controls over the platform's own elements: text inputs, checkboxes, selects, buttons, forms,
/// lists, tables and dialogs. Each control that keeps state is a component over a `ui.State`, so it
/// renders alone when its state changes, and each uses the real element (`input`, `select`, `button`,
/// `form`, `ul`, `table`, `dialog`), so focus, keyboard use and accessibility come from the browser.
/// The markup is plain and unstyled: give the page a stylesheet. A view given to a control comes
/// from a render function, because a control renders a fresh view each time.
#Since("0.3.0")
export let Controls = module (
    /// @brief One option of a `select`: the value submitted and the text shown.
    #[Final, Immutable]
    export let Choice = class (
        export last value: string;
        export last label: string;

        export let init = func(value: string, label: string) => set;

        /// @brief `value: label`.
        export let.override to_string = func -> string => value .. ": " .. label;

        /// @brief Another choice with the same value and label.
        export let.override equals = func(other: class) -> bool {
            if (other is not that: Choice) {
                return false;
            }
            return value == that.value && label == that.label;
        };

        /// @brief Combines the hashes of the value and label.
        export let.override hash_code = func -> uint32 => value.hash_code() ^ label.hash_code();
    );

    /// @brief One row of a `table`: a key that stays with the row when rows move, and its cells' text.
    #[Final, Immutable]
    export let TableRow = class (
        export last key: string;
        export last cells: frozen.FrozenList<string>;

        export let init = func(key: string, cells: frozen.FrozenList<string>) => set;

        /// @brief `TableRow(` the key `)`.
        export let.override to_string = func -> string => "TableRow(" .. key .. ")";

        /// @brief Another row with the same key and cells.
        export let.override equals = func(other: class) -> bool {
            if (other is not that: TableRow) {
                return false;
            }
            return key == that.key && cells.equals(that.cells);
        };

        /// @brief Combines the hashes of the key and cells.
        export let.override hash_code = func -> uint32 => key.hash_code() ^ cells.hash_code();
    );

    let text_input_view = html(id: string, label: string, kind: string, value: string, invalid: bool,
        described: optional.Optional<string>, error_id: string, message: string,
        on_input: func(ui.InputEvent) -> void, on_blur: func(ui.FocusEvent) -> void) {
        <div>
            <label for={id}>{label}</label>
            <input id={id} name={id} type={kind} prop:value={value} aria-invalid={invalid}
                   aria-describedby={described} on:input={on_input} on:blur={on_blur}>
            @if (invalid) {
                <p id={error_id} role="alert">{message}</p>
            }
        </div>
    };

    let text_area_view = html(id: string, label: string, value: string, invalid: bool,
        described: optional.Optional<string>, error_id: string, message: string,
        on_input: func(ui.InputEvent) -> void, on_blur: func(ui.FocusEvent) -> void) {
        <div>
            <label for={id}>{label}</label>
            <textarea id={id} name={id} prop:value={value} aria-invalid={invalid} aria-describedby={described}
                      on:input={on_input} on:blur={on_blur}></textarea>
            @if (invalid) {
                <p id={error_id} role="alert">{message}</p>
            }
        </div>
    };

    let checkbox_view = html(id: string, label: string, checked: bool, on_change: func(ui.ChangeEvent) -> void) {
        <div>
            <input id={id} name={id} type="checkbox" prop:checked={checked} on:change={on_change}>
            <label for={id}>{label}</label>
        </div>
    };

    let select_view = html(id: string, label: string, value: string, choices: frozen.FrozenList<Choice>,
        on_change: func(ui.ChangeEvent) -> void) {
        <div>
            <label for={id}>{label}</label>
            <select id={id} name={id} prop:value={value} on:change={on_change}>
                @for (const choice in choices; key: choice.value) {
                    <option value={choice.value} prop:selected={choice.value == value}>{choice.label}</option>
                }
            </select>
        </div>
    };

    let button_view = html(label: string, on_click: func(ui.ClickEvent) -> void) {
        <button type="button" on:click={on_click}>{label}</button>
    };

    let submit_view = html(label: string) {
        <button type="submit">{label}</button>
    };

    let form_view = html(on_submit: func(ui.SubmitEvent) -> void, content: ui.View) {
        <form novalidate on:submit.prevent_default={on_submit}>{content}</form>
    };

    let list_view = html(indexes: frozen.FrozenList<int32>, keys: string[list], views: ui.View[list]) {
        <ul>
            @for (const index in indexes; key: keys[index]) {
                <li>{views[index]}</li>
            }
        </ul>
    };

    let table_view = html(caption: string, columns: frozen.FrozenList<string>, positions: frozen.FrozenList<int32>,
        rows: frozen.FrozenList<TableRow>) {
        <table>
            <caption>{caption}</caption>
            <thead>
                <tr>
                    @for (const column in columns; key: column) {
                        <th scope="col">{column}</th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (const row in rows; key: row.key) {
                    <tr>
                        @for (const position in positions; key: position) {
                            <td>{row.cells.get(position as int)}</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    };

    let dialog_view = html(id: string, title_id: string, title: string, open: bool, content: ui.View,
        on_close: func(ui.CloseEvent) -> void, on_dismiss: func(ui.ClickEvent) -> void) {
        <dialog id={id} aria-labelledby={title_id} prop:open={open} on:close={on_close}>
            <h2 id={title_id}>{title}</h2>
            {content}
            <button type="button" on:click={on_dismiss}>Close</button>
        </dialog>
    };

    /// @brief A labelled `input` of the type `kind` (`text`, `email`, `password`, `search`, `tel`,
    /// `url` or `number`) over `field`: typing sets the draft, leaving the input touches the field,
    /// and a touched invalid field shows its message in an alert linked by `aria-describedby`.
    export let text_input = func<T>(field: forms.Field<T>, kind: string) -> ui.Component {
        if (kind != "text" && kind != "email" && kind != "password" && kind != "search" && kind != "tel"
            && kind != "url" && kind != "number") {
            trap_with_message("invalid argument: an input kind is text, email, password, search, tel, url or number");
        }
        last id = field.element_id();
        last label = field.label();
        last on_input = field.on_input();
        last on_blur = field.on_blur();
        return ui.component<forms.FieldState>(field.state, new func(state: forms.FieldState) -> ui.View =>
            text_input_view(id, label, kind, state.draft, state.shows_error(), described_by(id, state),
                id .. "-error", state.message, on_input, on_blur));
    };

    /// @brief A labelled `textarea` over `field`, as `text_input`.
    export let text_area = func<T>(field: forms.Field<T>) -> ui.Component {
        last id = field.element_id();
        last label = field.label();
        last on_input = field.on_input();
        last on_blur = field.on_blur();
        return ui.component<forms.FieldState>(field.state, new func(state: forms.FieldState) -> ui.View =>
            text_area_view(id, label, state.draft, state.shows_error(), described_by(id, state), id .. "-error",
                state.message, on_input, on_blur));
    };

    /// @brief A labelled checkbox over `state`: a change sets the state to the box's `checked`.
    export let checkbox = func(id: string, label: string, state: ui.State<bool>) -> ui.Component {
        last on_change = new func(event: ui.ChangeEvent) {
            state.set(event.checked);
        };
        return ui.component<bool>(state, new func(checked: bool) -> ui.View => checkbox_view(id, label, checked, on_change));
    };

    /// @brief A labelled `select` of `choices` over `field`, whose draft is the chosen value; a change
    /// sets it and touches the field.
    export let select = func<T>(field: forms.Field<T>, choices: frozen.FrozenList<Choice>) -> ui.Component {
        last id = field.element_id();
        last label = field.label();
        last on_change = field.on_change();
        return ui.component<forms.FieldState>(field.state, new func(state: forms.FieldState) -> ui.View =>
            select_view(id, label, state.draft, choices, on_change));
    };

    /// @brief A `button` of type `button` that calls `on_click`.
    export let button = func(label: string, on_click: func(ui.ClickEvent) -> void) -> ui.View =>
        button_view(label, on_click);

    /// @brief A `button` of type `submit`, which submits the form it is in.
    export let submit_button = func(label: string) -> ui.View => submit_view(label);

    /// @brief A `form` element over `form`, rendering `content` with the form's state. Submitting it
    /// (the Enter key or a submit button) validates every field without a page load and, when all are
    /// valid, calls `action`; otherwise the first invalid field gets the focus. `content` and `action`
    /// are retained.
    export let form = func(form: forms.Form, action: func() -> void,
        content: func(forms.FormState) -> ui.View) -> ui.Component {
        last on_submit = form.on_submit(action);
        last top = ui.component<forms.FormState>(form.state, new func(state: forms.FormState) -> ui.View =>
            form_view(on_submit, content(state)));
        form.bind(top);
        return top;
    };

    /// @brief A `ul` with one `li` per item of `items`, keyed by `key` so that an item keeps its
    /// element when items move. `key` and `item` are retained; `item` renders one item.
    export let list = func<T>(items: ui.State<frozen.FrozenList<T>>, key: func(T) -> string,
        item: func(T) -> ui.View) -> ui.Component =>
            ui.component<frozen.FrozenList<T>>(items, new func(all: frozen.FrozenList<T>) -> ui.View {
                last indexes: int32[list] = new;
                last keys: string[list] = new;
                last views: ui.View[list] = new;
                for (let i = 0; i < all.length(); i++) {
                    indexes.append(i as int32);
                    keys.append(key(all.get(i)));
                    views.append(item(all.get(i)));
                }
                return list_view(frozen.copy_of_list<int32>(indexes), keys, views);
            });

    /// @brief A `table` with a caption, a header row of `columns` and one row per `TableRow` of `rows`, keyed
    /// by the row's key; each row has one cell per column, and a row with another number of cells
    /// traps when it renders. Two columns with one name are refused by the host (a duplicate key).
    export let table = func(caption: string, columns: frozen.FrozenList<string>,
        rows: ui.State<frozen.FrozenList<TableRow>>) -> ui.Component {
        last counted: int32[list] = new;
        for (let i = 0; i < columns.length(); i++) {
            counted.append(i as int32);
        }
        last positions = frozen.copy_of_list<int32>(counted);
        return ui.component<frozen.FrozenList<TableRow>>(rows, new func(all: frozen.FrozenList<TableRow>) -> ui.View {
            for (let i = 0; i < all.length(); i++) {
                if (all.get(i).cells.length() != columns.length()) {
                    trap_with_message("a table row has " .. all.get(i).cells.length().to_string() .. " cells for "
                        .. columns.length().to_string() .. " columns");
                }
            }
            return table_view(caption, columns, positions, all);
        });
    };

    /// @brief A non-modal `dialog` whose `open` state is `open`, titled `title`, with the view `content`
    /// renders and a Close button. Closing it (the button, or the browser's own close) sets `open` to
    /// false. `content` is retained.
    export let dialog = func(id: string, title: string, open: ui.State<bool>, content: func() -> ui.View) -> ui.Component {
        last on_close = new func(event: ui.CloseEvent) {
            open.set(false);
        };
        last on_dismiss = new func(event: ui.ClickEvent) {
            open.set(false);
        };
        return ui.component<bool>(open, new func(shown: bool) -> ui.View =>
            dialog_view(id, id .. "-title", title, shown, content(), on_close, on_dismiss));
    };

    let described_by = func(id: string, state: forms.FieldState) -> optional.Optional<string> {
        if (state.shows_error()) {
            return optional.Optional<string>.Some(id .. "-error");
        }
        return optional.Optional<string>.None;
    };
);
