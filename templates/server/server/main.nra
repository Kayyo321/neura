// The server of a new project: neura-server-host runs it once for each request (docs/runtime/ServerHost.md).
let app = import:Std.App;
let errors = import:Std.Core.Error;
let program = import:Std.Program;
let strings = import:Std.Text.Strings;
let optional = import:Std.Core.Optional;
let.promote _ = import:Std.Core.Result;
let.promote _ = import:Std.Core.Unit;

let Main = module:program.Entry (
    export let.override main = func(args: string[]) -> program.ExitCode => app.run(serve);

    /// @brief Hands the routing function to the host for this execution's one request.
    let serve = func(context: app.Context) -> Result<Unit> {
        last greeting = optional.value_or<string>(context.config("greeting"), "hello");
        return context.serve(app.handler_of(new func(request: app.Request) -> Result<app.Response> =>
            route(greeting, request)));
    };

    /// @brief Answers GET /hello; everything else is 404.
    let route = func(greeting: string, request: app.Request) -> Result<app.Response> {
        if (request.path == "/hello" && (request.method == "GET" || request.method == "HEAD")) {
            last name = strings.starts_with(request.query, "name=")
                ? request.query.slice(5, request.query.byte_length) : "world";
            return Result<app.Response>.Ok(app.text(200, $"{greeting}, {name}\n"));
        }
        return Result<app.Response>.Ok(app.text(404, "not found\n"));
    };
);
