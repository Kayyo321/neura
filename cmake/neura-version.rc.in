// The version resource of the Neura executables and DLLs on Windows, which
// Explorer's Details tab and installers read. Generated by
// cmake/NeuraWindows.cmake from NEURA_VERSION_FULL, the one version source.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @NEURA_RC_VERSION_NUMBERS@
PRODUCTVERSION @NEURA_RC_VERSION_NUMBERS@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE @NEURA_RC_FILE_TYPE@
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Neura"
            VALUE "FileVersion", "@NEURA_VERSION_FULL@"
            VALUE "ProductName", "Neura"
            VALUE "ProductVersion", "@NEURA_VERSION_FULL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
