// The registry of NeuraIR symbol attributes (docs/NirFormat.md, Revision
// 1.10). Each entry is
//
//   NEURA_ATTRIBUTE(Identifier, id, "name", kinds, repeats, "schema")
//
// - Identifier: the AttributeId enumerator.
// - id: the stable u16 written to .nir files. Never renumber or reuse an id;
//   retire an attribute by leaving its line commented out. 0 is reserved.
// - name: the spelling in listings and diagnostics.
// - kinds: a mask of the symbol kinds that may carry it (attributes.hpp,
//   `on_*` constants).
// - repeats: whether one symbol may carry it more than once. Order is kept.
// - schema: the payload shape the reader and the verifier check:
//     b         bool
//     i         signed 64-bit integer
//     u         unsigned 64-bit integer; `uN` also requires value <= N
//     t         text
//     s         symbol reference (remapped by linking and specialization)
//     y         type
//     p         source span
//     a         any literal: b, i, u, or t
//     *X        list whose items all match X (may be empty)
//     [X Y ...] list of exactly these items in order (a record)
//   Spaces are ignored.
//
// Adding an attribute: append a line with the next free id. The reader,
// writer, equality, listing, linker, and specialization handle it without
// further changes; semantic checks beyond the schema go in the verifier
// (verifier.cpp, check_attributes).

// A source tag (`#Name(args)`): [tag id from the tag registry, the tag's
// written name, [[argument name or "" when positional, literal value]...],
// the tag's span].
NEURA_ATTRIBUTE(Tag, 1, "tag", on_declarations, true, "[u65535 t *[t a] p]")
// On an exported field: its hidden getter or setter function.
NEURA_ATTRIBUTE(AccessorGet, 2, "accessor.get", on_field, false, "s")
NEURA_ATTRIBUTE(AccessorSet, 3, "accessor.set", on_field, false, "s")
// On a hidden accessor function: [the field, 0 for a getter or 1 for a setter].
NEURA_ATTRIBUTE(AccessorOf, 4, "accessor.of", on_function, false, "[s u1]")
// A `last` binding; the value is true when it is declared without an
// initializer (deferred single assignment).
NEURA_ATTRIBUTE(BindingLast, 5, "binding.last", on_local | on_field, false, "b")
// An anonymous class: [structural (fields only), canonical structural
// signature, the occurrence's span].
NEURA_ATTRIBUTE(ClassAnonymous, 6, "class.anonymous", on_class, false, "[b t p]")
// A function implemented by a built-in C kernel: [kernel name, ABI version].
NEURA_ATTRIBUTE(KernelBinding, 7, "kernel.binding", on_function, false, "[t u4294967295]")
// The optimizer's inlining directive: 0 auto, 1 always, 2 never.
NEURA_ATTRIBUTE(InlineDirective, 8, "inline.directive", on_function, false, "u2")
// A method that runs under its instance's guard.
NEURA_ATTRIBUTE(Synchronized, 9, "synchronized", on_function, false, "b")
// A class whose instances may be shared between tasks.
NEURA_ATTRIBUTE(ClassShareable, 10, "class.shareable", on_class, false, "b")
