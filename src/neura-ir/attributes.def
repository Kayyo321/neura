// The registry of NeuraIR symbol attributes (docs/NirFormat.md, Revision
// 1.10). Each entry is
//
//   NEURA_ATTRIBUTE(Identifier, id, "name", kinds, repeats, "schema")
//
// - Identifier: the AttributeId enumerator.
// - id: the stable u16 written to .nir files. Never renumber or reuse an id;
//   retire an attribute by leaving its line commented out. 0 is reserved.
// - name: the spelling in listings and diagnostics.
// - kinds: a mask of the symbol kinds that may carry it (attributes.hpp,
//   `on_*` constants).
// - repeats: whether one symbol may carry it more than once. Order is kept.
// - schema: the payload shape the reader and the verifier check:
//     b         bool
//     i         signed 64-bit integer
//     u         unsigned 64-bit integer; `uN` also requires value <= N
//     t         text
//     s         symbol reference (remapped by linking and specialization)
//     y         type
//     p         source span
//     a         any literal: b, i, u, or t
//     *X        list whose items all match X (may be empty)
//     [X Y ...] list of exactly these items in order (a record)
//   Spaces are ignored.
//
// Adding an attribute: append a line with the next free id. The reader,
// writer, equality, listing, linker, and specialization handle it without
// further changes; semantic checks beyond the schema go in the verifier
// (verifier.cpp, check_attributes).

// A source tag (`#Name(args)`): [tag id from the tag registry, the tag's
// written name, [[argument name or "" when positional, literal value]...],
// the tag's span].
NEURA_ATTRIBUTE(Tag, 1, "tag", on_declarations, true, "[u65535 t *[t a] p]")
// On an exported field: its hidden getter or setter function.
NEURA_ATTRIBUTE(AccessorGet, 2, "accessor.get", on_field, false, "s")
NEURA_ATTRIBUTE(AccessorSet, 3, "accessor.set", on_field, false, "s")
// On a hidden accessor function: [the field, 0 for a getter or 1 for a setter].
NEURA_ATTRIBUTE(AccessorOf, 4, "accessor.of", on_function, false, "[s u1]")
// A `last` binding; the value is true when it is declared without an
// initializer (deferred single assignment).
NEURA_ATTRIBUTE(BindingLast, 5, "binding.last", on_local | on_field, false, "b")
// An anonymous class: [structural (fields only), canonical structural
// signature, the occurrence's span].
NEURA_ATTRIBUTE(ClassAnonymous, 6, "class.anonymous", on_class, false, "[b t p]")
// A function implemented by a built-in C kernel: [kernel name, ABI version].
NEURA_ATTRIBUTE(KernelBinding, 7, "kernel.binding", on_function, false, "[t u4294967295]")
// The optimizer's inlining directive: 0 auto, 1 always, 2 never.
NEURA_ATTRIBUTE(InlineDirective, 8, "inline.directive", on_function, false, "u2")
// A method that runs under its instance's guard.
NEURA_ATTRIBUTE(Synchronized, 9, "synchronized", on_function, false, "b")
// A class whose instances may be shared between tasks.
NEURA_ATTRIBUTE(ClassShareable, 10, "class.shareable", on_class, false, "b")
// On a function bound to a host service and declared without a body: what a
// call may do, as the standard library declares with #HostEffects:
// [may allocate, may trap, uses the scheduler, retains its arguments]. A host
// call is a host request by definition. Without it every fact is unknown
// (docs/design/Representation030.md, "Effect and retention summaries").
NEURA_ATTRIBUTE(HostEffects, 11, "host.effects", on_function, false, "[b b b b]")
// A constant default of a parameter (docs/design/Calls030.md, Constant
// defaults): [kind, literal]. Kind 0 Boolean, 1 signed integer, 2 unsigned
// integer, 3 float (the literal is the value's encoding at the parameter's
// width, as an unsigned integer), 4 text, 5 nil (the literal is false). A
// caller that leaves the parameter out passes this value.
NEURA_ATTRIBUTE(ParameterDefault, 12, "parameter.default", on_parameter, false, "[u5 a]")
// A default that is an enum variant without payload.
NEURA_ATTRIBUTE(ParameterDefaultVariant, 13, "parameter.default.variant", on_parameter, false, "s")
// An extension function (docs/design/Calls030.md, Extension sets): a
// function that a module enabled with `let.extensions` may call as a member
// of its first parameter's type. The value is true.
NEURA_ATTRIBUTE(FunctionExtension, 14, "function.extension", on_function, false, "b")
// On a class that declares a class hook clause: its hidden hook function.
NEURA_ATTRIBUTE(HookGet, 15, "hook.get", on_class, false, "s")
NEURA_ATTRIBUTE(HookSet, 16, "hook.set", on_class, false, "s")
// On a hidden hook function: [the class that declares the clause, 0 for a
// getter or 1 for a setter].
NEURA_ATTRIBUTE(HookOf, 17, "hook.of", on_function, false, "[s u1]")
// Records, property contracts, static requirements and derivation
// (docs/design/Records030.md). The milestone's identifiers start at 18 and
// are renumbered when it merges.
//
// A record class: its generated constructor.
NEURA_ATTRIBUTE(ClassRecord, 18, "class.record", on_class, false, "s")
// A bodyless `$get_<name>` or `$set_<name>` function of an interface that a
// property requirement declares: [the property's name, 0 get or 1 set].
NEURA_ATTRIBUTE(PropertyRequirement, 19, "property.requirement", on_function, false, "[t u1]")
// A hidden accessor that establishes a slot a subclass may override.
NEURA_ATTRIBUTE(AccessorVirtual, 20, "accessor.virtual", on_function, false, "b")
// A static function that implements a static requirement of an interface:
// [the requirement, the class or primitive whose declaration lists the
// conformance]. Repeatable.
NEURA_ATTRIBUTE(StaticImplements, 21, "static.implements", on_function, true, "[s y]")
// A symbol a generator produced: [the generator, one of "record",
// "property.adapter" or "derive:json.codec", and the span of the declaration
// that caused it].
NEURA_ATTRIBUTE(Generated, 22, "generated", on_function | on_class | symbol_kind_bit(SymbolKind::Module), false, "[t p]")
