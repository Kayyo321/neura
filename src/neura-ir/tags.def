          "the name used when serialized", "choose the key in the explicit to_json")
NEURA_TAG(Skip, 79, Serialization, Field, reserved, false, "", "0.2.0", "left out when serialized",
          "leave the field out of the explicit to_json")
NEURA_TAG(SerialDefault, 80, Serialization, Field, reserved, false, "value:a", "0.2.0",
          "the value used when the input has no entry", "supply the default in the explicit from_json")

// Resource management
NEURA_TAG(Resource, 81, Resources, Class, reserved, false, "", "0.2.0",
          "instances must be destroyed before they become unreachable",
          "destroy the instance explicitly or bind it in a scope block")
NEURA_TAG(NoAlloc, 82, Resources, Callables, reserved, false, "", "0.2.0", "never allocates heap cells",
          "measure peak_heap_cells with `neura run --stats`")
NEURA_TAG(MaxSteps, 83, Resources, Callables, reserved, false, "steps:i", "0.2.0",
          "a step budget for each call", "bound the whole run with --max-steps")

// Numerics
NEURA_TAG(Unit, 84, Numerics, Values | Local | Parameter | Callables, informational, false, "name:t", "0.2.0",
          "the unit of measure of the value or result, such as \"ms\"", "")
NEURA_TAG(Range, 85, Numerics, Values | Local | Parameter | Callables, reserved, false, "min:x,max:x", "0.2.0",
          "the value always lies within [min, max]",
          "check the bounds where the value is produced and trap_with_message")

