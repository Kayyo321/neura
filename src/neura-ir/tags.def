// Interop and layout
NEURA_TAG(Export, 64, Interop, Callables, reserved, false, "symbol:t?", "0.2.0",
          "make the function callable from C",
          "Neura calls C through import:c; C cannot call into an image yet")
NEURA_TAG(Callback, 65, Interop, Callables, reserved, false, "", "0.2.0",
          "a function C code may call back",
          "pass a Neura function value to Std.DynamicForeign, which supports upcalls")
NEURA_TAG(NativeName, 66, Interop, Callables | Values, reserved, false, "name:t", "0.2.0",
          "the C symbol name of a declaration", "import:c names declarations as the header does")
NEURA_TAG(Repr, 67, Interop, Class | Enum, reserved, false, "layout:n", "0.2.0", "a fixed memory layout",
          "object layout is the runtime's; marshal through Std.DynamicForeign")
NEURA_TAG(Align, 68, Interop, Class | Field, reserved, false, "bytes:i", "0.2.0", "a minimum alignment",
          "object layout is the runtime's; marshal through Std.DynamicForeign")
NEURA_TAG(Packed, 69, Interop, Class, reserved, false, "", "0.2.0", "no padding between fields",
          "object layout is the runtime's; marshal through Std.DynamicForeign")

// Diagnostics control
NEURA_TAG(Allow, 70, Diagnostics, Declarations & ~Variant, implemented, true, "warnings:w+", "0.2.0",
          "silences the named warnings inside the declaration", "")
NEURA_TAG(Deny, 71, Diagnostics, Declarations & ~Variant, implemented, true, "warnings:w+", "0.2.0",
          "turns the named warnings into errors inside the declaration", "")
NEURA_TAG(Expect, 72, Diagnostics, Declarations & ~Variant, reserved, true, "warnings:w+", "0.2.0",
          "silences the named warnings and reports when none occurs", "use #Allow")

// Security
NEURA_TAG(RequiresCapability, 73, Security, Callables | Module, reserved, true, "capability:n+", "0.2.0",
          "callers need the named runtime capability",
          "capabilities are granted per run (`neura run --deny-*`); document the requirement")
NEURA_TAG(Sensitive, 74, Security, Values | Local | Parameter | Class, reserved, false, "", "0.2.0",
          "a secret kept out of traces, dumps, and to_string",
          "avoid printing the value; --record and --task-dump may contain it")
NEURA_TAG(Untrusted, 75, Security, Values | Parameter | Callables, reserved, false, "", "0.2.0",
          "data from outside the program that must be validated before use",
          "validate the value where it enters the program")
NEURA_TAG(ConstantTime, 76, Security, Callables, reserved, false, "", "0.2.0",
          "runs in time independent of secret inputs",
          "write the comparison without early exits; no analysis proves it yet")

