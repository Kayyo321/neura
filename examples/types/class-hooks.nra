// Class hook clauses (docs/design/Hooks030.md, Class hook clauses): a rule
// about every reference of a class, where an accessor is a rule about one
// field. The compiler checks this file; a program that declares a clause
// cannot be built into an image yet (E0801).
let failure = import:Std.Core.Failure;

let Session = class (
    | get: instance;
    | set: {
        if (value == nil) {
            failure.trap("a Session reference is never nil");
        }
        return value;
    };

    export last user: string;
    export let init = func(user: string) => set;
);

// An administrator's references accept nil; the getter is inherited.
let Admin = class:Session (
    | set.override: value;

    export let init = func(user: string) {
        super.init(user);
    };
);

let Desk = class (
    export let current: Session = new Session("guest");
);
