let Classes = module (
    // A class groups fields and methods into a type.
    export let Animal = class (
        export static const DefaultName = "Animal";
        static let fallback_name = load_default_name();
        export let name: string = fallback_name;

        static let load_default_name = func -> string => DefaultName;

        export let speak = func() -> string {
            return name + " makes a sound";
        };
    );

    // A derived class inherits fields and can override methods.
    export let Dog = class:Animal (
        export let.override speak = func() -> string {
            return name + " barks";
        };
    );

    export let Cat = class:Animal (
        export let.override speak = func() -> string {
            return name + " meows";
        };
    );

    // A base-typed parameter accepts instances of derived classes.
    // The call dispatches to the method of the actual instance.
    export let describe = func(animal: Animal) -> string {
        return animal.speak();
    };

    export let example = func() -> void {
        last default_name = Animal.DefaultName; // A constant read leaves Animal's statics dormant.
        last dog: Dog = new; // Animal's static initializer runs before Dog's instance is created.
        dog.name = "Rover";
        last cat: Cat = new;
        cat.name = "Mittens";

        last dog_description: string = describe(dog); // "Rover barks"
        last cat_description: string = describe(cat); // "Mittens meows"
    };
);
