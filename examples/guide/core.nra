// Core syntax: functions, loops, and branches. tests/backend/examples/core-driver.nra runs it.
let Core = module (
    /// @brief Sums the positive integers through the inclusive limit.
    /// @param limit The largest integer to add.
    /// @return Zero for a limit below one, otherwise the sum.
    export let sum_to = func(limit: int32) -> int32 {
        let total: int32 = 0;
        let current: int32 = 1;
        if (limit < current) {
            return total;
        }
        do {
            total += current++;
        } while (current <= limit);
        return total;
    };

    export let describe = func(value: int32) -> string =>
        (value > 0) ? "positive" : "zero or negative";

    /// @brief Names the sign of a value.
    /// @param value The value to classify.
    /// @return "negative", "zero", or "positive".
    export let sign_name = func(value: int32) -> string {
        // A `last` binding is assigned exactly once, here on each branch.
        last name: string;
        if (value < 0) {
            name = "negative";
        } else if (value == 0) {
            name = "zero";
        } else {
            name = "positive";
        }
        return name;
    };
);
