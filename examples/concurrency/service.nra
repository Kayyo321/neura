// Scoped tasks, a cancellable operation, and safe shared state
// (docs/lang/Concurrency.md). Nothing here needs a clock or a network: the
// "backends" are functions, so the output is the same on every run.
let console = import:Std.Io.Console;
let program = import:Std.Program;
let cancellation = import:Std.Concurrent.Cancellation;
let channels = import:Std.Concurrent.Channel;
let guards = import:Std.Concurrent.Guarded;
let maps = import:Std.Collections.HashMap;

// A request to the task that owns the price table. The reply travels on a
// channel the caller supplies, so the table itself never leaves its owner.
let Request = enum (
    Put { item: string, price: int },
    Get { item: string, reply: channels.Sender<int> }
);

// State owned by one task needs no synchronization: no other task can
// reach `prices`. The request channel's capacity bounds the backlog.
let price_owner = func(requests: channels.Receiver<Request>) {
    last prices = maps.create<string, int>();
    do {
        match (requests.receive()) {
            channels.Received.Value(request) => {
                match (request) {
                    Request.Put { item, price } => {
                        prices.set(item, price);
                    },
                    Request.Get { item, reply } => {
                        reply.send(prices.get_or(item, -1));
                    },
                }
            },
            _ => {
                return;  // Closed or cancelled: stop serving.
            },
        }
    }
};

let price_of = func(requests: channels.Sender<Request>, item: string) -> int {
    const [reply, answer, closer] = channels.open<int>(1);
    requests.send(Request.Get { item: item, reply: reply });
    return match (answer.receive()) {
        channels.Received.Value(price) => price,
        _ => -1,
    };
};

// A slow search that asks, between steps, whether its work is still wanted.
// Cancellation is cooperative: nothing interrupts the loop.
let search = func(name: string, steps: int, found: channels.Sender<string>) -> int {
    let done = 0;
    while (done < steps) {
        if (cancellation.requested()) {
            return done;
        }
        done = done + 1;
    }
    found.send(name);
    return done;
};

// Asks three backends and keeps the first answer. The scope cancels the
// others and still waits for them, so nothing they hold outlives the call.
let first_answer = func -> string {
    const [found, winner, closer] = channels.open<string>(3);
    scope (group) {
        last fast = spawn search("fast", 200, found);
        last slow = spawn search("slow", 200000, found);
        last slower = spawn search("slower", 400000, found);
        last name = match (winner.receive()) {
            channels.Received.Value(text) => text,
            _ => "nobody",
        };
        group.cancel();
        last wasted = slow.join() + slower.join();
        return name + " answered; the others stopped early: " + (wasted < 600000).to_string();
    }
};

// Shared mutable state behind a guard: one task at a time, and nothing that
// refers to the map can leave `with`.
let count_visit = func(visits: guards.Guarded<maps.HashMap<string, int>>, page: string, times: int) {
    for (let i: int = 0; i < times; i++) {
        visits.with<bool>(func(table: maps.HashMap<string, int>) -> bool {
            table.set(page, table.get_or(page, 0) + 1);
            return true;
        });
    }
};

export let Main = module:program.Entry (
    export let.override main = func(arguments: string[]) -> program.ExitCode {
        // State owned by a task.
        const [requests, incoming, requests_closer] = channels.open<Request>(8);
        scope {
            spawn price_owner(incoming);
            requests.send(Request.Put { item: "tea", price: 3 });
            requests.send(Request.Put { item: "cake", price: 5 });
            last tea = spawn price_of(requests, "tea");
            last cake = spawn price_of(requests, "cake");
            last unknown = spawn price_of(requests, "soup");
            console.print_line("tea " + tea.join().to_string() + ", cake " + cake.join().to_string() +
                               ", soup " + unknown.join().to_string());
            requests_closer.close();
        }

        // A cancellable operation.
        console.print_line(first_answer());

        // State behind a guard.
        last visits = guards.create<maps.HashMap<string, int>>(
            func -> maps.HashMap<string, int> => maps.create<string, int>());
        scope {
            spawn count_visit(visits, "home", 300);
            spawn count_visit(visits, "about", 200);
            spawn count_visit(visits, "home", 100);
        }
        last home = visits.with<int>(func(table: maps.HashMap<string, int>) -> int => table.get_or("home", 0));
        last about = visits.with<int>(func(table: maps.HashMap<string, int>) -> int => table.get_or("about", 0));
        console.print_line("home " + home.to_string() + ", about " + about.to_string());
        return program.ExitCode.Ok;
    };
);
